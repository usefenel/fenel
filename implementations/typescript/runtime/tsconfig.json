{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // The storage module's irreducible host leaves follow the repository's
    // per-module FFI convention under fenel/modules/storage/ffi. Runtime owns
    // their DB-bearing assembly, so its source graph spans the repository root.
    "rootDir": "../../.."
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/*_todelete*"]
}
