module SourceParityFixture where
import std (add)
import SourceOrigin as Origin

@entity
@fieldLabel "value" "Value"
@valueLabel "SourcePayload" "Payload"
@widget "value" "text"
@helpText "value" "A payload"
@fieldReusable "value"
SourcePayload = SourcePayload value: String

@discriminator "kind"
SourceChoice = SourceFirst | SourceSecond

SourceDisplay a = SourceDisplay display: (a -> String) = (\value -> "default")
sourceDisplayNumber : SourceDisplay Number
sourceDisplayNumber = SourceDisplay {}

@label "Decorated function"
@description "All declaration annotations survive editing"
@tags "sample" "module"
@category "examples"
@icon "star"
@emoji "*"
@codeName "decoratedAlias"
@requires "HasLog"
@ioAction "source.decorated"
@stopAction "source.stop"
@listInstancesAction "source.instances"
decorated : Number -> Number
decorated value = value

@native
external : String -> String

identity : (value: a) -> a
identity value = value

render : Number -> String
render value = SourceDisplay.display value

addOne : Number -> Number
addOne value = add value 1

same : Number -> Number
same value = add value 100

useOrigin : Number -> Number
useOrigin value = (Origin.callback 3) value

SourceHolder = SourceHolder later: SourceLater
SourceLater = SourceLater text: String
