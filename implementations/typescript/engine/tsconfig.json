{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // module-substrate Phase 3b — `rootDir` spans the repo root (not just
    // `src`) so the per-module FFI leaves under `fenel/modules/<area>/ffi/*.ts`
    // — real `.ts` imports the seam pulls in, NOT `.fenel?raw` strings — satisfy
    // the rootDir-containment check (TS6059). `include: ["src"]` still bounds
    // the program roots to the engine source; rootDir only governs output-path
    // mapping, which the `--noEmit` typecheck gate (and Bun's run-from-source)
    // never exercises. This is DECISION 3's build-wiring resolution: the leaf is
    // reachable by the engine tsconfig without moving host-IO back into the
    // engine tree. (Also clears the pre-existing cross-package test-file TS6059
    // noise — engine `*.test.ts` importing runtime files — for the same reason.)
    "rootDir": "../../.."
  },
  "include": ["src"]
}
