module ownerinputpolicy where

-- C2 policy source. The host supplies descriptor-admitted, closed-schema
-- Boolean facts from the complete loader/consumer witness. A successful full
-- render does not set reviewedAnchor: only the reviewed category anchor does.
-- No registry, dispatch, evaluator callback, or authority is needed by these
-- structural bodies. Missing/unreadable facts must be refused by the wire
-- decoder before invocation, never defaulted to true.

ownerEntityInputFields : { name: Boolean, entities: Boolean, fieldFacetDirectives: Boolean }
ownerEntityInputFields = { name = true, entities = true, fieldFacetDirectives = true }

ownerConsumerPlan : {
  version: String, catalogueContract: String, canonicalLoader: String,
  entityFacade: String, copyContract: String, opaqueContract: String,
  harnessSourceSite: String, constructorSourcePrefix: String, globalSourceSite: String,
  profile0: String, profile1: String, profile2: String, profile3: String, profile4: String
}
ownerConsumerPlan = {
  version = "canonical-standalone-entity-envelope.v1",
  catalogueContract = "deny-full-before-cache-sticky",
  canonicalLoader = "implementations/typescript/engine/src/fenel-module.ts",
  entityFacade = "exactRepositoryCompilerModuleEntityProjection",
  copyContract = "exact-own-data-only",
  opaqueContract = "reviewed-byte-bound-producers",
  harnessSourceSite = "engine/harnessModuleDefinitions",
  constructorSourcePrefix = "compiler-constructor/profile",
  globalSourceSite = "system/SYSTEM_MODULES",
  profile0 = "system", profile1 = "seed-product", profile2 = "engine-identity-types",
  profile3 = "self-host-functions", profile4 = "self-host-engine-types"
}

ownerEntityOnlyEligible : (facts: {
  closedStandaloneLoader: Boolean,
  completeSourceProvenance: Boolean,
  completeConsumerRoster: Boolean,
  reviewedConsumerAnchor: Boolean,
  canonicalLoaderAdmitted: Boolean,
  hasEntityConsumer: Boolean,
  hasPrimaryConsumer: Boolean,
  hasBootstrapConsumer: Boolean,
  hasHarnessConsumer: Boolean,
  hasGlobalInstallerConsumer: Boolean,
  hasDirectRawConsumer: Boolean,
  hasUnknownConsumer: Boolean
}) -> Boolean
ownerEntityOnlyEligible facts =
  if facts.closedStandaloneLoader then
    if facts.completeSourceProvenance then
      if facts.completeConsumerRoster then
        if facts.reviewedConsumerAnchor then
          if facts.canonicalLoaderAdmitted then
            if facts.hasEntityConsumer then
              if facts.hasPrimaryConsumer then false
              else if facts.hasBootstrapConsumer then false
              else if facts.hasHarnessConsumer then false
              else if facts.hasGlobalInstallerConsumer then false
              else if facts.hasDirectRawConsumer then false
              else if facts.hasUnknownConsumer then false
              else true
            else false
          else false
        else false
      else false
    else false
  else false

-- Deliberately conservative B1. Every type/field/reserved row remains in the
-- digest. A function row can be dropped only when the complete current loaded
-- declaration is proven EntityOnly AND no complete full-role domain needs it.
-- Thus the original photo's added rgb parameter Field still invalidates B1;
-- narrowing function-owned fields needs an additional ownership proof.
ownerIdentityRowRetained : (row: {
  kind: String,
  declaredInEntityOnlySource: Boolean,
  neededByFullConsumerDomain: Boolean
}) -> Boolean
ownerIdentityRowRetained row =
  case row.kind of
    "function" ->
      if row.declaredInEntityOnlySource then
        if row.neededByFullConsumerDomain then true else false
      else true
    _ -> true
