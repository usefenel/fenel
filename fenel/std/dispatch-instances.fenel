-- Representational :: X — marker tagging a typeclass as "presents a value".
-- Empty method record; the RepresentationsPanel queries the instance set.
labelableRepresentational : Representational Labelable
labelableRepresentational = Representational

codeableRepresentational : Representational Codeable
codeableRepresentational = Representational

describableRepresentational : Representational Describable
describableRepresentational = Representational

-- Submittable is a representation (storage-as-effect Phase 4e) — the shared
-- RepresentationsPanel surfaces its `submitLabel` editor for free via
-- instancesOf("Representational"); no TS, no editor edit.
submittableRepresentational : Representational Submittable
submittableRepresentational = Representational

iconableRepresentational : Representational Iconable
iconableRepresentational = Representational

emojiableRepresentational : Representational Emojiable
emojiableRepresentational = Representational

picturableRepresentational : Representational Picturable
picturableRepresentational = Representational

soundableRepresentational : Representational Soundable
soundableRepresentational = Representational

aliasableRepresentational : Representational Aliasable
aliasableRepresentational = Representational

categorizableRepresentational : Representational Categorizable
categorizableRepresentational = Representational

taggableRepresentational : Representational Taggable
taggableRepresentational = Representational

exemplifiableRepresentational : Representational Exemplifiable
