viewableRepresentational : Representational Viewable
viewableRepresentational = Representational

inputableRepresentational : Representational Inputable
inputableRepresentational = Representational

-- UUID-keyed field facet family. The generated repository field catalog reads
-- these authored facts; browser code never hardcodes the family.
codeableFieldRepresentational : FieldRepresentational Codeable
codeableFieldRepresentational = FieldRepresentational

labelableFieldRepresentational : FieldRepresentational Labelable
labelableFieldRepresentational = FieldRepresentational

describableFieldRepresentational : FieldRepresentational Describable
describableFieldRepresentational = FieldRepresentational

iconableFieldRepresentational : FieldRepresentational Iconable
iconableFieldRepresentational = FieldRepresentational

displayableFieldRepresentational : FieldRepresentational Displayable
displayableFieldRepresentational = FieldRepresentational

-- Filterable profile — the canonical self-exclude default filter for entity-ref
-- pickers (a candidate may not be the entity being edited). `defaultFilter` is
-- an Expression VALUE (Filterable's method type), evaluated by the renderer with
-- `candidate` + `_self` bound — NOT a lambda. typed-function-references Phase 10c
-- moved it off the `builtin-classes.ts` TS const (`SELF_EXCLUDE_FILTER`); the
-- `.fenel` `!=` parses to the canonical call-form `{call:["neq",…]}` (the legacy
-- const stored the retired operator-form `{"!=":[…]}` — same evaluation).
profileFilterable : Filterable "profile"
profileFilterable = Filterable { defaultFilter = candidate.id != _self.id }

-- Identifiable h — handle-kind dispatch for reference resolution (the OPEN
-- handle class of typed-function-references Phase 8a; declared INERTLY — the
-- resolution flip is the deferred 8c-2 step). `resolve` holds a point-free
-- FUNCTION REFERENCE: the by-id read for the UUID handle, the by-codeName read
-- for the CodeableName handle. Phase 10 of typed-function-references taught the
-- `.fenel` loader to lower a bare point-free method reference (`{var:"…"}`) to
-- the dispatch-ready codeableName-handle `{$ref:"…"}`, so these two — the last
-- reference-method instances stranded as TS `ClassInstance` consts in
-- builtin-classes.ts — finally move to `.fenel`. The `{$ref}` handle is the
-- function's codeName (`getInstanceById` / `getInstanceByName`); dispatch
-- resolves it via `getFunction` (id-or-codeName) at call time, identically to
-- the fnId handle the consts carried.
uuidIdentifiable : Identifiable UUID
uuidIdentifiable = Identifiable { resolve = getInstanceById }

codeableNameIdentifiable : Identifiable CodeableName
codeableNameIdentifiable = Identifiable { resolve = getInstanceByName }

-- HasDefault Boolean — the canonical default for Boolean is `False`. The `=
-- False` Bool constructor coerces to JS `false` at load, byte-matching the
-- deleted `booleanHasDefault` const (typed-function-references Phase 11). The
-- `HasDefault Unit` const (`default = null`) was DROPPED, not migrated — it was
-- runtime-dead (the `$unit` short-circuit + `case "Unit"` fallback both return
-- null without ever consulting the instance).
booleanHasDefault : HasDefault Boolean
booleanHasDefault = HasDefault { default = False }

-- Undefinable FieldMetadata — the meta sidecar may be omitted from the
-- serialised form when empty/absent. Single boolean method (`isErasable =
-- True` → JS `true`); the `Undefinable (Maybe a)` parametric instance stays
-- TS-side (its applied-type arg expands to `$variant`, diverging from the
-- const's `{$el}` dispatch key). typed-function-references Phase 11.
fieldMetadataUndefinable : Undefinable FieldMetadata
fieldMetadataUndefinable = Undefinable { isErasable = True }

-- Truthy Boolean — boolean coercion is the identity (`True → True`,
-- `False → False`). Lambda method; `\x -> x` lowers to `{fn:["x",{var:"x"}]}`
-- (the nested `{var:"x"}` is a lexical param, NOT a function reference — the
-- loader's bare-`{var}`→`{$ref}` flip is top-level-method-value only).
-- typed-function-references Phase 11.
boolTruthy : Truthy Boolean
boolTruthy = Truthy { truthy = \x -> x }

-- Landing 1 A1 — the runtime effect dictionaries are authored data, not
-- boot-time TS instance construction. String method values are IO action
-- descriptors consumed by the single perform gate; the qualified point-free
-- UUID method remains a function reference. `scope` is projection metadata:
-- the dispatch-instance loader lifts it onto Instance.scope and removes it
-- from the method record.
--
-- ⚠ rights R3a (the RETAG, commit 1 of retag → fence → flip). These seven
-- carried `scope = "account"`, which the loader lifted to `{kind:"tag",
-- tag:"account"}` — a TAG, and no production frame has ever populated
-- `_activeTags`. So the visibility predicate ALREADY hid them, and IO worked
-- only because the durable arm resolved UNFILTERED. Filtering before
-- retagging is a total silent IO outage; retagging first is what makes the
-- fence safe to add. They are boot-DECLARED rows of the repository, not rows
-- any account owns: `"account"` in the SIGNATURE is the dispatch TARGET key
-- (`HasStateIO "account"`, read by the durable arm), a different coordinate
-- from the scope. After R3a the bare string `"account"` is not a legal
-- sidecar scope at all — `fenel-module.ts` refuses it at load.
accountHasRandom : HasRandom "account"
accountHasRandom = HasRandom { uuid = crypto.uuidV4, scope = "global" }

accountHasStateIO : HasStateIO "account"
accountHasStateIO = HasStateIO { loadType = "state.load_type", schemaOf = "state.schema_of", createInstance = "state.create_instance", updateInstance = "state.update_instance", appendEvent = "state.append_event", getInstance = "state.get_instance", listInstances = "state.list_instances", tryCreateInstanceByName = "state.try_create_instance_by_name", pinToView = "state.pin_to_view", scope = "global" }

accountHasTelegramBot : HasTelegramBot "account"
accountHasTelegramBot = HasTelegramBot { runCollector = "telegram_collector.run", stopCollector = "telegram_collector.stop", handleUpdate = "telegram_collector.handle_update", findBotById = "telegram.find_bot_by_id", sendMessageText = "telegram.send_message_text", sendFieldPrompt = "telegram.send_field_prompt", scope = "global" }

accountHasIO : HasIO "account"
accountHasIO = HasIO { read = "read", sleep = "sleep", wait = "wait", end_function = "end_function", emit = "emit", call_function = "call_function", scope = "global" }

accountHasHTTP : HasHTTP "account"
accountHasHTTP = HasHTTP { request = "http_request", scope = "global" }

accountHasControlFlow : HasControlFlow "account"
accountHasControlFlow = HasControlFlow { retry = "retry", with_timeout = "with_timeout", on_error = "on_error", bracket = "bracket", parallel = "parallel", race = "race", any = "any", for_each = "for_each", scope = "global" }

accountHasLog : HasLog "account"
accountHasLog = HasLog { log = "log", scope = "global" }

-- Resolvable Place.<level> — per-GeoLevel instances for `Place : GeoLevel ->
-- Type` (field-meta-collapse Phase 4). Dispatch is off the typeclass arg (the
-- dotted tag `Place.GeoCountry` projects to the bare-string arg `"Place.Geo…"`).
-- The method bodies are sensible-default stubs (0 = equal, True = accept,
-- identity = pass-through); the per-level ordering logic is a deferred follow-up.
-- All three are lambdas → `{fn}` method values. typed-function-references P11.
placeCountryResolvable : Resolvable Place.GeoCountry
placeCountryResolvable = Resolvable { compareLevel = \x y -> 0, validateGeoPath = \x -> True, truncateToLevel = \x -> x }

placeRegionResolvable : Resolvable Place.GeoRegion
placeRegionResolvable = Resolvable { compareLevel = \x y -> 0, validateGeoPath = \x -> True, truncateToLevel = \x -> x }

placeCityResolvable : Resolvable Place.GeoCity
placeCityResolvable = Resolvable { compareLevel = \x y -> 0, validateGeoPath = \x -> True, truncateToLevel = \x -> x }

placePostalCodeResolvable : Resolvable Place.GeoPostalCode
placePostalCodeResolvable = Resolvable { compareLevel = \x y -> 0, validateGeoPath = \x -> True, truncateToLevel = \x -> x }

placeStreetResolvable : Resolvable Place.GeoStreet
placeStreetResolvable = Resolvable { compareLevel = \x y -> 0, validateGeoPath = \x -> True, truncateToLevel = \x -> x }

placeAddressResolvable : Resolvable Place.GeoAddress
placeAddressResolvable = Resolvable { compareLevel = \x y -> 0, validateGeoPath = \x -> True, truncateToLevel = \x -> x }

-- Exemplifiable :: X — sample values for the storybook surface (a "what does
-- this type look like with concrete values" lens, edge cases alongside ordinary
-- values). String/Nat/Boolean migrated in typed-function-references Phase 11
-- (array literals + `True`/`False` round-trip byte-identically). Number/Int
-- stay TS-side (their arrays carry NEGATIVE literals, which parse to
-- `{call:["negate",N]}` not plain `-N`); the media Exemplifiable (Image/Sound/…)
-- stay TS-side (TS-generated sample matrices, not hand-authored data).
stringExemplifiable : Exemplifiable String
stringExemplifiable = Exemplifiable { examples = ["", "Hello", "the quick brown fox", "rom@usefenel.com", "🦊 unicode"] }

natExemplifiable : Exemplifiable Nat
natExemplifiable = Exemplifiable { examples = [0, 1, 2, 7, 42, 100] }

booleanExemplifiable : Exemplifiable Boolean
booleanExemplifiable = Exemplifiable { examples = [True, False] }

-- Reprable JsRuntime Boolean — the pure↔native representation boundary for
-- Bool under the JS-runtime target (representation-substrate Phase 1). This is
-- the Fenel-authored SOURCE OF TRUTH for the Bool↔JS-boolean coercion that was
-- a hardcoded `name === "True"|"False"` arm in json-logic.ts; that arm survives
-- as this instance's law-bound opaque-repr PERF BRANCH (re-annotated, not
-- deleted — Phase 1 is additive; design/ts-exceptions-ledger.md B5).
--
-- THE DEGENERATE CASE BY DESIGN: Bool's native rep and pure ADT COINCIDE as JS
-- booleans (the pure `True`/`False` ARE JS booleans in disguise), so `native =
-- Boolean` (native type == pure type) and `lift`/`lower` are the identity-via-
-- round-trip — each maps a value to the OTHER representation by re-emitting its
-- constructor. They are kept SEMANTIC (examine the value, re-emit `True`/`False`)
-- rather than the bare `\x -> x` perf shortcut: the RHS `True`/`False` flow
-- through the construct perf branch (→ JS boolean), so the bodies bottom out at
-- the host crossing exactly once, non-re-entrantly. Phase 2 (Nat) is the first
-- NON-trivial encoding (native `number` ≠ the Peano `Zero`/`Succ` pure ADT).
--
-- `native = Boolean` lowers to the type reference `{$named:"Boolean"}` via the
-- loader's `typeValuedFields: {Reprable: ["native"]}` option (system-entities.ts);
-- the two `Verified Boolean` law fields are OMITTED (the isoBase64 precedent —
-- codec/instances.fenel) and the round-trip is sample-discharged in
-- bool-opaque.test.ts.
reprableBoolJsRuntime : Reprable JsRuntime Boolean
reprableBoolJsRuntime = Reprable { native = Boolean, lift = \b -> if b then True else False, lower = \n -> if n then True else False }

-- Reprable JsRuntime Nat — the pure↔native boundary for Nat under the JS-runtime
-- target (representation-substrate Phase 2). The FIRST NON-TRIVIAL encoding: the
-- native rep (a JS `number`) genuinely differs from the pure Peano ADT
-- (`Zero`/`Succ`), unlike Bool's degenerate identity.
--
--   lift  = std.natToNumber  (Nat → Number: counts the Succ spine — the PERF direction)
--   lower = std.numberToNat  (Number → Nat: materialises the Peano spine — the REASONING direction)
--
-- These are the EXISTING numeric-tower Phase-1 bridge fns (fenel/modules/std/nat/
-- nat-bridge.fenel) — they ARE the `Reprable JsRuntime Nat` lower/lift the design
-- (R5) identified, reused verbatim (qualified function references, the
-- aggregable/codec precedent; contrast Bool's inline lambdas, used only because
-- Bool's bridge is the degenerate identity with no named fn). `native = Number` lowers to `{$named:"Number"}`
-- via the `typeValuedFields: {Reprable: ["native"]}` loader option. The two
-- `Verified Boolean` law fields are OMITTED (the isoBase64 / Bool precedent);
-- the round-trip is sample-discharged over a 0..N grid in nat-peano.test.ts.
reprableNatJsRuntime : Reprable JsRuntime Nat
reprableNatJsRuntime = Reprable { native = NatNativeRepresentation, lift = std.natRepresentationLift, lower = std.natRepresentationLower }

-- Reprable JsRuntime Int — the pure↔native boundary for Int under the JS-runtime
-- target (numeric-tower Phase 2 — the representation-substrate hand-off; Int is
-- "the substrate's first NEW client", R10, the reason representation-substrate
-- ran ahead of this rung). The DIRECT SIBLING of the Nat instance: the native
-- rep (a JS `number`) differs from the pure sign-magnitude ADT (`Int magnitude:
-- Nat negative: Bool`).
--
--   lift  = std.intToNumber  (Int → Number: collapse sign-magnitude — the PERF direction)
--   lower = std.numberToInt  (Number → Int: materialise sign-magnitude — the REASONING direction)
--
-- These are the EXISTING numeric-tower Phase-2 bridge fns (fenel/modules/std/int/
-- int-bridge.fenel) — they ARE the `Reprable JsRuntime Int` lower/lift the design
-- (R5) identified, reused verbatim (qualified function references, the Nat/
-- aggregable/codec precedent). `native = Number` lowers to `{$named:"Number"}` via the
-- `typeValuedFields: {Reprable: ["native"]}` loader option. The two `Verified
-- Boolean` law fields are OMITTED (the isoBase64 / Bool / Nat precedent); the
-- round-trip is sample-discharged over a signed grid in int-tower.test.ts.
reprableIntJsRuntime : Reprable JsRuntime Int
reprableIntJsRuntime = Reprable { native = IntNativeRepresentation, lift = std.intRepresentationLift, lower = std.intRepresentationLower }

-- Exact Rational representation: integer decimal strings preserve the whole
-- ratio through runtime and storage. The source arithmetic stays over the pure
-- Int/PositiveNat ADT; its BigInt performance branch carries the same nominal
-- Rational tag and produces reduced, positive-denominator ratios. The explicit
-- rationalToNumber projection is separate and approximate. Roundtrip coverage
-- includes genuine fractions and values above the scalar Number precision.
reprableRationalJsRuntime : Reprable JsRuntime Rational
reprableRationalJsRuntime = Reprable { native = RationalRepresentation, lift = std.rationalRepresentationParts, lower = std.rationalRepresentationLower }

-- Reprable JsRuntime Real — the pure↔native boundary for Real under the JS-runtime
-- target (numeric-tower Phase 4 — the LAST tower rung). The native is a `Number`
-- SAMPLE of the Cauchy sequence at a fixed precision — FAR lossier than Rational:
-- a double cannot round-trip a real (it is a sample at ONE precision, not the
-- value; the D7 ℝ carve-out made total). OPTION A again (the §0/§2f Step-0
-- decision): `native = Number`, consistent with every lower rung, the lossiness as
-- the sanctioned native-vs-pure divergence. The round-trip is discharged over the
-- integer/simple-rational sub-domain (where the sample is exact); a real that
-- cannot be decided within budget returns Nothing (the partiality is the point, not
-- a wrong round-trip).
--
--   lift  = std.realToNumber  (Real → Number: sample seq at modulus(PREC) — LOSSY)
--   lower = std.numberToReal  (Number → Real: the constant-sequence embedding)
--
-- These are the EXISTING Phase-4 bridge fns (fenel/modules/std/real/
-- real-bridge.fenel) — they ARE the `Reprable JsRuntime Real` lift/lower (R5),
-- reused verbatim. `native = Number` lowers to `{$named:"Number"}` via the
-- `typeValuedFields` loader option; law fields OMITTED (sample-discharged, the
-- whole-tower precedent). This instance + the Jsonb sibling below ARE the
-- representation-substrate Phase 6 hand-off content (D1/D8 collapse — the tower's
-- top rung authors its own Reprable).
reprableRealJsRuntime : Reprable JsRuntime Real
reprableRealJsRuntime = Reprable { native = Number, lift = std.realToNumber, lower = std.numberToReal }

-- Reprable JsRuntime Number — the pure↔native boundary for the WHOLE tower
-- (numeric-tower Phase 5, the capstone). UNLIKE the per-rung instances above
-- (whose pure is one rung — Peano Nat, sign-magnitude Int, …), Number's pure is
-- the TAGGED $variant `NatN Nat | IntN Int | RatN Rational | RealN Real` and its
-- native is the flat JS double (the `"number"` repr). So this is the SELF-NAMING
-- case (the List `native = List` / Char `native = Char` precedent — `native =
-- Number` because Number IS the type whose `$opaque.repr` is the double):
--   lift  = std.towerToDouble  (tagged value → double — collapse the rung, the PERF direction)
--   lower = std.doubleToTower  (double → tagged value — IntN if integral else RealN, the REASONING direction)
-- LOSSY by construction (FORK 2 — a double erases the rung tag; lower never
-- produces NatN/RatN): the round-trip is discharged over the IntN/RealN +
-- integer sub-domains (number-tower.test.ts), the Real-Reprable carve-out
-- precedent. Law fields OMITTED (the whole-tower precedent). `native = Number`
-- lowers to `{$named:"Number"}` via the `typeValuedFields` loader option.
reprableNumberJsRuntime : Reprable JsRuntime Number
reprableNumberJsRuntime = Reprable { native = Number, lift = std.towerToDouble, lower = std.doubleToTower }

-- Reprable JsRuntime (List a) — the pure↔native boundary for List under the
-- JS-runtime target (representation-substrate Phase 3 — the FIRST hot-path repr,
-- and the FIRST instance whose represented type is PARAMETRIC). The native rep
-- (a JS array) differs from the pure cons-spine ADT (`Nil`/`Cons`).
--
--   lift  = std.listToArray  (cons-spine → array — the PERF direction)
--   lower = std.arrayToList  (array → cons-spine — the REASONING direction)
--
-- THE PARAMETRIC-HEAD FALLBACK (Step-0 verdict, notes/phase-3-step0-probe.md):
-- the natural head `Reprable JsRuntime (List a)` does NOT register cleanly — the
-- parser EXPANDS the registered type-app `(List a)` to its full `$opaque`, so
-- `args[1]` becomes that whole object, not the string "List" the dispatch index
-- keys on. So this uses the brief's sanctioned FALLBACK: the BARE `List` head
-- (`Reprable JsRuntime List`), which records `args = ["JsRuntime", "List"]` — the
-- type-CONSTRUCTOR name, the element var dropped from the head. Parametricity
-- lives in the BODY's element-transparency (the spine bridge carries each element
-- through untouched — see fenel/modules/std/list/list-repr.fenel §1.2), not in the
-- instance head; one parametric instance, NOT one-per-element-type.
--
-- `native = List` (NOT a separate "native array" type — there is none registered;
-- `List` IS the type whose `$opaque.repr` is "array") lowers to `{$named:"List"}`
-- via the `typeValuedFields: {Reprable: ["native"]}` loader option. The Bool-
-- degenerate parallel: native type name == pure type name, but UNLIKE Bool the
-- runtime values differ (cons-spine ≠ array — the boundary is real). The two
-- `Verified Boolean` law fields are OMITTED (the isoBase64 / Bool / Nat / Int /
-- Rational precedent); the round-trip + element-transparency are sample-discharged
-- in list-string-repr.test.ts. These bridges ARE the lift/lower (R5); the
-- std-ffi.ts list natives are their ledgered opaque-repr PERF BRANCH (B4).
reprableListJsRuntime : Reprable JsRuntime List
reprableListJsRuntime = Reprable { native = List, lift = std.listToArray, lower = std.arrayToList }

-- Reprable JsRuntime String — the pure↔native boundary for String under the
-- JS-runtime target (representation-substrate Phase 3). String is `List Char`
-- PURE, but its native is a JS STRING, not a JS array (R4 — per-(target,type)
-- granularity made literal), so it gets its OWN instance, NOT List's at `a = Char`.
--
--   lift  = std.charListToString  (List Char → JS string — the PERF direction)
--   lower = std.stringToCharList  (JS string → List Char — the REASONING direction)
--
-- THE ASYMMETRY vs List: String's native is a FLAT code-point sequence, so its
-- lift/lower DO touch elements (split into / rejoin chars via `chars`/`join`),
-- contrast List's element-transparent spine bridge — List's native already holds
-- the elements, String's flattens them. The Char element crossing needs NO new
-- native: Char's runtime repr IS a 1-char String, so `chars`/`join` cross
-- String↔List<Char-repr> directly; the codepoint↔Nat crossing (`charCode`/
-- `charFromCode`, both already host leaves) is Char's OWN Reprable, deferred to
-- representation-substrate Phase 4. `native = String` lowers to `{$named:"String"}`
-- via `typeValuedFields`. Law fields OMITTED (the precedent); round-trip
-- (empty/ASCII/emoji) sample-discharged in list-string-repr.test.ts. The bridges
-- reuse the List spine bridge (string-repr.fenel = arrayToList∘chars / join∘listToArray);
-- the std-ffi.ts string natives are their ledgered opaque-repr PERF BRANCH (B4 —
-- the canonical "String.concat over List<Char>" class).
reprableStringJsRuntime : Reprable JsRuntime String
reprableStringJsRuntime = Reprable { native = String, lift = std.charListToString, lower = std.stringToCharList }

-- Reprable JsRuntime Char — the pure↔native boundary for Char under the
-- JS-runtime target (representation-substrate Phase 4). The LAST opaque without a
-- `Reprable` instance — it closes the Phase-3 String seam (Phase 3's String bridge
-- left each Char element in its NATIVE 1-char-string form; THIS is the separate
-- crossing from that native form to Char's pure value).
--
--   lift  = std.charFromCode  (codepoint Number → 1-char String — the native side)
--   lower = std.charCode      (1-char String → codepoint Number — the pure side)
--
-- THE LAYERED-OPAQUE ASYMMETRY (vs the other instances): Char is a LAYERED opaque
-- — `$opaque { repr:"codepoint", pure: Nat ∈ unicode-scalars }`, so its PURE is a
-- *refined Nat* (itself opaque over a JS number) and its NATIVE is a *1-char JS
-- string*. The bridge crosses refined-Nat ↔ 1-char-String, NOT a Peano-ADT ↔
-- native like Nat/Int.
--
-- STEP-0 VERDICT = NUMBER-DIRECT (notes/phase-4-step0-probe.md). The faithful
-- Peano-materializing path (`charFromCode (natToNumber c)` / `numberToNat (charCode
-- s)`) is PROVABLY INFEASIBLE: `numberToNat` is non-tail recursive, so a
-- codepoint-magnitude argument blows the JS stack (`numberToNat(129418)` for 🦊 and
-- `numberToNat(1114111)` for 0x10FFFF both throw `Maximum call stack size
-- exceeded`). A *refined* Nat surfaces at the value level as its base `repr` — a JS
-- number (the codepoint) — never a million-deep Peano spine. So the lift/lower
-- point STRAIGHT at the existing `charFromCode`/`charCode` host leaves (NO new
-- bridge fn — §2b shrank to identify-and-wire), the degenerate Bool-like identity
-- AT THE NUMBER LEVEL (the value crosses 1-char-string ↔ codepoint-number once,
-- non-re-entrantly through the native dispatch). These leaves ARE the lift/lower
-- the design (R5) identified; they are ALSO the ledgered opaque-repr PERF BRANCH
-- (design/ts-exceptions-ledger.md B4 — set-algebra-to-fenel 3b-3 named them for the
-- Char/String lexical-ordering substrate).
--
-- SURROGATE EXCLUSION (the refinement, R1 axis separation): the refinement excludes
-- 0xD800..0xDFFF, but the bridge is the ENCODE/DECODE axis (R1) — it PASSES THROUGH;
-- refinement *validation* is `validateValue`'s axis, NOT the bridge's.
--
-- `native = Char` (Char is ONE type with two reprs — the 1-char-string native and
-- the refined-Nat pure; the List `native = List` self-naming precedent) lowers to
-- `{$named:"Char"}` via the `typeValuedFields: {Reprable: ["native"]}` loader
-- option. The two `Verified Boolean` law fields are OMITTED (the isoBase64 / Bool /
-- Nat / Int / Rational / List / String precedent); the round-trip is
-- sample-discharged over a codespace grid (ASCII / BMP accents / emoji / the four
-- codespace boundaries) in char-repr.test.ts.
reprableCharJsRuntime : Reprable JsRuntime Char
reprableCharJsRuntime = Reprable { native = Char, lift = std.charFromCode, lower = std.charCode }

-- ============================================================================
-- representation-substrate Phase 5c — the STORAGE-target `Reprable Jsonb <type>`
-- instances (R7). The LAST representation target; with these the workstream arc
-- is complete (every opaque atom has a `Reprable` instance under BOTH the
-- JsRuntime in-memory target and the Jsonb storage target).
--
-- `Reprable Jsonb <type>` is the Fenel-authored SOURCE OF TRUTH for "how a
-- `<type>` value encodes AT REST" (the JSONB/wire shape) — the storage analogue
-- of the `Reprable JsRuntime` in-memory instances above. The `state.ts` DB IO
-- leaf (`stripTopLevelTag` → `performStorageMethod`'s `store` descriptor) is these
-- instances' ledgered PERF BRANCH (design/ts-exceptions-ledger.md B4): values
-- reach the store leaf ALREADY in their JS-native form, so store-as-is IS the
-- `lift` (pure→native) fast path — byte-compat-verified, not a re-encode.
--
-- STEP-0 VERDICT (notes/phase-5c-step0-probe.md): the storage native == the
-- runtime native for all 7 atoms (Bool→JS boolean, Nat/Int/Rational→JS number,
-- List→JS array, String→JS string, Char→1-char JS string), and a 445-row staging
-- scan found ZERO stored pure forms (no Peano spine / Bool ctor / cons-spine) ⇒
-- the `Reprable Jsonb` `lift` reproduces today's bytes EXACTLY, NO data migration.
-- So per R4 (per-(target,type) granularity — SEPARATE instances even when the
-- native coincides; a future `bytea`/columnar target may diverge) each instance
-- reuses the SAME `native` + `lift`/`lower` functions as its `Reprable JsRuntime`
-- sibling. The two `Verified Boolean` law fields are OMITTED (the isoBase64 / Bool
-- / Nat / Int / Rational / List / String / Char precedent); the round-trip +
-- BYTE-COMPAT are sample-discharged in phase-5c-storage-repr.test.ts.
--
-- `native` lowers to `{$named:…}` via `typeValuedFields: {Reprable: ["native"]}`
-- (the Phase-1 finding holds — the JsRuntime siblings use the same path).
-- Rational uses the same exact integer-string representation for both targets;
-- its storage contract is a ratio record, not the former scalar Number bytes.
-- ============================================================================

reprableBoolJsonb : Reprable Jsonb Boolean
reprableBoolJsonb = Reprable { native = Boolean, lift = \b -> if b then True else False, lower = \n -> if n then True else False }

reprableNatJsonb : Reprable Jsonb Nat
reprableNatJsonb = Reprable { native = NatNativeRepresentation, lift = std.natRepresentationLift, lower = std.natRepresentationLower }

reprableIntJsonb : Reprable Jsonb Int
reprableIntJsonb = Reprable { native = IntNativeRepresentation, lift = std.intRepresentationLift, lower = std.intRepresentationLower }

reprableRationalJsonb : Reprable Jsonb Rational
reprableRationalJsonb = Reprable { native = RationalRepresentation, lift = std.rationalRepresentationParts, lower = std.rationalRepresentationLower }

-- numeric-tower Phase 4 — the storage-target sibling of reprableRealJsRuntime
-- (same Number sample, the D7 ℝ carve-out; the Phase-5c per-rung Jsonb pattern).
reprableRealJsonb : Reprable Jsonb Real
reprableRealJsonb = Reprable { native = Number, lift = std.realToNumber, lower = std.numberToReal }

-- numeric-tower Phase 5 — the storage-target sibling of reprableNumberJsRuntime
-- (the tagged-tower ⇄ double bridges; the Phase-5c per-type Jsonb pattern). A
-- stored Number is the flat double exactly as today — `lift` reproduces the bytes;
-- the tagged pure view is the in-memory reasoning form.
reprableNumberJsonb : Reprable Jsonb Number
reprableNumberJsonb = Reprable { native = Number, lift = std.towerToDouble, lower = std.doubleToTower }

reprableListJsonb : Reprable Jsonb List
reprableListJsonb = Reprable { native = List, lift = std.listToArray, lower = std.arrayToList }

reprableStringJsonb : Reprable Jsonb String
reprableStringJsonb = Reprable { native = String, lift = std.charListToString, lower = std.stringToCharList }

reprableCharJsonb : Reprable Jsonb Char
reprableCharJsonb = Reprable { native = Char, lift = std.charFromCode, lower = std.charCode }

-- ============================================================================
-- numeric-tower Phase 5 (2026-06-26) — the Eq / Ord / Numeric per-rung instances
-- (D5, THE TOWER CAPSTONE). Each method value is a FUNCTION REFERENCE (a bare
-- `natEqM` ident the loader lowers to the dispatch-ready `{$ref:"natEqM"}` —
-- Phase 10 of typed-function-references; NOT a bare-string-callable, so the audit
-- count holds at baseline) to a Phase 1–4 body or its Phase-5 Maybe-Bool wrapper
-- (numeric-compare.fenel). With these registered, `eq`/`lt`/`add` over a tower
-- value dispatch to the value's rung by reflection — the tower becomes one
-- dispatched numeric type.
--
-- THE `ordEq` SUPER IS OMITTED FROM THE Ord INSTANCES. `Ord a`'s `ordEq: Eq a`
-- field is a SUPERCLASS obligation (erased from the dispatch method set by
-- `seedFromType`'s super classifier), NOT a method — so instances do not populate
-- it, exactly as `countryGroupable` omits Groupable's `referenceable` super. The
-- witness (the `Eq` instance for the same rung) is resolved by reflection at use.
--
-- FORK-1 (B): every comparison method is `Maybe Bool`-valued. Nat/Int/Rational
-- reference the always-`Just` decidable wrappers (*EqM/*LtM/…); Real references
-- the default-fuel partial wrappers (realEqDefault/realLtDefault/… — Nothing when
-- undecided within budget). Numeric is RINGS only (Int/Rational/Real); `Numeric
-- Nat` is omitted (ℕ is not a ring — no negate, truncated monus).

-- Eq / Ord over the DECIDABLE rungs (Nat / Int / Rational) — always Just.
eqNat : Eq Nat
eqNat = Eq { eq = natEqM, neq = natNeqM }

ordNat : Ord Nat
ordNat = Ord { lt = natLtM, lte = natLteM, gt = natGtM, gte = natGteM }

eqInt : Eq Int
eqInt = Eq { eq = intEqM, neq = intNeqM }

ordInt : Ord Int
ordInt = Ord { lt = intLtM, lte = intLteM, gt = intGtM, gte = intGteM }

eqRational : Eq Rational
eqRational = Eq { eq = ratEqM, neq = ratNeqM }

ordRational : Ord Rational
ordRational = Ord { lt = ratLtM, lte = ratLteM, gt = ratGtM, gte = ratGteM }

-- Eq / Ord over the PARTIAL ℝ rung — default-fuel wrappers; Nothing when
-- undecided within budget (FORK-1 (B); the realEq/realLt Maybe Bool, D4).
eqReal : Eq Real
eqReal = Eq { eq = realEqDefault, neq = realNeqDefault }

ordReal : Ord Real
ordReal = Ord { lt = realLtDefault, lte = realLteDefault, gt = realGtDefault, gte = realGteDefault }

-- Numeric over the RINGS — Int / Rational / Real (add/sub/mul/negate, all TOTAL,
-- referencing the Phase 2–4 bodies). No `Numeric Nat` (ℕ is not a ring).
numericInt : Numeric Int
numericInt = Numeric { add = intAdd, sub = intSub, mul = intMul, negate = intNegate }

numericRational : Numeric Rational
numericRational = Numeric { add = ratAdd, sub = ratSub, mul = ratMul, negate = ratNeg }

numericReal : Numeric Real
numericReal = Numeric { add = realAdd, sub = realSub, mul = realMul, negate = realNegate }

-- ============================================================================
-- solver-extension Phase 1 (2026-06-26) — the `Enumerable` per-base instances
-- (the typed widening the shipped solver fences on). Each `enumFromTo` value is
-- a FUNCTION REFERENCE (a bare `intEnumFromTo` ident the loader lowers to
-- `{$ref:"intEnumFromTo"}`; NOT a bare-string-callable, so the audit count holds
-- at baseline) to the Phase-1 stepper body (enumerable.fenel). With these
-- registered, `Enumerable.enumFromTo lo hi` over an integer-typed value
-- dispatches to the rung's stepper by reflection, and `engine:enumerableSet`
-- steps an integer-typed `WsInterval` into a finite witness set. Int + Nat are
-- the integer-enumerable bases; the irrational rungs (Rational / Real) are NOT
-- `Enumerable` (a dense/uncountable order has no successor — the honest gap, the
-- `Numeric Nat` omission precedent).
enumerableInt : Enumerable Int
enumerableInt = Enumerable { enumFromTo = intEnumFromTo }

enumerableNat : Enumerable Nat
enumerableNat = Enumerable { enumFromTo = natEnumFromTo }

-- solver-extension Phase 2 — `Enumerable Char` (codepoint stepping). Char is the
-- first NON-numeric Enumerable base: not a ring, but a discrete order (the Unicode
-- codespace has a successor — the next codepoint). The stepper composes the host
-- leaves charCode/charFromCode (NO new TS).
enumerableChar : Enumerable Char
enumerableChar = Enumerable { enumFromTo = charEnumFromTo }

-- ============================================================================
-- containment-substrate Phase 2 Step 3 (design §10.3) — the per-former math-GLYPH
-- `Symbolable` instances. The §10.3 "printer-hardcoded-glyph → Symbolable"
-- subsumption: the formatter glyphs (`set-syntax.fenel:formatSetExpr` +
-- `ExpressionDisplay.tsx`) were hardcoded string literals — a per-former Fenel
-- fact encoded in TS/formatter source, the [[feedback_no_language_concept_in_ts]]
-- violation. Here they become typed `Symbolable` VALUES keyed by the FORMER NAME;
-- `engine:getSymbol "union"` resolves `Just "∪"` and both emit surfaces route
-- through it.
--
-- The dispatch arg is a STRING LITERAL in type position (`Symbolable "union"`),
-- exactly the parser-fixities `Infixable "std:add"` precedent — it projects to the
-- `args: ["union"]` shape `dispatchLookupOne "Symbolable" "union"` matches (a bare
-- lowercase ident would project as a type VARIABLE, not its name). Every method
-- value is a string literal ⇒ no infix operators ⇒ no fixity-bootstrap concern.
--
-- The LIVE formatter set is `union`/`intersect`/`complement`/`diff` (the only
-- SetExpr arms with a routing site today). `top`/`bottom`/`arrow` are the
-- forward-looking §10.3 entries (SeAll/SeNone render as word forms; an `$arrow`
-- is not a SetExpr) — registered now so the full §10.3 instance table is present
-- the moment a routing site appears. `diff`'s glyph is the ASCII `\` (the §10.3
-- `∖` renders as `\` in this text DSL — KEEP `\`, the current byte-output).
unionSymbolable : Symbolable "union"
unionSymbolable = Symbolable { symbol = "∪" }

intersectSymbolable : Symbolable "intersect"
intersectSymbolable = Symbolable { symbol = "∩" }

complementSymbolable : Symbolable "complement"
complementSymbolable = Symbolable { symbol = "¬" }

diffSymbolable : Symbolable "diff"
diffSymbolable = Symbolable { symbol = "\\" }

topSymbolable : Symbolable "top"
topSymbolable = Symbolable { symbol = "⊤" }

bottomSymbolable : Symbolable "bottom"
bottomSymbolable = Symbolable { symbol = "⊥" }

arrowSymbolable : Symbolable "arrow"
arrowSymbolable = Symbolable { symbol = "→" }

-- ============================================================================
-- The SetExpr cases' own names, read by a typed reader where a set value is shown
-- (a record field typed `SetExpr`: "One of" above its values, not `SeEnum`). Keyed by
-- the bare constructor tag, as `_ : Labelable "SolanumLycopersicum"` is. The words are
-- the set editor's (SetExprEditor.tsx CASE_LABEL, whose comment names these instances
-- as its principled home). SeRigid is validation-only and never shown.

_ : Labelable "SeAll"
_ = Labelable { label = "Any value" }

_ : Labelable "SeNone"
_ = Labelable { label = "No value" }

_ : Labelable "SeEnum"
_ = Labelable { label = "One of" }

_ : Labelable "SeInterval"
_ = Labelable { label = "Between" }

_ : Labelable "SeRef"
_ = Labelable { label = "Named set" }

_ : Labelable "SePattern"
_ = Labelable { label = "Matches" }

_ : Labelable "SeWhere"
_ = Labelable { label = "Where" }

_ : Labelable "SeCtor"
_ = Labelable { label = "Constructor" }

_ : Labelable "SeMu"
_ = Labelable { label = "Recursive set" }

_ : Labelable "SeArrow"
_ = Labelable { label = "Function" }

_ : Labelable "SeUnion"
_ = Labelable { label = "Any of" }

_ : Labelable "SeIntersect"
_ = Labelable { label = "All of" }

_ : Labelable "SeDiff"
_ = Labelable { label = "Difference" }

_ : Labelable "SeComplement"
_ = Labelable { label = "Not in" }

-- ============================================================================
-- Numeric named-set relation facts use the existing Subsumable dispatch data.
-- Exact integer and ratio values have represented record inhabitants as well
-- as their pure ADT forms. Numeric embedding functions do not establish
-- containment of these carriers in the scalar Number/Real sample sets.
-- Keep existing same-kind alias rows; omit cross-carrier positive claims until
-- the judgment proves them in the reader's scope. Native numeric domains and
-- opaque projections carry matching fences in both containment cores.
subsumableNat : Subsumable "Nat"
subsumableNat = Subsumable { supers = ["ℕ"] }

subsumableNatGlyph : Subsumable "ℕ"
subsumableNatGlyph = Subsumable { supers = ["Nat"] }

subsumableInt : Subsumable "Int"
subsumableInt = Subsumable { supers = ["ℤ"] }

subsumableIntGlyph : Subsumable "ℤ"
subsumableIntGlyph = Subsumable { supers = [] }

subsumableRational : Subsumable "Rational"
subsumableRational = Subsumable { supers = ["ℚ"] }

subsumableRationalGlyph : Subsumable "ℚ"
subsumableRationalGlyph = Subsumable { supers = [] }

subsumableReal : Subsumable "Real"
subsumableReal = Subsumable { supers = ["ℝ", "Number"] }

subsumableRealGlyph : Subsumable "ℝ"
subsumableRealGlyph = Subsumable { supers = ["Real", "Number"] }

-- The numeric TOP (≡ ℝ ≡ Real) — its own row so `Number ⊆ ℝ`/`Real` (and, with
-- ℝ/Real carrying `Number`, the mutual-synonym closure) decide.
subsumableNumber : Subsumable "Number"
subsumableNumber = Subsumable { supers = ["ℝ", "Real"] }

-- ============================================================================
-- containment-substrate Phase 4 — the RESIDUAL char/str/Bool `Subsumable`
-- instances. This COMPLETES the `NAMED_HIERARCHY` retirement Step 2 began: the
-- char:* / str:* codespace-inclusion hierarchy (`char:ascii ⊂ char:latin1 ⊂
-- char:bmp`, `str:ascii ⊂ … ⊂ String`, …) + Bool / String / NonEmpty were the
-- LAST rows in the TS const; ported here, the const is DELETED entirely (the
-- accessor reads ONLY this `.fenel` relation now — no more `.fenel`-numeric +
-- TS-residual merge). The honesty rider (same as Step 2): codespace inclusion is
-- a STRUCTURAL FACT the trio does NOT derive — *something* must assert
-- `char:ascii ⊆ char:latin1`; this moves that assertion from the TS const to the
-- instance-extensible `Subsumable` relation (the registration mechanism
-- engine/DOCS.md §818 asked for; adding a char-class = add a `.fenel` instance).
-- `supers` reproduced VERBATIM from the deleted const rows (byte-parity gate).
-- The named-type key is a string literal (colons/hyphens fine — `Subsumable
-- "char:ascii-printable"` → `args: ["char:ascii-printable"]`); the VALUE name is
-- camelCased to a valid ASCII Fenel identifier. Deriving char-class inclusion
-- STRUCTURALLY (from the regex/char-class predicates) is a regex-substrate /
-- solver-extension thread — NOT this phase.
subsumableBool : Subsumable "Bool"
subsumableBool = Subsumable { supers = [] }

subsumableString : Subsumable "String"
subsumableString = Subsumable { supers = [] }

subsumableNonEmpty : Subsumable "NonEmpty"
subsumableNonEmpty = Subsumable { supers = ["String"] }

-- Char-class hierarchy (codespace inclusion) — 22 rows.
subsumableCharAscii : Subsumable "char:ascii"
subsumableCharAscii = Subsumable { supers = ["char:latin1", "char:bmp"] }

subsumableCharAsciiPrintable : Subsumable "char:ascii-printable"
subsumableCharAsciiPrintable = Subsumable { supers = ["char:ascii", "char:latin1", "char:bmp"] }

subsumableCharAsciiLetter : Subsumable "char:ascii-letter"
subsumableCharAsciiLetter = Subsumable { supers = ["char:letter", "char:ascii", "char:latin1", "char:bmp"] }

subsumableCharAsciiLower : Subsumable "char:ascii-lower"
subsumableCharAsciiLower = Subsumable { supers = ["char:ascii-letter", "char:lowercase", "char:letter", "char:ascii", "char:latin1", "char:bmp"] }

subsumableCharAsciiUpper : Subsumable "char:ascii-upper"
subsumableCharAsciiUpper = Subsumable { supers = ["char:ascii-letter", "char:uppercase", "char:letter", "char:ascii", "char:latin1", "char:bmp"] }

subsumableCharAsciiDigit : Subsumable "char:ascii-digit"
subsumableCharAsciiDigit = Subsumable { supers = ["char:digit", "char:decimal-digit", "char:ascii", "char:latin1", "char:bmp"] }

subsumableCharAsciiAlnum : Subsumable "char:ascii-alnum"
subsumableCharAsciiAlnum = Subsumable { supers = ["char:alnum", "char:word", "char:ascii", "char:latin1", "char:bmp"] }

subsumableCharAsciiPunct : Subsumable "char:ascii-punct"
subsumableCharAsciiPunct = Subsumable { supers = ["char:punct", "char:ascii", "char:latin1", "char:bmp"] }

subsumableCharLatin1 : Subsumable "char:latin1"
subsumableCharLatin1 = Subsumable { supers = ["char:bmp"] }

subsumableCharLowercase : Subsumable "char:lowercase"
subsumableCharLowercase = Subsumable { supers = ["char:letter"] }

subsumableCharUppercase : Subsumable "char:uppercase"
subsumableCharUppercase = Subsumable { supers = ["char:letter"] }

subsumableCharTitlecase : Subsumable "char:titlecase"
subsumableCharTitlecase = Subsumable { supers = ["char:letter"] }

subsumableCharModifierLetter : Subsumable "char:modifier-letter"
subsumableCharModifierLetter = Subsumable { supers = ["char:letter"] }

subsumableCharOtherLetter : Subsumable "char:other-letter"
subsumableCharOtherLetter = Subsumable { supers = ["char:letter"] }

subsumableCharDecimalDigit : Subsumable "char:decimal-digit"
subsumableCharDecimalDigit = Subsumable { supers = ["char:digit"] }

subsumableCharLetterNumber : Subsumable "char:letter-number"
subsumableCharLetterNumber = Subsumable { supers = ["char:digit"] }

subsumableCharOtherNumber : Subsumable "char:other-number"
subsumableCharOtherNumber = Subsumable { supers = ["char:digit"] }

subsumableCharCurrency : Subsumable "char:currency"
subsumableCharCurrency = Subsumable { supers = ["char:symbol"] }

subsumableCharMath : Subsumable "char:math"
subsumableCharMath = Subsumable { supers = ["char:symbol"] }

subsumableCharModifierSymbol : Subsumable "char:modifier-symbol"
subsumableCharModifierSymbol = Subsumable { supers = ["char:symbol"] }

subsumableCharOtherSymbol : Subsumable "char:other-symbol"
subsumableCharOtherSymbol = Subsumable { supers = ["char:symbol"] }

subsumableCharAlnum : Subsumable "char:alnum"
subsumableCharAlnum = Subsumable { supers = ["char:word"] }

-- String-class hierarchy mirrors char-class — 16 rows.
subsumableStrAscii : Subsumable "str:ascii"
subsumableStrAscii = Subsumable { supers = ["str:latin1", "str:bmp", "String"] }

subsumableStrAsciiPrintable : Subsumable "str:ascii-printable"
subsumableStrAsciiPrintable = Subsumable { supers = ["str:ascii", "str:latin1", "str:bmp", "String"] }

subsumableStrAsciiLetter : Subsumable "str:ascii-letter"
subsumableStrAsciiLetter = Subsumable { supers = ["str:letter", "str:ascii", "String"] }

subsumableStrAsciiLower : Subsumable "str:ascii-lower"
subsumableStrAsciiLower = Subsumable { supers = ["str:ascii-letter", "str:lowercase", "str:letter", "str:ascii", "String"] }

subsumableStrAsciiUpper : Subsumable "str:ascii-upper"
subsumableStrAsciiUpper = Subsumable { supers = ["str:ascii-letter", "str:uppercase", "str:letter", "str:ascii", "String"] }

subsumableStrAsciiDigit : Subsumable "str:ascii-digit"
subsumableStrAsciiDigit = Subsumable { supers = ["str:digit", "str:ascii", "String"] }

subsumableStrAsciiAlnum : Subsumable "str:ascii-alnum"
subsumableStrAsciiAlnum = Subsumable { supers = ["str:alnum", "str:word", "str:ascii", "String"] }

subsumableStrLatin1 : Subsumable "str:latin1"
subsumableStrLatin1 = Subsumable { supers = ["str:bmp", "String"] }

subsumableStrBmp : Subsumable "str:bmp"
subsumableStrBmp = Subsumable { supers = ["String"] }

subsumableStrLowercase : Subsumable "str:lowercase"
subsumableStrLowercase = Subsumable { supers = ["str:letter", "String"] }

subsumableStrUppercase : Subsumable "str:uppercase"
subsumableStrUppercase = Subsumable { supers = ["str:letter", "String"] }

subsumableStrLetter : Subsumable "str:letter"
subsumableStrLetter = Subsumable { supers = ["String"] }

subsumableStrDigit : Subsumable "str:digit"
subsumableStrDigit = Subsumable { supers = ["String"] }

subsumableStrAlnum : Subsumable "str:alnum"
subsumableStrAlnum = Subsumable { supers = ["str:word", "String"] }

subsumableStrWord : Subsumable "str:word"
subsumableStrWord = Subsumable { supers = ["String"] }

subsumableStrEmoji : Subsumable "str:emoji"
subsumableStrEmoji = Subsumable { supers = ["String"] }

-- Exportable :: X — file formats type X can serialise to.
imageExportable : Exportable Image
imageExportable = Exportable { formats = ["png"] }

audioBufferExportable : Exportable AudioBuffer
audioBufferExportable = Exportable { formats = ["wav"] }

soundExportable : Exportable Sound
soundExportable = Exportable { formats = ["wav"] }

pictureExportable : Exportable Picture
pictureExportable = Exportable { formats = ["png"] }
