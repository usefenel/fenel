-- Typeclass instances — Fenel-authored typed values (Phase 3 of
-- typeclass-substrate-completion, 2026-05-28).
--
-- An instance is NOT a special concept: it is a typed VALUE of a
-- parametric spec type. `profileReferenceable : Referenceable profile`
-- is a value whose type is `Referenceable` applied to `profile`,
-- exactly as `x : Int = 3` is an Int value. The `loadFenelModule` loader
-- (engine/src/fenel-module.ts) recognises any `name : <X>Spec a1 a2 =
-- <X>Spec { f1 = v1, ... }` value-decl and PROJECTS it into the legacy
-- `SpecInstance { typeName, args, methods }` cache shape downstream TS
-- dispatch still reads — typeName = <X>, args = [a1, a2], methods = the
-- record fields. Phase 4 retires that cache; the value is the substrate.
--
-- Scope: this file carries the dispatch instances authored as Fenel typed
-- values. typed-function-references Phase 11 added the non-reference instance
-- slice the original Phase 3 deferred: the lambda-method instances (Truthy,
-- the 6 Resolvable), the boolean-method instances (booleanHasDefault,
-- fieldMetadataUndefinable), and three primitive Exemplifiable sample arrays
-- (String/Nat/Boolean) — all round-trip byte-identically (the Bool
-- `True`/`False` → JS-bool coercion + the lambda/`{fn}` pass-through). Still
-- deferred, each for a concrete encoding reason:
--   * Number/Int Exemplifiable — their arrays carry NEGATIVE literals, which the
--     parser lowers to `{call:["negate",N]}`, not the plain `-N` the const
--     stored (a negative-number-literal lexer gap; folding it is a loader
--     decision, not this slice's).
--   * maybeUndefinable (`Undefinable (Maybe a)`) — the applied-type arg expands
--     to a full `$variant` in sig position (and `a` → `{$ref}`, not the const's
--     `{$var}`), diverging from the const's `{$el:{call:["Maybe",{$var:"a"}]}}`
--     dispatch key; migrating it would move the unevaluated-Maybe
--     `isErasableType` registry path.
--   * Media Exemplifiable — TS-generated sample matrices, its own arc.
--   (Infixable/Prefixable moved to fenel/std/parser-fixities.fenel in
--   typed-function-references Phase 12 — a separate bootstrap-first file.)
--   * unitHasDefault was DROPPED (not migrated): `default = null` is runtime-
--     dead (`defaultValueFor` short-circuits `$unit` to null before any registry
--     lookup, and the `case "Unit"` fallback returns null identically).
-- See workstreams/typed-function-references/roadmap.md Phase 11. The original
-- Phase 3 clean string/array/empty-method slice (Referenceable / Groupable /
-- HasDefault String|Number|Int|Nat / Layout / Representational / Exportable)
-- and the per-module / factory-derived format families load through the same
-- projection path -- see workstreams/typeclass-substrate-completion/roadmap.md
-- Phase 3.

-- Referenceable :: X — which field of entity X is its canonical reference id.
profileReferenceable : Referenceable "profile"
profileReferenceable = Referenceable { refId = "id" }

countryReferenceable : Referenceable "country"
countryReferenceable = Referenceable { refId = "code" }

currencyReferenceable : Referenceable "currency"
currencyReferenceable = Referenceable { refId = "code" }

languageReferenceable : Referenceable "language"
languageReferenceable = Referenceable { refId = "code" }

itemReferenceable : Referenceable "item"
itemReferenceable = Referenceable { refId = "id" }

planReferenceable : Referenceable "plan"
planReferenceable = Referenceable { refId = "id" }

functionReferenceable : Referenceable "function"
functionReferenceable = Referenceable { refId = "id" }

formReferenceable : Referenceable "form"
formReferenceable = Referenceable { refId = "id" }

platformReferenceable : Referenceable "platform"
platformReferenceable = Referenceable { refId = "code" }

-- Groupable :: X — how entity X aggregates into a portfolio/group.
countryGroupable : Groupable "country"
countryGroupable = Groupable { groupName = "geographical_set", groupLabel = "Geographical Set", groupStructure = "flat" }

-- HasDefault :: X — canonical default value for type X (boolean/unit
-- defaults deferred: `False` / `null` don't round-trip byte-identically).
stringHasDefault : HasDefault String
stringHasDefault = HasDefault { default = "" }

numberHasDefault : HasDefault Number
numberHasDefault = HasDefault { default = 0 }

intHasDefault : HasDefault Int
intHasDefault = HasDefault { default = 0 }

natHasDefault : HasDefault Nat
natHasDefault = HasDefault { default = 0 }

-- FM-retire-E1 Step 3 — the enum-atom defaults, lifted off the retired
-- per-field `fieldDefaults` overlay (profile/inventory/purchase/form) onto the
-- field's TYPE. `defaultValueFor` resolves a field of type `{$ref: ProfileType}`
-- through `HasDefault ProfileType` (the field type is a name-handle, NOT an
-- inlined `$refined` — so it reaches the registry arm, not the String fallback).
-- Type-level, NOT mass-applied per field — see [[feedback-fielddef-default-is-antipattern]].
profileTypeHasDefault : HasDefault ProfileType
profileTypeHasDefault = HasDefault { default = "person" }

inventoryEnforceHasDefault : HasDefault InventoryEnforce
inventoryEnforceHasDefault = HasDefault { default = "soft" }

purchaseStatusHasDefault : HasDefault PurchaseStatus
purchaseStatusHasDefault = HasDefault { default = "pending" }

-- forms-collapse Phase 4 Stage 3 — formScopeHasDefault RETIRED (FormScope was
-- the `form` entity's scope enum; the form entity is gone).

