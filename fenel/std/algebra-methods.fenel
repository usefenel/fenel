-- =========================================================================
-- module algebra where — the Functor / Monad method bodies, as typed functions.
--
-- typed-function-references · FenelModule-retirement Phase FM-retire-2
-- (2026-06-06). The 5 `defineFunction` specs in `engine/src/modules/algebra.ts`
-- are RETIRED; source of truth is this file — a `module algebra where` header +
-- the 5 generic-typed signatures + the 5 identity-facet blocks ABOVE the
-- (unchanged) bodies. The seam collapses to the `templates.ts` shape (0
-- `defineFunction`): it loads this file (functions + facets + bodies) and merges
-- the `algebra-instances.fenel` dispatch instances exactly as before.
--
-- The new dimension this phase proves: GENERIC-TYPED (polymorphic) signatures in
-- `.fenel` — bare type vars (`a` / `b` / `e`), applied `Maybe a` / `List a` /
-- `Result e a`, and an arrow-typed PARAM `(a -> b)`. This is exactly the pattern
-- the 204-fn `std` behemoth inherits, so it is the high-leverage dimension-prover.
--
-- Per the Fenel-first HARD RULE (AGENTS.md): these bodies are pure
-- (pattern-match + construct), so they MUST be Fenel, never TS. They compose
-- the canonical ADTs from foundation.fenel (`Maybe a = Nothing | Just a`,
-- `Result e a = Err e | Ok a`, `List a = Nil | Cons …`). The instances in
-- algebra-instances.fenel reference them by fnId STRING (the dispatch surface
-- applies an fnId method via `invokeFunction`), exactly as the
-- DecidableMembership / codec instances reference their `set:` / `codec:` fns.
--
-- ARGUMENT ORDER follows the class method signatures so dispatch applies the
-- args in the right order:
--   Functor.fmap : (a -> b) -> f a -> f b   →  fmap f m   →  body (f, m)
--   Monad.bind   : m a -> (a -> m b) -> m b →  bind m f   →  body (m, f)
--
-- APPLYING THE CONTINUATION uses the `$` apply operator (`f $ x`), not bare
-- juxtaposition (`f x`). `f` is a closure-valued PARAMETER, and bare `f x`
-- lowers to `{call: ["f", x]}` whose string head the evaluator resolves as a
-- registered fnId — which a local closure is not, so it would mis-resolve to
-- null. `f $ x` lowers to `{call: ["$", {var: "f"}, x]}`: the `$` apply
-- operator evaluates `{var: "f"}` to the bound closure and applies it. (The
-- native higher-order std fns sidestep this by taking the closure as an
-- argument — see `flatMap f m` below.)
--
-- List's Functor.fmap reuses `std:map` directly (its `(fn, arr)` order already
-- matches `fmap (f, m)`), and both Monoid instances reuse `std:concat` (which
-- is `List a -> List a -> List a` and special-cases JS strings). Only the
-- Maybe / Result fmap+bind and List's bind (arg-flip over `flatMap`) need
-- dedicated bodies, written below.
--
-- Identity parity: each fn carried label + description + category="algebra" +
-- tags. NO `@category` (derives from the `algebra:` id prefix, Phase 3j);
-- `@label`/`@description`/`@tags` reproduce the rest. Param labels DROP (the
-- seam's `fp` helper already set `label: Nothing`). The empty `default: Nothing`
-- boilerplate VANISHES; NO `@default`.
-- =========================================================================

module algebra where

-- Functor Maybe — map over the Just case, pass Nothing through.
maybeFmap : (a -> b) -> Maybe a -> Maybe b
@label "Maybe fmap"
@description "Functor Maybe: map over the Just case, pass Nothing through. ∀a b. (a → b) → Maybe a → Maybe b"
@tags "functor" "maybe"
maybeFmap f m = case m of
  Nothing -> Nothing
  Just x -> Just (f $ x)

-- Monad Maybe — feed the Just value into the continuation, short-circuit on Nothing.
maybeBind : Maybe a -> (a -> Maybe b) -> Maybe b
@label "Maybe bind"
@description "Monad Maybe: feed the Just value into the continuation, short-circuit on Nothing. ∀a b. Maybe a → (a → Maybe b) → Maybe b"
@tags "monad" "maybe"
maybeBind m f = case m of
  Nothing -> Nothing
  Just x -> f $ x

-- Functor Result — map over the Ok case, pass Err through.
resultFmap : (a -> b) -> Result e a -> Result e b
@label "Result fmap"
@description "Functor Result: map over the Ok case, pass Err through. ∀e a b. (a → b) → Result e a → Result e b"
@tags "functor" "result"
resultFmap f r = case r of
  Err e -> Err e
  Ok x -> Ok (f $ x)

-- Monad Result — feed the Ok value into the continuation, short-circuit on Err.
resultBind : Result e a -> (a -> Result e b) -> Result e b
@label "Result bind"
@description "Monad Result: feed the Ok value into the continuation, short-circuit on Err. ∀e a b. Result e a → (a → Result e b) → Result e b"
@tags "monad" "result"
resultBind r f = case r of
  Err e -> Err e
  Ok x -> f $ x

-- Monad List — map each element to a list and flatten (bind argument order).
-- List monadic bind = `flatMap` with the bind argument order (value first,
-- function second); `std:flatMap` is `(fn, arr)`, so flip. `flatMap` is a
-- native higher-order fn that applies its closure argument internally, so it
-- takes `f` as a plain argument (no `$` needed here).
listBind : List a -> (a -> List b) -> List b
@label "List bind"
@description "Monad List: map each element to a list and flatten (bind argument order). ∀a b. List a → (a → List b) → List b"
@tags "monad" "list"
listBind m f = flatMap f m

-- Foldable — `foldr : (a -> b -> b) -> b -> f a -> b` (unified-static-analysis
-- Phase 6c). The binop `f` is a BINARY closure-valued PARAM; applying it to two
-- args is `(f $ x) $ acc` — `$` (`($) f x = f x`) is right-associative, so the
-- explicit parens force left-application: `f $ x` curries to `b -> b`, then `$
-- acc` applies it. A bare `f x acc` would resolve `f` as a global fnId (it is a
-- local closure), and `f $ x $ acc` would parse as `f $ (x $ acc)` (wrong).
-- These mirror the trinity bodies' `$`-apply convention (algebra-methods header).

-- Foldable Maybe — fold the Just value into the seed; Nothing yields the seed.
maybeFoldr : (a -> b -> b) -> b -> Maybe a -> b
@label "Maybe foldr"
@description "Foldable Maybe: fold the Just value into the seed with the binop, pass the seed through on Nothing. ∀a b. (a → b → b) → b → Maybe a → b"
@tags "foldable" "maybe"
maybeFoldr f z m = case m of
  Nothing -> z
  Just x -> (f $ x) $ z

-- Foldable Result — fold the Ok value into the seed; Err yields the seed.
resultFoldr : (a -> b -> b) -> b -> Result e a -> b
@label "Result foldr"
@description "Foldable Result: fold the Ok value into the seed with the binop, pass the seed through on Err. ∀e a b. (a → b → b) → b → Result e a → b"
@tags "foldable" "result"
resultFoldr f z r = case r of
  Err e -> z
  Ok x -> (f $ x) $ z

-- Foldable List — the right-fold: `foldr f z [x0,x1,..] = f x0 (f x1 (.. z))`.
-- head/tail recursion (the array-repr List idiom; `tail` returns Maybe (List a)).
-- The accumulator is the recursive fold of the rest, then `f` combines the head
-- on top — proper foldr order (rightmost element touches the seed first).
listFoldr : (a -> b -> b) -> b -> List a -> b
@label "List foldr"
@description "Foldable List: right-fold over a list — f x0 (f x1 (… z)). ∀a b. (a → b → b) → b → List a → b"
@tags "foldable" "list"
listFoldr f z xs = case head xs of
  Nothing -> z
  Just x -> case tail xs of
    Nothing -> (f $ x) $ z
    Just rest -> (f $ x) $ (listFoldr f z rest)

-- toList / foldableLength — derived FROM `Foldable.foldr` (the brief's "toList /
-- length / sum derive from the primitive as ordinary std functions over
-- Foldable"). They work on ANY Foldable — nominal (`List`/`Maybe`/`Result`) AND
-- the derived structural instance (a user `Box a` / `Tree a`) — because they go
-- through method dispatch, not a per-type branch. The binop is passed by fn
-- reference; `foldr` applies it as `(f $ x) $ acc` internally.

-- foldablePrepend — `\x acc -> [x] ++ acc`, the `foldr` cons that builds a list
-- in element order. Internal binop for toList.
foldablePrepend : (x: a) -> (acc: List a) -> List a
@label "foldable: prepend"
@description "Phase 6c — cons an element onto the front of a list (foldr's list-builder). ∀a. a → List a → List a"
@tags "foldable" "internal"
foldablePrepend x acc = concat [x] acc

-- toList — collect a Foldable's elements into a List (left-to-right order).
toList : (xs: a) -> List b
@label "To list"
@description "Collect a Foldable's elements into a List in fold order. `toList = foldr (:) []`. Works on any Foldable via dispatch. ∀(f : * -> *) a. Foldable f ⇒ f a → List a"
@tags "foldable" "list"
toList xs = foldr foldablePrepend [] xs

-- foldableInc — `\_ n -> n + 1`, the element-ignoring counter. Internal binop
-- for foldableLength.
foldableInc : (x: a) -> (n: Number) -> Number
@label "foldable: inc"
@description "Phase 6c — increment the accumulator, ignoring the element (length's foldr step). ∀a. a → Number → Number"
@tags "foldable" "internal"
foldableInc x n = add n 1

-- foldableLength — count a Foldable's elements. `length = foldr (\_ n -> n+1) 0`.
-- Named `foldableLength` (not `length`) to avoid the builtin `length` op id.
foldableLength : (xs: a) -> Number
@label "Foldable length"
@description "Count a Foldable's elements via `foldr (\\_ n -> n+1) 0`. Works on any Foldable via dispatch. ∀(f : * -> *) a. Foldable f ⇒ f a → Number"
@tags "foldable" "length"
foldableLength xs = foldr foldableInc 0 xs

-- =========================================================================
-- Functor / Foldable / Traversable (Map k) — array-substrate Phase 1a. The
-- `$map`/`Map k` former joins the algebra: `fmap`/`foldr`/`traverse` over a
-- `$map`-shaped value map/fold/traverse the VALUES, keys fixed. `Vec n a = $map
-- (Fin n) a` / `Array` / a user `Map String User` all inherit through the ONE
-- structural `(Map k)` instance (system-entities.ts, keyed
-- `{$pattern:"engine:isMapShaped"}`) — NO per-type code.
--
-- THE DISPATCH FACT (the Phase-1a Step-0 PROBE, verdict STRUCTURAL): runtime
-- method dispatch keys on `typeConstructorOf(value)` (effect-dispatch.ts), which
-- reflects a value's `$tag`. A `$map` value dispatches the structural instance
-- when it carries a `$tag` naming a registered type whose schema is bare-`$map`
-- (so `typeConstructorOf → name → getEntityTypeByName → $map → TtMap → isMapShaped
-- True`). The `$tag` therefore RIDES ON the runtime value alongside the entries —
-- it is METADATA, not a map entry. So these bodies treat `$`-prefixed keys as
-- metadata: `fmap` PASSES THEM THROUGH unchanged (preserving `$tag` ⇒ the result
-- is still a same-typed, re-dispatchable map ⇒ the Functor identity law holds),
-- `foldr`/`traverse` SKIP them (they fold/traverse only the data values). A bare
-- UNTAGGED map (a locale-string `{en,fr}`) has no reflectable identity ⇒ no
-- dispatch (universal — any untagged record is the same); the bodies still run
-- correctly when invoked directly (no `$`-key to pass through).
--
-- A `$map` value's runtime rep is the JS-object of entries; `std:entries`
-- projects it to `List {key, value}` (the iteration primitive), `std:fromEntries`
-- rebuilds it (the inverse). UNLIKE the derived Functor/Foldable bridges (which
-- marshal a `$`-keyed SCHEMA to walk a variant's cases), the map operation needs
-- NO schema — it iterates the value's entries directly — so these are plain
-- `algebra:*` bodies, not the `engine:derive*` reflection bridges. `traverse`
-- (which needs the applicative's pure/ap, unreachable from a 2-arg `.fenel` body)
-- DELEGATES to the LIST nominal traverse over the value list, then `fmap`s the
-- key-rebuild back through the applicative — ZERO new TS, the g-threading problem
-- solved by composition.
--
-- The continuation `g` (Functor) / binop `f` (Foldable) is a closure-valued PARAM
-- ⇒ applied via `$` (the algebra-methods closure-apply convention; a bare `g x`
-- would resolve `g` as a global fnId). `entries`/`fromEntries`/`map`/`filter`/
-- `startsWith`/`not`/`zipWith` are std natives (bare codeName, the algebra-body
-- idiom); `listFoldr` (above) + `Traversable.traverse`/`Functor.fmap` (dispatch)
-- are reused.
-- =========================================================================

-- Functor (Map k) — map `g` over the present values, keys fixed; pass `$`-keyed
-- metadata (`$tag`) through unchanged.
mapFmap : (a -> b) -> Map k a -> Map k b
@label "Map fmap"
@description "Functor (Map k): map the function over the present values, keys fixed; `$`-keyed metadata ($tag) passes through so the result stays a same-typed map (the identity law holds). `Vec`/`Array`/user `Map K V` all inherit through the structural (Map k) instance. ∀k a b. (a → b) → Map k a → Map k b"
@tags "functor" "map"
mapFmap g m = fromEntries (map (mapFmapStep g) (entries m))

-- mapFmapStep — one entry: a `$`-keyed metadata entry passes through unchanged;
-- a data entry's value is remapped (key fixed). Internal `std:map` step for
-- mapFmap. `g` rides in via partial application and is applied via `$`.
mapFmapStep : (g: a) -> (e: { key: String, value: b }) -> { key: String, value: c }
@label "map-fmap: step"
@description "Phase 1a — re-map one map entry's value (key fixed), or pass a `$`-keyed metadata entry through unchanged; mapFmap's std:map step. ∀a b c. a → {key: String, value: b} → {key: String, value: c}"
@tags "functor" "map" "internal"
mapFmapStep g e =
  if startsWith e.key "$"
    then e
    else { key = e.key, value = g $ e.value }

-- mapEntryIsData — is this entry a DATA entry (not `$`-keyed metadata)? The
-- foldr/traverse filter predicate. Internal helper.
mapEntryIsData : (e: { key: String, value: a }) -> Bool
@label "map: entryIsData"
@description "Phase 1a — is a map entry a data entry (its key is not `$`-prefixed metadata like $tag)? The foldr/traverse filter. ∀a. {key: String, value: a} → Bool"
@tags "map" "internal"
mapEntryIsData e = not (startsWith e.key "$")

-- mapEntryValue — project one entry's value (drops the key). Internal helper for
-- mapFoldr / mapTraverse value-list extraction.
mapEntryValue : (e: { key: String, value: a }) -> a
@label "map: entryValue"
@description "Phase 1a — project a map entry's value (drops the key); the foldr/traverse value extractor. ∀a. {key: String, value: a} → a"
@tags "map" "internal"
mapEntryValue e = e.value

-- Foldable (Map k) — right-fold the binop over the present DATA values. The fold
-- is over the ACTUAL entries (always finite at runtime), so it is total + always
-- valid (no enumerability needed — unlike `tabulate`, Phase 1b). Reuses the
-- same-module `listFoldr` over the projected value list.
mapFoldr : (a -> b -> b) -> b -> Map k a -> b
@label "Map foldr"
@description "Foldable (Map k): right-fold the binop over the present data values (keys + `$`-keyed metadata ignored). The fold is over the actual finite entries — total, no enumerability needed. ∀k a b. (a → b → b) → b → Map k a → b"
@tags "foldable" "map"
mapFoldr f z m = listFoldr f z (map mapEntryValue (filter mapEntryIsData (entries m)))

-- Traversable (Map k) — traverse `g` over the present DATA values, collecting in
-- the applicative. DELEGATES the effect-sequencing to the LIST nominal traverse
-- over the value list (which resolves the applicative's pure/ap via the bridge),
-- then `Functor.fmap`s the key-rebuild (`mapZipKeys keys`) back through the
-- applicative — `g (List b) → g (Map k b)`. So `traverse mkJust {a:1,b:2}` =
-- `Just {a:.., b:..}`; one `Nothing` short-circuits the whole map. The applicative
-- `g` is resolved from the values list (the bridge's non-empty reflection); an
-- empty data map rides the documented all-empty fence (returns the empty list
-- wrapped, the List-traverse contract). The output drops `$`-keyed metadata (the
-- key-rebuild starts from data keys only) — acceptable, the result is freshly
-- built inside the effect.
mapTraverse : (a -> b) -> Map k a -> b
@label "Map traverse"
@description "Traversable (Map k): traverse the function over the present data values, collecting in the applicative; keys are re-zipped through the effect. Delegates the sequencing to the List nominal traverse (resolves the applicative pure/ap) + Functor.fmap of the key-rebuild — `g (List b) → g (Map k b)`. ∀k (g : * -> *) a b. Applicative g ⇒ (a → g b) → Map k a → g (Map k b)"
@tags "traversable" "map"
mapTraverse g m =
  let dataEntries = filter mapEntryIsData (entries m)
  let keys = map mapEntryKey dataEntries
  let vals = map mapEntryValue dataEntries
  fmap (mapZipKeys keys) (traverse g vals)

-- mapEntryKey — project one entry's key. Internal helper for mapTraverse's
-- key-list extraction.
mapEntryKey : (e: { key: String, value: a }) -> String
@label "map: entryKey"
@description "Phase 1a — project a map entry's key; mapTraverse's key extractor. ∀a. {key: String, value: a} → String"
@tags "map" "internal"
mapEntryKey e = e.key

-- mapZipKeys — rebuild a map from a key list + a value list (the post-traverse
-- re-key, run INSIDE the applicative via Functor.fmap). `zipWith` is a native
-- HOF (takes its closure arg directly — no `$`). Internal helper.
mapZipKeys : (keys: List String) -> (vals: List a) -> Map String a
@label "map: zipKeys"
@description "Phase 1a — rebuild a map from aligned key + value lists (mapTraverse's in-applicative re-key). ∀a. List String → List a → Map String a"
@tags "map" "internal"
mapZipKeys keys vals = fromEntries (zipWith mapMakeEntry keys vals)

-- mapMakeEntry — pair one key + value into a `{key, value}` entry. Internal
-- binop for mapZipKeys's `zipWith`.
mapMakeEntry : (k: String) -> (v: a) -> { key: String, value: a }
@label "map: makeEntry"
@description "Phase 1a — pair a key + value into a {key, value} entry; mapZipKeys's zipWith step. ∀a. String → a → {key: String, value: a}"
@tags "map" "internal"
mapMakeEntry k v = { key = k, value = v }

-- =========================================================================
-- Representable (Vec) — array-substrate Phase 1b. The two halves of the
-- `Vec n a ≅ Fin n → a` isomorphism: `index` (lookup) + `tabulateVec` (build).
-- The class lives in fenel/std/algebra.fenel; the `Representable Vec` instance
-- (algebra-instances.fenel) points `index` here. `tabulate` is return-position
-- (it cannot dispatch on a value AND a bare index-fn carries no shape `n`) — so
-- the value-level builder is the standalone `tabulateVec n g`, NOT a dispatched
-- method (the Monad.return / Applicative.pure precedent).
-- =========================================================================

-- index — TOTAL lookup at an index (Representable Vec). The Vec value is a map
-- keyed by stringified indices ("0", "1", …) — this is true of BOTH the keyed
-- `{$tag:"Vec", "0":…}` dispatch repr AND the JS-array `$opaque.repr` view (a JS
-- array carries the same "0"/"1"/… keys), so `mapGet`-by-`toString` indexes
-- EITHER repr uniformly (PROBE-confirmed). Arrays are TOTAL functions ⇒ `i :
-- Fin n` is in-bounds by construction (D3); the partial `std:mapGet` is the impl
-- primitive, peeled under the in-domain assumption (vecIndexTotal).
vecIndex : Vec n a -> Number -> a
@label "Vec index"
@description "Representable Vec (array-substrate Phase 1b): TOTAL lookup of the value at index `i` in a `Vec n a = $map (Fin n) a`. Indexes by the stringified index over `std:mapGet` (works on both the keyed `{$tag:\"Vec\"}` dispatch repr and the JS-array `$opaque.repr` view — both carry \"0\"/\"1\"/… keys). Arrays are total functions ⇒ `i : Fin n` is in-bounds by construction (D3); the partial mapGet Maybe is peeled under the in-domain assumption. ∀n a. Vec n a → Fin n → a"
@tags "representable" "array" "vec"
vecIndex v i = vecIndexTotal (mapGet v (toString i))

-- vecIndexTotal — peel a guaranteed-Just (the in-domain index assumption, D3).
-- The Nothing arm is UNREACHABLE for an in-bounds `Fin n` index; it diverges
-- (Fenel's ⊥ — the faithful total-function-on-its-domain encoding, the analog of
-- Haskell `(!!)`'s out-of-bounds bottom). Never hit for a well-typed call.
vecIndexTotal : (m: Maybe a) -> a
@label "Vec index: total peel"
@description "Peel a `std:mapGet` Maybe under the Representable-Vec in-domain assumption (D3 — arrays are total functions, so a `Fin n` index is in-bounds by construction): Just x ⇒ x; Nothing ⇒ ⊥ (diverges — UNREACHABLE for an in-bounds index, the faithful total-function-on-its-domain encoding). Internal helper to vecIndex. ∀a. Maybe a → a"
@tags "representable" "array" "internal"
vecIndexTotal m = case m of
  Just x -> x
  Nothing -> vecIndexTotal m

-- tabulateVec — BUILD a `Vec n a` from an index function (the `tabulate` half of
-- Representable, taking `n` explicitly since the class `tabulate` is return-
-- position + a bare index-fn carries no shape). `tabulateVec n g = map g
-- [0..n-1]` — enumerate the index domain, apply `g` at each index. Produces the
-- JS-array `$opaque.repr` view (consistent with the Phase-1b membership floor,
-- which checks the array repr); `vecIndex` reads that repr back, so
-- `vecIndex (tabulateVec n g) i ≡ g i` round-trips (PROBE-confirmed). The index
-- domain is built directly (`rangeUpTo`, a static `[0..n-1]`) rather than via
-- `enumerableSet`-over-`Fin n` — `enumerableSet` needs a `$`-keyed `Fin` TYPE a
-- `.fenel` body cannot author; for a STATIC literal `n` the direct range is the
-- Fenel-first form (the `enumerableSet` path is the symbolic-`n` route, Phase 5).
tabulateVec : (n: Number) -> (g: (Number -> a)) -> Vec n a
@label "Vec tabulate"
@description "Representable Vec (array-substrate Phase 1b): BUILD a `Vec n a` by applying the index function `g` at every index `[0..n-1]` (`tabulateVec n g = map g (rangeUpTo n)`). The value-level `tabulate` builder — taking `n` explicitly because the class `tabulate : (i -> a) -> f a` is return-position (cannot dispatch on a value) and a bare index-fn carries no shape `n` (the Applicative.pure / Monad.return precedent). Produces the JS-array `$opaque.repr` view; `vecIndex` reads it back ⇒ `index (tabulate g) i ≡ g i`. Static `[0..n-1]` via rangeUpTo (the symbolic-`n` enumerableSet route is Phase 5). ∀n a. Number → (Fin n → a) → Vec n a"
@tags "representable" "array" "vec"
tabulateVec n g = map g (rangeUpTo n)

-- rangeUpTo — the half-open index list `[0, 1, …, n-1]` (the `Fin n` index
-- domain, statically enumerated). The direct Fenel-first range builder for
-- tabulateVec's index enumeration.
rangeUpTo : (n: Number) -> List Number
@label "range up to"
@description "The half-open integer index list `[0, 1, …, n-1]` — the static `Fin n` index domain for tabulateVec (array-substrate Phase 1b). Direct Fenel range (the symbolic-`n` enumerableSet-over-Fin route is Phase 5). ∀. Number → List Number"
@tags "array" "internal"
rangeUpTo n = rangeFrom 0 n

-- rangeFrom — `[i, i+1, …, n-1]` (the rangeUpTo recursion). Internal helper.
rangeFrom : (i: Number) -> (n: Number) -> List Number
@label "range from"
@description "Build `[i, i+1, …, n-1]` by upward recursion; rangeUpTo's worker (array-substrate Phase 1b). ∀. Number → Number → List Number"
@tags "array" "internal"
rangeFrom i n = if lt i n then concat [i] (rangeFrom (add i 1) n) else []

-- =========================================================================
-- Lift (broadcasting / rank polymorphism) — array-substrate Phase 2. The
-- `Lift f` class (fenel/std/algebra.fenel) declares ONE method, `zip2`; the
-- structural `Lift (Map k)` instance (system-entities.ts) points it HERE. The
-- SOUL of array languages, made dispatch: `zip2 add vec vec` zips element-wise,
-- `zip2 add scalar vec` BROADCASTS the scalar over the frame. design/array-
-- substrate.md §2c.
--
-- `liftZip2` is a RANK-POLYMORPHIC DRIVER (the Phase-2 D1 finding: `zip2` cannot
-- be pure arg-1 dispatch — a scalar-first `zip2 f 5 vec` has no `Lift` instance
-- at arg 1 — so the broadcast is a std driver that routes on the rank-0-vs-≥1
-- KIND test + RECURSES). The kind test is `liftIsScalar` (a scalar = rank-0 =
-- `Array [] a = a`, a bare element with NO data entries; a rank-≥1 `{$tag:"Vec"}`
-- has data entries). This is §2c's KIND difference (scalar≠vector), NOT a
-- hand-rolled shape-EQUALITY `if` (that is the Phase-4 conformance arm — the
-- fence). Same-length rank-≥1 arrays zip key-aligned; DIFFERENT-length is the
-- Phase-4 conformance question (Phase 2 assumes conformant — the `vecIndex`
-- in-domain-assumption precedent; `zipWith` position-aligns).
--
-- The closure binop `f` rides via partial application + `$`-apply (the algebra-
-- methods convention): `(f $ x) $ y` at the leaf; `liftZip2 f x` / `liftZipEntry
-- f` / `liftZip2RightScalar f y` are partials passed to the native HOFs
-- `Functor.fmap` / `zipWith` (the `mapFmapStep g` / `mapZipKeys` precedent). The
-- recursion bottoms out when BOTH operands are scalars.
--
-- 🔑 PHASE-4 VERDICT (Q1 = A — the realization SETTLED, design § 9 /
-- notes/phase-4-prototype.md). This driver IS the Naperian/representable broadcast
-- formula `zip2 f x y = if both-scalar then f x y else tabulate (jointShape x y)
-- (λi → zip2 f (index x i) (index y i))`, where a SCALAR is a CONSTANT FUNCTOR
-- (`index scalar _ = scalar`). The correspondence is EXACT (prototype-confirmed,
-- byte-identical on all four behaviors): `liftIsScalar`-routing IS `jointShape`;
-- the `Functor.fmap` / `zipWith` frame-walk IS the `tabulate` over the joint frame;
-- the scalar-replication arm (`fmap (liftZip2 f x) y`) IS `index scalar _ = scalar`.
-- So the Phase-2 "multiple-dispatch can't be declarative" surprise was a FALSE
-- ALARM — broadcasting is NOT a dispatch problem (no dispatch-position is a pair);
-- it is `tabulate∘jointShape∘index`, where the only "instance" is the constant
-- functor (single-arg) and `jointShape` is a plain resolver. Approach B (multiple
-- dispatch as a language primitive) is REJECTED — it would change the dispatch
-- substrate for zero capability A doesn't give free. The literal `tabulate`-rebuild
-- rewrite is Phase-7-gated (a `tabulateVec` rebuild emits the JS-array repr, NO
-- `$tag` ⇒ would break the re-dispatch this fmap/zipWith form preserves; a
-- tag-preserving `tabulate` is the Phase-7 single-repr unification). Until then this
-- IS A's faithful operational realization — re-framed, not retired. The general
-- arbitrary-cell-rank form is the `rank` adverb (Q4, above).
-- =========================================================================

-- liftIsScalar — the rank-0 KIND test: a value is a SCALAR (rank-0) iff it has
-- NO data entries. A scalar (`5`, `"x"`, `True`) has `entries` = [] (PROBE-
-- confirmed); a rank-≥1 `{$tag:"Vec", "0":…}` / JS-array `[…]` has data entries
-- (the `$tag` is `$`-keyed metadata, dropped by `mapEntryIsData`). NOT a shape-
-- equality check (§2c kind difference, not the Phase-4 conformance fence).
liftIsScalar : (v: a) -> Bool
@label "lift: is scalar"
@description "The rank-0 KIND test (array-substrate Phase 2): is a value a SCALAR (rank-0, `Array [] a = a`)? True iff it has NO data entries — a scalar's `entries` is [] (a number/string/bool), a rank-≥1 `Vec`/array has data entries (the `$tag` metadata is dropped by mapEntryIsData). The §2c kind difference (scalar≠vector) the broadcast routes on; NOT a shape-equality conformance check (that is Phase 4). ∀a. a → Bool"
@tags "lift" "array" "internal"
liftIsScalar v = eq (length (filter mapEntryIsData (entries v))) 0

-- liftEntryIsMeta — is an entry `$`-keyed metadata (the `$tag`)? The complement
-- of mapEntryIsData; the filter that CARRIES the `$tag` through liftZipAligned so
-- the zipped result stays a same-typed, re-dispatchable map (the mapFmap
-- pass-through precedent — the Functor/Lift identity is preserved).
liftEntryIsMeta : (e: { key: String, value: a }) -> Bool
@label "lift: entryIsMeta"
@description "Is a map entry `$`-keyed metadata (e.g. $tag)? The complement of mapEntryIsData; liftZipAligned's `$tag`-carry filter so the zip result stays a same-typed re-dispatchable map (the mapFmap pass-through precedent). ∀a. {key: String, value: a} → Bool"
@tags "lift" "map" "internal"
liftEntryIsMeta e = startsWith e.key "$"

-- zip2 (Lift Map k) — the RANK-POLYMORPHIC broadcast driver. Routes on the
-- rank of each operand (the liftIsScalar KIND test) and RECURSES:
--   both rank-0 (scalars)  ⇒ apply the binop:      (f $ x) $ y
--   x scalar, y rank-≥1    ⇒ replicate x into y:    fmap (\yi -> zip2 f x yi) y
--   x rank-≥1, y scalar    ⇒ replicate y into x:    fmap (\xi -> zip2 f xi y) x
--   both rank-≥1           ⇒ key-aligned, recurse:  zipWith (\xi yi -> zip2 f xi yi)
-- So a nested `Array [2,3]` broadcasts through EVERY rank (the recursion descends
-- the frame). Split into XScalar/XStruct helpers to keep the layout flat.
liftZip2 : (a -> b -> c) -> f a -> f b -> f c
@label "Lift zip2"
@description "Lift (Map k) (array-substrate Phase 2): the rank-polymorphic broadcast — lift a binop over two operands, REPLICATING a rank-0 (scalar) operand into the other's frame. `zip2 add vec vec` zips element-wise; `zip2 add scalar vec` broadcasts; a nested `Array` broadcasts through every rank (the driver recurses on the liftIsScalar kind test). Same-length rank-≥1 arrays zip key-aligned; different-length is the Phase-4 conformance question (assumed conformant here). ∀(f : * -> *) a b c. Lift f ⇒ (a → b → c) → f a → f b → f c"
@tags "lift" "array" "broadcast"
liftZip2 f x y =
  if liftIsScalar x then liftZip2XScalar f x y
  else liftZip2XStruct f x y

-- liftZip2XScalar — the x-is-scalar arm: both scalar ⇒ apply the binop; else
-- replicate x into y's frame (fmap the recursion, which descends y's ranks).
liftZip2XScalar : (a -> b -> c) -> a -> f b -> f c
@label "lift-zip2: x scalar"
@description "Phase 2 — liftZip2's x-is-scalar arm: both rank-0 ⇒ `(f $ x) $ y`; else replicate the scalar x into y's frame via `Functor.fmap (liftZip2 f x) y` (recurse, descending y's ranks). Internal helper. ∀(f : * -> *) a b c. (a → b → c) → a → f b → f c"
@tags "lift" "array" "internal"
liftZip2XScalar f x y =
  if liftIsScalar y then (f $ x) $ y
  else fmap (liftZip2 f x) y

-- liftZip2XStruct — the x-is-rank-≥1 arm: y scalar ⇒ replicate y into x's frame;
-- else both rank-≥1 ⇒ key-aligned zip (recurse per element).
liftZip2XStruct : (a -> b -> c) -> f a -> b -> f c
@label "lift-zip2: x struct"
@description "Phase 2 — liftZip2's x-is-rank-≥1 arm: y scalar ⇒ replicate y into x's frame via `Functor.fmap (liftZip2RightScalar f y) x`; else both rank-≥1 ⇒ key-aligned recursive zip (liftZipAligned). Internal helper. ∀(f : * -> *) a b c. (a → b → c) → f a → b → f c"
@tags "lift" "array" "internal"
liftZip2XStruct f x y =
  if liftIsScalar y then fmap (liftZip2RightScalar f y) x
  else liftZipAligned f x y

-- liftZip2RightScalar — `\xi -> zip2 f xi y` (y the held scalar). The flipped
-- recursion for the x-rank-≥1/y-scalar arm (partial-applied `liftZip2RightScalar
-- f y` is the fmap step). Internal helper.
liftZip2RightScalar : (a -> b -> c) -> b -> a -> c
@label "lift-zip2: right scalar"
@description "Phase 2 — `\\xi -> zip2 f xi y` with y the held scalar; the fmap step for liftZip2's x-rank-≥1/y-scalar arm. Internal helper. ∀a b c. (a → b → c) → b → a → c"
@tags "lift" "array" "internal"
liftZip2RightScalar f y xi = liftZip2 f xi y

-- liftZipAligned — both operands rank-≥1: zip the DATA entries key-aligned (the
-- mapZipKeys/zipWith shape), RECURSING liftZip2 per element pair (so nested ranks
-- descend), then CARRY x's `$`-keyed metadata (the `$tag`) so the result stays a
-- same-typed re-dispatchable map. Position-aligned (same-length assumed — the
-- Phase-4 conformance arm adds the key-EQUALITY guard).
liftZipAligned : (a -> b -> c) -> f a -> f b -> f c
@label "lift-zip2: aligned"
@description "Phase 2 — both operands rank-≥1: key-aligned zip of the data entries (recursing liftZip2 per element so nested ranks descend), carrying x's `$`-keyed metadata ($tag) through so the result re-dispatches (the mapFmap pass-through precedent). Position-aligned; different-length is the Phase-4 conformance arm. Internal helper. ∀(f : * -> *) a b c. (a → b → c) → f a → f b → f c"
@tags "lift" "array" "internal"
liftZipAligned f x y =
  fromEntries (concat (zipWith (liftZipEntry f) (filter mapEntryIsData (entries x)) (filter mapEntryIsData (entries y))) (filter liftEntryIsMeta (entries x)))

-- liftZipEntry — pair two aligned entries, recursing liftZip2 on their values
-- (so a nested rank descends), keeping x's key. liftZipAligned's zipWith step.
liftZipEntry : (a -> b -> c) -> (ex: { key: String, value: a }) -> (ey: { key: String, value: b }) -> { key: String, value: c }
@label "lift-zip2: entry"
@description "Phase 2 — pair two aligned map entries, recursing liftZip2 on their values (nested ranks descend), keeping x's key; liftZipAligned's zipWith step. ∀a b c. (a → b → c) → {key, value: a} → {key, value: b} → {key, value: c}"
@tags "lift" "array" "internal"
liftZipEntry f ex ey = { key = ex.key, value = liftZip2 f ex.value ey.value }

-- each — the APL map adverb `¨`. `each = fmap` (design §2c) — a DERIVED std alias
-- over `Functor.fmap`, NOT a `Lift` class method (it adds no new dispatch
-- behavior; the toList/sequenceA derived-std-fn precedent, D3). Works on ANY
-- Functor via dispatch (the structural `(Map k)` instance for Vec/Array, the
-- nominal instances for Maybe/List/Result, the derived for user types).
each : (a -> b) -> f a -> f b
@label "Each"
@description "The map adverb (`¨`) — apply a function to every element of a structure. `each = fmap`, a derived std alias over `Functor.fmap` (array-substrate Phase 2, D3 — not a Lift method, it adds no new dispatch). Works on any Functor via dispatch. ∀(f : * -> *) a b. Functor f ⇒ (a → b) → f a → f b"
@tags "lift" "functor" "array"
each g xs = fmap g xs

-- =========================================================================
-- Rank — the general rank-polymorphic application adverb (`f⍤r`), array-substrate
-- Phase 4 (THE CRUX, Q4). `rank r f x` applies a cell-rank-`r` function `f` across
-- the leading FRAME axes of `x`, framing the rest — the full Remora application
-- discipline. The natural GENERALIZATION of A's representable formula (design
-- § 9 / notes/phase-4-prototype.md): when `x`'s rank ≤ `r`, `x` IS a cell ⇒ apply
-- `f`; else descend ONE frame axis (`Functor.fmap (rank r f)`) and recurse. So
-- `each` (= `fmap`) is the rank-(r−1) special case; `rank 0 f` maps `f` over every
-- SCALAR cell (the deepest rank); `rank 1 f` frames a row-function over the leading
-- axis (`rank 1 sumRow (Array[2,3]) = {6, 15}`, prototype-confirmed). A plain std
-- HOF (NOT a `Lift`/class method — it adds no new dispatch, the `each`/`sequenceA`
-- derived-std precedent). Composes with conformance (`engine:conformable` decides
-- whether two operands' frames match) and broadcast (Q1 — `rank` + `zip2` share the
-- `arrayRank`/frame-descent vocabulary).
--
-- The cell fn `f` is a closure-valued PARAM ⇒ applied via `$` (the closure-apply
-- convention); `rank r f` is a 2-arg partial passed to the native HOF `Functor.fmap`
-- (the `liftZip2 f x` / `mapFmapStep g` precedent — `fmap` preserves the `$tag` so
-- the framed result re-dispatches). `not (lt r (arrayRank x))` = `arrayRank x ≤ r`
-- (`le` is not a std native; `lt`/`add`/`not` are).
rank : (r: Number) -> (f: (a -> b)) -> (xs: c) -> d
@label "Rank"
@description "The rank adverb (`f⍤r`) — apply a cell-rank-`r` function across the leading frame axes of an array, framing the rest (array-substrate Phase 4, the general rank-polymorphic application discipline). `each`/`fmap` is the rank-(r−1) special case; `rank 0 f` maps over every scalar cell; `rank 1 f` frames a row-function over the leading axis. The generalization of the representable broadcast formula. ∀(f : * -> *) a b. Number → (a → b) → f a → f b (rank-polymorphic)"
@tags "rank" "array" "broadcast"
rank r f xs =
  if not (lt r (arrayRank xs))
    then f $ xs
    else fmap (rank r f) xs

-- arrayRank — the NESTING DEPTH of an array value (rank-substrate Phase 4): a
-- scalar (rank-0 `Array [] a = a`, NO data entries — the `liftIsScalar` kind test)
-- has rank 0; a rank-≥1 `{$tag:"Vec"}` / array has rank `1 + arrayRank (first
-- cell)`. The frame-counter `rank` routes on. Reuses `liftIsScalar` (the Phase-2
-- rank-0 detector) + the `entries`/`mapEntryIsData` data-entry projection.
arrayRank : (x: a) -> Number
@label "Array rank"
@description "The nesting depth (rank) of an array value (array-substrate Phase 4): a scalar (no data entries, the liftIsScalar kind test) ⇒ 0; a rank-≥1 Vec/array ⇒ 1 + arrayRank (first cell). The frame-counter the `rank` adverb routes on. ∀a. a → Number"
@tags "rank" "array" "internal"
arrayRank x =
  if liftIsScalar x
    then 0
    else add 1 (arrayRankCell (head (filter mapEntryIsData (entries x))))

-- arrayRankCell — the rank of an array's first DATA cell (or 0 if there is none —
-- unreachable for a non-scalar, since liftIsScalar already caught the empty case).
-- arrayRank's recursion step over the `head`-Maybe. Internal helper.
arrayRankCell : (mc: Maybe a) -> Number
@label "array-rank: cell"
@description "array-substrate Phase 4 — the rank of an array's first data cell (Just e ⇒ arrayRank e.value; Nothing ⇒ 0, unreachable for a non-scalar). arrayRank's recursion step over the head-Maybe. Internal helper. ∀a. Maybe a → Number"
@tags "rank" "array" "internal"
arrayRankCell mc = case mc of
  Nothing -> 0
  Just e -> arrayRank e.value

-- =========================================================================
-- Applicative — `pure : a -> f a` + `ap : f (a -> b) -> f a -> f b` (`<*>`)
-- (unified-static-analysis Phase 6d). The standard rung between Functor and
-- Monad. `ap` is the dispatchable method (arg position 0); `pure` is
-- return-position (rides on the instance as a constant handle, the `mempty`
-- precedent — the Traversable bridge resolves it from the registry). These are
-- ordinary 2-arg / 1-arg dispatch bodies (no `g`-threading problem). The wrapped
-- function `g` is applied to the wrapped value via `$` (the algebra-methods
-- closure-apply convention).
-- =========================================================================

-- Applicative Maybe — apply a wrapped fn to a wrapped value; Nothing on either side.
maybeAp : Maybe (a -> b) -> Maybe a -> Maybe b
@label "Maybe ap"
@description "Applicative Maybe: apply a wrapped function to a wrapped value; Nothing if either side is Nothing. ∀a b. Maybe (a → b) → Maybe a → Maybe b"
@tags "applicative" "maybe"
maybeAp mf mx = case mf of
  Nothing -> Nothing
  Just g -> case mx of
    Nothing -> Nothing
    Just x -> Just (g $ x)

-- Applicative Maybe — `pure x = Just x`. Return-position (not dispatched).
maybePure : a -> Maybe a
@label "Maybe pure"
@description "Applicative Maybe: lift a value into Maybe — `pure x = Just x`. Return-position (rides on the instance, not dispatched). ∀a. a → Maybe a"
@tags "applicative" "maybe"
maybePure x = Just x

-- Applicative List — cartesian: apply every wrapped fn to every wrapped value.
-- `ap fs xs = [g x | g <- fs, x <- xs]` = flatMap (\g -> map g xs) fs. The inner
-- `map g xs` applies the closure g to each x (std:map applies its fn arg), and
-- flatMap concatenates the per-fn rows — no nested lambda needed.
listAp : List (a -> b) -> List a -> List b
@label "List ap"
@description "Applicative List: cartesian application — apply every wrapped function to every wrapped value. `ap fs xs = [g x | g <- fs, x <- xs]`. ∀a b. List (a → b) → List a → List b"
@tags "applicative" "list"
listAp fs xs = flatMap (listApRow xs) fs

-- listApRow — apply ONE wrapped function to every element of xs (the inner map
-- of the cartesian product). `xs` first so `listApRow xs` partial-applies as the
-- flatMap step. Internal helper.
listApRow : (xs: List a) -> (g: a) -> List b
@label "list-ap: row"
@description "Phase 6d — apply one function to every element of a list (listAp's inner map). Helper; tagged internal."
@tags "applicative" "list" "internal"
listApRow xs g = map g xs

-- Applicative List — `pure x = [x]`. Return-position (not dispatched).
listPure : a -> List a
@label "List pure"
@description "Applicative List: lift a value into a singleton list — `pure x = [x]`. Return-position (rides on the instance, not dispatched). ∀a. a → List a"
@tags "applicative" "list"
listPure x = concat [x] []

-- Applicative Result — apply a wrapped fn to a wrapped value; Err short-circuits
-- (function side first).
resultAp : Result e (a -> b) -> Result e a -> Result e b
@label "Result ap"
@description "Applicative Result: apply a wrapped function to a wrapped value; Err short-circuits (function side first). ∀e a b. Result e (a → b) → Result e a → Result e b"
@tags "applicative" "result"
resultAp rf rx = case rf of
  Err e -> Err e
  Ok g -> case rx of
    Err e2 -> Err e2
    Ok x -> Ok (g $ x)

-- Applicative Result — `pure x = Ok x`. Return-position (not dispatched).
resultPure : a -> Result e a
@label "Result pure"
@description "Applicative Result: lift a value into Result — `pure x = Ok x`. Return-position (rides on the instance, not dispatched). ∀e a. a → Result e a"
@tags "applicative" "result"
resultPure x = Ok x

-- =========================================================================
-- sequenceA — `sequenceA = traverse id`, derived FROM `Traversable.traverse` as
-- an ordinary std fn over `Traversable` (unified-static-analysis Phase 6d, the
-- `toList`/`foldableLength` precedent). `sequenceA : f (g a) -> g (f a)` flips a
-- structure-of-effects into an effect-of-structure. Works on ANY Traversable via
-- dispatch (nominal `List`/`Maybe`/`Result` + the derived structural instance),
-- because it goes through `Traversable.traverse`, not a per-type branch. `id`
-- (std identity) is the trivial effectful fn — each element IS already a `g`
-- value, so `traverse id` resolves `g` from the first element (the bridge's
-- non-empty reflection; an empty `sequenceA []` is the documented all-empty
-- fence, D-6d-2).
-- =========================================================================
sequenceA : (xs: a) -> b
@label "Sequence applicative"
@description "Flip a structure-of-effects into an effect-of-structure. `sequenceA = traverse id`. Works on any Traversable via dispatch. ∀(f : * -> *) (g : * -> *) a. (Traversable f, Applicative g) ⇒ f (g a) → g (f a)"
@tags "traversable" "sequence"
sequenceA xs = traverse id xs

-- =========================================================================
-- The combinator library — array-substrate Phase 3 (`reduce`/`scan`/`transpose`/
-- `reshape`). The array VOCABULARY, composed entirely from the shipped algebra
-- (`Foldable.foldr` / `Foldable.toList` / `Representable.index` (`vecIndex`) /
-- `tabulateVec` / `rangeUpTo` / the std HOFs) — NO new engine TS, NO new
-- `$`-constructor. design/array-substrate.md §1/§9 + notes/phase-3-prototype.md
-- (the Step-0 design lock).
--
-- STEP-0 VERDICT (notes/phase-3-prototype.md): NESTED stays locked (§6 OQ#2 does
-- NOT flip). `transpose` (the Naperian double-tabulate) + `reshape` (flatten +
-- re-chunk) compose CLEANLY from the nested `Representable` vocabulary on the
-- static `Array [2,3]` corpus — a flat `$map (Fin m × Fin n)` product-index buys
-- nothing (and would need a Rom-gated `$`-key former + fork the representation).
-- REDUCE/SCAN AXIS: reduce over the OUTER frame (rows) via `Foldable.foldr`;
-- inner/axis reduction composes with the shipped `rank r` adverb (Phase 4) — no
-- new axis machinery on `reduce` itself.
--
-- 🔑 THE `$tag`-CARRY RETAG (`tagVec`). A combinator that BUILDS a new array
-- (transpose / reshape / scan) must return a RE-DISPATCHABLE keyed Vec
-- (`{$tag:"Vec", "0":…}`), but `map`/`tabulateVec` emit the UNtagged JS-array
-- `$opaque.repr` view. `tagVec` re-tags via the `liftZipAligned` `$tag`-carry
-- precedent: `fromEntries` over a `{key = "$tag", value = "Vec"}` metadata entry
-- prepended to the data entries. `"$tag"` is a string VALUE (the `key` field), NOT
-- a `$`-prefixed object key — so there is NO `$`-key barrier (`fromEntries`, a
-- native, writes the key dynamically). The `construct`-route (1c probe #4) does NOT
-- work for a COMPUTED array — `construct ["Vec", expr]` inspects the RAW `expr`
-- structure (treats a `{call:…}` as a named-record literal), it does not evaluate
-- it first — so `tagVec` via `fromEntries`+`$tag`-string is the correct mechanic.
--
-- The closure binop `f` rides via partial application + `$`-apply (the algebra-
-- methods convention): `(f $ acc) $ x` at the leaf; `transposeRow arr m` /
-- `reshapeChild …` / `vecIndex xs` partials are passed to the native HOF `map`
-- (the `mapFmapStep g` precedent). `take`/`drop`/`rotate`/`grade` are SPLIT to
-- Phase 3b (the brief's split sanction — `take`/`drop` collide with the existing
-- std List natives, a genuine subsume-vs-alias design question; `grade` needs a
-- sort) — see the roadmap.
-- =========================================================================

-- tagVec — re-tag a list/JS-array of cells as a keyed, re-dispatchable `Vec` value
-- (`{$tag:"Vec", "0":…}`). The `liftZipAligned` `$tag`-carry made a reusable
-- helper: prepend a `{key="$tag", value="Vec"}` metadata entry to the data entries
-- and `fromEntries`. NO `$`-key barrier — `"$tag"` is a string value, not an
-- authored object key. Internal builder for the array-building combinators.
tagVec : (xs: List a) -> Vec n a
@label "tag Vec"
@description "array-substrate Phase 3 — re-tag a list of cells as a keyed, re-dispatchable `Vec` value (`{$tag:\"Vec\", \"0\":…}`) via the liftZipAligned `$tag`-carry: prepend a `{key=\"$tag\", value=\"Vec\"}` metadata entry to the data entries and fromEntries (no `$`-key barrier — `$tag` is a string value, written dynamically by the native). Internal builder for the array-building combinators (transpose/reshape/scan). ∀a n. List a → Vec n a"
@tags "array" "internal"
tagVec xs = fromEntries (concat [{ key = "$tag", value = "Vec" }] (entries xs))

-- reduce (`/`) — fold a binop over an array's elements. The general form of
-- `Aggregable`'s `sum`/`min`/… : `reduce f seed xs = Foldable.foldr f seed xs`,
-- working on ANY Foldable via dispatch (Vec/Array inherit the `(Map k)` foldr; the
-- nominal List/Maybe/Result instances; the derived structural). APL's `+/` =
-- `reduce add 0`. Reduces the OUTER frame (rows) by default (Step-0 axis lock);
-- inner/axis reduction composes with `rank r` (e.g. `rank 1 (reduce f s)`). `f` is
-- forwarded to `foldr`, which applies it internally — no `$` at this level.
reduce : (a -> b -> b) -> b -> f a -> b
@label "Reduce"
@description "The reduce adverb (`f/`) — fold a binop over an array's elements (the general form of `Aggregable`'s sum/min/…). `reduce f seed xs = Foldable.foldr f seed xs`; works on any Foldable via dispatch (Vec/Array inherit the (Map k) foldr). APL's `+/` = `reduce add 0`. Reduces the OUTER frame by default; inner/axis reduction composes with the `rank` adverb. ∀(f : * -> *) a b. Foldable f ⇒ (a → b → b) → b → f a → b"
@tags "reduce" "foldable" "array"
reduce f seed xs = foldr f seed xs

-- scan (`\`) — prefix-reduce: `scan f xs = [x0, f x0 x1, f (f x0 x1) x2, …]` (the
-- running accumulator; scanl1 semantics). PRESERVES shape (same length as input).
-- Walks `toList xs` (the OUTER frame — the Step-0 axis lock) carrying the running
-- `acc`, then re-tags via `tagVec` so the result re-dispatches. The binop `f` is a
-- closure-valued PARAM ⇒ `(f $ acc) $ x`.
scan : (b -> a -> b) -> f a -> Vec n b
@label "Scan"
@description "The scan adverb (`f\\`) — prefix-reduce: `scan f xs = [x0, f x0 x1, f (f x0 x1) x2, …]` (the running accumulator; scanl1 semantics, shape-preserving). Walks the outer frame (`toList`) carrying the running acc, re-tagged via `tagVec` to re-dispatch. ∀(f : * -> *) a b n. Foldable f ⇒ (b → a → b) → f a → Vec n b"
@tags "scan" "array"
scan f xs = tagVec (scanList f (toList xs))

-- scanList — the running scan over a concrete element list: emit `x0`, then
-- continue from `x0` over the tail. scan's worker.
scanList : (b -> a -> b) -> List a -> List b
@label "scan: list"
@description "array-substrate Phase 3 — the running prefix-scan over a concrete list: emit x0, then continue the accumulator over the tail. scan's worker. ∀a b. (b → a → b) → List a → List b"
@tags "scan" "array" "internal"
scanList f xs = case head xs of
  Nothing -> []
  Just x0 -> concat [x0] (scanTail f x0 (tail xs))

-- scanTail — continue the running scan from `acc` over the Maybe-tail: combine the
-- next element into `acc` and emit. Internal recursion step.
scanTail : (b -> a -> b) -> b -> Maybe (List a) -> List b
@label "scan: tail"
@description "array-substrate Phase 3 — continue the running scan from acc over the Maybe-tail (combine the next element, emit). scan's recursion step. ∀a b. (b → a → b) → b → Maybe (List a) → List b"
@tags "scan" "array" "internal"
scanTail f acc mxs = case mxs of
  Nothing -> []
  Just xs -> case head xs of
    Nothing -> []
    Just x -> scanCons f ((f $ acc) $ x) (tail xs)

-- scanCons — emit the freshly-combined `acc2`, then recurse over the remaining
-- Maybe-tail. Internal helper (splits the emit from the recursion to keep the
-- accumulator threaded without a `let`).
scanCons : (b -> a -> b) -> b -> Maybe (List a) -> List b
@label "scan: cons"
@description "array-substrate Phase 3 — emit the freshly-combined accumulator, then recurse over the remaining Maybe-tail. scan's emit step (threads acc2 as a param, no let). ∀a b. (b → a → b) → b → Maybe (List a) → List b"
@tags "scan" "array" "internal"
scanCons f acc2 rest = concat [acc2] (scanTail f acc2 rest)

-- transpose (`⍉`) — the Naperian `distribute`: swap the two leading axes of a
-- rank-≥2 array. `transpose arr = tabulate n' (λj → tabulate m' (λi → index
-- (index arr i) j))` — re-index by swapping (THE representable-derivation
-- showcase, Gibbons). `m = foldableLength arr` (outer/row count), `n =
-- foldableLength (vecIndex arr 0)` (inner/col count). Each output row + the outer
-- frame are `tagVec`-re-tagged ⇒ `transpose (transpose arr) ≡ arr`. (Step-0: the
-- nested double-tabulate composes cleanly; no flat product-index needed.)
transpose : f a -> Vec n b
@label "Transpose"
@description "The transpose adverb (`⍉`) — the Naperian `distribute`: swap the two leading axes of a rank-≥2 array by re-indexing (`result[j][i] = index (index arr i) j`). THE representable-derivation showcase (Gibbons). Round-trips: `transpose (transpose arr) ≡ arr`. ∀(f : * -> *) a b n. f a → Vec n b"
@tags "transpose" "array" "representable"
transpose arr = tagVec (map (transposeRow arr (foldableLength arr)) (rangeUpTo (foldableLength (vecIndex arr 0))))

-- transposeRow — build the j-th transposed row: `tabulate m (λi → arr[i][j])`
-- (read column j down all m input rows). transpose's outer-map step (`arr` + `m`
-- partial-applied; `j` supplied by `map`).
transposeRow : f a -> Number -> Number -> Vec m b
@label "transpose: row"
@description "array-substrate Phase 3 — build the j-th transposed row by reading column j down all m input rows (`tabulate m (λi → arr[i][j])`, re-tagged). transpose's outer-map step. ∀(f : * -> *) a b m. f a → Number → Number → Vec m b"
@tags "transpose" "array" "internal"
transposeRow arr m j = tagVec (map (transposeCol arr j) (rangeUpTo m))

-- transposeCol — the swapped-index cell read: `arr[i][j] = index (index arr i)
-- j`. transpose's inner-map step (`arr` + `j` partial-applied; `i` supplied by
-- `map`).
transposeCol : f a -> Number -> Number -> b
@label "transpose: cell"
@description "array-substrate Phase 3 — the swapped-index cell read `arr[i][j] = vecIndex (vecIndex arr i) j`. transpose's inner-map step. ∀(f : * -> *) a b. f a → Number → Number → b"
@tags "transpose" "array" "internal"
transposeCol arr j i = vecIndex (vecIndex arr i) j

-- reshape (`⍴`) — reinterpret the flat element sequence under a new shape: FLATTEN
-- to the element list (`arrayFlatten` — recursive descent to the scalars) then
-- RE-CHUNK per the new `dims` (build each axis from the flat offset). General
-- rank: `reshapeAt dims flat off` recurses the dims, computing each axis's stride
-- as the product of the trailing dims (`restSize`). `reshape [3,2] (Array[2,3])`
-- re-chunks `[1..6]` into 3 rows of 2. (Step-0: the flatten/re-chunk is a clean
-- two-step over `toList` + `vecIndex`; no flat product-index needed.)
reshape : List Number -> f a -> Vec n b
@label "Reshape"
@description "The reshape adverb (`⍴`) — reinterpret the flat element sequence under a new shape: flatten to the element list then re-chunk per the new dims (each axis built from the flat offset, stride = product of the trailing dims). `reshape [3,2] (Array[2,3])` re-chunks [1..6] into 3 rows of 2. ∀(f : * -> *) a b n. List Number → f a → Vec n b"
@tags "reshape" "array"
reshape dims arr = reshapeAt dims (arrayFlatten arr) 0

-- arrayFlatten — the recursive element sequence of an array: a scalar (rank-0,
-- `liftIsScalar`) is `[x]`; a rank-≥1 array flat-maps `arrayFlatten` over its
-- cells (`toList`). `arrayFlatten (Array[2,3]) = [1,2,3,4,5,6]`. (Named to avoid
-- the std `flatten`, which is ONE-level over `List (List a)`.)
arrayFlatten : (x: a) -> List b
@label "array: flatten"
@description "array-substrate Phase 3 — the recursive element sequence of an array (descend to the scalars): scalar ⇒ [x]; rank-≥1 ⇒ flatMap arrayFlatten over the cells (toList). Named to avoid the std one-level `flatten`. ∀a b. a → List b"
@tags "reshape" "array" "internal"
arrayFlatten x = if liftIsScalar x then [x] else flatMap arrayFlatten (toList x)

-- reshapeAt — build the sub-array at `dims` reading the flat element list from
-- `off`: empty `dims` ⇒ a single scalar cell (`vecIndex flat off`); `dims = n:rest`
-- ⇒ a `tagVec`'d axis of `n` children, each a `reshapeAt rest` at stride
-- `restSize rest`. reshape's recursive worker.
reshapeAt : List Number -> List a -> Number -> b
@label "reshape: at"
@description "array-substrate Phase 3 — build the sub-array at `dims` reading the flat element list from `off`: [] ⇒ a scalar cell (vecIndex flat off); n:rest ⇒ a tagged axis of n children at stride `restSize rest`. reshape's recursive worker. ∀a b. List Number → List a → Number → b"
@tags "reshape" "array" "internal"
reshapeAt dims flat off = case head dims of
  Nothing -> vecIndex flat off
  Just n -> tagVec (map (reshapeChild (tailDims dims) flat off (restSize (tailDims dims))) (rangeUpTo n))

-- reshapeChild — the i-th child of a reshape axis: `reshapeAt rest flat (off + i *
-- stride)`. reshape's per-axis map step (`rest`/`flat`/`off`/`stride` partial-
-- applied; `i` supplied by `map`).
reshapeChild : List Number -> List a -> Number -> Number -> Number -> b
@label "reshape: child"
@description "array-substrate Phase 3 — the i-th child of a reshape axis: `reshapeAt rest flat (off + i*stride)`. reshape's per-axis map step. ∀a b. List Number → List a → Number → Number → Number → b"
@tags "reshape" "array" "internal"
reshapeChild rest flat off stride i = reshapeAt rest flat (add off (mul i stride))

-- restSize — the cell count of one element under the trailing dims = the product
-- of those dims (`Foldable.foldr mul 1 dims`; empty ⇒ 1 = one scalar). The stride
-- between successive children of a reshape axis. Internal helper.
restSize : List Number -> Number
@label "reshape: restSize"
@description "array-substrate Phase 3 — the cell count of one element under the trailing dims = the product of those dims (`foldr mul 1 dims`; empty ⇒ 1). The stride between a reshape axis's children. ∀. List Number → Number"
@tags "reshape" "array" "internal"
restSize dims = foldr mul 1 dims

-- tailDims — the trailing dims (`tail`, or `[]` when there is none). reshape's
-- dims-tail projection. Internal helper.
tailDims : List Number -> List Number
@label "reshape: tailDims"
@description "array-substrate Phase 3 — the trailing dims (`tail dims`, or [] when none). reshape's dims-tail projection. ∀. List Number → List Number"
@tags "reshape" "array" "internal"
tailDims dims = case tail dims of
  Nothing -> []
  Just t -> t

-- =========================================================================
-- Index transforms + grade — array-substrate Phase 3b (`take` / `drop` /
-- `rotate` / `grade`). The second half of the combinator library, SPLIT out
-- of Phase 3 (the Phase-1b/1c/3 split discipline). Leading-axis prefix/suffix +
-- cyclic shift + the sort-permutation, composed from the shipped vocabulary
-- (`vecIndex` / `rangeUpTo` / `tagVec` / `sort`) — NO new engine TS, NO new
-- `$`-constructor. notes/phase-3b-prototype.md (the Step-0 design lock).
--
-- 🔑 STEP-0 VERDICT (UPDATED — resolution-substrate Phase 2 Commit 4 SUBSUMED the
-- alias). Step 0 shipped these as ALIASES under distinct codeNames `takeAxis`/
-- `dropAxis` because `std:take`/`std:drop`/`std:flatten` are EXISTING TS `@native`s
-- (`List → List`) called ~181× across 66 files INCLUDING the perf-critical parser
-- (lexer/expr-grammar/decl-grammar/pattern-algebra) + compiler (lower-to-llvm/wasm)
-- + set-algebra-deciders — the sanctioned perf-branch exception
-- ([[feedback_opaque_is_optimization]]) — and the codeName resolver is LAST-WINS,
-- so naming the Vec method `take` would have last-wins-overwritten `std:take`.
-- resolution-substrate Phase 1 REPLACED that last-wins with the bare-name dispatch
-- substrate (`classifyBareName`): a multi-binding codeName routes through its
-- arg-dispatched class instead of silently overwriting. So Commit 4 RENAMED
-- `takeAxis`→`take` / `dropAxis`→`drop` — the codeName now binds two fnIds
-- (`std:take`+`algebra:take`), and the classifier dispatches bare `take` List-vs-Vec.
-- This IS the TRUE one-`take`-for-List+Vec subsumption (no `$opaque.repr` unification
-- needed). `rotate`/`grade` stay clean new names (no collision). The interim runtime-
-- dispatch cost of bare take/drop (~6.7× interpreted) is ACCEPTED; its zero-cost fix
-- is resolution-substrate Phase 4 (compile-time resolution). Each array-BUILDING
-- result PRESERVES the `$tag` via `tagVec` so it re-dispatches.
-- =========================================================================

-- take — the first `k` cells of the leading axis (the `Sequential Vec` instance
-- method). A pure index transform over the explicit callback
-- `\i -> vecIndex xs i`, for indices `[0..k-1]`. The explicit lambda keeps
-- the existing compiler from treating a named partial as an eager call.
-- (resolution-substrate Phase 2 Commit 4: RENAMED `takeAxis`→`take`, forcing the
-- codeName collision with `std:take` so the bare `take` codeName binds two fnIds
-- — `std:take` (List) + `algebra:take` (Vec) — and the Phase-1 classifier routes
-- bare `take` through `Sequential` dispatch: List arg → `std:take` native, Vec arg
-- → this method. The TRUE one-`take`-for-List+Vec subsumption, no qualifier needed.)
take : Number -> f a -> Vec k a
@label "Take (axis)"
@description "The take adverb — the first `k` indexed cells of an array's leading axis, re-tagged as a Vec (array-substrate Phase 3b). Maps an explicit index callback over `rangeUpTo k`; each requested index must exist. The `Sequential Vec` instance's `take` method. Global bare-name routing chooses std's take for List and this function for Vec; this source's local name binds this function directly. ∀(f : * -> *) a k. Number → f a → Vec k a"
@tags "take" "array" "index-transform"
take k xs = tagVec (map (\i -> vecIndex xs i) (rangeUpTo k))

-- drop — all but the first `k` cells of the leading axis (the `Sequential Vec`
-- instance method). `tagVec (map (dropCell xs k) [0..n-k-1])`, reading `xs[k+i]`.
-- The suffix counterpart of `take`. (resolution-substrate Phase 2 Commit 4:
-- RENAMED `dropAxis`→`drop`, same codeName-collision story as `take` above —
-- bare `drop` now dispatches `std:drop` (List) vs `algebra:drop` (Vec).)
drop : Number -> f a -> Vec m a
@label "Drop (axis)"
@description "The drop adverb — all but the first `k` cells of an array's leading axis, re-tagged as a Vec (array-substrate Phase 3b). `tagVec (map (dropCell xs k) (rangeUpTo (n-k)))`, reading `xs[k+i]`. The `Sequential Vec` instance's `drop` method (resolution-substrate Phase 2 Commit 4 — RENAMED from `dropAxis` to collide with `std:drop`, so bare `drop` dispatches List-vs-Vec). ∀(f : * -> *) a m. f a → Vec m a (over Number k)"
@tags "drop" "array" "index-transform"
drop k xs = tagVec (map (dropCell xs k) (rangeUpTo (sub (foldableLength xs) k)))

-- dropCell — the i-th surviving cell of a drop: `xs[k+i]`. `drop`'s map step
-- (`xs` + `k` partial-applied; `i` supplied by `map`). Internal helper.
dropCell : f a -> Number -> Number -> a
@label "drop: cell"
@description "array-substrate Phase 3b — the i-th surviving cell of a drop: `vecIndex xs (k+i)`. The Vec `drop`'s map step. ∀(f : * -> *) a. f a → Number → Number → a"
@tags "drop" "array" "internal"
dropCell xs k i = vecIndex xs (add k i)

-- splitAt — cut a sequence into its first `n` elements and the rest, as a pair
-- (resolution-substrate Phase 2). Defined over the BARE dispatched `take`/`drop`:
-- `splitAt n xs = [take n xs, drop n xs]`. One generic body serves BOTH the List +
-- Vec `Sequential` instances — as of Commit 4 the bare `take`/`drop` codeNames are
-- MULTI-BINDING (`std:take`+`algebra:take`, `std:drop`+`algebra:drop`), so the
-- Phase-1 classifier routes each bare call through `Sequential` dispatch on the
-- arg's reflected type (List native vs Vec leading-axis). (Commit 3 used the
-- QUALIFIED `Sequential.take`/`.drop` form because bare take/drop were still
-- single-binding direct-to-List then; the collision Commit 4 forces makes the bare
-- form correct and collision-independent, so the qualifier is no longer needed.)
--
-- The conceptual result is the PAIR `(take n xs, drop n xs)`, but tuple-VALUE
-- literals `(a, b)` are a current Fenel-parser gap (it parses tuple TYPES, not
-- VALUES — and the runtime has no `tuple` construction op), so the pair is
-- carried as a 2-element list (index 0 = the take-part, 1 = the drop-part,
-- exactly a tuple's `_0` / `_1`). The `Sequential.splitAt` law `splitAt n xs ==
-- [take n xs, drop n xs]` is THIS body by construction.
splitAt : Number -> f a -> List (f a)
@label "Split at"
@description "resolution-substrate Phase 2 — cut a sequence into its first `n` elements and the rest, as a 2-element list `[take n xs, drop n xs]` (the conceptual pair `(f a, f a)`, carried as a list while tuple-value literals are a Fenel-parser gap), over the BARE dispatched take/drop (multi-binding as of Commit 4, so each cut type-dispatches List-vs-Vec). The `Sequential.splitAt` method body — one generic def serves both instances. forall (f : * -> *) a. Number -> f a -> List (f a)"
@tags "splitAt" "sequence" "slice"
splitAt n xs = [take n xs, drop n xs]

-- seqTakeTwo — exercise a source-owned call through the local `take` binding.
-- That binding names the axis-take function above, so both List and Vec runtime
-- representations produce a two-cell keyed Vec. The first two indices must
-- exist, as for `vecIndex`. Global bare-name dispatch is a separate control:
-- this lexical call does not demonstrate List-vs-Vec dispatcher selection.
seqTakeTwo : f a -> Vec 2 a
@label "Seq take two"
@description "Take the first two indexed cells through this source's local axis-take function, returning a tagged two-cell Vec for List and Vec runtime representations. Both indices must exist. A source-owned call regression, with global bare-name dispatch checked separately. ∀(f : * -> *) a. f a → Vec 2 a"
@tags "take" "sequence" "vec" "self-host" "local-bindings"
seqTakeTwo xs = take 2 xs

-- rotate — cyclic (left) shift of the leading axis by `k`: `tabulate n (λi →
-- index xs ((i+k) mod n))`. A pure index transform; no collision (`rotate` is a
-- clean new name). `rotate 1 [10,20,30,40] = [20,30,40,10]`.
rotate : Number -> f a -> Vec n a
@label "Rotate"
@description "The rotate adverb — cyclic (left) shift of an array's leading axis by `k`: `tabulate n (λi → index xs ((i+k) mod n))`, re-tagged (array-substrate Phase 3b). `rotate 1 [10,20,30,40] = [20,30,40,10]`. ∀(f : * -> *) a n. Number → f a → Vec n a"
@tags "rotate" "array" "index-transform"
rotate k xs = tagVec (map (rotateCell xs k (foldableLength xs)) (rangeUpTo (foldableLength xs)))

-- rotateCell — the i-th rotated cell: `xs[(i+k) mod n]`. rotate's map step (`xs` +
-- `k` + `n` partial-applied; `i` supplied by `map`). Internal helper.
rotateCell : f a -> Number -> Number -> Number -> a
@label "rotate: cell"
@description "array-substrate Phase 3b — the i-th rotated cell: `vecIndex xs ((i+k) mod n)`. rotate's map step. ∀(f : * -> *) a. f a → Number → Number → Number → a"
@tags "rotate" "array" "internal"
rotateCell xs k n i = vecIndex xs (mod (add i k) n)

-- grade (grade-up) — the permutation that would SORT the array (argsort): sort
-- the index domain `[0..n-1]` BY each index's value. Composes from the std `sort`
-- native (sort-BY-key) — NO new sort: `sort (vecIndex xs) [0..n-1]` orders the
-- indices by `xs[index]`. `grade [3,1,2] = [1,2,0]`. Re-tagged as a Vec.
grade : f a -> Vec n Number
@label "Grade up"
@description "The grade-up adverb — the permutation that would sort the array (argsort): sort the index domain `[0..n-1]` by each index's value, via the std `sort` native (`sort (vecIndex xs) (rangeUpTo n)`); re-tagged as a Vec (array-substrate Phase 3b). `grade [3,1,2] = [1,2,0]`. NO new sort. ∀(f : * -> *) a n. f a → Vec n Number"
@tags "grade" "array" "sort"
grade xs = tagVec (sort (vecIndex xs) (rangeUpTo (foldableLength xs)))

-- gradeDown (grade-down) — the permutation that would sort the array DESCENDING
-- (the descending argsort). The mirror of `grade`: reverse the ascending sort-
-- permutation. Composes from `std:reverse` over the INDEX list (NO Vec reverse —
-- that's a separate `Reversible` concern, D4): `reverse (sort (vecIndex xs)
-- [0..n-1])` is the indices ordered descending-by-value. `gradeDown [3,1,2] =
-- [0,2,1]` (idx0=3, idx2=2, idx1=1). Re-tagged as a Vec. (array-substrate Phase
-- 3c — the last 3c combinator, landing over the now-bare dispatched take/drop +
-- the shipped `Sequential Vec` instance; resolution-substrate Phase 2 Commit 4.)
gradeDown : f a -> Vec n Number
@label "Grade down"
@description "The grade-down adverb — the permutation that would sort the array descending (the descending argsort): reverse the ascending sort-permutation, `tagVec (reverse (sort (vecIndex xs) (rangeUpTo n)))`; re-tagged as a Vec (array-substrate Phase 3c). The mirror of `grade`. `gradeDown [3,1,2] = [0,2,1]`. NO new sort, NO Vec reverse (uses `std:reverse` over the index list). ∀(f : * -> *) a n. f a → Vec n Number"
@tags "grade" "array" "sort"
gradeDown xs = tagVec (reverse (sort (vecIndex xs) (rangeUpTo (foldableLength xs))))
