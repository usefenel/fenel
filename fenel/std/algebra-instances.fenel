-- Functor / Monad / Monoid instances — Fenel-authored typed values (Phase 5
-- of typeclass-substrate-completion, 2026-05-29).
--
-- An instance is NOT a special concept: `maybeMonad : Monad Maybe` is a value
-- whose type is `Monad` applied to `Maybe`, exactly as `x : Int = 3` is an Int
-- value. `loadFenelModule(..., {dispatchInstanceFile: true})` projects each
-- decl into the `SpecInstance { typeName, args, methods }` dispatch-index
-- shape (typeName = `Monad`, args = `["Maybe"]`, methods = the record fields).
--
-- Each method value is a qualified function reference (`fmap =
-- algebra.maybeFmap` loads as `{$ref: "algebra.maybeFmap"}`, modules-as-values
-- Phase 2b): the dispatch surface (json-logic.ts `applyResolvedMethod`) applies
-- it through `invokeFunction`, which resolves the handle in the calling
-- registry. Handles are always qualified — a bare `take = take` would dispatch
-- back into this instance. fmap/bind/mappend bodies live in algebra-methods.fenel
-- (registered as `algebra:*` fns by engine/src/modules/algebra.ts); List's fmap
-- and both Monoid mappends reuse the existing `std.map` / `std.concat`.
--
-- `mempty` (Monoid) is declared on the class for completeness but is
-- return-position → not dispatched (the constant value rides along on the
-- instance; a `.fenel` call of `Monoid.mempty` surfaces None-with-reason,
-- inference-owned). `return` (Monad) is likewise return-position and omitted
-- from the instances (no body needed; nothing dispatches it this phase).

-- Functor — `fmap : (a -> b) -> f a -> f b`.
maybeFunctor : Functor Maybe
maybeFunctor = Functor { fmap = algebra.maybeFmap }

listFunctor : Functor List
listFunctor = Functor { fmap = std.map }

resultFunctor : Functor Result
resultFunctor = Functor { fmap = algebra.resultFmap }

-- Monad — `bind : m a -> (a -> m b) -> m b`.
maybeMonad : Monad Maybe
maybeMonad = Monad { bind = algebra.maybeBind }

listMonad : Monad List
listMonad = Monad { bind = algebra.listBind }

resultMonad : Monad Result
resultMonad = Monad { bind = algebra.resultBind }

-- Monoid — `mappend : a -> a -> a` (+ the return-position `mempty : a`).
listMonoid : Monoid List
listMonoid = Monoid { mappend = std.concat, mempty = [] }

stringMonoid : Monoid String
stringMonoid = Monoid { mappend = std.concat, mempty = "" }

-- Foldable — `foldr : (a -> b -> b) -> b -> f a -> b` (unified-static-analysis
-- Phase 6c). UNLIKE the trinity, there were NO authored Foldable instances
-- before 6c, so without these the DERIVED structural instance
-- (`engine:deriveFoldr`) would be the only resolution even for `List`/`Maybe`/
-- `Result` — and the derived schema-fold can't reach `List`'s `$opaque`-array
-- repr (a JS array carries no `$tag` to dispatch the fold case). So we author
-- the nominal instances (D-6c-4): they keep precedence (the Functor model) AND
-- they make `List`/`Maybe`/`Result` BE Foldable, which the nested-foreign-functor
-- re-dispatch (Section B) relies on (`Foldable.foldr f acc nestedList`). The
-- derived instance is then the fall-through for USER types only.
maybeFoldable : Foldable Maybe
maybeFoldable = Foldable { foldr = algebra.maybeFoldr }

listFoldable : Foldable List
listFoldable = Foldable { foldr = algebra.listFoldr }

resultFoldable : Foldable Result
resultFoldable = Foldable { foldr = algebra.resultFoldr }

-- Applicative — `pure : a -> f a` + `ap : f (a -> b) -> f a -> f b`
-- (unified-static-analysis Phase 6d). `ap` is the dispatchable method (arg
-- position 0); `pure` is return-position — it is NOT dispatched but rides on the
-- instance as a function reference (the `mempty` precedent) so the Traversable
-- bridge can resolve `g`'s `pure` from the registry (D-6d-2). Both are real
-- `algebra:*` Fenel bodies (algebra-methods.fenel) — unlike Traversable below,
-- there is no `g`-threading problem (`ap` is an ordinary 2-arg dispatch).
maybeApplicative : Applicative Maybe
maybeApplicative = Applicative { pure = algebra.maybePure, ap = algebra.maybeAp }

listApplicative : Applicative List
listApplicative = Applicative { pure = algebra.listPure, ap = algebra.listAp }

resultApplicative : Applicative Result
resultApplicative = Applicative { pure = algebra.resultPure, ap = algebra.resultAp }

-- Traversable — `traverse : (a -> g b) -> f a -> g (f b)` (Phase 6d). UNLIKE
-- Foldable's nominal foldr bodies, the nominal `traverse` methods reference the
-- GENERIC `engine.deriveTraverse` bridge (declared `@native` in
-- engine/derive-traversable.fenel), NOT a per-type `algebra:*` body:
-- `traverse` needs the applicative `g`'s `pure`/`ap` for its empty case, and the
-- class method is only 2-arg (`f`, the structure) — so `g` MUST be resolved by a
-- native (the bridge reflects `f`'s return type / a first element, D-6d-2) and
-- threaded into the pure `.fenel` decision body. A 2-arg `.fenel` body cannot
-- reach `g`. These nominal instances exist for explicit precedence (resolveMethod
-- keys on Maybe/List/Result) symmetric with Foldable; the bridge dispatches on
-- the value's repr (array branch for `List`, schema-fold for `Maybe`/`Result`),
-- and the derived `{$pattern}` instance gives every other `* -> *` type traverse
-- free. The DECISION (sequencing) is 100% the `.fenel` `engine:deriveTraverseFold`.
maybeTraversable : Traversable Maybe
maybeTraversable = Traversable { traverse = engine.deriveTraverse }

listTraversable : Traversable List
listTraversable = Traversable { traverse = engine.deriveTraverse }

resultTraversable : Traversable Result
resultTraversable = Traversable { traverse = engine.deriveTraverse }

-- Representable — `index : f a -> i -> a` + `tabulate : (i -> a) -> f a`
-- (array-substrate Phase 1b). The `Vec n a ≅ Fin n → a` isomorphism: an array
-- IS a total function from its index set to its values. `index` is the
-- dispatchable method (arg position 0 — `f<a>` heads the first arg, the `fmap`
-- shape); its body is `algebra:vecIndex` (total `mapGet`-peel, D3 in-domain).
-- `tabulate` is RETURN-POSITION (cannot dispatch on a value AND a bare index-fn
-- carries no shape `n`) — OMITTED from the instance, exactly as `Monad.return`
-- is (the value-level builder is the standalone `algebra:tabulateVec n g`).
-- `Vec` is a parametric system entity (system-entities.ts), so dispatch on a
-- `{$tag:"Vec"}` value resolves this nominal instance.
vecRepresentable : Representable Vec
vecRepresentable = Representable { index = algebra.vecIndex }

-- Sequential — `take`/`drop`/`splitAt` (resolution-substrate Phase 2). The List
-- instance is the KEPT NATIVE PERF BRANCH: `take`/`drop` point at the existing
-- `std:take`/`std:drop` natives (List→List, lowering to `DirectOp`), so the
-- ~181 hot List-`take` sites pay NOTHING ([[feedback_opaque_is_optimization]] —
-- the pure-ADT `Sequential List` is the source of truth, the native is the repr
-- perf branch). `splitAt` is the generic `algebra:splitAt` (`[take n xs, drop n
-- xs]` over the dispatched take/drop). The laws are OMITTED (they live on the
-- class as `Verified Boolean` fields — the `isoBase64` / Bool-instance precedent).
--
-- As of Commit 4 the `take`/`drop` codeNames are MULTI-BINDING (`std:take` +
-- `algebra:take`), so the Phase-1 classifier routes bare `take`/`drop` through
-- `Sequential` dispatch: a List arg reflects to "List" and resolves to THIS
-- instance's `std:take` native — the ~181 hot sites still land on the native
-- (pure per-call dispatch overhead, not a different code path; the zero-cost fix
-- is Phase 4 compile-time resolution). (Commit 3 kept the Vec methods under
-- DISTINCT `takeAxis`/`dropAxis` codeNames so bare `take` stayed single-binding
-- direct; Commit 4's rename forced the collision that makes bare take/drop the
-- true List-vs-Vec dispatch.)
listSequential : Sequential List
listSequential = Sequential { take = std.take, drop = std.drop, splitAt = algebra.splitAt }

-- Sequential Vec — the array leading-axis transforms (resolution-substrate Phase
-- 2; array-substrate Phase 3b's leading-axis prefix/suffix, the Vec instance
-- methods). `take`/`drop` point at `algebra:take`/`algebra:drop` (tag-preserving
-- `vecIndex`/`rangeUpTo` index transforms over a `{$tag:"Vec"}` value); `splitAt`
-- reuses the generic `algebra:splitAt` (its bare `take`/`drop` internals dispatch
-- to THESE Vec methods on a Vec value). With this instance, `Sequential` has TWO
-- instances, so `take`/`drop`/`splitAt` genuinely dispatch List-vs-Vec by the
-- arg's reflected type — the true one-`Sequential`-for-List+Vec subsumption
-- (design/resolution-substrate.md). A Vec value reflects to the key "Vec"
-- (`typeConstructorOf` reads the `$tag`), matching this instance's `args[0]`.
--
-- BARE `take`/`drop` now DISPATCH (resolution-substrate Phase 2 Commit 4): the
-- methods were RENAMED `takeAxis`→`take` / `dropAxis`→`drop`, forcing the codeName
-- collision so each bare codeName binds TWO fnIds (`std:take`+`algebra:take`,
-- `std:drop`+`algebra:drop`). The Phase-1 classifier (`classifyBareName`) routes
-- the now-multi-binding name through `Sequential` dispatch: List arg → the
-- `std:take` native (the ~181 hot sites still LAND on the native — pure dispatch
-- overhead, not a different code path), Vec arg → `algebra:take`. The interim
-- ~6.7× interpreted dispatch cost is ACCEPTED; its zero-cost fix is
-- resolution-substrate Phase 4 (compile-time resolution).
vecSequential : Sequential Vec
vecSequential = Sequential { take = algebra.take, drop = algebra.drop, splitAt = algebra.splitAt }

-- Containable — value-level membership (resolution-substrate Phase 1b). Two
-- instances over the KEPT NATIVE bodies (the `listSequential` perf-branch
-- precedent — the instance points at the existing native fnId; the pure-ADT class
-- is the source of truth):
--   • `Containable String` → `std:contains` (substring test, `(s, sub) -> Boolean`).
--   • `Containable List`   → `std:includes` (element membership, `(arr, value) -> Boolean`).
-- A String value reflects to "String", a List to "List" (`typeConstructorOf`),
-- selecting the matching instance's `args[0]`. With BOTH instances, bare `contains`
-- (which binds two fnIds — `std:contains` + the `set:contains` SetExpr-decider
-- sibling — so the Phase-1 classifier routes it through its unique arg-dispatched
-- owning class) dispatches String→substring, List→element-membership by the
-- container's reflected type. This RETIRES the grandfathered collision where bare
-- `contains` silently last-wins'd to `set:contains` over EVERY container. The
-- SetExpr decider (`set:contains`, `Maybe Boolean`) is NOT an instance — a
-- different concept reached by fnId (see the algebra.fenel class header).
stringContainable : Containable String
stringContainable = Containable { contains = std.contains }

listContainable : Containable List
listContainable = Containable { contains = std.includes }
