-- Operator fixity instances — the built-in `Infixable` / `Prefixable` typed
-- values that the parser + printer consume to build their default fixity
-- tables (typed-function-references Phase 12, 2026-06-05).
--
-- An `Infixable` / `Prefixable` instance is a typed VALUE like any other
-- (the substrate position since typeclass-substrate-completion Phase 3): the
-- value's type is `Infixable` applied to the function itself, and its method
-- record carries the notation / precedence / associativity. Each instance is
-- UNNAMED (`_`) and names its function by REFERENCE — `_ : Infixable std.add`,
-- the dotted handle of the member (`design/module-system.md` §3), never a
-- colon-id string (modules-as-values Phase 2e). The projection stores the
-- handle as written (`args: ["std.add"]`); readers compare by the RESOLVED
-- function id, never by the raw string. A `Class.method` handle (`Monad.bind`)
-- names a class method: the parser lowers it to the qualified-method node and
-- no reader resolves it as a function.
--
-- BOOTSTRAP — why this file is special, and why it nonetheless parses with NO
-- fixity table:
--   The parser sources its default fixity from these instances to parse
--   `.fenel` at all. That looks circular — but every method value here is a
--   string / number literal and every type argument a single dotted name in
--   type position (`std.add`), so THIS file uses no infix operators and parses
--   correctly under an EMPTY fixity table. `parser-fixities.ts`
--   (`getFixityInstances`) projects it lazily on first parse, guarded by an
--   in-progress sentinel: while this file is itself being parsed, the default
--   fixity is the structural-operators-only table (literals never hit the
--   Infixable lookup), and the full table is built + memoized once the
--   projection completes. NEVER add an infix operator to this file — that
--   would reintroduce the load-order cycle the bootstrap dissolves.
--
-- THREE consumers, THREE subsets (all sourced from this one file):
--   * parser  — ALL 18 infixables (incl. the `&&`/`||` symbolic aliases and the
--     `>>=`/`<>` qualified-method operators). The prefix `not`/`-` are hardcoded
--     in the parser's `parseNot`/`parseUnary`, so the parser ignores Prefixable.
--   * printer — the 14 CANONICAL infixables only (excludes `&&`/`||`/`>>=`/`<>`)
--     + both prefixables. The asymmetry is LOAD-BEARING: `&&` parses to
--     `{call:["and",…]}` but must print back as `and`; `>>=` lowers to
--     `{method:["Monad","bind",…]}` and prints as `Monad.bind`. Excluding these
--     from the printer's tables keeps the canonical printed form.
--   * specRegistry (introspection) — everything EXCEPT the `&&`/`||` symbolic
--     aliases (matches the legacy `builtinInstances` set: the canonical 14 +
--     `>>=`/`<>` + the 2 prefixables). `&&`/`||` are pure parser sugar, never
--     surfaced to the operator picker.

-- Additive (precedence 6, left-associative)
_ : Infixable std.add
_ = Infixable { notation = "+", precedence = 6, associativity = "left" }

_ : Infixable std.sub
_ = Infixable { notation = "-", precedence = 6, associativity = "left" }

-- Multiplicative (precedence 7, left-associative)
_ : Infixable std.mul
_ = Infixable { notation = "*", precedence = 7, associativity = "left" }

_ : Infixable std.div
_ = Infixable { notation = "/", precedence = 7, associativity = "left" }

_ : Infixable std.mod
_ = Infixable { notation = "%", precedence = 7, associativity = "left" }

-- Concatenation (precedence 5, right-associative — mirrors Haskell's ++).
-- Notation matches the JSON-Logic `cat` op so the editor's `op:<notation>`
-- fnId round-trips through `toLogic` / `logicToExprNode` unchanged.
_ : Infixable std.concat
_ = Infixable { notation = "cat", precedence = 5, associativity = "right" }

-- Comparison (precedence 4, non-associative — chaining is ambiguous)
_ : Infixable std.eq
_ = Infixable { notation = "==", precedence = 4, associativity = "none" }

_ : Infixable std.neq
_ = Infixable { notation = "!=", precedence = 4, associativity = "none" }

_ : Infixable std.lt
_ = Infixable { notation = "<", precedence = 4, associativity = "none" }

_ : Infixable std.gt
_ = Infixable { notation = ">", precedence = 4, associativity = "none" }

_ : Infixable std.lte
_ = Infixable { notation = "<=", precedence = 4, associativity = "none" }

_ : Infixable std.gte
_ = Infixable { notation = ">=", precedence = 4, associativity = "none" }

-- Logical (precedences 3 and 2, right-associative). Notation matches the
-- JSON-Logic `and` / `or` ops — same round-trip rationale as `cat` above.
_ : Infixable std.and
_ = Infixable { notation = "and", precedence = 3, associativity = "right" }

_ : Infixable std.or
_ = Infixable { notation = "or", precedence = 2, associativity = "right" }

-- Symbolic aliases — `&&` / `||` name the SAME function (`std.and` /
-- `std.or`) as the canonical `and` / `or`. PARSER-ONLY: the printer keys its
-- `INFIXABLE_BY_NAME` map by fnId (last-set wins) and must keep printing the
-- canonical `and` / `or`, so these are excluded from the printer's set (and
-- from the introspection registry — they're pure parser sugar). Without these
-- fixity entries `&&` would fall back to infixl 9 and bind TIGHTER than the
-- precedence-4 comparisons, misparsing chained `>= && <=` shapes.
_ : Infixable std.and
_ = Infixable { notation = "&&", precedence = 3, associativity = "right" }

_ : Infixable std.or
_ = Infixable { notation = "||", precedence = 2, associativity = "right" }

-- Operators whose Infixable target is a QUALIFIED METHOD (`Class.method`)
-- rather than a std function (typeclass-substrate-completion Phase 3.5).
-- `applyBinOp` lowers `a >>= f` to the qualified-method-ref `{method:["Monad",
-- "bind",a,f]}`. `>>=` (monadic bind) is Haskell `infixl 1`; `<>` (monoid
-- append) is `infixr 6`. PARSER-ONLY for the printer (the `method` case renders
-- the canonical `Monad.bind a f`), but REGISTERED for introspection parity with
-- the std operator set (the legacy `builtinInstances` carried them).
_ : Infixable Monad.bind
_ = Infixable { notation = ">>=", precedence = 1, associativity = "left" }

_ : Infixable Monoid.mappend
_ = Infixable { notation = "<>", precedence = 6, associativity = "right" }

-- `not` — logical negation. Notation matches the JSON-Logic `!` op (also
-- surfaced as the word `not` by the parser). Consumed by the printer +
-- introspection registry; the parser hardcodes the `not` prefix.
_ : Prefixable std.not
_ = Prefixable { notation = "not", precedence = 9 }

-- `negate` — arithmetic negation. Notation `-` (unary) at precedence 9,
-- tighter than any binary operator so `-x + y` parses as `(- x) + y`.
_ : Prefixable std.negate
_ = Prefixable { notation = "-", precedence = 9 }

-- Localized word-operator codenames — the parser/printer i18n source.
--
-- `and` / `or` / `not` are ordinary std functions (since the word-operator
-- de-reservation), so their localized spelling IS their `Codeable` localized
-- codeName (a LocaleString). std attaches the canonical `Codeable` (codeName
-- `and` …); these instances carry the per-locale spellings. This is the
-- bootstrap-safe home: the parser projects THIS file before the std module
-- exists (load-order cycle), so the spellings can't be read from std's Codeable
-- at parse time. `parser-fixities.ts` (`getLocalizedOperators`) derives the
-- lexer's spelling→canonical canonicalization (`et` → `and`) and the printer's
-- canonical→spelling map from the `codeName` LocaleStrings here. Replaces the
-- former hardcoded TS `LOCALE_OP` table (no language concept in TS — a localized
-- codeName is a Codeable fact, not a parser const). Projected via
-- getFixityInstances' `Codeable` filter, NOT registered globally (the std-side
-- canonical Codeable owns the registry row).
_ : Codeable std.and
_ = Codeable { codeName = { en = "and", fr = "et", es = "y", ar = "و" } }

_ : Codeable std.or
_ = Codeable { codeName = { en = "or", fr = "ou", es = "o", ar = "أو" } }

_ : Codeable std.not
_ = Codeable { codeName = { en = "not", fr = "non", es = "no", ar = "ليس" } }
