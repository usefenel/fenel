-- Portfolio — a nested group of profiles for manual classification.
-- Self-referential through `parentId: Maybe (EntityRef<"portfolio">)` —
-- the EntityRef shorthand wrapped in Maybe so portfolios form a tree.
--
-- Static rows: none. Identity (label / description / icon) is
-- registered by defineSystemEntity on the TS side.
--
-- Phase 3d of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3d-system-entities-wholesale-flip.md.
-- One override (parentId → "Parent portfolio"); the humanize default
-- "Parent Id" mis-describes the self-referential parent link.

@entity
@codeName "portfolio"
@label "Portfolio"
@description "A nested group of profiles for manual classification"
@icon "folder-tree"
@fieldLabel "parentId" "Parent portfolio"
Portfolio = Portfolio name: String parentId: Maybe (EntityRef<"portfolio">)
