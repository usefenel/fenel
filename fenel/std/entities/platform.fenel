-- Platform — social media platform. Handle-format rules (max length,
-- pattern, URL template, prefix) are stored as fields so the
-- HandleFormat typeclass can derive instances from the static rows.
--
-- Reference rows live in platform-data.fenel as per-row value-decls
-- (`platform_instagram = Platform {…}`), indexed under `Platform` by the value-
-- registry loader and registered as global-scope by-type dispatch targets
-- (storage-as-effect Phase 3a — the retired setStaticData map + platforms.ts
-- array). Identity (label / description / icon) is registered by
-- defineSystemEntity on the TS side.
--
-- Phase 3b of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3b-system-entities-small-batch.md.
-- Three fields carry per-field label overrides supplied via the
-- `fieldLabels` param on the TS-side spec: `handleMaxLength` →
-- "Max Length" (vs humanize "Handle Max Length"), `handlePattern` →
-- "Pattern" (vs "Handle Pattern"), `urlTemplate` → "URL Template" (vs
-- "Url Template"). The other six fields humanize cleanly to their
-- intended labels.

@entity
@codeName "platform"
@label "Platform"
@description "Social media platform — handle rules derived via HandleFormat typeclass"
@icon "share-2"
@fieldLabel "handleMaxLength" "Max Length"
@fieldLabel "handlePattern" "Pattern"
@fieldLabel "urlTemplate" "URL Template"
Platform = Platform code: String name: String shortName: String description: String logo: String handlePrefix: String handleMaxLength: Number handlePattern: String urlTemplate: String
