-- Profile — a person, organization, or AI agent. 10 fields: 2 enum
-- selects (type / gender), 2 free-form Strings (firstName / lastName /
-- notes), 3 refined-String atoms (email / phone / avatar), a Date
-- (dob), and a List String (nicknames).
--
-- Static rows: none. Identity (label / description / icon) is
-- registered by defineSystemEntity on the TS side.
--
-- Phase 3d of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3d-system-entities-wholesale-flip.md.
-- Multiple atom extractions (`|`-refinement is type-decl-level only):
--   - `ProfileType = String | value ∈ {"person", "group", "ai_agent"}`
--   - `ProfileGender = String | value ∈ {"male", "female", "other",
--     "unknown"}`
--   - `EmailStr = String | value ∈ format:email`
--   - `PhoneStr = String | value ∈ format:phone`
-- `UrlStr` is already declared in proxy_link.fenel (cross-entity
-- atom); the avatar field references it by name from the catalog.
--
-- TS-side overlays:
--   - `fieldLabels`: firstName → "First Name", lastName → "Last Name",
--     dob → "Date of Birth" (humanize fallbacks differ from intent).
--   - `fieldDefaults`: type → "person" (new profiles default to
--     person).
--   - `fieldUi`: type → options list; gender → options list.

@entity
@label "Profile Type"
@description "Enum: person | group | ai_agent"
@valueLabel "group" "Group / Organization"
@valueLabel "ai_agent" "AI Agent"
ProfileType = String | value ∈ {"person", "group", "ai_agent"}
@entity
@label "Profile Gender"
@description "Enum: male | female | other | unknown"
ProfileGender = String | value ∈ {"male", "female", "other", "unknown"}
@entity
@label "Email"
@icon "mail"
@description "String constrained to a valid email address (format:email)"
EmailStr = String | value ∈ format:email
@entity
@label "Phone"
@icon "phone"
@description "String constrained to a valid phone number (format:phone)"
PhoneStr = String | value ∈ format:phone

@entity
@codeName "profile"
@label "Profile"
@description "A person, organization, or AI agent"
@icon "users"
@fieldLabel "dob" "Date of Birth"
Profile = Profile type: ProfileType gender: ProfileGender firstName: String lastName: String email: EmailStr phone: PhoneStr dob: Date avatar: UrlStr notes: String nicknames: List String
