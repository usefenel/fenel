-- Inventory — a capacity-bounded resource: slug, capacity (non-negative
-- Number), reservation enforcement (soft / hard enum).
--
-- Static rows: none. Identity (label / description / icon) is
-- registered by defineSystemEntity on the TS side.
--
-- Phase 3d of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3d-system-entities-wholesale-flip.md.
-- Two atom extractions:
--   - `NonNegCapacity = Number | value ∈ [0..)` — left-closed
--     unbounded-right interval; refined-Number for capacity values.
--   - `InventoryEnforce = String | value ∈ {"soft", "hard"}` — the
--     2-value enum; runtime branches on this when committing
--     reservations.
-- TS-side overlays:
--   - `fieldLabels`: enforce → "Enforcement" (humanize "Enforce" loses
--     the noun form).
--   - `fieldDefaults`: enforce → "soft" (new inventories default to
--     soft enforcement).
--   - `fieldUi`: enforce → options list for the select widget.

@entity
@label "Non-Negative Capacity"
@description "Refined Number ≥ 0 — inventory capacity"
NonNegCapacity = Number | value ∈ [0..)
@entity
@label "Inventory Enforcement"
@description "Enum: soft | hard — overcommit policy"
@valueLabel "soft" "Soft (warn only)"
@valueLabel "hard" "Hard (reject overcommit)"
InventoryEnforce = String | value ∈ {"soft", "hard"}

@entity
@codeName "inventory"
@label "Inventory"
@description "A capacity-bounded resource — slug, capacity, reservation enforcement"
@icon "archive"
@fieldLabel "enforce" "Enforcement"
Inventory = Inventory slug: String capacity: NonNegCapacity enforce: InventoryEnforce
