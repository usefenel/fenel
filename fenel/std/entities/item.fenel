-- Item — a product or service that can be sold. Three fields: slug,
-- name, type-enum.
--
-- Static rows: none. Identity (label / description / icon) is
-- registered by defineSystemEntity on the TS side.
--
-- Phase 3d of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3d-system-entities-wholesale-flip.md.
-- One atom extraction:
--   - `ItemType = String | value ∈ {"digital_file",
--     "telegram_group_access", "telegram_group_dynamic",
--     "subscription"}` — the 4-value enum (item category for
--     downstream fulfilment branching).
-- TS-side overlays:
--   - `fieldUi`: type → options list for the select widget (option
--     labels are humanised renderings of the value strings, supplied
--     verbatim through the fieldUi block — humanize-of-enum-value
--     isn't a substrate primitive).

@entity
@label "Item Type"
@description "Enum: digital_file | telegram_group_access | telegram_group_dynamic | subscription"
@valueLabel "telegram_group_dynamic" "Telegram Group (Dynamic)"
ItemType = String | value ∈ {"digital_file", "telegram_group_access", "telegram_group_dynamic", "subscription"}

@entity
@codeName "item"
@label "Item"
@description "A product or service that can be sold"
@icon "package"
Item = Item slug: String name: String type: ItemType
