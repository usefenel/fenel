-- QueryCategory — hierarchical category that groups saved queries.
-- Categories own query refs.
--
-- Phase 3b of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3b-system-entities-small-batch.md.
-- Identity (label / description / icon) is registered by
-- defineSystemEntity on the TS side. The `parentId` field carries a
-- per-field label override ("Parent Category") supplied via the new
-- `fieldLabels` param on the same TS-side spec — the bare
-- `humanizeCodeName("parentId")` default ("Parent Id") would mis-describe
-- the field. This is the entity that proves out the per-field
-- Labelable-typeclass-instance authoring surface for the rest of the
-- system-entities sweep.

@entity
@codeName "query_category"
@label "Query Category"
@description "Hierarchical category that groups saved queries — categories own query refs"
@icon "folder"
@fieldLabel "parentId" "Parent Category"
QueryCategory = QueryCategory slug: String name: String description: String parentId: String
