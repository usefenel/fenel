-- Purchase — a profile's purchase of a plan. Status enum (pending /
-- active / completed / refunded / cancelled). Two EntityRef fields
-- (profileId, planId) and one enum status.
--
-- Static rows: none. Identity (label / description / icon) is
-- registered by defineSystemEntity on the TS side.
--
-- Phase 3d of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3d-system-entities-wholesale-flip.md.
-- One atom extraction:
--   - `PurchaseStatus = String | value ∈ {"pending", "active",
--     "completed", "refunded", "cancelled"}` — the 5-value lifecycle
--     enum.
-- TS-side overlays:
--   - `fieldLabels`: profileId → "Profile", planId → "Plan" (drop the
--     Id suffix).
--   - `fieldDefaults`: status → "pending" (new purchases default to
--     pending).
--   - `fieldUi`: status → options list for the select widget.

@entity
@label "Purchase Status"
@description "Enum: pending | active | completed | refunded | cancelled"
PurchaseStatus = String | value ∈ {"pending", "active", "completed", "refunded", "cancelled"}

@entity
@codeName "purchase"
@label "Purchase"
@description "A profile's purchase of a plan — pending, active, completed, refunded, or cancelled"
@icon "shopping-cart"
@fieldLabel "profileId" "Profile"
@fieldLabel "planId" "Plan"
Purchase = Purchase profileId: EntityRef<"profile"> planId: EntityRef<"plan"> status: PurchaseStatus
