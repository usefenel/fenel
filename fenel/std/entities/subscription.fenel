-- Subscription — a binding from a source (HTTP webhook, event type,
-- cron, signal) to a Fenel function handler. Seven fields total:
-- enum source, refined-String slug, EntityRef handler (functionId-
-- shaped), plus four Maybe-wrapped fields for source-specific config.
--
-- Static rows: none. Identity (label / description / icon) is
-- registered by defineSystemEntity on the TS side.
--
-- Phase 3d of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3d-system-entities-wholesale-flip.md.
-- Two atom extractions:
--   - `SubscriptionSlug = String | value ∈ format:url-segment` — note
--     that `format:url-segment` is a forward-reference (not registered
--     in `NAMED_SETS` today); the .fenel parse preserves the named-
--     reference shape verbatim, matching pre-flip behavior. Phase 3d
--     does NOT register the predicate — that's a separate concern.
--   - `SubscriptionSource = String | value ∈ {"http_webhook", "event",
--     "cron", "signal"}` — the 4-value enum the runtime router
--     branches on.
-- Two overrides via fieldLabels: handler → "Handler function" and
-- cronExpr → "Cron expression" (humanize defaults yield "Handler" /
-- "Cron Expr"); plus eventType → "Event type" so the case matches
-- pre-flip exactly.

@entity
@label "Subscription Slug"
@description "String constrained to a valid URL segment (format:url-segment)"
SubscriptionSlug = String | value ∈ format:url-segment
@entity
@label "Subscription Source"
@description "Enum: http_webhook | event | cron | signal"
SubscriptionSource = String | value ∈ {"http_webhook", "event", "cron", "signal"}

@entity
@codeName "subscription"
@label "Subscription"
@description "A binding from a source (HTTP webhook, event type, cron, signal) to a Fenel function handler"
@icon "rss"
@fieldLabel "cronExpr" "Cron expression"
@fieldLabel "handler" "Handler function"
Subscription = Subscription slug: SubscriptionSlug source: SubscriptionSource secret: Maybe String eventType: Maybe String cronExpr: Maybe String handler: EntityRef<"function">
