-- PaymentStep — a single payment step within a purchase (Stripe /
-- crypto / etc.). One EntityRef field (purchaseId), four Maybe
-- fields (provider / providerRef / paidAt / refundedAt), an enum
-- status field, and a non-negative Number amount.
--
-- Static rows: none. Identity (label / description / icon) is
-- registered by defineSystemEntity on the TS side.
--
-- Phase 3d of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3d-system-entities-wholesale-flip.md.
-- Two atom extractions:
--   - `NonNegAmount = Number | value ∈ [0..)` — refined-Number with a
--     left-closed unbounded-right interval, used for `amount`. Distinct
--     from NonNegInt (base `Int`); PaymentStep amounts are
--     Number-typed since fractional cents / sub-unit currency
--     amounts must be representable.
--   - `PaymentStepStatus` — the 4-value enum (pending / paid /
--     refunded / failed). Extracted as a type-decl-level atom because
--     `|`-enum refinement doesn't parse at field-position.
-- One override (purchaseId → "Purchase") and one label-shape override
-- via fieldLabels for `amount` → "Amount (cents)" (the humanize default
-- "Amount" loses the unit hint).

@entity
@label "Non-Negative Amount"
@description "Refined Number ≥ 0 — monetary amount in subunits"
NonNegAmount = Number | value ∈ [0..)
@entity
@label "Payment Step Status"
@description "Enum: pending | paid | refunded | failed"
PaymentStepStatus = String | value ∈ {"pending", "paid", "refunded", "failed"}

@entity
@codeName "payment_step"
@label "Payment Step"
@description "A single payment step within a purchase (Stripe / crypto / etc.)"
@icon "credit-card"
@fieldLabel "purchaseId" "Purchase"
@fieldLabel "stepSlug" "Step"
@fieldLabel "amount" "Amount (cents)"
PaymentStep = PaymentStep purchaseId: EntityRef<"purchase"> stepSlug: String amount: NonNegAmount currency: String provider: Maybe String providerRef: Maybe String status: PaymentStepStatus paidAt: Maybe Date refundedAt: Maybe Date
