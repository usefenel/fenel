-- Postal address shapes — one first-class named `$record` type per country
-- (Phase 3.3c of typeclass-substrate-completion, 2026-05-29).
--
-- In a types = UI = app system the idiomatic carrier for "the shape of a US
-- postal address" is a TYPE (a `$record`), not a bare `List FieldDef` held as
-- typeclass-method data. Phase 3.3c reshapes AddressFormat from four methods
-- (`addressFields : List FieldDef` + `postalName`/`stateName`/`cityName` label
-- strings) down to a single `addressType : Type`; each country's address shape
-- becomes one of the named records below, and the `AddressFormat <CC>` instance
-- carries `addressType = <CcAddress>` (projected to `{$named:"<CcAddress>"}` via
-- the loader's `typeValuedFields` option — the same type-as-value mechanism
-- aggregable's `inputType = List` uses). The universal FieldRenderer drives the
-- form for free from the `$record` — the first real exercise of "address shape
-- as a browsable Type" toward the flagship product.
--
-- The per-field labels that the old `postalName`/`stateName`/`cityName` methods
-- carried now live on each `FieldDef.label` inside the record (set via
-- `defineSystemEntity` `fieldLabels` overrides in system-entities.ts, since the
-- humanized default of `postalCode` is "Postal Code", not "ZIP code" etc.).
--
-- Postal-code constraints are refined-String atoms (regex in TYPE position),
-- following the universal named-atom pattern every entity file uses (cf.
-- `PageSlug` / `UrlStr` / `DriveLetter`). Field-position inline refinement does
-- not parse (the parser rejects `field: (String | value ∈ /…/)`), so each
-- postal format is extracted as a named atom and referenced by name — exactly
-- as country.fenel extracts Latitude / Longitude. Each atom is registered as a
-- system entity (like the other refined atoms) so the catalog + `{$named:…}`
-- resolution see it.
--
-- `Address` is already the email-address entity (email.ts) and `GeoAddress` is
-- a GeoLevel constructor — the per-country names below are collision-free.

@entity
@label "ZIP code"
@description "String constrained to a US ZIP code (5 digits, optional +4)"
UsPostalCode = String | value ∈ /^\d{5}(-\d{4})?$/
@entity
@label "Postal code"
@description "String constrained to a Canadian postal code (A1A 1A1)"
CaPostalCode = String | value ∈ /^[A-Z]\d[A-Z]\s?\d[A-Z]\d$/
@entity
@label "Postcode"
@description "String constrained to a UK postcode"
GbPostalCode = String | value ∈ /^[A-Z]{1,2}\d[A-Z\d]?\s?\d[A-Z]{2}$/
@entity
@label "PLZ"
@description "String constrained to a German postal code (5 digits)"
DePostalCode = String | value ∈ /^\d{5}$/
@entity
@label "Code postal"
@description "String constrained to a French postal code (5 digits)"
FrPostalCode = String | value ∈ /^\d{5}$/
@entity
@label "郵便番号"
@description "String constrained to a Japanese postal code (123-4567)"
JpPostalCode = String | value ∈ /^\d{3}-?\d{4}$/

-- Western shape with a required State/Province (US, CA).
@entity
@label "US address"
@description "United States postal address — line1/line2, city, state, ZIP code"
@icon "map-pin"
@fieldLabel "line1" "Address line 1"
@fieldLabel "line2" "Address line 2"
@fieldLabel "city" "City"
@fieldLabel "state" "State"
@fieldLabel "postalCode" "ZIP code"
UsAddress = UsAddress line1: String line2: Maybe String city: String state: String postalCode: UsPostalCode
@entity
@label "Canadian address"
@description "Canadian postal address — line1/line2, city, province, postal code"
@icon "map-pin"
@fieldLabel "line1" "Address line 1"
@fieldLabel "line2" "Address line 2"
@fieldLabel "city" "City"
@fieldLabel "state" "Province"
@fieldLabel "postalCode" "Postal code"
CaAddress = CaAddress line1: String line2: Maybe String city: String state: String postalCode: CaPostalCode

-- Western shape with no state/province field (GB, DE, FR).
@entity
@label "UK address"
@description "United Kingdom postal address — line1/line2, town/city, postcode (no county field)"
@icon "map-pin"
@fieldLabel "line1" "Address line 1"
@fieldLabel "line2" "Address line 2"
@fieldLabel "city" "Town/City"
@fieldLabel "postalCode" "Postcode"
GbAddress = GbAddress line1: String line2: Maybe String city: String postalCode: GbPostalCode
@entity
@label "German address"
@description "German postal address — line1/line2, Stadt, PLZ (no state field)"
@icon "map-pin"
@fieldLabel "line1" "Address line 1"
@fieldLabel "line2" "Address line 2"
@fieldLabel "city" "Stadt"
@fieldLabel "postalCode" "PLZ"
DeAddress = DeAddress line1: String line2: Maybe String city: String postalCode: DePostalCode
@entity
@label "French address"
@description "French postal address — line1/line2, Ville, Code postal (no state field)"
@icon "map-pin"
@fieldLabel "line1" "Address line 1"
@fieldLabel "line2" "Address line 2"
@fieldLabel "city" "Ville"
@fieldLabel "postalCode" "Code postal"
FrAddress = FrAddress line1: String line2: Maybe String city: String postalCode: FrPostalCode

-- Japan — postal-first ordering, prefecture + ward, no street "line" fields.
@entity
@label "Japanese address"
@description "Japanese postal address — postal-first ordering, prefecture, city, ward, building"
@icon "map-pin"
@fieldLabel "postalCode" "郵便番号"
@fieldLabel "prefecture" "都道府県"
@fieldLabel "city" "市区町村"
@fieldLabel "ward" "町名・番地"
@fieldLabel "building" "建物名・部屋番号"
JpAddress = JpAddress postalCode: JpPostalCode prefecture: String city: String ward: String building: Maybe String
