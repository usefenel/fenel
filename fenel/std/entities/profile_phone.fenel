-- ProfilePhone — a phone number attached to a profile. `number` refines
-- String over the `format:phone` named-set predicate; `label` is a
-- 3-value enum (mobile / work / home) refining String.
--
-- Static rows: none — this is a per-account user-domain entity, not a
-- catalog. Identity (label / description / icon) is registered by
-- defineSystemEntity on the TS side.
--
-- Phase 3c of the system-entities sweep — see
-- workstreams/ts-elimination/briefs/phase-3c-profile-relations.md.
-- First .fenel to use the new `EntityRef<"<name>">` parser shorthand:
-- `profileId: EntityRef<"profile">` expands to the canonical
-- `Id<profile>` phantom-tag shape — {$tagged: {value: {$named: "Id"},
-- phantom: {$refined: {base: {$named: "String"}, set: {$enum:
-- ["profile"]}}}}} — that `phantomEntityName` and every downstream
-- $tagged consumer already recognises. The TS-side `profileId` →
-- "Profile" override lives in defineSystemEntity's `fieldLabels`
-- block — the humanize-default "Profile Id" mis-describes the field.
--
-- `PhoneNumber` and `PhoneLabel` are extracted as top-level atoms
-- because `|`-refinement is a type-decl-level form only — it doesn't
-- parse at field-position type-expr slot (the field-list loop in
-- parseTypeDef terminates on `|`). Same path-(b) pattern as
-- country.fenel's Latitude / Longitude extraction.

@entity
@label "Phone Number"
@icon "phone"
@description "String constrained to a valid phone number (format:phone)"
PhoneNumber = String | value ∈ format:phone
@entity
@label "Phone Label"
@description "Enum: mobile | work | home"
PhoneLabel = String | value ∈ {"mobile", "work", "home"}

@entity
@codeName "profile_phone"
@label "Profile Phone"
@description "A phone number attached to a profile"
@icon "phone"
@fieldLabel "profileId" "Profile"
ProfilePhone = ProfilePhone profileId: EntityRef<"profile"> number: PhoneNumber label: PhoneLabel
