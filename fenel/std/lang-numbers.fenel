-- Per-language number atoms — refined Int / Rational over per-language bounds.
--
-- Languages have different number models. Most are fixed-width and can be
-- described as a refined Int / Rational over an interval. Floats come from
-- IEEE-754 (binary32 / binary64); NaN / ±Inf inclusion is opt-in via separate
-- variants (not declared here yet).
--
-- Two orthogonal aspects per integer type:
--   - bit width (8, 16, 32, 64, 128, …)
--   - signedness (signed two's complement vs unsigned)
--
-- Conventions:
--   - Signed N-bit integer:    Int | value ∈ [-2^(N-1) .. 2^(N-1) - 1]
--   - Unsigned N-bit integer:  Int | value ∈ [0 .. 2^N - 1]
--   - Float type:              Rational | value ∈ [-fmax .. fmax]
--
-- 64-bit / 128-bit clamp:
--   JS `number` loses precision past 2^53, so any bound wider than that
--   collapses to ±MAX_SAFE_INTEGER (9007199254740991). The TS helpers in
--   `lang-numbers.ts` have the same `bits >= 53` guard. Consequence:
--   RustI64 / RustI128 / GoInt64 / JavaLong / SqlBigInt are all
--   structurally identical at this resolution, as are RustU64 / RustU128 /
--   GoUint64. A future phase that introduces true BigInt-shaped bounds
--   (string-encoded) can widen the decls structurally.
--
-- Hex literals (`0xFF`) and scientific notation (`3.4028235e38`) are
-- admitted by the parser as of Phase 2.7 / 2.8 respectively, so the
-- bounds read in their natural per-language form.
--
-- The unrefined aliases `JsBigInt` and `PyInt` use a vacuous refinement
-- `value ∈ ℤ` — semantically equivalent to bare `Int`, structurally
-- distinct from the plain `{$named: "Int"}` ref. The parser doesn't
-- admit a bare-alias decl form (`X = Y`) — that shape parses as a
-- single-nullary-constructor enum — so the vacuous refinement is the
-- cheapest way to keep the alias and the canonical AST aligned.

-- JavaScript
JsNumber  = Rational | value ∈ [-1.7976931348623157e308..1.7976931348623157e308]
JsSafeInt = Int | value ∈ [-9007199254740991..9007199254740991]
JsBigInt  = Int | value ∈ ℤ

-- Python
PyInt   = Int | value ∈ ℤ
PyFloat = Rational | value ∈ [-1.7976931348623157e308..1.7976931348623157e308]

-- Rust — signed
RustI8   = Int | value ∈ [-0x80..0x7F]
RustI16  = Int | value ∈ [-0x8000..0x7FFF]
RustI32  = Int | value ∈ [-0x80000000..0x7FFFFFFF]
RustI64  = Int | value ∈ [-9007199254740991..9007199254740991]
RustI128 = Int | value ∈ [-9007199254740991..9007199254740991]

-- Rust — unsigned
RustU8   = Int | value ∈ [0..0xFF]
RustU16  = Int | value ∈ [0..0xFFFF]
RustU32  = Int | value ∈ [0..0xFFFFFFFF]
RustU64  = Int | value ∈ [0..9007199254740991]
RustU128 = Int | value ∈ [0..9007199254740991]

-- Rust — float
RustF32 = Rational | value ∈ [-3.4028235e38..3.4028235e38]
RustF64 = Rational | value ∈ [-1.7976931348623157e308..1.7976931348623157e308]

-- Java / C# — fixed widths matching the JVM / CLR specs
JavaByte   = Int | value ∈ [-0x80..0x7F]
JavaShort  = Int | value ∈ [-0x8000..0x7FFF]
JavaInt    = Int | value ∈ [-0x80000000..0x7FFFFFFF]
JavaLong   = Int | value ∈ [-9007199254740991..9007199254740991]
JavaFloat  = Rational | value ∈ [-3.4028235e38..3.4028235e38]
JavaDouble = Rational | value ∈ [-1.7976931348623157e308..1.7976931348623157e308]

-- Go — fixed widths (platform-dependent `int`/`uint` use the IntegerWidth
-- typeclass, separate from the per-width atoms below).
GoInt8    = Int | value ∈ [-0x80..0x7F]
GoInt16   = Int | value ∈ [-0x8000..0x7FFF]
GoInt32   = Int | value ∈ [-0x80000000..0x7FFFFFFF]
GoInt64   = Int | value ∈ [-9007199254740991..9007199254740991]
GoUint8   = Int | value ∈ [0..0xFF]
GoUint16  = Int | value ∈ [0..0xFFFF]
GoUint32  = Int | value ∈ [0..0xFFFFFFFF]
GoUint64  = Int | value ∈ [0..9007199254740991]
GoFloat32 = Rational | value ∈ [-3.4028235e38..3.4028235e38]
GoFloat64 = Rational | value ∈ [-1.7976931348623157e308..1.7976931348623157e308]

-- SQL
SqlSmallInt = Int | value ∈ [-0x8000..0x7FFF]
SqlInteger  = Int | value ∈ [-0x80000000..0x7FFFFFFF]
SqlBigInt   = Int | value ∈ [-9007199254740991..9007199254740991]
SqlReal     = Rational | value ∈ [-3.4028235e38..3.4028235e38]
SqlDouble   = Rational | value ∈ [-1.7976931348623157e308..1.7976931348623157e308]
