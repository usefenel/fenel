-- =========================================================================
-- Cross-modal — turn Pictures into Sounds and Sounds into Pictures.
--
-- `sonify : Picture -> Number -> Number -> AudioBuffer`
--   Rasterise a Picture and scan its pixels at audio rate; each pixel's
--   luminance becomes an amplitude. Different images sound different.
--
-- `visualize : Sound -> Number -> Number -> Picture`
--   Render a Sound's waveform as a Picture — a Field that lights up the
--   cyan trace where the waveform passes through each (x, y).
--
-- Both go through the existing render / sample primitives — no engine
-- extensions; the natives just compose what's already there.
--
-- module-substrate Phase 3i (2026-05-30) — crossmodal is the WARM-UP of the
-- non-media ctx BULK: the smallest module (3 fns, disjoint plain/ctx split).
-- The 3 TS natives, previously hand-assembled as `defineFunction` specs in
-- `engine/src/modules/crossmodal.ts`, are now @native FOREIGN DECLARATIONS
-- here; their impls live in the `ffi/crossmodal-ffi.ts` leaf. `sonify` /
-- `visualize` are CTX natives (sonify re-enters the evaluator via the picture
-- renderer; visualize builds a Field closure), so their impls land in the
-- seam's `nativeImplsCtx` map; `_visualizeAt` is plain (`nativeImpls`).
-- Plain-vs-ctx is decided ENTIRELY by which seam map an impl lands in — the
-- @native decl is uniform, no marker needed (axis #4 settled: seam-routing
-- suffices). The lowercase `crossmodal` name + `crossmodal:` id-prefix +
-- `crossmodal` category stay byte-identical. crossmodal has NO entities + NO
-- own dispatch instances (the composer rides on Picture / Sound / Point /
-- RgbaPixel / AudioBuffer declared by the media modules).
-- =========================================================================

module crossmodal where

-- ----- Foreign declarations (native-backed; impl in ffi/crossmodal-ffi.ts) ----

@native
@label "Sonify"
@description "Convert a Picture into a Sound by rasterising the picture and scanning its pixels at audio rate. Each pixel's luminance becomes an amplitude. Different images sound different — the result is the sonic image of the picture."
@tags "crossmodal" "audio" "visual"
sonify : (picture: Picture, duration: Number, sampleRate: Number) -> AudioBuffer

@native
@label "Visualize"
@description "Convert a Sound (a Buffer) into a Picture rendering its waveform. The result is a Field that lights up the cyan trace where the waveform passes through each (x, y) — a classic oscilloscope view."
@tags "crossmodal" "visual" "audio"
visualize : (sound: Sound, width: Number, height: Number) -> Picture

@native
@label "Visualize-at (internal)"
@description "Internal: per-pixel colour lookup for visualize's Field closure."
@tags "internal"
_visualizeAt : (cols: List Number, w: Number, h: Number, p: Point) -> RgbaPixel
