module dashboard where

-- =========================================================================
-- Dashboard route bodies — thin Fenel-bodied shims for the Disposition-E
-- DELETE batch (22 routes in api/src/routes/dashboard.ts that collapse to
-- one or two state:* primitive calls).
--
-- Phase 12a sub-step 2 of the ts-elimination workstream. Consumes the
-- 12a-1 substrate: state:deleteInstance + the flatten helpers in this
-- module's helpers.fenel sibling.
--
-- Wire-shape decisions:
--   - Per-entity DELETE routes (items / plans / proxy_links / email_templates)
--     DROP the legacy entityType-guard. Legacy did get → check entityType
--     → delete; the new bodies just call deleteInstance directly. UI never
--     sends wrong-type IDs; deleteInstance is idempotent on missing rows.
--     Documented as a contract erosion in the sub-step's commit message.
--   - Per-entity PUT routes (proxy_links / email_templates / profiles)
--     keep their entityType-guard IN TS as a pre-check, since dropping
--     would let a malicious client overwrite a row of one type with
--     fields of another type. The Fenel body is still a thin
--     state:updateInstance call.
--   - Items / plans GET routes return raw envelope rows from
--     state:listInstancesByName; the TS wrapper does the bespoke
--     slug/name/type/config flatten (no recordEntries primitive in
--     Fenel today — flagged in 12a-1 surprise 4).
-- =========================================================================

-- ---- Profiles ----

@label "Patch profile"
@description "PUT /profiles/:id route body. Thin shim around state:updateInstance — the IO handler does the existing-row merge with Nothing-as-clear semantics, so the legacy route-level field-by-field merge loop is redundant. The TS wrapper still does the Zod validation + the field whitelist (handles/phones/tags arrays the schema accepts but the legacy route filtered out)."
@tags "dashboard" "profile" "route" "patch"
patchProfile : (id: String) -> (patch: {}) -> Unit
patchProfile id patch =
  updateInstance id patch

@label "Delete profile"
@description "DELETE /profiles/:id route body. Calls state:deleteInstance which is idempotent on the wire. The TS wrapper retains the entityType-guard pre-check; without it a misrouted call could remove an unrelated row of any type."
@tags "dashboard" "profile" "route" "delete"
deleteProfile : (id: String) -> {}
deleteProfile id =
  deleteInstance id

-- ---- Purchases ----
--
-- Wire shape: { id, accountId, ...data, createdAt, updatedAt } — the
-- merged-envelope row from state:listInstancesByName IS the wire shape.
-- The legacy /purchases response omitted updatedAt; this body adds it
-- (additive). Sibling additive change to the relation wire shape inside
-- /profiles/:id in 12a-3 — both stem from the envelope-merge evolutions
-- and the absence of a std:recordEntries primitive to drop one key
-- without listing every other.
--
-- (Phase 12a sub-step 3 fix — 12a-2 mapped flattenRelation here, but
-- flattenRelation reads row.data which is absent on merged-envelope
-- rows; the result dropped every data-side field, returning only
-- {id, accountId, createdAt}. A wire-shape latent bug; corrected here
-- by removing the now-redundant flatten — the IO handler's envelope
-- merge already produces the wire shape we want.)

@label "List purchases"
@description "GET /purchases route body. Reads via state:listInstancesByName 'purchase' (envelope-merged rows post-12a-2 evolution) and maps each through flattenRelation (id + accountId + spread of data + createdAt — no updatedAt to match the legacy purchases wire shape)."
@tags "dashboard" "purchases" "route" "list"
listPurchases : List ({})
listPurchases =
  listInstancesByName "purchase"

-- ---- Items ----
--
-- Items use a bespoke ItemRow flatten (slug/name/type hoisted to top
-- level + remaining data nested under `config`). That shape requires
-- record-key iteration (recordEntries) which Fenel doesn't have today;
-- the Fenel body returns raw envelope rows and the TS wrapper does
-- the legacy `flatten` via the existing db/queries/items.ts helper.

@label "List items (raw envelope rows)"
@description "GET /items route body. Returns raw envelope rows from state:listInstancesByName 'item'; the TS wrapper does the bespoke ItemRow flatten (slug/name/type hoisted to top level + remaining data nested under `config`). The bespoke shape can't be expressed in Fenel today — record-key iteration has no std primitive (no std:recordEntries); flagged for a future std-primitives sub-step."
@tags "dashboard" "items" "route" "list"
listItemsRaw : List ({})
listItemsRaw =
  listInstancesByName "item"

@label "Get item (raw envelope row)"
@description "GET /items/:id route body. Returns the raw Maybe<envelope row> from state:getInstance 'item' id; the TS wrapper does the ItemRow flatten + 404-on-Nothing framing."
@tags "dashboard" "items" "route" "get"
getItemRaw : (id: String) -> Maybe ({})
getItemRaw id =
  getInstance "item" id

@label "Delete item"
@description "DELETE /items/:id route body. Calls state:deleteInstance — idempotent on missing rows. The TS wrapper drops the legacy entityType-guard (option b per the 12a-2 brief); documented contract erosion. UI only sends item-typed IDs to this endpoint."
@tags "dashboard" "items" "route" "delete"
deleteItem : (id: String) -> {}
deleteItem id =
  deleteInstance id

-- ---- Plans ----
--
-- Same shape concern as items — PlanRow has many specifically-named fields
-- + a `config` nested-rest. TS does the flatten.

@label "List plans (raw envelope rows)"
@description "GET /plans route body. Returns raw envelope rows from state:listInstancesByName 'plan'; the TS wrapper does the PlanRow flatten (many specifically-named fields + a `config` nested-rest). Same recordEntries gap as items."
@tags "dashboard" "plans" "route" "list"
listPlansRaw : List ({})
listPlansRaw =
  listInstancesByName "plan"

@label "Get plan (raw envelope row)"
@description "GET /plans/:id route body. Returns the raw Maybe<envelope row> from state:getInstance 'plan' id; the TS wrapper does the PlanRow flatten + 404-on-Nothing framing."
@tags "dashboard" "plans" "route" "get"
getPlanRaw : (id: String) -> Maybe ({})
getPlanRaw id =
  getInstance "plan" id

@label "Delete plan"
@description "DELETE /plans/:id route body. Same shape as deleteItem — thin state:deleteInstance call, entityType-guard dropped."
@tags "dashboard" "plans" "route" "delete"
deletePlan : (id: String) -> {}
deletePlan id =
  deleteInstance id

-- ---- Proxy Links ----
--
-- (Phase 12a sub-step 4 fix — 12a-2 mapped flattenInstance here, but
-- flattenInstance reads row.data which is undefined on merged-envelope
-- rows post-12a-2; the result was {id, accountId, createdAt, updatedAt}
-- with every data-side field LOST. Same latent-bug shape as the
-- listPurchases fix in 12a-3. Fixed by removing the redundant flatten —
-- the merged envelope IS the wire shape we want, with an additive
-- `updatedAt` field per the 12a-2 IO handler evolution.)

@label "List proxy links"
@description "GET /proxy-links route body. Returns envelope-merged rows from state:listInstancesByName 'proxy_link' — the merged envelope IS the wire shape (id + accountId + spread of data + createdAt + updatedAt). Sort happens in the TS wrapper (no std:sortBy yet). Phase 12a sub-step 4 — removed the now-redundant `map flattenInstance rows` that had been silently dropping every data-side field on the wire (the same latent-bug shape as 12a-3's listPurchases fix)."
@tags "dashboard" "proxy-links" "route" "list"
listProxyLinks : List ({})
listProxyLinks =
  listInstancesByName "proxy_link"

@label "Create proxy link"
@description "POST /proxy-links route body. state:tryCreateInstanceByName 'proxy_link' data — Result-shape return ({ok, value?, error?}) lets the TS wrapper map ok→201 / err→422. Zod validation stays in the TS wrapper (Decision D2 within 12a-2; full Zod retirement is 12b scope)."
@tags "dashboard" "proxy-links" "route" "create"
createProxyLink : (data: {}) -> {}
createProxyLink data =
  tryCreateInstanceByName "proxy_link" data

@label "Update proxy link"
@description "PUT /proxy-links/:id route body. Thin state:updateInstance call — the IO handler's merge semantics replace the legacy route-level read+merge. The TS wrapper keeps the entityType pre-check + post-fetch+flatten of the updated row for the response wire shape."
@tags "dashboard" "proxy-links" "route" "update"
updateProxyLink : (id: String) -> (patch: {}) -> Unit
updateProxyLink id patch =
  updateInstance id patch

@label "Delete proxy link"
@description "DELETE /proxy-links/:id route body. Thin state:deleteInstance call; entityType-guard dropped."
@tags "dashboard" "proxy-links" "route" "delete"
deleteProxyLink : (id: String) -> {}
deleteProxyLink id =
  deleteInstance id

-- ---- Email Templates ----
--
-- (Phase 12a sub-step 4 fix — same latent-bug shape as listProxyLinks.)

@label "List email templates"
@description "GET /email-templates route body. Returns envelope-merged rows from state:listInstancesByName 'email_template' (post-12a-2 envelope evolution). Phase 12a sub-step 4 — same latent-bug fix as listProxyLinks."
@tags "dashboard" "email-templates" "route" "list"
listEmailTemplates : List ({})
listEmailTemplates =
  listInstancesByName "email_template"

@label "Create email template"
@description "POST /email-templates route body. state:tryCreateInstanceByName 'email_template' data — Result-shape return."
@tags "dashboard" "email-templates" "route" "create"
createEmailTemplate : (data: {}) -> {}
createEmailTemplate data =
  tryCreateInstanceByName "email_template" data

@label "Update email template"
@description "PUT /email-templates/:id route body. Thin state:updateInstance call. Same wrapper pattern as updateProxyLink."
@tags "dashboard" "email-templates" "route" "update"
updateEmailTemplate : (id: String) -> (patch: {}) -> Unit
updateEmailTemplate id patch =
  updateInstance id patch

@label "Delete email template"
@description "DELETE /email-templates/:id route body. Thin state:deleteInstance call; entityType-guard dropped."
@tags "dashboard" "email-templates" "route" "delete"
deleteEmailTemplate : (id: String) -> {}
deleteEmailTemplate id =
  deleteInstance id

-- ---- Generic entity instances ----

@label "List entity instances by type"
@description "GET /entity-instances/:entityType route body. Thin state:listInstancesByName call — returns the envelope-merged row shape (post-12a-2 IO handler evolution), which is a wire-shape NARROWING vs the legacy raw drizzle row (no `entityType` field). Documented as a surprise; downstream callers that read row.entityType need a follow-up."
@tags "dashboard" "entity-instances" "route" "list" "generic"
listEntityInstancesByType : (entityType: String) -> List ({})
listEntityInstancesByType entityType =
  listInstancesByName entityType

@label "Create entity instance (by type)"
@description "POST /entity-instances/:entityType route body. state:tryCreateInstanceByName entityType data — Result-shape return. The TS wrapper handles Zod validation + maps ok→201 / err→422."
@tags "dashboard" "entity-instances" "route" "create" "generic"
createEntityInstanceByType : (entityType: String) -> (data: {}) -> {}
createEntityInstanceByType entityType data =
  tryCreateInstanceByName entityType data

@label "Replace entity instance"
@description "PUT /entity-instances/:id route body. Thin state:updateInstance call. Despite the route name being 'replace', the IO handler merges with existing data (Nothing-as-clear semantics) — same as PATCH. The two routes (PUT + PATCH) collapse to the same body; both are kept as separate fnIds for matrix/observability granularity."
@tags "dashboard" "entity-instances" "route" "update" "generic"
replaceEntityInstance : (id: String) -> (data: {}) -> Unit
replaceEntityInstance id data =
  updateInstance id data

-- PATCH route — the runtime's state.update_instance handler already
-- merges the patch into existing data (Nothing-as-clear); the legacy
-- route-level read+merge was redundant. Body is the same as
-- replaceEntityInstance — both call updateInstance, the merge happens
-- in the IO handler.
@label "Patch entity instance"
@description "PATCH /entity-instances/:id route body. Thin state:updateInstance call. The legacy route did an explicit read+merge before calling updateEntityInstance; that's redundant with the IO handler's own merge — dropped in 12a-2 per the brief's pre-flight Decision E1."
@tags "dashboard" "entity-instances" "route" "update" "generic"
patchEntityInstance : (id: String) -> (patch: {}) -> Unit
patchEntityInstance id patch =
  updateInstance id patch

@label "Delete entity instance"
@description "DELETE /entity-instances/:id route body. Thin state:deleteInstance call. No type-guard by design — this is the generic surface where the caller has already chosen what to delete."
@tags "dashboard" "entity-instances" "route" "delete" "generic"
deleteEntityInstance : (id: String) -> {}
deleteEntityInstance id =
  deleteInstance id
