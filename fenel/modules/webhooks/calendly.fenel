-- =========================================================================
-- Calendly webhook ingress.
--
-- Phase 12c-routes sub-step 2 of the ts-elimination workstream. Single
-- route POST /webhooks/calendly. The TS wrapper handles:
--   - HMAC-SHA256 verify (calendly's t=...,v1=... envelope) via
--     crypto:verifyCalendlySignature
--   - JSON parse + accountId resolution (utm_source / DEFAULT_ACCOUNT_ID)
--   - mapCalendlyEventType env-var loop (irreducible IO — process.env
--     iteration; per Decision V the helper stays TS-side)
--
-- Body decides per-event-type emit. Only invitee.created drives an
-- event today; invitee.canceled is logged TS-side without a fenel call;
-- other event types fall through with { received = true }.
--
-- module-substrate Phase 3p (2026-05-31) — the AGGREGATION-FRONTIER CLOSE.
-- This file + webhooks/stripe.fenel form the NEW `webhooks` module via a
-- `loadFenelModuleUnion` (the 3m cross-file-header union mechanism): BOTH
-- carry `module webhooks where` so their 6 disjoint fns group into ONE
-- `webhooks` namespace. Lifted out of the retired `mixed-ingress` bundle
-- (which loaded this under `webhooks-calendly` + re-wrapped each body in a
-- `defineFunction` spec). No stored @category (derives from the `webhooks:`
-- id prefix at read time, Phase 3j); HasStateIO is INFERRED transitively.
-- =========================================================================

module webhooks where

-- calendlyWebhook — POST /webhooks/calendly body.
-- The wrapper has already parsed body + extracted accountId + mapped
-- Calendly URI/name to callType. Per-event-type emit decision lives
-- here.
@label "Calendly webhook"
@description "POST /webhooks/calendly body. The TS wrapper handles HMAC-SHA256 verify (calendly's t=...,v1=... envelope) + JSON parse + accountId resolution (utm_source / DEFAULT_ACCOUNT_ID) + mapCalendlyEventType env-var loop. Body dispatches per event-type — only invitee.created drives an emit today."
@tags "webhook" "calendly" "route" "phase-12c"
calendlyWebhook : String -> {} -> {}
calendlyWebhook eventType payload =
  if eq eventType "invitee.created" then handleCalendlyInviteeCreated payload
  else { received = true }

-- handleCalendlyInviteeCreated — emit the calendly_call_scheduled event.
-- The wrapper has built the typed payload before the call.
@label "Handle Calendly invitee.created"
@description "Phase 12c-routes sub-step 2 — invitee.created arm. Emits calendly_call_scheduled with the typed payload (email / scheduledAt / callType / eventTypeUri / eventTypeName / calendlyInviteeUri)."
@tags "webhook" "calendly" "phase-12c"
handleCalendlyInviteeCreated : {} -> {}
handleCalendlyInviteeCreated payload =
  let _emitted = emitEvent "calendly_call_scheduled" payload Nothing
  { received = true }
