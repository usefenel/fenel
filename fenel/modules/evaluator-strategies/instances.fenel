-- Evaluator typeclass instances — Fenel-authored typed values (Phase 3.1 of
-- typeclass-substrate-completion, 2026-05-28).
--
-- Each `Evaluator <Strategy>` keys an eval impl off a strategy tag
-- (args[0]). `loadFenelModule` projects to `SpecInstance { typeName =
-- "Evaluator", args, methods, label }`. Phase 3.2 (2026-05-29) restored the
-- top-level `label` via the loader's `label` method-field lift (byte-identical
-- to the original TS const; dev-facing string, unconsumed by dispatch).
--
-- modules-as-values Phase 2b: Evaluator declares `eval : (Expression,
-- EvaluateContext) -> Result EvalError Value`, so each instance holds the strategy
-- function itself, written qualified (`evaluatorStrategies.eagerEval` loads as
-- `{$ref: "evaluatorStrategies.eagerEval"}`). The `lazy { … }` / `eager { … }`
-- block frames the parser emits still carry the id string (a parser table).

eagerEvaluatorInstance : Evaluator EagerStrategy
eagerEvaluatorInstance = Evaluator { eval = evaluatorStrategies.eagerEval, label = "EagerEvaluator — call-by-value (default)" }

lazyEvaluatorInstance : Evaluator LazyStrategy
lazyEvaluatorInstance = Evaluator { eval = evaluatorStrategies.lazyEval, label = "LazyEvaluator — call-by-name (POC)" }

partialEvaluatorInstance : Evaluator PartialStrategy
partialEvaluatorInstance = Evaluator { eval = evaluatorStrategies.partialEval, label = "PartialEvaluator — symbolic / Futamura specialiser" }

jitEvaluatorInstance : Evaluator JitStrategy
jitEvaluatorInstance = Evaluator { eval = evaluatorStrategies.jitEval, label = "JitEvaluator — PE ∘ CompileJs ∘ exec" }
