-- =========================================================================
-- module query where — the LIVE relational query ORCHESTRATION
-- (solver-extension Phase 4). The production caller the P16 materialize.fenel
-- header documented as "the live caller (NOT wired here — decision 6)".
--
-- `queryEntities expr relSpecs rules` runs a relational query over your LIVE
-- typed `entity_instances`: types = data = queryable. The thin orchestration —
--   1. for each relSpec, FETCH the entity's rows (the existing `state:
--      listInstancesByName` IO leaf — ZERO new IO leaf);
--   2. ASSEMBLE the relDef markers `{ name, fieldOrder, instances }` (the
--      materialize.fenel marker shape);
--   3. SOLVE via the `query:rel` bridge (`runRelQuery`), which routes
--      `engine:queryRel` (= solve ∘ materialize) through the engine's curated
--      dispatch harness — sidestepping the production `std:contains` vs
--      `set:contains` codeName shadow (the Step-0 finding; the bridge is the
--      ONLY new TS, the prover/ffi host-re-entry category — see bridge.fenel).
--
-- WHY THE `query` MODULE (NOT `state`): the `state` module is a PURE-LEAF volume
-- (bodyless `@native` IO leaves only — the FM-retire-8 invariant the
-- module-migrate-state oracle pins). Orchestration that COMPOSES state leaves
-- lives in the CONSUMER's module — exactly as `telegram:findActiveConversation`
-- / `dashboard:*` compose `state:listInstances` from their own modules. So the
-- query orchestration is a `query:*` body that calls the `state:` leaf
-- cross-module, keeping `state` native-/body-free. (Divergence from the brief's
-- "fenel/modules/state/…" home, taken to respect that invariant.)
--
-- A relSpec is a plain record `{ name, fieldOrder, typeName }`:
--   name      — the atom-head the query lambda uses (caller's verbatim choice).
--   fieldOrder — the projection columns IN ORDER (envelope fields id / accountId
--               / createdAt / updatedAt are ORDINARY columns — an id-join is
--               first-class).
--   typeName  — the entity_type to fetch (e.g. "profile", "purchase").
-- `expr` is the query predicate (an Expr value the caller builds); `rules` is a
-- pre-reified rules list (`[]` for a plain conjunctive query).
--
-- Semantics inherited from the P15/P16 split: `queryEntities` is findall (`Just
-- bindings`, possibly `Just []` = safe-but-empty); `queryEntitiesOne` is the
-- first witness (`Nothing` = no satisfying row / out-of-fragment). Scalar cells
-- match; a variant-valued cell rides but does not match (the materialize.fenel
-- shallow-eq honesty fence — a documented later widening).
--
-- storage-as-effect hand-off: the read rides `state:listInstancesByName` (the
-- stable `entity_instances` system table) today; it migrates to the generalized
-- read-effect when storage-as-effect lands it.
-- =========================================================================

module query where

-- materializeRelSpecs — fetch each relSpec's rows (the listInstancesByName IO
-- leaf) and assemble the relDef marker list, IN relSpec order (appendItem keeps
-- head-to-tail order, matching materialize.fenel's relationsFromDefs). The IO
-- recursion: one `listInstancesByName` per step; the durable executor suspends/
-- resumes each (continuation-based — no re-fetch). requires HasStateIO.
@label "Materialize rel specs"
@description "solver-extension Phase 4 internal helper: walk a relSpec list `{ name, fieldOrder, typeName }`, fetch each entity's flat merged-envelope rows via state:listInstancesByName, and build the relDef marker list `{ name, fieldOrder, instances }` in order (the materialize.fenel marker shape). One IO fetch per relSpec; requires HasStateIO."
@tags "query" "materialize" "relational" "phase-4"
@category "query"
@requires "HasStateIO"
materializeRelSpecs : List ({}) -> List ({}) -> List ({})
materializeRelSpecs relSpecs acc =
  case head relSpecs of
    Nothing -> acc
    Just rs ->
      let rows = listInstancesByName rs.typeName
      let rel = { name = rs.name, fieldOrder = rs.fieldOrder, instances = rows }
      let acc2 = appendItem rel acc
      case tail relSpecs of
        Nothing -> acc2
        Just rest -> materializeRelSpecs rest acc2

@label "Query entities (findall)"
@description "solver-extension Phase 4 — run a relational query (findall) over LIVE entity_instances: types = data = queryable. Fetch each relSpec's rows (state:listInstancesByName), assemble the relDef markers, and enumerate ALL satisfying bindings of the predicate Expr via the query:rel bridge (engine:queryRel = solve ∘ materialize, run in the engine's curated dispatch harness). relSpecs = list of `{ name, fieldOrder, typeName }`; rules = pre-reified rules (`[]` for a plain conjunctive query). Returns Just bindings (Just [] = safe-but-empty) or Nothing (out-of-fragment). requires HasStateIO (the read rides the state IO leaf — storage-as-effect migrates it to the generalized read-effect later)."
@tags "query" "solver" "relational" "materialize" "live" "phase-4"
@category "query"
@ioAction "query.entities"
@requires "HasStateIO"
queryEntities : Expr -> List ({}) -> List ({}) -> Maybe (List (List ({})))
queryEntities expr relSpecs rules =
  runRelQuery expr (materializeRelSpecs relSpecs []) rules

@label "Query entities one (findall first witness)"
@description "solver-extension Phase 4 — the first-witness sibling of queryEntities over LIVE entity_instances. Fetch + assemble the relDefs, then return the FIRST satisfying binding via the query:relOne bridge (engine:queryRelOne). Nothing = no satisfying row / out-of-fragment. requires HasStateIO."
@tags "query" "solver" "relational" "materialize" "live" "phase-4"
@category "query"
@ioAction "query.entities_one"
@requires "HasStateIO"
queryEntitiesOne : Expr -> List ({}) -> List ({}) -> Maybe (List ({}))
queryEntitiesOne expr relSpecs rules =
  runRelQueryOne expr (materializeRelSpecs relSpecs []) rules
