-- =========================================================================
-- Path module — parametric vector curves layered on top of Picture.
--
-- A CurvePath is a sequence of anchor Points joined by *linker functions*.
-- Each linker is `(Number, Point, Point) -> Point` for t in [0, 1] — a
-- parametric mapping from one anchor to the next. Lines, beziers, arcs,
-- sine displacements are all just different linker functions; the
-- CurvePath abstraction stays minimal. Two natives bridge CurvePath →
-- Picture: stroke (colour within thickness/2 of the curve) + fill
-- (even-odd interior). Both re-enter the evaluator to invoke linker
-- closures, so they are CTX natives.
--
-- module-substrate Phase 3i (2026-05-30) — path is a DISJOINT plain/ctx
-- module (= picture's 3f shape). The TS spec wrapper (engine/src/modules/
-- path.ts) is RETIRED. This file is the source of truth: the CurvePath
-- entity + the `line` linker (Fenel-bodied) + the `path` constructor
-- (Fenel-bodied — consolidated from the former path/path.fenel sidecar,
-- 3b/3g consolidation) + the 4 @native FOREIGN DECLARATIONS (stroke / fill
-- CTX → nativeImplsCtx; _pathHit / _pathInside plain → nativeImpls). Their
-- impls live in ffi/path-ffi.ts. Plain-vs-ctx is decided by which seam map
-- an impl lands in — the @native decl is uniform, no marker (axis #4).
--
-- The `path` codeName constructs the `CurvePath` entity (codeName-vs-entity
-- divergence — the std-tier `Path` ADT at fenel/std/paths.fenel is the
-- filesystem-path ADT, unrelated to this graphical curve). The natives are
-- categorised `vector` (NOT the `path` header default), so each carries an
-- explicit @category; `line` keeps the `path` module default.
--
-- Records (single constructor, all named fields) may be compact or use
-- indented field continuations. The `segments` field uses tuple-arrow syntax
-- `(Number, Point, Point) -> Point`. References to
-- `Point` resolve lazily through the catalog walk; picture loads before
-- path in SYSTEM_MODULES order.
-- =========================================================================

module path where

CurvePath = CurvePath anchors: [Point] segments: [(Number, Point, Point) -> Point]

-- ----- Foreign declarations (native-backed; impl in ffi/path-ffi.ts) -----

@native
@label "Stroke path"
@description "Render a CurvePath as a stroked Picture: colour col within thickness/2 of any point on the curve."
@category "vector"
@tags "path" "vector"
stroke : (path: CurvePath, thickness: Number, col: RgbaPixel) -> Picture

@native
@label "Fill path"
@description "Render a CurvePath as a filled Picture: colour col inside the closed shape (even-odd rule), transparent outside."
@category "vector"
@tags "path" "vector"
fill : (path: CurvePath, col: RgbaPixel) -> Picture

@native
@label "Path hit (internal)"
@description "Internal: per-pixel distance test for stroke's Field closure."
@category "vector"
@tags "internal"
_pathHit : (pts: [Point], half: Number, col: RgbaPixel, p: Point) -> RgbaPixel

@native
@label "Path inside (internal)"
@description "Internal: even-odd ray-cast inside test for fill's Field closure."
@category "vector"
@tags "internal"
_pathInside : (pts: [Point], col: RgbaPixel, p: Point) -> RgbaPixel

-- ----- Fenel-bodied constructor + linker -----

-- path — construct a typed CurvePath from a list of anchor Points and a
-- list of parametric linker functions. segments[i] connects anchors[i] to
-- anchors[i+1]. Consolidated from the former path/path.fenel sidecar.
path : [Point] -> [(Number, Point, Point) -> Point] -> CurvePath
@label "Curve path"
@description "Build a CurvePath from anchors and linker functions. segments[i] connects anchors[i] to anchors[i+1]. Returns the canonical typed CurvePath shape via the CurvePath constructor (codeName path constructs entity CurvePath — the std-tier Path ADT is the unrelated filesystem-path type)."
@category "vector"
@tags "path" "vector" "constructor"
path anchors segments = CurvePath { anchors = anchors, segments = segments }

-- The simplest linker: linear interpolation between anchors.
-- t=0 returns p1; t=1 returns p2; otherwise lerp.
line : Number -> Point -> Point -> Point
line t p1 p2 = point (lerp p1.x p2.x t) (lerp p1.y p2.y t)
