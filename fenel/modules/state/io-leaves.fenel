@ioAction "state.get_function"
@requires "HasStateIO"
@native
getFunction : (name: String) -> Maybe ({ id: String, accountId: String, name: String, version: Number, active: Boolean, isSystem: Boolean, sourceRegistryId: Any, function: Map String Any, createdAt: Any, updatedAt: Any })

@label "Pin to view"
@description "Append the given value to the user's active home view as an inline expression. Lets a function's body materialise UI artefacts directly — e.g. an init function that registers a bot can pin its Id<bot> for the user without a separate dashboard step."
@tags "state" "io" "ui" "desktop"
@icon "pin"
@emoji "📌"
@ioAction "state.pin_to_view"
@requires "HasStateIO"
@native
pinToView : (value: a) -> (caption: Maybe (String)) -> Unit

-- decodeCheckpointRow strips the physical encoding columns. Nullable joined
-- names/native Date timestamps remain Any. Checkpoint variables have dynamic
-- keys and may still be raw null on legacy rows, so their slot also remains Any.
@label "List function instances"
@description "Phase 12a sub-step 5 — return function_instances rows for the current account, optionally filtered by fnDbId (Nothing = any function) and statuses (Nothing = any status). Each row carries {id, functionId, functionName, status, variables, startedAt, completedAt} — functionName is joined from the functions table so callers don't N+1. Ordered by startedAt desc."
@tags "state" "io" "function-instance" "phase-12a"
@ioAction "state.list_function_instances"
@requires "HasStateIO"
@native
listFunctionInstances : (fnDbId: Maybe (String)) -> (statuses: Maybe ([String])) -> [{ id: String, functionId: String, functionName: Any, status: String, variables: Any, startedAt: Any, completedAt: Any }]

@label "Get function instance"
@description "Phase 12a sub-step 5 — fetch a single function_instances row by id for the current account. Returns Just row on hit, Nothing on miss (including cross-account access)."
@tags "state" "io" "function-instance" "phase-12a"
@ioAction "state.get_function_instance"
@requires "HasStateIO"
@native
getFunctionInstance : (instanceId: String) -> Maybe ({ id: String, functionId: String, accountId: String, profileId: Any, name: Any, icon: Any, status: String, currentStepPath: Any, variables: Any, triggerEvent: Any, parentInstanceId: Any, startedAt: Any, completedAt: Any })

@label "Start function instance"
@description "Phase 12a sub-step 5 — kick off a durable function_instance for the given DB function row id. profileId scopes the instance to a profile (Nothing for dashboard-initiated runs); source is the trigger-event-type string written into triggerEvent.type for trace attribution; params is the eventPayload spread into the body's variables. Returns the new instanceId. Wraps runtime/triggers.ts:startFunctionInstance."
@tags "state" "io" "function-instance" "phase-12a"
@ioAction "state.start_function_instance"
@requires "HasStateIO"
@native
startFunctionInstance : (dbFnId: String) -> (profileId: Maybe (String)) -> (source: String) -> (params: {  }) -> String

-- Caller event keys and resume-envelope keys vary. The success wire is
-- {ok, instance: Just row}; errors carry {ok, error: String}. A dynamic map
-- preserves both existing arms without inventing absent Maybe fields or tags.
@label "Resume waiting instance"
@description "Phase 12a sub-step 5 — resume a function_instance that's in awaiting_choice / waiting_event / waiting_timer with the caller-supplied event payload. The handler calls runtime/evaluator.ts:resumeWaitingInstance and re-reads the row to surface the post-resume status. Returns {ok: true, instance: Just <row>} on success or {ok: false, error: <msg>} on failure (the instance may complete OR remain suspended in a different status — the caller pattern-matches on instance.status)."
@tags "state" "io" "function-instance" "phase-12a"
@ioAction "state.resume_waiting_instance"
@requires "HasStateIO"
@native
resumeWaitingInstance : (instanceId: String) -> (event: Map String Any) -> (expectedSuspensionId: Maybe String) -> Map String Any

@label "Find last completed instance"
@description "Phase 12a sub-step 5 — fetch the most recent completed function_instance for a function (DB row UUID), scoped to the current account. Returns Just <row> when one exists, Nothing otherwise. Used by /io/last-result so pin cards hydrate from persisted state."
@tags "state" "io" "function-instance" "phase-12a"
@ioAction "state.find_last_completed_instance"
