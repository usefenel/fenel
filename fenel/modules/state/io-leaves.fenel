-- =========================================================================
-- FM-retire-10 — the 4 dependent-typing leaves. `Type` return (Ext1) +
-- lowercase-headed `$el` dependent params (Ext2). Same @native + @ioAction +
-- @requires "HasStateIO" shape as every leaf above; the only novelty is the sig
-- surface. schemaOf / typeclassMethodsSchema RETURN a first-class Type; their
-- ids are then usable as the `$el` call heads in tryCreateInstanceByName.value /
-- registerRepresentation.methods — Fenel dependent types authored in surface
-- syntax (the showcase outcome of the FenelModule-retirement arc).
-- =========================================================================

@label "Schema of"
@description "Return an entity_definition's pure type schema as a first-class Type value. Combined with `$el` in another parameter's type, this expresses dependent typing — e.g. `tryCreateInstanceByName(typeId, value)` where `value`'s schema is `$el {call: [\"schemaOf\", {var: \"typeId\"}]}`."
@tags "state" "io" "type" "schema" "dependent"
@ioAction "state.schema_of"
@requires "HasStateIO"
@native
schemaOf : (typeId: EntityRef<"entity_definition">) -> Type

@label "ClassSeed methods schema"
@description "Return a typeclass's methods record shape as a first-class Type value. Combined with `$el` in another parameter's type, this expresses dependent typing — e.g. `registerRepresentation(target, typeName, methods)` where `methods`'s schema is `$el {call: [\"typeclassMethodsSchema\", {var: \"typeName\"}]}`."
@tags "state" "io" "type" "schema" "dependent" "typeclass"
@ioAction "state.typeclass_methods_schema"
@requires "HasStateIO"
@native
typeclassMethodsSchema : (typeName: EntityRef<"typeclass">) -> Type

-- storage-as-effect Phase 1 (2026-06-19) — id Fenel-minted handler-side via
-- crypto:uuidV4 (see createInstance). Leaf surface UNCHANGED (dependent `value :
-- schemaOf typeId` $el param + precise Result return preserved).
@label "Try create instance"
@description "Persist a value as an instance of a registered entity type. Accepts the type's id (UUID, `system:<name>`, `module:<name>`) or its bare name — the handler resolves any form to the type's name. Wraps validation/insert errors in `{ok, value?: instanceId, error?: String}` instead of throwing. The instance id is Fenel-minted via crypto:uuidV4."
@tags "state" "io" "instance"
@ioAction "state.try_create_instance_by_name"
@requires "HasStateIO"
@native
tryCreateInstanceByName : (typeId: EntityRef<"entity_definition">) -> (value: schemaOf typeId) -> { ok: Boolean, value: Maybe (EntityRef<"instance">), error: Maybe (String) }

@label "Register typeclass instance"
@description "Persist a typeclass_instances row scoped to the current account, and merge into the in-memory typeclass registry so subsequent dispatch sees the new instance. Used by registration flows that wire Labelable/Iconable/Emojiable/Describable for newly-created entities."
@tags "state" "io" "typeclass" "representation"
@ioAction "state.register_representation"
@requires "HasStateIO"
@native
registerRepresentation : (targetId: EntityRef<"entity_definition">) -> (typeName: EntityRef<"typeclass">) -> (methods: typeclassMethodsSchema typeName) -> Unit


-- Identity-only transactional leaf. Authenticated orchestration and pure
-- planning live in auth/accounts.fenel. Registered by its canonical fn id.
@requires "HasStateIO"
@native
ensurePersonalAccount : (userId: String) -> (candidateAccount: String) -> (candidateMembership: String) -> Result String String
