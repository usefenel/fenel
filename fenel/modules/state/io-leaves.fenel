-- =========================================================================
-- module state where — the persistence-leaf IO volume (142 bodyless leaves).
--
-- typed-function-references Phase FM-retire-8 Step 1 (2026-06-07). These 142
-- functions are irreducible host-IO leaves: each is BODYLESS and dispatches to a
-- runtime IO handler keyed by its `@ioAction` (registered in
-- runtime/handlers/state.ts via `registerStateHandlers` — UNCHANGED by this
-- migration). They were hand-wrapped `defineFunction` specs in
-- engine/src/modules/state.ts; their declaration now rides `@native` (bodyless
-- foreign-decl, the Phase-3b convention) + `@ioAction` + `@requires "HasStateIO"`
-- + @facet directives here (the telegram/io.fenel mechanic).
--
-- This file was generated by a one-shot generate-then-verify codemod
-- (engine/scripts/_gen-state-fenel.ts, since deleted) which round-tripped each
-- leaf byte-faithfully against the original TS spec (params name+type / returns /
-- requires / Codeable / Labelable / Describable / Taggable / Iconable / Emojiable
-- / IOInvokable; Categorizable asserted ABSENT — Phase-3j read-time derives the
-- category from the `state:` id prefix). The `.fenel` is now the source of truth.
--
-- Container types render in the `.fenel` PREFIX application form `Maybe (X)` /
-- `[X]` / `Result (E) (A)` (not printType's angle-bracket `Maybe<X>`, whose nested
-- `Maybe<EntityRef<"Bot">>` collapses to a stray `>>` operator token). The
-- `$tagged` Id phantom round-trips as `EntityRef<"name">`. Empty-record
-- placeholders (`{}` / `[{}]` / `Maybe ({})`) ride byte-faithfully — they are a
-- separate deferred `$el`-dependent-typing task, NOT modelled here.
--
-- FM-retire-10 (2026-06-07) — the 4 dependent-typing fns (schemaOf /
-- typeclassMethodsSchema / tryCreateInstanceByName / registerRepresentation) are
-- now ALSO authored here, at the tail of this file. Two parser extensions landed
-- their sig surface: Ext1 = the `Type` type-atom (`-> Type` ⇒ `{$type:true}`) and
-- Ext2 = the lowercase-headed `$el` dependent param (`value : schemaOf typeId` ⇒
-- `{$el:{call:["schemaOf",{var:"typeId"}]}}`). state.ts is now a thin
-- `loadFenelModule` seam at 0 `defineFunction`. The 7 `crypto:*` fns + 1
-- `dispatch:*` fn spun out to their own modules in Steps 2-3.
-- =========================================================================

module state where

@label "Load Type"
@description "Fetch a registered FenelType by its UUID. Returns Nothing when the type is not found in the current account or system catalog."
@tags "state" "io" "type"
@ioAction "state.load_type"
@requires "HasStateIO"
@native
loadType : (typeId: EntityRef<"entity_definition">) -> Maybe ({  })

-- storage-as-effect Phase 1 (2026-06-19) — the entity id is now Fenel-minted: the
-- `state.create_instance` IO handler mints it via the `crypto:uuidV4` body
-- (invokeCallable, pure) and passes it explicitly to createEntityInstance, instead
-- of relying on Postgres `gen_random_uuid()` (the headline leak,
-- [[project_storage_is_an_effect]] / design/storage-as-effect.md D3). The leaf
-- surface here is UNCHANGED (bodyless @native): the mint is sourced inside the
-- handler (which already orchestrates resolve/strip/verify/store) rather than by
-- converting createInstance into a Fenel body that mints-then-stores. That choice
-- is a PERF + risk call, NOT a language limit — a Fenel body CAN end in an IO call
-- and returns its value fine (pinned by runtime/evaluator.test.ts "bare IO-tail").
-- Routing this HOT create leaf through a body would spawn a durable
-- function_instance per create + touch the order-sensitive HasStateIO dispatch;
-- handler-side mint keeps the create path byte-identical.
@label "Create Instance"
@description "Persist a value as an instance of the given type. The value is validated against the type's $record shape; on success returns the new instance's UUID (Fenel-minted via crypto:uuidV4, no DB round-trip for identity)."
@tags "state" "io" "instance"
@ioAction "state.create_instance"
@requires "HasStateIO"
@native
createInstance : (typeId: EntityRef<"entity_definition">) -> (value: {  }) -> EntityRef<"instance">

@label "Update Instance"
@description "Replace the data of an existing instance with the given value. Validates against the instance's type schema before writing."
@tags "state" "io" "instance"
@ioAction "state.update_instance"
@requires "HasStateIO"
@native
updateInstance : (instanceId: EntityRef<"instance">) -> (value: {  }) -> Unit

@label "Delete Instance"
@description "Delete an entity_instances row by id within the current account. Wraps SQL errors in `{ok, error?: String}` rather than throwing — DELETE is idempotent on the wire (a missing row reports ok: true)."
@tags "state" "io" "instance"
@ioAction "state.delete_instance"
@requires "HasStateIO"
@native
deleteInstance : (instanceId: EntityRef<"instance">) -> {  }

@label "Validate entity instance"
@description "Phase 12b — pure validation against a registered entity's FenelType. Returns Result {ok: true, value} | {ok: false, errors: [{path, message}]} without persisting. `partial=true` narrows the type to only fields present in raw, suitable for PATCH semantics. Replaces the Zod prelude in dashboard.ts wrappers."
@tags "state" "io" "validation" "phase-12b"
@ioAction "state.validate_entity_instance"
@requires "HasStateIO"
@native
validateEntityInstance : (typeName: String) -> (raw: {  }) -> (partial: Boolean) -> {  }

@label "Append Event"
@description "Append a typed event to the events log. Triggers user-defined function handlers that bind on this event type. Provenance fields (aggregateType / aggregateId / profileId) are optional Maybe<String> — Nothing leaves the corresponding DB column null."
@tags "state" "io" "event"
@ioAction "state.append_event"
@requires "HasStateIO"
@native
appendEvent : (type: String) -> (payload: {  }) -> (aggregateType: Maybe (String)) -> (aggregateId: Maybe (String)) -> (profileId: Maybe (String)) -> Unit

@label "Get Instance"
@description "Fetch an instance by id. Dispatches across the durable system tables when the type maps to one (bot → bots, conversation → conversations, profile → profiles, …); falls through to entity_instances for user-defined types. Returns the row's data record or Nothing when not found."
@tags "state" "io" "instance"
@ioAction "state.get_instance"
@requires "HasStateIO"
@native
getInstance : (typeId: EntityRef<"entity_definition">) -> (instanceId: EntityRef<"instance">) -> Maybe ({  })

@label "Get instance by id"
@description "Fetch a single entity_instances row by id (no typeId) within the current account. Returns Just <full envelope row {id, accountId, entityType, data, createdAt, updatedAt}> on hit, Nothing on miss or cross-account access. Sister of getInstance (typeId-keyed, body-shape); this returns the raw envelope for response flattening + entityType guards."
@tags "state" "io" "instance"
@ioAction "state.get_instance_by_id"
@requires "HasStateIO"
@native
getInstanceById : (id: EntityRef<"instance">) -> Maybe ({  })

@label "Resolve instance by name"
@description "Resolve a CodeableName to its entity_instances row(s) within the current account, surfacing the explicit-ambiguity LookupResult: Unique <envelope> for one match, Conflict <list of envelopes> for a same-(account, entityType) tie, None on miss. Resolution inverts the Codeable typeclass projection (matches the persisted Codeable instances, not a `codeName` data field), so it resolves instances whose name lives only as a Codeable projection. Optional entityType narrows a codeName shared across types. The scoped name→value adjoint of the Codeable value→name projection."
@tags "state" "io" "instance"
@ioAction "state.resolve_instance_by_name"
@requires "HasStateIO"
@native
resolveInstanceByName : (codeName: String) -> (entityType: Maybe (String)) -> LookupResult ({})

@label "Get instance by name"
@description "Fetch a single entity_instances row by its CodeableName (the Codeable typeclass projection keyed by the row id) within the current account. Optional entityType narrows a codeName shared across types. Returns Just <full envelope row {id, accountId, entityType, data, createdAt, updatedAt}> on a UNIQUE match, Nothing on miss, cross-account access, OR an ambiguous (Conflict) resolution. Sister of getInstanceById (UUID-keyed); this is the CodeableName-keyed read — the opaque Identifiable handle class resolves through one or the other per handle kind. The Maybe adapter over resolveInstanceByName (which surfaces the Conflict arm)."
@tags "state" "io" "instance"
@ioAction "state.get_instance_by_name"
@requires "HasStateIO"
@native
getInstanceByName : (codeName: String) -> (entityType: Maybe (String)) -> Maybe ({  })

@label "List Instances"
@description "Return instances of the given type for the current account, optionally filtered by a containment record. The filter is ANDed across keys (JSONB `@>` semantics). Pass Nothing to list every instance."
@tags "state" "io" "instance"
@ioAction "state.list_instances"
@requires "HasStateIO"
@native
listInstances : (typeId: EntityRef<"entity_definition">) -> (where: Maybe ({  })) -> [{  }]

-- storage-as-effect Phase 1 (2026-06-19) — id Fenel-minted handler-side via
-- crypto:uuidV4 (see createInstance above). Leaf surface UNCHANGED.
@label "Try create instance"
@description "Persist a typed-constructor value as an entity instance. The value's `$tag` field identifies the registered entity to validate against. Wraps validation/insert errors in `{ok, value?: instanceId, error?: String}` instead of throwing — prefer over `tryCreateInstanceByName` (which exists for legacy callers passing an explicit type name). The instance id is Fenel-minted via crypto:uuidV4."
@tags "state" "io" "instance"
@ioAction "state.try_create_instance"
@requires "HasStateIO"
@native
tryCreateInstance : (value: {  }) -> {  }

@label "Call hook function (String)"
@description "Execute a user-defined Fenel function by codeName and project its result to Maybe<String>. Used by collector orchestration bodies to invoke welcome / completion hooks. Returns Just <text> when the hook produced a non-empty string, Nothing otherwise (including missing function, errors, or non-string results)."
@tags "state" "io" "hook"
@ioAction "state.call_hook_function_string"
@requires "HasStateIO"
@native
callHookFunctionString : (fnSlug: String) -> (args: {  }) -> Maybe (String)

@label "Call hook function (Record)"
@description "Execute a user-defined Fenel function by codeName and project its result to Maybe<Record>. Used by the form-fill onField hook path: the hook returns a CollectorAction (a tagged record) describing how to handle the user's reply. Returns Nothing when the hook is missing, throws, or produces a non-object value."
@tags "state" "io" "hook"
@ioAction "state.call_hook_function_record"
@requires "HasStateIO"
@native
callHookFunctionRecord : (fnSlug: String) -> (args: {  }) -> Maybe ({  })

@label "Delete subscription"
@description "Remove the subscription row keyed by slug. Used by collector teardown to deregister the inbound webhook handler."
