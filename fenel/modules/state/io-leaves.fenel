deleteSubscription : (slug: String) -> Unit

@label "Dispatch event to user-defined triggers"
@description "Run every user-defined function trigger that matches the given event type and payload. The trigger registry decides which functions to instantiate; their bodies execute through the same durable runtime as direct calls."
