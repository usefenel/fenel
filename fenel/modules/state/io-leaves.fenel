@label "Create membership"
@description "Create a membership row — THE act that introduces authority into an account. Present only in the owner envelope, argued there on the account and the role (rights R2b). Wraps @fenel/db:createMembership."
@tags "state" "io" "auth" "membership" "grant"
@ioAction "state.create_membership"
@requires "HasStateIO"
@native
-- ⚠ `role` IS A STRING, not a Maybe, and the reason is the gate rather than
-- ergonomics. A FieldAxis judges the own entry the act carries, and a `Maybe`
-- payload is an OBJECT; the host `elem` matches objects by REFERENCE, so
-- `Just "owner"` is in no enumeration an envelope can write. The default moves
-- to the one Fenel caller (`auth:createMembershipForRole`), which resolves
-- Nothing to "member" before the act exists.
createMembership : (userId: String) -> (accountId: String) -> (role: String) -> {  }

@label "Set membership role"
