@ioAction "state.dispatch_event_triggers"
@requires "HasStateIO"
@native
dispatchEventTriggers : (eventType: String) -> (payload: {  }) -> Unit

@label "List instances by type name"
@description "List every entity_instances row whose entity_type equals the given name. Sister to `listInstances` (which takes a type UUID); this version takes the type name directly — useful for system entities like 'bot' / 'profile' that don't have a UUID type row in the types DB table. Returns merged-envelope rows `{id, accountId, ...data, createdAt, updatedAt}` so callers can flatten without a second IO trip (system entities like 'bot' keep their bespoke flatten via listBotsByAccount)."
@tags "state" "io" "instance" "list"
@ioAction "state.list_instances_by_name"
@requires "HasStateIO"
@native
listInstancesByName : (typeName: String) -> [{  }]

