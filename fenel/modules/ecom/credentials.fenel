-- =========================================================================
-- Ecom provider credential requirements (signature-substrate Phase 4-prep,
-- D0b; carbon-copy of ai/email `credentials.fenel`).
--
-- Each is a `ProviderCredentials { capability, provider, envVars }`
-- value-decl; the seam loads this file as a SIDECAR
-- ({dispatchInstanceFile:true}), reads each projected
-- `{typeName:"ProviderCredentials", methods:{capability, provider,
-- envVars}}` back, and reassembles the byte-identical
-- `ProviderCredentials[]` for the Module `credentialRequirements` field.
-- NOT merged into `ecomModule.instances` — pure data read at the seam.
--
-- The former AI rows (anthropic / openai) are OWNED by the `ai` module
-- (`fenel/modules/ai/credentials.fenel`) and are not re-declared here.
-- Order (sms / telegram / stripe / nowpayments) + envVars preserved
-- verbatim from the retired const.
-- =========================================================================

smsCredentials : ProviderCredentials
smsCredentials = ProviderCredentials { capability = "Messaging", provider = "sms", envVars = ["TWILIO_SID", "TWILIO_AUTH_TOKEN", "TWILIO_FROM"] }

telegramMessagingCredentials : ProviderCredentials
telegramMessagingCredentials = ProviderCredentials { capability = "Messaging", provider = "telegram", envVars = ["TELEGRAM_BOT_TOKEN"] }

stripeCredentials : ProviderCredentials
stripeCredentials = ProviderCredentials { capability = "Payment", provider = "stripe", envVars = ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"] }

nowpaymentsCredentials : ProviderCredentials
nowpaymentsCredentials = ProviderCredentials { capability = "Payment", provider = "nowpayments", envVars = ["NOWPAYMENTS_API_KEY"] }
