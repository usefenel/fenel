-- =========================================================================
-- Ecom provider + storage instances — Fenel typed values (signature-
-- substrate Phase 4-prep, D0b; the ai/email `instances.fenel` string-method
-- model: methods are fnId strings — the qualified dispatch names the
-- runtime provider layer routes on (`resolveCapabilityMethod` keys off
-- `provider.args[0]` + the method name, never the spec fields); `label` +
-- `priority` lift to the instance slots).
--
-- The retired TS provider consts carried per-provider methodSpec PARAM
-- lists (e.g. stripe's success_url/cancel_url); those specs were display/
-- legacy payloads the runtime never consults — the codec/email/ai ports
-- established the string-method shape as the `.fenel`-authored form. The
-- AI provider rows formerly duplicated here are OWNED by the `ai` module
-- (`fenel/modules/ai/instances.fenel`) and are not re-declared.
--
-- Storage instances keep their handler codeNames verbatim (s3_/r2_/local_*)
-- — routing payloads, not signature authority.
-- =========================================================================

messagingSms : Messaging "sms"
messagingSms = Messaging { send = "Messaging.sms.send", label = "SMS (Twilio)", priority = 5 }

messagingTelegram : Messaging "telegram"
messagingTelegram = Messaging { send = "Messaging.telegram.send", label = "Telegram", priority = 3 }

paymentStripe : Payment "stripe"
paymentStripe = Payment { create_checkout = "Payment.stripe.create_checkout", verify = "Payment.stripe.verify", refund = "Payment.stripe.refund", label = "Stripe", priority = 10 }

paymentNowpayments : Payment "nowpayments"
paymentNowpayments = Payment { create_checkout = "Payment.nowpayments.create_checkout", verify = "Payment.nowpayments.verify", refund = "Payment.nowpayments.refund", label = "NOWPayments (Crypto)", priority = 5 }

storageS3 : Storage "s3"
storageS3 = Storage { store = "s3_store", retrieve = "s3_retrieve", delete = "s3_delete", publicUrl = "s3_url" }

storageR2 : Storage "r2"
storageR2 = Storage { store = "r2_store", retrieve = "r2_retrieve", delete = "r2_delete", publicUrl = "r2_url" }

storageLocal : Storage "local"
storageLocal = Storage { store = "local_store", retrieve = "local_retrieve", delete = "local_delete", publicUrl = "local_url" }
