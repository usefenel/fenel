-- =========================================================================
-- Migration module — sample `DemoV1 → DemoV2` instance + per-case check
-- natives backing the typeclass laws.
--
-- Phase 10 of the implementation roadmap. Registers ONE worked Migration
-- instance (`migrationDemoV1ToV2`) plus the law-check natives
-- (`migration:roundtripCheck` / `migration:forwardTotalCheck`) that the
-- typeclass laws delegate to. The two worked Migration instances live in the
-- `instances.fenel` sidecar (loaded `{ dispatchInstanceFile: true }`).
--
-- module-substrate Phase 3i (2026-05-30) — migration is a DISJOINT plain/ctx
-- module. The ~515-LOC hand-assembled TS module (engine/src/modules/
-- migration.ts — 5 `defineFunction` specs + inline native impls + helpers) is
-- RETIRED. This file carries the declarative half: the 5 @native FOREIGN
-- DECLARATIONS (3 plain `profileDemoV1ToV2` / `profileDemoV2ToV1` /
-- `profileDemoV2ToV1Narrow` → nativeImpls; 2 ctx `roundtripCheck` /
-- `forwardTotalCheck` → nativeImplsCtx). Their impls live in
-- ffi/migration-ffi.ts. 0 entities, 0 Fenel-bodied helpers. Plain-vs-ctx is
-- decided by which seam map an impl lands in — the @native decl is uniform, no
-- marker (axis #4). The lowercase `migration` name + `migration:` id-prefix +
-- `migration` category stay byte-identical.
--
-- The per-version demo types (ProfileDemoV1 / ProfileDemoV2 /
-- ProfileDemoV1Narrow) are declared below (modules-as-values Phase 2d); they
-- were bare names before. `MigrationError` and `Losslessness` are declared
-- beside the `Migration` class in fenel/std/interfaces.fenel. Wire shapes are
-- unchanged: the natives build and read plain `{firstName, lastName, …}`
-- records.
-- =========================================================================

module migration where

-- ----- The demo profile versions -------------------------------------------

ProfileDemoV1 = ProfileDemoV1 firstName: String lastName: String

ProfileDemoV2 = ProfileDemoV2 firstName: String lastName: String email: String

ProfileDemoV1Narrow = ProfileDemoV1Narrow firstName: String

-- ----- Foreign declarations (native-backed; impl in ffi/migration-ffi.ts) -----

@native
@label "profile_demo: V1 → V2"
@description "Forward migration of the demo profile entity: copy firstName / lastName, default email to empty string. The Lossless invariant holds: backward composes to identity on values whose email is `\"\"`."
@tags "migration" "forward" "profile_demo"
profileDemoV1ToV2 : (value: ProfileDemoV1) -> Result MigrationError ProfileDemoV2

@native
@label "profile_demo: V2 → V1"
@description "Backward migration of the demo profile entity: drop the email field. Combined with profileDemoV1ToV2 it produces the Lossless `Migration<ProfileDemoV1, ProfileDemoV2>` instance (backward(forward(v1)) = Ok v1 for every v1 in the sample set)."
@tags "migration" "backward" "profile_demo"
profileDemoV2ToV1 : (value: ProfileDemoV2) -> Result MigrationError ProfileDemoV1

@native
@label "profile_demo: V2 → V1Narrow (drop lastName)"
@description "Lossy forward migration: V2 → V1Narrow drops the lastName field. The companion Migration instance declares `Lossy { reason: \"lastName is dropped on forward\" }` and carries `{$tag: \"Nothing\"}` as backward — there's no way to recover the dropped value. Demonstrates the Lossy variant of the typeclass shape."
@tags "migration" "forward" "lossy" "profile_demo"
profileDemoV2ToV1Narrow : (value: ProfileDemoV2) -> Result MigrationError ProfileDemoV1Narrow

@native
@label "Migration Roundtrip Check"
@description "Backs the `migration-roundtrip-lossless` law. Iterates the per-instance sample list, applies forward then backward, and asserts deepEq with the original v1. Returns `Just true` when every sample passes, `Just false` on refutation, `Nothing` when the instance is Lossy or has no samples (vacuous)."
@tags "migration" "law" "roundtrip" "check"
roundtripCheck : (forward: Any, backward: Any, losslessness: Any, samples: Any) -> Maybe Boolean

@native
@label "Migration Forward Totality Check"
@description "Backs the `migration-forward-total` law. Iterates the per-instance sample list and asserts every `forward(v1)` returns `Ok _`. Returns `Just true` on success, `Just false` if any forward returns `Err _`, `Nothing` when no samples are supplied."
@tags "migration" "law" "forward" "check"
forwardTotalCheck : (forward: Any, samples: Any) -> Maybe Boolean
