-- Migration typeclass instances — Fenel-authored typed values (Phase 3.2 of
-- typeclass-substrate-completion, 2026-05-29).
--
-- The two worked Migration instances: the Lossless DemoV1 → DemoV2 (adds an
-- `email` field, defaulted to "") and the Lossy DemoV2 → DemoV1Narrow (drops
-- `lastName`). Each is a typed VALUE of `Migration v1 v2`; `loadFenelModule`
-- projects it into the legacy `SpecInstance { typeName = "Migration", args,
-- methods, label }` cache shape downstream dispatch + the migration path-finder
-- read (see fenel/modules/codec/instances.fenel for the module-path template).
--
-- Phase 3.2 extended the loader to carry NON-string method values:
--   - `backward`        — `Just migration.x` / `Nothing` (a Maybe variant)
--   - `losslessness`    — `Lossless` / `Lossy { reason }` (a variant)
--   - `roundtripSamples`— an inline list of anonymous v1 records
-- The loader's `lowerConstructLiteral` lowers `{construct:[...]}` bodies to the
-- canonical `{$tag, ...}` runtime shape, and lifts the top-level `label`
-- method-field into the `SpecInstance.label` slot (mirroring the `priority`
-- lift). `roundtripSamples` are anonymous records (no `$tag`) — matching the
-- TS const's plain `{firstName, lastName}` JS objects exactly.
--
-- modules-as-values Phase 2d: `forward` holds the function itself
-- (`migration.profileDemoV1ToV2`, loaded as a `{$ref}` reference), and
-- `backward = Just migration.profileDemoV2ToV1` holds one inside the Just. The
-- parser gives that Just the same JSON as a record literal with a field named
-- `var`; the migration seam (engine/src/modules/migration.ts) lowers it by the
-- declared field type, `Maybe (v2 -> Result MigrationError v1)`, to
-- `{$tag:"Just", _0:{$ref:"migration.profileDemoV2ToV1"}}`.

migrationDemoV1ToV2 : Migration ProfileDemoV1 ProfileDemoV2
migrationDemoV1ToV2 = Migration {
  forward = migration.profileDemoV1ToV2,
  backward = Just migration.profileDemoV2ToV1,
  losslessness = Lossless,
  roundtripSamples = [
    { firstName = "Ada", lastName = "Lovelace" },
    { firstName = "Grace", lastName = "Hopper" },
    { firstName = "Linus", lastName = "Torvalds" },
    { firstName = "", lastName = "" },
    { firstName = "Edge", lastName = "Case" }
  ],
  label = "profile_demo @v1 → @v2 (add email)"
}

migrationDemoV2ToV1Narrow : Migration ProfileDemoV2 ProfileDemoV1Narrow
migrationDemoV2ToV1Narrow = Migration {
  forward = migration.profileDemoV2ToV1Narrow,
  backward = Nothing,
  losslessness = Lossy { reason = "lastName is dropped on forward — no way to recover it from a V1Narrow value" },
  roundtripSamples = [
    { firstName = "Bob", lastName = "Smith", email = "bob@example.com" },
    { firstName = "", lastName = "", email = "" },
    { firstName = "Carol", lastName = "Singh", email = "carol@example.org" }
  ],
  label = "profile_demo @v2 → @v1Narrow (drop lastName — Lossy)"
}
