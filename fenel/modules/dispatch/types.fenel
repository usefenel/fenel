-- =========================================================================
-- Dispatch — value-level type-driven polymorphic functions + the Fenel-callable
-- scoped-instance-registry surface.
--
-- A polymorphic `sample` / `render` dispatch on the runtime tag of their first
-- argument (driven by Sampleable / Renderable typeclass instances), plus the
-- dispatch.register / lookup / lookupOne / lookupAll / listAllInstances /
-- getType primitives + the dashboard registry-enumeration reads.
--
-- module-substrate Phase 3i (2026-05-30) — dispatch is a CTX-ONLY module (no
-- plain nativeImpls, like animation/track). The ~654-LOC hand-assembled TS
-- module (engine/src/modules/dispatch.ts — 13 `defineFunction` specs + inline
-- native impls + the lazyDispatchDeps cycle-break) is RETIRED. This file
-- carries the declarative half: the 13 @native FOREIGN DECLARATIONS. 8 are
-- backed by a ctx native in ffi/dispatch-ffi.ts (sample / render / lookup /
-- lookupOne / lookupAll / listAllInstances / getType / register); the other 5
-- (listSystemEntities / listModuleEntities / listModuleFunctions /
-- getModuleFunction / refreshAccountInstances) are ioAction-ONLY — their
-- impl is a runtime IO handler, so they are bodyless @native + @ioAction decls
-- with no entry in the ctx native map. Plain-vs-ctx is decided by which seam
-- map an impl lands in — no marker (axis #4). The lowercase `dispatch` name +
-- `dispatch:` id-prefix stay byte-identical.
--
-- The LookupResult ADT lives in fenel/modules/engine/dispatch.fenel and is
-- merged in by the seam (kept there — it is the dispatch-scoped ambiguity
-- surface; loaded for the entity, not consolidated). The `Any` / `DispatchKey`
-- / `Unit` types are $named refs — placeholders matching the retired spec's
-- untyped registry values (exact type-shape byte-equality is not required for
-- parity).
--
-- @codeName notes: 6 fns carry a `dispatch`-prefixed GLOBAL codeName while the
-- fnId keeps the short suffix (dispatch:lookupOne's codeName is
-- dispatchLookupOne, etc.) — preserved via @codeName. The ctx native map is
-- keyed by the short fnId-suffix, so rekeyNativesById yields the right id
-- regardless of codeName. sample / render are categorised `core` (NOT the
-- `dispatch` header default), so each carries an explicit @category.
-- =========================================================================

module dispatch where

-- ----- Foreign declarations (native-backed; impl in ffi/dispatch-ffi.ts) -----

@native
@label "Sample (polymorphic)"
@description "Sample any sampleable value (Picture / Sound / Animation / Movie / Behavior) at a coordinate. Dispatches to the modality's sample implementation based on the value's runtime tag — driven by Sampleable typeclass instances."
@category "core"
@tags "polymorphic" "dispatch" "primitive"
sample : (value: a, coord: b) -> c

@native
@label "Render (polymorphic)"
@description "Render any renderable value (Picture / Sound / Animation / Movie) to its concrete buffer. Dispatches by runtime tag via Renderable typeclass instances; trailing args differ per modality (Picture: w, h; Sound: duration, sampleRate; Animation: duration, fps, w, h; Movie: duration, fps, sampleRate, w, h)."
@category "core"
@tags "polymorphic" "dispatch" "primitive"
render : (value: a) -> c

@native
@codeName "dispatchLookupOne"
@label "Dispatch Lookup One"
@description "Strict resolver. Unique x -> Just x; None -> Nothing; Conflict _ throws. Callers wanting permissive selection use dispatchLookupAll; callers wanting the ambiguity surface use dispatchLookup and pattern-match on LookupResult. Today's silent-priority-picking registry never populates Conflict, so this is effectively `Maybe` of a single-match lookup until 10a-4 lands."
@ioAction "dispatch.lookup_one"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive"
lookupOne : (specTypeId: String, target: String) -> Maybe Any

@native
@codeName "dispatchLookupAll"
@label "Dispatch Lookup All"
@description "Return every matching instance's methods in registry priority order. Permissive resolver — callers see every candidate, not just the highest-priority pick. Useful for debug overlays, conflict-resolution UI, and any caller that wants to surface ambiguity rather than collapse it."
@ioAction "dispatch.lookup_all"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive"
lookupAll : (specTypeId: String, target: String) -> List Any

@native
@codeName "dispatchListAllInstances"
@label "Dispatch List All Instances"
@description "Phase 10b sub-step 3 / signature-substrate Phase 2 — list every instance for a specTypeId regardless of target. Returns full own-data instance rows ({args: List Any, methods: Any, scope: Any, priority: Number}) in priority-descending order. The dynamic method/scope/type-expression carriers are explicit native-boundary Any slots; the row topology is exact. Sync-native-only — no body, no ioAction."
@requires "HasRegistry"
@tags "dispatch" "registry" "primitive" "phase-10b"
listAllInstances : (specTypeId: String) -> List ({ args: List Any, methods: Any, scope: Any, priority: Number })

@native
@codeName "dispatchGetType"
@label "Dispatch Get Type"
@description "Resolve a type's dispatch face (its Interface — name + methods + laws + supers) by name. Returns Just record on hit, Nothing on miss (a plain data type has no dispatch face). Sync-native-only. Used by engine:representationalClasses to lift class names into full Interface records. universal-dispatch-convergence Phase 5 — renamed from getClass/dispatchGetClass now that a class is just a TYPE (the A∪B store convergence made getType one operation over all types; this is its dispatch-face projection). Untyped Value return; the wrapper recasts."
@requires "HasRegistry"
@tags "dispatch" "registry" "primitive" "phase-10b"
getType : (typeName: String) -> Maybe Any

@native
@codeName "dispatchRegister"
@label "Dispatch Register"
@description "Register an instance for dispatch with a typed DispatchKey. ByType target dispatches nominally on the spec codename (legacy parity); ByValue value dispatches on a literal value (new); ByPattern predicate dispatches on a structural predicate (reserved; lookup doesn't yet match). Wraps specRegistry.addInstance under a DispatchKey-aware handler."
@ioAction "dispatch.register"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive" "typed-id"
register : (specTypeId: String, key: DispatchKey, methods: Any, scope: Maybe String) -> Unit

@native
@codeName "dispatchUnregister"
@label "Dispatch Unregister"
@description "The per-instance inverse of dispatchRegister — drop every instance of specTypeId whose dispatch target (args[0]) equals target. Wraps specRegistry.removeInstance. Takes a plain string target (like dispatchLookupOne / dispatchLookupAll), not a DispatchKey — the ByValue/ByPattern removal paths are reserved alongside their lookup counterparts. module-substrate Phase 3v.6 (closes the field-providers natives: unregisterProvider / unregisterBinding compose this)."
@ioAction "dispatch.unregister"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive"
unregister : (specTypeId: String, target: String) -> Unit

@native
@label "List system entities"
@description "Phase 12a sub-step 4 — return every engine compile-time system entity ({id, type?, module = \"system\"}). Wraps the `systemEntities` array exported from engine/src/system-entities.ts. Used by the dashboard /types Fenel body to synthesize the `system:<name>` rows that merge with DB type rows + module entities."
@ioAction "dispatch.list_system_entities"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive" "phase-12a"
listSystemEntities : List Any

@native
@label "List module entities"
@description "Phase 12a sub-step 4 — return every module-registered entity ({id, type, module?}) from the system registry. Wraps getSystemRegistry().listEntities(). Used by the dashboard /types Fenel body to synthesize `module:<name>` rows for entities (Picture, Sound, Animation, …) that don't have a DB row."
@ioAction "dispatch.list_module_entities"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive" "phase-12a"
listModuleEntities : List Any

@native
@label "List module functions"
@description "Phase 12a sub-step 4 — return every module-registered FenelFunction ({id, codeName?, label?, …}) from the system registry. Wraps getSystemRegistry().listFunctions(). Used by the dashboard /functions Fenel body to synthesize `module:<fn>` rows that don't have a DB row."
@ioAction "dispatch.list_module_functions"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive" "phase-12a"
listModuleFunctions : List Any

@native
@codeName "getModuleFunction"
@label "Get module function"
@description "Phase 12a sub-step 5 — resolve a module-registered FenelFunction record by its fnId. Returns Just <fn> on hit, Nothing on miss. Wraps getSystemRegistry().getFunction(fnId). Sister of listModuleFunctions (12a-4). Used by /io/invoke's decideInvoke body to read fn.params + check fn.body for the durable-vs-oneshot decision."
@ioAction "dispatch.get_module_function"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive" "phase-12a"
getModuleFunction : (fnId: String) -> Maybe Any

@native
@codeName "dispatchLookup"
@label "Dispatch Lookup"
@description "Resolve an instance for (specTypeId, DispatchKey). ByType dispatches nominally on the spec codename; ByValue / ByPattern resolutions surface through the same LookupResult ADT. Walks block scope (innermost withInstance frame) → tag / global scope (persisted registry). ByPattern keys are RESERVED — today's lookup never matches them."
@ioAction "dispatch.lookup"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive" "typed-id"
lookup : (specTypeId: String, key: DispatchKey) -> LookupResult Any

@native
@label "Refresh account typeclass instances"
@description "Phase 12a sub-step 6 — re-read all typeclass_instances rows for the current account from the DB and re-apply them to the in-memory specRegistry, replacing the prior account-scoped set. Called by the dashboard typeclass-instance CRUD route bodies after each write so subsequent dispatch resolves through the new state without a server restart."
@ioAction "dispatch.refresh_account_spec_instances"
@requires "HasStateIO"
@requires "HasRegistry"
@tags "dispatch" "registry" "io" "primitive" "phase-12a"
refreshAccountInstances : Unit

-- typed-function-references Phase FM-retire-8 Step 3 (2026-06-07) — the lone
-- `dispatch:dispatchAction` IO leaf folds in here from state.ts (it belongs to
-- this module — internal action dispatch). Bodyless ioAction-backed @native +
-- @requires "HasStateIO"; the runtime IO handler `dispatch.dispatch_action`
-- (registerDispatchHandlers) is UNCHANGED. category "dispatch" === the prefix →
-- @category OMITTED.
@native
@label "Dispatch action (internal)"
@description "Phase 12d sub-step 2 — invoke a registered action by name with System subject. Used by Fenel bodies that compose action dispatch (e.g. forms.submit_form's on_submit CreatePaymentLink arm dispatching create_payment_link). System subject bypasses permission policy evaluation; the call still routes through @fenel/core dispatch() so the action's Zod schema parse + handler fire normally. Returns the raw ActionResult."
@ioAction "dispatch.dispatch_action"
@requires "HasStateIO"
@tags "dispatch" "action" "io" "phase-12d"
dispatchAction : (actionName: String) -> (params: {  }) -> {  }
