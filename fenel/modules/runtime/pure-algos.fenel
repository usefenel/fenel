-- pure-algos — pure runtime helpers ported as Fenel bodies.
--
-- Phase 11a port. The runtime/src/ tree has had ZERO Fenel-body migrations
-- prior to this phase — every preceding port targets engine/src/. Phase
-- 11a establishes the runtime-side dispatched-wrapper precedent for
-- future runtime/src/ phases (11b codecs, 11c handler orchestration, …).
--
-- Currently surfaces ONE body: `triggerMatches` (the only pure-function
-- export from runtime/src/triggers.ts). The other 4 exports
-- (processEvent / startFunctionInstance / checkTimeouts /
-- checkAllTimeouts) are async DB orchestrators — they belong to a
-- later Phase 12 handler-orchestration arc, not the pure-algorithms
-- recipe.
--
-- Companion DEFERs landed in the same Phase 11a commit (documented in
-- audit.md):
--
--   interpolate.ts — DELETED (Path B). Pre-flight grep showed zero
--                    production callers across implementations/typescript
--                    + distros/narthex + fenel/. The 6 exports were
--                    dead code; deletion shrinks workstream TS surface
--                    by 174 LOC without porting effort.
--
--   parser.ts      — DEFER-PROVISIONAL. Path B-aligned in spirit (legacy
--                    YAML→Expression bridge for un-migrated DB rows;
--                    DB query confirms 0/411 active functions use the
--                    legacy on_start / steps / branches / program format
--                    so the evaluator.ts:1446 fallback is unreachable in
--                    production). Kept TS-side pending the workstream's
--                    decision on full deletion vs port. The validate-
--                    acceptance-test.ts script that consumes `extractFlows`
--                    is already broken — a separate cleanup.
--
-- Same recipe as Phase 10c sub-step 2: per-helper pre-classified ADT,
-- TS-side classifier, Fenel body dispatches on the variant.
--
-- All internal helpers are prefixed `pureAlgo…` to avoid colliding with
-- like-named helpers in other engine bodies.
--
-- typed-function-references Phase FM-retire-5 Step 5b (2026-06-06) — the
-- `FenelModule`-retirement port. This file gained the `module runtime where`
-- header + per-fn signatures + identity facets; it unions with codecs.fenel /
-- mime.fenel / triggers.fenel (all `module runtime where`) into the one
-- `runtime` module at the seam (loadFenelModuleUnion). The 23 `defineFunction`
-- specs in engine/src/modules/runtime.ts are RETIRED; this file is the source
-- of truth (ids stay `runtime:<fn>`).

module runtime where

-- ---------------------------------------------------------------------------
-- TmFilter — pre-classified per-filter check for triggerMatches.
--
-- The TS wrapper walks `Object.entries(trigger)` and for each filter key
-- (skipping "type" and "once_per_profile"):
--   * Array filter (entitlement: [a, b, c]) → TmfArray with the trigger's
--     allowed-values list + the payload's actual value
--   * Scalar filter (country: "US")        → TmfScalar with the
--     expected value + the payload's actual value
--
-- The body checks each filter via `elem` (array) or `eq` (scalar) and
-- ANDs across all entries via std:all.
-- ---------------------------------------------------------------------------

TmFilter =
  TmfArray payloadValue: a items: a
  | TmfScalar payloadValue: a expectedValue: a

-- ---------------------------------------------------------------------------
-- TmInput — pre-classified triggerMatches input.
--
-- The wrapper checks `trigger.type === eventType` TS-side; on mismatch
-- it emits TmiTypeMismatch (skipping the filter walk entirely). On
-- match it walks the filters + emits TmiCheck carrying the pre-
-- classified per-filter list.
-- ---------------------------------------------------------------------------

TmInput =
  TmiTypeMismatch
  | TmiCheck filters: a

-- ---------------------------------------------------------------------------
-- triggerMatches — check whether a trigger definition matches an event.
--
-- Mirrors the TS oracle at implementations/typescript/runtime/src/triggers.ts:122:
--   if (trigger.type !== eventType) return false;
--   for (const [key, value] of Object.entries(trigger)) {
--     if (key === "type" || key === "once_per_profile") continue;
--     if (Array.isArray(value)) {
--       const actual = eventPayload[key];
--       if (!value.includes(actual)) return false;
--     } else {
--       if (eventPayload[key] !== value) return false;
--     }
--   }
--   return true;
--
-- The wrapper pre-classifies into TmInput (TmiTypeMismatch / TmiCheck).
-- The body dispatches on the variant; on TmiCheck it walks the filter
-- list via std:all + per-filter predicate.
-- ---------------------------------------------------------------------------

triggerMatches : a -> Boolean
@label "triggers: triggerMatches"
@description "Phase 11a — check whether a FunctionTrigger definition matches an incoming event. The TS wrapper at `runtime/src/runtime-bodies-dispatch.ts` pre-classifies (trigger, eventType, eventPayload) into TmInput (TmiTypeMismatch when trigger.type !== eventType; TmiCheck carrying the per-filter pre-classified TmFilter list otherwise). The body dispatches on the variant + ANDs over filter results via std:all. Boundary adapter; dispatched via `dispatchedTriggerMatches`. Mirrors implementations/typescript/runtime/src/triggers.ts:triggerMatches."
@tags "runtime" "triggers" "boundary" "phase-11a"
triggerMatches input = case input of
  TmiTypeMismatch -> False
  TmiCheck { filters = fs } -> all fs pureAlgoCheckFilter

-- ---------------------------------------------------------------------------
-- pureAlgoCheckFilter — per-filter predicate.
--
-- TmfArray: payload value must be one of the trigger's allowed items.
-- TmfScalar: payload value must equal the trigger's expected scalar.
--
-- `elem` accepts `(needle, haystack)` where haystack can be a list (the
-- TmfArray.items case) — the std builtin handles the array-repr
-- traversal.
-- ---------------------------------------------------------------------------

pureAlgoCheckFilter : a -> Boolean
@label "triggers: pureAlgoCheckFilter"
@description "Phase 11a — per-filter predicate for triggerMatches. Dispatches on TmFilter (TmfArray: payload value ∈ items; TmfScalar: payload value = expected). Internal helper consumed by `runtime:triggerMatches` via std:all. Body-only fnId — not exposed as a dispatched wrapper."
@tags "runtime" "triggers" "internal" "phase-11a"
@category "runtime-internal"
pureAlgoCheckFilter f = case f of
  TmfArray { payloadValue = p, items = is } -> elem p is
  TmfScalar { payloadValue = p, expectedValue = e } -> eq p e
