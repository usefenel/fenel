-- ----- canonical preimage core --------------------------------------------

-- JSON-Logic predicates use the operator string as an object key. Fenel
-- record literals cannot put a runtime string in key position, so these two
-- envelope constructors are the irreducible host boundary. All SetExpr
-- classification and policy stays in the bodies below.
@native
@category "engine-internal"
@label "Aggregable comparison predicate envelope"
@description "Irreducible host envelope: build `{ [op]: [{ call: [aggFn, { var: \"value\" }] }, value] }` for a Fenel-decided preimage comparison. Contains no SetExpr classification or policy."
@tags "aggregable" "preimage" "json-logic" "boundary" "floor-kernel-phase-4"
preimagePredicateEnvelope : (aggFn: String, op: String, value: Any) -> Any

@native
@category "engine-internal"
@label "Aggregable boolean predicate envelope"
@description "Irreducible host envelope: build `{ [op]: predicates }` for a Fenel-decided n-ary JSON-Logic predicate. Contains no SetExpr classification or policy."
@tags "aggregable" "preimage" "json-logic" "boundary" "floor-kernel-phase-4"
preimageBooleanEnvelope : (op: String, predicates: List Any) -> Any

@category "engine-internal"
@label "Aggregable generic preimage"
@description "Canonical SetExpr classifier for Aggregable.preimageOf. Handles SeAll, SeNone and finite enums; authors canonical SeWhere/SeUnion results. Intervals abstain because scalar endpoints do not establish the aggregator's output carrier, and raw comparison predicates exclude admitted exact Nat/Int records. Every other constructor also returns Nothing."
@tags "aggregable" "preimage" "set-expr" "canonical" "floor-kernel-phase-4"
genericPreimageOf : (aggFn: String, outputSet: SetExpr) -> Maybe SetExpr
genericPreimageOf aggFn outputSet =
  case outputSet of
    SeAll -> Just (SeAll)
    SeNone -> Just (SeNone)
    SeEnum { values = values } -> genericPreimageEnum aggFn values
    SeInterval { interval = interval } -> genericPreimageInterval aggFn interval
    _ -> Nothing

@category "engine-internal"
@label "Aggregable enum preimage"
@description "Enum arm of genericPreimageOf: empty is SeNone, singleton is one equality SeWhere, and multiple values form a SeUnion of equality SeWhere branches. Internal helper."
@tags "aggregable" "preimage" "set-expr" "canonical" "floor-kernel-phase-4"
genericPreimageEnum : (aggFn: String, values: List Any) -> Maybe SetExpr
genericPreimageEnum aggFn values =
  let n = length values
  if eq n 0
  then Just (SeNone)
  else if eq n 1
       then case head values of
              Nothing -> Just (SeNone)
              Just value -> Just (genericPreimageComparison aggFn "==" value)
       else Just (SeUnion { branches = map (\value -> genericPreimageComparison aggFn "==" value) values })

@category "engine-internal"
@label "Aggregable interval preimage"
@description "Conservative interval preimage fence. Numeric interval membership admits exact Nat/Int records, but raw comparison predicates do not. Scalar endpoints alone cannot prove the aggregator produces only native Number/String values, so this generic helper returns Nothing until the predicate can preserve canonical interval membership."
@tags "aggregable" "preimage" "set-expr" "canonical" "floor-kernel-phase-4"
genericPreimageInterval : (aggFn: String, interval: Any) -> Maybe SetExpr
genericPreimageInterval aggFn interval = Nothing

@category "engine-internal"
@label "Aggregable interval-bound preimage"
@description "Turn one optional numeric interval bound into zero or one JSON-Logic comparison predicate. Lower uses >/>=; upper uses </<=. Internal helper."
@tags "aggregable" "preimage" "set-expr" "canonical" "floor-kernel-phase-4"
genericPreimageBound : (aggFn: String, isLower: Bool, maybeBound: Any) -> List Any
genericPreimageBound aggFn isLower maybeBound =
  case maybeBound of
    Nothing -> []
    Just bound ->
      if isNumber bound.value
      then appendItem (genericPreimageComparisonPredicate aggFn isLower bound.inclusive bound.value) []
      else []

@category "engine-internal"
@label "Aggregable bound comparison predicate"
@description "Choose the comparison operator for one lower/upper inclusive/strict interval bound and delegate only the dynamic-key envelope to the host. Internal helper."
@tags "aggregable" "preimage" "set-expr" "canonical" "floor-kernel-phase-4"
genericPreimageComparisonPredicate : (aggFn: String, isLower: Bool, inclusive: Bool, value: Any) -> Any
genericPreimageComparisonPredicate aggFn isLower inclusive value =
  if isLower
  then if inclusive
       then preimagePredicateEnvelope aggFn ">=" value
       else preimagePredicateEnvelope aggFn ">" value
  else if inclusive
       then preimagePredicateEnvelope aggFn "<=" value
       else preimagePredicateEnvelope aggFn "<" value

@category "engine-internal"
@label "Aggregable comparison SetExpr"
@description "Author one canonical SeWhere preimage comparison, delegating only the JSON-Logic operator-key envelope to the host. Internal helper."
@tags "aggregable" "preimage" "set-expr" "canonical" "floor-kernel-phase-4"
genericPreimageComparison : (aggFn: String, op: String, value: Any) -> SetExpr
genericPreimageComparison aggFn op value =
  SeWhere { pred = preimagePredicateEnvelope aggFn op value }

-- ----- the law harness -----------------------------------------------------

-- preimageRoundtripCheck — per-case checker for the `aggregable-preimage-
-- roundtrip` law. The law invokes it positionally (`{call: [..., {var:
-- "case"}]}` where `case` is the law's forall binding, NOT this param's name),
-- so the param name is cosmetic; the keyword `case` is avoided in the sig.
@native
@label "Preimage Roundtrip Check"
@description "Per-case ANTECEDENT probe for the `aggregable-preimage-roundtrip` law — read the name, because it does NOT check the law. Reads `{aggFn, outputSet, value}` from the sample case, confirms a closed-form preimage EXISTS (else `Nothing`, vacuous), and then returns whether `agg(value) ∈ outputSet` computed by an independent JS model. The law itself is the IMPLICATION `agg(v) ∈ outputSet ⇒ v ∈ preimage(outputSet)`; the CONSEQUENT is never tested, because testing it needs `contains` over the generated SeWhere, i.e. evaluating its predicate through a registry — the one thing this native was built to avoid. Corrected from a description that claimed `contains(preimage, value) = true` (signature-substrate slice 3c). Consequences to keep in mind: a `Just true` is evidence for the ANTECEDENT only, and a case whose antecedent fails reports `Just false` where the implication is VACUOUSLY TRUE. Do not read a green `aggregable-preimage-roundtrip` as evidence that any preimage contains anything."
@tags "aggregable" "law" "preimage" "check"
preimageRoundtripCheck : Any -> Maybe Boolean
