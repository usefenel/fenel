-- =========================================================================
-- module aggregable where — the Aggregable typeclass surface: per-aggregator
-- image / preimage SetExpr-lifting + the preimage-roundtrip law checker.
--
-- module-substrate Phase 3r (2026-05-31) — the DECLARATIVE HALF of the
-- aggregable migration. The ~98-LOC `defineFunction` spec wrapper in
-- `engine/src/modules/aggregable.ts` is RETIRED in favour of this
-- `module aggregable where` source (the original 15 public sigs + facets) + a thin seam
-- that loads it, merges the `instances.fenel` sidecar, and wires the natives.
--
-- floor-kernel Phase 4 (2026-07-11) converges the preimage path on the
-- canonical 14-constructor SetExpr ADT. `genericPreimageOf` and the seven
-- public `<agg>PreimageOf` entries are now Fenel bodies: the SetExpr case
-- analysis, enum cardinality policy, interval-bound policy, and canonical
-- SeWhere/SeUnion construction all live here. Only construction of JSON-Logic
-- objects whose operator is a runtime string remains in two native host
-- envelopes. Image approximations and the law harness are
-- separate deferred surfaces and remain native.
--
-- The header keeps the lowercase `aggregable:` id-prefix, preserving the
-- public image/preimage/law ids and the Aggregable instance method targets.
-- The `Aggregable` dispatch instances stay in their `instances.fenel` sidecar.
-- =========================================================================

module aggregable where

-- ----- length --------------------------------------------------------------

@label "length Preimage"
@description "Aggregable.preimageOf instance for `length`. Given an output `SetExpr` over the aggregator's output type, return the canonical `$where`-wrapped preimage `{v | length(v) ∈ outputSet}`, or `Nothing` when the output set has no closed-form preimage."
@tags "aggregable" "preimage" "length"
lengthPreimageOf : (outputSet: SetExpr) -> Maybe SetExpr
lengthPreimageOf outputSet = genericPreimageOf "length" outputSet

@native
@label "length Image"
@description "Aggregable.imageOf instance for `length`. Given an input `SetExpr`, return the aggregator's output image when expressible in closed form. Phase 9 ships a conservative implementation that returns the aggregator's declared outputType (e.g. `Nat` for length/count) — refining with input-set-aware tightening is a future Aggregable enhancement."
@tags "aggregable" "image" "length"
lengthImageOf : (inputSet: SetExpr) -> Maybe SetExpr

