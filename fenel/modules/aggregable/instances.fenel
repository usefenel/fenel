-- Aggregable typeclass instances — Fenel-authored typed values (Phase 3.2b of
-- typeclass-substrate-completion, 2026-05-29).
--
-- One `Aggregable <agg>` instance per std aggregator (length / count / sum /
-- avg / minimum / maximum / distinctCount). Each is a typed VALUE of
-- `Aggregable agg`; `loadFenelModule` projects it into the legacy
-- `SpecInstance { typeName = "Aggregable", args, methods, label }` cache shape
-- the set-algebra composition-shape recogniser reads (it looks up
-- `Aggregable [aggName]` to restore the structural reasoning the retired
-- `$preimage` SetExpr constructor enabled). See fenel/modules/codec/instances.fenel
-- for the module-path template + the label-lift note.
--
-- Phase 3.2b extended the loader to carry a method value that holds a TYPE:
--   - `inputType` / `outputType` — declared `FenelType` in Aggregable.
-- Authoring `inputType = List` parses `List` (uppercase, value position) to a
-- nullary constructor application `{construct:["List"]}`. The caller
-- (engine/src/modules/aggregable.ts) passes
-- `typeValuedFields: { Aggregable: ["inputType", "outputType"] }`, so the
-- loader lowers those fields to the TYPE reference `{$named:"List"}` (what the
-- legacy TS const held) rather than the runtime value `{$tag:"List"}`. The
-- disambiguation is declarative — `monotonicity` (also a nullary construct,
-- `Neither` / `Monotone`) is NOT in the type-valued set, so it lowers to the
-- variant value `{$tag:"Neither"}` exactly as before.
--
-- modules-as-values Phase 2b: `imageOf` / `preimageOf` are declared
-- `SetExpr -> Maybe SetExpr` and hold the functions themselves. A qualified
-- name such as `aggregable.lengthImageOf` loads as the reference
-- `{$ref: "aggregable.lengthImageOf"}`, resolved by whichever registry reads it.

aggregableLength : Aggregable "length"
aggregableLength = Aggregable {
  inputType = List,
  outputType = Nat,
  monotonicity = Neither,
  imageOf = aggregable.lengthImageOf,
  preimageOf = aggregable.lengthPreimageOf,
  label = "length Aggregable"
}

aggregableCount : Aggregable "count"
aggregableCount = Aggregable {
  inputType = List,
  outputType = Nat,
  monotonicity = Neither,
  imageOf = aggregable.countImageOf,
  preimageOf = aggregable.countPreimageOf,
  label = "count Aggregable"
}

aggregableSum : Aggregable "sum"
aggregableSum = Aggregable {
  inputType = List,
  outputType = Number,
  monotonicity = Monotone,
  imageOf = aggregable.sumImageOf,
  preimageOf = aggregable.sumPreimageOf,
  label = "sum Aggregable"
}

aggregableAvg : Aggregable "avg"
aggregableAvg = Aggregable {
  inputType = List,
  outputType = Number,
  monotonicity = Neither,
  imageOf = aggregable.avgImageOf,
  preimageOf = aggregable.avgPreimageOf,
  label = "avg Aggregable"
}

aggregableMinimum : Aggregable "minimum"
aggregableMinimum = Aggregable {
  inputType = List,
  outputType = Any,
  monotonicity = Neither,
  imageOf = aggregable.minimumImageOf,
  preimageOf = aggregable.minimumPreimageOf,
  label = "minimum Aggregable"
}

aggregableMaximum : Aggregable "maximum"
aggregableMaximum = Aggregable {
  inputType = List,
  outputType = Any,
  monotonicity = Neither,
  imageOf = aggregable.maximumImageOf,
  preimageOf = aggregable.maximumPreimageOf,
  label = "maximum Aggregable"
}

aggregableDistinctCount : Aggregable "distinctCount"
aggregableDistinctCount = Aggregable {
  inputType = List,
  outputType = Nat,
  monotonicity = Neither,
  imageOf = aggregable.distinctCountImageOf,
  preimageOf = aggregable.distinctCountPreimageOf,
  label = "distinctCount Aggregable"
}
