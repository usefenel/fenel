-- listTelegramCollectors — list registered bot collectors for the
-- current account, optionally filtered to bots matching a given token.
--
-- Used by the dashboard's "Instances" view on a runTelegramCollector
-- pin card (the dashboard calls with the card's botToken so it can
-- highlight that specific deployment). When called with no botToken,
-- returns every live collector.
--
-- "Live" means the bot row's data still has a `collectorConfig`
-- field — stopTelegramCollector clears it via the Maybe-Nothing
-- field-clear semantics on updateInstance.
--
-- module-substrate Phase 3o (2026-05-31) — migrated to `module telegram where`.
-- The defineFunction spec + LIST_COLLECTORS_BODY extraction RETIRED; identity
-- rides @facet directives. Def head renamed listTelegramCollectors →
-- listCollectors with @codeName preserving the public codeName. `requires`
-- INFERRED. Body UNCHANGED.

module telegram where

@label "List Telegram Collectors"
@description "List the registered Telegram bot collectors for the current account, optionally filtered to bots whose token matches `botToken`. Powers the dashboard's Instances panel on a runTelegramCollector pin card."
@tags "telegram" "collector" "io" "list"
@ioAction "telegram_collector.list"
@codeName "listTelegramCollectors"
listCollectors : (botToken: BotToken) -> List ({})
listCollectors botToken =
  let allBots = listInstancesByName "bot"
  let withCollector = filter (\b -> b.collectorConfig) allBots
  let matching = if botToken then filter (\b -> b.token == botToken) withCollector else withCollector
  map (\b -> { id = b.id, username = b.username, label = b.label, webhookUrl = b.webhookUrl, enabled = b.enabled, updatedAt = b.updatedAt }) matching
