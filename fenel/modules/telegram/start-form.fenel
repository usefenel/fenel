-- startTelegramForm — kick off a form-fill conversation for a registered
-- bot. Validates the bot, cancels any prior active conversation for the
-- same (bot, chat, user) triple, inserts a new conversation row,
-- optionally fires the start hook (or sends the static intro message),
-- and prompts for the first field.
--
-- Returns Result<String, String> — Err "error" on validation /
-- lookup failure, Ok convId on success. The empty-fields check
-- folds into the head pattern: an empty list returns Nothing, which
-- maps to Err.
--
-- `intro` is Maybe<String>. When the start hook is set it wins over
-- the static intro; both are skipped if neither is set.
--
-- `hooks` is a record { startFn: Maybe<String>, ... }. Only `startFn`
-- is consulted here — `completionFn` / `onFieldFn` / `instanceTypeName`
-- are persisted on the row and fire from the routing / finalize
-- bodies.
--
-- module-substrate Phase 3o (2026-05-31) — migrated to `module telegram where`.
-- The defineFunction spec + START_FORM_BODY extraction RETIRED; identity rides
-- @facet directives. Def name === codeName (no @codeName). `requires` INFERRED.
-- Body UNCHANGED.

module telegram where

@label "Start Telegram Form"
@description "Begin a form-fill conversation on a registered Telegram bot. Validates the bot, cancels any prior active conversation for the same (bot, chat, user), inserts a new conversation row, fires the start hook (or sends the static intro), and prompts for the first field. Returns Either<String, String>: Left on validation/setup failure, Right<conversationId> on success."
@tags "telegram" "collector" "io" "form"
@icon "message-square"
@emoji "📝"
@ioAction "telegram_form.start"
startTelegramForm : (botId: String) -> (chatId: Int) -> (userId: Int) -> (formId: String) -> (fields: List ({})) -> (intro: Maybe String) -> (completionPayload: {}) -> (hooks: {}) -> Result String String
startTelegramForm botId chatId userId formId fields intro completionPayload hooks =
  case head fields of
    Nothing -> Err "fields is empty"
    Just firstField ->
      let botMaybe = findBotById botId
      case botMaybe of
        Nothing -> Err `unknown or disabled bot: ${botId}`
        Just bot ->
          if not bot.enabled
          then Err `unknown or disabled bot: ${botId}`
          else
            let existing = findActiveConversation botId chatId userId
            case existing of
              Nothing -> 0
              Just oldConv -> markConversationCancelled oldConv.id
            -- insertConversation wraps tryCreateInstance and returns
            -- the legacy {ok, value, error} shape (NOT canonical
            -- Result — same convention as tryCreateInstanceByName).
            -- Check `.ok` and project to Result<String, String> for
            -- this function's declared return type.
            let r = insertConversation {
              botId = botId,
              chatId = chatId,
              userId = userId,
              formId = formId,
              fields = fields,
              partialValue = {},
              completionPayload = completionPayload,
              hooks = hooks
            }
            if not r.ok
            then Err r.error
            else
              let convId = r.value
              case hooks.startFn of
                Nothing ->
                  case intro of
                    Nothing -> 0
                    Just msg -> sendMessageText bot.token chatId msg
                Just fn ->
                  let welcomeMsg = callHookFunctionString fn { botId = botId, chatId = chatId, userId = userId }
                  case welcomeMsg of
                    Nothing -> 0
                    Just msg -> sendMessageText bot.token chatId msg
              sendFieldPrompt bot.token chatId firstField
              stampPromptSentAt convId
              Ok convId
