-- =========================================================================
-- Telegram-webhook orchestration body.
--
-- Phase 12c-routes sub-step 2 of the ts-elimination workstream. Decision
-- M1 — wrapper port. The route body (POST /webhooks/telegram/:botId) lives
-- here; the TS wrapper handles:
--   - JSON parse (irreducible IO)
--   - fromTelegramWire decode (codec — stays TS-side)
--   - bot lookup via state:findBotByIdGlobal + subscription lookup via
--     state:findSubscriptionBySlug (tg-bot-<botId>)
--   - secret-header constant-time verify via crypto:verifyTelegramSecret
--   - the actual telegram_collector.handle_update invoke (runtime-
--     determined action name + typed Update arg; no Fenel-side
--     dynamic-dispatch primitive today)
--
-- Body fires the umbrella `telegram.update` event so user-defined
-- triggers that bind on it keep working. Returns {ok = true} for the
-- Hono response.
--
-- This is a Disposition-B-with-A-body file: the body decoding has been
-- Fenel since 11c-2c (handleTelegramUpdate); this sub-step ports the
-- WRAPPER's event-emission step. The handle_update invocation itself
-- stays TS for the same runtime-dispatch reason as 12a-5's /io/invoke
-- and 12c-2's subscription-ingress.
--
-- module-substrate Phase 3p (2026-05-31) — the AGGREGATION-FRONTIER CLOSE
-- (Option C). This 1-fn webhook slice semantically belongs to `telegram`, so
-- the dissolve of the retired `mixed-ingress` bundle MERGES it into the already-
-- migrated `telegram` union (telegram.ts's `loadFenelModuleUnion`). This file
-- carries `module telegram where` and is added as one more union source — it
-- folds into `telegramModule` like any other telegram body file (no standalone
-- seam, no transient second module). The `telegram:telegramWebhookDispatch` id
-- is collision-free (poll.fenel CALLS it but only this file DEFINES it). No
-- stored @category (derives from the `telegram:` id prefix, Phase 3j);
-- HasStateIO is INFERRED from the emitEvent call.
-- =========================================================================

module telegram where

-- telegramWebhookDispatch — orchestration body. Fires the umbrella
-- telegram.update event for user-defined triggers. The wrapper
-- subsequently invokes telegram_collector.handle_update separately;
-- this body returns the wire-stable response shape.
@label "Telegram webhook dispatch"
@description "POST /webhooks/telegram/:botId body. The TS wrapper handles JSON parse + fromTelegramWire decode + bot/subscription lookup + secret-header verify + the subsequent handle_update invocation. Body fires the umbrella telegram.update event so user-defined triggers that bind on it keep working."
@tags "telegram" "webhook" "route" "phase-12c"
telegramWebhookDispatch : String -> {} -> {}
telegramWebhookDispatch botId update =
  let payload = { botId = botId, update = update }
  let _umbrella = emitEvent "telegram.update" payload Nothing
  { ok = true }
