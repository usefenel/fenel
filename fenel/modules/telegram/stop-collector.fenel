-- stopTelegramCollector — tear down a registered collector.
--
-- Looks up the bot by id, tells Telegram to stop sending updates,
-- cancels every in-flight conversation for that bot, clears the
-- collector binding + webhook URL + webhook secret from the bot row,
-- and removes the subscription. The bot row itself stays — re-running
-- runTelegramCollector with the same token redeploys; only the
-- collector binding + webhook are cleared.
--
-- Returns Maybe<String> — Just "error" on failure, Nothing on
-- success (Haskell convention for "operations that can fail",
-- avoiding the awkwardness of Either<E, Unit>).
--
-- Field-clearing in updateInstance: passing `Nothing` for a field
-- removes it from the row's data. The runtime's update_instance
-- handler treats `Nothing` as "this field should be absent" — the
-- natural Fenel mapping for "remove" since Maybe<T> already means
-- "present or absent".
--
-- module-substrate Phase 3o (2026-05-31) — migrated to `module telegram where`.
-- The defineFunction spec + STOP_COLLECTOR_BODY extraction RETIRED; identity rides
-- @facet directives. Def head renamed stopTelegramCollector → stopCollector with
-- @codeName preserving the public codeName. `requires` INFERRED. Body UNCHANGED.

module telegram where

@label "Stop Telegram Collector"
@description "Tear down a registered Telegram bot collector. Looks up the bot row by id, calls deleteWebhook on Telegram, clears collectorConfig / webhookUrl / webhookSecret, and cancels every in-flight conversation. The bot row stays (re-running runTelegramCollector with the same token redeploys); only the collector binding is removed."
@tags "telegram" "collector" "io" "lifecycle"
@icon "circle-stop"
@emoji "🛑"
@ioAction "telegram_collector.stop"
@codeName "stopTelegramCollector"
stopCollector : (botId: BotId) -> Maybe String
stopCollector botId =
  let botMaybe = findBotById botId
  case botMaybe of
    Nothing -> Just "No bot found for that id."
    Just bot ->
      let deleted = deleteWebhookByToken bot.token
      case deleted of
        Err err -> Just err
        Ok _ ->
          cancelAllConversations botId
          updateInstance botId { collectorConfig = Nothing, webhookUrl = Nothing, webhookSecret = Nothing }
          deleteSubscription `tg-bot-${botId}`
          Nothing
