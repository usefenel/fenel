-- =========================================================================
-- module telegram where — the bodyless Bot-API IO leaves.
--
-- module-substrate Phase 3o (2026-05-31). These 12 functions are irreducible
-- host-IO leaves: each is BODYLESS and dispatches to a runtime IO handler keyed
-- by its `@ioAction` (registered in runtime/handlers/telegram.ts — UNCHANGED by
-- this migration). They were hand-wrapped `defineFunction` specs in
-- engine/src/modules/telegram.ts; their declaration now rides `@native` (bodyless
-- foreign-decl, the Phase-3b convention) + `@ioAction` + `@requires` + @facet
-- directives here, joining the `telegram` UNION.
--
-- `@requires` (Phase 3o loader addition) carries the capability constraint a
-- bodyless leaf can't infer (no body): HasTelegramBot for the raw-token /
-- bot-row primitives, HasStateIO for the poll + notify leaves. The orchestrators
-- that CALL these (run-collector / handle-update / poll / …) infer their own
-- requires transitively from these declarations (attachInferredRequires).
--
-- Param types reference the registered named types BotToken / BotId / Url /
-- CollectorEntry (telegram.ts entities) instead of inlining the opaque/regex /
-- tagged-phantom / record shapes (which have no `.fenel` sig surface). Same
-- value, referenced by name — the registered-named-type convention.
-- =========================================================================

module telegram where

-- Bot-row + raw-token primitives (used by the routeTelegramMessage / collector
-- bodies). HasTelegramBot.

@label "Find bot by id"
@description "Look up the bots row by its UUID. Returns Nothing when not found. Used by the form-fill loop to grab the bot's token + enabled flag."
@tags "telegram" "io" "bot"
@ioAction "telegram.find_bot_by_id"
@requires "HasTelegramBot"
@native
findBotById : (botId: String) -> Maybe ({})

@label "Send Telegram text"
@description "Send a plain text message to a chat as the given bot. Thin wrapper around the Bot API sendMessage call."
@tags "telegram" "io" "send"
@ioAction "telegram.send_message_text"
@requires "HasTelegramBot"
@native
sendMessageText : (botToken: BotToken) -> (chatId: Int) -> (text: String) -> Unit

@label "Send field prompt"
@description "Send the prompt for a specific FieldDef — the Fenel renderer (promptForField) builds the text, the runtime sends it. Inline keyboards for enum/skip variants live in the underlying handler today; their Fenel port follows."
@tags "telegram" "io" "send"
@ioAction "telegram.send_field_prompt"
@requires "HasTelegramBot"
@native
sendFieldPrompt : (botToken: BotToken) -> (chatId: Int) -> (field: {}) -> Unit

@label "Send confirmation summary"
@description "Send the form-fill confirmation step UI: a `Please confirm your answers` message with each field's label + value rendered inline, plus a Confirm / Cancel inline keyboard. The user's reply on those buttons is dispatched to routeConfirmation (callback_data = `confirm:yes` / `confirm:cancel`)."
@tags "telegram" "io" "send" "form"
@ioAction "telegram.send_confirmation_summary"
@requires "HasTelegramBot"
@native
sendConfirmationSummary : (botToken: BotToken) -> (chatId: Int) -> (fields: List ({})) -> (values: {}) -> Unit

@label "Validate Telegram bot token"
@description "Calls Telegram's getMe with the given raw token to verify it. Returns a record `{ok: true, user: User}` on success, `{ok: false, error: String}` on failure. Does not persist anything — used by registration flows that need to validate the token before creating a bot row."
@tags "telegram" "io" "validate"
@ioAction "telegram.validate_bot_token"
@requires "HasTelegramBot"
@native
validateBotToken : (token: BotToken) -> Result String User

@label "Set Telegram webhook (raw token)"
@description "Calls Telegram's setWebhook using the raw bot token (no DB lookup). Used during bot registration before the bot row's id is referenceable through the typed capability handler."
@tags "telegram" "io" "webhook"
@ioAction "telegram.set_webhook_by_token"
@requires "HasTelegramBot"
@native
setWebhookByToken : (token: BotToken) -> (url: Url) -> (secret: Maybe String) -> Result String Boolean

@label "Start collector entry"
@description "Phase 11c sub-step 3 IO leaf — start a form-fill conversation for a single CollectorEntry. Resolves the entry's typeId to a typeName + field list (via the existing TS resolveTypeRef helper), then calls startTelegramForm (form-fill orchestration leaf — Conversation row insert + first-prompt send). Called from the stepConversation body's collector autostart / picker arms."
@tags "telegram" "io" "collector" "start"
@ioAction "telegram.start_collector_entry"
@requires "HasTelegramBot"
@native
startCollectorEntry : (botId: String) -> (chatId: Int) -> (userId: Int) -> (entry: CollectorEntry) -> Unit

@label "Send collector picker"
@description "Phase 11c sub-step 3 IO leaf — send the multi-entry collector picker as an inline_keyboard message ('What would you like to do?'). Takes the raw CollectorEntry list and constructs the inline_keyboard wire shape TS-side (each entry → row with the entry's label as button text + `collector:<idx>` as callback_data). Decision GG defer-provisional — full typed InlineKeyboardMarkup construction in the body is queued for 11c-4."
@tags "telegram" "io" "collector" "send"
@ioAction "telegram.send_collector_picker"
@requires "HasTelegramBot"
@native
sendCollectorPicker : (botToken: BotToken) -> (chatId: Int) -> (entries: List CollectorEntry) -> Unit

@label "Acknowledge callback query"
@description "Acknowledge an inbound Telegram callback_query (no-text ack) so the user's button stops showing the loading spinner. Phase 11c sub-step 3 — takes botId + callbackQueryId as direct args (the pre-3 payload-record form is still accepted by the IO handler for any in-flight callers)."
@tags "telegram" "io" "callback"
@ioAction "telegram.ack_callback_query"
@requires "HasTelegramBot"
@native
ackCallbackQuery : (botId: String) -> (callbackQueryId: String) -> Unit

@label "Delete Telegram webhook (raw token)"
@description "Calls Telegram's deleteWebhook with the raw bot token. Returns Ok Unit after confirmed deletion, or Err String on provider or transport failure so callers can retain the deployment and retry."
@tags "telegram" "io" "webhook"
@ioAction "telegram.delete_webhook_by_token"
@requires "HasTelegramBot"
@native
deleteWebhookByToken : (token: BotToken) -> Result String Unit

-- Poll + notify leaves. HasStateIO.

@label "Get Updates (Polling)"
@description "Phase 13c sub-step 1 — long-poll wrapper around the TelegramWebhooks.getUpdates capability method. Same signature; reuses the auto-registered handler at ioAction TelegramWebhooks.getUpdates. Returns a list of raw camel-shaped Update JSON values (post-fromTelegramWire); callers pass each through handleTelegramUpdate which wraps + decodes internally."
@tags "telegram" "io" "poll" "phase-13c"
@ioAction "TelegramWebhooks.getUpdates"
@requires "HasStateIO"
@native
getUpdatesPoll : (botId: BotId) -> (offset: Maybe Int) -> (limit: Maybe Int) -> (timeout: Maybe Int) -> (allowedUpdates: List String) -> List Update

@label "Send Telegram notification"
@description "Phase 13c sub-step 1 — outbound notification IO leaf. The TS handler parses target (tg_group:N / tg_user:N / numeric / @handle / raw), builds an InlineKeyboardMarkup from the NotificationButton list (webapp: prefix becomes a Url button; otherwise callback_data carries JSON-encoded {action, params}), and sends via TelegramMessages.sendMessage with HTML parse mode. Used by the bot's NotifyTransport adapter so notify / tg_dm actions deliver via the Fenel substrate rather than a grammy singleton."
@tags "telegram" "io" "notify" "phase-13c"
@ioAction "telegram.send_notification"
@requires "HasStateIO"
@native
sendNotification : (botId: BotId) -> (target: String) -> (message: String) -> (buttons: List ({})) -> Unit
