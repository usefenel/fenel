-- =========================================================================
-- module telegram where — pure string/URL formatting leaves.
--
-- module-substrate Phase 3o Wave D (2026-05-31). escapeMarkdownV2 + deepLink
-- were the last two TS `@native` rides in telegram (`telegramNatives` in
-- engine/src/modules/telegram.ts). Both are PURE string ops — the Fenel-first
-- HARD rule says they belong in `.fenel`, not TS. This file ports both:
--
--   - escapeMarkdownV2 composes std:replaceAll (the exact precedent set by
--     std:escapeHtml) — no regex, no host primitive. Fully Fenel-bodied.
--   - deepLink composes std string fns + the std:urlEncode substrate leaf.
--     deepLink's ORCHESTRATION (strip leading @, branch on kind, concat the
--     t.me URL) is pure Fenel; the ONLY irreducible host primitive is the
--     payload's percent-encoding (encodeURIComponent — UTF-8 byte-level
--     encoding has no pure-Fenel form). That single leaf rides as `std:urlEncode`
--     — the expected substrate bridge (cf. abs / round / regexSet), NOT a
--     whole-function TS reimplementation.
--
-- Both join the `telegram` UNION. `telegramNatives` / escapeMarkdownV2Native /
-- deepLinkNative / the `_nativeDefined` array are all RETIRED; telegramModule's
-- `nativeImpls` collapses to `{}`.
-- =========================================================================

module telegram where

-- ---------------------------------------------------------------------------
-- escapeMarkdownV2 — backslash-escape the 18 reserved MarkdownV2 chars
-- (_ * [ ] ( ) ~ ` > # + - = | { } . !) plus backslash itself. A chained
-- replaceAll fold, backslash FIRST (so the backslashes the later passes
-- prepend aren't themselves re-escaped). This reproduces the single-pass
-- regex `[_*[]()~`>#+\-=|{}.!\\]` → `\$&` the retired TS native used:
-- each reserved char gets exactly one leading backslash.
-- ---------------------------------------------------------------------------

@label "Escape MarkdownV2"
@description "Escape a string for safe inclusion in a Telegram MarkdownV2 message. Backslash-escapes the 18 reserved characters per Bot API docs."
@tags "telegram" "format" "pure"
escapeMarkdownV2 : (s: String) -> String
escapeMarkdownV2 s =
  let s1 = replaceAll s "\\" "\\\\"
  let s2 = replaceAll s1 "_" "\\_"
  let s3 = replaceAll s2 "*" "\\*"
  let s4 = replaceAll s3 "[" "\\["
  let s5 = replaceAll s4 "]" "\\]"
  let s6 = replaceAll s5 "(" "\\("
  let s7 = replaceAll s6 ")" "\\)"
  let s8 = replaceAll s7 "~" "\\~"
  let s9 = replaceAll s8 "`" "\\`"
  let s10 = replaceAll s9 ">" "\\>"
  let s11 = replaceAll s10 "#" "\\#"
  let s12 = replaceAll s11 "+" "\\+"
  let s13 = replaceAll s12 "-" "\\-"
  let s14 = replaceAll s13 "=" "\\="
  let s15 = replaceAll s14 "|" "\\|"
  let s16 = replaceAll s15 "{" "\\{"
  let s17 = replaceAll s16 "}" "\\}"
  let s18 = replaceAll s17 "." "\\."
  replaceAll s18 "!" "\\!"

-- ---------------------------------------------------------------------------
-- deepLink — build a t.me deep-link to a user/bot. Strips a leading `@` from
-- the handle, then branches on kind:
--   "bot_start" + non-empty payload → https://t.me/<h>?start=<urlEncode payload>
--   anything else                   → https://t.me/<h>
-- The payload is percent-encoded via std:urlEncode (the irreducible host
-- leaf). `kind` is the registered refined-enum TgLinkKind ("user" | "bot_start").
-- ---------------------------------------------------------------------------

@label "Deep link"
@description "Build a t.me deep-link to a user/bot. kind=user produces https://t.me/<handle>; kind=bot_start produces https://t.me/<handle>?start=<payload>."
@tags "telegram" "url" "pure"
deepLink : (handle: Handle) -> (kind: TgLinkKind) -> (payload: String) -> Url
deepLink handle kind payload =
  let h = if startsWith handle "@" then slice handle 1 (length handle) else handle
  if kind == "bot_start" and length payload > 0
  then `https://t.me/${h}?start=${urlEncode payload}`
  else `https://t.me/${h}`
