-- routeConfirmation — handle a user reply during the confirmation
-- step of a form-fill conversation.
--
-- Returns Boolean — true if a confirming conversation matched and
-- the message was handled; false when no conversation matched (the
-- caller falls through to the active form-fill router).
--
-- Behaviour:
--   - "yes" / "confirm" / "ok"  → finalize the conversation
--   - "cancel" / "no"           → cancel the conversation
--   - "/back" / "back"          → flip back to active and re-prompt
--                                  the last field (so the user can
--                                  fix an answer)
--   - anything else             → tell the user to confirm/cancel/back
--
-- module-substrate Phase 3o (2026-05-31) — migrated to `module telegram where`.
-- The defineFunction spec + ROUTE_CONFIRMATION_BODY extraction RETIRED; identity
-- rides @facet directives. Def name === codeName (no @codeName). `requires`
-- INFERRED. Body UNCHANGED.

module telegram where

@label "Route Telegram confirmation reply"
@description "Handle a user reply during the confirmation step of a form-fill conversation. yes/confirm/ok → finalizeConversation; cancel/no → cancel + acknowledge; /back → flip to active and re-prompt the last field; anything else → re-ask the question. Returns false when no confirming conversation matched (caller routes to the active form-fill loop instead)."
@tags "telegram" "collector" "io" "form" "routing"
@ioAction "telegram_form.route_confirmation"
routeConfirmation : (botId: String) -> (chatId: Int) -> (userId: Int) -> (text: String) -> Boolean
routeConfirmation botId chatId userId text =
  let convMaybe = findConfirmingConversation botId chatId userId
  case convMaybe of
    Nothing -> false
    Just conv ->
      let botMaybe = findBotById botId
      case botMaybe of
        Nothing -> false
        Just bot ->
          if not bot.enabled
          then false
          else
            let answer = lower (trim text)
            if answer == "cancel" or answer == "no"
            then
              markConversationCancelled conv.id
              sendMessageText bot.token chatId "Cancelled. Send /start to begin again."
              true
            else if answer == "yes" or answer == "confirm" or answer == "ok"
            then
              finalizeConversation conv bot chatId userId
              true
            else if answer == "/back" or answer == "back"
            then
              case last conv.fields of
                Nothing -> true
                Just lastField ->
                  let lastIdx = (length conv.fields) - 1
                  updateConversationProgress conv.id conv.partialValue lastIdx
                  markConversationActive conv.id
                  sendFieldPrompt bot.token chatId lastField
                  stampPromptSentAt conv.id
                  true
            else
              sendMessageText bot.token chatId "Please confirm, cancel, or send /back to fix an answer."
              true
