  | PassportErrorTranslationFile type: String fileHash: String message: String
  | PassportErrorTranslationFiles type: String fileHashes: [String] message: String
  | PassportErrorUnspecified type: String elementHash: String message: String

PollOption = PollOption text: String voterCount: Int textEntities: [MessageEntity] persistentId: Maybe<Int>

