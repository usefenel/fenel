StoryArea = StoryArea position: StoryAreaPosition type: StoryAreaType

Story = Story chat: Chat id: Int

ReactionCount = ReactionCount type: ReactionType totalCount: Int

CollectorAction = Continue | SendAndContinue message: String | SkipTo fieldName: String | Abort

FieldParseResult = Parsed value: String | ParseFailed error: String

ResolveTypeRefDecision = TypeNotFound typeId: String | NotRecordType typeName: String | ResolvedFields typeName: String

CollectorContext = CollectorContext botId: String chatId: Int userId: Int user: Maybe<User> startedAt: Int
