PollAnswer = PollAnswer pollId: String voterChat: Maybe<Chat> user: Maybe<User> optionIds: [Int]

Poll = Poll id: String question: String options: [PollOption] totalVoterCount: Int isClosed: Boolean isAnonymous: Boolean type: String allowsMultipleAnswers: Boolean correctOptionIds: [Int] explanation: Maybe<String> openPeriod: Maybe<Int> closeDate: Maybe<Int>

Dice = Dice emoji: String value: Int

