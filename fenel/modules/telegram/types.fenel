Checklist = Checklist title: String titleEntities: [MessageEntity] tasks: [ChecklistTask] othersCanAddTasks: Maybe<Boolean> othersCanMarkTasksAsDone: Maybe<Boolean>

InputChecklist = InputChecklist title: String parseMode: Maybe<ParseMode> titleEntities: [MessageEntity] tasks: [InputChecklistTask] othersCanAddTasks: Maybe<Boolean> othersCanMarkTasksAsDone: Maybe<Boolean>

