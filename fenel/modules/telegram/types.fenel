-- =========================================================================
-- Telegram Bot API types — typed mirror of the Telegram Bot API surface
-- (https://core.telegram.org/bots/api). Covers User / Chat / Message /
-- Update / Media / Inline / Sticker / Payment / Stars / Passport / Poll /
-- Game / Story / Forum / Business. Plus three orchestration-tier
-- synthetics (CollectorAction / FieldParseResult / CollectorContext)
-- used by the bot's collector dispatch loop.
--
-- Records (single constructor, all named fields) may be compact or use
-- indented field continuations. Variants use leading `|` for multiline peers.
--
-- Phase 4f of the ts-elimination workstream — see
-- workstreams/ts-elimination/briefs/phase-4f-telegram-wholesale.md.
-- Verbatim extract from the prior inline `TELEGRAM_SRC` template literal
-- at engine/src/modules/telegram.ts:69-416. No semantic change.
-- =========================================================================

ChatRef = ById id: Int | ByUsername username: String

ParseMode = MarkdownV2 | HTML | LegacyMarkdown

ChatType = Private | Group | Supergroup | Channel

MessageEntityType = Mention
  | Hashtag
  | Cashtag
  | BotCommand
  | UrlEntity
  | EmailEntity
  | PhoneNumber
  | Bold
  | Italic
  | Underline
  | Strikethrough
  | Spoiler
  | Code
  | Pre
  | TextLink
  | TextMention
  | CustomEmoji
  | Blockquote
  | ExpandableBlockquote

User = User id: Int isBot: Boolean firstName: String lastName: Maybe<String> username: Maybe<String> languageCode: Maybe<String> isPremium: Maybe<Boolean> canJoinGroups: Maybe<Boolean> canManageBots: Maybe<Boolean>

Chat = Chat id: ChatRef type: ChatType title: Maybe<String> username: Maybe<String> firstName: Maybe<String> lastName: Maybe<String> isForum: Maybe<Boolean>

MessageEntity = MessageEntity type: MessageEntityType offset: Int length: Int url: Maybe<String> user: Maybe<User> language: Maybe<String> customEmojiId: Maybe<String>

LinkPreviewOptions = LinkPreviewOptions isDisabled: Maybe<Boolean> url: Maybe<String> preferSmallMedia: Maybe<Boolean> preferLargeMedia: Maybe<Boolean> showAboveText: Maybe<Boolean>

ReplyParameters = ReplyParameters messageId: Int chatId: Maybe<ChatRef> allowSendingWithoutReply: Maybe<Boolean> quote: Maybe<String> quoteParseMode: Maybe<ParseMode> quotePosition: Maybe<Int>

InlineKeyboardButton = InlineKeyboardButton text: String url: Maybe<String> callbackData: Maybe<String> webAppUrl: Maybe<String> switchInlineQuery: Maybe<String> switchInlineQueryCurrentChat: Maybe<String> copyText: Maybe<String> pay: Maybe<Boolean>

InlineKeyboardMarkup = InlineKeyboardMarkup inlineKeyboard: [[InlineKeyboardButton]]

KeyboardButton = KeyboardButton text: String requestContact: Maybe<Boolean> requestLocation: Maybe<Boolean>

ReplyKeyboardMarkup = ReplyKeyboardMarkup keyboard: [[KeyboardButton]] isPersistent: Maybe<Boolean> resizeKeyboard: Maybe<Boolean> oneTimeKeyboard: Maybe<Boolean> inputFieldPlaceholder: Maybe<String> selective: Maybe<Boolean>

ReplyKeyboardRemove = ReplyKeyboardRemove removeKeyboard: Boolean selective: Maybe<Boolean>

ForceReply = ForceReply forceReply: Boolean inputFieldPlaceholder: Maybe<String> selective: Maybe<Boolean>

ReplyMarkup = Inline keyboard: InlineKeyboardMarkup
  | Reply keyboard: ReplyKeyboardMarkup
  | Remove keyboard: ReplyKeyboardRemove
  | Force keyboard: ForceReply

Message = Message id: Int from: Maybe<User> senderChat: Maybe<Chat> chat: Chat date: Int messageThreadId: Maybe<Int> text: Maybe<String> entities: [MessageEntity] caption: Maybe<String> captionEntities: [MessageEntity] hasProtectedContent: Maybe<Boolean> isTopicMessage: Maybe<Boolean> editDate: Maybe<Int> replyToMessage: Maybe<Message> linkPreviewOptions: Maybe<LinkPreviewOptions>

CallbackQuery = CallbackQuery id: String from: User chatInstance: String message: Maybe<Message> inlineMessageId: Maybe<String> data: Maybe<String> gameShortName: Maybe<String>

WebhookInfo = WebhookInfo url: String hasCustomCertificate: Boolean pendingUpdateCount: Int ipAddress: Maybe<String> lastErrorDate: Maybe<Int> lastErrorMessage: Maybe<String> maxConnections: Maybe<Int> allowedUpdates: [String]

InputFile = ByPath path: String | ByUrl url: String | ByFileId fileId: String

EditResult = Edited message: Message | InlineEdited success: Boolean

Update = MessageUpdate updateId: Int message: Message
  | EditedMessageUpdate updateId: Int message: Message
  | ChannelPostUpdate updateId: Int message: Message
  | EditedChannelPostUpdate updateId: Int message: Message
  | BusinessConnectionUpdate updateId: Int connectionId: String
  | BusinessMessageUpdate updateId: Int message: Message
  | EditedBusinessMessageUpdate updateId: Int message: Message
  | DeletedBusinessMessagesUpdate updateId: Int chatId: ChatRef messageIds: [Int]
  | MessageReactionUpdate updateId: Int chatId: ChatRef messageId: Int
  | MessageReactionCountUpdate updateId: Int chatId: ChatRef messageId: Int
  | InlineQueryUpdate updateId: Int queryId: String fromUserId: Int query: String
  | ChosenInlineResultUpdate updateId: Int resultId: String fromUserId: Int query: String
  | CallbackQueryUpdate updateId: Int callbackQuery: CallbackQuery
  | ShippingQueryUpdate updateId: Int queryId: String fromUserId: Int
  | PreCheckoutQueryUpdate updateId: Int queryId: String fromUserId: Int
  | PurchasedPaidMediaUpdate updateId: Int fromUserId: Int payload: String
  | PollUpdate updateId: Int pollId: String
  | PollAnswerUpdate updateId: Int pollId: String fromUserId: Maybe<Int>
  | MyChatMemberUpdate updateId: Int chatId: ChatRef
  | ChatMemberStatusUpdate updateId: Int chatId: ChatRef
  | ChatJoinRequestUpdate updateId: Int chatId: ChatRef fromUserId: Int
  | ChatBoostUpdate updateId: Int chatId: ChatRef
  | RemovedChatBoostUpdate updateId: Int chatId: ChatRef
  | ManagedBotUpdate updateId: Int botId: Int
  | UnknownUpdate updateId: Int kind: String

PhotoSize = PhotoSize fileId: String fileUniqueId: String width: Int height: Int fileSize: Maybe<Int>

Animation = Animation fileId: String fileUniqueId: String width: Int height: Int duration: Int thumbnail: Maybe<PhotoSize> fileName: Maybe<String> mimeType: Maybe<String> fileSize: Maybe<Int>

Audio = Audio fileId: String fileUniqueId: String duration: Int performer: Maybe<String> title: Maybe<String> fileName: Maybe<String> mimeType: Maybe<String> fileSize: Maybe<Int> thumbnail: Maybe<PhotoSize>

Document = Document fileId: String fileUniqueId: String thumbnail: Maybe<PhotoSize> fileName: Maybe<String> mimeType: Maybe<String> fileSize: Maybe<Int>

Video = Video fileId: String fileUniqueId: String width: Int height: Int duration: Int thumbnail: Maybe<PhotoSize> fileName: Maybe<String> mimeType: Maybe<String> fileSize: Maybe<Int>

VideoNote = VideoNote fileId: String fileUniqueId: String length: Int duration: Int thumbnail: Maybe<PhotoSize> fileSize: Maybe<Int>

Voice = Voice fileId: String fileUniqueId: String duration: Int mimeType: Maybe<String> fileSize: Maybe<Int>

Contact = Contact phoneNumber: String firstName: String lastName: Maybe<String> userId: Maybe<Int> vcard: Maybe<String>

Location = Location latitude: Number longitude: Number horizontalAccuracy: Maybe<Number> livePeriod: Maybe<Int> heading: Maybe<Int> proximityAlertRadius: Maybe<Int>

Venue = Venue location: Location title: String address: String foursquareId: Maybe<String> foursquareType: Maybe<String> googlePlaceId: Maybe<String> googlePlaceType: Maybe<String>

File = File fileId: String fileUniqueId: String fileSize: Maybe<Int> filePath: Maybe<String>

ChatPhoto = ChatPhoto smallFileId: String smallFileUniqueId: String bigFileId: String bigFileUniqueId: String

ChatInviteLink = ChatInviteLink inviteLink: String creator: User createsJoinRequest: Boolean isPermanent: Boolean isRevoked: Boolean expireDate: Maybe<Int> memberLimit: Maybe<Int> name: Maybe<String> pendingJoinRequestCount: Maybe<Int>

ChatPermissions = ChatPermissions canSendMessages: Maybe<Boolean> canSendAudios: Maybe<Boolean> canSendDocuments: Maybe<Boolean> canSendPhotos: Maybe<Boolean> canSendVideos: Maybe<Boolean> canSendVideoNotes: Maybe<Boolean> canSendVoiceNotes: Maybe<Boolean> canSendPolls: Maybe<Boolean> canSendOtherMessages: Maybe<Boolean> canAddWebPagePreviews: Maybe<Boolean> canChangeInfo: Maybe<Boolean> canInviteUsers: Maybe<Boolean> canPinMessages: Maybe<Boolean> canManageTopics: Maybe<Boolean>

ChatAdministratorRights = ChatAdministratorRights isAnonymous: Boolean canManageChat: Boolean canDeleteMessages: Boolean canManageVideoChats: Boolean canRestrictMembers: Boolean canPromoteMembers: Boolean canChangeInfo: Boolean canInviteUsers: Boolean canPostStories: Boolean canEditStories: Boolean canDeleteStories: Boolean canPostMessages: Maybe<Boolean> canEditMessages: Maybe<Boolean> canPinMessages: Maybe<Boolean> canManageTopics: Maybe<Boolean>

ChatMember = MemberCreator user: User isAnonymous: Boolean customTitle: Maybe<String>
  | MemberAdministrator user: User canBeEdited: Boolean rights: ChatAdministratorRights customTitle: Maybe<String>
  | MemberRegular user: User untilDate: Maybe<Int>
  | MemberRestricted user: User isMember: Boolean permissions: ChatPermissions untilDate: Int
  | MemberLeft user: User
  | MemberBanned user: User untilDate: Int

ChatJoinRequest = ChatJoinRequest chat: Chat from: User userChatId: Maybe<Int> date: Int bio: Maybe<String> inviteLink: Maybe<ChatInviteLink>

ChatMemberUpdated = ChatMemberUpdated chat: Chat from: User date: Int oldChatMember: ChatMember newChatMember: ChatMember inviteLink: Maybe<ChatInviteLink> viaJoinRequest: Maybe<Boolean> viaChatFolderInviteLink: Maybe<Boolean>

BotCommand = BotCommand command: String description: String

BotCommandScope = ScopeDefault
  | ScopeAllPrivateChats
  | ScopeAllGroupChats
  | ScopeAllChatAdministrators
  | ScopeChat chatId: ChatRef
  | ScopeChatAdministrators chatId: ChatRef
  | ScopeChatMember chatId: ChatRef userId: Int

BotName = BotName name: String

BotDescription = BotDescription description: String

BotShortDescription = BotShortDescription shortDescription: String

MenuButton = MenuButtonCommands
  | MenuButtonWebApp text: String webAppUrl: String
  | MenuButtonDefault

UserProfilePhotos = UserProfilePhotos totalCount: Int photos: [[PhotoSize]]

ChatFullInfo = ChatFullInfo id: ChatRef type: ChatType title: Maybe<String> username: Maybe<String> firstName: Maybe<String> lastName: Maybe<String> isForum: Maybe<Boolean> photo: Maybe<ChatPhoto> activeUsernames: [String] description: Maybe<String> inviteLink: Maybe<String> pinnedMessage: Maybe<Message> permissions: Maybe<ChatPermissions> stickerSetName: Maybe<String> linkedChatId: Maybe<Int> location: Maybe<Location>

ReactionType = ReactionEmoji emoji: String | ReactionCustomEmoji customEmojiId: String

MessageReactionUpdated = MessageReactionUpdated chat: Chat messageId: Int user: Maybe<User> actorChat: Maybe<Chat> date: Int oldReaction: [ReactionType] newReaction: [ReactionType]

InputMediaPhoto = InputMediaPhoto media: InputFile caption: Maybe<String> parseMode: Maybe<ParseMode> captionEntities: [MessageEntity] hasSpoiler: Maybe<Boolean> showCaptionAboveMedia: Maybe<Boolean>

InputMediaVideo = InputMediaVideo media: InputFile thumbnail: Maybe<InputFile> caption: Maybe<String> parseMode: Maybe<ParseMode> captionEntities: [MessageEntity] width: Maybe<Int> height: Maybe<Int> duration: Maybe<Int> supportsStreaming: Maybe<Boolean> hasSpoiler: Maybe<Boolean> showCaptionAboveMedia: Maybe<Boolean>

InputMediaAnimation = InputMediaAnimation media: InputFile thumbnail: Maybe<InputFile> caption: Maybe<String> parseMode: Maybe<ParseMode> captionEntities: [MessageEntity] width: Maybe<Int> height: Maybe<Int> duration: Maybe<Int> hasSpoiler: Maybe<Boolean>

InputMediaAudio = InputMediaAudio media: InputFile thumbnail: Maybe<InputFile> caption: Maybe<String> parseMode: Maybe<ParseMode> captionEntities: [MessageEntity] duration: Maybe<Int> performer: Maybe<String> title: Maybe<String>

InputMediaDocument = InputMediaDocument media: InputFile thumbnail: Maybe<InputFile> caption: Maybe<String> parseMode: Maybe<ParseMode> captionEntities: [MessageEntity] disableContentTypeDetection: Maybe<Boolean>

InputMedia = MediaPhoto photo: InputMediaPhoto
  | MediaVideo video: InputMediaVideo
  | MediaAnimation animation: InputMediaAnimation
  | MediaAudio audio: InputMediaAudio
  | MediaDocument document: InputMediaDocument

ChatAction = Typing | UploadPhoto | RecordVideo | UploadVideo | RecordVoice | UploadVoice | UploadDocument | ChooseSticker | FindLocation | RecordVideoNote | UploadVideoNote

LabeledPrice = LabeledPrice label: String amount: Int

Invoice = Invoice title: String description: String startParameter: String currency: String totalAmount: Int

ShippingAddress = ShippingAddress countryCode: String state: String city: String streetLine1: String streetLine2: String postCode: String

OrderInfo = OrderInfo name: Maybe<String> phoneNumber: Maybe<String> email: Maybe<String> shippingAddress: Maybe<ShippingAddress>

ShippingOption = ShippingOption id: String title: String prices: [LabeledPrice]

SuccessfulPayment = SuccessfulPayment currency: String totalAmount: Int invoicePayload: String shippingOptionId: Maybe<String> orderInfo: Maybe<OrderInfo> telegramPaymentChargeId: String providerPaymentChargeId: String

RefundedPayment = RefundedPayment currency: String totalAmount: Int invoicePayload: String telegramPaymentChargeId: String providerPaymentChargeId: Maybe<String>

ShippingQueryData = ShippingQueryData id: String from: User invoicePayload: String shippingAddress: ShippingAddress

PreCheckoutQueryData = PreCheckoutQueryData id: String from: User currency: String totalAmount: Int invoicePayload: String shippingOptionId: Maybe<String> orderInfo: Maybe<OrderInfo>

StarAmount = StarAmount amount: Int nanostarAmount: Maybe<Int>

RevenueWithdrawalState = WithdrawalPending | WithdrawalSucceeded date: Int url: String | WithdrawalFailed

TransactionPartner = PartnerUser userId: Int
  | PartnerChatBoost chatId: ChatRef userId: Int
  | PartnerAffiliateProgram sponsorBotId: Int commissionPerMille: Int
  | PartnerFragment withdrawalState: Maybe<RevenueWithdrawalState>
  | PartnerTelegramAds
  | PartnerTelegramApi requestCount: Int
  | PartnerOther

StarTransaction = StarTransaction id: String amount: Int nanostarAmount: Maybe<Int> date: Int source: Maybe<TransactionPartner> receiver: Maybe<TransactionPartner>

StarTransactions = StarTransactions transactions: [StarTransaction]

InlineQuery = InlineQuery id: String from: User query: String offset: String chatType: Maybe<String> location: Maybe<Location>

InputMessageContentText = InputMessageContentText messageText: String parseMode: Maybe<ParseMode> entities: [MessageEntity] linkPreviewOptions: Maybe<LinkPreviewOptions>

InputMessageContentLocation = InputMessageContentLocation latitude: Number longitude: Number horizontalAccuracy: Maybe<Number> livePeriod: Maybe<Int> heading: Maybe<Int> proximityAlertRadius: Maybe<Int>

InputMessageContentVenue = InputMessageContentVenue latitude: Number longitude: Number title: String address: String foursquareId: Maybe<String> googlePlaceId: Maybe<String>

InputMessageContentContact = InputMessageContentContact phoneNumber: String firstName: String lastName: Maybe<String> vcard: Maybe<String>

InputMessageContentInvoice = InputMessageContentInvoice title: String description: String payload: String providerToken: Maybe<String> currency: String prices: [LabeledPrice]

InputMessageContent = ContentText text: InputMessageContentText
  | ContentLocation location: InputMessageContentLocation
  | ContentVenue venue: InputMessageContentVenue
  | ContentContact contact: InputMessageContentContact
  | ContentInvoice invoice: InputMessageContentInvoice

