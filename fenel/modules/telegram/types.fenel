  | ResultAudio id: String audioUrl: String title: String performer: Maybe<String> audioDuration: Maybe<Int> caption: Maybe<String>
  | ResultVoice id: String voiceUrl: String title: String voiceDuration: Maybe<Int> caption: Maybe<String>
