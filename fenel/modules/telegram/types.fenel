StickerSet = StickerSet name: String title: String stickerType: String stickers: [Sticker] thumbnail: Maybe<PhotoSize>

InputSticker = InputSticker sticker: InputFile format: String emojiList: [String] maskPosition: Maybe<MaskPosition> keywords: [String]

