-- =========================================================================
-- Telegram — ALL 16 CAPABILITIES, authored as Fenel record-of-methods types
-- (module-substrate Phase 3o.2 opened the tier with `TelegramWebhooks`; Phase
-- 3o.3 closed it — the remaining 15 capabilities transcribed off their TS
-- `ClassMethod[]` rosters + the `telegramCapabilities` object-literal, retiring
-- ~1400 LOC of TS + the `withBotIdParam` / `botCapabilityInstance` helpers).
--
-- A capability is a record whose fields are its methods (each an arrow type) —
-- the same shape `fenel/std/algebra.fenel` declares Functor/Monad/Monoid and
-- `email`/`ai` declare their providers. The telegram seam reads each type and
-- `seedFromType`s it into the dispatch `ClassSeed` (replacing the retired
-- hand-written `telegramCapabilities[…]` consts + the per-capability rosters).
--
-- THREE telegram-specific wrinkles (settled on the 3o.2 representative; they
-- hold byte-for-byte across all 16):
--
--   WRINKLE 1 (Id<Bot>-first param) — every telegram capability method takes a
--   `botId: Id<Bot>` FIRST param (the TS `withBotIdParam` helper prepended it).
--   Here it is authored EXPLICITLY as the first arrow segment of each method
--   (`BotId` = the registered `Id<Bot>` named type, telegram.ts entity). NO
--   loader prepend-helper — the `.fenel` is the source of truth. The runtime
--   maps call args to param names from the io-LEAF function sigs (getUpdatesPoll
--   etc., `resolveParams` → function registry), NOT from these capability-method
--   params, so `seedFromType`'s `_0, _1, …` re-indexing of these arrow segments
--   is dispatch-safe; the `botId`-first ORDER is what's load-bearing.
--
--   WRINKLE 2 (the bot-keyed instance) — telegram's instance is NOT a provider
--   VALUE (email's mailgun/anthropic were values OF the capability type). It is a
--   type-level assertion "Bot implements <Cap>" (`args:["Bot"]`, priority 50,
--   method dict keyed `<Cap>.<method>`). That shape is not a `.fenel` value-decl
--   projection, so the INSTANCE stays seam-built (the 3d mixed-instances-deferral
--   precedent): the SEED moves to `.fenel` here; the seam derives the bot-keyed
--   instance FROM this seed's methods via `instanceFromCapabilitySeed`. Only the
--   seed is authored Fenel-side.
--
--   WRINKLE 3 (the ClassName.methodName dispatch key, the parity LOCK) — the
--   runtime `registerTelegramHandlers` keys handlers `${cap.name}.${method.name}`
--   from these SEEDs (`reg.listCapabilities()`), and `io.fenel`'s `getUpdatesPoll`
--   reuses the auto-registered `TelegramWebhooks.getUpdates` handler via its
--   `@ioAction`. Method field names here are plain idents (`getUpdates`, …) so
--   the keys stay byte-identical; the `getUpdatesPoll` end-to-end lock proves it.
--
-- Loaded SEPARATELY from the telegram body files (NOT merged) so these capability
-- types do NOT enter `telegramModule.entities` (the data-type roster); the seam
-- reads only their types to derive the seeds. The capability NAMES are
-- byte-identical to the retired consts. The 16 are listed in source order.
--
-- Param/return types reference the registered telegram `$named` types (Update /
-- Message / ChatRef / ReplyMarkup / InlineKeyboardMarkup / InputMedia /
-- ChatMember / LabeledPrice / … — all union/source/param-type entities); the
-- refined-String formats reference their named entities (`Url`, `MessageText`,
-- `CallbackText`) NOT String-relaxed inline `$refined` (which the sig surface
-- can't express). `Maybe` / `List` ride the std encodings.
-- =========================================================================

module telegram where

TelegramLifecycle = TelegramLifecycle getMe: (BotId -> User) logOut: (BotId -> Boolean) close: (BotId -> Boolean)
TelegramWebhooks = TelegramWebhooks getUpdates: (BotId -> Maybe Int -> Maybe Int -> Maybe Int -> List String -> List Update) setWebhook: (BotId -> Url -> Maybe String -> Maybe Int -> List String -> Maybe Boolean -> Boolean) deleteWebhook: (BotId -> Maybe Boolean -> Boolean) getWebhookInfo: (BotId -> WebhookInfo)
TelegramMessages = TelegramMessages sendMessage: (BotId -> ChatRef -> MessageText -> Maybe ParseMode -> List MessageEntity -> Maybe LinkPreviewOptions -> Maybe Boolean -> Maybe Boolean -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Maybe String -> Maybe Int -> Message) editMessageText: (BotId -> Maybe ChatRef -> Maybe Int -> Maybe String -> MessageText -> Maybe ParseMode -> List MessageEntity -> Maybe LinkPreviewOptions -> Maybe InlineKeyboardMarkup -> EditResult) editMessageReplyMarkup: (BotId -> Maybe ChatRef -> Maybe Int -> Maybe String -> Maybe InlineKeyboardMarkup -> EditResult) deleteMessage: (BotId -> ChatRef -> Int -> Boolean) deleteMessages: (BotId -> ChatRef -> List Int -> Boolean) forwardMessage: (BotId -> ChatRef -> ChatRef -> Int -> Maybe Int -> Maybe Boolean -> Maybe Boolean -> Message) forwardMessages: (BotId -> ChatRef -> ChatRef -> List Int -> Maybe Int -> Maybe Boolean -> Maybe Boolean -> List Int) copyMessage: (BotId -> ChatRef -> ChatRef -> Int -> Maybe String -> Maybe ParseMode -> List MessageEntity -> Maybe Int -> Maybe Boolean -> Maybe Boolean -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Int) copyMessages: (BotId -> ChatRef -> ChatRef -> List Int -> Maybe Boolean -> Maybe Int -> Maybe Boolean -> Maybe Boolean -> List Int) editMessageCaption: (BotId -> Maybe ChatRef -> Maybe Int -> Maybe String -> Maybe String -> Maybe ParseMode -> List MessageEntity -> Maybe Boolean -> Maybe InlineKeyboardMarkup -> EditResult) editMessageMedia: (BotId -> Maybe ChatRef -> Maybe Int -> Maybe String -> InputMedia -> Maybe InlineKeyboardMarkup -> EditResult) sendChatAction: (BotId -> ChatRef -> ChatAction -> Maybe Int -> Maybe String -> Boolean) setMessageReaction: (BotId -> ChatRef -> Int -> List ReactionType -> Maybe Boolean -> Boolean)
TelegramCallbacks = TelegramCallbacks answerCallbackQuery: (BotId -> String -> Maybe CallbackText -> Maybe Boolean -> Maybe Url -> Maybe Int -> Boolean)
TelegramMedia = TelegramMedia sendPhoto: (BotId -> ChatRef -> InputFile -> Maybe String -> Maybe ParseMode -> List MessageEntity -> Maybe Boolean -> Maybe Boolean -> Maybe Boolean -> Maybe Boolean -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendAudio: (BotId -> ChatRef -> InputFile -> Maybe String -> Maybe ParseMode -> Maybe Int -> Maybe String -> Maybe String -> Maybe InputFile -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendDocument: (BotId -> ChatRef -> InputFile -> Maybe InputFile -> Maybe String -> Maybe ParseMode -> Maybe Boolean -> Maybe Boolean -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendVideo: (BotId -> ChatRef -> InputFile -> Maybe Int -> Maybe Int -> Maybe Int -> Maybe InputFile -> Maybe String -> Maybe ParseMode -> Maybe Boolean -> Maybe Boolean -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendAnimation: (BotId -> ChatRef -> InputFile -> Maybe Int -> Maybe Int -> Maybe Int -> Maybe InputFile -> Maybe String -> Maybe ParseMode -> Maybe Boolean -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendVoice: (BotId -> ChatRef -> InputFile -> Maybe String -> Maybe ParseMode -> Maybe Int -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendVideoNote: (BotId -> ChatRef -> InputFile -> Maybe Int -> Maybe Int -> Maybe InputFile -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendMediaGroup: (BotId -> ChatRef -> List InputMedia -> Maybe Boolean -> Maybe Boolean -> Maybe ReplyParameters -> List Message) sendLocation: (BotId -> ChatRef -> Number -> Number -> Maybe Number -> Maybe Int -> Maybe Int -> Maybe Int -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendVenue: (BotId -> ChatRef -> Number -> Number -> String -> String -> Maybe String -> Maybe String -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendContact: (BotId -> ChatRef -> String -> String -> Maybe String -> Maybe String -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message)
TelegramFiles = TelegramFiles getFile: (BotId -> String -> File) getUserProfilePhotos: (BotId -> Int -> Maybe Int -> Maybe Int -> UserProfilePhotos)
TelegramChatAdmin = TelegramChatAdmin banChatMember: (BotId -> ChatRef -> Int -> Maybe Int -> Maybe Boolean -> Boolean) unbanChatMember: (BotId -> ChatRef -> Int -> Maybe Boolean -> Boolean) restrictChatMember: (BotId -> ChatRef -> Int -> ChatPermissions -> Maybe Boolean -> Maybe Int -> Boolean) promoteChatMember: (BotId -> ChatRef -> Int -> ChatAdministratorRights -> Boolean) setChatPermissions: (BotId -> ChatRef -> ChatPermissions -> Maybe Boolean -> Boolean) exportChatInviteLink: (BotId -> ChatRef -> Url) createChatInviteLink: (BotId -> ChatRef -> Maybe String -> Maybe Int -> Maybe Int -> Maybe Boolean -> ChatInviteLink) editChatInviteLink: (BotId -> ChatRef -> Url -> Maybe String -> Maybe Int -> Maybe Int -> Maybe Boolean -> ChatInviteLink) revokeChatInviteLink: (BotId -> ChatRef -> Url -> ChatInviteLink) approveChatJoinRequest: (BotId -> ChatRef -> Int -> Boolean) declineChatJoinRequest: (BotId -> ChatRef -> Int -> Boolean) pinChatMessage: (BotId -> ChatRef -> Int -> Maybe Boolean -> Boolean) unpinChatMessage: (BotId -> ChatRef -> Int -> Boolean) unpinAllChatMessages: (BotId -> ChatRef -> Boolean) leaveChat: (BotId -> ChatRef -> Boolean) getChat: (BotId -> ChatRef -> ChatFullInfo) getChatAdministrators: (BotId -> ChatRef -> List ChatMember) getChatMemberCount: (BotId -> ChatRef -> Int) getChatMember: (BotId -> ChatRef -> Int -> ChatMember)
TelegramBotConfig = TelegramBotConfig setMyCommands: (BotId -> List BotCommand -> Maybe BotCommandScope -> Maybe String -> Boolean) deleteMyCommands: (BotId -> Maybe BotCommandScope -> Maybe String -> Boolean) getMyCommands: (BotId -> Maybe BotCommandScope -> Maybe String -> List BotCommand) setMyName: (BotId -> Maybe String -> Maybe String -> Boolean) getMyName: (BotId -> Maybe String -> BotName) setMyDescription: (BotId -> Maybe String -> Maybe String -> Boolean) getMyDescription: (BotId -> Maybe String -> BotDescription) setMyShortDescription: (BotId -> Maybe String -> Maybe String -> Boolean) getMyShortDescription: (BotId -> Maybe String -> BotShortDescription) setChatMenuButton: (BotId -> Maybe ChatRef -> Maybe MenuButton -> Boolean) getChatMenuButton: (BotId -> Maybe ChatRef -> MenuButton)
TelegramPayments = TelegramPayments sendInvoice: (BotId -> ChatRef -> String -> String -> String -> Maybe String -> String -> List LabeledPrice -> Maybe Int -> List Int -> Maybe String -> Maybe Url -> Maybe Boolean -> Maybe Boolean -> Maybe Boolean -> Maybe Boolean -> Maybe Boolean -> Message) createInvoiceLink: (BotId -> String -> String -> String -> Maybe String -> String -> List LabeledPrice -> Url) answerShippingQuery: (BotId -> String -> Boolean -> List ShippingOption -> Maybe String -> Boolean) answerPreCheckoutQuery: (BotId -> String -> Boolean -> Maybe String -> Boolean) getMyStarBalance: (BotId -> StarAmount) getStarTransactions: (BotId -> Maybe Int -> Maybe Int -> StarTransactions) refundStarPayment: (BotId -> Int -> String -> Boolean) editUserStarSubscription: (BotId -> Int -> String -> Boolean -> Boolean)
TelegramInlineMode = TelegramInlineMode answerInlineQuery: (BotId -> String -> List InlineQueryResult -> Maybe Int -> Maybe Boolean -> Maybe String -> Maybe InlineQueryResultsButton -> Boolean) answerWebAppQuery: (BotId -> String -> InlineQueryResult -> SentWebAppMessage) savePreparedInlineMessage: (BotId -> Int -> InlineQueryResult -> Maybe Boolean -> Maybe Boolean -> Maybe Boolean -> Maybe Boolean -> PreparedInlineMessage)
TelegramStickers = TelegramStickers sendSticker: (BotId -> ChatRef -> InputFile -> Maybe String -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) getStickerSet: (BotId -> String -> StickerSet) getCustomEmojiStickers: (BotId -> List String -> List Sticker) uploadStickerFile: (BotId -> Int -> InputFile -> String -> File) createNewStickerSet: (BotId -> Int -> String -> String -> List InputSticker -> String -> Maybe Boolean -> Boolean) addStickerToSet: (BotId -> Int -> String -> InputSticker -> Boolean) setStickerPositionInSet: (BotId -> String -> Int -> Boolean) deleteStickerFromSet: (BotId -> String -> Boolean) replaceStickerInSet: (BotId -> Int -> String -> String -> InputSticker -> Boolean) setStickerEmojiList: (BotId -> String -> List String -> Boolean) setStickerKeywords: (BotId -> String -> List String -> Boolean) setStickerMaskPosition: (BotId -> String -> Maybe MaskPosition -> Boolean) setStickerSetTitle: (BotId -> String -> String -> Boolean) setStickerSetThumbnail: (BotId -> String -> Int -> Maybe InputFile -> String -> Boolean) setCustomEmojiStickerSetThumbnail: (BotId -> String -> Maybe String -> Boolean) deleteStickerSet: (BotId -> String -> Boolean)
TelegramPassport = TelegramPassport setPassportDataErrors: (BotId -> Int -> List PassportElementError -> Boolean)
TelegramGames = TelegramGames sendGame: (BotId -> ChatRef -> String -> Maybe ReplyParameters -> Maybe InlineKeyboardMarkup -> Message) setGameScore: (BotId -> Int -> Int -> Maybe Boolean -> Maybe Boolean -> Maybe ChatRef -> Maybe Int -> Maybe String -> EditResult) getGameHighScores: (BotId -> Int -> Maybe ChatRef -> Maybe Int -> Maybe String -> List GameHighScore)
TelegramPolls = TelegramPolls sendPoll: (BotId -> ChatRef -> String -> List InputPollOption -> Maybe Boolean -> Maybe String -> Maybe Boolean -> List Int -> Maybe String -> Maybe Int -> Maybe Int -> Maybe Boolean -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) stopPoll: (BotId -> ChatRef -> Int -> Maybe InlineKeyboardMarkup -> Poll) sendDice: (BotId -> ChatRef -> Maybe String -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) sendChecklist: (BotId -> ChatRef -> InputChecklist -> Maybe ReplyParameters -> Maybe ReplyMarkup -> Message) editMessageChecklist: (BotId -> ChatRef -> Int -> InputChecklist -> Maybe InlineKeyboardMarkup -> EditResult)
TelegramForumTopics = TelegramForumTopics getForumTopicIconStickers: (BotId -> List Sticker) createForumTopic: (BotId -> ChatRef -> String -> Maybe Int -> Maybe String -> ForumTopic) editForumTopic: (BotId -> ChatRef -> Int -> Maybe String -> Maybe String -> Boolean) closeForumTopic: (BotId -> ChatRef -> Int -> Boolean) reopenForumTopic: (BotId -> ChatRef -> Int -> Boolean) deleteForumTopic: (BotId -> ChatRef -> Int -> Boolean) unpinAllForumTopicMessages: (BotId -> ChatRef -> Int -> Boolean) editGeneralForumTopic: (BotId -> ChatRef -> String -> Boolean) closeGeneralForumTopic: (BotId -> ChatRef -> Boolean) reopenGeneralForumTopic: (BotId -> ChatRef -> Boolean) hideGeneralForumTopic: (BotId -> ChatRef -> Boolean) unhideGeneralForumTopic: (BotId -> ChatRef -> Boolean)
TelegramBusiness = TelegramBusiness getBusinessConnection: (BotId -> String -> BusinessConnection) readBusinessMessage: (BotId -> String -> ChatRef -> Int -> Boolean) deleteBusinessMessages: (BotId -> String -> List Int -> Boolean) setBusinessAccountName: (BotId -> String -> String -> Maybe String -> Boolean) setBusinessAccountUsername: (BotId -> String -> Maybe String -> Boolean) setBusinessAccountBio: (BotId -> String -> Maybe String -> Boolean) setBusinessAccountGiftSettings: (BotId -> String -> Boolean -> AcceptedGiftTypes -> Boolean) getBusinessAccountStarBalance: (BotId -> String -> StarAmount) transferBusinessAccountStars: (BotId -> String -> Int -> Boolean) getAvailableGifts: (BotId -> Gifts) sendGift: (BotId -> Maybe Int -> Maybe ChatRef -> String -> Maybe String -> Maybe ParseMode -> Maybe Boolean -> Boolean) giftPremiumSubscription: (BotId -> Int -> Int -> Maybe String -> Boolean) verifyUser: (BotId -> Int -> Maybe String -> Boolean) verifyChat: (BotId -> ChatRef -> Maybe String -> Boolean) removeUserVerification: (BotId -> Int -> Boolean) removeChatVerification: (BotId -> ChatRef -> Boolean) postStory: (BotId -> String -> InputStoryContent -> Int -> Maybe String -> Maybe ParseMode -> List StoryArea -> Maybe Boolean -> Maybe Boolean -> Story) editStory: (BotId -> String -> Int -> InputStoryContent -> Maybe String -> Maybe ParseMode -> List StoryArea -> Story) deleteStory: (BotId -> String -> Int -> Boolean)
