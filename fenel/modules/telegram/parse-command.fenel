-- parseCommand — extract a Telegram bot command from message text.
--
-- Accepts `/cmd args...` and `/cmd@botname args...`. The `@botname`
-- suffix is stripped from the command name. Args are split on
-- whitespace; multiple consecutive spaces collapse (matching `\s+`).
-- Returns Nothing when the text doesn't start with `/` or when the
-- resulting command name is empty.
--
-- Ported from a TS native that used a regex; the Fenel body uses
-- std primitives (startsWith / slice / split / filter / head / tail)
-- and pattern matching only.
--
-- module-substrate Phase 3o.1+ (2026-05-31) — carries `module telegram where`,
-- so it UNIONs into the `telegram` module alongside decoders.fenel +
-- conversation.fenel. The hand-wrapped defineFunction spec + the
-- PARSE_COMMAND_BODY extraction in engine/src/modules/telegram.ts are RETIRED;
-- identity now rides @facet directives. The inline-record return type
-- (Maybe { name, args }) round-trips byte-identically now that the sig parser
-- stamps `meta: {}` on inline-record fields (the Surprise #37 fix).

module telegram where

@label "Parse command"
@description "Extract a Telegram bot command from message text. Accepts `/cmd args` and `/cmd@botname args`. Nothing if no command prefix."
@tags "telegram" "parser" "pure"
parseCommand : String -> Maybe ({ name : String, args : List String })
parseCommand s =
  if not (startsWith s "/") then Nothing
  else
    let rest = slice s 1 (length s)
    let tokens = split rest " "
    case head tokens of
      Nothing -> Nothing
      Just firstToken ->
        let nameParts = split firstToken "@"
        case head nameParts of
          Nothing -> Nothing
          Just name ->
            if length name == 0 then Nothing
            else
              case tail tokens of
                Nothing -> Just { name = name, args = [] }
                Just restTokens ->
                  let args = filter (\t -> length t > 0) restTokens
                  Just { name = name, args = args }
