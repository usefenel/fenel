-- Movie dispatch instances (typed-function-references Phase 10c).
--
-- Sampleable<Movie> / Renderable<Movie> — entries in the polymorphic
-- sample/render dispatch tables. `.fenel` value-decls (the Phase-10 loader flip
-- lowers the point-free method refs to the dispatch-ready `{$ref}` codeName
-- handle; the registry resolves them to `movie:sampleMovie` / `movie:renderMovie`).
-- Loaded with `dispatchInstanceFile: true`.
sampleableMovie : Sampleable Movie
sampleableMovie = Sampleable { sample = sampleMovie }

renderableMovie : Renderable Movie
renderableMovie = Renderable { render = renderMovie }
