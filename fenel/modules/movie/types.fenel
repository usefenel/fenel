-- =========================================================================
-- Movie — visual and audio together over time. Tagged union with two
-- cases (Recorded RecordedMovie / MovieAt (Time -> Scene)) plus the
-- `Scene` and `RecordedMovie` records and the inline closure-construction
-- helpers (withAudio / silentMovie).
--
-- A `Scene` is what's visible AND audible at one instant — a record of
-- Picture + Amplitude. A Movie is a signal of Scenes over time.
--
-- Phase 4g of ts-elimination: this body was previously the inline
-- `const MOVIE_SRC = \`…\`` template literal at engine/src/modules/movie.ts;
-- extracted verbatim with JS template-literal `\\t` lambda escapes
-- collapsed to single-backslash `\t`. The externally owned `Animation`
-- reference is module-qualified so its nominal identity never depends on
-- catalog/module registration order; the remaining unique names resolve
-- lazily through the catalog walk.
--
-- module-substrate Phase 3g (2026-05-30) — movie is the RICHEST COMPOSER:
-- its ffi/ leaf imports BOTH picture-ffi's renderNative (a previously-migrated
-- base, 3f) AND sound-ffi's Amplitude/AudioBuffer value types (a same-phase
-- base, 3g) leaf-to-leaf. The 3 TS natives (sampleMovie / renderMovie / scene),
-- previously hand-assembled defineFunction specs, are now @native FOREIGN
-- DECLARATIONS here; their impls live in ffi/movie-ffi.ts. `sampleMovie` /
-- `renderMovie` are CTX natives (they re-enter the evaluator to run MovieAt
-- closures); `scene` is plain. Plain-vs-ctx is decided ENTIRELY by which seam
-- map an impl lands in — no marker (axis #4). The natives keep their `video`
-- category; the 2 Fenel-bodied helpers keep the module-name `movie` default.
-- =========================================================================

module movie where

Movie = Recorded RecordedMovie | MovieAt (Time -> Scene)

Scene = Scene visual: Picture audio: Amplitude

RecordedMovie = RecordedMovie
  fps: Number
  width: Number
  height: Number
  frames: [Image]
  audio: AudioBuffer

-- ----- Foreign declarations (native-backed; impl in ffi/movie-ffi.ts) -------
-- `sampleMovie` / `renderMovie` re-enter the evaluator (CTX natives →
-- nativeImplsCtx); `scene` is a pure representation-record builder (plain
-- native → nativeImpls). No Fenel body: the registry resolves each call to the
-- ffi leaf keyed by codeName.

@native
@label "Sample movie"
@description "Sample a Movie at a Time, returning the Scene (Picture + Amplitude) at that instant."
@category "video"
@tags "video" "audio" "primitive"
sampleMovie : (movie: Movie, t: Time) -> Scene

@native
@label "Render movie"
@description "Rasterise a Movie into synchronised video frames + audio. Walks the timeline at fps for video and sampleRate for audio over `duration` seconds."
@category "video"
@tags "video" "audio" "primitive"
renderMovie : (movie: Movie, duration: Number, fps: Number, sampleRate: Number, width: Number, height: Number) -> RecordedMovie

@native
@label "Scene"
@description "Build a Scene record from a Picture and an Amplitude."
@category "video"
@tags "video" "audio" "constructor"
scene : (visual: Picture, audio: Amplitude) -> Scene

-- Combine a visual Animation with a Sound into a Movie. At each instant the
-- scene is the Animation's Picture and the Sound's Amplitude.
withAudio : animation.Animation -> Sound -> Movie
withAudio anim snd = MovieAt (\t -> scene (sampleAnim anim t) (sampleSound snd t))

-- A purely-visual Movie (silent). Useful for demos.
silentMovie : animation.Animation -> Movie
silentMovie anim = MovieAt (\t -> scene (sampleAnim anim t) (amplitude 0 0))
