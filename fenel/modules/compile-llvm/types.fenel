-- =========================================================================
-- compile-llvm target AST surface — canonical declaration site for every
-- entity in the LLVM-IR-target compilation pipeline's typed IR.
--
-- Phase 4j of ts-elimination: consolidates the per-target deep AST ADTs
-- that Phase 4h's program-envelope tier had to leave as lazy `a` field
-- refs. Pre-4j these ~22 entities were declared inside
-- `fenel/modules/engine/lower-to-llvm-ast.fenel` (the LLVM lowering pass
-- body); only `LlvmModule` was dual-declared between the body file and
-- this types file (Phase 4h's program-envelope tier authored the
-- LlvmModule shape here while lower-to-llvm-ast.fenel kept its own copy —
-- shapes matched, dedup silently inert). Post-4j this file is the single
-- canonical declaration site for the full LLVM-target AST surface;
-- lower-to-llvm-ast.fenel keeps its function bodies only.
--
-- Provenance: follows the operational Fenel-native subset of
-- `implementations/typescript/engine/src/ir/llvm-ast.ts`. Recursive operands,
-- instructions, blocks, and module collections are named concretely; the
-- unused optional host-only axes are called out below, and no declaration
-- couples unrelated fields through a shared placeholder variable.
-- =========================================================================

-- ---------------------------------------------------------------------------
-- LlvmValType — LLVM IR value types.
-- ---------------------------------------------------------------------------
-- 12 variants from ir/llvm-ast.ts: 9 atomic (I1/I8/I16/LlvmI32/LlvmI64/Float/Double/
-- Void/Ptr) + 3 composite (Vector/Array/Struct). The bootstrap mostly uses
-- Double (numbers) + I1 (booleans) + Ptr (strings/ADTs); the rest are
-- declared for completeness so future bodies extend without re-declaration.
LlvmValType =
  I1
  | I8
  | I16
  | LlvmI32
  | LlvmI64
  | Float
  | Double
  | Void
  | Ptr
  | Vector elemType: LlvmValType count: Number
  | LlvmArrayT elemType: LlvmValType count: Number
  | LlvmStructT fields: List LlvmValType

-- ---------------------------------------------------------------------------
-- LlvmDomain — source-level domain of an LLVM value. Mirrors the TS
-- oracle's LlvmDomain (compile-llvm.ts:139). The TS-side inferEntryDomains
-- populates an env Map<String, LlvmDomain> and marshals the result as
-- (paramDomains, externalReturn) body args.
-- ---------------------------------------------------------------------------
LlvmDomain =
  DomDouble
  | DomI1
  | DomPtr
  | LlvmDomUnknown

-- LlvmDomainEntry — one entry in the marshalled domain env. Built by the
-- dispatch wrapper from the TS-side `inferEnv` map. Carried for symmetry
-- with Phase 21.7's WasmDomain pattern even though the Phase 21.8 MVP
-- uses paramDomains directly (not via LlvmDomainEntry lookup).
LlvmDomainEntry = LlvmDomainEntry name: String domain: LlvmDomain

-- ---------------------------------------------------------------------------
-- LlvmOperand — values that appear inside an instruction. 8 variants from
-- ir/llvm-ast.ts: 5 constant forms + 2 reference forms + ConstNullPtr.
-- ---------------------------------------------------------------------------
LlvmOperand =
  ConstI1 value: Boolean
  | ConstI32 value: Number
  | ConstI64 value: Number
  | ConstFloat value: Number
  | ConstDouble value: Number
  | ConstNullPtr
  | LocalRef name: String
  | GlobalRef name: String

-- ---------------------------------------------------------------------------
-- LlvmInstr — non-terminator instructions. ~27 variants from
-- ir/llvm-ast.ts: Add/Sub/Mul/SDiv/SRem, FAdd/FSub/FMul/FDiv/FNeg,
-- And/Or/Xor, ICmp/FCmp, SIToFP/FPToSI/ZExt/SExt/Trunc/BitCast,
-- Alloca/Load/Store, Phi, LlvmCall.
-- ---------------------------------------------------------------------------
LlvmInstr =
  -- Integer arithmetic
  Add result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | Sub result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | Mul result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | SDiv result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | SRem result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  -- Float arithmetic
  | FAdd result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | FSub result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | FMul result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | FDiv result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | FNeg result: String opType: LlvmValType operand: LlvmOperand
  -- Bitwise
  | And result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | Or result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | Xor result: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  -- Comparisons
  | ICmp result: String predicate: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  | FCmp result: String predicate: String opType: LlvmValType lhs: LlvmOperand rhs: LlvmOperand
  -- Conversions
  | SIToFP result: String fromType: LlvmValType value: LlvmOperand toType: LlvmValType
  | FPToSI result: String fromType: LlvmValType value: LlvmOperand toType: LlvmValType
  | ZExt result: String fromType: LlvmValType value: LlvmOperand toType: LlvmValType
  | SExt result: String fromType: LlvmValType value: LlvmOperand toType: LlvmValType
  | Trunc result: String fromType: LlvmValType value: LlvmOperand toType: LlvmValType
  | BitCast result: String fromType: LlvmValType value: LlvmOperand toType: LlvmValType
  -- Memory
  | Alloca result: String elemType: LlvmValType
  | Load result: String valType: LlvmValType ptr: LlvmOperand
  | Store valType: LlvmValType value: LlvmOperand ptr: LlvmOperand
  -- SSA join
  | Phi result: String phiType: LlvmValType incoming: List LlvmPhiIncoming
  -- Calls — the Fenel-native pipeline models value and void calls as two
  -- distinct constructors. The older TS AST used one optional `result` field;
  -- no dispatch wrapper normalisation remains on this self-hosted path.
  | LlvmCall result: String retType: LlvmValType fn: LlvmOperand args: List LlvmCallArg
  | LlvmCallVoid retType: LlvmValType fn: LlvmOperand args: List LlvmCallArg

-- ---------------------------------------------------------------------------
-- LlvmTerminator — every basic block ends in exactly one of these.
-- The Fenel-native pipeline models value and void returns as Ret + RetVoid.
-- The older TS AST used one optional `value` field; no dispatch wrapper
-- normalisation remains on this self-hosted path.
-- ---------------------------------------------------------------------------
LlvmTerminator =
  Ret retType: LlvmValType value: LlvmOperand
  | RetVoid retType: LlvmValType
  | LlvmBr target: String
  | BrCond cond: LlvmOperand ifTrue: String ifFalse: String
  | Switch opType: LlvmValType value: LlvmOperand defaultLabel: String cases: List LlvmSwitchCase
  | LlvmUnreachable

-- ---------------------------------------------------------------------------
-- LlvmBasicBlock — labeled instruction sequence + terminator.
-- ---------------------------------------------------------------------------
LlvmBasicBlock = LlvmBasicBlock label: String instructions: List LlvmInstr terminator: LlvmTerminator

-- ---------------------------------------------------------------------------
-- LlvmParam — function parameter.
-- ---------------------------------------------------------------------------
LlvmParam = LlvmParam name: String paramType: LlvmValType

-- ---------------------------------------------------------------------------
-- LlvmFunctionDef — function definition with basic blocks.
-- ---------------------------------------------------------------------------
LlvmFunctionDef = LlvmFunctionDef name: String returnType: LlvmValType params: List LlvmParam blocks: List LlvmBasicBlock

-- ---------------------------------------------------------------------------
-- LlvmFunctionDecl — function declaration (extern).
-- ---------------------------------------------------------------------------
LlvmFunctionDecl = LlvmFunctionDecl name: String returnType: LlvmValType params: List LlvmParam

-- ---------------------------------------------------------------------------
-- LlvmGlobal — module-level global. The current operational declaration uses
-- an initializer-required subset; Phase 21.8 emits no globals. A future body
-- that needs the host AST's optional initializer must widen this boundary
-- explicitly rather than smuggling absence through a shared type variable.
-- ---------------------------------------------------------------------------
LlvmGlobal = LlvmGlobal name: String globalType: LlvmValType initializer: LlvmOperand isConstant: Boolean

-- ---------------------------------------------------------------------------
-- LlvmEffectImport — Phase 16 effect metadata: structured view of the
-- `declare ptr @fenel_<Class>_<method>(ptr, ...)` externs the dispatch
-- sites emit.
-- ---------------------------------------------------------------------------
LlvmEffectImport = LlvmEffectImport typeName: String methodName: String arity: Number symbol: String

-- ---------------------------------------------------------------------------
-- LlvmModule — program-level Fenel-native envelope. effectImports and
-- stringPool are always carried (empty when absent). The host AST's optional
-- targetTriple/dataLayout axes are outside the shipped self-hosted subset;
-- there is no dispatch-wrapper shape normalisation on this path.
-- ---------------------------------------------------------------------------
LlvmModule = LlvmModule name: String fieldSlots: List CompileFieldSlot declarations: List LlvmFunctionDecl globals: List LlvmGlobal definitions: List LlvmFunctionDef effectImports: List LlvmEffectImport stringPool: List String

-- ---------------------------------------------------------------------------
-- LowerOutput — (operand, domain) pair returned by per-CeExpr lowering.
-- Mirrors the TS oracle's `Lowered` type (compile-llvm.ts:577).
-- ---------------------------------------------------------------------------
LlvmLowerOutput = LlvmLowerOutput operand: LlvmOperand domain: LlvmDomain

-- ---------------------------------------------------------------------------
-- LlvmDirectArith / LlvmDirectCmp — encoded mapping from canonical
-- codeName to the LLVM direct-op shape. Mirrors DIRECT_FP_ARITH_OPS /
-- DIRECT_FP_COMPARISONS at compile-llvm.ts:2021-2036.
-- ---------------------------------------------------------------------------
LlvmDirectArith =
  LDArithFAdd
  | LDArithFSub
  | LDArithFMul
  | LDArithFDiv
  | LDArithNone

LlvmDirectCmp =
  LDCmp predicate: String
  | LDCmpNone

-- ---------------------------------------------------------------------------
-- LlvmScopeEntry — value bound in the builder's scope map. Mirrors the TS
-- oracle's `{ operand, domain }` shape at compile-llvm.ts:445.
-- ---------------------------------------------------------------------------
LlvmScopeEntry = LlvmScopeEntry operand: LlvmOperand domain: LlvmDomain

-- ---------------------------------------------------------------------------
-- LlvmParamDomain — entry in the paramDomains list flowed from the
-- dispatch wrapper's TS-side inferEntryDomains. Mirrors the TS oracle's
-- `{ name: string; domain: LlvmDomain }` shape at compile-llvm.ts:2066.
-- ---------------------------------------------------------------------------
LlvmParamDomain = LlvmParamDomain name: String domain: LlvmDomain

-- ---------------------------------------------------------------------------
-- LlvmCallDomain — argDomains + resultDomain pair returned by callDomainOf.
-- ---------------------------------------------------------------------------
LlvmCallDomain = LlvmCallDomain argDomains: List LlvmDomain resultDomain: LlvmDomain

-- ---------------------------------------------------------------------------
-- LlvmPhiIncoming — (value, label) pair for Phi instruction incoming-bindings.
-- ---------------------------------------------------------------------------
LlvmPhiIncoming = LlvmPhiIncoming value: LlvmOperand label: String

-- ---------------------------------------------------------------------------
-- LlvmCallArg — (argType, value) pair for LlvmCall instruction arg lists.
-- ---------------------------------------------------------------------------
LlvmCallArg = LlvmCallArg argType: LlvmValType value: LlvmOperand

-- ---------------------------------------------------------------------------
-- LlvmSwitchCase — (caseValue, target) pair for Switch terminator cases.
-- Declared for follow-on; Phase 21.8 bootstrap doesn't emit Switch.
-- ---------------------------------------------------------------------------
LlvmSwitchCase = LlvmSwitchCase caseValue: LlvmOperand target: String
