-- =========================================================================
-- compile-llvm — bodyless @native sigs for the seven LLVM-target pipeline
-- steps.
--
-- module-substrate Phase 3v.5 (2026-06-01) — sibling of compile-js/sigs.fenel
-- and compile-wasm/sigs.fenel. The TS impls (step natives in
-- engine/src/modules/compile-llvm.ts) STAY — they're the irreducible host
-- leaves that walk the typed IR through engine-bodies-dispatch.ts. This
-- file is the FENEL-AUTHORED sig surface; the union (types.fenel +
-- instances.fenel + sigs.fenel) groups all three under the compile-llvm
-- module name supplied by the loader arg.
--
-- Three of the 7 sigs carry an explicit @codeName: the per-target LLVM
-- spec gave the first three pipeline steps target-suffixed global codeNames
-- (normaliseToCoreForLlvm / makeEffectsExplicitForLlvm /
-- makeClosuresExplicitForLlvm) while keeping the short fnId suffix
-- (compile-llvm:normaliseToCore / …). Default behaviour stamps codeName
-- == def-name; @codeName overrides for these three so the byte-identical
-- codeName-driven Codeable surface is preserved.
--
-- The 7 sigs (in spec-list order, preserved for stable instance ordering):
--   normaliseToCore       — codeName normaliseToCoreForLlvm
--   makeEffectsExplicit   — codeName makeEffectsExplicitForLlvm
--   makeClosuresExplicit  — codeName makeClosuresExplicitForLlvm
--   lowerToLlvmAst        — codeName lowerToLlvmAst
--   serializeLlvmModule   — Iso String LlvmModule encode side
--   deserializeLlvmModule — Iso String LlvmModule decode side (Phase 14 stub)
--   compileFenelToLlvm    — top-level pipeline (CompileSource into LlvmModule)
--
-- No `module ... where` header — `compile-llvm` contains a hyphen which the
-- ident lexer splits on. The loader name-arg (set by compile-llvm.ts)
-- supplies the module identity instead; the three files share that arg
-- and union under the same group.
-- =========================================================================

@native
@codeName "normaliseToCoreForLlvm"
@label "Lower → Core (LLVM path)"
@description "Lower a CompileSource (signature + JSON-Logic body + declared `requires`) to the Core IR for the LLVM target. Shares the engine-wide Core IR with the JS and Wasm targets — the same lowering, the same diagnostics. Surfacing this as a per-target function-id ensures the Phase 5 lowering's structural metadata is reachable from every compile-{js,wasm,llvm} registry entry."
@category "compile-llvm"
@tags "compile" "lowering" "ir" "llvm"
normaliseToCore : (source: CompileSource) -> Result CompileError CoreProgram

@native
@codeName "makeEffectsExplicitForLlvm"
@label "Lower → EffectsExplicit (LLVM path)"
@description "Make effect-dispatch sites explicit. Shares the IR pass with Wasm / JS — sentinel `$effect:<Class>:<method>` calls populate the `effects` inventory + `handlerSites` list. Phase 16: the LLVM lowering (`lowerToLlvmAst`) emits `declare ptr @fenel_<Class>_<method>(...)` externs + `call` instructions at each dispatch site; the C runtime shim (`runtime/llvm-rt.c`) provides the implementations and the host runtime registers handlers via `fenel_register_handler` at instantiation time. See `design/effectful-compilation.md` for the per-target ABI."
@category "compile-llvm"
@tags "compile" "lowering" "ir" "effects" "llvm"
makeEffectsExplicit : (core: CoreProgram) -> Result CompileError EffectsExplicitProgram

@native
@codeName "makeClosuresExplicitForLlvm"
@label "Lower → ClosuresExplicit (LLVM path)"
@description "Closure-convert: walk the IR, compute the free-variable set of each lambda, materialise it as the closure's `captures` list. LLVM has no native closure representation — the captures list is essential for the struct-of-captures + function-pointer-pair shape that backs a closure at the native level. Phase 14 reuses the same pass as compile-js / compile-wasm since the closures-explicit form is target-agnostic."
@category "compile-llvm"
@tags "compile" "lowering" "ir" "closures" "llvm"
makeClosuresExplicit : (ee: EffectsExplicitProgram) -> Result CompileError ClosuresExplicitProgram

@native
@label "Lower → LlvmAst"
@description "Lower a ClosuresExplicitProgram to LlvmAst using phi-based SSA. Maps Fenel std-op subset to direct LLVM ops (`add` → `fadd double`, `lt` → `fcmp olt double`, …) where the semantics align; routes other calls through `@fenel_<fnId>` declarations (resolved by linking against a C runtime shim). CeIf lowers to a conditional branch + two branch-blocks + a phi at the merge block — textbook SSA frontend pattern. Type inference picks `double` / `i1` / `ptr` for each param + return based on usage in the body. Phase 16: effect-dispatch sentinels (`$effect:<Class>:<method>`) lower to `call ptr @fenel_<Class>_<method>(<args>) → ptr` against the C runtime shim's externs, populating `LlvmModule.effectImports` as structured metadata. String literals route through the per-module `stringPool` + `@fenel_lit_string(ptr, i64) → ptr` helper."
@category "compile-llvm"
@tags "compile" "lowering" "ir" "llvm"
lowerToLlvmAst : (ce: ClosuresExplicitProgram) -> Result CompileError LlvmModule

@native
@label "Serialize LlvmModule"
@description "Serialize a LlvmModule to LLVM IR text per the LLVM Language Reference Manual. The encode side of `Iso<String, LlvmModule>`. Output is a `.ll`-shaped string that `llvm-as` / `lli` / `opt` / `llc` consume directly."
@category "compile-llvm"
@tags "compile" "serialize" "llvm" "codec"
serializeLlvmModule : (module: LlvmModule) -> Result String String

@native
@label "Deserialize LlvmModule (placeholder)"
@description "The decode side of `Iso<String, LlvmModule>`. Phase 14 stub — always returns Err. A real parser lands when a use case demands round-tripping `.ll` text back into the typed LlvmAst (e.g. importing externally-optimised IR for further rewriting)."
@category "compile-llvm"
@tags "compile" "deserialize" "llvm" "codec" "placeholder"
deserializeLlvmModule : (encoded: String) -> Result String LlvmModule

@native
@label "Compile Fenel → LLVM IR"
@description "Top-level CompileLlvm pipeline: CompileSource → CoreProgram → EffectsExplicitProgram → ClosuresExplicitProgram → LlvmModule. The first three passes are reused unchanged from Phase 5 (the substrate is target-agnostic). The fourth pass — `lowerToLlvmAst` — is new in Phase 14. Pair with `serializeLlvmModule` to obtain the LLVM IR text string."
@category "compile-llvm"
@tags "compile" "pipeline" "llvm"
compileFenelToLlvm : (source: CompileSource) -> Result CompileError LlvmModule
