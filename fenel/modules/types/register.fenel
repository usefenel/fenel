-- =========================================================================
-- Types — register_type (the FenelType-as-action-param action).
--
-- forms-collapse Phase 1 (D-REG = B, Rom 2026-06-08). This is the
-- action-subsumption thesis applied to TYPE-AUTHORING ITSELF: "an action's
-- params ARE its form," and here the param IS a `FenelType`, so *registering a
-- type is submitting a form whose type is FenelType* — self-referential,
-- headless-callable, and uniform with every other action.
--
-- `registerType : String -> Type -> ActionResult` (+ injected `adapter`):
--   • `name`   — the type's persistence KEY / Codeable codeName (entity_definition
--                identity is a Codeable projection keyed by name, not a schema
--                field; see fenel/std/entities/entity_definition.fenel).
--   • `schema` — the FenelType. Typed `Type` (= the `{$type: true}` universe).
--                Two facts make `Type`-as-param work end-to-end (proven by
--                register-type-fenel-param.test.ts):
--                  - validate({$type: true}, value) accepts any well-formed
--                    FenelType value via isFenelType (validate.ts:427-429) — so
--                    the dispatcher's `state.validate_function_args` (over
--                    paramRecordOf) accepts a type-AST as the `schema` arg,
--                    untouched (non-Maybe pass-through);
--                  - the editor renders `Type`-typed fields with the universal
--                    `TypeBuilder` (FieldRenderer.tsx:623 — `"$type" in type`),
--                    so the action's AUTO-DERIVED input UX IS the FenelType
--                    editor. No bespoke form, no fork.
--
-- This REPLACES `create_form` (forms-collapse): the funnel-builder "new form"
-- becomes "register the funnel's input type." A form is the auto-derived input
-- UX of a registered `$record`; there is no second object. See
-- design/forms-collapse.md + workstreams/forms-collapse/.
--
-- NEW module (no oracle) — created directly in the `module … where` + `@facet`
-- format proven on items/profiles. The thin engine/src/modules/types.ts seam
-- loads this file; `typesModule` is registered at the same four boot surfaces
-- itemsModule is (system-entities, type-catalog, runtime evaluator, self-host
-- matrix). `register_type` is exposed as a public action in
-- core/src/actions/types.ts (fnRef = "types:registerType"); dispatch validates
-- {name, schema} against paramRecordOf(fn) (D2 — no `register_type_params`
-- mirror entity) and injects `adapter` (D4). HasStateIO is supplied by
-- createRegistry's attachInferredRequires (transitive from the state:* calls),
-- as on items.
--
-- ActionResult ADT (ActionOk { data, aggregateType, aggregateId, profileId } |
-- ActionErr { message }) is the return; the wrapper's actionResultAdtToTs
-- translates it.
-- =========================================================================

module types where

-- registerType — build the entity_definition row, persist it via the generic
-- state:upsertType type-registry leaf (the SAME write target POST /types uses),
-- then attach identity + emit. `def` carries only {name, type}; the optional
-- entity_definition template fields stay absent (Maybe → Nothing at the codec).
registerType : String -> Type -> String -> ActionResult
@label "Register type"
@description "forms-collapse Phase 1 (D-REG=B) — the public register_type action. Params ARE the contract: name (the type's persistence key / Codeable codeName) + schema (a FenelType, typed `Type` = the {$type:true} universe). Persists the entity_definition via state:upsertType (the POST /types write target), attaches the type's Codeable, emits type_registered, returns ActionOk { data = the row }. The action's auto-derived input UX is TypeBuilder (Type-typed param). Replaces create_form: a form is the auto-derived input UX of a registered $record."
@tags "type" "registry" "register" "action"
@ioAction "types.register_type"
registerType name schema adapter =
  let def = { name = name, type = schema }
  let row = upsertType def
  registerTypeEmit name row adapter

-- registerTypeEmit — successful-register tail. Attaches the type's Codeable
-- (codeName ← name) the same way the frontend's persistCommonRepresentations
-- does after POST /types (so headless register_type is identity-complete, not
-- frontend-dependent), writes the type_registered event, and returns the row.
registerTypeEmit : String -> {} -> String -> ActionResult
@label "Register type (emit)"
@description "forms-collapse Phase 1 — successful-register tail of registerType. Attaches the type Codeable (codeName ← name) via state:registerRepresentation (keyed by the type name, mirroring the frontend persistCommonRepresentations after POST /types), writes type_registered via state:appendEvent (aggregateType=Just 'entity_definition', aggregateId=Just name, profileId=Nothing), returns ActionOk { data = the upserted row }."
@tags "type" "registry" "register"
registerTypeEmit name row adapter =
  let _c = registerRepresentation name "Codeable" { codeName = name }
  let payload = { name = name, adapter = adapter }
  let _e = appendEvent "type_registered" payload (Just "entity_definition") (Just name) Nothing
  ActionOk { data = row, aggregateType = Just "entity_definition", aggregateId = Just name, profileId = Nothing }
