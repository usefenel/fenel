-- =========================================================================
-- Types — funnel BEHAVIOR (the dissolved `onSubmit`).
--
-- forms-collapse Phase 3a (2026-06-08) / Phase 5 (2026-06-10). The thesis
-- (design/forms-collapse.md Q3): **a funnel IS a Fenel IO function.** Its param
-- is the input type, its body is the behavior, and its return value's VIEW is
-- the next screen. So the legacy `onSubmit` rule-set + the navigation directive
-- **dissolve** into an ordinary function body + a returned typed value — there
-- is NO `FormOnSubmitAction` ADT, NO `OnSubmitRule`, NO directive protocol
-- (LOCK-1).
--
-- Phase 5 (R2) retired the transitional R1 shim (`funnelRedirect`/`funnelPage`,
-- which wrapped `{redirect = url}` / `{page = name}` directive records the
-- widget special-cased). A funnel now returns a **real typed value** and the
-- `FenelForm` widget renders that value's view:
--   • instant arm → `Link { url, label }` (a typed navigable link — std entity,
--     fenel/std/entities/link.fenel). The widget renders it as a "Continue →"
--     anchor the visitor clicks (render the VALUE'S VIEW, not obey a directive).
--   • regular arm → a bare ack record `{}` (no renderable typed value → the
--     widget's default thank-you state — "absence of a renderable value = the
--     default screen", D2 lean (a); no second entity invented).
--
-- `cfApplication` — the re-homed `cf_application` funnel (THE proof). The 1 live
-- legacy `onSubmit` was:
--     if  $form.application_type == "instant"
--       → create_payment_link { plan: "cf_instant", redirect: true }
--     else
--       → show_page "thanks_regular"
-- Re-expressed here as an ordinary body: capture the lead
-- (state:tryCreateInstanceByName — unverified, LOCK-2 create-only), then an
-- ordinary `if` over the input field, returning `Link { url = <the dispatched
-- payment link>, label = Nothing }` or the bare ack `{}`. The `CreatePaymentLink`
-- arm is the SAME machinery forms/submit.fenel already used (dispatch:dispatchAction
-- → create_payment_link) — relocated into a per-funnel body, not authored from
-- scratch.
--
-- HOME: `cfApplication` is registered as a `types` MODULE function (NOT a user
-- row) ONLY because it is the built-in demo proof — it makes the dissolved
-- onSubmit in-process testable (createRegistry + invokeCallable). AUTHORED
-- funnels (the builder, app/forms) target USER-function rows
-- (state:upsertFunction, name = the funnel name) — funnels are account data, not
-- std. At runtime `types:submit` resolves a per-type function by name
-- (state:getFunction) and calls it; for this demo to fire end-to-end a
-- `cf_application` user-function row carrying this body must exist for the
-- account (authored via the builder, or seeded) — see the roadmap's Phase-3a
-- completion notes (the staging-activation step; the in-process proof stands
-- without it).
--
-- parseApp doesn't continue arg lists across newlines — multi-line conditionals
-- → top-level helpers; the `if` stays LAZY (the `else`/regular branch evaluates
-- WITHOUT touching the dispatch arm — so cfApplicationNext's regular path is
-- pure and in-process testable; the `instant`/dispatch arm → staging e2e).
-- =========================================================================

module types where

-- cfApplication — the re-homed cf_application funnel (THE proof). param = the
-- cf_application input record; returns a typed value (Link, or the bare ack).
-- Captures the lead (unverified) then dispatches on application_type.
cfApplication : {} -> {}
@label "CFApplication funnel"
@description "forms-collapse Phase 3a / Phase 5 — the re-homed CFApplication funnel (the proof that a legacy onSubmit rule-set = an ordinary function body + a returned typed value). Captures the lead as an UNVERIFIED instance (state:tryCreateInstanceByName — LOCK-2 create-only), then an ordinary `if` over input.application_type: 'instant' → Link { url = the create_payment_link url via dispatch:dispatchAction (plan cf_instant), label = Nothing } (the widget renders a 'Continue →' anchor); else → the bare ack {} (the widget's default thank-you). No FormOnSubmitAction ADT, no directive protocol (LOCK-1). The demo home for the dissolved onSubmit; authored funnels are user-function rows."
@tags "funnel" "behavior" "CFApplication" "forms-collapse"
cfApplication input =
  let _cap = tryCreateInstanceByName "CFApplication" input
  cfApplicationNext input

-- cfApplicationNext — the PURE behavior decision (no capture). `if` is lazy, so
-- the regular branch returns the bare ack WITHOUT evaluating cfInstantLink (the
-- dispatch arm) — this helper's regular path is in-process testable. The instant
-- arm constructs a Link typed value whose view (a 'Continue →' anchor) is the
-- next screen.
cfApplicationNext : {} -> {}
cfApplicationNext input =
  if isInstant input
  then Link { url = cfInstantLink input, label = Nothing }
  else {}

-- isInstant — the dissolved `$form.application_type == "instant"` predicate, now
-- an ordinary body `if` condition (no std:evalExpr, no OnSubmitRule.if).
isInstant : {} -> Boolean
isInstant input = eq input.application_type "instant"

-- cfInstantLink — the dissolved CreatePaymentLink arm: dispatch create_payment_link
-- (plan cf_instant) and read the link url off the ActionResult. The SAME
-- machinery forms/submit.fenel's createPaymentLinkResp used, relocated here.
cfInstantLink : {} -> String
cfInstantLink input =
  let params = { profileId = Nothing, planSlug = "cf_instant", stepSlug = Nothing }
  let result = dispatchAction "create_payment_link" params
  result.data.url
