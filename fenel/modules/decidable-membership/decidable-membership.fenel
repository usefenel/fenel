-- =========================================================================
-- module set where — Decidable Membership: per-SetExpr-shape decision
-- procedures (contains / decideSubset / decideDisjoint / decideEmpty) + the
-- four polymorphic orchestrators that dispatch on a SetExpr's structural shape.
--
-- module-substrate Phase 3s (2026-06-01) — the DECLARATIVE HALF of the
-- decidable-membership migration. The ~520-LOC `defineFunction` spec wrapper
-- in `engine/src/modules/decidable-membership.ts` (the containsFn / subsetFn /
-- disjointFn / emptyFn factories + the _dmPolymorphic / _dmDefined arrays) is
-- RETIRED in favour of this source (48 sigs + facet directives) + a thin seam
-- that loads it, merges the `instances.fenel` DecidableMembership sidecar, and
-- wires the natives.
--
-- THE NATIVES ARE NOT A PURE-LOGIC PORT (depth-read finding — Surprise #47).
-- The 3r tier-reorder premise was "3s builds the Fenel contains / SetExpr-ADT
-- surface; aggregable's natives ride on it." But that surface ALREADY EXISTS:
-- the recursive decision procedures (setAlgebraContains / setAlgebraDecideEmpty
-- / setAlgebraIsDisjoint / setAlgebraIsSubset + the interval / enum / bound
-- algebra) are ALREADY Fenel-bodied in
-- `fenel/modules/engine/set-algebra-deciders.fenel` (built by the SEPARATE
-- engine-substrate workstream, Phase 7b/7c). The `set-algebra.ts` per-shape
-- impls + top-level dispatchers (`contains` / `isSubset` / `isDisjoint` /
-- `decideEmpty`) are now thin shims that `require("./engine-bodies-dispatch")`
-- and call the dispatched Fenel bodies. So this module's `dmNatives` are NOT
-- pure-logic reimplementations to port — they are the registry-facing
-- MARSHALLING-BOUNDARY adapters into those dispatchers (the same
-- engine-bodies-dispatch boundary that marshals SetExpr -> SetExprAdt and
-- pre-computes the evaluator-dependent opaque arms — $where / $named / $pattern
-- — which are carved out to stay TS forever). A marshalling boundary is no
-- more an "ffi/ leaf" than it is a pure-logic body: it stays as `nativeImpls`
-- in the seam (NO `ffi/` leaf — not host-IO; NO Fenel body — the pure logic
-- lives in set-algebra-deciders.fenel already). See the roadmap 3s notes.
--
-- The 48 fns are authored as bodyless `@native` FOREIGN DECLARATIONS carrying
-- their exact sigs + identity facets. The header is `module set where` — the
-- legacy id-prefix is `set:` (NOT `decidable-membership:` — the module name
-- and its id-namespace have always diverged; the hyphenated dir-name can't be
-- a header ident anyway). Keeping `set:` -> byte-identical fn ids (the
-- DecidableMembership instances' method values point at `set:setIntervalContains`
-- etc.) -> zero boot-list edits. `@category "set-algebra"` is KEPT (the
-- read-time derived category from the `set:` prefix would be `set`, NOT
-- `set-algebra`; the 3p `proxyLinks` precedent keeps `@category` when prefix
-- != stored category; Categorizable is audit-law-neutral). The
-- DecidableMembership dispatch instances stay in their `instances.fenel`
-- sidecar (already Fenel-authored).
-- =========================================================================

module set where

@native
@label "Contains (polymorphic)"
@description "Polymorphic membership test for any SetExpr. Inspects the structural discriminator (`$enum` / `$interval` / `$pattern` / …), resolves the per-shape DecidableMembership.contains impl through the same shape-table lookup the typeclass registry uses, and dispatches. Tri-state return (`Just True` / `Just False` / `Nothing`). Phase 8 surfaces this so the DecidableMembership laws — which reference `{call: [\"set:contains\", …]}` — become checkable end-to-end."
@category "set-algebra"
@tags "set-algebra" "decidable-membership" "contains" "polymorphic"
contains : (set: SetExpr, value: Any) -> Maybe Boolean

@native
@label "Decide Subset (polymorphic)"
@description "Polymorphic subset decision: `a ⊆ b` for arbitrary SetExpr shapes. Dispatches on the left-hand shape; combinators on the right side (`$union` / `$intersect` / `$where`) are handled by the per-shape impls' shared tail rules."
@category "set-algebra"
@tags "set-algebra" "decidable-membership" "subset" "polymorphic"
decideSubset : (a: SetExpr, b: SetExpr) -> Maybe Boolean

@native
@label "Decide Disjoint (polymorphic)"
@description "Polymorphic disjointness decision: `a ∩ b = ∅` for arbitrary SetExpr shapes. Symmetric: tries the LEFT shape's impl first, then RIGHT (so rules like \"$pattern vs numeric interval are disjoint\" fire from whichever side the pattern is on)."
@category "set-algebra"
@tags "set-algebra" "decidable-membership" "disjoint" "polymorphic"
decideDisjoint : (a: SetExpr, b: SetExpr) -> Maybe Boolean

@native
@label "Decide Empty (polymorphic)"
@description "Polymorphic emptiness decision: is the set provably empty? Dispatches on the SetExpr's structural shape. Conservative — opaque `$where` predicates return `Nothing` (the structural algebra can't inspect them)."
@category "set-algebra"
@tags "set-algebra" "decidable-membership" "empty" "polymorphic"
decideEmpty : (set: SetExpr) -> Maybe Boolean

@native
@label "Witness (polymorphic)"
@description "Polymorphic witness SYNTHESIS for any SetExpr — the constructive dual of decideEmpty (decide-substrate Phase 1 Stage B): `Just w` exhibits a member (proving non-emptiness constructively); `Nothing` = no canonical witness (empty, out-of-fragment, or no attained bound — the ℝ honesty fence). Marshals to the canonical `Se*` and dispatches the ONE `engine:inhabit` judgment core (inhabit.fenel), which case-cascades on the shape `$tag`: enum ⇒ first value; interval ⇒ an inclusive bound; intersect ⇒ the tightened-interval fold; union ⇒ first witnessing child. The DecidableMembership `witness` method's target for every shape (the per-shape fnId face is the Phase-3 tail)."
@category "set-algebra"
@tags "set-algebra" "decidable-membership" "witness" "inhabit" "polymorphic" "decide-substrate"
witness : (set: SetExpr) -> Maybe Any

@native
@label "Enumerate (polymorphic)"
@description "Polymorphic finite-extension ENUMERATION for any SetExpr (decide-substrate Phase 1 Stage B): `Just xs` = the COMPLETE, exact, deduped finite extension; `Just []` = provably empty (the load-bearing `Just [] ≠ Nothing` split); `Nothing` = not finitely enumerable (intervals without a base type, `$where`, complements). Marshals to the canonical `Se*` and dispatches `engine:enumerateSet` (enumerate.fenel). The DecidableMembership `enumerate` method's target for every shape (the typed interval de-fence stays `enumerableSet`-level — it needs the base type threaded, the Phase-3 tail)."
@category "set-algebra"
@tags "set-algebra" "decidable-membership" "enumerate" "polymorphic" "decide-substrate"
enumerate : (set: SetExpr) -> Maybe (List Any)

@label "Witness soundness harness"
@description "The decidableMembershipWitnessSoundness law's decidable property, Fenel-bodied (decide-substrate Phase 1 Stage B): `witness(s) = Just w ⇒ {w} ⊆ s ≠ Just False` — a synthesized witness must membership-check in its own set, phrased through the kernel's membership-as-singleton-subset face (`decideSubset (SeEnum [w]) s` — the `{v} ⊆ t` judgment `design/deciding.md` names; bare `contains` is Containable's dispatch-method name, so the subset face is also the collision-free spelling). Nothing witness (no canonical inhabitant) ⇒ vacuously true; an undecided subset (Nothing) is not a refutation ⇒ true; `Just False` ⇒ the law refutes. The law's `property` is one call to this harness per sample (the trusted-law-harness pattern, Fenel-first)."
@category "set-algebra"
@tags "set-algebra" "decidable-membership" "witness" "law" "decide-substrate"
witnessSound : (set: SetExpr) -> Boolean
witnessSound set =
  case witness set of
    Nothing -> true
    Just w ->
      -- (the singleton is let-bound: a BARE application as a named-field
      -- construct value — `SeEnum { values = appendItem w [] }` — is a known
      -- Fenel-parser regroup divergence (parser-substrate P4 class); the
      -- let-bound spelling parses identically on both parsers, keeping this
      -- file OFF the corpus-parity fence list)
      let ws = appendItem w []
      case decideSubset (SeEnum { values = ws }) set of
        Nothing -> true
        Just b -> b

@native
@label "All Contains"
@description "Per-shape DecidableMembership contains procedure for the `All` SetExpr constructor. Returns `Just True` if the value is in the set, `Just False` if it's provably out, or `Nothing` when a compound child couldn't be decided. Backs `DecidableMembership.contains` dispatch for this shape."
@category "set-algebra"
@tags "set-algebra" "decidable-membership" "contains" "All"
setAllContains : (set: SetExpr, value: Any) -> Maybe Boolean

