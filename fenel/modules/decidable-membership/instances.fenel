-- DecidableMembership typeclass instances — Fenel-authored typed values
-- (Phase 3.1 of typeclass-substrate-completion, 2026-05-28).
--
-- One instance per SetExpr shape — each keys the contains / decideSubset /
-- decideDisjoint / decideEmpty decision procedures off the set-shape tag
-- (args[0] = `Set<Shape>`). Previously generated by the `dmInstance(shape)`
-- TS factory; the 11 entries are written out explicitly here so the Fenel
-- value-decl is the authoring surface. `loadFenelModule` projects to
-- `SpecInstance { typeName = "DecidableMembership", args, methods, label }`.
-- Phase 3.2 (2026-05-29) restored the top-level `label` via the loader's
-- `label` method-field lift (byte-identical to the original factory's
-- `${shape} Decidable Membership`; dev-facing string, unconsumed by dispatch).
--
-- decide-substrate Phase 1 Stage B — the family WIDENING: every instance
-- gains `witness` (the constructive dual of decideEmpty — a Just w proves
-- non-emptiness by exhibition) + `enumerate` (the complete finite extension,
-- `Just [] ≠ Nothing`).
--
-- decide-substrate Phase 3 (the theory-family completion tail) — THE PER-SHAPE
-- FACES. The Stage-B stopgap pointed all 11 `witness`/`enumerate` at the ONE
-- polymorphic pair (`set:witness`/`set:enumerate`); each instance now names its
-- OWN per-shape witness/enumerate procedure — the arms EXTRACTED from the
-- inhabit / enumerateSet cascades, which became thin `seTag` dispatchers over
-- the family. FEWER honest faces over 22 forced ones: the real synthesis
-- procedures (Enum / Interval / Intersect / Union witness; Enum / None / Union /
-- Intersect enumerate) each get a face; the no-procedure shapes share ONE honest
-- face (`seWitnessNone` for the witness-less shapes — SIX of them since
-- signature-substrate slice 3jw moved Named to `seWitnessRef`; `seEnumOpaque` for the
-- six non-enumerable ones; `seEnumNone` = the load-bearing `Just []` of the
-- empty set). The faces live in the ENGINE module (WITH the inhabit / interval
-- machinery they call — no cross-module bare-name coupling), so the instances
-- name `engine` functions (a flagged brief-namespace divergence: the brief
-- guessed `set:*` mints; the sound choice co-locates the procedure with its
-- machinery). The polymorphic `set:witness` /
-- `set:enumerate` stay the DISPATCH ENTRY (the widened class methods' face +
-- the `dispatchedInhabit` / `dispatchedEnumerateSet` engine-fnId adapters);
-- class-method dispatch and `engine:inhabit` converge on the SAME per-shape
-- faces. The decidableMembershipWitnessSoundness law rides the same
-- sample-discharge route via the set:witnessSound harness (which calls the
-- polymorphic `witness` — now per-shape-dispatched).
--
-- modules-as-values Phase 2c (2026-09-25) — each method value is a qualified
-- reference to the procedure itself (`contains = set.setAllContains`), naming
-- the function its old id string named. The class types every method over its
-- general input (`contains : (SetExpr, Any) -> Maybe Boolean`), so a
-- shape-specific procedure given a set of another shape answers `Nothing`. The
-- `engine` faces resolve where the engine module is loaded (the engine
-- harness); the system registry shows them as stored.

dmInstanceAll : DecidableMembership SetAll
dmInstanceAll = DecidableMembership { contains = set.setAllContains, decideSubset = set.setAllDecideSubset, decideDisjoint = set.setAllDecideDisjoint, decideEmpty = set.setAllDecideEmpty, witness = engine.seWitnessNone, enumerate = engine.seEnumOpaque, label = "All Decidable Membership" }

dmInstanceNone : DecidableMembership SetNone
dmInstanceNone = DecidableMembership { contains = set.setNoneContains, decideSubset = set.setNoneDecideSubset, decideDisjoint = set.setNoneDecideDisjoint, decideEmpty = set.setNoneDecideEmpty, witness = engine.seWitnessNone, enumerate = engine.seEnumNone, label = "None Decidable Membership" }

dmInstanceEnum : DecidableMembership SetEnum
dmInstanceEnum = DecidableMembership { contains = set.setEnumContains, decideSubset = set.setEnumDecideSubset, decideDisjoint = set.setEnumDecideDisjoint, decideEmpty = set.setEnumDecideEmpty, witness = engine.seWitnessEnum, enumerate = engine.seEnumEnum, label = "Enum Decidable Membership" }

dmInstanceInterval : DecidableMembership SetInterval
dmInstanceInterval = DecidableMembership { contains = set.setIntervalContains, decideSubset = set.setIntervalDecideSubset, decideDisjoint = set.setIntervalDecideDisjoint, decideEmpty = set.setIntervalDecideEmpty, witness = engine.seWitnessInterval, enumerate = engine.seEnumOpaque, label = "Interval Decidable Membership" }

dmInstanceNamed : DecidableMembership SetNamed
-- signature-substrate slice 3jw §2 — `witness` was `engine:seWitnessNone` while
-- `decideEmpty` was the real `set:setNamedDecideEmpty`: the EXACT
-- emptiness/inhabitation asymmetry this slice closes. Emptiness answered
-- "decidably NONempty" for ten names while inhabitation refused to exhibit an
-- inhabitant for any of them — a missing constructive dual, not a fence.
-- The other six `seWitnessNone` rows (All / None / Pattern / Where /
-- Complement / Rigid) are DELIBERATELY untouched.
dmInstanceNamed = DecidableMembership { contains = set.setNamedContains, decideSubset = set.setNamedDecideSubset, decideDisjoint = set.setNamedDecideDisjoint, decideEmpty = set.setNamedDecideEmpty, witness = engine.seWitnessRef, enumerate = engine.seEnumOpaque, label = "Named Decidable Membership" }

dmInstancePattern : DecidableMembership SetPattern
dmInstancePattern = DecidableMembership { contains = set.setPatternContains, decideSubset = set.setPatternDecideSubset, decideDisjoint = set.setPatternDecideDisjoint, decideEmpty = set.setPatternDecideEmpty, witness = engine.seWitnessNone, enumerate = engine.seEnumOpaque, label = "Pattern Decidable Membership" }

dmInstanceWhere : DecidableMembership SetWhere
dmInstanceWhere = DecidableMembership { contains = set.setWhereContains, decideSubset = set.setWhereDecideSubset, decideDisjoint = set.setWhereDecideDisjoint, decideEmpty = set.setWhereDecideEmpty, witness = engine.seWitnessNone, enumerate = engine.seEnumOpaque, label = "Where Decidable Membership" }

dmInstanceUnion : DecidableMembership SetUnion
dmInstanceUnion = DecidableMembership { contains = set.setUnionContains, decideSubset = set.setUnionDecideSubset, decideDisjoint = set.setUnionDecideDisjoint, decideEmpty = set.setUnionDecideEmpty, witness = engine.seWitnessUnion, enumerate = engine.seEnumUnion, label = "Union Decidable Membership" }

dmInstanceIntersect : DecidableMembership SetIntersect
dmInstanceIntersect = DecidableMembership { contains = set.setIntersectContains, decideSubset = set.setIntersectDecideSubset, decideDisjoint = set.setIntersectDecideDisjoint, decideEmpty = set.setIntersectDecideEmpty, witness = engine.seWitnessIntersect, enumerate = engine.seEnumIntersect, label = "Intersect Decidable Membership" }

dmInstanceDiff : DecidableMembership SetDiff
dmInstanceDiff = DecidableMembership { contains = set.setDiffContains, decideSubset = set.setDiffDecideSubset, decideDisjoint = set.setDiffDecideDisjoint, decideEmpty = set.setDiffDecideEmpty, witness = engine.seWitnessDiff, enumerate = engine.seEnumOpaque, label = "Diff Decidable Membership" }

dmInstanceComplement : DecidableMembership SetComplement
dmInstanceComplement = DecidableMembership { contains = set.setComplementContains, decideSubset = set.setComplementDecideSubset, decideDisjoint = set.setComplementDecideDisjoint, decideEmpty = set.setComplementDecideEmpty, witness = engine.seWitnessNone, enumerate = engine.seEnumOpaque, label = "Complement Decidable Membership" }

-- decide-substrate Phase 8μ.1a/1b/8λ.1 — the datatype / fixpoint / exponential
-- SET-former shapes join the DecidableMembership family (the carried §6 bundle +
-- SetArrow). The four decision methods point at the POLYMORPHIC dispatchers
-- (`set:contains`/`set:decideSubset`/`set:decideDisjoint`/`set:decideEmpty`) — the
-- top-level `set-algebra.ts` shims that route via the recursive decider cascades
-- (setAlgebra{Contains,IsSubset,IsDisjoint,DecideEmpty}), whose SeCtor / SeMu /
-- SeArrow arms already ship. No new per-shape `set:*` wrappers (the engine faces
-- cover every live path — the 8μ.3 §6-skip finding); `witness` names each theory's
-- OWN per-shape face (seWitnessCtor / seWitnessMu / seWitnessArrow — Phase-3
-- engine-fnId pattern), `enumerate` the honest shared non-enumerable face
-- (seEnumOpaque — a bare SetExpr of these shapes carries no finite extension).

dmInstanceCtor : DecidableMembership SetCtor
dmInstanceCtor = DecidableMembership { contains = set.contains, decideSubset = set.decideSubset, decideDisjoint = set.decideDisjoint, decideEmpty = set.decideEmpty, witness = engine.seWitnessCtor, enumerate = engine.seEnumOpaque, label = "Ctor Decidable Membership" }

dmInstanceMu : DecidableMembership SetMu
dmInstanceMu = DecidableMembership { contains = set.contains, decideSubset = set.decideSubset, decideDisjoint = set.decideDisjoint, decideEmpty = set.decideEmpty, witness = engine.seWitnessMu, enumerate = engine.seEnumOpaque, label = "Mu Decidable Membership" }

dmInstanceArrow : DecidableMembership SetArrow
dmInstanceArrow = DecidableMembership { contains = set.contains, decideSubset = set.decideSubset, decideDisjoint = set.decideDisjoint, decideEmpty = set.decideEmpty, witness = engine.seWitnessArrow, enumerate = engine.seEnumOpaque, label = "Arrow Decidable Membership" }

-- signature-substrate Phase 4 slice 3a — the VALIDATION-ONLY rigid atom joins
-- the family so no shape is missing a row. Every method is an ABSTENTION by
-- construction: the four decisions go through the polymorphic dispatchers,
-- whose recursive deciders now carry explicit `SeRigid` arms answering Nothing
-- for membership, emptiness, and disjointness (and Just true ONLY for κ ⊆ κ,
-- ∅ ⊆ κ, κ ⊆ ⊤); `witness` is the honest no-witness face (a ground witness
-- would not survive κ := ∅); `enumerate` is the honest non-enumerable face
-- (`seEnumOpaque` ⇒ Nothing, deliberately NOT `seEnumNone`'s `Just []`, which
-- would claim a complete empty extension and re-open the vacuity trap).

dmInstanceRigid : DecidableMembership SetRigid
dmInstanceRigid = DecidableMembership { contains = set.contains, decideSubset = set.decideSubset, decideDisjoint = set.decideDisjoint, decideEmpty = set.decideEmpty, witness = engine.seWitnessNone, enumerate = engine.seEnumOpaque, label = "Rigid Decidable Membership" }
