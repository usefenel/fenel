module locale where

-- locale:canonical — resolve a LocaleString to its plain String view.
--
-- Plain String passes through verbatim. A locale-map (a record with one or
-- more locale-keyed entries) returns the FIRST key's value — the canonical-
-- locale convention (first key wins). An empty map yields "".
--
-- Mirrors implementations/typescript/engine/src/locale.ts:canonical (line 201):
--     if (typeof value === "string") return value;
--     const keys = Object.keys(value);
--     return keys.length > 0 ? value[keys[0]!]! : "";
--
-- Composed from std fns: `isString` to discriminate the String / record cases,
-- `entries` to lift a record to `List {key, value}` (returns `[]` for null /
-- non-object inputs — same defensive shape canonicalNative used to handle),
-- `head` to pick the first entry as `Maybe {key, value}`.
--
-- Phase 3v.4d (module-substrate): the FIRST non-body-neutral 3v rung. Retires
-- canonicalNative from engine.ts's engineNativesCtx; the body becomes the sole
-- implementation. Lives in `module locale where` (new home for the locale-tier
-- substrate — future format / negotiate / fallback-chain ports land here).
canonical : (value: LocaleString) -> String
canonical value =
  if isString value
    then value
    else case head (entries value) of
      Just entry -> entry.value
      Nothing -> ""

-- A reader's language selects a string projection; the multilingual value
-- itself remains unchanged. Missing translations fall back to English, then
-- to the same first-entry convention used by canonical.
@label "Text in a language"
@description "Resolve an exact language, its base language, English, then the first available translation. Plain strings pass through and empty translations remain empty."
localize : (value: LocaleString) -> (language: String) -> String
localize value language =
  if isString value then value
  else case translation value language of
    Just text -> text
    Nothing ->
      let base = case head (split language "-") of
        Just text -> text
        Nothing -> language
      case translation value base of
        Just text -> text
        Nothing -> case translation value "en" of
          Just text -> text
          Nothing -> locale.canonical value

@description "Read one exact translation without changing its LocaleString. Nothing means that language is absent; an empty translation is Just an empty string."
translation : (value: LocaleString) -> (language: String) -> Maybe String
translation value language =
  case find (\entry -> eq entry.key language) (entries value) of
    Just entry -> Just entry.value
    Nothing -> Nothing
