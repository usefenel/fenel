-- =========================================================================
-- compile-js — bodyless @native sigs for the seven JS-target pipeline steps.
--
-- module-substrate Phase 3v.5 (2026-06-01) — the carbon-copy 3v rung that
-- collapses the per-target TS `defineFunction` spec lists into a Fenel-
-- authored sig surface. The TS impls (step natives in
-- engine/src/modules/compile-js.ts) STAY — they're the irreducible host
-- leaves that walk the typed IR through engine-bodies-dispatch.ts. This
-- file is the FENEL-AUTHORED sig surface; the union (types.fenel +
-- instances.fenel + sigs.fenel) groups all three under the compile-js
-- module name supplied by the loader arg. Every @label / @description /
-- @category / @tags directive mirrors the retired TS second-arg facet
-- record byte-identically — the migration is sig-source-only, the
-- visible facets do not change.
--
-- The 7 sigs (in spec-list order, preserved for stable instance ordering):
--   normaliseToCore       — Lower CompileSource into Core IR
--   makeEffectsExplicit   — Lift effect-dispatch sites into structured form
--   makeClosuresExplicit  — Closure-convert lambdas (captures)
--   emitJs                — Lower ClosuresExplicit into JsAst
--   serializeJsModule     — Iso String JsModule encode side
--   deserializeJsModule   — Iso String JsModule decode side (Phase 5 stub)
--   compileFenelToJs      — Top-level pipeline (CompileSource into JsModule)
--
-- Every codeName equals def name (no @codeName directive) so rekeyNativesById
-- under prefix compile-js produces ids byte-identical to the retired TS
-- specs (compile-js prefix + the def name).
--
-- No `module ... where` header — `compile-` contains a hyphen which the
-- ident lexer splits on, so the header cannot carry a hyphenated module
-- name. The loader name-arg (set by the compile-js.ts seam) supplies the
-- module identity instead; the three files share that arg and union under
-- the same group.
-- =========================================================================

@native
@label "Lower → Core"
@description "Lower a CompileSource to a CoreProgram through the shared Fenel JSON-Logic adapter. Preserves identity-bearing parameter and constructor slots, rejects ambiguous unscoped constructor metadata, resolves defining-module lexical calls to exact canonical fnIds, and surfaces unrecognised shapes as structured CompileError.Unsupported."
@category "compile-js"
@tags "compile" "lowering" "ir"
normaliseToCore : (source: CompileSource) -> Result CompileError CoreProgram

@native
@label "Lower → EffectsExplicit"
@description "Make the effect-dispatch sites in a CoreProgram explicit. Phase 15: recognises `$effect:<Class>:<method>` sentinel fnIds at CoreCall sites and populates the `effects` inventory + `handlerSites` list. Per-target lowering (`emitJs`) routes them through `$fenel.$effect.<Class>.<method>(...)` member access; the host populates the `$fenel.$effect` namespace at instantiation time by walking the typeclass instance dispatch scope."
@category "compile-js"
@tags "compile" "lowering" "ir" "effects"
makeEffectsExplicit : (core: CoreProgram) -> Result CompileError EffectsExplicitProgram

@native
@label "Lower → ClosuresExplicit"
@description "Closure-convert every lambda in the program body: walk the IR, compute the free-variable set of each lambda, materialise it as the closure's `captures` list. JS-target ignores `captures` (JS handles lexical closure capture natively); other targets (Wasm / native) use the list to lay out closure records."
@category "compile-js"
@tags "compile" "lowering" "ir" "closures"
makeClosuresExplicit : (ee: EffectsExplicitProgram) -> Result CompileError ClosuresExplicitProgram

@native
@label "Lower → JsAst"
@description "Lower a ClosuresExplicitProgram to JsAst. Maps the Fenel std-op set to direct JS operators (`add` → `+`, `eq` → `===`, …) where the semantics align; routes other calls through a `$fenel.<fnId>(…)` runtime helper namespace. Effect-dispatch sentinels (`$effect:<Class>:<method>` — Phase 15) lower to `$fenel.$effect.<Class>.<method>(...)` member access; the host populates the `$fenel.$effect` namespace at instantiation time by walking the typeclass instance dispatch scope (`resolveEffect` — same walk Phase 11's evaluator uses at every `withInstance` call site). Pattern matching emits chained ternaries over `$tag` and `_<i>` field access."
@category "compile-js"
@tags "compile" "lowering" "ir" "js"
emitJs : (ce: ClosuresExplicitProgram) -> Result CompileError JsModule

@native
@label "Serialize JsModule"
@description "Serialize a JsModule to a JS source string. The encode side of `Iso<String, JsModule>`. Aggressively parenthesises sub-expressions to avoid precedence ambiguities; emits arrow-function shapes for closures and IIFE shapes for let-bindings. The output is `eval`-able / dynamic-`import`-able as long as the host provides a `$fenel` namespace with the runtime helpers the program references."
@category "compile-js"
@tags "compile" "serialize" "js" "codec"
serializeJsModule : (module: JsModule) -> Result String String

@native
@label "Deserialize JsModule (placeholder)"
@description "The decode side of `Iso<String, JsModule>`. Phase 5 stub — always returns Err. A real parser lands when a use case demands round-tripping compiled JS back into the typed IR (e.g. for further rewriting / fusion / auditing)."
@category "compile-js"
@tags "compile" "deserialize" "js" "codec" "placeholder"
deserializeJsModule : (encoded: String) -> Result String JsModule

@native
@label "Compile Fenel → JS"
@description "The top-level CompileJs pipeline: CompileSource → CoreProgram → EffectsExplicitProgram → ClosuresExplicitProgram → JsModule. Threaded through Result so the first failure short-circuits; the output is the typed JS AST. Pair with `serializeJsModule` to obtain the JS source string."
@category "compile-js"
@tags "compile" "pipeline" "js"
compileFenelToJs : (source: CompileSource) -> Result CompileError JsModule
