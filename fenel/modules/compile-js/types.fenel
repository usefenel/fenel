-- =========================================================================
-- compile-js target AST surface — canonical declaration site for every
-- entity in the JS-target compilation pipeline's typed IR.
--
-- Phase 4j of ts-elimination: consolidates the per-target deep AST ADTs
-- that Phase 4h's program-envelope tier had to leave as lazy `a` field
-- refs. Pre-4j these entities were declared inside
-- `fenel/modules/engine/emit-js.fenel` (the JS-emitter pass body); only
-- `JsModule` was dual-declared between the body file and this types file
-- (Phase 4h's program-envelope tier authored the JsModule shape here while
-- emit-js.fenel kept its own copy — shapes matched, dedup silently inert).
-- Post-4j this file is the single canonical declaration site for the full
-- JS-target AST surface; emit-js.fenel keeps its function bodies only.
--
-- Provenance: mirrors `implementations/typescript/engine/src/ir/js-ast.ts`
-- field-for-field. Recursive target nodes and collection payloads are named
-- exactly; only the literal payload and the program entry's deliberately mixed
-- expression/loop shape remain explicit dynamic boundaries.
-- =========================================================================

-- JsAst — typed JS-shaped IR. Mirrors ir/js-ast.ts field-for-field except
-- where noted. The 12-case variant covers every JS construct the emitter
-- produces. Note JsArray uses `elements` (not `items`) to byte-equal the
-- TS oracle.
JsAst =
  JsLit value: Any
  | JsVar name: String
  | JsMember object: JsAst property: String
  | JsCall callee: JsAst args: List JsAst
  | JsArrow params: List String captures: List String body: JsAst
  | JsLet bindings: List ({ name: String, value: JsAst }) body: JsAst
  | JsTernary cond: JsAst then: JsAst else: JsAst
  | JsBinOp op: String left: JsAst right: JsAst
  | JsUnaryOp op: String arg: JsAst
  | JsObject fields: List ({ key: String, value: JsAst })
  | JsArray elements: List JsAst
  | JsSequence exprs: List JsAst

-- JsStmt — statement-position ADT for the self-tail-call → while-loop
-- emission (parser-substrate Phase 6b2, lever B). DELIBERATELY SEPARATE
-- from JsAst: statements never appear in expression position by
-- construction, so the 12-arm expression walkers (serializeAst,
-- referencesName) stay total + untouched. A self-tail-recursive fn's
-- body lowers to a `List JsStmt` spine (the `while (true)` loop body);
-- tail self-calls become temp-first reassign + JsSContinue, everything
-- else returns. The `then` / `else` of JsSIf and the `body` of JsSBlock
-- are themselves `List JsStmt` (the inner-block frames). No TS consumes
-- these shapes (ir/js-ast.ts is NOT edited).
JsStmt =
  JsSConst name: String value: JsAst        -- const <name> = <expr>;
  | JsSAssign name: String value: JsAst     -- <name> = <expr>;
  | JsSExpr value: JsAst                    -- <expr>;            (non-tail sequence element)
  | JsSIf cond: JsAst then: List JsStmt else: List JsStmt -- if (<c>) { <then> } else { <else> }
  | JsSBlock body: List JsStmt              -- { <stmts> }        (the shadow-fallback frame)
  | JsSReturn value: JsAst                  -- return <expr>;
  | JsSContinue                         -- continue;

-- JsModule — program-level envelope. Mirrors ir/js-ast.ts:JsModule.
-- `name` flows through unchanged from the input ClosuresExplicitProgram;
-- `entry` is a JsArrow wrapping the lowered body with the function's
-- formal params — OR, for a self-tail-recursive fn (Phase 6b2), a
-- JsLoopFn carrying the lowered statement spine instead.
JsModule = JsModule name: String fieldSlots: List CompileFieldSlot entry: Any

-- JsLoopFn — the qualifying-fn entry shape: a block-bodied arrow
-- `((p1, …, pn) => { while (true) { <stmts> } })`. `body` is a
-- `List JsStmt`. Lives in the `JsModule.entry` slot alongside JsArrow
-- (serializeJsModuleEntry dispatches on the entry's tag). Phase 6b2.
JsLoopFn = JsLoopFn params: List String captures: List String body: List JsStmt

-- CallMapping — Fenel encoding of the TS oracle's CALL_MAPPING table.
-- Each known fnId maps to one of four shapes; everything else falls
-- through to the default `$fenel.<fnId>(...)` runtime call. Using a
-- dedicated ADT (rather than `Maybe<{kind, op}>`) keeps the per-case
-- field set typed and the dispatch in `emitCall` exhaustive.
CallMapping =
  CMBinOp op: String
  | CMUnary op: String
  | CMConcat
  | CMNoMapping
