-- =========================================================================
-- module control where — control-flow wrappers as higher-order functions:
-- retry / timeout / error-handling / structured concurrency / iteration.
--
-- module-substrate Phase 3q (2026-05-31) — `control` is the other half of
-- the "signature-only pair" Surprise #30 DEFERRED at Phase 3k. It is a PLAIN
-- function module (no capability / creds / providers / instances / entities)
-- whose ~255-LOC TS `defineFunction` spec wrapper
-- (`engine/src/modules/control.ts`) is RETIRED in favour of this
-- `module control where` source + a thin seam.
--
-- ALL 12 functions are runtime PRIMITIVES — each takes a function-NAME String
-- (+ wrapper-specific params) and re-enters the evaluator. They are bodyless
-- `@native` FOREIGN DECLARATIONS backed by the evaluator's IO handlers in
-- `runtime/src/evaluator.ts` (NO `nativeImpls` map, NO `ffi/` leaf; the
-- handlers stay as-is). The wrapped function's EFFECT is dispatched at
-- runtime, so the wrappers themselves carry NO `requires` (parity).
--
-- THE FIRST defaultable-subsumption DEFAULT-DROP. The retired spec attached
-- per-param `default` values: `maxAttempts = 3`, `backoffMs = 1000`,
-- `concurrency = Infinity`, `maxIterations = 1000`, `level = "info"`,
-- `fallback = undefined`, and the ubiquitous `args = {}`. A per-fn audit of
-- the native handlers confirmed EVERY default is RUNTIME-DEAD — each native
-- owns its own fallback (`params.maxAttempts ?? 3`, `params.args ?? {}`,
-- `params.concurrency || Infinity`, `params.maxIterations ?? 1000`, …). They
-- were editor-prefill only, so they are simply DROPPED. NO `@default`
-- directive (the guardrail; `feedback_fielddef_default_is_antipattern`). This
-- establishes the clean-drop pattern `dashboard`/`notion` + the
-- `defaultable-subsumption` arc inherit.
--
-- Param LABELS also drop (in-bar, Surprise #30 — no directive). The `args`
-- param is `Maybe ({})` — the parens are REQUIRED (`Maybe {}` mis-parses;
-- the 3n/3p gotcha), and it recurs on every fn. NO `@category` (the
-- `control` category derives at read time from the `control:` id prefix,
-- Phase 3j). The header keeps the LEGACY lowercase `control:` id-prefix.
-- =========================================================================

module control where

-- ----- Wrappers ------------------------------------------------------------

-- retry — call a function, retrying on failure with optional backoff.
@native
@label "Retry"
@description "Call a function, retrying on failure up to maxAttempts times with optional backoff"
@tags "wrapper" "error-handling" "resilience"
retry : (fn: String, args: Maybe ({}), maxAttempts: Maybe Number, backoffMs: Maybe Number) -> String

-- with_timeout — call a function with a time limit, falling back if exceeded.
@native
@label "Timeout"
@description "Call a function with a time limit. Returns fallback if duration exceeded."
@tags "wrapper" "resilience" "time"
with_timeout : (fn: String, args: Maybe ({}), duration: String, fallback: Maybe String) -> String

-- on_error — call a function, catching errors and returning fallback.
@native
@label "On Error"
@description "Call a function, catching errors and returning fallback"
@tags "wrapper" "error-handling"
on_error : (fn: String, args: Maybe ({}), fallback: Maybe String) -> String

-- bracket — acquire, use, release regardless of success/failure.
@native
@label "Bracket"
@description "Acquire resource, use it, release regardless of success/failure"
@tags "wrapper" "resource-management"
bracket : (acquire: String, use: String, release: String, args: Maybe ({})) -> String

-- parallel — run multiple functions concurrently, return all results.
@native
@label "Parallel"
@description "Run multiple functions concurrently, return all results"
@tags "wrapper" "concurrency"
parallel : (fns: List String, args: Maybe ({})) -> List String

-- race — run multiple functions concurrently, return first to complete.
@native
@label "Race"
@description "Run multiple functions concurrently, return first to complete"
@tags "wrapper" "concurrency"
race : (fns: List String, args: Maybe ({})) -> String

-- any — run multiple functions concurrently, return first successful result.
@native
@label "Any"
@description "Run multiple functions concurrently, return first successful result (ignores failures until all fail)"
@tags "wrapper" "concurrency" "resilience"
any : (fns: List String, args: Maybe ({})) -> String

-- log — call a function, logging input/output as a span.
-- resolution-substrate Phase 1b Commit 2 — codeName RENAMED `log`→`logSpan` to
-- retire the grandfathered `log` collision: bare `log` is the conventional
-- logarithm (`std:log`); this control-flow trace wrapper is reachable as
-- `logSpan` (the cross-concept homonym dissolved, the compile-llvm/sigs
-- @codeName-to-avoid-collision precedent). The def name + fnId (control:log)
-- are unchanged; only the Codeable projection moves.
@native
@codeName "logSpan"
@label "Log"
@description "Call a function, logging input/output as a span"
@tags "wrapper" "observability"
log : (fn: String, args: Maybe ({}), level: Maybe String, label: Maybe String) -> String

-- ----- Iteration -----------------------------------------------------------

-- for_each — apply a function to each element sequentially.
@native
@label "For Each"
@description "Apply a function to each element of a list sequentially"
@tags "iteration" "list"
for_each : (list: List String, fn: String, args: Maybe ({})) -> List String

-- par_map — apply a function to each element concurrently (bounded).
@native
@label "Parallel Map"
@description "Apply a function to each element concurrently with optional concurrency limit"
@tags "iteration" "list" "concurrency"
par_map : (list: List String, fn: String, concurrency: Maybe Number, args: Maybe ({})) -> List String

-- while_true — repeat a function while its result is truthy.
@native
@label "While"
@description "Repeat a function while its result is truthy"
@tags "iteration" "loop"
while_true : (fn: String, args: Maybe ({}), maxIterations: Maybe Number) -> String

-- repeat — call a function n times, collecting results.
-- resolution-substrate Phase 1b Commit 3 — codeName RENAMED `repeat`→`repeatCall`
-- to retire the grandfathered `repeat` collision: bare `repeat` is the
-- conventional string×n (`std:repeat`); this call-a-function-n-times wrapper is
-- reachable as `repeatCall` (the `logSpan` sibling, Commit 2). The def name + fnId
-- (control:repeat) are unchanged; only the Codeable projection moves.
@native
@codeName "repeatCall"
@label "Repeat"
@description "Call a function n times, collecting results"
@tags "iteration"
repeat : (n: Number, fn: String, args: Maybe ({})) -> List String
