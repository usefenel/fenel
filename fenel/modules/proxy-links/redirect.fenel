-- =========================================================================
-- Proxy-link redirect ingress.
--
-- Phase 12c-routes sub-step 2 of the ts-elimination workstream. Single
-- route GET /:accountSlug/:tag. The TS wrapper handles:
--   - proxy-link lookup via state:findProxyLinkByAccountSlugAndTag
--   - 404 short-circuit when the link doesn't exist
--   - visitor-IP extraction + hash via crypto:sha256Hex
--   - HTML template formatting (Decision R — TS wrapper formats; Fenel
--     body returns typed values; the std:escapeHtml composition runs
--     in the wrapper since the HTML template is wire-format-stable)
--
-- Body fires the click event (fire-and-forget, no trigger dispatch since
-- clicks aren't trigger sources) + returns the typed page-data the
-- wrapper formats as HTML.
--
-- module-substrate Phase 3p (2026-05-31) — the AGGREGATION-FRONTIER CLOSE.
-- This is the lone `proxyLinks` fn, lifted out of the retired `mixed-ingress`
-- bundle into its own fresh `module proxyLinks where` module (the 3n single-file
-- pattern). The header is camelCase `proxyLinks` to bake the existing
-- `proxyLinks:` id-prefix — the `proxy-links/` directory name is incidental.
-- HasStateIO is INFERRED from the appendEvent call. WRINKLE: the read-time
-- category fallback derives "proxyLinks" from the id prefix, but the stored
-- category was the hyphenated "proxy-links" — so unlike the other 4 prefixes
-- this fn KEEPS its `@category "proxy-links"` to hold display-identical parity
-- (the lone surviving @category in the dissolve).
-- =========================================================================

module proxyLinks where

-- redirectClick — GET /:accountSlug/:tag body.
-- Inputs:
--   link — resolved proxy_link record {id, accountId, tag, url, title,
--     description, image}; wrapper has already 404'd if Nothing.
--   visitorHash — sha256-hashed visitor IP (16-hex prefix); wrapper
--     extracted the header.
--   referer — Maybe<String>; the request's referer header.
-- Returns the typed page-data the wrapper renders as HTML.
@label "Redirect click"
@description "GET /:accountSlug/:tag body. The TS wrapper resolves the proxy_link via state:findProxyLinkByAccountSlugAndTag + 404s on Nothing + hashes the visitor IP via crypto:sha256Hex + extracts the referer header. Body fires the proxy_link_click appendEvent (no dispatch — clicks aren't trigger sources) + returns the typed {url, title, description, image} the wrapper formats as HTML."
@tags "proxy-link" "redirect" "route" "phase-12c"
@category "proxy-links"
redirectClick : {} -> String -> Maybe String -> {}
redirectClick link visitorHash referer =
  let clickPayload = { visitorHash = visitorHash, referrer = referer }
  let _clickEvent = appendEvent "proxy_link_click" clickPayload Nothing Nothing Nothing
  { url = link.url, title = link.title, description = link.description, image = link.image }
