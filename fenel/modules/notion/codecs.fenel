module notion where

-- =========================================================================
-- Notion wire codecs — typed encoder/decoder pairs for the Notion REST
-- API surface. Phase 11b sub-step 2a port covering §1-§7 of
-- runtime/src/handlers/notion-codec.ts:
--
--   * §2  NotionColor          (20-arm string ↔ tag lookup)
--   * §3  SortDirection / TimestampField  (2-arm string ↔ tag pairs)
--   * §4  Annotations / NotionDate        (records w/ Maybe<String> optionals)
--   * §5  Parent / CommentParent          (variant dispatch by wire `type`
--                                          OR field-presence)
--   * §6  NotionFile           (External | Uploaded by wire `type`)
--   * §7  Icon / Cover         (similar shape to NotionFile)
--
-- §1 (the basic helpers `camelToSnake` / `snakeToCamel` / `toNotionWire` /
-- `fromNotionWire`) is NOT ported in this file — those reuse the existing
-- `runtime:camelToSnake` / `runtime:snakeToCamel` / `runtime:toTelegramWire`
-- / `runtime:fromTelegramWire` from Phase 11b sub-step 1 directly via
-- lazy-require shims at notion-codec.ts. Semantic-identical transforms;
-- documenting cross-module reuse rather than duplicating the fnIds.
--
-- Recipe matches Phase 11b sub-step 1's telegram-codec port (structural
-- codec walk over CodecValue) and sub-step 3's mime.ts port (stateful
-- per-byte walk). For these per-type codecs the boundary recipe is
-- simpler: the wrapper pre-coerces the wire JS value into a clean
-- Fenel-shape record (asString / asBool / asNumberOrNull at each field;
-- Maybe<X> wrapping for optionals; pre-resolution of fallback chains
-- like `inner.expiry_time ?? v.expiry_time`); the body does the
-- variant dispatch + typed-value construction. Encoders are symmetric:
-- the body's case-of destructures the typed Fenel value and emits a
-- wire-shape record (with snake_case keys where applicable); the
-- wrapper post-walks to omit Maybe-Nothing optional fields TS-side.
--
-- All bodies live in `notion-codecs:*` ids; the published surface uses
-- `notion:*` ids via the defineFunction wrapper at
-- engine/src/modules/notion.ts (see Phase 11b sub-step 1's
-- codecs.fenel for the same loader-vs-published id split).
-- =========================================================================


-- -------------------------------------------------------------------------
-- §2. NotionColor — bare wire string ↔ NotionColor variant
--
-- TS oracle: handlers/notion-codec.ts:109 (COLOR_WIRE_TO_TAG 20-entry
-- table + reverse map). The body is a 20-arm case-of on the wire
-- string (decode) / on the variant tag (encode). The 20-arm shape is
-- verbose but matrix-visible + clearer than a generic lookup helper.
--
-- The catch-all `_ -> ColorDefault` mirrors the TS oracle's
-- `COLOR_WIRE_TO_TAG[asString(v)] ?? "ColorDefault"` fallback for
-- unknown wire strings.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeColor"
@description "Phase 11b sub-step 2a — decode a Notion wire-format color string (\"default\" / \"gray\" / \"red_background\" / …) to a NotionColor variant. 20-arm case-of on the wire string with `ColorDefault` fallback. Boundary adapter dispatched via `dispatchedDecodeColor`. Mirrors runtime/src/handlers/notion-codec.ts:138."
@tags "notion" "codec" "color" "boundary" "phase-11b"
decodeColor : (wire: String) -> NotionColor
decodeColor wire = case wire of
  "default" -> ColorDefault
  "gray" -> Gray
  "brown" -> Brown
  "orange" -> Orange
  "yellow" -> Yellow
  "green" -> Green
  "blue" -> Blue
  "purple" -> Purple
  "pink" -> Pink
  "red" -> Red
  "gray_background" -> GrayBackground
  "brown_background" -> BrownBackground
  "orange_background" -> OrangeBackground
  "yellow_background" -> YellowBackground
  "green_background" -> GreenBackground
  "blue_background" -> BlueBackground
  "purple_background" -> PurpleBackground
  "pink_background" -> PinkBackground
  "red_background" -> RedBackground
  _ -> ColorDefault

@label "notion-codec: encodeColor"
@description "Phase 11b sub-step 2a — encode a NotionColor variant to its Notion wire-format string. Inverse of decodeColor: 19-arm case-of on the variant tag (no catch-all because all variants are exhaustively named). Boundary adapter dispatched via `dispatchedEncodeColor`. Mirrors runtime/src/handlers/notion-codec.ts:143."
@tags "notion" "codec" "color" "boundary" "phase-11b"
encodeColor : (v: NotionColor) -> String
encodeColor v = case v of
  ColorDefault -> "default"
  Gray -> "gray"
  Brown -> "brown"
  Orange -> "orange"
  Yellow -> "yellow"
  Green -> "green"
  Blue -> "blue"
  Purple -> "purple"
  Pink -> "pink"
  Red -> "red"
  GrayBackground -> "gray_background"
  BrownBackground -> "brown_background"
  OrangeBackground -> "orange_background"
  YellowBackground -> "yellow_background"
  GreenBackground -> "green_background"
  BlueBackground -> "blue_background"
  PurpleBackground -> "purple_background"
  PinkBackground -> "pink_background"
  RedBackground -> "red_background"


-- -------------------------------------------------------------------------
-- §3. SortDirection / TimestampField — 2-arm string ↔ tag pairs
--
-- TS oracle: handlers/notion-codec.ts:149. Both pairs follow the same
-- shape: the wire is one of two string literals + the Fenel value is
-- one of two nullary constructors. The catch-all falls through to the
-- "first" arm (matches the TS oracle's `=== "descending" ? Descending :
-- Ascending` ternary).
-- -------------------------------------------------------------------------

@label "notion-codec: decodeSortDirection"
@description "Phase 11b sub-step 2a — decode a Notion sort-direction wire string (\"descending\" / \"ascending\") to a SortDirection variant. 2-arm case-of with `Ascending` fallback. Boundary adapter dispatched via `dispatchedDecodeSortDirection`. Mirrors runtime/src/handlers/notion-codec.ts:152."
@tags "notion" "codec" "sort" "boundary" "phase-11b"
decodeSortDirection : (wire: String) -> SortDirection
decodeSortDirection wire = case wire of
  "descending" -> Descending
  _ -> Ascending

@label "notion-codec: encodeSortDirection"
@description "Phase 11b sub-step 2a — encode a SortDirection variant to its Notion wire-format string. Inverse of decodeSortDirection. Boundary adapter dispatched via `dispatchedEncodeSortDirection`. Mirrors runtime/src/handlers/notion-codec.ts:156."
@tags "notion" "codec" "sort" "boundary" "phase-11b"
encodeSortDirection : (v: SortDirection) -> String
encodeSortDirection v = case v of
  Descending -> "descending"
  Ascending -> "ascending"

@label "notion-codec: decodeTimestampField"
@description "Phase 11b sub-step 2a — decode a Notion timestamp-field wire string (\"last_edited_time\" / \"created_time\") to a TimestampField variant. 2-arm case-of with `TimestampCreatedTime` fallback. Boundary adapter dispatched via `dispatchedDecodeTimestampField`. Mirrors runtime/src/handlers/notion-codec.ts:160."
@tags "notion" "codec" "timestamp" "boundary" "phase-11b"
decodeTimestampField : (wire: String) -> TimestampField
decodeTimestampField wire = case wire of
  "last_edited_time" -> TimestampLastEditedTime
  _ -> TimestampCreatedTime

@label "notion-codec: encodeTimestampField"
@description "Phase 11b sub-step 2a — encode a TimestampField variant to its Notion wire-format string. Inverse of decodeTimestampField. Boundary adapter dispatched via `dispatchedEncodeTimestampField`. Mirrors runtime/src/handlers/notion-codec.ts:166."
@tags "notion" "codec" "timestamp" "boundary" "phase-11b"
encodeTimestampField : (v: TimestampField) -> String
encodeTimestampField v = case v of
  TimestampLastEditedTime -> "last_edited_time"
  TimestampCreatedTime -> "created_time"


-- -------------------------------------------------------------------------
-- §4. Annotations / NotionDate — flat records
--
-- TS oracle: handlers/notion-codec.ts:170. Annotations is a flat record
-- with 5 booleans + 1 NotionColor; the body recursively calls
-- decodeColor / encodeColor for the color field. NotionDate has 1
-- String start + 2 Maybe<String> optionals (end / timeZone) — the
-- wrapper marshals Maybe wrapping at the boundary; the body just
-- shuttles fields through.
--
-- Note the snake_case field `time_zone` in the wire-shape: Fenel
-- identifiers allow `_` (the lexer regex at fenel-parser.ts:237 is
-- `/[\p{L}\p{N}_]/u`), so `time_zone` is a valid record field name in
-- a Fenel record literal. The body emits the wire-shape key name
-- directly + the wrapper handles the omit-when-Nothing post-pass.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeAnnotations"
@description "Phase 11b sub-step 2a — decode a Notion annotations record (5 booleans + color string) to an Annotations variant. The wrapper pre-coerces all fields via asBool / asString TS-side and dispatches; the body constructs the Annotations record + recursively calls decodeColor for the color field. Boundary adapter dispatched via `dispatchedDecodeAnnotations`. Mirrors runtime/src/handlers/notion-codec.ts:174."
@tags "notion" "codec" "annotations" "boundary" "phase-11b"
decodeAnnotations : (w: JsonValue) -> Annotations
decodeAnnotations w =
  Annotations {
    bold = w.bold,
    italic = w.italic,
    strikethrough = w.strikethrough,
    underline = w.underline,
    code = w.code,
    color = decodeColor w.color
  }

@label "notion-codec: encodeAnnotations"
@description "Phase 11b sub-step 2a — encode an Annotations variant to the Notion wire-shape record. Single-arm case-of destructuring + record-literal reconstruction; recursively calls encodeColor for the color field. Boundary adapter dispatched via `dispatchedEncodeAnnotations`. Mirrors runtime/src/handlers/notion-codec.ts:187."
@tags "notion" "codec" "annotations" "boundary" "phase-11b"
encodeAnnotations : (v: Annotations) -> JsonValue
encodeAnnotations v = case v of
  Annotations { bold = b, italic = i, strikethrough = s, underline = u, code = c, color = col } ->
    { bold = b, italic = i, strikethrough = s, underline = u, code = c, color = encodeColor col }

@label "notion-codec: decodeNotionDate"
@description "Phase 11b sub-step 2a — decode a Notion date record (start: String + end: Maybe<String> + time_zone: Maybe<String>) to a NotionDate variant. The wrapper Maybe-wraps the optional fields at the boundary; the body constructs the variant + renames `time_zone` to `timeZone` via the field-access path. Boundary adapter dispatched via `dispatchedDecodeNotionDate`. Mirrors runtime/src/handlers/notion-codec.ts:199."
@tags "notion" "codec" "date" "boundary" "phase-11b"
decodeNotionDate : (w: JsonValue) -> NotionDate
decodeNotionDate w =
  NotionDate {
    start = w.start,
    end = w.end,
    timeZone = w.time_zone
  }

@label "notion-codec: encodeNotionDate"
@description "Phase 11b sub-step 2a — encode a NotionDate variant to the Notion wire-shape record. Body emits { start, end: Maybe<String>, time_zone: Maybe<String> } directly with snake_case key; the wrapper post-processes to omit Maybe-Nothing optionals. Boundary adapter dispatched via `dispatchedEncodeNotionDate`. Mirrors runtime/src/handlers/notion-codec.ts:209."
@tags "notion" "codec" "date" "boundary" "phase-11b"
encodeNotionDate : (v: NotionDate) -> JsonValue
encodeNotionDate v = case v of
  NotionDate { start = s, end = e, timeZone = tz } ->
    { start = s, end = e, time_zone = tz }


-- -------------------------------------------------------------------------
-- §5. Parent / CommentParent
--
-- Parent: TS oracle handlers/notion-codec.ts:223. 4-arm dispatch by
-- wire `type` discriminator ("page_id" / "database_id" / "block_id" /
-- "workspace"). The body reads `w.type` directly + reads the
-- corresponding id field for each arm. The wrapper pre-extracts all 3
-- id-named fields TS-side (empty string when absent), then the body's
-- arm picks the right one.
--
-- CommentParent: TS oracle handlers/notion-codec.ts:255. NOT
-- discriminated by `type` — Notion's /comments endpoint reads
-- `parent.page_id` vs `parent.discussion_id` by FIELD PRESENCE. The
-- wrapper pre-computes a boolean `has_discussion` (true when wire's
-- discussion_id is a string) + dispatches on that. Pattern follows
-- triggerMatches's TmInput pre-classification recipe — the field-
-- presence detection is awkward inside a Fenel `case-of`, easier as
-- a TS-side pre-pass.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeParent"
@description "Phase 11b sub-step 2a — decode a Notion parent record (wire shape: { type: \"page_id\" | \"database_id\" | \"block_id\" | \"workspace\", <id_field>: String }) to a Parent variant. 4-arm case-of on `w.type` with `WorkspaceParent` fallback; the wrapper pre-extracts the 3 id fields as strings TS-side. Boundary adapter dispatched via `dispatchedDecodeParent`. Mirrors runtime/src/handlers/notion-codec.ts:223."
@tags "notion" "codec" "parent" "boundary" "phase-11b"
decodeParent : (w: JsonValue) -> Parent
decodeParent w = case w.type of
  "page_id" -> PageParent { pageId = w.page_id }
  "database_id" -> DatabaseParent { databaseId = w.database_id }
  "block_id" -> BlockParent { blockId = w.block_id }
  _ -> WorkspaceParent

@label "notion-codec: encodeParent"
@description "Phase 11b sub-step 2a — encode a Parent variant to the Notion wire-shape record. 4-arm case-of with each arm emitting { type, <snake_case_id_field>: String } or { type: \"workspace\", workspace: True }. Body emits snake_case keys directly (valid Fenel identifiers). Boundary adapter dispatched via `dispatchedEncodeParent`. Mirrors runtime/src/handlers/notion-codec.ts:238."
@tags "notion" "codec" "parent" "boundary" "phase-11b"
encodeParent : (v: Parent) -> JsonValue
encodeParent v = case v of
  PageParent { pageId = i } -> { type = "page_id", page_id = i }
  DatabaseParent { databaseId = i } -> { type = "database_id", database_id = i }
  BlockParent { blockId = i } -> { type = "block_id", block_id = i }
  WorkspaceParent -> { type = "workspace", workspace = True }

@label "notion-codec: decodeCommentParent"
@description "Phase 11b sub-step 2a — decode a Notion CommentParent record to a CommentParent variant. NOT discriminated by `type` (per TS oracle handlers/notion-codec.ts:255) — discriminated by FIELD PRESENCE of `discussion_id` vs `page_id`. The wrapper pre-computes `has_discussion: Bool` TS-side + dispatches; the body's if-else picks the right constructor. Boundary adapter dispatched via `dispatchedDecodeCommentParent`. Mirrors runtime/src/handlers/notion-codec.ts:257."
@tags "notion" "codec" "comment-parent" "boundary" "phase-11b"
decodeCommentParent : (w: JsonValue) -> CommentParent
decodeCommentParent w =
  if w.has_discussion then CommentOnDiscussion { discussionId = w.discussion_id }
  else CommentOnPage { pageId = w.page_id }

@label "notion-codec: encodeCommentParent"
@description "Phase 11b sub-step 2a — encode a CommentParent variant to the Notion wire-shape record. 2-arm case-of emitting { discussion_id } or { page_id }. Boundary adapter dispatched via `dispatchedEncodeCommentParent`. Mirrors runtime/src/handlers/notion-codec.ts:265."
@tags "notion" "codec" "comment-parent" "boundary" "phase-11b"
encodeCommentParent : (v: CommentParent) -> JsonValue
encodeCommentParent v = case v of
  CommentOnDiscussion { discussionId = d } -> { discussion_id = d }
  CommentOnPage { pageId = p } -> { page_id = p }


-- -------------------------------------------------------------------------
-- §6. NotionFile — ExternalFile | UploadedFile
--
-- TS oracle: handlers/notion-codec.ts:278. Discriminated by wire
-- `type` ("external" vs "file" or "file_upload" — both map to
-- UploadedFile). The TS oracle has a 2-level fallback chain for the
-- url + expiry_time:
--
--   ExternalFile: url = wire.external.url
--                 expiryTime = wire.expiry_time (top-level)
--   UploadedFile: url = wire.file.url OR wire.file_upload.url
--                 expiryTime = (wire.file.expiry_time OR wire.file_upload.expiry_time)
--                              ?? wire.expiry_time
--
-- The wrapper pre-resolves the nesting + fallback chain TS-side
-- (Phase 21.5 marshal-once recipe), then dispatches with a normalized
-- record `{ type, url, expiry_time: Maybe<String> }` shape. The body
-- reads the resolved fields directly.
--
-- Encoder side: Notion's write API only accepts `{ url }` (no
-- expiry_time — server-side managed). The body emits the wire-shape
-- with the nested `external: { url }` / `file: { url }` wrapper.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeNotionFile"
@description "Phase 11b sub-step 2a — decode a Notion file record to a NotionFile variant (ExternalFile | UploadedFile). 2-arm case-of on `w.type`. The wrapper pre-resolves the wire's nested url + the `inner.expiry_time ?? v.expiry_time` fallback chain TS-side; the body sees a flat record { type, url, expiry_time: Maybe<String> }. Boundary adapter dispatched via `dispatchedDecodeNotionFile`. Mirrors runtime/src/handlers/notion-codec.ts:279."
@tags "notion" "codec" "file" "boundary" "phase-11b"
decodeNotionFile : (w: JsonValue) -> NotionFile
decodeNotionFile w = case w.type of
  "external" -> ExternalFile { url = w.url, expiryTime = w.expiry_time }
  _ -> UploadedFile { url = w.url, expiryTime = w.expiry_time }

@label "notion-codec: encodeNotionFile"
@description "Phase 11b sub-step 2a — encode a NotionFile variant to the Notion wire-shape record. 2-arm case-of with each arm emitting { type, <wrapper-key>: { url } } (Notion's write API only accepts URL on writes — expiry_time is server-side-managed). Boundary adapter dispatched via `dispatchedEncodeNotionFile`. Mirrors runtime/src/handlers/notion-codec.ts:298."
@tags "notion" "codec" "file" "boundary" "phase-11b"
encodeNotionFile : (v: NotionFile) -> JsonValue
encodeNotionFile v = case v of
  ExternalFile { url = u, expiryTime = _ } -> { type = "external", external = { url = u } }
  UploadedFile { url = u, expiryTime = _ } -> { type = "file", file = { url = u } }


-- -------------------------------------------------------------------------
-- §7. Icon / Cover
--
-- Icon (TS oracle handlers/notion-codec.ts:317): 3 variants — EmojiIcon
-- (wire `type: "emoji"`) / ExternalIcon (wire `type: "external"`,
-- nested `external.url`) / UploadedIcon (wire `type: "file"`, nested
-- `file.url` + `file.expiry_time`). Same wrapper-pre-extraction
-- pattern as NotionFile.
--
-- Cover (TS oracle handlers/notion-codec.ts:351): 2 variants —
-- ExternalCover / UploadedCover. Same shape as NotionFile minus the
-- file_upload alternative wire tag.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeIcon"
@description "Phase 11b sub-step 2a — decode a Notion icon record to an Icon variant (EmojiIcon | ExternalIcon | UploadedIcon). 3-arm case-of on `w.type`. The wrapper pre-resolves the wire's nested url + emoji + expiry_time TS-side. Boundary adapter dispatched via `dispatchedDecodeIcon`. Mirrors runtime/src/handlers/notion-codec.ts:317."
@tags "notion" "codec" "icon" "boundary" "phase-11b"
decodeIcon : (w: JsonValue) -> Icon
decodeIcon w = case w.type of
  "emoji" -> EmojiIcon { emoji = w.emoji }
  "external" -> ExternalIcon { url = w.url }
  _ -> UploadedIcon { url = w.url, expiryTime = w.expiry_time }

@label "notion-codec: encodeIcon"
@description "Phase 11b sub-step 2a — encode an Icon variant to the Notion wire-shape record. 3-arm case-of: EmojiIcon → { type: \"emoji\", emoji }; ExternalIcon → { type: \"external\", external: { url } }; UploadedIcon → { type: \"file\", file: { url } }. Boundary adapter dispatched via `dispatchedEncodeIcon`. Mirrors runtime/src/handlers/notion-codec.ts:338."
@tags "notion" "codec" "icon" "boundary" "phase-11b"
encodeIcon : (v: Icon) -> JsonValue
encodeIcon v = case v of
  EmojiIcon { emoji = e } -> { type = "emoji", emoji = e }
  ExternalIcon { url = u } -> { type = "external", external = { url = u } }
  UploadedIcon { url = u, expiryTime = _ } -> { type = "file", file = { url = u } }

@label "notion-codec: decodeCover"
@description "Phase 11b sub-step 2a — decode a Notion cover record to a Cover variant (ExternalCover | UploadedCover). 2-arm case-of on `w.type`. The wrapper pre-resolves the wire's nested url + expiry_time TS-side. Boundary adapter dispatched via `dispatchedDecodeCover`. Mirrors runtime/src/handlers/notion-codec.ts:351."
@tags "notion" "codec" "cover" "boundary" "phase-11b"
decodeCover : (w: JsonValue) -> Cover
decodeCover w = case w.type of
  "external" -> ExternalCover { url = w.url }
  _ -> UploadedCover { url = w.url, expiryTime = w.expiry_time }

@label "notion-codec: encodeCover"
@description "Phase 11b sub-step 2a — encode a Cover variant to the Notion wire-shape record. 2-arm case-of: ExternalCover → { type: \"external\", external: { url } }; UploadedCover → { type: \"file\", file: { url } }. Boundary adapter dispatched via `dispatchedEncodeCover`. Mirrors runtime/src/handlers/notion-codec.ts:365."
@tags "notion" "codec" "cover" "boundary" "phase-11b"
encodeCover : (v: Cover) -> JsonValue
encodeCover v = case v of
  ExternalCover { url = u } -> { type = "external", external = { url = u } }
  UploadedCover { url = u, expiryTime = _ } -> { type = "file", file = { url = u } }


-- =========================================================================
-- Phase 11b sub-step 2b — mid-complexity codecs for §8-§11 of
-- runtime/src/handlers/notion-codec.ts:
--
--   * §8   NotionUser (+ BotInfo + BotOwner)
--   * §9   RichText + Mention (+ TemplateMention) — encode pair only
--          for Mention/RichText (TemplateMention is opaque-encoded)
--   * §10  SelectOption + StatusGroup       (decode only)
--   * §11  FileRef + FormulaResult + RollupResult + RelationRef
--
-- Boundary recipe extends Phase 11b sub-step 2a's pattern:
--
--   * Decoders: the wrapper pre-coerces the wire value into a flat
--     Fenel-shape record. For variant-by-`type` decoders with nested
--     payloads (NotionUser / Mention / RichText), the wrapper pre-
--     shapes nested inputs (e.g. `bot_input`, `user_input`,
--     `date_input`, `annotations_input`) so the body can bare-ident
--     call the relevant decoder. For decoders whose Maybe<X> fields
--     need a sub-decode (FormulaResult / RollupResult), the wrapper
--     pre-decodes + Maybe-wraps TS-side; the body just shuttles
--     through.
--
--   * Encoders: same as 2a — body destructures + emits the wire
--     record; wrapper post-processes Maybe<X> fields (link → null
--     vs {url}, href → omit vs include, embedded NotionDate.end /
--     time_zone → omit-when-Nothing).
--
-- Cross-codec body-to-body calls all flow via bare-ident → fnId
-- resolution. Pattern validated in 2a (decodeAnnotations →
-- decodeColor); extended here to:
--   * decodeNotionUser → decodeBotInfo → decodeBotOwner
--   * decodeMention → decodeNotionUser / decodeNotionDate /
--                    decodeTemplateMention
--   * decodeRichText → decodeAnnotations / decodeMention
--   * decodeSelectOption / decodeStatusGroup → decodeColor
--   * decodeFileRef → decodeNotionFile
--   * encodeRichText → encodeAnnotations / encodeMention
--   * encodeMention → encodeNotionDate
-- =========================================================================


-- -------------------------------------------------------------------------
-- §8. NotionUser (+ BotInfo + BotOwner)
--
-- TS oracle: handlers/notion-codec.ts:271. Each of the 3 fnIds is
-- separately published for matrix visibility + Fenel-side callability
-- (so e.g. a Fenel script can `decodeNotionUser`-decode a user
-- without rebuilding the wrapper's pre-shaping). Cross-body calls
-- (decodeNotionUser → decodeBotInfo → decodeBotOwner) flow via
-- bare-ident; the outer wrapper recursively pre-shapes the entire
-- input tree, so each inner body sees a ready-to-use input record.
--
-- decodeNotionUser dispatches on `w.type`:
--   "person" -> PersonUser (with `email` pulled from nested
--               `v.person.email` by the wrapper)
--   "bot"    -> BotUser (with `info` = decodeBotInfo on a pre-shaped
--               BotInfo input record)
--   _        -> PartialUser (catches undefined / unknown type values;
--               matches the TS oracle's final fall-through return)
--
-- decodeBotInfo dispatches on `w.has_owner` (Bool, pre-classified by
-- wrapper from `v.owner !== undefined`). For has_owner=True, the
-- body calls decodeBotOwner on a pre-shaped owner input. The
-- workspaceName Maybe<String> is wrapper-pre-wrapped.
--
-- decodeBotOwner dispatches on `w.type` (extracted by wrapper from
-- v.type as String). For "user" -> UserOwner with userId pulled from
-- nested v.user.id; default -> WorkspaceOwner (catches the
-- workspace-owner shape `{ type: "workspace" }`).
-- -------------------------------------------------------------------------

@label "notion-codec: decodeBotOwner"
@description "Phase 11b sub-step 2b — decode a Notion bot-owner record (wire shape: { type: \"user\" | \"workspace\", user: { id } }) to a BotOwner variant. 2-arm case-of on `w.type` with `WorkspaceOwner` fallback. The wrapper pre-extracts the nested user.id TS-side. Boundary adapter dispatched via `dispatchedDecodeBotOwner`. Mirrors runtime/src/handlers/notion-codec.ts:272."
@tags "notion" "codec" "user" "boundary" "phase-11b"
decodeBotOwner : (w: JsonValue) -> BotOwner
decodeBotOwner w = case w.type of
  "user" -> UserOwner { userId = w.user_id }
  _ -> WorkspaceOwner

@label "notion-codec: decodeBotInfo"
@description "Phase 11b sub-step 2b — decode a Notion bot-info record (the `bot` field of a bot user) to a BotInfo value. The wrapper pre-classifies `has_owner: Bool` from field presence + pre-shapes the owner_input record + Maybe-wraps workspace_name. The body's if-then-else conditionally calls `decodeBotOwner` via bare-ident + wraps in Just/Nothing for the Maybe<BotOwner> field. Boundary adapter dispatched via `dispatchedDecodeBotInfo`. Mirrors runtime/src/handlers/notion-codec.ts:281."
@tags "notion" "codec" "user" "boundary" "phase-11b"
decodeBotInfo : (w: JsonValue) -> BotInfo
decodeBotInfo w =
  if w.has_owner then
    BotInfo { owner = Just (decodeBotOwner w.owner_input), workspaceName = w.workspace_name }
  else
    BotInfo { owner = Nothing, workspaceName = w.workspace_name }

@label "notion-codec: decodeNotionUser"
@description "Phase 11b sub-step 2b — decode a Notion user record to a NotionUser variant (PersonUser | BotUser | PartialUser). 3-arm case-of on `w.type` (\"person\" / \"bot\" / fallback PartialUser). The wrapper recursively pre-shapes the bot_input record for the BotUser arm so the body's bare-ident `decodeBotInfo` call resolves. Boundary adapter dispatched via `dispatchedDecodeNotionUser`. Mirrors runtime/src/handlers/notion-codec.ts:291."
@tags "notion" "codec" "user" "boundary" "phase-11b"
decodeNotionUser : (w: JsonValue) -> NotionUser
decodeNotionUser w = case w.type of
  "person" -> PersonUser { id = w.id, name = w.name, avatarUrl = w.avatar_url, email = w.email }
  "bot" -> BotUser { id = w.id, name = w.name, avatarUrl = w.avatar_url, info = decodeBotInfo w.bot_input }
  _ -> PartialUser { id = w.id }


-- -------------------------------------------------------------------------
-- §9. RichText + Mention (+ TemplateMention)
--
-- TS oracle: handlers/notion-codec.ts:324-473.
--
-- decodeTemplateMention: 2-arm by wire `type`:
--   "template_mention_user" -> TemplateMentionUser
--   _                       -> TemplateMentionDate (catches
--                              "template_mention_date" and unknowns)
-- The wrapper extracts the inner `template_mention_user` /
-- `template_mention_date` payload strings.
--
-- decodeMention: 7-arm by wire `type`, each arm reads a different
-- nested payload (v.user / v.page.id / v.database.id / v.date /
-- v.template_mention / v.link_preview.url / v.link_mention.href /
-- v.href). Wrapper pre-extracts each into a flat field; for
-- variant types (user / date / template), the wrapper pre-shapes
-- the inner input record so the body can bare-ident call the
-- relevant decoder. LinkPreviewMention is a single-field variant —
-- the body inline-constructs it rather than calling a separate
-- decoder (saves an fnId for a trivial wrapper).
--
-- decodeRichText: 3-arm by wire `type` with shared annotations +
-- plainText + href. Each arm's body shape is essentially the same
-- record-construction with a variant-specific payload. The body
-- uses bare-ident `decodeAnnotations w.annotations_input`,
-- `decodeMention w.mention_input` for the cross-codec calls;
-- annotations / plain_text / href are shared across all 3 arms +
-- could in theory be factored out via a let-binding, but the
-- repetition is tolerable + each arm is locally readable.
--
-- Encoders mirror the decoders in shape. encodeMention's DateMention
-- arm emits `date = encodeNotionDate d`, which produces the raw
-- shape `{ start, end: Maybe, time_zone: Maybe }`; the wrapper for
-- dispatchedEncodeMention post-processes that sub-record to the
-- wire shape (omit-when-Nothing) — same wrapper-finalization
-- pattern as encodeNotionDate in 2a. encodeRichText's wrappers
-- post-process embedded mention + the `text.link` field (Maybe →
-- `null` or `{ url }`) + the top-level `href` Maybe.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeTemplateMention"
@description "Phase 11b sub-step 2b — decode a Notion template-mention record to a TemplateMention variant. 2-arm case-of on `w.type` (\"template_mention_user\" -> TemplateMentionUser; default -> TemplateMentionDate). Boundary adapter dispatched via `dispatchedDecodeTemplateMention`. Mirrors runtime/src/handlers/notion-codec.ts:324."
@tags "notion" "codec" "mention" "boundary" "phase-11b"
decodeTemplateMention : (w: JsonValue) -> TemplateMention
decodeTemplateMention w = case w.type of
  "template_mention_user" -> TemplateMentionUser { value = w.template_mention_user }
  _ -> TemplateMentionDate { value = w.template_mention_date }

@label "notion-codec: decodeMention"
@description "Phase 11b sub-step 2b — decode a Notion mention record to a Mention variant. 7-arm case-of on `w.type`. The wrapper recursively pre-shapes nested user_input / date_input / template_input records so the body's bare-ident `decodeNotionUser` / `decodeNotionDate` / `decodeTemplateMention` calls resolve. LinkPreviewMention is inline-constructed (single-field; no separate decoder). Boundary adapter dispatched via `dispatchedDecodeMention`. Mirrors runtime/src/handlers/notion-codec.ts:332."
@tags "notion" "codec" "mention" "boundary" "phase-11b"
decodeMention : (w: JsonValue) -> Mention
decodeMention w = case w.type of
  "user" -> UserMention { user = decodeNotionUser w.user_input }
  "page" -> PageMention { pageId = w.page_id }
  "database" -> DatabaseMention { databaseId = w.database_id }
  "date" -> DateMention { date = decodeNotionDate w.date_input }
  "template_mention" -> TemplateMentionM { template = decodeTemplateMention w.template_input }
  "link_preview" -> LinkPreviewMentionM { linkPreview = LinkPreviewMention { url = w.link_preview_url } }
  _ -> LinkMention { url = w.link_url }

-- IMPORTANT: PageMention / DatabaseMention emit FLAT markers (`_pageId` /
-- `_databaseId`) rather than the nested wire shape `{ page = { id = p } }`.
-- Reason: a single-field record literal `{ id = X }` in the body's emit
-- path collides with `std:id` (the identity function — `id` is its
-- codeName). The evaluator's single-key dispatch path treats `{id: …}` as
-- a call to `id(…)` rather than a record literal. Multi-field records are
-- safe (the multi-key path always treats as user record literal), so
-- UserMention emits `user = { object = "user", id = u.id }` directly.
-- For PageMention / DatabaseMention there's no natural second field, so
-- the body emits the flat marker + the wrapper `finalizeMentionWire`
-- assembles the wire shape. Same pattern applies if 2c/2d encoders need
-- to emit `{ id = X }` for nested page/database/block references — keep
-- the marker convention. (Substrate-level fix would be: parser emits a
-- distinguishable record-literal marker, e.g. `{$record: …}` or `{$rec:
-- …}`, so the evaluator can tell records from single-arg calls. Deferred
-- as a substrate enhancement; out of scope for 2b.)
@label "notion-codec: encodeMention"
@description "Phase 11b sub-step 2b — encode a Mention variant to the Notion wire-shape record. 7-arm case-of: each arm destructures the variant + emits the wire shape. UserMention reads `u.id` directly (all NotionUser variants share an `id` field). DateMention emits `date = encodeNotionDate d`, which produces a sub-record with Maybe<String> fields; the wrapper post-processes to omit-when-Nothing for end / time_zone. TemplateMentionM emits an opaque `template_mention: {}` (matches TS oracle's lossy round-trip). Boundary adapter dispatched via `dispatchedEncodeMention`. Mirrors runtime/src/handlers/notion-codec.ts:367."
@tags "notion" "codec" "mention" "boundary" "phase-11b"
encodeMention : (v: Mention) -> JsonValue
encodeMention v = case v of
  UserMention { user = u } -> { type = "user", user = { object = "user", id = u.id } }
  PageMention { pageId = p } -> { type = "page", _pageId = p }
  DatabaseMention { databaseId = d } -> { type = "database", _databaseId = d }
  DateMention { date = d } -> { type = "date", date = encodeNotionDate d }
  TemplateMentionM { template = _ } -> { type = "template_mention", template_mention = {} }
  LinkPreviewMentionM { linkPreview = lp } -> { type = "link_preview", link_preview = { url = lp.url } }
  LinkMention { url = u } -> { type = "link_mention", link_mention = { href = u } }

@label "notion-codec: decodeRichText"
@description "Phase 11b sub-step 2b — decode a Notion rich-text span record to a RichText variant. 3-arm case-of on `w.type` (\"mention\" / \"equation\" / default \"text\"). The wrapper recursively pre-shapes the annotations_input + mention_input records so the body's bare-ident `decodeAnnotations` / `decodeMention` calls resolve. Each arm shares annotations / plainText / href (the body repeats the field bindings rather than factoring via let — local readability over DRY at this scale). Boundary adapter dispatched via `dispatchedDecodeRichText`. Mirrors runtime/src/handlers/notion-codec.ts:391."
@tags "notion" "codec" "richtext" "boundary" "phase-11b"
decodeRichText : (w: JsonValue) -> RichText
decodeRichText w = case w.type of
  "mention" ->
    RichTextMention {
      mention = decodeMention w.mention_input,
      annotations = decodeAnnotations w.annotations_input,
      plainText = w.plain_text,
      href = w.href
    }
  "equation" ->
    RichTextEquation {
      expression = w.expression,
      annotations = decodeAnnotations w.annotations_input,
      plainText = w.plain_text,
      href = w.href
    }
  _ ->
    RichTextText {
      content = w.content,
      link = w.link,
      annotations = decodeAnnotations w.annotations_input,
      plainText = w.plain_text,
      href = w.href
    }

@label "notion-codec: encodeRichText"
@description "Phase 11b sub-step 2b — encode a RichText variant to the Notion wire-shape record. 3-arm case-of. Each arm calls `encodeAnnotations a` via bare-ident (output passes through wrapper unchanged — no Maybe fields in Annotations). The body emits Maybe<String> for href + (RichTextText only) text.link; the wrapper post-processes: href Maybe → omit-when-Nothing; link Maybe → JS `null` for Nothing / `{ url }` for Just. For RichTextMention, the embedded mention is recursively finalized (in particular DateMention's date sub-record). Boundary adapter dispatched via `dispatchedEncodeRichText`. Mirrors runtime/src/handlers/notion-codec.ts:431."
@tags "notion" "codec" "richtext" "boundary" "phase-11b"
encodeRichText : (v: RichText) -> JsonValue
encodeRichText v = case v of
  RichTextMention { mention = m, annotations = a, plainText = p, href = h } ->
    { type = "mention", mention = encodeMention m, annotations = encodeAnnotations a, plain_text = p, href = h }
  RichTextEquation { expression = e, annotations = a, plainText = p, href = h } ->
    { type = "equation", equation = { expression = e }, annotations = encodeAnnotations a, plain_text = p, href = h }
  RichTextText { content = c, link = l, annotations = a, plainText = p, href = h } ->
    { type = "text", text = { content = c, link = l }, annotations = encodeAnnotations a, plain_text = p, href = h }


-- -------------------------------------------------------------------------
-- §10. SelectOption + StatusGroup (decode-only)
--
-- TS oracle: handlers/notion-codec.ts:479. Both are flat records
-- whose only complexity is the recursive decodeColor call for the
-- `color` field. description (SelectOption) is Maybe<String> from
-- the wrapper; optionIds (StatusGroup) is a List<String> from the
-- wrapper.
--
-- Encode side intentionally omitted — these are read-only schema
-- metadata. PropertyWrite (§13, sub-step 2c) encodes select values
-- inline as `{ name }` records, doesn't call encodeSelectOption.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeSelectOption"
@description "Phase 11b sub-step 2b — decode a Notion select-option record (id / name / color / description) to a SelectOption value. Single-arm body constructing the variant + recursively calling `decodeColor` for the color field. description is Maybe<String> from the wrapper. Boundary adapter dispatched via `dispatchedDecodeSelectOption`. Mirrors runtime/src/handlers/notion-codec.ts:479."
@tags "notion" "codec" "select-option" "boundary" "phase-11b"
decodeSelectOption : (w: JsonValue) -> SelectOption
decodeSelectOption w =
  SelectOption {
    id = w.id,
    name = w.name,
    color = decodeColor w.color,
    description = w.description
  }

@label "notion-codec: decodeStatusGroup"
@description "Phase 11b sub-step 2b — decode a Notion status-group record (id / name / color / optionIds) to a StatusGroup value. Single-arm body constructing the variant. optionIds is List<String> pre-decoded by the wrapper. Boundary adapter dispatched via `dispatchedDecodeStatusGroup`. Mirrors runtime/src/handlers/notion-codec.ts:490."
@tags "notion" "codec" "status-group" "boundary" "phase-11b"
decodeStatusGroup : (w: JsonValue) -> StatusGroup
decodeStatusGroup w =
  StatusGroup {
    id = w.id,
    name = w.name,
    color = decodeColor w.color,
    optionIds = w.option_ids
  }


-- -------------------------------------------------------------------------
-- §11. FileRef + FormulaResult + RollupResult + RelationRef
--
-- TS oracle: handlers/notion-codec.ts:505-570.
--
-- decodeFileRef: simple — name + nested NotionFile (the wire format
-- merges them at the top level of the wrapping object, but the
-- wrapper handles the unwrap + passes a pre-shaped `file_input`).
-- The body calls decodeNotionFile via bare-ident.
--
-- encodeFileRef: 2-arm case-of on the inner NotionFile variant.
-- The wire shape merges the name field into the file record at
-- the top level — both `name` and the file's `type`/`external`/
-- `file` fields are siblings in the output. The body emits the
-- merged shape directly via nested-named-field destructuring (cf.
-- 2b risk #1 — verified pattern parses).
--
-- decodeFormulaResult: 4-arm case-of on wire `type`. Each variant's
-- value field is Maybe<X> where X varies per arm (String / Number /
-- Boolean / NotionDate). The wrapper pre-Maybe-wraps the primitive
-- values + pre-decodes the date variant TS-side via the dispatched
-- decodeNotionDate wrapper (semantic-identical to a body bare-ident
-- call, but the Maybe wrapping is cleaner TS-side because the body
-- would need an if-then-else over a wrapper-set Bool to construct
-- Just vs Nothing — net code is smaller with wrapper-side pre-
-- decoding).
--
-- decodeRollupResult: 5-arm case-of. NumberRollup / DateRollup
-- follow the same wrapper-pre-decode pattern as FormulaResult.
-- ArrayRollup contains a List<PropertyValue>; the wrapper pre-
-- decodes each element TS-side using the still-TS-side
-- decodePropertyValue shim (CROSS-SUB-STEP CARVE-OUT — when 2c
-- lands and notion:decodePropertyValue is registered, the wrapper
-- can drop the TS-side pre-decoding + the body could call
-- `decodePropertyValue` via bare-ident; documented as a sub-step
-- 2c follow-up). IncompleteRollup / UnsupportedRollup are nullary.
--
-- decodeRelationRef: degenerate single-field record construction.
-- Same surface-visibility justification as 2a's NotionDate.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeFileRef"
@description "Phase 11b sub-step 2b — decode a Notion file-ref record (name + merged NotionFile wire shape) to a FileRef value. The wrapper pre-shapes the file_input record so the body's bare-ident `decodeNotionFile` call resolves; the name field passes through directly. Boundary adapter dispatched via `dispatchedDecodeFileRef`. Mirrors runtime/src/handlers/notion-codec.ts:505."
@tags "notion" "codec" "file-ref" "boundary" "phase-11b"
decodeFileRef : (w: JsonValue) -> FileRef
decodeFileRef w =
  FileRef {
    name = w.name,
    file = decodeNotionFile w.file_input
  }

@label "notion-codec: encodeFileRef"
@description "Phase 11b sub-step 2b — encode a FileRef value to the Notion wire-shape record (name + merged NotionFile wire fields at top level). 2-arm case-of on the inner NotionFile variant via NESTED named-field destructuring (`FileRef { name = n, file = ExternalFile { url = u } }`). Boundary adapter dispatched via `dispatchedEncodeFileRef`. Mirrors runtime/src/handlers/notion-codec.ts:514."
@tags "notion" "codec" "file-ref" "boundary" "phase-11b"
encodeFileRef : (v: FileRef) -> JsonValue
encodeFileRef v = case v of
  FileRef { name = n, file = ExternalFile { url = u, expiryTime = _ } } ->
    { name = n, type = "external", external = { url = u } }
  FileRef { name = n, file = UploadedFile { url = u, expiryTime = _ } } ->
    { name = n, type = "file", file = { url = u } }

@label "notion-codec: decodeFormulaResult"
@description "Phase 11b sub-step 2b — decode a Notion formula-result record to a FormulaResult variant. 4-arm case-of on `w.type`. The wrapper pre-Maybe-wraps the primitive values (string / number / boolean) + pre-decodes the date variant TS-side via dispatchedDecodeNotionDate + Maybe-wraps (cleaner than a body if-then-else over a wrapper-set Bool for Just vs Nothing construction). Boundary adapter dispatched via `dispatchedDecodeFormulaResult`. Mirrors runtime/src/handlers/notion-codec.ts:520."
@tags "notion" "codec" "formula" "boundary" "phase-11b"
decodeFormulaResult : (w: JsonValue) -> FormulaResult
decodeFormulaResult w = case w.type of
  "string" -> StringFormulaResult { value = w.string_value }
  "number" -> NumberFormulaResult { value = w.number_value }
  "boolean" -> BooleanFormulaResult { value = w.boolean_value }
  _ -> DateFormulaResult { value = w.date_value }

@label "notion-codec: decodeRollupResult"
@description "Phase 11b sub-step 2b — decode a Notion rollup-result record to a RollupResult variant. 5-arm case-of on `w.type`. NumberRollup / DateRollup follow the same wrapper-pre-decode pattern as FormulaResult. ArrayRollup contains a List<PropertyValue>; the wrapper pre-decodes each element TS-side via the still-TS decodePropertyValue shim (CROSS-SUB-STEP CARVE-OUT pending sub-step 2c — when notion:decodePropertyValue is registered, the wrapper can drop the TS-side pre-decoding). IncompleteRollup / UnsupportedRollup are nullary. Boundary adapter dispatched via `dispatchedDecodeRollupResult`. Mirrors runtime/src/handlers/notion-codec.ts:544."
@tags "notion" "codec" "rollup" "boundary" "phase-11b"
decodeRollupResult : (w: JsonValue) -> RollupResult
decodeRollupResult w = case w.type of
  "number" -> NumberRollup { value = w.number_value }
  "date" -> DateRollup { value = w.date_value }
  "array" -> ArrayRollup { values = w.values_input }
  "incomplete" -> IncompleteRollup
  _ -> UnsupportedRollup

@label "notion-codec: decodeRelationRef"
@description "Phase 11b sub-step 2b — decode a Notion relation-ref record (single id field) to a RelationRef value. Degenerate body — single-field record construction. Same surface-visibility justification as 2a's NotionDate (matrix-visible + Fenel-callable, despite minimal genuine reasoning content). Boundary adapter dispatched via `dispatchedDecodeRelationRef`. Mirrors runtime/src/handlers/notion-codec.ts:567."
@tags "notion" "codec" "relation-ref" "boundary" "phase-11b"
decodeRelationRef : (w: JsonValue) -> RelationRef
decodeRelationRef w = RelationRef { id = w.id }


-- =========================================================================
-- Phase 11b sub-step 2c — §12-§14 of runtime/src/handlers/notion-codec.ts:
--
--   * §12  PropertyValue                     (24-arm decoder + Object-form
--                                             helper)
--   * §13  PropertyWrite                     (14-arm encoder)
--   * §14  Property + RelationKind           (24-arm decoder + 2-arm helper
--                                             + Object-form helper)
--
-- The largest single arc in the codec series (decodePropertyValue has 24
-- arms; decodeProperty has 24). Recipe matches 2a + 2b but at scale:
--
--   * Decoders: the wrapper pre-decodes every nested value TS-side
--     (lists via dispatchedDecodeRichText / dispatchedDecodeSelectOption
--     / etc.; Maybe<NotionDate> via dispatchedDecodeNotionDate +
--     maybeVal; Maybe<NotionUser> via dispatchedDecodeNotionUser; etc.).
--     The body's case-of reads pre-decoded fields directly + constructs
--     the typed variant via the construct op. No body-side bare-ident
--     cross-codec calls in this sub-step — all decoding flows through the
--     wrapper for clearer dispatch boundary + dead-simple body recipe.
--
--   * encodePropertyWrite: body destructures the PropertyWrite variant +
--     emits a flat marker record `{ _wkind = "<VariantName>", ...raw
--     fields }`. The wrapper switches on `_wkind` + applies per-arm wire-
--     shape transformations TS-side: list-element encoding (RichText /
--     FileRef), Maybe → null|value finalization, [String] → [{name}] /
--     [{id}] / [{object, id}] wrappers. Marker-record approach avoids the
--     `{ id = X }` codeName clash entirely (each marker record is multi-
--     field — _wkind + raw payload field — so it's never single-key).
--
--   * decodePropertiesObject / decodePropertySchemaObject: the wrapper
--     walks the JS object via Object.entries TS-side + pre-decodes each
--     value (via dispatchedDecodePropertyValue / dispatchedDecodeProperty)
--     + passes a list of pre-shaped { name, value_input } / { name,
--     property_input } records to the body. The body uses std:map with
--     a lambda to wrap each into a PropertyEntry / PropertySchemaEntry
--     constructor. Pattern: typed-list construction is natural Fenel +
--     matrix-visible; the dynamic-key object walk stays TS-side because
--     Fenel record literals require static keys.
--
-- decodeRelationKind is broken out as a separate fnId per the 2a/2b
-- precedent for small dispatch helpers (decodeColor / decodeSortDirection
-- etc.) — matrix visibility + Fenel-side callability over inlining.
--
-- Resolves the 2b ArrayRollup cross-sub-step carve-out: once
-- notion:decodePropertyValue lands, dispatchedDecodeRollupResult's
-- ArrayRollup arm switches from the still-TS `decodePropertyValue` shim
-- to direct `dispatchedDecodePropertyValue` calls — same Fenel body
-- either way, but the wrapper-to-wrapper call removes the shim indirection.
-- =========================================================================


-- -------------------------------------------------------------------------
-- §12. PropertyValue
--
-- TS oracle: handlers/notion-codec.ts:367. The most-used Notion type. 24
-- arms discriminated by wire `v.type`. The body emits typed variants via
-- the construct op; each arm reads pre-decoded fields from the wrapper-
-- shaped input record.
--
-- Wrapper input shape (per-field pre-decoding):
--   * id: String, type: String
--   * title_richtext / rich_text_richtext: [RichText] (pre-mapped)
--   * number_value: Maybe<Number>
--   * select_option / status_option: Maybe<SelectOption>
--   * multi_select_options: [SelectOption]
--   * date_value: Maybe<NotionDate>
--   * people_list: [NotionUser]
--   * files_list: [FileRef]
--   * checkbox_value: Boolean
--   * url_value / email_value / phone_number_value: Maybe<String>
--   * formula_value: FormulaResult
--   * relation_list: [RelationRef] + has_more: Boolean
--   * rollup_value: RollupResult
--   * created_time / last_edited_time: String
--   * created_by_user / last_edited_by_user: NotionUser
--   * uid_number: Maybe<Number>, uid_prefix: Maybe<String>
--   * ver_state: String, ver_verified_by: Maybe<NotionUser>, ver_date: Maybe<NotionDate>
--
-- Default arm (`_ -> UnsupportedValue { ... kind = w.type }`) matches the
-- TS oracle's `default: UnsupportedValue { ..., kind: asString(v.type) }`.
-- -------------------------------------------------------------------------

@label "notion-codec: decodePropertyValue"
@description "Phase 11b sub-step 2c — decode a Notion property-value record to a PropertyValue variant (the most-used Notion type). 24-arm case-of on `w.type`. The wrapper recursively pre-decodes every nested value TS-side: [RichText] (title / rich_text), Maybe<SelectOption> (select / status), [SelectOption] (multi_select), Maybe<NotionDate> (date), [NotionUser] (people), [FileRef] (files), FormulaResult (formula), [RelationRef] (relation), RollupResult (rollup), NotionUser (created_by / last_edited_by), Maybe<NotionUser> + Maybe<NotionDate> (verification), Maybe<Number> + Maybe<String> (unique_id), Maybe<String> (url / email / phone_number). The body reads pre-decoded fields + constructs the typed variant via the construct op. Default arm emits UnsupportedValue with the raw type string. Boundary adapter dispatched via `dispatchedDecodePropertyValue`. Mirrors runtime/src/handlers/notion-codec.ts:367."
@tags "notion" "codec" "property-value" "boundary" "phase-11b"
decodePropertyValue : (w: JsonValue) -> PropertyValue
decodePropertyValue w = case w.type of
  "title" -> TitleValue { id = w.id, richText = w.title_richtext }
  "rich_text" -> RichTextValue { id = w.id, richText = w.rich_text_richtext }
  "number" -> NumberValue { id = w.id, number = w.number_value }
  "select" -> SelectValue { id = w.id, selected = w.select_option }
  "multi_select" -> MultiSelectValue { id = w.id, selected = w.multi_select_options }
  "status" -> StatusValue { id = w.id, selected = w.status_option }
  "date" -> DateValue { id = w.id, date = w.date_value }
  "people" -> PeopleValue { id = w.id, people = w.people_list }
  "files" -> FilesValue { id = w.id, files = w.files_list }
  "checkbox" -> CheckboxValue { id = w.id, checkbox = w.checkbox_value }
  "url" -> UrlValue { id = w.id, url = w.url_value }
  "email" -> EmailValue { id = w.id, email = w.email_value }
  "phone_number" -> PhoneNumberValue { id = w.id, phoneNumber = w.phone_number_value }
  "formula" -> FormulaValue { id = w.id, formula = w.formula_value }
  "relation" -> RelationValue { id = w.id, relation = w.relation_list, hasMore = w.has_more }
  "rollup" -> RollupValue { id = w.id, rollup = w.rollup_value }
  "created_time" -> CreatedTimeValue { id = w.id, createdTime = w.created_time }
  "created_by" -> CreatedByValue { id = w.id, createdBy = w.created_by_user }
  "last_edited_time" -> LastEditedTimeValue { id = w.id, lastEditedTime = w.last_edited_time }
  "last_edited_by" -> LastEditedByValue { id = w.id, lastEditedBy = w.last_edited_by_user }
  "unique_id" -> UniqueIdValue { id = w.id, number = w.uid_number, prefix = w.uid_prefix }
  "verification" -> VerificationValue { id = w.id, state = w.ver_state, verifiedBy = w.ver_verified_by, date = w.ver_date }
  "button" -> ButtonValue { id = w.id }
  _ -> UnsupportedValue { id = w.id, kind = w.type }


-- -------------------------------------------------------------------------
-- decodePropertiesObject — Notion's `{ propName: propValue }` JS object →
-- typed [PropertyEntry] list.
--
-- The wrapper walks Object.entries TS-side + pre-decodes each propValue
-- via dispatchedDecodePropertyValue. The body sees a list of pre-shaped
-- entries `[{ name: String, value: PropertyValue }]` + maps each into
-- PropertyEntry via std:map + an inline lambda.
--
-- The PropertyEntry construct call is multi-field (name + value), so it
-- bypasses the single-key `{ id = X }` codeName clash. Same precedent
-- used by fenel/modules/telegram/list-collectors.fenel:17 for typed-list
-- transforms.
-- -------------------------------------------------------------------------

@label "notion-codec: decodePropertiesObject"
@description "Phase 11b sub-step 2c — convert Notion's `{ propName: propValue }` JS object form into a typed [PropertyEntry] list. The wrapper walks Object.entries TS-side + pre-decodes each propValue via dispatchedDecodePropertyValue + passes a list of `{ name, value }` records to the body. The body uses std:map + an inline lambda to wrap each pre-shaped entry into a PropertyEntry constructor. Dynamic-key object walks stay TS-side because Fenel record literals require static keys; typed-list construction is natural Fenel. Boundary adapter dispatched via `dispatchedDecodePropertiesObject`. Mirrors runtime/src/handlers/notion-codec.ts:549."
@tags "notion" "codec" "property-value" "boundary" "phase-11b"
decodePropertiesObject : (entries: List JsonValue) -> List PropertyEntry
decodePropertiesObject entries =
  map (\e -> PropertyEntry { name = e.name, value = e.value }) entries


-- -------------------------------------------------------------------------
-- §13. PropertyWrite — write-side per-arm encoder
--
-- TS oracle: handlers/notion-codec.ts:475. 14-arm dispatch on the Fenel
-- value's $tag. The body destructures each variant + emits a flat marker
-- record `{ _wkind = "<VariantName>", ...raw_payload_fields }`. The
-- wrapper switches on `_wkind` + builds the wire-shape with per-arm
-- transformations:
--
--   * TitleWrite / RichTextWrite: wrapper maps richText [RichText] →
--     [encoded RichText] via dispatchedEncodeRichText, emits
--     { title: [...] } / { rich_text: [...] }.
--   * NumberWrite: wrapper finalizes Maybe<Number> → null | n,
--     emits { number: ... }.
--   * SelectWrite / StatusWrite: wrapper finalizes
--     Maybe<String> → null | { name: optionName }.
--   * MultiSelectWrite: wrapper maps [String] → [{name}],
--     emits { multi_select: [{name: x}, ...] }.
--   * DateWrite: wrapper finalizes Maybe<NotionDate> → null |
--     dispatchedEncodeNotionDate(d).
--   * PeopleWrite: wrapper maps [String] → [{object, id}],
--     emits { people: [{ object: "user", id: ... }, ...] }.
--   * FilesWrite: wrapper maps [FileRef] → [encoded FileRef] via
--     dispatchedEncodeFileRef.
--   * CheckboxWrite: wrapper coerces via asBool (no Maybe — boolean is
--     non-optional in write-side).
--   * UrlWrite / EmailWrite / PhoneNumberWrite: wrapper finalizes
--     Maybe<String> → null | value.
--   * RelationWrite: wrapper maps [String] → [{id}],
--     emits { relation: [{ id: ... }, ...] }. The single-field `{ id: x }`
--     records are constructed TS-side, avoiding the codeName clash.
--
-- Each marker record is multi-field (`_wkind` + payload field name), so
-- never hits the single-key dispatch path. Safe.
-- -------------------------------------------------------------------------

@label "notion-codec: encodePropertyWrite"
@description "Phase 11b sub-step 2c — encode a PropertyWrite variant to the Notion wire-shape record. 14-arm case-of on the Fenel value's tag. The body destructures each variant + emits a flat marker record `{ _wkind = \"<VariantName>\", ...raw_payload_fields }` (multi-field — avoids the single-key `{ id = X }` codeName clash). The wrapper switches on `_wkind` + builds the wire shape with per-arm transformations: list-element encoding via dispatchedEncodeRichText / dispatchedEncodeFileRef (TitleWrite / RichTextWrite / FilesWrite), Maybe → null|value finalization (NumberWrite / UrlWrite / EmailWrite / PhoneNumberWrite), Maybe<String> → { name } (SelectWrite / StatusWrite), Maybe<NotionDate> → encoded date or null (DateWrite), [String] → [{name: x}] (MultiSelectWrite), [String] → [{object: \"user\", id: x}] (PeopleWrite), [String] → [{id: x}] (RelationWrite). Boundary adapter dispatched via `dispatchedEncodePropertyWrite`. Mirrors runtime/src/handlers/notion-codec.ts:475."
@tags "notion" "codec" "property-write" "boundary" "phase-11b"
encodePropertyWrite : (v: JsonValue) -> JsonValue
encodePropertyWrite v = case v of
  TitleWrite { richText = rs } -> { _wkind = "TitleWrite", richText = rs }
  RichTextWrite { richText = rs } -> { _wkind = "RichTextWrite", richText = rs }
  NumberWrite { number = n } -> { _wkind = "NumberWrite", number = n }
  SelectWrite { optionName = on } -> { _wkind = "SelectWrite", optionName = on }
  MultiSelectWrite { optionNames = ons } -> { _wkind = "MultiSelectWrite", optionNames = ons }
  StatusWrite { optionName = on } -> { _wkind = "StatusWrite", optionName = on }
  DateWrite { date = d } -> { _wkind = "DateWrite", date = d }
  PeopleWrite { userIds = ids } -> { _wkind = "PeopleWrite", userIds = ids }
  FilesWrite { files = fs } -> { _wkind = "FilesWrite", files = fs }
  CheckboxWrite { checkbox = c } -> { _wkind = "CheckboxWrite", checkbox = c }
  UrlWrite { url = u } -> { _wkind = "UrlWrite", url = u }
  EmailWrite { email = e } -> { _wkind = "EmailWrite", email = e }
  PhoneNumberWrite { phoneNumber = p } -> { _wkind = "PhoneNumberWrite", phoneNumber = p }
  RelationWrite { pageIds = ps } -> { _wkind = "RelationWrite", pageIds = ps }


-- -------------------------------------------------------------------------
-- §14. Property + RelationKind
--
-- TS oracle: handlers/notion-codec.ts:562 (decodeRelationKind),
-- handlers/notion-codec.ts:575 (decodeProperty). 24-arm Property decoder
-- discriminating on wire `v.type` for the database schema side. Most arms
-- are degenerate (id + name only). Wrapper pre-shapes lists + nested
-- variants for the richer arms.
--
-- Wrapper input shape:
--   * id: String, name: String, type: String
--   * number_format: String
--   * select_options / multi_select_options / status_options: [SelectOption]
--   * status_groups: [StatusGroup]
--   * formula_expression: String
--   * relation_db_id: String, relation_kind: RelationKind (pre-computed via
--     dispatchedDecodeRelationKind for the inner v.relation record)
--   * rollup_rpn / rollup_rpnm / rollup_rpi / rollup_rpid / rollup_fn:
--     String (the 5 strings inside v.rollup, pre-extracted via asString)
--   * uid_prefix: Maybe<String>
--
-- Default arm (`_ -> RichTextProperty { ... }`) matches the TS oracle's
-- `default: { $tag: "RichTextProperty", id, name }` catch-all. Notion's
-- API hasn't introduced a new property type since 2024, but the fallback
-- keeps downstream consumers from crashing on hypothetical unknown types.
--
-- Note: the TS oracle factors "select" + "multi_select" into a shared
-- branch that dispatches the constructor tag inline (`v.type === "select"
-- ? "SelectProperty" : "MultiSelectProperty"`). The Fenel body's case-of
-- has TWO arms for these (each emitting the appropriate constructor),
-- which is the natural Fenel translation. Net code is slightly more
-- verbose but the dispatch surface is identical.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeRelationKind"
@description "Phase 11b sub-step 2c — decode a Notion relation-property `kind` sub-record to a RelationKind variant (SinglePropertyRelation | DualPropertyRelation). 2-arm case-of on `w.type` (\"dual_property\" -> DualPropertyRelation with the 2 synced-property ids; default -> SinglePropertyRelation). The wrapper pre-extracts the synced-property strings TS-side. Broken out as a separate fnId per the 2a/2b precedent for small dispatch helpers (matrix visibility + Fenel-callability). Boundary adapter dispatched via `dispatchedDecodeRelationKind`. Mirrors runtime/src/handlers/notion-codec.ts:562."
@tags "notion" "codec" "relation-kind" "boundary" "phase-11b"
decodeRelationKind : (w: JsonValue) -> RelationKind
decodeRelationKind w = case w.type of
  "dual_property" -> DualPropertyRelation { syncedPropertyName = w.synced_property_name, syncedPropertyId = w.synced_property_id }
  _ -> SinglePropertyRelation

@label "notion-codec: decodeProperty"
@description "Phase 11b sub-step 2c — decode a Notion property (database schema) record to a Property variant. 24-arm case-of on `w.type`. Most arms are degenerate (id + name only); the wrapper pre-shapes the richer arms — [SelectOption] for select/multi_select/status options, [StatusGroup] for status groups, RelationKind for relation (pre-computed via dispatchedDecodeRelationKind), 5 strings for rollup, Maybe<String> for unique_id prefix, the format string for number. Default arm emits RichTextProperty as catch-all (matches TS oracle). The TS oracle factors \"select\" + \"multi_select\" into a shared branch with inline tag dispatch; the Fenel body uses separate arms (each emitting the appropriate constructor) — the natural Fenel translation. Boundary adapter dispatched via `dispatchedDecodeProperty`. Mirrors runtime/src/handlers/notion-codec.ts:575."
@tags "notion" "codec" "property" "boundary" "phase-11b"
decodeProperty : (w: JsonValue) -> Property
decodeProperty w = case w.type of
  "title" -> TitleProperty { id = w.id, name = w.name }
  "rich_text" -> RichTextProperty { id = w.id, name = w.name }
  "number" -> NumberProperty { id = w.id, name = w.name, format = NumberFormat { name = w.number_format } }
  "select" -> SelectProperty { id = w.id, name = w.name, options = w.select_options }
  "multi_select" -> MultiSelectProperty { id = w.id, name = w.name, options = w.multi_select_options }
  "status" -> StatusProperty { id = w.id, name = w.name, options = w.status_options, groups = w.status_groups }
  "date" -> DateProperty { id = w.id, name = w.name }
  "people" -> PeopleProperty { id = w.id, name = w.name }
  "files" -> FilesProperty { id = w.id, name = w.name }
  "checkbox" -> CheckboxProperty { id = w.id, name = w.name }
  "url" -> UrlProperty { id = w.id, name = w.name }
  "email" -> EmailProperty { id = w.id, name = w.name }
  "phone_number" -> PhoneNumberProperty { id = w.id, name = w.name }
  "formula" -> FormulaProperty { id = w.id, name = w.name, expression = w.formula_expression }
  "relation" -> RelationProperty { id = w.id, name = w.name, databaseId = w.relation_db_id, kind = w.relation_kind }
  "rollup" -> RollupProperty { id = w.id, name = w.name, relationPropertyName = w.rollup_rpn, rollupPropertyName = w.rollup_rpnm, relationPropertyId = w.rollup_rpi, rollupPropertyId = w.rollup_rpid, function = w.rollup_fn }
  "created_time" -> CreatedTimeProperty { id = w.id, name = w.name }
  "created_by" -> CreatedByProperty { id = w.id, name = w.name }
  "last_edited_time" -> LastEditedTimeProperty { id = w.id, name = w.name }
  "last_edited_by" -> LastEditedByProperty { id = w.id, name = w.name }
  "button" -> ButtonProperty { id = w.id, name = w.name }
  "unique_id" -> UniqueIdProperty { id = w.id, name = w.name, prefix = w.uid_prefix }
  "verification" -> VerificationProperty { id = w.id, name = w.name }
  _ -> RichTextProperty { id = w.id, name = w.name }


-- -------------------------------------------------------------------------
-- decodePropertySchemaObject — Notion's `{ propName: propertyDef }` JS
-- object → typed [PropertySchemaEntry] list. Same recipe as
-- decodePropertiesObject: wrapper walks Object.entries TS-side + pre-
-- decodes each propertyDef via dispatchedDecodeProperty; body wraps each
-- pre-shaped `{ name, property }` into a PropertySchemaEntry via std:map +
-- an inline lambda.
-- -------------------------------------------------------------------------

@label "notion-codec: decodePropertySchemaObject"
@description "Phase 11b sub-step 2c — convert Notion's `{ propName: propertyDef }` JS object form (database schema) into a typed [PropertySchemaEntry] list. Same recipe as decodePropertiesObject: wrapper walks Object.entries TS-side + pre-decodes each propertyDef via dispatchedDecodeProperty; body uses std:map + lambda to wrap each pre-shaped `{ name, property }` into a PropertySchemaEntry constructor. Boundary adapter dispatched via `dispatchedDecodePropertySchemaObject`. Mirrors runtime/src/handlers/notion-codec.ts:673."
@tags "notion" "codec" "property-schema" "boundary" "phase-11b"
decodePropertySchemaObject : (entries: List JsonValue) -> List PropertySchemaEntry
decodePropertySchemaObject entries =
  map (\e -> PropertySchemaEntry { name = e.name, property = e.property }) entries


-- =========================================================================
-- Phase 11b sub-step 2d — §15 of runtime/src/handlers/notion-codec.ts:
--
--   * §15a  LinkTarget        (2-arm decoder + 2-arm encoder)
--   * §15b  BlockContent      (33-arm decoder + 33-arm encoder — the
--                              largest single arc in the codec series)
--   * §15c  Block             (flat-record decoder; recursive via
--                              wrapper pre-decoded `content` field)
--
-- 5 fnIds — `notion:decodeLinkTarget` + `notion:encodeLinkTarget` +
-- `notion:decodeBlockContent` + `notion:encodeBlockContent` +
-- `notion:decodeBlock`. `encodeBlock` is intentionally OMITTED — Notion's
-- write API never accepts a full Block on write; writes use BlockContent
-- directly (TS oracle has no `encodeBlock` export).
--
-- The architecture extends 2c with **mutually recursive body-to-body**
-- calls via wrapper-side TS recursion: `dispatchedDecodeBlock` recursively
-- calls `dispatchedDecodeBlockContent` for its `content` field, and
-- `dispatchedDecodeBlockContent` recursively calls `dispatchedDecodeBlock`
-- for each child in `children`. Same for the encode side
-- (`dispatchedEncodeBlockContent` recursively calls itself for each child
-- in nested BlockContent arms). Wrapper-side TS recursion is the safe
-- choice here (Notion API limits nesting depth — practical worst case is
-- ~5-10 levels for toggle-inside-toggle, no stack risk).
--
-- The encoder follows the `_kind`-marker-record pattern established in 2c:
-- the body destructures each variant + emits a FLAT marker record
-- `{ _kind = "<wire_type>", ...camelCase_payload_fields }`. The wrapper
-- finalize switches on `_kind` + assembles the Notion wire shape:
--     `{ object: "block", type: <wire_type>, <wire_type>: { ... } }`
-- with per-arm transformations (rich_text via dispatchedEncodeRichText
-- mapping, color via dispatchedEncodeColor, children via recursive
-- dispatchedEncodeBlockContent, icon Maybe → null|encodedIcon, file/media
-- payload assembly via encodeMediaPayload, target via
-- dispatchedEncodeLinkTarget, synced_from Maybe<String> → null|{type, id},
-- nested cells map for TableRowContent).
--
-- The decoder side is simpler: the wrapper pre-decodes the payload
-- extraction (`payload = v[v.type]` — dynamic key not natural Fenel),
-- pre-decodes nested lists (rich_text / caption / children / cells), pre-
-- decodes nested variants (color / icon / target / file), Maybe-wraps
-- syncedFromBlockId, asBool-coerces booleans, asStr-coerces strings. The
-- body reads pre-decoded fields directly via `.`-access + constructs the
-- typed variant.
--
-- Media payload helpers (`decodeMediaPayload` / `encodeMediaPayload`)
-- stay TS-only inline-utilities — 5 arms each duplicate the
-- file+caption pattern (the brief considered factoring as separate fnIds
-- but inlining matches 2a-2c's decision to keep small helpers inlined;
-- the wrapper does the pre-decoding either way).
-- =========================================================================


-- -------------------------------------------------------------------------
-- §15a. LinkTarget — used by LinkToPageContent
--
-- TS oracle: handlers/notion-codec.ts:408 (decodeLinkTarget) + :416
-- (encodeLinkTarget). 2-arm dispatch on wire `type` ("database_id" →
-- DatabaseIdTarget; default → PageIdTarget). The wrapper pre-extracts
-- type + database_id + page_id TS-side as strings; the body's case-of
-- reads the right field for each arm. Encoder's body emits the
-- snake_case wire shape directly via record literal (same pattern as
-- 2a's encodeParent — multi-field, safe from {id=X} clash).
-- -------------------------------------------------------------------------

@label "notion-codec: decodeLinkTarget"
@description "Phase 11b sub-step 2d — decode a Notion link-target record (used by LinkToPageContent) to a LinkTarget variant. 2-arm case-of on `w.type` (\"database_id\" -> DatabaseIdTarget; default -> PageIdTarget). The wrapper pre-extracts type + database_id + page_id as strings TS-side. Boundary adapter dispatched via `dispatchedDecodeLinkTarget`. Mirrors runtime/src/handlers/notion-codec.ts:408."
@tags "notion" "codec" "link-target" "boundary" "phase-11b"
decodeLinkTarget : (w: JsonValue) -> LinkTarget
decodeLinkTarget w = case w.type of
  "database_id" -> DatabaseIdTarget { databaseId = w.database_id }
  _ -> PageIdTarget { pageId = w.page_id }

@label "notion-codec: encodeLinkTarget"
@description "Phase 11b sub-step 2d — encode a LinkTarget variant to the Notion wire-shape record. 2-arm case-of: DatabaseIdTarget emits `{ type = \"database_id\", database_id = d }`; PageIdTarget emits `{ type = \"page_id\", page_id = p }`. Body emits the snake_case wire shape directly via record literal (multi-field — safe from {id=X} codeName clash). Boundary adapter dispatched via `dispatchedEncodeLinkTarget`. Mirrors runtime/src/handlers/notion-codec.ts:416."
@tags "notion" "codec" "link-target" "boundary" "phase-11b"
encodeLinkTarget : (v: LinkTarget) -> JsonValue
encodeLinkTarget v = case v of
  DatabaseIdTarget { databaseId = d } -> { type = "database_id", database_id = d }
  PageIdTarget { pageId = p } -> { type = "page_id", page_id = p }


-- -------------------------------------------------------------------------
-- §15b. BlockContent — 33-arm variant
--
-- TS oracle: handlers/notion-codec.ts:447 (decodeBlockContent) + :628
-- (encodeBlockContent). The biggest single body in the codec arc.
--
-- Decoder wrapper input shape (per-field pre-decoding):
--   * type: String (wire dispatch key)
--   * rich_text: [RichText] (pre-mapped via dispatchedDecodeRichText)
--   * color: NotionColor (pre-decoded via dispatchedDecodeColor)
--   * children: [Block] (pre-mapped via dispatchedDecodeBlock RECURSIVELY)
--   * caption: [RichText] (pre-mapped)
--   * is_toggleable: Bool (asBool-coerced)
--   * checked: Bool (asBool-coerced)
--   * language: String (asStr-coerced)
--   * icon: Maybe<Icon> (Maybe-wrapped + pre-decoded via dispatchedDecodeIcon)
--   * expression: String
--   * title: String
--   * url: String
--   * target: LinkTarget (pre-decoded via dispatchedDecodeLinkTarget)
--   * file: NotionFile (pre-decoded via dispatchedDecodeNotionFile)
--   * name: String (for FileBlockContent)
--   * table_width: Number
--   * has_column_header: Bool
--   * has_row_header: Bool
--   * cells: [[RichText]] (nested-mapped — each cell pre-mapped)
--   * synced_from_block_id: Maybe<String> (Maybe-wrapped from
--     payload.synced_from?.block_id)
--
-- The body dispatches on `w.type` + constructs the typed BlockContent
-- variant directly. snake_case wire field names work as Fenel identifiers
-- (per the 2a SURPRISE 2 — the lexer accepts underscores).
--
-- NOTE: the TS oracle's `decodeBlockContent` reads payload at the top of
-- the function via `v[v.type]` (dynamic bracket access). That extraction
-- is awkward in Fenel — it requires runtime lookup of a key whose name
-- isn't known at parse time. Wrapper handles this TS-side; the body
-- operates on the already-flattened pre-shaped input.
--
-- The wire NEVER carries a BlockContent variant under e.g. `children` for
-- a Block — the children field on the wire is List<Block>, which contains
-- full Block records with their own content. The wrapper's `children`
-- pre-decoding maps via dispatchedDecodeBlock (NOT dispatchedDecodeBlockContent).
-- So `w.children` in the body is `[Block]`. The Block ADT carries the
-- BlockContent inline as its `content` field.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeBlockContent"
@description "Phase 11b sub-step 2d — decode a Notion block-content record to a BlockContent variant (the biggest single body in the codec series). 33-arm case-of on `w.type` covering paragraph + 3 headings + 2 list items + to_do + toggle + code + callout + quote + equation + divider + table_of_contents + breadcrumb + 2 child kinds + embed + bookmark + link_preview + link_to_page + 5 media (image/video/audio/file/pdf) + table + table_row + 2 column kinds + synced_block + template + unsupported fallback. The wrapper recursively pre-decodes EVERY nested value TS-side: [RichText] (rich_text / caption), NotionColor (color), [Block] (children — RECURSIVE via dispatchedDecodeBlock), Maybe<Icon> (callout's icon), LinkTarget (link_to_page's target), NotionFile (media file), [[RichText]] (table_row's nested cells), Maybe<String> (synced_block's syncedFromBlockId). The body reads pre-decoded fields directly + constructs the typed variant via the construct op. Default arm emits UnsupportedContent with the raw type string. Boundary adapter dispatched via `dispatchedDecodeBlockContent`. Mirrors runtime/src/handlers/notion-codec.ts:447."
@tags "notion" "codec" "block-content" "boundary" "phase-11b"
decodeBlockContent : (w: JsonValue) -> BlockContent
decodeBlockContent w = case w.type of
  "paragraph" -> ParagraphContent { richText = w.rich_text, color = w.color, children = w.children }
  "heading_1" -> Heading1Content { richText = w.rich_text, color = w.color, isToggleable = w.is_toggleable, children = w.children }
  "heading_2" -> Heading2Content { richText = w.rich_text, color = w.color, isToggleable = w.is_toggleable, children = w.children }
  "heading_3" -> Heading3Content { richText = w.rich_text, color = w.color, isToggleable = w.is_toggleable, children = w.children }
  "bulleted_list_item" -> BulletedListItemContent { richText = w.rich_text, color = w.color, children = w.children }
  "numbered_list_item" -> NumberedListItemContent { richText = w.rich_text, color = w.color, children = w.children }
  "to_do" -> ToDoContent { richText = w.rich_text, checked = w.checked, color = w.color, children = w.children }
  "toggle" -> ToggleContent { richText = w.rich_text, color = w.color, children = w.children }
  "code" -> CodeContent { richText = w.rich_text, caption = w.caption, language = w.language }
  "callout" -> CalloutContent { richText = w.rich_text, icon = w.icon, color = w.color, children = w.children }
  "quote" -> QuoteContent { richText = w.rich_text, color = w.color, children = w.children }
  "equation" -> EquationContent { expression = w.expression }
  "divider" -> DividerContent
  "table_of_contents" -> TableOfContentsContent { color = w.color }
  "breadcrumb" -> BreadcrumbContent
  "child_page" -> ChildPageContent { title = w.title }
  "child_database" -> ChildDatabaseContent { title = w.title }
  "embed" -> EmbedContent { url = w.url, caption = w.caption }
  "bookmark" -> BookmarkContent { url = w.url, caption = w.caption }
  "link_preview" -> LinkPreviewContent { url = w.url }
  "link_to_page" -> LinkToPageContent { target = w.target }
  "image" -> ImageContent { file = w.file, caption = w.caption }
  "video" -> VideoContent { file = w.file, caption = w.caption }
  "audio" -> AudioContent { file = w.file, caption = w.caption }
  "file" -> FileBlockContent { file = w.file, caption = w.caption, name = w.name }
  "pdf" -> PdfContent { file = w.file, caption = w.caption }
  "table" -> TableContent { tableWidth = w.table_width, hasColumnHeader = w.has_column_header, hasRowHeader = w.has_row_header, children = w.children }
  "table_row" -> TableRowContent { cells = w.cells }
  "column_list" -> ColumnListContent { children = w.children }
  "column" -> ColumnContent { children = w.children }
  "synced_block" -> SyncedBlockContent { syncedFromBlockId = w.synced_from_block_id, children = w.children }
  "template" -> TemplateContent { richText = w.rich_text, children = w.children }
  _ -> UnsupportedContent { kind = w.type }


-- -------------------------------------------------------------------------
-- encodeBlockContent — emit a flat marker record `{ _kind = "<wire_type>",
-- ...camelCase_payload }` for each variant. The wrapper finalize switches
-- on `_kind` + assembles the Notion wire shape with per-arm transformations.
--
-- Following 2c's `_wkind`-marker pattern: each marker is multi-field
-- (_kind + payload fields), so they never hit the single-key `{id=X}`
-- codeName dispatch path. DividerContent / BreadcrumbContent emit a
-- single-field `{ _kind = "..." }` — safe because `_kind` is not a std
-- function codeName.
--
-- The UnsupportedContent arm emits `{ _kind = "unsupported" }` without
-- reading the `kind` field — matches the TS oracle's
-- `{ object: "block", type: "unsupported", unsupported: {} }` default
-- (the kind string is informational, not round-tripped).
-- -------------------------------------------------------------------------

@label "notion-codec: encodeBlockContent"
@description "Phase 11b sub-step 2d — encode a BlockContent variant to the Notion wire-shape record. 33-arm case-of: each arm destructures + emits a FLAT marker record `{ _kind = \"<wire_type>\", ...camelCase_payload }`. The wrapper finalize switches on `_kind` + assembles the Notion wire shape `{ object: \"block\", type: <wire_type>, <wire_type>: { ...wire payload } }` with per-arm transformations: rich_text via dispatchedEncodeRichText (mapped), color via dispatchedEncodeColor, children via RECURSIVE dispatchedEncodeBlockContent (mapped), icon Maybe<Icon> → null|encodedIcon (CalloutContent), file/media payload assembly (5 media arms — encodeMediaPayload helper inlines NotionFile fields + caption), target via dispatchedEncodeLinkTarget (LinkToPageContent), synced_from Maybe<String> → null|{type, block_id} (SyncedBlockContent), nested cells map (TableRowContent). The marker-record approach AVOIDS the 2b `{ id = X }` codeName clash (each marker is multi-field — `_kind` + payload). DividerContent / BreadcrumbContent emit single-field `{ _kind = \"...\" }` — safe because `_kind` is not a std function codeName. UnsupportedContent emits `{ _kind = \"unsupported\" }` without round-tripping the kind string (matches TS oracle's lossy default). Boundary adapter dispatched via `dispatchedEncodeBlockContent`. Mirrors runtime/src/handlers/notion-codec.ts:628."
@tags "notion" "codec" "block-content" "boundary" "phase-11b"
encodeBlockContent : (v: BlockContent) -> JsonValue
encodeBlockContent v = case v of
  ParagraphContent { richText = rs, color = c, children = ch } ->
    { _kind = "paragraph", richText = rs, color = c, children = ch }
  Heading1Content { richText = rs, color = c, isToggleable = it, children = ch } ->
    { _kind = "heading_1", richText = rs, color = c, isToggleable = it, children = ch }
  Heading2Content { richText = rs, color = c, isToggleable = it, children = ch } ->
    { _kind = "heading_2", richText = rs, color = c, isToggleable = it, children = ch }
  Heading3Content { richText = rs, color = c, isToggleable = it, children = ch } ->
    { _kind = "heading_3", richText = rs, color = c, isToggleable = it, children = ch }
  BulletedListItemContent { richText = rs, color = c, children = ch } ->
    { _kind = "bulleted_list_item", richText = rs, color = c, children = ch }
  NumberedListItemContent { richText = rs, color = c, children = ch } ->
    { _kind = "numbered_list_item", richText = rs, color = c, children = ch }
  ToDoContent { richText = rs, checked = chk, color = c, children = ch } ->
    { _kind = "to_do", richText = rs, checked = chk, color = c, children = ch }
  ToggleContent { richText = rs, color = c, children = ch } ->
    { _kind = "toggle", richText = rs, color = c, children = ch }
  CodeContent { richText = rs, caption = cap, language = l } ->
    { _kind = "code", richText = rs, caption = cap, language = l }
  CalloutContent { richText = rs, icon = ic, color = c, children = ch } ->
    { _kind = "callout", richText = rs, icon = ic, color = c, children = ch }
  QuoteContent { richText = rs, color = c, children = ch } ->
    { _kind = "quote", richText = rs, color = c, children = ch }
  EquationContent { expression = e } ->
    { _kind = "equation", expression = e }
  DividerContent ->
    { _kind = "divider" }
  TableOfContentsContent { color = c } ->
    { _kind = "table_of_contents", color = c }
  BreadcrumbContent ->
    { _kind = "breadcrumb" }
  ChildPageContent { title = t } ->
    { _kind = "child_page", title = t }
  ChildDatabaseContent { title = t } ->
    { _kind = "child_database", title = t }
  EmbedContent { url = u, caption = cap } ->
    { _kind = "embed", url = u, caption = cap }
  BookmarkContent { url = u, caption = cap } ->
    { _kind = "bookmark", url = u, caption = cap }
  LinkPreviewContent { url = u } ->
    { _kind = "link_preview", url = u }
  LinkToPageContent { target = t } ->
    { _kind = "link_to_page", target = t }
  ImageContent { file = f, caption = cap } ->
    { _kind = "image", file = f, caption = cap }
  VideoContent { file = f, caption = cap } ->
    { _kind = "video", file = f, caption = cap }
  AudioContent { file = f, caption = cap } ->
    { _kind = "audio", file = f, caption = cap }
  FileBlockContent { file = f, caption = cap, name = n } ->
    { _kind = "file", file = f, caption = cap, name = n }
  PdfContent { file = f, caption = cap } ->
    { _kind = "pdf", file = f, caption = cap }
  TableContent { tableWidth = tw, hasColumnHeader = hch, hasRowHeader = hrh, children = ch } ->
    { _kind = "table", tableWidth = tw, hasColumnHeader = hch, hasRowHeader = hrh, children = ch }
  TableRowContent { cells = c } ->
    { _kind = "table_row", cells = c }
  ColumnListContent { children = ch } ->
    { _kind = "column_list", children = ch }
  ColumnContent { children = ch } ->
    { _kind = "column", children = ch }
  SyncedBlockContent { syncedFromBlockId = sfid, children = ch } ->
    { _kind = "synced_block", syncedFromBlockId = sfid, children = ch }
  TemplateContent { richText = rs, children = ch } ->
    { _kind = "template", richText = rs, children = ch }
  UnsupportedContent ->
    { _kind = "unsupported" }
  -- Catch-all for type-laundered values that aren't BlockContent variants.
  -- The TS oracle's decoder for container blocks (paragraph / heading_X /
  -- toggle / etc.) pre-decodes `payload.children` as `[Block]` (NOT
  -- `[BlockContent]`) — a pre-existing type lie in the original code. When
  -- a round-tripped Block value reaches this encoder, no explicit arm
  -- matches; the catch-all preserves the TS oracle's default-branch
  -- behavior of emitting `unsupported`. Same arm covers any future
  -- BlockContent variants added to the ADT but not yet to this case-of.
  _ -> { _kind = "unsupported" }


-- -------------------------------------------------------------------------
-- §15c. Block — flat record decoder
--
-- TS oracle: handlers/notion-codec.ts:743. Reads Notion's block-response
-- envelope (id + parent + created_time + last_edited_time + created_by +
-- last_edited_by + has_children + archived + in_trash) + recursively
-- decodes `content` from the FULL wire object `v` (NOT a sub-record —
-- decodeBlockContent reads `v.type` then `v[v.type]`).
--
-- The wrapper pre-decodes:
--   * parent: Parent (via dispatchedDecodeParent)
--   * created_by_user / last_edited_by_user: NotionUser (via
--     dispatchedDecodeNotionUser)
--   * content: BlockContent (via dispatchedDecodeBlockContent — RECURSIVE
--     into the mutually-recursive blocks/content tree)
--
-- The body shuttles snake_case wire fields → camelCase Fenel fields in
-- the Block constructor.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeBlock"
@description "Phase 11b sub-step 2d — decode a Notion block-response record to a Block value. Flat record decoder: shuttles snake_case wire fields (id / parent / created_time / last_edited_time / created_by_user / last_edited_by_user / has_children / archived / in_trash / content) into camelCase Block constructor fields. The wrapper pre-decodes parent (via dispatchedDecodeParent), the 2 NotionUser fields (via dispatchedDecodeNotionUser), and content (via dispatchedDecodeBlockContent — RECURSIVE into the mutually-recursive blocks/content tree). Per the TS oracle, decodeBlock passes the ENTIRE wire object to decodeBlockContent (not just a sub-record — decodeBlockContent reads `v.type` to dispatch). encodeBlock is intentionally OMITTED: Notion's write API never accepts a full Block on write (writes use BlockContent directly). Boundary adapter dispatched via `dispatchedDecodeBlock`. Mirrors runtime/src/handlers/notion-codec.ts:743."
@tags "notion" "codec" "block" "boundary" "phase-11b"
decodeBlock : (w: JsonValue) -> Block
decodeBlock w = Block {
  id = w.id,
  parent = w.parent,
  createdTime = w.created_time,
  lastEditedTime = w.last_edited_time,
  createdBy = w.created_by_user,
  lastEditedBy = w.last_edited_by_user,
  hasChildren = w.has_children,
  archived = w.archived,
  inTrash = w.in_trash,
  content = w.content
}


-- =========================================================================
-- Phase 11b sub-step 2e — §16-§17 of runtime/src/handlers/notion-codec.ts:
--
--   * §16a  Page              (flat-record decoder, 13 fields)
--   * §16b  Database          (flat-record decoder, 16 fields — Page +
--                              isInline + title + description + property
--                              schema)
--   * §16c  Comment           (flat-record decoder, 7 fields)
--   * §17a  PaginatedList<a>  (parametric over element type — wrapper
--                              handles element pre-decoding; body is a
--                              degenerate construction)
--   * §17b  SearchResult      (2-arm dispatch on wire `object` field)
--
-- 5 fnIds (decode-only — these are read-only response shapes; writes use
-- PropertyWrite / BlockContent / Filter / Sort handled in 2c/2d/2f).
--
-- Recipe matches 2a-2d but with simpler bodies: §16 + §17b are flat-record
-- decoders that COMPOSE already-Fenel-bodied helpers from 2a-2d via the
-- wrapper's pre-decoding pass (parent / createdBy / lastEditedBy /
-- icon / cover / properties / title / description / rich_text). §17a's
-- parametric-over-element-type is handled by the wrapper: the JS-side
-- caller supplies a `decodeItem` callback, the wrapper pre-decodes the
-- results list TS-side via the callback + the body constructs a flat
-- PaginatedList record from pre-decoded fields. The alternative — body
-- takes a Fenel function reference as a param — is more elegant but
-- requires function-marshalling at the boundary, not yet validated in
-- the codec arc.
--
-- The brief flagged a CommentParent vs Parent risk for §16c: per
-- types.fenel:390 Comment.parent is `Parent` (NOT CommentParent). The
-- TS oracle confirms via `decodeParent(v.parent)`. CommentParent is
-- write-side only (createComment input).
-- =========================================================================


-- -------------------------------------------------------------------------
-- §16a. Page — flat-record decoder
--
-- TS oracle: handlers/notion-codec.ts:448. 13 fields. The wrapper pre-
-- decodes 4 sub-records (parent + createdBy + lastEditedBy + properties)
-- + 2 Maybe-wrapped variant fields (icon + cover) + 1 Maybe-wrapped
-- string (publicUrl). The body shuttles fields through.
--
-- Note: the wire's `icon` and `cover` fields are nested wire records OR
-- null; per the TS oracle's `v.icon == null ? just(null) : just(decodeIcon
-- (v.icon))`, the Maybe carries a decoded Icon (Just) or null (Nothing).
-- Wrapper-side maybeDecode handles this.
-- -------------------------------------------------------------------------

@label "notion-codec: decodePage"
@description "Phase 11b sub-step 2e — decode a Notion page-response record to a Page value. Flat record decoder: shuttles 13 fields from the wire shape into the Page constructor. The wrapper pre-decodes parent (via dispatchedDecodeParent), createdBy + lastEditedBy (via dispatchedDecodeNotionUser), icon + cover (via maybeDecode + dispatchedDecodeIcon / dispatchedDecodeCover), properties (via dispatchedDecodePropertiesObject), and Maybe-wraps publicUrl. Boundary adapter dispatched via `dispatchedDecodePage`. Mirrors runtime/src/handlers/notion-codec.ts:448."
@tags "notion" "codec" "page" "boundary" "phase-11b"
decodePage : (w: JsonValue) -> Page
decodePage w = Page {
  id = w.id,
  parent = w.parent,
  createdTime = w.created_time,
  lastEditedTime = w.last_edited_time,
  createdBy = w.created_by_user,
  lastEditedBy = w.last_edited_by_user,
  archived = w.archived,
  inTrash = w.in_trash,
  icon = w.icon,
  cover = w.cover,
  properties = w.properties,
  url = w.url,
  publicUrl = w.public_url
}


-- -------------------------------------------------------------------------
-- §16b. Database — flat-record decoder
--
-- TS oracle: handlers/notion-codec.ts:468. Same shape as Page + isInline +
-- title + description + property schema. 16 fields total. The wrapper pre-
-- decodes the same Page sub-records + adds:
--   * title / description: [RichText] (via asListOf + dispatchedDecodeRichText)
--   * properties: [PropertySchemaEntry] (via dispatchedDecodePropertySchemaObject)
--   * isInline: Bool (via asBoolVal)
-- -------------------------------------------------------------------------

@label "notion-codec: decodeDatabase"
@description "Phase 11b sub-step 2e — decode a Notion database-response record to a Database value. Flat record decoder: shuttles 16 fields (Page shape + isInline + title + description + property schema) from the wire shape into the Database constructor. The wrapper pre-decodes the same fields as Page + maps title / description as [RichText] (via asListOf + dispatchedDecodeRichText), pre-decodes properties via dispatchedDecodePropertySchemaObject, asBool-coerces isInline. Boundary adapter dispatched via `dispatchedDecodeDatabase`. Mirrors runtime/src/handlers/notion-codec.ts:468."
@tags "notion" "codec" "database" "boundary" "phase-11b"
decodeDatabase : (w: JsonValue) -> Database
decodeDatabase w = Database {
  id = w.id,
  parent = w.parent,
  createdTime = w.created_time,
  lastEditedTime = w.last_edited_time,
  createdBy = w.created_by_user,
  lastEditedBy = w.last_edited_by_user,
  archived = w.archived,
  inTrash = w.in_trash,
  isInline = w.is_inline,
  title = w.title,
  description = w.description,
  icon = w.icon,
  cover = w.cover,
  properties = w.properties,
  url = w.url,
  publicUrl = w.public_url
}


-- -------------------------------------------------------------------------
-- §16c. Comment — flat-record decoder
--
-- TS oracle: handlers/notion-codec.ts:491. 7 fields. Simpler than Page —
-- no icon/cover/properties. Notable: parent uses dispatchedDecodeParent
-- (NOT decodeCommentParent — per types.fenel:390 Comment.parent is
-- `Parent`, not `CommentParent`). CommentParent is for write-side comment
-- creation only.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeComment"
@description "Phase 11b sub-step 2e — decode a Notion comment-response record to a Comment value. Flat record decoder: shuttles 7 fields (id / parent / discussion_id / created_time / last_edited_time / created_by / rich_text) into the Comment constructor. Notable: parent uses dispatchedDecodeParent (NOT dispatchedDecodeCommentParent — per types.fenel:390 Comment.parent is `Parent`, not `CommentParent`; CommentParent is write-side only for comment creation). The wrapper pre-decodes parent + createdBy (via dispatchedDecodeNotionUser) + richText (via asListOf + dispatchedDecodeRichText). Boundary adapter dispatched via `dispatchedDecodeComment`. Mirrors runtime/src/handlers/notion-codec.ts:491."
@tags "notion" "codec" "comment" "boundary" "phase-11b"
decodeComment : (w: JsonValue) -> Comment
decodeComment w = Comment {
  id = w.id,
  parent = w.parent,
  discussionId = w.discussion_id,
  createdTime = w.created_time,
  lastEditedTime = w.last_edited_time,
  createdBy = w.created_by_user,
  richText = w.rich_text
}


-- -------------------------------------------------------------------------
-- §17a. PaginatedList<a> — parametric over element type
--
-- TS oracle: handlers/notion-codec.ts:509. Generic over the element type
-- via a JS callback `decodeItem: (x: unknown) => T`. The body here is
-- DEGENERATE: it just constructs PaginatedList from pre-decoded fields.
-- The wrapper takes (v, decodeItem) and pre-decodes results TS-side via
-- the callback before invoking the body.
--
-- The alternative — pass the element decoder as a Fenel function reference
-- — is more elegant but requires marshalling a JS function into a Fenel
-- callable, which we haven't validated in the codec arc. The wrapper-side
-- approach matches the wrapper-pre-decoding pattern from 2c (Object.entries
-- walk for decodePropertiesObject) + 2d (recursive blocks tree).
--
-- The body's degenerate shape is matrix-visible + Fenel-callable per the
-- 2a NotionDate precedent (degenerate body justified by surface-visibility
-- consistency across the codec arc).
-- -------------------------------------------------------------------------

@label "notion-codec: decodePaginatedList"
@description "Phase 11b sub-step 2e — decode a Notion paginated-list response to a PaginatedList<a> value. Parametric over the element type: the wrapper takes a JS callback `decodeItem: (x: unknown) => unknown` + pre-decodes results TS-side via that callback before invoking the body. The body is DEGENERATE (constructs PaginatedList from pre-decoded fields). The wrapper-pre-decoding approach matches the pattern from 2c (Object.entries walk for decodePropertiesObject). The alternative — pass the element decoder as a Fenel function reference — requires marshalling a JS function into a Fenel callable, not yet validated in the codec arc. Degenerate body justified by surface-visibility consistency (matrix-tracked, Fenel-callable). Boundary adapter dispatched via `dispatchedDecodePaginatedList`. Mirrors runtime/src/handlers/notion-codec.ts:509."
@tags "notion" "codec" "paginated-list" "boundary" "phase-11b"
decodePaginatedList : (w: JsonValue) -> PaginatedList JsonValue
decodePaginatedList w = PaginatedList {
  results = w.results,
  nextCursor = w.next_cursor,
  hasMore = w.has_more
}


-- -------------------------------------------------------------------------
-- §17b. SearchResult — 2-arm dispatch
--
-- TS oracle: handlers/notion-codec.ts:523. Dispatches on wire `v.object`
-- ("database" -> DatabaseResult; default -> PageResult). The wrapper
-- conditionally pre-decodes ONLY the matching variant (Database vs Page)
-- to avoid wasted work. The body's case-of reads the pre-decoded
-- `database` / `page` field for the matching arm.
--
-- The fallback case in the TS oracle: when `v` is not a plain object, it
-- returns `PageResult { page: decodePage({}) }` — an empty Page. The
-- wrapper pre-decodes an empty Page in `w.page` for that case + the body's
-- default arm constructs PageResult from it.
-- -------------------------------------------------------------------------

@label "notion-codec: decodeSearchResult"
@description "Phase 11b sub-step 2e — decode a Notion search-response record (Page or Database) to a SearchResult variant. 2-arm case-of on wire `w.object` (\"database\" -> DatabaseResult; default -> PageResult). The wrapper conditionally pre-decodes ONLY the matching variant (Database vs Page) to avoid wasted work. The fallback case (non-object input) decodes an empty Page in `w.page` + the body's default arm constructs PageResult from it (matches TS oracle's `PageResult { page: decodePage({}) }`). Boundary adapter dispatched via `dispatchedDecodeSearchResult`. Mirrors runtime/src/handlers/notion-codec.ts:523."
@tags "notion" "codec" "search-result" "boundary" "phase-11b"
decodeSearchResult : (w: JsonValue) -> SearchResult
decodeSearchResult w = case w.object of
  "database" -> DatabaseResult { database = w.database }
  _ -> PageResult { page = w.page }


-- =========================================================================
-- Phase 11b sub-step 2f — §18-§19 of runtime/src/handlers/notion-codec.ts:
--
--   * §18a  Per-property condition encoders (9 fnIds):
--             encodeTextCondition / encodeNumberCondition /
--             encodeCheckboxCondition / encodeSelectCondition /
--             encodeMultiSelectCondition / encodeDateCondition /
--             encodePeopleCondition / encodeFilesCondition /
--             encodeRelationCondition
--   * §18b  Composite condition encoders (2 fnIds):
--             encodeFormulaCondition / encodeRollupCondition
--   * §18c  encodeFilter (1 fnId; 22-arm dispatch + recursive And/Or via
--             wrapper-side TS recursion — same pattern as 2d's
--             encodeBlockContent recursing into children)
--   * §19a  encodeSort (1 fnId; 2-arm dispatch)
--   * §19b  encodeSearchObjectFilter / encodeSearchSort (2 fnIds)
--
-- 15 fnIds total. The FINAL slice of the codec arc — after this lands,
-- notion-codec.ts is fully Fenel-bodied end-to-end.
--
-- **MARKER CONVENTION REQUIRED** (not optional). Pre-flight grep
-- confirmed `contains`, `none`, `and`, `or`, `filter`, `sort` ARE std
-- codeNames. Direct single-field record literals like `{ contains = x }`
-- would hit the json-logic.ts:441 single-key dispatch path and be
-- interpreted as a CALL to std:contains, returning a non-record value.
-- The marker pattern emits multi-field records `{ _op = "<wire_op>",
-- value = X }` or single-field `{ _op = "is_empty" }` (safe because
-- `_op` is not a std codeName). The wrapper's finalizeConditionWire
-- post-processor converts the marker to the dynamic-key wire shape
-- `{ [op]: value }` or `{ [op]: true }`.
--
-- The catch-all `_ -> { _op = "" }` arm matches 2d's pattern for type-
-- laundered values: each encoder's case-of ends with a catch-all so
-- the wrapper's `if (op === "") return {};` matches the TS oracle's
-- `if (!wireOp) return {};` fall-through behavior.
--
-- For composite encoders (Formula / Rollup) + Filter, the body emits
-- `{ _kind = "<outer_key>", ... }` markers with sub-condition / sub-
-- filter / property values; the wrapper switches on `_kind` + calls
-- the appropriate inner encoder via dispatchedEncode* recursively.
--
-- encodeFilter's recursive And/Or: the body emits
-- `{ _kind = "and"|"or", filters = fs }` with the unencoded filter list;
-- the wrapper recursively maps each via dispatchedEncodeFilter.
-- Same wrapper-side TS recursion as 2d's encodeBlockContent.
-- =========================================================================


-- -------------------------------------------------------------------------
-- §18a. Per-property condition encoders — 9 fnIds
--
-- Each emits a flat marker `{ _op = "<wire_op>", value = X }` (for
-- variants with a value field) or `{ _op = "<wire_op>" }` (for no-arg
-- variants like *IsEmpty / *IsNotEmpty / DatePastWeek / etc.). The
-- wrapper's finalizeConditionWire converts to `{ [op]: value }` or
-- `{ [op]: true }`.
--
-- TS oracle pattern (notion-codec.ts:495 encodeCondition + op-map
-- tables TEXT_OPS / NUMBER_OPS / etc.): tag → wire_op via lookup +
-- `v.value !== undefined ? { [op]: v.value } : { [op]: true }`. The
-- Fenel translation inlines the per-variant arms.
--
-- PeopleCondition / RelationCondition note their value field
-- differently (`userId` / `pageId`); the body translates to `value`
-- for unified wrapper handling.
-- -------------------------------------------------------------------------

@label "notion-codec: encodeTextCondition"
@description "Phase 11b sub-step 2f — encode a TextCondition variant to a Notion wire-shape record `{ [op]: value }` or `{ [op]: true }`. 8-arm case-of mapping each variant to a marker `{ _op = \"<wire_op>\", value = x }` (for variants with a value field) or `{ _op = \"<wire_op>\" }` (for the no-arg *IsEmpty / *IsNotEmpty variants); the wrapper's finalizeConditionWire converts the marker to the dynamic-key wire shape. Marker convention used because `contains` is a std codeName (clashes with single-field record literal dispatch). Boundary adapter dispatched via `dispatchedEncodeTextCondition`. Mirrors runtime/src/handlers/notion-codec.ts:583 (encodeTextCondition + TEXT_OPS table)."
@tags "notion" "codec" "text-condition" "boundary" "phase-11b"
encodeTextCondition : (v: TextCondition) -> JsonValue
encodeTextCondition v = case v of
  TextEquals { value = x } -> { _op = "equals", value = x }
  TextDoesNotEqual { value = x } -> { _op = "does_not_equal", value = x }
  TextContains { value = x } -> { _op = "contains", value = x }
  TextDoesNotContain { value = x } -> { _op = "does_not_contain", value = x }
  TextStartsWith { value = x } -> { _op = "starts_with", value = x }
  TextEndsWith { value = x } -> { _op = "ends_with", value = x }
  TextIsEmpty -> { _op = "is_empty" }
  TextIsNotEmpty -> { _op = "is_not_empty" }
  _ -> { _op = "" }

@label "notion-codec: encodeNumberCondition"
@description "Phase 11b sub-step 2f — encode a NumberCondition variant to a Notion wire-shape record. 8-arm case-of with the marker-record convention. Boundary adapter dispatched via `dispatchedEncodeNumberCondition`. Mirrors runtime/src/handlers/notion-codec.ts:584 (encodeNumberCondition + NUMBER_OPS table)."
@tags "notion" "codec" "number-condition" "boundary" "phase-11b"
encodeNumberCondition : (v: NumberCondition) -> JsonValue
encodeNumberCondition v = case v of
  NumberEquals { value = x } -> { _op = "equals", value = x }
  NumberDoesNotEqual { value = x } -> { _op = "does_not_equal", value = x }
  NumberGreaterThan { value = x } -> { _op = "greater_than", value = x }
  NumberLessThan { value = x } -> { _op = "less_than", value = x }
  NumberGreaterThanOrEqualTo { value = x } -> { _op = "greater_than_or_equal_to", value = x }
  NumberLessThanOrEqualTo { value = x } -> { _op = "less_than_or_equal_to", value = x }
  NumberIsEmpty -> { _op = "is_empty" }
  NumberIsNotEmpty -> { _op = "is_not_empty" }
  _ -> { _op = "" }

@label "notion-codec: encodeCheckboxCondition"
@description "Phase 11b sub-step 2f — encode a CheckboxCondition variant to a Notion wire-shape record. 2-arm case-of with the marker-record convention. The value field carries a Bool (True/False). Boundary adapter dispatched via `dispatchedEncodeCheckboxCondition`. Mirrors runtime/src/handlers/notion-codec.ts:585 (encodeCheckboxCondition + CHECKBOX_OPS table)."
@tags "notion" "codec" "checkbox-condition" "boundary" "phase-11b"
encodeCheckboxCondition : (v: CheckboxCondition) -> JsonValue
encodeCheckboxCondition v = case v of
  CheckboxEquals { value = x } -> { _op = "equals", value = x }
  CheckboxDoesNotEqual { value = x } -> { _op = "does_not_equal", value = x }
  _ -> { _op = "" }

@label "notion-codec: encodeSelectCondition"
@description "Phase 11b sub-step 2f — encode a SelectCondition variant to a Notion wire-shape record. 4-arm case-of with the marker-record convention. Reused by StatusFilter via the wrapper's wireKind dispatch (StatusFilter's condition is also a SelectCondition wire-side). Boundary adapter dispatched via `dispatchedEncodeSelectCondition`. Mirrors runtime/src/handlers/notion-codec.ts:586 (encodeSelectCondition + SELECT_OPS table)."
@tags "notion" "codec" "select-condition" "boundary" "phase-11b"
encodeSelectCondition : (v: SelectCondition) -> JsonValue
encodeSelectCondition v = case v of
  SelectEquals { value = x } -> { _op = "equals", value = x }
  SelectDoesNotEqual { value = x } -> { _op = "does_not_equal", value = x }
  SelectIsEmpty -> { _op = "is_empty" }
  SelectIsNotEmpty -> { _op = "is_not_empty" }
  _ -> { _op = "" }

@label "notion-codec: encodeMultiSelectCondition"
@description "Phase 11b sub-step 2f — encode a MultiSelectCondition variant to a Notion wire-shape record. 4-arm case-of with the marker-record convention. Boundary adapter dispatched via `dispatchedEncodeMultiSelectCondition`. Mirrors runtime/src/handlers/notion-codec.ts:587 (encodeMultiSelectCondition + MULTI_SELECT_OPS table)."
@tags "notion" "codec" "multi-select-condition" "boundary" "phase-11b"
encodeMultiSelectCondition : (v: MultiSelectCondition) -> JsonValue
encodeMultiSelectCondition v = case v of
  MultiSelectContains { value = x } -> { _op = "contains", value = x }
  MultiSelectDoesNotContain { value = x } -> { _op = "does_not_contain", value = x }
  MultiSelectIsEmpty -> { _op = "is_empty" }
  MultiSelectIsNotEmpty -> { _op = "is_not_empty" }
  _ -> { _op = "" }

@label "notion-codec: encodeDateCondition"
@description "Phase 11b sub-step 2f — encode a DateCondition variant to a Notion wire-shape record. 14-arm case-of with the marker-record convention (5 variants with value + 7 relative-date no-arg variants like past_week / next_month / this_week + 2 *IsEmpty / *IsNotEmpty). Reused by CreatedTimeFilter / LastEditedTimeFilter / TimestampFilter via the wrapper's wireKind dispatch. Boundary adapter dispatched via `dispatchedEncodeDateCondition`. Mirrors runtime/src/handlers/notion-codec.ts:588 (encodeDateCondition + DATE_OPS table)."
@tags "notion" "codec" "date-condition" "boundary" "phase-11b"
encodeDateCondition : (v: DateCondition) -> JsonValue
encodeDateCondition v = case v of
  DateEquals { value = x } -> { _op = "equals", value = x }
  DateBefore { value = x } -> { _op = "before", value = x }
  DateAfter { value = x } -> { _op = "after", value = x }
  DateOnOrBefore { value = x } -> { _op = "on_or_before", value = x }
  DateOnOrAfter { value = x } -> { _op = "on_or_after", value = x }
  DatePastWeek -> { _op = "past_week" }
  DatePastMonth -> { _op = "past_month" }
  DatePastYear -> { _op = "past_year" }
  DateThisWeek -> { _op = "this_week" }
  DateNextWeek -> { _op = "next_week" }
  DateNextMonth -> { _op = "next_month" }
  DateNextYear -> { _op = "next_year" }
  DateIsEmpty -> { _op = "is_empty" }
  DateIsNotEmpty -> { _op = "is_not_empty" }
  _ -> { _op = "" }

@label "notion-codec: encodePeopleCondition"
@description "Phase 11b sub-step 2f — encode a PeopleCondition variant to a Notion wire-shape record. 4-arm case-of with the marker-record convention. NOTE: PeopleContains / PeopleDoesNotContain have a `userId` field (not `value`); the body translates `userId` to `value` in the emitted marker so the shared finalizeConditionWire helper handles both PeopleCondition + the other 8 condition encoders identically. Reused by CreatedByFilter / LastEditedByFilter via the wrapper's wireKind dispatch. Boundary adapter dispatched via `dispatchedEncodePeopleCondition`. Mirrors runtime/src/handlers/notion-codec.ts:589 (encodePeopleCondition + PEOPLE_OPS table)."
@tags "notion" "codec" "people-condition" "boundary" "phase-11b"
encodePeopleCondition : (v: PeopleCondition) -> JsonValue
encodePeopleCondition v = case v of
  PeopleContains { userId = u } -> { _op = "contains", value = u }
  PeopleDoesNotContain { userId = u } -> { _op = "does_not_contain", value = u }
  PeopleIsEmpty -> { _op = "is_empty" }
  PeopleIsNotEmpty -> { _op = "is_not_empty" }
  _ -> { _op = "" }

@label "notion-codec: encodeFilesCondition"
@description "Phase 11b sub-step 2f — encode a FilesCondition variant to a Notion wire-shape record. 2-arm case-of with the marker-record convention. Both variants are no-arg (FilesIsEmpty / FilesIsNotEmpty). Boundary adapter dispatched via `dispatchedEncodeFilesCondition`. Mirrors runtime/src/handlers/notion-codec.ts:599 (encodeFilesCondition + FILES_OPS table)."
@tags "notion" "codec" "files-condition" "boundary" "phase-11b"
encodeFilesCondition : (v: FilesCondition) -> JsonValue
encodeFilesCondition v = case v of
  FilesIsEmpty -> { _op = "is_empty" }
  FilesIsNotEmpty -> { _op = "is_not_empty" }
  _ -> { _op = "" }

@label "notion-codec: encodeRelationCondition"
@description "Phase 11b sub-step 2f — encode a RelationCondition variant to a Notion wire-shape record. 4-arm case-of with the marker-record convention. NOTE: RelationContains / RelationDoesNotContain have a `pageId` field (not `value`); same translation pattern as PeopleCondition. Boundary adapter dispatched via `dispatchedEncodeRelationCondition`. Mirrors runtime/src/handlers/notion-codec.ts:600 (encodeRelationCondition + RELATION_OPS table)."
@tags "notion" "codec" "relation-condition" "boundary" "phase-11b"
encodeRelationCondition : (v: RelationCondition) -> JsonValue
encodeRelationCondition v = case v of
  RelationContains { pageId = p } -> { _op = "contains", value = p }
  RelationDoesNotContain { pageId = p } -> { _op = "does_not_contain", value = p }
  RelationIsEmpty -> { _op = "is_empty" }
  RelationIsNotEmpty -> { _op = "is_not_empty" }
  _ -> { _op = "" }


-- -------------------------------------------------------------------------
-- §18b. Composite condition encoders — FormulaCondition + RollupCondition
--
-- TS oracle: notion-codec.ts:618 (encodeFormulaCondition) + :633
-- (encodeRollupCondition). The outer wire key indicates which inner
-- condition to encode. The Fenel body emits a marker
-- `{ _kind = "<outer_key>", inner = c }` (or `{ _kind = "<outer_key>",
-- filter = f }` for RollupAny/Every/None which contain a Filter not
-- a Condition); the wrapper switches on `_kind` + calls the matching
-- inner encoder (dispatchedEncodeTextCondition / dispatchedEncodeNumberCondition
-- / etc. for FormulaCondition; dispatchedEncodeFilter for the 3 Rollup
-- compound arms — RECURSIVE into the filter tree).
--
-- This is the only place where the recursion crosses an encoder
-- boundary (RollupCondition → Filter → can contain RollupFilter →
-- RollupCondition again). The wrapper-side TS recursion handles it
-- transparently — same pattern as 2d's encodeBlockContent recursing
-- into children, but here the recursion crosses TWO dispatched* wrappers.
-- -------------------------------------------------------------------------

@label "notion-codec: encodeFormulaCondition"
@description "Phase 11b sub-step 2f — encode a FormulaCondition variant to a Notion wire-shape record. 4-arm case-of dispatching on outer formula-result-type (string / checkbox / number / date) + the inner condition; emits a `{ _kind = \"<outer_key>\", inner = c }` marker that the wrapper finalizes by dispatching to the matching inner encoder (dispatchedEncodeTextCondition / dispatchedEncodeCheckboxCondition / dispatchedEncodeNumberCondition / dispatchedEncodeDateCondition). Boundary adapter dispatched via `dispatchedEncodeFormulaCondition`. Mirrors runtime/src/handlers/notion-codec.ts:618."
@tags "notion" "codec" "formula-condition" "boundary" "phase-11b"
encodeFormulaCondition : (v: FormulaCondition) -> JsonValue
encodeFormulaCondition v = case v of
  FormulaText { condition = c } -> { _kind = "string", inner = c }
  FormulaCheckbox { condition = c } -> { _kind = "checkbox", inner = c }
  FormulaNumber { condition = c } -> { _kind = "number", inner = c }
  FormulaDate { condition = c } -> { _kind = "date", inner = c }
  _ -> { _kind = "" }

@label "notion-codec: encodeRollupCondition"
@description "Phase 11b sub-step 2f — encode a RollupCondition variant to a Notion wire-shape record. 5-arm case-of: 3 compound arms (RollupAny / RollupEvery / RollupNone) contain a Filter — wrapper finalizes by recursively calling dispatchedEncodeFilter (the only place in the codec arc where recursion crosses TWO dispatched* wrappers — RollupCondition → Filter → can contain RollupFilter → RollupCondition again); 2 scalar arms (RollupNumber / RollupDate) contain a sub-condition handled like FormulaCondition. Same `{ _kind = ..., filter = f | inner = c }` marker shape as FormulaCondition. Boundary adapter dispatched via `dispatchedEncodeRollupCondition`. Mirrors runtime/src/handlers/notion-codec.ts:633."
@tags "notion" "codec" "rollup-condition" "boundary" "phase-11b"
encodeRollupCondition : (v: RollupCondition) -> JsonValue
encodeRollupCondition v = case v of
  RollupAny { filter = f } -> { _kind = "any", filter = f }
  RollupEvery { filter = f } -> { _kind = "every", filter = f }
  RollupNone { filter = f } -> { _kind = "none", filter = f }
  RollupNumber { condition = c } -> { _kind = "number", inner = c }
  RollupDate { condition = c } -> { _kind = "date", inner = c }
  _ -> { _kind = "" }


-- -------------------------------------------------------------------------
-- §18c. encodeFilter — 22-arm dispatch + recursive And/Or
--
-- TS oracle: notion-codec.ts:650. The biggest body in this sub-step:
-- 22 variants of Filter, 2 of which (AndFilter / OrFilter) recurse into
-- nested filters, 1 (TimestampFilter) takes a TimestampField instead
-- of a property name, and the remaining 19 are per-property arms
-- mapping to one of the 9 per-property condition encoders.
--
-- The body emits one of three marker shapes:
--   * `{ _kind = "and"|"or", filters = fs }` — wrapper recursively
--     maps each via dispatchedEncodeFilter
--   * `{ _kind = "prop", property = p, wireKind = "<key>", condition = c }`
--     — wrapper switches on wireKind to pick the right inner encoder
--   * `{ _kind = "timestamp", timestamp = t, condition = c }` — wrapper
--     encodes t TS-side + uses the encoded string as BOTH the
--     `timestamp` value AND the dynamic key for the encoded condition
--
-- The wireKind → sub-encoder mapping is in the wrapper's
-- encodeConditionForWireKind switch (13 cases mapping to the 9
-- per-property + 2 composite encoders). Per the brief, this is a
-- single-purpose dispatch table that lives wrapper-side.
-- -------------------------------------------------------------------------

@label "notion-codec: encodeFilter"
@description "Phase 11b sub-step 2f — encode a Filter variant to a Notion query-database filter record. 22-arm case-of dispatching on Filter variant: AndFilter / OrFilter emit `{ _kind = \"and\"|\"or\", filters = fs }` (wrapper recursively maps each filter via dispatchedEncodeFilter — wrapper-side TS recursion same as 2d's encodeBlockContent); 19 per-property arms emit `{ _kind = \"prop\", property = p, wireKind = \"<key>\", condition = c }` (wrapper switches on wireKind to pick one of the 9 per-property condition encoders + 2 composite condition encoders); TimestampFilter emits `{ _kind = \"timestamp\", timestamp = t, condition = c }` (wrapper encodes timestamp via dispatchedEncodeTimestampField + uses the encoded string as BOTH the wire value AND the dynamic key for the encoded DateCondition). Boundary adapter dispatched via `dispatchedEncodeFilter`. Mirrors runtime/src/handlers/notion-codec.ts:650."
@tags "notion" "codec" "filter" "recursive" "boundary" "phase-11b"
encodeFilter : (v: Filter) -> JsonValue
encodeFilter v = case v of
  AndFilter { filters = fs } -> { _kind = "and", filters = fs }
  OrFilter { filters = fs } -> { _kind = "or", filters = fs }
  TitleFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "title", condition = c }
  RichTextFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "rich_text", condition = c }
  UrlFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "url", condition = c }
  EmailFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "email", condition = c }
  PhoneNumberFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "phone_number", condition = c }
  NumberFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "number", condition = c }
  CheckboxFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "checkbox", condition = c }
  SelectFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "select", condition = c }
  MultiSelectFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "multi_select", condition = c }
  StatusFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "status", condition = c }
  DateFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "date", condition = c }
  PeopleFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "people", condition = c }
  FilesFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "files", condition = c }
  RelationFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "relation", condition = c }
  FormulaFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "formula", condition = c }
  RollupFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "rollup", condition = c }
  CreatedByFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "created_by", condition = c }
  LastEditedByFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "last_edited_by", condition = c }
  CreatedTimeFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "created_time", condition = c }
  LastEditedTimeFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "last_edited_time", condition = c }
  UniqueIdFilter { property = p, condition = c } ->
    { _kind = "prop", property = p, wireKind = "unique_id", condition = c }
  TimestampFilter { timestamp = t, condition = c } ->
    { _kind = "timestamp", timestamp = t, condition = c }
  _ -> { _kind = "" }


-- -------------------------------------------------------------------------
-- §19a. encodeSort — 2-arm dispatch
--
-- TS oracle: notion-codec.ts:693. Body emits marker + wrapper assembles
-- the wire shape via dispatchedEncodeTimestampField + dispatchedEncodeSortDirection.
-- -------------------------------------------------------------------------

@label "notion-codec: encodeSort"
@description "Phase 11b sub-step 2f — encode a Sort variant to a Notion query-database sort record. 2-arm case-of: TimestampSort emits `{ _kind = \"timestamp\", timestamp = t, direction = d }` (wrapper encodes timestamp via dispatchedEncodeTimestampField + direction via dispatchedEncodeSortDirection); PropertySort emits `{ _kind = \"property\", property = p, direction = d }` (wrapper passes property string through + encodes direction). Boundary adapter dispatched via `dispatchedEncodeSort`. Mirrors runtime/src/handlers/notion-codec.ts:693."
@tags "notion" "codec" "sort" "boundary" "phase-11b"
encodeSort : (v: Sort) -> JsonValue
encodeSort v = case v of
  TimestampSort { timestamp = t, direction = d } ->
    { _kind = "timestamp", timestamp = t, direction = d }
  PropertySort { property = p, direction = d } ->
    { _kind = "property", property = p, direction = d }
  _ -> { _kind = "" }


-- -------------------------------------------------------------------------
-- §19b. encodeSearchObjectFilter / encodeSearchSort
--
-- TS oracle: notion-codec.ts:714 + :726.
--
-- encodeSearchObjectFilter: 3-arm dispatch. The TS oracle returns
-- `undefined` for SearchAllObjects (the search handler omits the
-- `filter` field entirely when this value is absent). The body emits
-- `{ _kind = "page"|"database" }` for the present cases + `{ _kind = "" }`
-- for SearchAllObjects + the catch-all; the wrapper converts the
-- marker to `{ value, property: "object" }` or `undefined`.
--
-- encodeSearchSort: degenerate single variant. The Fenel ADT has 1
-- variant (SearchSortByLastEdited direction) but the TS oracle
-- hardcodes `timestamp: "last_edited_time"`. The body emits the
-- direction + wrapper assembles the final shape with the hardcoded
-- timestamp.
-- -------------------------------------------------------------------------

@label "notion-codec: encodeSearchObjectFilter"
@description "Phase 11b sub-step 2f — encode a SearchObjectFilter variant to either a Notion search-filter wire record `{ value, property: \"object\" }` OR undefined (when filter is SearchAllObjects, the search handler omits the filter field entirely). 3-arm case-of: SearchOnlyPages emits `{ _kind = \"page\" }`; SearchOnlyDatabases emits `{ _kind = \"database\" }`; SearchAllObjects + catch-all emit `{ _kind = \"\" }` (the wrapper's `if (kind === \"\") return undefined;` finalize converts to JS undefined). Boundary adapter dispatched via `dispatchedEncodeSearchObjectFilter`. Mirrors runtime/src/handlers/notion-codec.ts:714."
@tags "notion" "codec" "search-filter" "boundary" "phase-11b"
encodeSearchObjectFilter : (v: SearchObjectFilter) -> JsonValue
encodeSearchObjectFilter v = case v of
  SearchOnlyPages -> { _kind = "page" }
  SearchOnlyDatabases -> { _kind = "database" }
  SearchAllObjects -> { _kind = "" }
  _ -> { _kind = "" }

@label "notion-codec: encodeSearchSort"
@description "Phase 11b sub-step 2f — encode a SearchSort variant to a Notion search-sort wire record `{ timestamp: \"last_edited_time\", direction: <encoded> }`. Degenerate single-variant ADT: SearchSortByLastEdited emits `{ direction = d }` + the catch-all emits `{ direction = Ascending }` fallback; the wrapper hardcodes `timestamp: \"last_edited_time\"` (matching the TS oracle) + encodes the direction via dispatchedEncodeSortDirection. Boundary adapter dispatched via `dispatchedEncodeSearchSort`. Mirrors runtime/src/handlers/notion-codec.ts:726."
@tags "notion" "codec" "search-sort" "boundary" "phase-11b"
encodeSearchSort : (v: SearchSort) -> JsonValue
encodeSearchSort v = case v of
  SearchSortByLastEdited { direction = d } -> { direction = d }
  _ -> { direction = Ascending }
