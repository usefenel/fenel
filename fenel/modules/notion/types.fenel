module notion where

-- =========================================================================
-- Notion API types — typed mirror of the Notion REST API surface
-- (https://developers.notion.com/reference). Names follow the Notion docs;
-- shared-but-generic names (User, Date, Color, File) are prefixed `Notion*`
-- to avoid catalog collision with other modules (e.g. telegram's User).
--
-- Records (single constructor, all named fields) may be compact or use
-- indented field continuations. Variants use leading `|` for multiline peers.
-- =========================================================================


-- -------------------------------------------------------------------------
-- Colors — the palette Notion uses for text annotations, block colors,
-- select option chips, and database property hues.
-- -------------------------------------------------------------------------

NotionColor = ColorDefault
  | Gray | Brown | Orange | Yellow | Green | Blue | Purple | Pink | Red
  | GrayBackground | BrownBackground | OrangeBackground | YellowBackground
  | GreenBackground | BlueBackground | PurpleBackground | PinkBackground | RedBackground


-- -------------------------------------------------------------------------
-- Rich-text annotations + dates
-- -------------------------------------------------------------------------

Annotations = Annotations bold: Boolean italic: Boolean strikethrough: Boolean underline: Boolean code: Boolean color: NotionColor

NotionDate = NotionDate start: String end: Maybe<String> timeZone: Maybe<String>


-- -------------------------------------------------------------------------
-- Parent — every Notion object has a parent that locates it in the
-- workspace tree.
-- -------------------------------------------------------------------------

Parent = PageParent pageId: String
  | DatabaseParent databaseId: String
  | WorkspaceParent
  | BlockParent blockId: String


-- -------------------------------------------------------------------------
-- Files, icons, covers — Notion distinguishes external links from files
-- hosted by Notion. The expiry only applies to Notion-hosted URLs.
-- -------------------------------------------------------------------------

NotionFile = ExternalFile url: String expiryTime: Maybe<String>
  | UploadedFile url: String expiryTime: Maybe<String>

Icon = EmojiIcon emoji: String
  | ExternalIcon url: String
  | UploadedIcon url: String expiryTime: Maybe<String>

Cover = ExternalCover url: String
  | UploadedCover url: String expiryTime: Maybe<String>


-- -------------------------------------------------------------------------
-- Users — Notion users are either people (humans with an email) or bots
-- (integrations). Partial form (id-only) shows up in mentions, comments,
-- and people-property values when the integration lacks user-info scope.
-- -------------------------------------------------------------------------

BotOwner = WorkspaceOwner | UserOwner userId: String

BotInfo = BotInfo owner: Maybe<BotOwner> workspaceName: Maybe<String>

NotionUser = PersonUser id: String name: Maybe<String> avatarUrl: Maybe<String> email: Maybe<String>
  | BotUser id: String name: Maybe<String> avatarUrl: Maybe<String> info: BotInfo
  | PartialUser id: String


-- -------------------------------------------------------------------------
-- Mentions — every mention variant is what shows up inline inside a
-- RichTextMention element.
-- -------------------------------------------------------------------------

TemplateMention = TemplateMentionDate value: String | TemplateMentionUser value: String

LinkPreviewMention = LinkPreviewMention url: String

Mention = UserMention user: NotionUser
  | PageMention pageId: String
  | DatabaseMention databaseId: String
  | DateMention date: NotionDate
  | TemplateMentionM template: TemplateMention
  | LinkPreviewMentionM linkPreview: LinkPreviewMention
  | LinkMention url: String


-- -------------------------------------------------------------------------
-- RichText — Notion's inline text primitive. Every block that holds text
-- carries a [RichText] list, where each element is one styled span. The
-- annotations + plainText + href fields are shared across all variants.
-- -------------------------------------------------------------------------

RichText = RichTextText content: String link: Maybe<String> annotations: Annotations plainText: String href: Maybe<String>
  | RichTextMention mention: Mention annotations: Annotations plainText: String href: Maybe<String>
  | RichTextEquation expression: String annotations: Annotations plainText: String href: Maybe<String>


-- -------------------------------------------------------------------------
-- Database property schema — what a database column DECLARES. One entry
-- per type Notion supports. Page-side values are PropertyValue (below).
-- -------------------------------------------------------------------------

SelectOption = SelectOption id: String name: String color: NotionColor description: Maybe<String>

StatusGroup = StatusGroup id: String name: String color: NotionColor optionIds: [String]

NumberFormat = NumberFormat name: String

RelationKind = SinglePropertyRelation
  | DualPropertyRelation syncedPropertyName: String syncedPropertyId: String

Property = TitleProperty id: String name: String
  | RichTextProperty id: String name: String
  | NumberProperty id: String name: String format: NumberFormat
  | SelectProperty id: String name: String options: [SelectOption]
  | MultiSelectProperty id: String name: String options: [SelectOption]
  | StatusProperty id: String name: String options: [SelectOption] groups: [StatusGroup]
  | DateProperty id: String name: String
  | PeopleProperty id: String name: String
  | FilesProperty id: String name: String
  | CheckboxProperty id: String name: String
  | UrlProperty id: String name: String
  | EmailProperty id: String name: String
  | PhoneNumberProperty id: String name: String
  | FormulaProperty id: String name: String expression: String
  | RelationProperty id: String name: String databaseId: String kind: RelationKind
  | RollupProperty id: String name: String relationPropertyName: String rollupPropertyName: String relationPropertyId: String rollupPropertyId: String function: String
  | CreatedTimeProperty id: String name: String
  | CreatedByProperty id: String name: String
  | LastEditedTimeProperty id: String name: String
  | LastEditedByProperty id: String name: String
  | ButtonProperty id: String name: String
  | UniqueIdProperty id: String name: String prefix: Maybe<String>
  | VerificationProperty id: String name: String


-- -------------------------------------------------------------------------
-- Page-side property values — what a database row CARRIES for each column.
-- Mirrors the structure of Property above but with concrete values
-- instead of schema metadata.
-- -------------------------------------------------------------------------

FileRef = FileRef name: String file: NotionFile

FormulaResult = StringFormulaResult value: Maybe<String>
  | NumberFormulaResult value: Maybe<Number>
  | BooleanFormulaResult value: Maybe<Boolean>
  | DateFormulaResult value: Maybe<NotionDate>

RollupResult = NumberRollup value: Maybe<Number>
  | DateRollup value: Maybe<NotionDate>
  | ArrayRollup values: [PropertyValue]
  | UnsupportedRollup
  | IncompleteRollup

RelationRef = RelationRef id: String

PropertyValue = TitleValue id: String richText: [RichText]
  | RichTextValue id: String richText: [RichText]
  | NumberValue id: String number: Maybe<Number>
  | SelectValue id: String selected: Maybe<SelectOption>
  | MultiSelectValue id: String selected: [SelectOption]
  | StatusValue id: String selected: Maybe<SelectOption>
  | DateValue id: String date: Maybe<NotionDate>
  | PeopleValue id: String people: [NotionUser]
  | FilesValue id: String files: [FileRef]
  | CheckboxValue id: String checkbox: Boolean
  | UrlValue id: String url: Maybe<String>
  | EmailValue id: String email: Maybe<String>
  | PhoneNumberValue id: String phoneNumber: Maybe<String>
  | FormulaValue id: String formula: FormulaResult
  | RelationValue id: String relation: [RelationRef] hasMore: Boolean
  | RollupValue id: String rollup: RollupResult
  | CreatedTimeValue id: String createdTime: String
  | CreatedByValue id: String createdBy: NotionUser
  | LastEditedTimeValue id: String lastEditedTime: String
  | LastEditedByValue id: String lastEditedBy: NotionUser
  | UniqueIdValue id: String number: Maybe<Number> prefix: Maybe<String>
  | VerificationValue id: String state: String verifiedBy: Maybe<NotionUser> date: Maybe<NotionDate>
  | ButtonValue id: String
  | UnsupportedValue id: String kind: String


-- -------------------------------------------------------------------------
-- Blocks — content of a page. Block is the response shape (id + metadata
-- + content); BlockContent is the type-discriminated body, which is what
-- you also send to append/create endpoints.
--
-- Block children: BlockContent variants that can contain other blocks
-- carry a `children: [BlockContent]` field. On READ responses that field
-- is always empty (children are paginated through retrieveBlockChildren).
-- On WRITES (appendBlockChildren), populate it to create nested blocks
-- in one call.
-- -------------------------------------------------------------------------

LinkTarget = PageIdTarget pageId: String | DatabaseIdTarget databaseId: String

BlockContent = ParagraphContent richText: [RichText] color: NotionColor children: [BlockContent]
  | Heading1Content richText: [RichText] color: NotionColor isToggleable: Boolean children: [BlockContent]
  | Heading2Content richText: [RichText] color: NotionColor isToggleable: Boolean children: [BlockContent]
  | Heading3Content richText: [RichText] color: NotionColor isToggleable: Boolean children: [BlockContent]
  | BulletedListItemContent richText: [RichText] color: NotionColor children: [BlockContent]
  | NumberedListItemContent richText: [RichText] color: NotionColor children: [BlockContent]
  | ToDoContent richText: [RichText] checked: Boolean color: NotionColor children: [BlockContent]
  | ToggleContent richText: [RichText] color: NotionColor children: [BlockContent]
  | CodeContent richText: [RichText] caption: [RichText] language: String
  | CalloutContent richText: [RichText] icon: Maybe<Icon> color: NotionColor children: [BlockContent]
  | QuoteContent richText: [RichText] color: NotionColor children: [BlockContent]
  | EquationContent expression: String
  | DividerContent
  | TableOfContentsContent color: NotionColor
  | BreadcrumbContent
  | ChildPageContent title: String
  | ChildDatabaseContent title: String
  | EmbedContent url: String caption: [RichText]
  | BookmarkContent url: String caption: [RichText]
  | LinkPreviewContent url: String
  | LinkToPageContent target: LinkTarget
  | ImageContent file: NotionFile caption: [RichText]
  | VideoContent file: NotionFile caption: [RichText]
  | AudioContent file: NotionFile caption: [RichText]
  | FileBlockContent file: NotionFile caption: [RichText] name: String
  | PdfContent file: NotionFile caption: [RichText]
  | TableContent tableWidth: Number hasColumnHeader: Boolean hasRowHeader: Boolean children: [BlockContent]
  | TableRowContent cells: [[RichText]]
  | ColumnListContent children: [BlockContent]
  | ColumnContent children: [BlockContent]
  | SyncedBlockContent syncedFromBlockId: Maybe<String> children: [BlockContent]
  | TemplateContent richText: [RichText] children: [BlockContent]
  | UnsupportedContent kind: String

Block = Block id: String parent: Parent createdTime: String lastEditedTime: String createdBy: NotionUser lastEditedBy: NotionUser hasChildren: Boolean archived: Boolean inTrash: Boolean content: BlockContent


-- -------------------------------------------------------------------------
-- Pages — a Notion page. Properties is a list of (name, value) entries
-- rather than a dynamic-keyed map (Fenel doesn't yet expose Map; entries
-- keep the typed shape browsable).
-- -------------------------------------------------------------------------

PropertyEntry = PropertyEntry name: String value: PropertyValue

Page = Page id: String parent: Parent createdTime: String lastEditedTime: String createdBy: NotionUser lastEditedBy: NotionUser archived: Boolean inTrash: Boolean icon: Maybe<Icon> cover: Maybe<Cover> properties: [PropertyEntry] url: String publicUrl: Maybe<String>


-- -------------------------------------------------------------------------
-- Databases — schema is a list of (name, property-definition) entries.
-- -------------------------------------------------------------------------

PropertySchemaEntry = PropertySchemaEntry name: String property: Property

Database = Database id: String parent: Parent createdTime: String lastEditedTime: String createdBy: NotionUser lastEditedBy: NotionUser archived: Boolean inTrash: Boolean isInline: Boolean title: [RichText] description: [RichText] icon: Maybe<Icon> cover: Maybe<Cover> properties: [PropertySchemaEntry] url: String publicUrl: Maybe<String>


-- -------------------------------------------------------------------------
-- Filter — used by /databases/{id}/query. Filter is recursive (compound
-- and/or) plus one leaf variant per property type. Conditions break out
-- the per-type operator set so the editor surfaces the right options.
-- -------------------------------------------------------------------------

TextCondition = TextEquals value: String
  | TextDoesNotEqual value: String
  | TextContains value: String
  | TextDoesNotContain value: String
  | TextStartsWith value: String
  | TextEndsWith value: String
  | TextIsEmpty
  | TextIsNotEmpty

NumberCondition = NumberEquals value: Number
  | NumberDoesNotEqual value: Number
  | NumberGreaterThan value: Number
  | NumberLessThan value: Number
  | NumberGreaterThanOrEqualTo value: Number
  | NumberLessThanOrEqualTo value: Number
  | NumberIsEmpty
  | NumberIsNotEmpty

CheckboxCondition = CheckboxEquals value: Boolean
  | CheckboxDoesNotEqual value: Boolean

SelectCondition = SelectEquals value: String
  | SelectDoesNotEqual value: String
  | SelectIsEmpty
  | SelectIsNotEmpty

MultiSelectCondition = MultiSelectContains value: String
  | MultiSelectDoesNotContain value: String
  | MultiSelectIsEmpty
  | MultiSelectIsNotEmpty

DateCondition = DateEquals value: String
  | DateBefore value: String
  | DateAfter value: String
  | DateOnOrBefore value: String
  | DateOnOrAfter value: String
  | DatePastWeek
  | DatePastMonth
  | DatePastYear
  | DateThisWeek
  | DateNextWeek
  | DateNextMonth
  | DateNextYear
  | DateIsEmpty
  | DateIsNotEmpty

PeopleCondition = PeopleContains userId: String
  | PeopleDoesNotContain userId: String
  | PeopleIsEmpty
  | PeopleIsNotEmpty

FilesCondition = FilesIsEmpty | FilesIsNotEmpty

RelationCondition = RelationContains pageId: String
  | RelationDoesNotContain pageId: String
  | RelationIsEmpty
  | RelationIsNotEmpty

FormulaCondition = FormulaText condition: TextCondition
  | FormulaCheckbox condition: CheckboxCondition
  | FormulaNumber condition: NumberCondition
  | FormulaDate condition: DateCondition

RollupCondition = RollupAny filter: Filter
  | RollupEvery filter: Filter
  | RollupNone filter: Filter
  | RollupNumber condition: NumberCondition
  | RollupDate condition: DateCondition

TimestampField = TimestampCreatedTime | TimestampLastEditedTime

Filter = AndFilter filters: [Filter]
  | OrFilter filters: [Filter]
  | TitleFilter property: String condition: TextCondition
  | RichTextFilter property: String condition: TextCondition
  | UrlFilter property: String condition: TextCondition
  | EmailFilter property: String condition: TextCondition
  | PhoneNumberFilter property: String condition: TextCondition
  | NumberFilter property: String condition: NumberCondition
  | CheckboxFilter property: String condition: CheckboxCondition
  | SelectFilter property: String condition: SelectCondition
  | MultiSelectFilter property: String condition: MultiSelectCondition
  | StatusFilter property: String condition: SelectCondition
  | DateFilter property: String condition: DateCondition
  | PeopleFilter property: String condition: PeopleCondition
  | FilesFilter property: String condition: FilesCondition
  | RelationFilter property: String condition: RelationCondition
  | FormulaFilter property: String condition: FormulaCondition
  | RollupFilter property: String condition: RollupCondition
  | CreatedByFilter property: String condition: PeopleCondition
  | LastEditedByFilter property: String condition: PeopleCondition
  | CreatedTimeFilter property: String condition: DateCondition
  | LastEditedTimeFilter property: String condition: DateCondition
  | TimestampFilter timestamp: TimestampField condition: DateCondition
  | UniqueIdFilter property: String condition: NumberCondition


-- -------------------------------------------------------------------------
-- Sort — by property name or by built-in timestamp.
-- -------------------------------------------------------------------------

SortDirection = Ascending | Descending

Sort = PropertySort property: String direction: SortDirection
  | TimestampSort timestamp: TimestampField direction: SortDirection


-- -------------------------------------------------------------------------
-- Pagination — every list endpoint (query database, list users,
-- retrieveBlockChildren, retrieveComments, search) returns this shape.
-- -------------------------------------------------------------------------

PaginatedList a = PaginatedList results: [a] nextCursor: Maybe<String> hasMore: Boolean


-- -------------------------------------------------------------------------
-- Comments — threaded discussion attached to a page or block. The
-- discussionId groups replies; createComment can target either an
-- existing discussion (reply) or a parent page/block (new thread).
-- -------------------------------------------------------------------------

CommentParent = CommentOnPage pageId: String | CommentOnDiscussion discussionId: String

Comment = Comment id: String parent: Parent discussionId: String createdTime: String lastEditedTime: String createdBy: NotionUser richText: [RichText]


-- -------------------------------------------------------------------------
-- Search — POST /search returns a mixed list of pages and databases.
-- The filter narrows by object type; sort orders by last-edited time.
-- -------------------------------------------------------------------------

SearchObjectFilter = SearchAllObjects | SearchOnlyPages | SearchOnlyDatabases

SearchSort = SearchSortByLastEdited direction: SortDirection

SearchResult = PageResult page: Page | DatabaseResult database: Database


-- -------------------------------------------------------------------------
-- Request-only types — small wrappers used by endpoints whose request
-- body is structurally distinct from the response. Most endpoints accept
-- the same types they return; these are the exceptions.
-- -------------------------------------------------------------------------

-- Property write — what you send to create/update a page property. Same
-- discriminator as PropertyValue but write-side (no id, no read-only
-- fields like CreatedTime). Most write-side properties are a single
-- field; relational ones take a list of references.
PropertyWrite = TitleWrite richText: [RichText]
  | RichTextWrite richText: [RichText]
  | NumberWrite number: Maybe<Number>
  | SelectWrite optionName: Maybe<String>
  | MultiSelectWrite optionNames: [String]
  | StatusWrite optionName: Maybe<String>
  | DateWrite date: Maybe<NotionDate>
  | PeopleWrite userIds: [String]
  | FilesWrite files: [FileRef]
  | CheckboxWrite checkbox: Boolean
  | UrlWrite url: Maybe<String>
  | EmailWrite email: Maybe<String>
  | PhoneNumberWrite phoneNumber: Maybe<String>
  | RelationWrite pageIds: [String]

PropertyWriteEntry = PropertyWriteEntry name: String value: PropertyWrite
