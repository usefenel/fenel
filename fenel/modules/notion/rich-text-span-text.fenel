module notion where

-- richTextSpanText — extract the displayed text of a single RichText
-- span. Notion stores the de-styled text alongside each span (via the
-- `plainText` field), so this is a 3-way pattern match across the
-- RichText variants. Map this over a [RichText] to recover the plain
-- text of a paragraph / heading / etc.

@label "Rich-text span text"
@description "Extract the displayed (de-styled) text of a single RichText span. Map this over a [RichText] to recover the plain text of a paragraph / heading."
@tags "notion" "richtext" "accessor"
richTextSpanText : (t: RichText) -> String
richTextSpanText t = case t of
  RichTextText { plainText = p } -> p
  RichTextMention { plainText = p } -> p
  RichTextEquation { plainText = p } -> p
