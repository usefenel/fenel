-- =========================================================================
-- module notion where — the bodyless Notion REST IO leaves.
--
-- module-substrate Phase 3u.2 (2026-06-01). These 16 functions are irreducible
-- host-IO leaves: each is BODYLESS and dispatches to a runtime IO handler keyed
-- by its `@ioAction` (`notion.<endpoint>` — registered in
-- runtime/src/handlers/notion.ts, UNCHANGED by this migration). They were
-- hand-wrapped `defineFunction` specs in engine/src/modules/notion.ts; their
-- declaration now rides `@native` (bodyless foreign-decl, the Phase-3b
-- convention) + `@ioAction` + @facet directives here, joining the `notion` UNION.
--
-- No `@requires`: the Notion handlers are IO-handler-backed with no declared
-- capability constraint (the pre-migration specs carried none — the runtime
-- dispatches by `@ioAction` string).
--
-- Return types reference the registered named ADTs (Page / Database / Block /
-- NotionUser / Comment / PaginatedList <Elem>) from types.fenel; the wire-JSON
-- boundary that the TS specs typed `anyType` ({$var}) is named `JsonValue`
-- (the registered codec entity) — same value, referenced by name (the telegram
-- JsonValue / MessageText precedent).
-- =========================================================================

module notion where


@label "Retrieve page"
@description "Fetch a page by id. Returns the page with its property values."
@tags "notion" "page" "read"
@ioAction "notion.retrievePage"
@native
retrievePage : (token: String) -> (pageId: String) -> Page

@label "Create page"
@description "Create a new page under a parent page or database. `properties` carries column values when the parent is a database; otherwise pass `[]`."
@tags "notion" "page" "write"
@ioAction "notion.createPage"
@native
createPage : (token: String) -> (parent: Parent) -> (properties: List PropertyWriteEntry) -> (children: List BlockContent) -> (icon: Maybe Icon) -> (cover: Maybe Cover) -> Page

@label "Update page"
@description "Patch a page's properties / icon / cover / archived state. Pass an empty `properties` list to leave columns untouched."
@tags "notion" "page" "write"
@ioAction "notion.updatePage"
@native
updatePage : (token: String) -> (pageId: String) -> (properties: List PropertyWriteEntry) -> (archived: Maybe Boolean) -> (icon: Maybe Icon) -> (cover: Maybe Cover) -> Page

@label "Retrieve database"
@description "Fetch a database by id, including its property schema."
@tags "notion" "database" "read"
@ioAction "notion.retrieveDatabase"
@native
retrieveDatabase : (token: String) -> (databaseId: String) -> Database

@label "Query database"
@description "Query a database's rows (pages). Pass `Nothing` for filter to return all rows. `pageSize` caps at 100 server-side."
@tags "notion" "database" "query"
@ioAction "notion.queryDatabase"
@native
queryDatabase : (token: String) -> (databaseId: String) -> (filter: Maybe Filter) -> (sorts: List Sort) -> (startCursor: Maybe String) -> (pageSize: Maybe Number) -> PaginatedList Page

@label "Retrieve block"
@description "Fetch a single block by id. Children are NOT inline — call retrieveBlockChildren."
@tags "notion" "block" "read"
@ioAction "notion.retrieveBlock"
@native
retrieveBlock : (token: String) -> (blockId: String) -> Block

@label "Retrieve block children"
@description "Fetch the children of a block (or of a page — pages are blocks too). Paginated; `pageSize` caps at 100."
@tags "notion" "block" "read" "paginated"
@ioAction "notion.retrieveBlockChildren"
@native
retrieveBlockChildren : (token: String) -> (blockId: String) -> (startCursor: Maybe String) -> (pageSize: Maybe Number) -> PaginatedList Block

@label "Append block children"
@description "Append blocks to the children of `blockId`. Pass `after` to insert after a specific existing child block; otherwise blocks are appended at the end."
@tags "notion" "block" "write"
@ioAction "notion.appendBlockChildren"
@native
appendBlockChildren : (token: String) -> (blockId: String) -> (children: List BlockContent) -> (after: Maybe String) -> PaginatedList Block

@label "Update block"
@description "Replace a block's content. The new content must be the same block kind as the existing block."
@tags "notion" "block" "write"
@ioAction "notion.updateBlock"
@native
updateBlock : (token: String) -> (blockId: String) -> (content: BlockContent) -> (archived: Maybe Boolean) -> Block

@label "Delete block"
@description "Move a block to the trash. Notion soft-deletes — the returned block has `inTrash = true`."
@tags "notion" "block" "write"
@ioAction "notion.deleteBlock"
@native
deleteBlock : (token: String) -> (blockId: String) -> Block

@label "Retrieve user"
@description "Fetch a workspace user by id."
@tags "notion" "user" "read"
@ioAction "notion.retrieveUser"
@native
retrieveUser : (token: String) -> (userId: String) -> NotionUser

@label "List users"
@description "Page through all users in the workspace. `pageSize` caps at 100."
@tags "notion" "user" "read" "paginated"
@ioAction "notion.listUsers"
@native
listUsers : (token: String) -> (startCursor: Maybe String) -> (pageSize: Maybe Number) -> PaginatedList NotionUser

@label "Retrieve token bot"
@description "Fetch the bot user that owns the integration token."
@tags "notion" "user" "read"
@ioAction "notion.retrieveMe"
@native
retrieveMe : (token: String) -> NotionUser

@label "Create comment"
@description "Post a comment. Use CommentOnPage to start a new discussion on a page; CommentOnDiscussion to reply to an existing thread."
@tags "notion" "comment" "write"
@ioAction "notion.createComment"
@native
createComment : (token: String) -> (parent: CommentParent) -> (richText: List RichText) -> Comment

@label "Retrieve comments"
@description "Fetch comments attached to a page or block."
@tags "notion" "comment" "read" "paginated"
@ioAction "notion.retrieveComments"
@native
retrieveComments : (token: String) -> (blockId: String) -> (startCursor: Maybe String) -> (pageSize: Maybe Number) -> PaginatedList Comment

@label "Search"
@description "Workspace-wide search for pages and databases the integration has access to. Pass `Nothing` for query to list everything."
@tags "notion" "search" "read" "paginated"
@ioAction "notion.search"
@native
search : (token: String) -> (query: Maybe String) -> (filter: Maybe SearchObjectFilter) -> (sort: Maybe SearchSort) -> (startCursor: Maybe String) -> (pageSize: Maybe Number) -> PaginatedList SearchResult
