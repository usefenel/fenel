-- Sound dispatch instances (typed-function-references Phase 10c).
--
-- Sampleable<Sound> / Renderable<Sound> — entries in the polymorphic
-- sample/render dispatch tables. `.fenel` value-decls (the Phase-10 loader flip
-- lowers the point-free method refs to the dispatch-ready `{$ref}` codeName
-- handle; the registry resolves them to `sound:sampleSound` / `sound:renderSound`).
-- Loaded with `dispatchInstanceFile: true`.
sampleableSound : Sampleable Sound
sampleableSound = Sampleable { sample = sampleSound }

renderableSound : Renderable Sound
renderableSound = Renderable { render = renderSound }
