-- =========================================================================
-- Sound — audio as math. Tagged union with two cases (Buffer / Wave) over
-- the Time → Amplitude codomain, plus the canonical `Time = Time seconds`
-- entity used by every time-indexed signal (Animation / Movie / Behavior /
-- Track). Carries the inline closure-construction helpers (sine /
-- sawtooth / square / mix / delay / pitch / midiToFreq / note /
-- plucked / etc.) — the math IS the function.
--
-- Phase 4g of ts-elimination: this body was previously the inline
-- `const SOUND_SRC = \`…\`` template literal at engine/src/modules/sound.ts;
-- extracted verbatim with JS template-literal `\\t` lambda escapes
-- collapsed to single-backslash `\t`.
--
-- Helper functions (sineAt / sawAt / squareAt / scaleAmp / addAmp /
-- bound) are kept on single lines because the parser doesn't currently
-- continue arg lists across line breaks. Inlined constant 6.283185307179586
-- = 2π (no auto-called 0-arg functions yet).
--
-- module-substrate Phase 3g (2026-05-30) — sound is the SECOND both-maps
-- BASE (after picture, the 3f representative). The 8 TS natives (sampleSound /
-- renderSound / time / amplitude / mono / ampL / ampR / audioBuffer),
-- previously hand-assembled as `defineFunction` specs in
-- `engine/src/modules/sound.ts`, are now @native FOREIGN DECLARATIONS here;
-- their impls live in the `ffi/sound-ffi.ts` leaf. `sampleSound` /
-- `renderSound` are CTX natives (they re-enter the evaluator to run Wave
-- closures), so their impls land in the seam's `nativeImplsCtx` map; the other
-- 6 are plain (`nativeImpls`). Plain-vs-ctx is decided ENTIRELY by which seam
-- map an impl lands in — the @native decl is uniform, no marker (axis #4).
-- The natives keep their `audio` category (@category "audio"); the
-- Fenel-bodied helpers keep the module-name `sound` category default. The 16
-- Fenel-bodied helpers below + the 2 entities are unchanged.
-- =========================================================================

module sound where

Sound = Buffer AudioBuffer | Wave (Time -> Amplitude)

Time = Time seconds: Number

-- ----- Foreign declarations (native-backed; impl in ffi/sound-ffi.ts) -------
-- The bridge primitives + constructor / accessor helpers that touch runtime
-- representation records source can't construct directly today. `sampleSound` /
-- `renderSound` re-enter the evaluator (CTX natives → nativeImplsCtx); the
-- other 6 are pure representation-record builders / readers (plain natives →
-- nativeImpls). No Fenel body: the registry resolves each call to the ffi leaf
-- keyed by codeName. (Several are pure-logic F-permanent-revisit candidates
-- parked at the leaf for parity — see the ffi file header.)

@native
@label "Sample sound"
@description "Sample a Sound at a Time, returning a stereo Amplitude. The bridge primitive — every higher-level Sound operation reduces to this."
@category "audio"
@tags "audio" "primitive"
sampleSound : (sound: Sound, t: Time) -> Amplitude

@native
@label "Render sound"
@description "Rasterise a Sound into an AudioBuffer over `duration` seconds at `sampleRate` Hz."
@category "audio"
@tags "audio" "primitive"
renderSound : (sound: Sound, duration: Number, sampleRate: Number) -> AudioBuffer

@native
@label "Time"
@description "Build a Time record from a number of seconds."
@category "audio"
@tags "audio" "constructor"
time : (seconds: Number) -> Time

@native
@label "Amplitude"
@description "Build a stereo Amplitude from left and right channel values (clamped to [-1, 1])."
@category "audio"
@tags "audio" "constructor"
amplitude : (l: Number, r: Number) -> Amplitude

@native
@label "Mono"
@description "Build a mono Amplitude (left == right)."
@category "audio"
@tags "audio" "constructor"
mono : (v: Number) -> Amplitude

@native
@label "Left channel"
@description "Extract the left channel of an Amplitude."
@category "audio"
@tags "audio" "accessor"
ampL : (a: Amplitude) -> Number

@native
@label "Right channel"
@description "Extract the right channel of an Amplitude."
@category "audio"
@tags "audio" "accessor"
ampR : (a: Amplitude) -> Number

@native
@label "Audio buffer"
@description "Build an AudioBuffer from sample rate, channel count, and PCM samples."
@category "audio"
@tags "audio" "constructor"
audioBuffer : (sampleRate: Number, channels: Number, samples: List Amplitude) -> AudioBuffer

-- Sample a pure sine wave at frequency f and time t. The math IS the function.
sineAt : Number -> Time -> Number
sineAt f t = sin (6.283185307179586 * f * t.seconds)

-- Linear ramp from -1 to +1 every 1/f seconds.
sawAt : Number -> Time -> Number
sawAt f t = 2 * (f * t.seconds - floor (f * t.seconds)) - 1

-- ±1 alternating; sign of the cosine-equivalent at the same phase.
squareAt : Number -> Time -> Number
squareAt f t = if sineAt f t >= 0 then 1 else 0 - 1

-- Pure sine wave at frequency f Hz.
sine : Number -> Sound
sine f = Wave (\t -> mono (sineAt f t))

-- Sawtooth wave at frequency f Hz.
sawtooth : Number -> Sound
sawtooth f = Wave (\t -> mono (sawAt f t))

-- Square wave at frequency f Hz.
square : Number -> Sound
square f = Wave (\t -> mono (squareAt f t))

-- Per-sample channel-pair scaler (used by gain, lift to amplitude).
scaleAmp : Number -> Amplitude -> Amplitude
scaleAmp g a = amplitude (g * ampL a) (g * ampR a)

-- Per-sample channel-pair adder (used by mix).
addAmp : Amplitude -> Amplitude -> Amplitude
addAmp a b = amplitude (ampL a + ampL b) (ampR a + ampR b)

-- Volume control: multiply both channels by g.
gain : Number -> Sound -> Sound
gain g s = Wave (\t -> scaleAmp g (sampleSound s t))

-- Additive mix: sum two sounds sample-by-sample.
mix : Sound -> Sound -> Sound
mix a b = Wave (\t -> addAmp (sampleSound a t) (sampleSound b t))

-- Time-shift: play s starting d seconds later.
delay : Number -> Sound -> Sound
delay d s = Wave (\t -> sampleSound s (time (t.seconds - d)))

-- Pitch / time-scaling: stretch the time axis by factor f.
-- f=2 → octave up (twice as fast); f=0.5 → octave down (half speed).
pitch : Number -> Sound -> Sound
pitch f s = Wave (\t -> sampleSound s (time (f * t.seconds)))

-- Standard equal-temperament: MIDI note number → frequency in Hz.
-- Reference: A4 = 69 → 440 Hz. Each semitone is a factor of 2^(1/12).
midiToFreq : Number -> Number
midiToFreq n = 440 * pow 2 ((n - 69) / 12)

-- A pure sine note at a given MIDI pitch. Plays indefinitely; combine
-- with gain and time-windowing to shape envelope and duration.
note : Number -> Sound
note n = sine (midiToFreq n)

-- Time-window a sound: silence after t > dur. Crucial for sequencing
-- melodies — without it, every note in a track plays forever and stacks
-- into a wall of overlapping pitches by the end. With bound the
-- arpeggio sounds like an arpeggio.
bound : Number -> Sound -> Sound
bound dur s = Wave (\t -> if t.seconds <= dur then sampleSound s t else amplitude 0 0)

-- Convenience: a bounded note. plucked n dur = bound dur (note n)
plucked : Number -> Number -> Sound
plucked n dur = bound dur (note n)
