@category "engine-internal"
surfaceEditableColumn : (field: String) -> (label: String) -> a
surfaceEditableColumn field label =
  { field = field, label = label, editable = true }

@category "engine-internal"
surfaceTableDisplay : (columns: List a) -> a
surfaceTableDisplay columns =
  { style = "table", columns = columns }

@category "engine-internal"
surfaceCardsDisplay : a
surfaceCardsDisplay =
  mapSet {} "style" "cards"

@category "engine-internal"
surfaceStackDisplay : (addLabel: String) -> a
surfaceStackDisplay addLabel =
