module engine where

-- Fenel-authored surface vocabulary and built-in TypeView data.
-- Solid still owns component implementations; this module owns the pure
-- configuration records consumed by the Phase 10 surface planner.

@label "surface: maybe string"
@description "Normalize empty strings to Nothing for surface helper call-sites that accept optional strings."
@tags "engine" "surface" "typeview" "ux-parity" "phase-11"
surfaceMaybeString : (value: String) -> Maybe String
surfaceMaybeString value =
  if eq value "" then Nothing else Just value

-- Collection chrome follows the declared element, never reflected siblings or
-- formatted names. Broad/sum/function types retain each member's identity.
@category "engine-internal"
surfaceCollectionContentFirst : Maybe TraversalType -> List Anything -> Bool
surfaceCollectionContentFirst element facts = case element of
  Nothing -> false
  Just type -> surfaceCollectionDataElement type facts []

@category "engine-internal"
surfaceCollectionDataElement : TraversalType -> List Anything -> List String -> Bool
surfaceCollectionDataElement type facts seen = case type of
  TtRecord {} -> true
  TtVariant { cases = cases } -> length cases == 1 && some cases (\entry -> length entry.fields > 0)
  TtRefined { base = base } -> surfaceCollectionDataElement base facts seen
  TtNamed { name = name } ->
    if elem name seen then false else case surfaceReaderTypeFact name facts of
      Just fact -> case fact.type of Just next -> surfaceCollectionDataElement next facts (appendItem name seen); Nothing -> false
      Nothing -> false
  _ -> false

@label "surface: type ref"
@description "Build a FenelType name reference for TypeView.targetType. Uses mapSet because Fenel record literals cannot author $-prefixed keys."
@tags "engine" "surface" "typeview" "ux-parity" "phase-11"
surfaceTypeRef : (name: String) -> a
surfaceTypeRef name =
  mapSet {} "$ref" name

@label "surface: empty read display"
@description "ReadDisplay with every canonical Maybe slot set to Nothing."
@tags "engine" "surface" "display" "ux-parity" "phase-11"
surfaceEmptyReadDisplay : a
surfaceEmptyReadDisplay =
  { format = Nothing
  , transform = Nothing
  , colorMap = Nothing
  , labelMap = Nothing
  , icon = Nothing
  , emptyText = Nothing
  , prefix = Nothing
  , suffix = Nothing
  , refTemplate = Nothing
  }

@label "surface: read display"
@description "Construct a canonical ReadDisplay record from explicit Maybe slots."
@tags "engine" "surface" "display" "ux-parity" "phase-11"
surfaceReadDisplay : (format: Maybe String) -> (transform: Maybe String) -> (colorMap: Maybe a) -> (labelMap: Maybe a) -> (icon: Maybe String) -> (emptyText: Maybe b) -> (prefix: Maybe b) -> (suffix: Maybe b) -> (refTemplate: Maybe String) -> a
surfaceReadDisplay format transform colorMap labelMap icon emptyText prefix suffix refTemplate =
  { format = format
  , transform = transform
  , colorMap = colorMap
  , labelMap = labelMap
  , icon = icon
  , emptyText = emptyText
  , prefix = prefix
  , suffix = suffix
  , refTemplate = refTemplate
  }

@category "engine-internal"
surfaceReadFormat : (format: String) -> a
surfaceReadFormat format =
  surfaceReadDisplay (Just format) Nothing Nothing Nothing Nothing Nothing Nothing Nothing Nothing

@category "engine-internal"
surfaceReadFormatTransform : (format: String) -> (transform: String) -> a
surfaceReadFormatTransform format transform =
  surfaceReadDisplay (Just format) (Just transform) Nothing Nothing Nothing Nothing Nothing Nothing Nothing

@category "engine-internal"
surfaceReadFormatIcon : (format: String) -> (icon: String) -> a
surfaceReadFormatIcon format icon =
  surfaceReadDisplay (Just format) Nothing Nothing Nothing (Just icon) Nothing Nothing Nothing Nothing

@category "engine-internal"
surfaceReadEmptyText : (emptyText: String) -> a
surfaceReadEmptyText emptyText =
  surfaceReadDisplay Nothing Nothing Nothing Nothing Nothing (Just emptyText) Nothing Nothing Nothing

@category "engine-internal"
surfaceBadgeMaps : (colorMap: a) -> (labelMap: Maybe a) -> a
surfaceBadgeMaps colorMap labelMap =
  surfaceReadDisplay (Just "badge") Nothing (Just colorMap) labelMap Nothing Nothing Nothing Nothing Nothing

@label "surface: empty edit display"
@description "EditDisplay with every canonical Maybe slot set to Nothing."
@tags "engine" "surface" "display" "ux-parity" "phase-11"
surfaceEmptyEditDisplay : a
surfaceEmptyEditDisplay =
  { widget = Nothing
  , placeholder = Nothing
  , helpText = Nothing
  , options = Nothing
  , columns = Nothing
  , refFilter = Nothing
  , prefix = Nothing
  , suffix = Nothing
  , format = Nothing
  }

@label "surface: edit display"
@description "Construct a canonical EditDisplay record from explicit Maybe slots."
@tags "engine" "surface" "display" "ux-parity" "phase-11"
surfaceEditDisplay : (widget: Maybe String) -> (placeholder: Maybe a) -> (helpText: Maybe a) -> (options: Maybe b) -> (columns: Maybe Number) -> (refFilter: Maybe c) -> (prefix: Maybe a) -> (suffix: Maybe a) -> (format: Maybe String) -> a
surfaceEditDisplay widget placeholder helpText options columns refFilter prefix suffix format =
  { widget = widget
  , placeholder = placeholder
  , helpText = helpText
  , options = options
  , columns = columns
  , refFilter = refFilter
  , prefix = prefix
  , suffix = suffix
  , format = format
  }

@category "engine-internal"
surfaceEditWidget : (widget: String) -> a
surfaceEditWidget widget =
  surfaceEditDisplay (Just widget) Nothing Nothing Nothing Nothing Nothing Nothing Nothing Nothing

@category "engine-internal"
surfaceDisplay : (read: Maybe a) -> (edit: Maybe b) -> a
surfaceDisplay read edit =
  { read = read, edit = edit }

@label "surface: layout slot"
@description "Construct a LayoutDef slot for one field path and grid span."
@tags "engine" "surface" "layout" "ux-parity" "phase-11"
surfaceSlot : (field: String) -> (span: Number) -> a
surfaceSlot field span =
  { field = field, span = span }

@category "engine-internal"
surfaceSlotTemplate : (field: String) -> (span: Number) -> (template: String) -> a
surfaceSlotTemplate field span template =
  { field = field, span = span, template = template }

@category "engine-internal"
surfaceRow : (slots: List a) -> a
surfaceRow slots =
  mapSet {} "slots" slots

@category "engine-internal"
surfaceSection : (title: String) -> (rows: List a) -> a
surfaceSection title rows =
  { title = title, rows = rows }

@category "engine-internal"
surfaceUntitledSection : (rows: List a) -> a
surfaceUntitledSection rows =
  mapSet {} "rows" rows

@category "engine-internal"
surfaceLayoutDef : (sections: List a) -> a
surfaceLayoutDef sections =
  mapSet {} "sections" sections

@label "surface: list column"
@description "Construct a table ListColumn with field path and label."
@tags "engine" "surface" "list-display" "ux-parity" "phase-11"
surfaceColumn : (field: String) -> (label: String) -> a
surfaceColumn field label =
