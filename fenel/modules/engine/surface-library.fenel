@category "engine-internal"
surfaceStyleDisplay : (style: String) -> a
surfaceStyleDisplay style =
  mapSet {} "style" style

@category "engine-internal"
surfaceDisplayView : (name: String) -> (description: String) -> (read: Maybe a) -> (edit: Maybe b) -> a
surfaceDisplayView name description read edit =
  { name = name
  , description = description
  , display = Just (surfaceDisplay read edit)
  }

@category "engine-internal"
surfaceComponentDisplayView : (name: String) -> (description: String) -> (read: Maybe a) -> (edit: Maybe b) -> (readComponent: String) -> (editComponent: String) -> a
surfaceComponentDisplayView name description read edit readComponent editComponent =
  { name = name
  , description = description
  , display = Just (surfaceDisplay read edit)
  , readComponent = readComponent
  , editComponent = editComponent
  }

@category "engine-internal"
surfaceListTemplateView : (name: String) -> (description: String) -> (listDisplay: a) -> a
surfaceListTemplateView name description listDisplay =
  { name = name
  , description = description
  , display = Nothing
  , listDisplay = listDisplay
  }

@category "engine-internal"
surfaceDetailTypeView : (name: String) -> (description: String) -> (target: String) -> (layout: a) -> a
surfaceDetailTypeView name description target layout =
  { name = name
  , description = description
  , targetType = surfaceTypeRef target
  , display = Nothing
  , layout = layout
  }

@category "engine-internal"
surfaceTableTypeView : (name: String) -> (description: String) -> (target: String) -> (columns: List a) -> a
surfaceTableTypeView name description target columns =
  { name = name
  , description = description
  , targetType = surfaceTypeRef target
  , display = Nothing
  , listDisplay = surfaceTableDisplay columns
  }

@category "engine-internal"
surfaceCardTypeView : (name: String) -> (description: String) -> (target: String) -> (readComponent: String) -> a
surfaceCardTypeView name description target readComponent =
  { name = name
  , description = description
  , targetType = surfaceTypeRef target
  , display = Nothing
  , listDisplay = surfaceCardsDisplay ()
  , readComponent = readComponent
  }

@category "engine-internal"
surfaceReadComponentView : (name: String) -> (description: String) -> (readComponent: String) -> a
surfaceReadComponentView name description readComponent =
  { name = name
  , description = description
  , display = Nothing
  , readComponent = readComponent
  }

-- Codec readability only, over an inert host snapshot. Expr's registered
-- payload slots are intentionally broad; a tag alone cannot establish that
-- its recursive children can be displayed without changing their meaning.
-- The existing egress has no quoting vehicle for object-valued ELit data, so
-- those values remain unavailable in this lens. Singleton ERecord and named
-- constructor fields that collide with operation syntax also decline.
-- Ordinary unambiguous structures remain available; depth exhaustion declines.
@category "engine-internal"
surfaceReturnedExpressionReadable : (expression: a) -> (remaining: Number) -> (operatorKeys: List String) -> Boolean
surfaceReturnedExpressionReadable expression remaining operatorKeys =
  if remaining <= 0 then false
  else case expression of
    ELit { value = value } -> case lookup expression "value" of
      Nothing -> false
      Just present -> peQuotable present
    EVar { name = name } -> isString name
    ECall { fnId = identity, args = args } ->
      isString identity && isArray args && all args (\argument -> surfaceReturnedExpressionReadable argument (remaining - 1) operatorKeys)
    ELambda { params = parameters, body = body } ->
      isArray parameters && all parameters isString && surfaceReturnedExpressionReadable body (remaining - 1) operatorKeys
    ERecord { fields = fields } ->
      isArray fields && all fields (\field -> surfaceReturnedExpressionFieldReadable field (remaining - 1) operatorKeys) && surfaceReturnedRecordNamesReadable fields
    EConstruct { ctor = identity, args = args } ->
      isString identity && isArray args && surfaceReturnedConstructorFieldsReadable expression args operatorKeys && all args (\argument -> surfaceReturnedExpressionReadable argument (remaining - 1) operatorKeys)
    EMatch { scrutinee = scrutinee, arms = arms } ->
      surfaceReturnedExpressionReadable scrutinee (remaining - 1) operatorKeys && isArray arms && all arms (\arm -> surfaceReturnedExpressionArmReadable arm (remaining - 1) operatorKeys)
    _ -> false

@category "engine-internal"
surfaceReturnedExpressionFieldReadable : (field: a) -> (remaining: Number) -> (operatorKeys: List String) -> Boolean
surfaceReturnedExpressionFieldReadable field remaining operatorKeys =
  if not (isString field.name) then false else case lookup field "value" of
    Nothing -> false
    Just value -> surfaceReturnedExpressionReadable value remaining operatorKeys

@category "engine-internal"
surfaceReturnedRecordNamesReadable : (fields: a) -> Boolean
surfaceReturnedRecordNamesReadable fields =
  let names = map (\field -> field.name) fields
  -- A reader may resolve any singleton key as a function; without an exact
  -- literal/record transport the generic codec would reinterpret that field.
  length names != 1 && length (unique names) == length names && all names (\name -> not (startsWith name "$"))

@category "engine-internal"
surfaceReturnedExpressionArmReadable : (arm: a) -> (remaining: Number) -> (operatorKeys: List String) -> Boolean
surfaceReturnedExpressionArmReadable arm remaining operatorKeys =
  if not (surfaceReturnedPatternReadable arm.pattern remaining operatorKeys && surfaceReturnedExpressionReadable arm.body remaining operatorKeys) then false else case lookup arm "guard" of
    Nothing -> true
    Just guard -> surfaceReturnedExpressionReadable guard remaining operatorKeys

@category "engine-internal"
surfaceReturnedPatternReadable : (pattern: a) -> (remaining: Number) -> (operatorKeys: List String) -> Boolean
surfaceReturnedPatternReadable pattern remaining operatorKeys =
  if remaining <= 0 then false
  else case pattern of
    PatWildcard -> true
    PatVar { name = name } -> isString name
    PatLit { value = value } -> case lookup pattern "value" of
      Nothing -> false
      Just present -> peQuotable present
    PatConstruct { ctor = identity, args = args } ->
      isString identity && isArray args && surfaceReturnedConstructorFieldsReadable pattern args operatorKeys && all args (\argument -> surfaceReturnedPatternReadable argument (remaining - 1) operatorKeys)
    _ -> false

@category "engine-internal"
surfaceReturnedConstructorFieldsReadable : (expression: a) -> (args: a) -> (operatorKeys: List String) -> Boolean
surfaceReturnedConstructorFieldsReadable expression args operatorKeys =
  case lookup expression "fields" of
    Nothing -> true
    Just fields -> isArray fields && (length fields == 0 || (length fields == length args && all fields surfaceReturnedConstructorFieldReadable && length (unique (map (\field -> field.wireName) fields)) == length fields && surfaceReturnedConstructorNamesReadable fields operatorKeys))

@category "engine-internal"
surfaceReturnedConstructorNamesReadable : (fields: a) -> (operatorKeys: List String) -> Boolean
surfaceReturnedConstructorNamesReadable fields operatorKeys =
  if pePositionalFields fields 0 then true
  else
    let names = map (\field -> field.wireName) fields
    all names (\name -> not (startsWith name "$")) && (length names != 1 || not (elem (at names 0) operatorKeys))

@category "engine-internal"
surfaceReturnedConstructorFieldReadable : (field: a) -> Boolean
surfaceReturnedConstructorFieldReadable field =
  if not (isString field.wireName) then false else case field.key of
    PositionalField { index = index } -> isNumber index && numberIsFinite index && index >= 0 && floor index == index
    NamedField { ref = reference } -> case lookup reference "$ref" of
      Nothing -> false
      Just identity -> isString identity
    _ -> false

@category "engine-internal"
surfaceProfileLayout : a
surfaceProfileLayout =
  surfaceLayoutDef [
    surfaceSection "Identity" [
      surfaceRow [surfaceSlot "type" 6, surfaceSlot "gender" 6],
      surfaceRow [surfaceSlot "firstName" 6, surfaceSlot "lastName" 6],
      surfaceRow [surfaceSlotTemplate "email" 6 "email", surfaceSlotTemplate "phone" 6 "phone-formatted"],
      surfaceRow [surfaceSlot "dob" 6, surfaceSlot "avatar" 6]
    ],
    surfaceSection "Notes" [
      surfaceRow [surfaceSlot "notes" 12],
      surfaceRow [surfaceSlot "nicknames" 12]
    ]
  ]

