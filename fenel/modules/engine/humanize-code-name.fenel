module engine where

-- The type formatter's name grammar is source-owned here. This ports
-- expression-authoring.ts:spokenName without changing its ASCII camel-case
-- boundaries, separator runs, spacing, articles or mass nouns. The sole
-- spelling change is consonant + y -> ies (entry -> entries); vowel + y
-- still takes s. This is deliberately not humanizeCodeName's acronym grammar.
@label "Spoken type name"
@description "Derive the shared type formatter's bare name, plural and article phrase. Preserve existing name normalization and mass nouns; pluralize a final consonant-y word with ies."
@tags "string" "display"
spokenTypeName : (name: String) -> { bare: String, plural: String, sentence: String }
spokenTypeName name =
  let normalized = lower (spokenTypeNameWalk (chars (trim name)) "" "")
  let bare = if normalized == "" then "data" else normalized
  if bare == "anything" or bare == "any"
    then { bare = "anything", plural = "anything", sentence = "anything" }
    else
      let plural = spokenTypeNamePlural bare
      let first = fromMaybe "" (head (chars bare))
      let article = if elem first ["a", "e", "i", "o", "u"] then "an" else "a"
      { bare = bare, plural = plural, sentence = concat article (concat " " bare) }

@label "Spoken type name: walk"
@description "Preserve ASCII lower-or-digit to upper boundaries and collapse mixed underscore/hyphen runs; walk complete Unicode codepoints without splitting their runtime encoding. Internal name-normalization helper."
@tags "string" "internal"
spokenTypeNameWalk : (remaining: List String) -> (previous: String) -> (acc: String) -> String
spokenTypeNameWalk remaining previous acc =
  case head remaining of
    Nothing -> acc
    Just letter ->
      let separator = letter == "_" or letter == "-"
      let previousSeparator = previous == "_" or previous == "-"
      let camel = previous != "" and contains "abcdefghijklmnopqrstuvwxyz0123456789" previous and contains "ABCDEFGHIJKLMNOPQRSTUVWXYZ" letter
      let piece = if separator then (if previousSeparator then "" else " ") else (if camel then concat " " letter else letter)
      spokenTypeNameWalk (fromMaybe [] (tail remaining)) letter (concat acc piece)

@label "Spoken type name: uncounted"
@description "The existing type-name grammar's mass-word exceptions. Internal plural helper."
@tags "string" "internal"
spokenTypeNameUncounted : (word: String) -> Boolean
spokenTypeNameUncounted word = elem word ["anything", "any", "data", "audio"]

@label "Spoken type name: plural word"
@description "Preserve existing s endings, change a final ASCII consonant-y to ies, and otherwise append s. Internal helper; irregular English plurals remain outside this bounded grammar."
@tags "string" "internal"
spokenTypeNamePluralWord : (word: String) -> String
spokenTypeNamePluralWord word =
  let stem = fromMaybe [] (init (chars word))
  let previous = fromMaybe "" (last stem)
  if endsWith word "s"
    then word
    else if endsWith word "y" and previous != "" and contains "bcdfghjklmnpqrstvwxyz" previous
      then concat (join stem "") "ies"
      else concat word "s"

@label "Spoken type name: plural"
@description "Pluralize only the final space-separated word, retaining the existing whole-name and final-word mass exceptions and preserving authored spacing. Internal helper."
@tags "string" "internal"
spokenTypeNamePlural : (bare: String) -> String
spokenTypeNamePlural bare =
  let words = split bare " "
  let final = fromMaybe bare (last words)
  if spokenTypeNameUncounted bare or spokenTypeNameUncounted final
    then bare
    else
      let prefix = fromMaybe [] (init words)
      join (appendItem (spokenTypeNamePluralWord final) prefix) " "

-- Finite character choices are literal data: title-casing them changes the
-- letter displayed and can collapse distinct lowercase forms. Word/code-name
-- choices retain the existing humanization; authored Labelable overrides are
-- resolved by the canonical enumOptionLabel boundary before this fallback.
@label "Enum option fallback label"
@description "Preserve a single Unicode codepoint as literal choice data; humanize longer word/code-name choices with the existing formatter. Explicit Labelable labels remain authoritative at the caller."
enumOptionLabelFallback : (value: String) -> String
enumOptionLabelFallback value =
  if length (chars value) == 1 then value else humanizeCodeName value

-- humanize-code-name — turn a camelCase / snake_case / kebab-case / UPPER
-- codeName into a Title-Case display label.
--
-- Phase 3v.4d (module-substrate) port. The FIRST non-body-neutral 3v rung —
-- mirrors the TS oracle at implementations/typescript/engine/src/fenel-
-- module.ts:humanizeCodeName (line 675) char-for-char across the live
-- codeName roster. The TS oracle uses 4 regex passes plus a per-word title-
-- case pass that preserves all-caps words verbatim:
--
--     name
--       .replace(/([a-z\d])([A-Z])/g, "$1 $2")           // pass 1 — lower/digit-then-upper
--       .replace(/([A-Z]+)([A-Z][a-z])/g, "$1 $2")        // pass 2 — caps-then-camel
--       .replace(/_+/g, " ")                              // pass 3 — _ runs → space
--       .replace(/-+/g, " ")                              // pass 4 — - runs → space
--       .split(" ").filter(w => w.length > 0)             // post-pass — strip empty words
--       .map(w => w === w.toUpperCase() ? w : w[0].toUpperCase() + w.slice(1))
--       .join(" ")
--
-- The Fenel body fuses pass 1 + pass 2 into a single char-fold (recursive
-- walker over indices 1..length-1), then routes pass 3 + pass 4 through
-- std:replaceAll — the run-collapse the TS regexes provide via `_+` / `-+`
-- falls out for free at the split-filter-join post-pass: `__` → `  ` after
-- replaceAll, then split " " yields `["", ""]` between the surrounding
-- words, which the length-zero filter strips.
--
-- The TS `humanizeCodeName` export in fenel-module.ts STAYS as the loader's
-- stamp-time helper (called from the auto-label code path at catalog-build
-- time); only the Fenel-side fn surface flips to body-driven. Two views of
-- the same canonical String → String function — one called from JS host at
-- registry stamping, one dispatched through the Fenel runtime at user-code
-- call time. The behavioural oracle in module-port-natives-3v4d.test.ts
-- asserts byte-equality across the live roster + targeted edge cases.

@label "Humanize code name"
@description "Phase 3v.4d (module-substrate) — turn a camelCase / snake_case / kebab-case codeName into a Title-Case display label (\"runTelegramCollector\" → \"Run Telegram Collector\"; all-caps words like \"URL\" stay verbatim). Used by displayLabel's read-time fallback when a function declares no explicit @label. The TS oracle at implementations/typescript/engine/src/fenel-module.ts:humanizeCodeName is still called at registry-stamp time by the loader's auto-label code path; this Fenel body is the user-code call-time dispatch."
@tags "string" "primitive" "display" "phase-3v.4d"
@category "string"
humanizeCodeName : (name: String) -> String
humanizeCodeName name =
  if length name == 0
    then name
    else
      let camelSpaced = humanizeCodeNameWalk name 1 (slice name 0 1)
      let underscoreToSpace = replaceAll camelSpaced "_" " "
      let dashToSpace = replaceAll underscoreToSpace "-" " "
      let words = filter (\w -> length w > 0) (split dashToSpace " ")
      let titled = map (\w -> if w == upper w then w else concat (upper (slice w 0 1)) (slice w 1 (length w))) words
      join titled " "

-- humanizeCodeNameWalk — recursive char-fold inserting spaces at camel
-- boundaries. For each i in 1..length-1, examines (prev, curr, next) from
-- the ORIGINAL name (NOT the accumulator — so successive inserts cannot
-- shift the boundary detection); applies pass 1 (prev not uppercase letter
-- AND curr uppercase letter) or pass 2 (prev uppercase, curr uppercase,
-- next lowercase). The pass-1 broadening from `[a-z\d]` to "not an upper-
-- case letter" is intentional: any non-letter prev (underscore, dash) is
-- already destined for replacement at the next pass, and the extra space
-- folds away at the split-filter-join — verified across the entire live
-- codeName roster in module-port-natives-3v4d.test.ts.
@label "humanizeCodeName: walk"
@description "Phase 3v.4d (module-substrate) — recursive char-fold helper for humanizeCodeName. Walks name from index i, accumulating into acc with a space inserted before curr when (prev, curr, next) hits a camel-case boundary (pass 1 — lower-or-digit-then-upper) or a caps-then-camel boundary (pass 2 — upper-upper-lower)."
@tags "string" "internal" "phase-3v.4d"
@category "engine-internal"
humanizeCodeNameWalk : (name: String) -> (i: Number) -> (acc: String) -> String
humanizeCodeNameWalk name i acc =
  if i >= length name
    then acc
    else
      let curr = slice name i (i + 1)
      let prev = slice name (i - 1) i
      let next = if i + 1 < length name then slice name (i + 1) (i + 2) else ""
      let prevIsUpper = prev != lower prev
      let currIsUpper = curr != lower curr
      let nextIsLower = next != upper next
      let needSpace = (not prevIsUpper and currIsUpper) or (prevIsUpper and currIsUpper and nextIsLower)
      let nextAcc = if needSpace then concat acc (concat " " curr) else concat acc curr
      humanizeCodeNameWalk name (i + 1) nextAcc
