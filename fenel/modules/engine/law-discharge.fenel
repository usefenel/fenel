module engine where

-- =========================================================================
-- lawProposition — classify a representation-presence / enum-membership law
-- field into a decidable Proposition MARKER built from the instance's sibling
-- method values. expr-substrate Phase 6a (brief:
-- `workstreams/expr-substrate/briefs/phase-6a-law-discharge.md`).
--
-- THE DISCHARGE LEVER. The audit's ~1297 "law violations" are NOT prover
-- propositions — they are `validateSpecRecord` field checks for `Verified`-
-- typed law fields whose value is MISSING. Nobody hand-authors 1297 Verified
-- literals (the spec header calls that "permanent unproven boilerplate"). The
-- laws are DECIDABLE from data the instance already carries (`methods.label`
-- etc.); this fn builds the law's Proposition from the sibling method values,
-- and the TS audit-side hook (engine/src/law-discharge.ts) runs the existing
-- propose+verify round-trip — kernel-accepted `SolverChecked` ⇒ discharged.
--
-- THE 5-ROW CLASSIFICATION TABLE (the whole table lives HERE, Fenel-first):
--   labelNonEmpty   (Labelable) ⇒ methods.label   ≠ ""    -- PropDisjoint {v} {""}
--   iconNonEmpty    (Iconable)  ⇒ methods.icon     ≠ ""    -- PropDisjoint {v} {""}
--   emojiNonEmpty   (Emojiable) ⇒ methods.emoji    ≠ ""    -- PropDisjoint {v} {""}
--   structureValid  (Groupable) ⇒ methods.groupStructure ∈ {flat, tree}
--   geometryTypeValid (Spatial) ⇒ methods.geometryType ∈ {point, polygon, multipolygon}
--   anything else                ⇒ { tag = "None" } (out-of-table; stays violating)
--
-- THE CLAIM SHAPE (decide-substrate Phase 2 K2 — JUDGMENT-NATIVE). This fn now
-- emits the ONE lattice judgment (`JEmpty set`, judgment.fenel) rather than the
-- closed `PropDisjoint`/`PropSubset` marker: the non-empty law is
-- `JEmpty (SeIntersect [{value}, {""}])` (disjointness ≡ value ≠ "", via
-- `jopDisjoint`) and the membership law is `JEmpty (SeIntersect [{value},
-- ¬allowed])` (subsethood ≡ value ∈ allowed, via `jopSubset`) — the SAME
-- composed-set builders the kernel's `judgmentOfProposition` iso uses. The set
-- payloads are the CANONICAL `$tag` `SeEnum` SetExpr. The TS boundary
-- (law-discharge.ts `unmarshalProposition`) BACK-MAPS the judgment shape → the
-- `PropDisjoint`/`PropSubset` `$tag` the still-Prop* proposer/kernel consume
-- (SHAPE RECOGNITION preserves tri-precision: `SeIntersect [s, t]` ⇒ disjoint,
-- `SeIntersect [s, SeComplement t]` ⇒ subset), peels the SeEnum payloads
-- (value-projecting LocaleStrings) → `decidableSetProposerNative` → `verify`.
-- Everything downstream is byte-identical; the back-map DIES at K3 when the
-- proposers route on the judgment directly. The `{ tag = "None" }` out-of-table
-- sentinel stays a plain marker (the sample-arm signal).
--
-- LocaleString ∃-semantics (decision 3): the method value is typed
-- LocaleString for label, but the live registry projection carries plain
-- strings (census 2026-06-11: 1295/1295 plain non-empty strings, 0 objects).
-- The defensive object case (∃ a non-empty locale) is handled at the TS
-- unmarshal boundary (object iteration is trivial there; un-authorable here) —
-- this fn just drops `methods.label` into the singleton verbatim.
--
-- NO ENTITY DECLS: the markers are plain records, NOT registered ADTs — entity
-- oracle + ordered list UNTOUCHED, law count +0 (the P2/4a/3a/5 function-only
-- rule).
-- =========================================================================

@label "Law proposition"
@description "Classify a representation-presence / enum-membership law FIELD (labelNonEmpty / iconNonEmpty / emojiNonEmpty / structureValid / geometryTypeValid) into a decidable law claim built from the instance's sibling method values, JUDGMENT-NATIVE since decide-substrate Phase 2 (K2): non-empty laws ⇒ `JEmpty (SeIntersect [{value}, {\"\"}])` (value ≠ \"\", via jopDisjoint); enum-membership laws ⇒ `JEmpty (SeIntersect [{value}, ¬allowed])` (value ∈ allowed, via jopSubset). Out-of-table fields ⇒ `{ tag = \"None\" }` (the sample-arm sentinel). The producer now emits the one lattice judgment, not the closed PropDisjoint/PropSubset marker; the TS audit-side hook (unmarshalProposition) shape-recognizes the judgment back to the still-Prop* proposer (byte-identical), peels the SeEnum payloads, and runs the existing propose+verify round-trip. expr-substrate Phase 6a / decide-substrate Phase 2."
@tags "engine" "prover" "law" "judgment" "decide-substrate" "phase-2"
lawProposition : (lawField: String) -> (methods: a) -> a
lawProposition lawField methods =
  if eq lawField "labelNonEmpty" then nonEmptyProp methods.label
  else if eq lawField "iconNonEmpty" then nonEmptyProp methods.icon
  else if eq lawField "emojiNonEmpty" then nonEmptyProp methods.emoji
  else if eq lawField "structureValid" then membershipProp methods.groupStructure (appendItem "flat" (appendItem "tree" []))
  else if eq lawField "geometryTypeValid" then membershipProp methods.geometryType (appendItem "point" (appendItem "polygon" (appendItem "multipolygon" [])))
  else { tag = "None" }

-- nonEmptyProp — "value ≠ empty-string" as the JEmpty judgment (s ∩ t) —
-- disjointness of {value} and {""}. decide-substrate Phase 2 (K2): the
-- producer now speaks JUDGMENT-NATIVE — it emits the one lattice judgment
-- (`JEmpty (SeIntersect [{value}, {""}])`) via the SAME composed-set builder
-- the kernel's iso uses (`jopDisjoint`, judgment.fenel), instead of the closed
-- `PropDisjoint` marker. The TS seam (`unmarshalProposition`, law-discharge.ts)
-- BACK-MAPS the judgment shape → the `PropDisjoint` `$tag` the still-Prop*
-- proposer/kernel consume (tri-precision preserved by SHAPE RECOGNITION:
-- `SeIntersect [s, t]` ⇒ disjoint), so everything downstream is byte-identical.
-- The back-map dies at K3 when the proposers route on the judgment directly.
-- The set payloads are the CANONICAL `$tag` `SeEnum` SetExpr (Phase 1 Stage F).
@label "law: nonEmptyProp"
@description "decide-substrate Phase 2 (K2) — build a non-empty-string law claim JUDGMENT-NATIVE: `JEmpty (SeIntersect [SeEnum [witness], SeEnum [\"\"]])` via jopDisjoint (the same composed-set builder the kernel's judgmentOfProposition iso uses) — the {witness} ∩ {empty string} set is empty ≡ witness ≠ \"\" (disjointness). Emits the one lattice judgment, NOT the closed PropDisjoint marker; the TS seam (unmarshalProposition) shape-recognizes SeIntersect [s, t] ⇒ PropDisjoint for the still-Prop* proposer (byte-identical downstream; the back-map dies at K3). The set payloads are canonical `$tag` Se*. Internal helper."
@tags "engine" "internal" "prover" "law" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
nonEmptyProp : (witness: a) -> a
nonEmptyProp witness =
  jopDisjoint { s = SeEnum { values = appendItem witness [] }, t = SeEnum { values = appendItem "" [] } }

-- membershipProp — "value ∈ allowed" as the JEmpty judgment (s ∩ ¬t) —
-- subsethood of {value} in allowed. decide-substrate Phase 2 (K2): judgment-
-- native via `jopSubset` (the kernel's iso builder): `JEmpty (SeIntersect
-- [{value}, ¬allowed])`. The TS seam back-maps SeIntersect [s, SeComplement t]
-- ⇒ PropSubset (shape recognition preserves the subset tri-precision).
@label "law: membershipProp"
@description "decide-substrate Phase 2 (K2) — build an enum-membership law claim JUDGMENT-NATIVE: `JEmpty (SeIntersect [SeEnum [witness], SeComplement (SeEnum allowed)])` via jopSubset (the kernel's judgmentOfProposition iso builder) — the {witness} ∩ ¬allowed set is empty ≡ witness ∈ allowed (subsethood). Emits the one lattice judgment, NOT the closed PropSubset marker; the TS seam shape-recognizes SeIntersect [s, SeComplement t] ⇒ PropSubset for the still-Prop* proposer (byte-identical; the back-map dies at K3). Canonical `$tag` Se* payloads. Internal helper."
@tags "engine" "internal" "prover" "law" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
membershipProp : (witness: a) -> (allowed: a) -> a
membershipProp witness allowed =
  jopSubset { s = SeEnum { values = appendItem witness [] }, t = SeEnum { values = allowed } }

-- =========================================================================
-- Phase 6b0 additions — the discharge GRADE policy + the LocaleString
-- ∃-projection walk, completing the 6a hook's Fenel side (brief:
-- `workstreams/expr-substrate/briefs/phase-6b0-prover-fenel-port.md`).
-- The TS hook (engine/src/law-discharge.ts) is now plumbing only:
-- classify (lawProposition, 6a) → unmarshal ($enum leaf) → propose →
-- kernel-verify (both Fenel-bodied via their delegates) → dischargeGrade
-- (HERE — which outcome combinations discharge / refute / fall through,
-- and the refutation message) → stats.
-- =========================================================================

-- dischargeGrade — the discharge policy over the propose+verify outcome tags.
@label "Discharge grade"
@description "The 6a hook's grade policy, Fenel-bodied (expr-substrate Phase 6b0): a kernel-verified SolverChecked on an Ok proposal ⇒ Discharged; a WitnessError proposal ⇒ Refuted with the representation/structure refutation message (the new, wanted failure mode — distinct from 'missing'); every other combination (Undecided / OutOfScope / kernel-declined) ⇒ None — honest non-evidence, the law stays 'missing'. The TS hook replays the marker into ProveMissingOutcome + the stats tally."
@tags "engine" "prover" "law" "discharge" "expr-substrate" "phase-6b0"
dischargeGrade : (proposedTag: String) -> (proposedErrTag: String) -> (verifiedStatus: String) -> (fieldName: String) -> a
dischargeGrade proposedTag proposedErrTag verifiedStatus fieldName =
  if eq proposedTag "Ok"
  then
    if eq verifiedStatus "SolverChecked"
    then { tag = "Discharged" }
    else { tag = "None" }
  else if eq proposedErrTag "WitnessError"
  then { tag = "Refuted", reason = concat "representation/structure law refuted: " (concat fieldName " value is empty or out-of-set (SolverChecked refutation)") }
  else { tag = "None" }

-- firstNonEmptyString — the LocaleString ∃-projection's selection walk.
@label "First non-empty string"
@description "The LocaleString ∃-locale selection, Fenel-bodied (expr-substrate Phase 6b0, probe-5 outcome — std `entries` exists, so the 6a 'un-authorable' claim only held for the typeof classification): given the locale values already filtered to strings at the TS boundary, return the first non-empty one, or \"\" when every locale is empty (⇒ the non-empty law refutes). The ∃-semantics — 'SOME locale is non-empty' — is the law's meaning and lives here, not in the leaf."
@tags "engine" "prover" "law" "discharge" "expr-substrate" "phase-6b0"
firstNonEmptyString : (vals: a) -> String
firstNonEmptyString vals =
  case head vals of
    Nothing -> ""
    Just v ->
      if eq v ""
      then
        case tail vals of
          Nothing -> ""
          Just rest -> firstNonEmptyString rest
      else v

-- =========================================================================
-- Phase 6c additions — the sample-iteration discharge arm (brief:
-- `workstreams/expr-substrate/briefs/phase-6c-law-tail-discharge.md`).
--
-- The 6a hook's table covers the decidable representation-presence laws;
-- the residual tail is the sample-bearing law families (Aggregable / Iso /
-- Lens / Migration / DecidableMembership / Compilable / Evaluator) whose
-- spec-record law fields map onto the law decls each class already carries
-- (inline `forall` samples + a `property` expression). The discharge route
-- is UNIFORM across all families: evaluate the law's property AS DECLARED
-- per sample combination (the property text IS the law — vacuous arms are
-- encoded inside it), aggregate all-pass, claim a SampleTestResult, and
-- re-check through the kernel (PropForall rule ⇒ SampleTested n). The
-- reduction route the brief floated for the eq-shaped families was
-- REJECTED at Step 0: it cannot express Iso's vacuous-Err arm and adds no
-- trust (the kernel's Refl facts are delegate-precomputed either way).
--
-- The split (the 6a/6b0 discipline, extended): the FIELD→LAW classification
-- table (sampleLawSpec) + the aggregation policy and every message string
-- (sampleLawGrade) live HERE; the per-sample property EVALUATION is the
-- justified host re-entry in engine/src/law-discharge.ts (sample resolve +
-- cartesian walk + evaluator re-entry + the kernel round-trip), per-fn
-- ledgered in that file's header.
-- =========================================================================

-- sampleLawSpec — classify a sample-bearing law FIELD to its class + law decl.
@label "Sample law spec"
@description "Classify a sample-bearing spec-record law field (expr-substrate Phase 6c) into its owning class + law-decl name: `{ tag = \"SampleLaw\", typeName, law }` for the seven sample-tested families, `{ tag = \"None\" }` for out-of-table fields. The TS audit-side bridge resolves the named law decl, iterates its samples through the property expression, and discharges via the kernel's SampleTestResult rule."
@tags "engine" "prover" "law" "discharge" "expr-substrate" "phase-6c"
sampleLawSpec : (lawField: String) -> a
sampleLawSpec lawField =
  if eq lawField "aggregablePreimageRoundtrip" then { tag = "SampleLaw", typeName = "Aggregable", law = "aggregable-preimage-roundtrip" }
  else if eq lawField "isoDecodeEncodeRoundtrip" then { tag = "SampleLaw", typeName = "Iso", law = "iso-decode-encode-roundtrip" }
  else if eq lawField "isoEncodeDecodeRoundtrip" then { tag = "SampleLaw", typeName = "Iso", law = "iso-encode-decode-roundtrip" }
  else if eq lawField "lensGetPut" then { tag = "SampleLaw", typeName = "Lens", law = "lens-get-put" }
  else if eq lawField "lensPutGet" then { tag = "SampleLaw", typeName = "Lens", law = "lens-put-get" }
  else if eq lawField "lensPutPut" then { tag = "SampleLaw", typeName = "Lens", law = "lens-put-put" }
  else if eq lawField "migrationRoundtripLossless" then { tag = "SampleLaw", typeName = "Migration", law = "migration-roundtrip-lossless" }
  else if eq lawField "migrationForwardTotal" then { tag = "SampleLaw", typeName = "Migration", law = "migration-forward-total" }
  else if eq lawField "decidableMembershipSubsetSoundness" then { tag = "SampleLaw", typeName = "DecidableMembership", law = "decidable-membership-subset-soundness" }
  else if eq lawField "decidableMembershipDisjointSoundness" then { tag = "SampleLaw", typeName = "DecidableMembership", law = "decidable-membership-disjoint-soundness" }
  else if eq lawField "decidableMembershipEmptySoundness" then { tag = "SampleLaw", typeName = "DecidableMembership", law = "decidable-membership-empty-soundness" }
  else if eq lawField "decidableMembershipWitnessSoundness" then { tag = "SampleLaw", typeName = "DecidableMembership", law = "decidable-membership-witness-soundness" }
  else if eq lawField "compilableSemanticEquivalence" then { tag = "SampleLaw", typeName = "Compilable", law = "compilable-semantic-equivalence" }
  else if eq lawField "partialEvaluatorSoundness" then { tag = "SampleLaw", typeName = "Evaluator", law = "partial-evaluator-soundness" }
  else { tag = "None" }

-- sampleLawGrade — the sample-iteration discharge policy + messages.
@label "Sample law grade"
@description "The Phase 6c sample-iteration grade policy: any failing sample combination refutes (a counterexample is a FINDING — the reason carries the law field, the fail/total counts, and the first counterexample's bindings); any thrown sample is honest non-evidence (a crash is not a counterexample — the law stays missing); zero samples cannot claim (the kernel's samplesChecked > 0 guard); all-pass discharges. Counts arrive pre-stringified for the message (std concat does not coerce numbers — the 6b0 budget-message template)."
@tags "engine" "prover" "law" "discharge" "expr-substrate" "phase-6c"
sampleLawGrade : (total: Number) -> (passes: Number) -> (fails: Number) -> (threws: Number) -> (lawField: String) -> (failsStr: String) -> (totalStr: String) -> (counterexampleStr: String) -> a
sampleLawGrade total passes fails threws lawField failsStr totalStr counterexampleStr =
  if gt fails 0
  then { tag = "Refuted", reason = concat "sample-tested law refuted: " (concat lawField (concat ": " (concat failsStr (concat " of " (concat totalStr (concat " sample case(s) failed; first counterexample: " counterexampleStr)))))) }
  else if gt threws 0
  then { tag = "None" }
  else if lte total 0
  then { tag = "None" }
  else if eq passes total
  then { tag = "Discharged" }
  else { tag = "None" }

-- =========================================================================
-- Phase 3h additions (unified-static-analysis) — the totality-gate JOIN.
-- Brief: `workstreams/unified-static-analysis/briefs/phase-3h-totality-gate-
-- production-law-discharge.md`.
--
-- 3g shipped the kernel gate (`kernel.fenel:vpSample` rejects a
-- SampleTestResult whose SUBJECT function's totality verdict is
-- Unknown/Partial) + the `subjectTotalityVerdict` resolution seam, but it
-- stayed INERT on the real path (`dischargeSampleLaw` called `verify` 2-arg).
-- 3h plugs it in: per discharging instance, the seam gathers the subject
-- fnIds the law's `property` names (route a — the `{var: methodName}`
-- references mapped through the instance method dict; the `$`-keyed property
-- AST walk + the host record lookup are the category-B seam, in
-- engine/src/law-discharge.ts), resolves each to a totality verdict via the
-- shipped `subjectTotalityVerdict`, and folds them through `joinVerdict`
-- HERE — the conservative 3-valued meet that IS the gate's decision (any
-- Unknown ⇒ Unknown; else any Partial ⇒ Partial; else Total). The joined tag
-- threads into `verify(prop, proof, { verdict })`. An empty subject set (the
-- families whose property names no method var — Aggregable / DecidableMembership,
-- whose genuine subjects are trusted `@native` law-harnesses) folds to "Total"
-- (the meet's identity) ⇒ the gate proceeds, 0 flips.
-- =========================================================================

-- meetVerdict — the 2-ary conservative meet over totality verdict tags.
@label "Meet verdict"
@description "The 2-ary conservative meet over two totality verdict tags (unified-static-analysis Phase 3h): Unknown dominates (either Unknown ⇒ Unknown), then Partial (either Partial ⇒ Partial), else Total. The associative/commutative kernel `joinVerdict` folds. Internal helper."
@tags "engine" "internal" "prover" "law" "totality" "unified-static-analysis" "phase-3h"
@category "engine-internal"
meetVerdict : (a: String) -> (b: String) -> String
meetVerdict a b =
  if eq a "Unknown" then "Unknown"
  else if eq b "Unknown" then "Unknown"
  else if eq a "Partial" then "Partial"
  else if eq b "Partial" then "Partial"
  else "Total"

-- joinVerdict — the conservative 3-valued meet over a subject-verdict list.
@label "Join verdict"
@description "The Phase 3h totality-gate JOIN: fold a list of subject totality verdict tags (each the shipped `subjectTotalityVerdict` of one method fnId the law's property names) through the conservative meet — any Unknown ⇒ Unknown, else any Partial ⇒ Partial, else Total. An EMPTY list (the law names no method-var subject — its genuine subjects are trusted natives) folds to Total (the meet identity), so the gate proceeds. The TS seam (engine/src/law-discharge.ts) threads the result into `verify(prop, proof, { verdict })`; the kernel's `vpSample` rule rejects a SampleTestResult over an Unknown/Partial subject (Err NonTotal)."
@tags "engine" "prover" "law" "discharge" "totality" "unified-static-analysis" "phase-3h"
joinVerdict : (verdicts: a) -> String
joinVerdict verdicts =
  case head verdicts of
    Nothing -> "Total"
    Just v ->
      case tail verdicts of
        Nothing -> meetVerdict v "Total"
        Just rest -> meetVerdict v (joinVerdict rest)
