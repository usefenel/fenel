module engine where

-- =========================================================================
-- refineType — the `propose`-returns-a-refined-subtype generalisation, the
-- LADDER half. expr-substrate Phase 7 (brief:
-- `workstreams/expr-substrate/briefs/phase-7-propose-refined-subtype.md`).
--
-- THE FOUNDATIONAL CLAIM (design/solving-and-refinement.md): "prove should
-- return a refined subtype of its input proposition, not a single proof
-- term." A singleton refinement is the exact answer; a bounded refinement is
-- an interval; the input type itself = "no progress." This phase ships the
-- claim as a SIBLING operation `refine` (the kernel / ProofTerm / Proposition
-- sums stay CLOSED — `refine` IS the Structural strategy's type-level face,
-- same fragment, same kernel gate; the literal propose-subsumption is the
-- north-star, deferred until a phase re-opens the sums — decision 1).
--
-- ─────────────────────────────────────────────────────────────────────────
-- THE HOST BARRIER (the P5/6a precedent this rides). A `.fenel` body cannot
-- author the outer `$refined` FenelType or the dynamic-key JSON-Logic payload.
-- It CAN consume the registered canonical fourteen-case SetExpr ADT. The TS
-- wrapper (`dispatchedRefineType` in engine-bodies-dispatch.ts) therefore owns
-- only those irreducible boundaries: it extracts + canonicalizes the refined
-- set, asks `refineWherePred` to classify it in Fenel, lifts a returned raw
-- predicate to `Expr` via the live `jsonLogicToExpr`, maps the RefineOutcome
-- marker back to a canonical SeEnum/SeInterval + rebuilt `$refined` type, and
-- runs the kernel-round-trip SOUNDNESS GATE (decision 4). No SetExpr semantic
-- classification survives in the host wrapper.
--
-- RefineInput markers (TS-built, dispatched by the `tag` field):
--   { tag = "RiWhere", expr = Expr }   — `$refined` with a `$where` set; the
--                                        predicate lifted to Expr ⇒ run the ladder
--   { tag = "RiStructural" }           — `$refined` with an already-structural
--                                        set ($enum/$interval/…) ⇒ no-progress
--   { tag = "RiNotRefined" }           — a type but not `$refined` ⇒ no-progress
--   { tag = "RiNotType" }              — not a type at all ⇒ OutOfScope (Err)
--
-- RefineOutcome markers (the ladder's output; the TS wrapper authors the
-- canonical SetExpr from them + rebuilds the outer type and runs the gate):
--   { tag = "RfEnum", values = [v, …] }   — singleton (1) or union-of-singletons
--   { tag = "RfInterval", lo = MB, hi = MB } — bounded (MB = Maybe {value, inclusive})
--   { tag = "RfNoProgress" }              — honest "no narrowing" (return T unchanged)
--   { tag = "RfOutOfScope" }              — malformed input ⇒ Err UnprovedReason
--
-- THE LADDER (decision 3, LOCKED — maps a canonical `Se*` SetExpr to a
-- RefineOutcome; decide-substrate Phase 1 Stage B retired the Ws marker hop):
--   SeEnum [v]        ⇒ RfEnum [v]            (exact singleton)
--   SeEnum [v1…vn]    ⇒ RfEnum [v1…vn]        (union-of-singletons / multi-enum)
--   SeInterval        ⇒ RfInterval lo hi      (bounded)
--   SeIntersect       ⇒ the TIGHTENED interval (the shared seIntervalFold /
--                       tighterLo / tighterHi — inhabit.fenel); a non-interval
--                       branch or an all-unbounded fold ⇒ RfNoProgress
--   SeUnion           ⇒ merged enum IF every branch is SeEnum; any non-enum
--                       branch ⇒ RfNoProgress
--   SeWhere / SeComplement / SeAll / SeNone / anything else ⇒ RfNoProgress
-- The fragment is NOT widened here (P12 owns affine/linear inversion — it
-- widens the ONE shared `comprehend` fragment, and BOTH solve + refine
-- inherit it for free). Out-of-fragment NEVER errs — RfNoProgress is the
-- honest leaf; RfOutOfScope is reserved for malformed INPUT.
--
-- NO ENTITY DECLS (decision 6 + the audit-green invariant): the markers are
-- plain records, NOT registered ADTs — so the entity oracle + law count move
-- +0 and the audit stays exit-0 (a single new entity would re-open law
-- obligations and flip CI red). The classifier is one ordinary engine helper:
-- function roster / code-name lock +1, entity and law obligations +0.
-- =========================================================================

-- ─────────────────────────────────────────────────────────────────────────
-- refineWherePred — Fenel-owned canonical SetExpr classification for the
-- host's otherwise irreducible JSON-Logic lift.
-- ─────────────────────────────────────────────────────────────────────────

@label "Refine where predicate"
@description "Classify the canonical refined-set input for the host JSON-Logic lift: SeWhere returns its raw predicate; every other SetExpr returns Nothing. floor-kernel Phase 4 keeps SetExpr semantic recognition in Fenel while the host retains only the outer FenelType and dynamic-key JSON-Logic gateways."
@tags "engine" "internal" "refine" "floor-kernel" "phase-4"
@category "engine-internal"
refineWherePred : (set: SetExpr) -> Maybe a
refineWherePred set = case set of
  SeWhere { pred = p } -> Just p
  _ -> Nothing

-- ─────────────────────────────────────────────────────────────────────────
-- refineType — RefineInput marker → RefineOutcome marker (the entry).
-- ─────────────────────────────────────────────────────────────────────────

@label "Refine type"
@description "The `propose`-returns-a-refined-subtype generalisation (the ladder half). Takes a RefineInput marker (TS-built from a `$`-keyed type): `RiWhere` (a `$refined` whose set is a `$where` predicate, lifted to Expr) routes through `comprehend \"value\"` (the ONE recognizer) then the LADDER to a RefineOutcome (RfEnum singleton/multi-enum / RfInterval bounded / RfNoProgress); `RiStructural` (already-structural set) and `RiNotRefined` (a non-refined type) ⇒ RfNoProgress; `RiNotType` ⇒ RfOutOfScope. The kernel-round-trip soundness gate runs TS-side after this. decide-substrate Phase 1 Stage B: the ladder reads the canonical `Se*` (the Ws marker hop is gone). expr-substrate Phase 7."
@tags "engine" "refine" "prover" "expr-substrate" "phase-7" "decide-substrate" "phase-1"
refineType : (input: a) -> a
refineType input =
  if eq input.tag "RiWhere" then refineLadder (comprehend "value" input.expr)
  else if eq input.tag "RiStructural" then { tag = "RfNoProgress" }
  else if eq input.tag "RiNotRefined" then { tag = "RfNoProgress" }
  else { tag = "RfOutOfScope" }

-- ─────────────────────────────────────────────────────────────────────────
-- refineLadder — canonical `Se*` SetExpr → RefineOutcome marker (the ladder).
-- ─────────────────────────────────────────────────────────────────────────

@label "Refine ladder"
@description "The LOCKED P7 ladder over the canonical `Se*` (decide-substrate Phase 1 Stage B): SeEnum ⇒ RfEnum (singleton or union-of-singletons); SeInterval ⇒ RfInterval (bounded); SeIntersect ⇒ the tightened interval (via the shared seIntervalFold — inhabit.fenel; a non-interval branch ⇒ RfNoProgress); SeUnion ⇒ merged enum when every branch is SeEnum, else RfNoProgress; SeWhere / SeComplement / SeAll / SeNone / anything else ⇒ RfNoProgress. Out-of-fragment never errs. expr-substrate Phase 7."
@tags "engine" "refine" "prover" "expr-substrate" "phase-7" "decide-substrate" "phase-1"
refineLadder : (s: SetExpr) -> a
refineLadder s =
  case s of
    SeEnum { values = vs } -> { tag = "RfEnum", values = vs }
    SeInterval { interval = iv } -> { tag = "RfInterval", lo = iv.lo, hi = iv.hi }
    SeIntersect { branches = bs } -> refineIntersect bs
    SeUnion { branches = bs } -> refineUnion bs
    _ -> { tag = "RfNoProgress" }

-- refineIntersect — fold SeIntersect interval branches to a tightened interval.
-- Reuses the shared seIntervalFold / tighterLo / tighterHi (inhabit.fenel).
@label "refine: refineIntersect"
@description "Phase 7 — fold a SeIntersect's branches into one tightened interval via the shared seIntervalFold (tighterLo / tighterHi — inhabit.fenel); on a clean intervals-only fold with at least one present bound ⇒ RfInterval, else RfNoProgress (a non-interval branch or an all-unbounded fold). Internal helper."
@tags "engine" "internal" "refine" "expr-substrate" "phase-7"
@category "engine-internal"
refineIntersect : (branches: a) -> a
refineIntersect branches =
  let acc = seIntervalFold branches { lo = Nothing, hi = Nothing, ok = true }
  if acc.ok
  then
    if refineHasBound acc.lo acc.hi
    then { tag = "RfInterval", lo = acc.lo, hi = acc.hi }
    else { tag = "RfNoProgress" }
  else { tag = "RfNoProgress" }

-- refineHasBound — true when at least one of lo / hi is a present (Just) bound.
@label "refine: refineHasBound"
@description "Phase 7 — true when at least one of the two interval bounds is a Just (a genuine narrowing); both-Nothing is the universe ⇒ no progress. Internal helper."
@tags "engine" "internal" "refine" "expr-substrate" "phase-7"
@category "engine-internal"
refineHasBound : (lo: a) -> (hi: a) -> Bool
refineHasBound lo hi =
  case lo of
    Just b -> true
    Nothing ->
      case hi of
        Just b -> true
        Nothing -> false

-- refineUnion — merge a SeUnion's branches to one enum WHEN all are SeEnum.
-- The accumulator threads `{ values, ok }`; `ok` flips false on any
-- non-SeEnum branch (the v1 fence — only union-of-singletons merges).
@label "refine: refineUnion"
@description "Phase 7 — merge a SeUnion's branches into one RfEnum when EVERY branch is a SeEnum (union-of-singletons ⇒ multi-enum); any non-SeEnum branch ⇒ RfNoProgress (the v1 fence). Threads a `{ values, ok }` accumulator. Internal helper."
@tags "engine" "internal" "refine" "expr-substrate" "phase-7"
@category "engine-internal"
refineUnion : (branches: a) -> a
refineUnion branches =
  let acc = refineUnionFold branches { values = [], ok = true }
  if acc.ok then { tag = "RfEnum", values = acc.values } else { tag = "RfNoProgress" }

-- refineUnionFold — accumulator-threaded fold over the union branches.
@label "refine: refineUnionFold"
@description "Phase 7 — accumulator-threaded fold over SeUnion branches, threading `{ values, ok }`: a SeEnum branch appends its values; any other branch sets ok=false. Internal helper."
@tags "engine" "internal" "refine" "expr-substrate" "phase-7"
@category "engine-internal"
refineUnionFold : (branches: a) -> (acc: a) -> a
refineUnionFold branches acc =
  case head branches of
    Nothing -> acc
    Just b ->
      let acc2 = refineUnionStep acc b
      case tail branches of
        Nothing -> acc2
        Just rest -> refineUnionFold rest acc2

-- refineUnionStep — fold one union branch into the running { values, ok }.
@label "refine: refineUnionStep"
@description "Phase 7 — fold one SeUnion branch into the running `{ values, ok }`: a SeEnum branch concatenates its values; any other branch sets ok=false. Internal helper."
@tags "engine" "internal" "refine" "expr-substrate" "phase-7"
@category "engine-internal"
refineUnionStep : (acc: a) -> (b: SetExpr) -> a
refineUnionStep acc b =
  case b of
    SeEnum { values = vs } -> { values = concat acc.values vs, ok = acc.ok }
    _ -> { values = acc.values, ok = false }
