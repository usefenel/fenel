-- -------------------------------------------------------------------------
-- DETERMINISTIC native leaves (S1, 2026-10-23) — the positive list behind the
-- engine-body memo (design/tcb-ledger.md, "content-keyed replay of engine-body
-- applications"). anaCertifiedNativeLeaves above certifies TERMINATION only:
-- it lists std:now, std:formatDate and IO leaves, which are not functions of
-- their arguments. A memo recording run stores its result only when every
-- native it reached is listed HERE. Each entry was read in std-ffi.ts: it
-- computes on its argument data only (no clock, randomness, environment,
-- locale, time zone, registry or process-global table). The higher-order
-- entries (map, filter, fold, find, all, some, none, findIndex, partition,
-- takeWhile, flatMap, zipWith, sort, groupBy) re-enter the evaluator only
-- through invokeCallable on their callback, whose own natives the recording
-- sees separately. std:lower depends on the host's Unicode case tables
-- (toLowerCase, not the locale form) for text outside ASCII: it is also in
-- anaHostVariantNativeLeaves below, and an entry whose run lowercased such text
-- is bound to the recording host's case-mapping fingerprint. std:sort is the
-- engine's own stable merge over keys computed once, so its order no longer
-- depends on the host sort (2026-10-30). std:sortLex (default sort: stable,
-- code-unit order) is ES-specified. Excluded on
-- purpose: std:now, std:formatDate, std:parseDate, std:addDays,
-- std:addHours, std:diffDays (Date and locale), transcendental math
-- (std:sin/cos/tan/exp/log/pow/sqrt), std:namedSet/std:regexSet, and every
-- IO leaf. Adding an entry is a TCB change: read its implementation first.
-- -------------------------------------------------------------------------

@label "analyze: deterministic native leaves"
@description "The ids of the bodyless functions whose result is a function of their argument data alone (the deterministic-leaves block above). The engine-body memo stores a recorded result only when every native the run reached is listed here; anything else (a clock, the environment, a locale, a process-global table) leaves the result unstored."
@tags "engine" "analyze" "engine-body-memo"
anaDeterministicNativeLeaves : List String
anaDeterministicNativeLeaves =
  [
    "std:add", "std:sub", "std:mul", "std:div", "std:mod", "std:min", "std:max",
    "std:round", "std:floor", "std:ceil", "std:and", "std:or", "std:eq", "std:neq",
    "std:gt", "std:gte", "std:lt", "std:lte", "std:at", "std:chars", "std:concat",
    "std:contains", "std:elem", "std:entries", "std:fromEntries", "std:head", "std:tail", "std:take",
    "std:isArray", "std:isBoolean", "std:isNull", "std:isNumber", "std:isString",
    -- Descriptor-only observation over S1's exact admitted snapshot; numeric
    -- finiteness keeps toNum's existing nonnumber-coercion taint refusal.
    "std:representationValueSnapshot", "std:numberIsFinite",
    "std:join", "std:jsLit", "std:length", "std:lookup", "std:lower", "std:mapGet",
    "std:mapSet", "std:replaceAll", "std:slice", "std:sortLex", "std:split", "std:sum",
    "std:startsWith", "std:toString", "std:tryParseInt", "std:urlEncode",
    "std:includes", "std:unique", "std:distinctCount",
    "std:map", "std:filter", "std:fold", "std:find", "std:findIndex", "std:all",
    "std:some", "std:none", "std:partition", "std:takeWhile", "std:flatMap",
    "std:zipWith", "std:sort", "std:groupBy"
  ]

@label "analyze: host-variant deterministic native leaves"
@description "The subset of the deterministic native leaves whose result also depends on the host: std:lower reads the host's Unicode case tables for text outside ASCII. A memo entry whose run read them is replayed only where the live host fingerprint for that native equals the recorded one."
@tags "engine" "analyze" "engine-body-memo"
anaHostVariantNativeLeaves : List String
anaHostVariantNativeLeaves =
  [ "std:lower" ]

-- -------------------------------------------------------------------------
-- UNMEMOIZED engine bodies (2026-10-30) — bodies that dispatchEngineBody calls
-- WITHOUT the engine-body memo (the ordinary no-memo path, sound for every
-- body: the memo only proposes values). Criterion: the memo's key work for a
-- call (argument snapshot, portable-key digest, table compare) costs more
-- than the body's own computation, and its recordings are not stored anyway.
-- Measured for engine:collectFieldIdentitiesDelta in a Chrome worker reload
-- (2026-10-30, .tmp-diag/usable-20261030/probe-reprofile-reload-a): per call
-- a snapshot of base.kernel 1.8 s, the SHA-256 1.76 s and a 0.44 s compare,
-- against 0.18 s of computation; both recordings were refused ("uncertified
-- native"), and the replay recorder runs Delta outside the public scope, so
-- the artifact never holds a Delta entry. The facets delta (F1, 2026-11-01)
-- joins for the same reason: engine:fieldFacetsBase and
-- engine:projectFieldFacetsDelta take the retained repository facet
-- projection (thousands of facets) to add a few Local Codeables, and run only
-- in Local/account builds, whose entries no other partition reads. Removing an
-- entry only switches the memo back on for that body; adding one is a
-- performance choice, not a TCB change.
-- -------------------------------------------------------------------------

@label "analyze: unmemoized engine bodies"
@description "The engine bodies called without the engine-body memo because the memo's key work (argument snapshot and digest) costs more than their computation (the unmemoized-bodies block above). Calling a body without the memo is always sound; it only gives up reuse."
@tags "engine" "analyze" "engine-body-memo"
anaUnmemoizedBodies : List String
anaUnmemoizedBodies =
  [ "engine:collectFieldIdentitiesDelta", "engine:fieldFacetsBase", "engine:projectFieldFacetsDelta" ]

@label "analyze: native record"
@description "True when a gathered function record is a bodyless (native or host-leaf) function: the kernel seam marks such a record `native = True`. A record without the field (hand-built groups, the census) is not native."
@tags "engine" "internal" "analyze" "unified-static-analysis"
@category "engine-internal"
anaIsNative : (f: a) -> Bool
anaIsNative f =
  case lookup f "native" of
    Nothing -> False
    Just flag -> eq flag True

@label "analyze: canonical trusted head"
@description "The head the size-change oracle should see for a string call head: its canonical registry id when the spelling denotes exactly one registry id (anaSpellingTargets) and that id is a trusted std primitive (totIsTrustedPrimitive: std:sub, std:gt, std:gte, std:lt, std:lte, std:and, std:or); otherwise the spelling unchanged. A bare `gt` in a registry that also holds a user `gt` is ambiguous and stays a spelling, so it yields no fact. `$dyn:` heads and the `if` form are never rewritten. A string call head is resolved globally (a lambda or pattern binder never shadows one; a local is called through a var head)."
@tags "engine" "internal" "analyze" "unified-static-analysis"
@category "engine-internal"
anaCanonicalHead : (spelling: String) -> (registryIds: a) -> (joined: String) -> String
anaCanonicalHead spelling registryIds joined =
  if startsWith spelling "$dyn:" then spelling
  else if eq spelling "if" then spelling
  else
    let targets = anaSpellingTargets spelling registryIds joined
    let target = fromMaybe "" (head targets)
    if and (eq (length targets) 1) (totIsTrustedPrimitive target) then target else spelling

@label "analyze: canonicalize trusted heads (walk)"
@description "Rewrite every string call head of the core Expr through anaCanonicalHead, keeping each node's other fields (mapSet over the node, so marks such as a list literal's `lit` survive). Lambda bodies, match scrutinees, arm guards and bodies, constructor arguments and record field values are walked."
@tags "engine" "internal" "analyze" "unified-static-analysis"
@category "engine-internal"
anaCanonGo : (e: (Expr Any)) -> (registryIds: a) -> (joined: String) -> (Expr Any)
anaCanonGo e registryIds joined =
  case e of
    ELit { value = _ } -> e
    EVar { name = _ } -> e
    ECall { fnId = f, args = args } ->
      let headed = mapSet e "fnId" (anaCanonicalHead f registryIds joined)
      mapSet headed "args" (map (\a -> anaCanonGo a registryIds joined) args)
    ELambda { body = bd } -> mapSet e "body" (anaCanonGo bd registryIds joined)
    EMatch { scrutinee = sc, arms = arms } ->
      let withScrutinee = mapSet e "scrutinee" (anaCanonGo sc registryIds joined)
      mapSet withScrutinee "arms" (map (\arm -> anaCanonArm arm registryIds joined) arms)
    EConstruct { args = args } -> mapSet e "args" (map (\a -> anaCanonGo a registryIds joined) args)
    ERecord { fields = fields } -> mapSet e "fields" (map (\field -> mapSet field "value" (anaCanonGo field.value registryIds joined)) fields)

@label "analyze: canonicalize trusted heads (arm)"
@description "anaCanonGo over one match arm: its body, and its guard when present."
@tags "engine" "internal" "analyze" "unified-static-analysis"
@category "engine-internal"
anaCanonArm : (arm: a) -> (registryIds: b) -> (joined: String) -> a
anaCanonArm arm registryIds joined =
  let withBody = mapSet arm "body" (anaCanonGo arm.body registryIds joined)
  case lookup arm "guard" of
    Nothing -> withBody
    Just guard -> mapSet withBody "guard" (anaCanonGo guard registryIds joined)

@label "Canonicalize trusted primitive heads"
@description "The kernel projection's identity resolution for the size-change oracle (2026-10-03): rewrite each string call head of a lowered body that denotes exactly one registry id, that id being a trusted std primitive, to the canonical id (anaCanonicalHead). The oracle reads positivity, bound and descent facts only off canonical ids (totIsTrustedPrimitive), so a user function sharing a primitive's name, or an ambiguous spelling, yields none. verdictTagForIn applies it to every gathered body before the analysis."
@tags "engine" "analyze" "unified-static-analysis"
anaCanonicalizeTrusted : (body: (Expr Any)) -> (registryIds: a) -> (Expr Any)
anaCanonicalizeTrusted body registryIds = anaCanonGo body registryIds (anaJoinedIds registryIds)

@label "Totality verdict tag for a subject function, against the registry ids"
@description "THE KERNEL-GATE ENTRY (kernel.ts subjectTotalityVerdict dispatches it with the gathered records and the registry's id list, since 2026-10-03). Native records (anaIsNative: bodyless functions the seam gathered) are decided first: a native subject is Total exactly when it is a certified terminating leaf (anaCertifiedNativeLeaves), and any reached native that is not certified makes the verdict \"Unknown\" (a native that evaluates caller-supplied code can re-enter anything). The bodied records' trusted primitive heads are canonicalized (anaCanonicalizeTrusted: the size-change oracle reads facts only off canonical std ids) and their callees resolved once against the whole registry; a resolved callee with no gathered record ⇒ \"Unknown\" (anaAnyUngathered, 2026-10-03: a callee the seam lost is no evidence of termination, and a certified native is a sink only when present as a native record). The decision over the bodied records then runs on that adjacency restricted to them (anaVerdictTagOver, verdictTagFor's body; natives are absent there, so a gathered certified native stays a sink), followed by the refusal verdictTagFor cannot make without the registry's id set: a gathered body that APPLIES a reference denoting NO registry id ⇒ \"Unknown\" (anaAppliesUnchecked: a string call head other than the `if` form, the variable callee of a `$` apply, or a var-head call, whose root no binder binds; 2026-10-03 — before, only string call heads were checked, so `m.k.run $ x` over a bundle member holding the subject read Total), or that applies a gathered bodied function to more arguments than its params ⇒ \"Unknown\" (anaOverApplies: the evaluator spills the leftovers onto the result, invoking a value the analysis never checked — `idf p r` where p came from data). Such an unresolved reference is a class-method name resolved by dispatch (`fmap`), a host leaf the registry does not hold, a bundle or instance member path, or a free local recursive binding, and may re-enter the subject's group unseen. Applies to every gathered record (the kernel seam gathers exactly the subject's reach)."
@tags "engine" "analyze" "unified-static-analysis"
verdictTagForIn : (subjectId: String) -> (functions: a) -> (registryIds: b) -> String
verdictTagForIn subjectId functions registryIds =
  let certified = anaCertifiedNativeLeaves 0
  let natives = filter (\f -> anaIsNative f) functions
  let bodied = map (\f -> if f.analyzable then mapSet f "body" (anaCanonicalizeTrusted f.body registryIds) else f) (filter (\f -> not (anaIsNative f)) functions)
  if elem subjectId (anaMapIds natives) then (if elem subjectId certified then "Total" else "Unknown")
  else if gt (length (filter (\f -> not (elem f.id certified)) natives)) 0 then "Unknown"
  else
    let joined = anaJoinedIds registryIds
    let resolved = map (\f -> { id = f.id, callees = if f.analyzable then anaCalleesJoined registryIds joined f.body else [] }) bodied
    let gatheredIndex = fromEntries (map (\f -> { key = f.id, value = True }) functions)
    if anaAnyUngathered resolved gatheredIndex then "Unknown"
    else
      let bodiedIndex = fromEntries (map (\f -> { key = f.id, value = True }) bodied)
      let adjacency = map (\row -> { id = row.id, callees = filter (\c -> anaIndexHas bodiedIndex c) row.callees }) resolved
      let tag = anaVerdictTagOver subjectId bodied adjacency
      if not (eq tag "Total") then tag
      else
        let arities = fromEntries (map (\f -> { key = f.id, value = length f.params }) bodied)
        let unresolved = filter (\f -> anaAppliesUnchecked f registryIds joined arities) (filter (\f -> f.analyzable) bodied)
        if gt (length unresolved) 0 then "Unknown" else "Total"

@label "analyze: index has key"
@description "True when the record `index` (built by fromEntries) holds `key`."
@tags "engine" "internal" "analyze" "unified-static-analysis"
@category "engine-internal"
anaIndexHas : (index: a) -> (key: String) -> Bool
anaIndexHas index key =
  case mapGet index key of
    Nothing -> False
    Just _ -> True

@label "analyze: a resolved callee was not gathered"
@description "True when some row of `resolved` ({id, callees}: a bodied record's callees resolved against the whole registry) names a callee with no gathered record (`gatheredIndex`, over every record the seam passed, natives included). The seam gathers exactly the subject's reach; a missing callee means the gather lost it (a discovery failure, a truncated or hand-built record set), and treating it as a sink would assume, without evidence, that it terminates. A certified native counts as a sink only when it is present as a native record."
@tags "engine" "internal" "analyze" "unified-static-analysis"
@category "engine-internal"
anaAnyUngathered : (resolved: a) -> (gatheredIndex: b) -> Bool
anaAnyUngathered resolved gatheredIndex =
  fold (\found row -> if found then True else gt (length (filter (\c -> not (anaIndexHas gatheredIndex c)) row.callees)) 0) False resolved


-- =========================================================================
-- D. CONSTRAINT (requires) INFERENCE — the transitive typeclass-constraint
-- propagation over the call graph. unified-static-analysis Phase 4 (the
-- "effects fold-in"). Brief:
-- `workstreams/unified-static-analysis/briefs/phase-4-effects-fold-in-retire-effect-inference.md`.
--
-- NAMING — "effect inference" is LEGACY. Effects fold into typeclasses, which
-- fold into types (the subsumption arc), so a function's `requires` is a list
-- of typeclass CONSTRAINTS, and propagating them transitively up the call graph
-- is CONSTRAINT inference — a piece of type inference, NOT a separate "effect"
-- concern. The fold below is the SOURCE OF TRUTH for that inference. The legacy
-- TS `effect-inference.ts` is retained as the BOOTSTRAP PERFORMANCE BRANCH (the
-- opaque-repr-for-functions pattern), forced by two HEAD realities the Phase-4
-- audit surfaced (see the file's header ledger):
--   (1) RE-ENTRANCY. `attachInferredRequires` runs INSIDE every `createRegistry`,
--       and the Fenel-dispatch harness itself builds a registry — so the
--       load-time pass CANNOT route through `dispatchEngineBody` (it would recurse
--       infinitely during harness construction). The load pass MUST stay TS.
--   (2) The callee WALK is over RAW JSON-Logic (`call`/`pipe`/`apply`), whose keys
--       ARE evaluator ops — a `$`-key shape a Fenel body cannot author/walk. AND
--       `pipe`/`apply` do not lower to core `Expr` (normalise-to-core rejects
--       them), so reusing `analyzeCallees` over a lowered body would silently DROP
--       their callees (a parity break — Option A is NOT viable at HEAD). So the
--       callee walk stays the TS marshal boundary; the SEAM pre-resolves each
--       function's callee ids and hands the fold below `{ id, callees, requires }`
--       records (the census-runner gather-host-data-then-dispatch precedent).
-- What DOES become Fenel — and IS the genuine 2-birds the substrate was built
-- for (brief line 142: "the genuine 2-birds is the CLOSURE, not just the walk") —
-- is the transitive-reachability CLOSURE + the requires-union + the structural
-- dedup, all riding `anaReachClose` / `anaEdgesFrom` / `anaReachable` shared with
-- the SCC census. 0 entity decls (the Constraint ADT exists; requires-sets are
-- plain `List`s — the propagate/totality/analyze plain-record discipline).
--
-- INPUT function record: { id: String, callees: List String, requires: List w }
--   • id       : the registry fn-id (the call-graph node key).
--   • callees  : the registry-fn callee ids out of this function, pre-extracted
--                by the TS seam from the RAW JSON-Logic body (∩ the resolvable
--                registry set). The directed call-graph edges out of the node.
--   • requires : the function's OWN declared constraints, each MARSHALLED to a
--                `{ key: String, orig: Constraint }` wrapper by the TS seam:
--                  - key  : the dedup key STRING `${specId}::${stringified-args[0]}`
--                           (the legacy `constraintKey`), computed host-side.
--                  - orig : the Constraint value itself, riding OPAQUE — carried
--                           through the fold by `appendItem`/`totConcat` and
--                           returned EXACTLY as received (the `{$tag:"Id"}` class
--                           ref + the `{$var}`-shaped arg are never AUTHORED in
--                           Fenel; the seam unwraps `.orig` on the way out).
--
-- DEDUP is by the seam-computed STRING key (D-4-2, amended at HEAD). The brief
-- proposed comparing the (class spec-id, args[0]) key BY VALUE in Fenel, but two
-- HEAD realities forbid it: std `eq` is JS `==` (SHALLOW on records/variants — it
-- never matches two distinct constraint objects), and the structural `deepEq` op
-- is KEY-form-only (`{deepEq:[…]}`) — NOT reachable through function application
-- (`deepEq a b` lowers to a `call` whose head has no impl ⇒ null). So this fold
-- follows the KERNEL PRECEDENT (kernel.fenel: "std `eq` is shallow … structural
-- equality is PRE-COMPUTED" in the prover-ffi seam and passed as facts): the
-- structural dedup key is computed host-side as a String and compared here with
-- `eq` (string equality — sound + equivalent to the legacy stringified key on the
-- parity corpus). NOT a TS-ism leak — the seam IS the marshal boundary.
-- =========================================================================

@label "infer: edges from pre-extracted callees"
@description "Build the directed call-graph edge set {from, to} over function records carrying a pre-extracted `callees` id-list (the TS-seam form; parallel to anaBuildEdges, which extracts callees from a core Expr body). Concatenated across functions (order-irrelevant — used as a relation). REUSES anaEdgesFrom + totConcat."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqEdges : (functions: a) -> b
anaReqEdges functions =
  fold (\edges f -> anaEdgesFrom f.id f.callees edges) [] functions

@label "infer: constraint dedup-key equality"
@description "Equality of two marshalled constraints by their seam-computed dedup-key STRING (`c.key` = the legacy `${specId}::${JSON.stringify(args[0])}`). Plain string `eq` — sound because the structural key was pre-computed host-side (the kernel-precedent: std `eq` is shallow on records/variants, so structural equality is computed in the marshal seam and compared here as a String, NOT by value over the `{$tag}`/`{$var}` shapes)."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqKeyEq : (c1: a) -> (c2: a) -> Bool
anaReqKeyEq c1 c2 = eq c1.key c2.key

@label "infer: constraint member"
@description "True when constraint `c` (by its dedup key) occurs in the constraint list `cs`. Fold anaReqKeyEq over cs — the dedup membership test."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqMember : (c: a) -> (cs: b) -> Bool
anaReqMember c cs =
  fold (\found c2 -> if found then True else anaReqKeyEq c c2) False cs

@label "infer: add constraint unique"
@description "Insert constraint `c` into `acc` only if its dedup key is not already present (the structural dedup). Keeps the requires list a set by key, first-occurrence-wins (matching the TS seenKeys order)."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqAddUnique : (c: a) -> (acc: b) -> b
anaReqAddUnique c acc = if anaReqMember c acc then acc else appendItem c acc

@label "infer: union a requires list into the accumulator"
@description "Fold anaReqAddUnique over a constraint list `cs`, threading the deduped accumulator. Unions one function's declared requires into the running transitive set."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqUnion : (cs: a) -> (acc: b) -> b
anaReqUnion cs acc =
  fold (\current c -> anaReqAddUnique c current) acc cs

@label "infer: is g reached from target"
@description "True when node `gid` is the target itself (eq targetId gid) OR reachable from it in the closed relation `r`. The membership predicate for the reached-function set (self ∪ transitive callees) — matching the TS BFS whose own-requires are seeded and whose visited set is reached from the direct callees."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqIsReached : (targetId: String) -> (gid: String) -> (r: a) -> Bool
anaReqIsReached targetId gid r = if eq targetId gid then True else anaReachable targetId gid r

@label "infer: reached functions (tail)"
@description "Recurse on the tail of the function list for anaReqReached (keeps it free of case-in-let)."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqReachedTail : (targetId: String) -> (functions: a) -> (r: b) -> a
anaReqReachedTail targetId functions r =
  case tail functions of
    Nothing -> []
    Just rest -> anaReqReached targetId rest r

@label "infer: reached functions"
@description "Every function record in the list that is reached from `targetId` (the target itself, or transitively reachable in the closed relation `r`). Keeps the full records (id/callees/requires) so the union step can read their requires."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqReached : (targetId: String) -> (functions: a) -> (r: b) -> a
anaReqReached targetId functions r = filter (\g -> anaReqIsReached targetId g.id r) functions

@label "infer: collect requires over reached functions"
@description "Fold each reached function's `requires` list into the deduped accumulator (anaReqUnion). The transitive requires-union over the reached set."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqCollect : (functions: a) -> (acc: b) -> b
anaReqCollect functions acc =
  fold (\current f -> anaReqUnion f.requires current) acc functions

-- =========================================================================
-- unified-static-analysis Phase 4b — the `$dyn` / INDIRECT-DISPATCH arm (D-4b).
--
-- THE GAP (Phase-4 deferral D-4-4): the callee WALK (`collectCalledFunctions`,
-- the TS marshal seam) used to SILENTLY DROP an INDIRECT dispatch — a `call` /
-- `apply` head (or `pipe` stage) that is a non-string EXPRESSION (a function held
-- in a param/local, e.g. `applyOne f x = f x`, or `(.) f g = \x -> f (g x)`).
-- Its callee is a runtime VALUE, not a literal fn-id, so the walk dropped it and
-- the higher-order function was inferred PURE — UNSOUND (a function that runs an
-- effectful callback claiming `requires: []`).
--
-- THE FIX (the FLOOR — D-4b-1: conservative effect-opaque over-approximation).
-- The seam now emits a `$`-prefixed sentinel CALLEE token (`"$dyn"`) into the
-- `callees` list wherever an indirect dispatch occurs (it can never collide with
-- a real fnId). The DECISION — what that token MEANS — is THIS Fenel arm: a
-- reached function whose `callees` contains `"$dyn"` ⇒ the target carries an
-- effect-OPAQUE sentinel constraint (`dynSentinel`), so it can NEVER be certified
-- pure. SOUND by construction (never under-reports). The constraint VALUE itself
-- (`{$tag:"Id"}` class ref — a `$`-key shape a `.fenel` body cannot AUTHOR) is
-- marshalled IN by the seam as `dynSentinel`; the Fenel arm DECIDES its inclusion
-- (the floor-vs-north-star model lives HERE, so the constraint-variable NORTH-STAR
-- is a future Fenel-fold evolution, not a seam rewrite).
--
-- CONSUMER POLICY (D-4b-3 / D-4b-4, measured: only `.`/`$`/`bindResult` carry an
-- indirect dispatch at HEAD — the universal effect-polymorphic combinators):
--   • `findUndeclaredRequiresFor` EXEMPTS the sentinel (it is an inference-
--     completeness marker, not a missing declaration the author can ADD).
--   • the TS load-time `attachInferredRequires` STRIPS it from runtime
--     `fn.requires` (it is not declarable/dispatchable — keeping dispatch /
--     self-host / partial-eval untouched). The sentinel lives in the inference
--     QUERY output (the soundness-complete analysis), not the runtime requires.
-- =========================================================================

@label "infer: callees list contains the $dyn indirect-dispatch token"
@description "True when the callee-id list `callees` contains the `$dyn` sentinel — the marker the TS seam emits for an INDIRECT / dynamic dispatch (a non-string call/apply head or pipe stage). String membership fold."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4b"
@category "engine-internal"
anaCalleesHaveDyn : (callees: a) -> Bool
anaCalleesHaveDyn callees = elem "$dyn" callees

@label "infer: any reached function performs an indirect dispatch"
@description "True when ANY function in the reached set carries the `$dyn` indirect-dispatch token in its callees — i.e. the target transitively reaches an effect-OPAQUE dispatch. Folds anaCalleesHaveDyn over the reached functions; the predicate that gates the effect-opaque sentinel arm in inferRequiresFor (the D-4b FLOOR)."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4b"
@category "engine-internal"
anaReqReachedHasDyn : (functions: a) -> Bool
anaReqReachedHasDyn functions =
  fold (\found f -> if found then True else anaCalleesHaveDyn f.callees) False functions

@label "infer transitive requires for a function"
@description "The transitive `requires` set for `target`: union the target's OWN declared requires (own-first, matching the TS seed order) with every reached function's declared requires, deduped by the structural (class spec-id, args[0]) key. Builds the call-graph edges from the pre-extracted callees (anaReqEdges), takes the exact node-count-bounded reachability closure (anaReachClose — SHARED with the SCC census, the genuine 2-birds), collects the reached set (anaReqReached, self-inclusive), and folds. THE `$dyn` ARM (Phase 4b, D-4b FLOOR): if any reached function performs an INDIRECT dispatch (anaReqReachedHasDyn — its callees carry the `$dyn` token), union the effect-OPAQUE `dynSentinel` (marshalled IN by the seam — the `$`-key Constraint a `.fenel` body cannot author) so the target can never be certified pure. SOUND over-approximation closing the Phase-4 D-4-4 deferral. `functions` MUST contain `target` and every function transitively reachable from it (the TS marshal seam pre-resolves this reachable set host-side). The SOURCE OF TRUTH for the legacy TS `inferTransitiveRequires` (kept as the bootstrap perf branch — see the module header)."
@tags "engine" "analyze" "unified-static-analysis" "phase-4"
inferRequiresFor : (target: a) -> (functions: b) -> (dynSentinel: c) -> d
inferRequiresFor target functions dynSentinel =
  let edges = anaReqEdges functions
  let closure = anaReachClose (add (length functions) 1) edges
  let reached = anaReqReached target.id functions closure
  let acc0 = anaReqUnion target.requires []
  let acc1 = anaReqCollect reached acc0
  if anaReqReachedHasDyn reached then anaReqAddUnique dynSentinel acc1 else acc1

@label "infer: subtract declared requires (tail-threaded)"
@description "Keep each constraint of `cs` whose dedup key is NOT present in `declared`, preserving order. The set-difference inferred − declared underlying findUndeclaredRequiresFor."
@tags "engine" "internal" "analyze" "unified-static-analysis" "phase-4"
@category "engine-internal"
anaReqSubtract : (cs: a) -> (declared: b) -> (acc: c) -> c
anaReqSubtract cs declared acc =
  fold
    (\current c -> if anaReqMember c declared then current else appendItem c current)
    acc
    cs

@label "find undeclared requires for a function"
@description "The constraints `target` uses transitively but does NOT declare on its own signature: the set difference (inferRequiresFor target functions dynSentinel) − target.requires, by the structural dedup key. THE `$dyn` EXEMPTION (Phase 4b, D-4b-4): the effect-opaque `dynSentinel` is subtracted OUT of the result (a second anaReqSubtract against the singleton [dynSentinel]) — it is an inference-completeness marker, NOT a missing declaration the author can add, so it must never surface as a spurious 'undeclared requires' on a higher-order function. The SOURCE OF TRUTH for the legacy TS `findUndeclaredRequires` (the audit's undeclared-requires dimension; the TS stays the bootstrap perf branch — see the module header)."
@tags "engine" "analyze" "unified-static-analysis" "phase-4"
findUndeclaredRequiresFor : (target: a) -> (functions: b) -> (dynSentinel: c) -> d
findUndeclaredRequiresFor target functions dynSentinel =
  let inferred = inferRequiresFor target functions dynSentinel
  let undeclared = anaReqSubtract inferred target.requires []
  anaReqSubtract undeclared (appendItem dynSentinel []) []
