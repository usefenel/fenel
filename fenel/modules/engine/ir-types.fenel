-- =========================================================================
-- Compile-pipeline IR program-envelope types — shared across the three
-- compile targets (compile-js / compile-llvm / compile-wasm).
--
-- Phase 4h of ts-elimination: authored fresh against the TS source-of-truth
-- type definitions in `implementations/typescript/engine/src/compilable.ts`
-- (CompileSource, CompileError) and `implementations/typescript/engine/src/ir/`
-- (CoreProgram, EffectsExplicitProgram, HandlerSite, ClosuresExplicitProgram).
-- Unlike phases 4a–4g this body has no prior inline `*_SRC` template literal
-- to extract from — the entity declarations are written against the TS shape.
--
-- The shared file loads into the `engine` module. Each compile-{js,llvm,wasm}
-- module also loads it alongside its target-specific `types.fenel` so the
-- per-compile-module `entities` slot surfaces all program-envelope shapes
-- through the system registry catalog walk.
--
-- Front-of-pipeline deep IR ADTs (CoreExpr / CorePattern / CeExpr) live
-- in the sibling `fenel/modules/engine/ir-ast.fenel` (Phase 4i — pulled
-- out of the body fenel files that previously each redeclared a slice
-- of them). engine.ts loads `ir-ast.fenel` FIRST and this file SECOND
-- so both shared declaration sites win the first-registration-wins
-- tiebreak against body-file re-declarations.
--
-- Phase 4j moved the per-target ASTs (JsAst / WasmInstr / LlvmInstr and
-- their supporting entities) into the canonical compile-{js,wasm,llvm}/
-- types.fenel modules. This file remains the shared seven-entity envelope
-- tier; target projections supply those exact entities to compiler/self-host
-- registries without reintroducing body-file declarations.
-- =========================================================================


-- -------------------------------------------------------------------------
-- CompileFieldSlot — the single resolved compiler/reflection field shape.
-- `key` is semantic identity; `wireName` is projected only at source/runtime
-- emission seams. `type` is an explicit dynamic boundary because some
-- external reflection producers omit it, while registry-derived slots retain
-- a raw FenelType.
-- -------------------------------------------------------------------------

CompileFieldSlot = CompileFieldSlot key: FieldKey wireName: String type: Any


-- -------------------------------------------------------------------------
-- CompileSource — the input to `compile`. Mirrors
-- `compilable.ts:CompileSource` (~lines 92-126):
--   name: string
--   params: ReadonlyArray<CompileFieldSlot>
--   body: unknown (a JSON-Logic expression)
--   requires?: ReadonlyArray<string>
--   ctorDefs?: Readonly<Record<string, ReadonlyArray<CompileFieldSlot>>>
--   ctorWireNames?: Readonly<Record<string, string>>
--   callBindings?: Readonly<Record<string, string>>
--
-- The host validator normalises optional fields before the Fenel pipeline.
-- Raw JSON/body and host-owned lookup-table values stay explicit dynamic
-- boundaries; resolved params/requires carry exact list element types.
-- -------------------------------------------------------------------------

CompileSource = CompileSource name: String params: List CompileFieldSlot body: (JsonLogic Any) requires: List String ctorDefs: Any ctorWireNames: Any callBindings: Any


-- -------------------------------------------------------------------------
-- CompileError — structured failure shape. Mirrors the TS discriminated
-- union at `compilable.ts:55-59`. Four variants:
--   Unsupported reason node?      — source shape not yet lowerable
--   EffectfulCallNotHandled       — `requires` constraint with no target handler
--   UnboundVariable               — `{var: "name"}` resolves to no binding
--   InternalError                 — invariant violation in the compiler
--
-- The `node` field on Unsupported is `node?: unknown` in TS — explicit Any
-- keeps the field present so the catalog records the shape uniformly with
-- the existing normalise-to-core.fenel declaration of the same variant.
-- -------------------------------------------------------------------------

CompileError = Unsupported reason: String node: Any
  | EffectfulCallNotHandled constraint: String
  | UnboundVariable name: String
  | InternalError message: String


-- -------------------------------------------------------------------------
-- CoreProgram — the Core IR program-envelope. Mirrors `ir/core.ts:CoreProgram`
-- (~lines 208-214). `body: CoreExpr` typed against the canonical 10-case
-- CoreExpr declared in the sibling `ir-ast.fenel`. Parameters and effect
-- requirements preserve their exact compiler metadata/list shapes.
-- -------------------------------------------------------------------------

CoreProgram = CoreProgram name: String params: List CompileFieldSlot body: (Expr Any) requires: List String


-- -------------------------------------------------------------------------
-- HandlerSite — one effect-dispatch site in an EffectsExplicit body.
-- Mirrors `ir/effects-explicit.ts:HandlerSite` (~lines 55-59):
--   callPath: string  (dotted-index path into the body)
--   typeName: string (typeclass providing the method)
--   methodName: string
-- -------------------------------------------------------------------------

HandlerSite = HandlerSite callPath: String typeName: String methodName: String


-- -------------------------------------------------------------------------
-- EffectsExplicitProgram — CoreProgram + effect inventory + handler-dispatch
-- site index. Mirrors `ir/effects-explicit.ts:EffectsExplicitProgram`
-- (~lines 31-42). `body: CoreExpr` typed against the canonical ir-ast.fenel
-- declaration; effect names and handler sites carry exact list shapes.
-- -------------------------------------------------------------------------

EffectsExplicitProgram = EffectsExplicitProgram name: String params: List CompileFieldSlot body: (Expr Any) effects: List String handlerSites: List HandlerSite


-- -------------------------------------------------------------------------
-- ClosuresExplicitProgram — EffectsExplicit's body lowered through closure
-- conversion. Mirrors `ir/closures-explicit.ts:ClosuresExplicitProgram`
-- (~lines 126-132). `body: CeExpr` typed against the canonical 10-case
-- closure-converted sibling of CoreExpr (CoreLambda → CeClosure with
-- explicit captures), declared in `ir-ast.fenel`.
-- -------------------------------------------------------------------------

ClosuresExplicitProgram = ClosuresExplicitProgram name: String params: List CompileFieldSlot body: (CeExpr Any)
