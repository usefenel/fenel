module engine where

-- representations-leaves — pure-structural helpers from field-providers.ts
-- + identifiable.ts that DON'T depend on the typeclass registry.
--
-- Phase 10c sub-step 2 PARTIAL port. Mirrors the TS oracles at
-- implementations/typescript/engine/src/field-providers.ts:virtualFieldsFor
-- and implementations/typescript/engine/src/identifiable.ts:shortIdOf
-- (both now thin shims over the dispatched wrappers).
--
-- The other 42 exports across field-providers.ts + identifiable.ts +
-- representations.ts all go through typeclassRegistry.resolve /
-- listInstances / getType / addInstance — they DEFER-PROVISIONAL
-- pending Phase 10a's typeclass registry port. This sub-step is the
-- small carve-out of pure-structural leaves that land now.
--
-- Same recipe as Phase 10c sub-step 1 (field-meta.fenel): TS-side
-- pre-classification for shortIdOf via the ShortIdInput ADT. Field-identity
-- Phase 3 replaced virtualFieldsFor's dotted-string inputs with the shared
-- ProviderScope/ProviderFieldTarget model from field-providers.fenel.
--
-- All internal helpers are prefixed `repLeaves…` to avoid colliding with
-- like-named helpers in other engine bodies.

-- ---------------------------------------------------------------------------
-- virtualFieldsFor — list UUID-backed FieldRefs registered for one explicit
-- scope + owner. The lookup cannot enumerate another scope and never projects
-- a current codename.
-- ---------------------------------------------------------------------------

@label "field-providers: virtualFieldsFor"
@description "Field-identity Phase 3 — list virtual FieldRefs for an explicit provider scope and owner. Binding selection is structural and scope-isolated; readable names are projected only by the caller's registry edge."
@tags "engine" "field-providers" "field-identity" "phase-3"
virtualFieldsFor : (scope: ProviderScope) -> (owner: String) -> List FieldRef
virtualFieldsFor scope owner =
  let scoped = listBindings scope
  let matching = filter (\binding -> eq binding.target.owner owner) scoped
  map (\binding -> binding.target.field) matching

-- ---------------------------------------------------------------------------
-- ShortIdInput — pre-classified shortIdOf view.
--
-- The TS wrapper inspects `value`:
--   * non-empty string → SidString s
--   * object with non-empty string `id` field → SidObject id
--   * else → SidNone
--
-- Body dispatches on the variant and emits Maybe String (truncated to
-- 8 chars + "…" suffix when longer than 8).
-- ---------------------------------------------------------------------------

ShortIdInput =
  SidString s: String
  | SidObject id: String
  | SidNone

-- ---------------------------------------------------------------------------
-- shortIdOf — last-resort short-id helper for values lacking any other
-- label.
--
-- Mirrors the TS oracle:
--   if (typeof value === "string" && value.length > 0) {
--     return value.length > 8 ? `${value.slice(0, 8)}…` : value;
--   }
--   if (value !== null && typeof value === "object") {
--     const id = (value as Record<string, unknown>).id;
--     if (typeof id === "string" && id.length > 0) {
--       return id.length > 8 ? `${id.slice(0, 8)}…` : id;
--     }
--   }
--   return undefined;
--
-- Ellipsis is the single Unicode character U+2026 HORIZONTAL ELLIPSIS,
-- not three ASCII dots. Fenel string literals carry the codepoint
-- verbatim; the runtime `slice` / `concat` natives are JS .slice() /
-- string-concat which operate on UTF-16 code units, matching the TS
-- oracle byte-for-byte.
--
-- The truncation `if length > 8 then concat (slice s 0 8) "…" else s`
-- is inlined in both arms — single-statement, no callee. (A shared
-- top-level helper was contemplated but would require a third fnId or
-- an unsupported `where`-clause; inlining keeps the port at 2 fnIds as
-- the brief targets.)
-- ---------------------------------------------------------------------------

@label "identifiable: shortIdOf"
@description "Phase 10c sub-step 2 PARTIAL — last-resort short-id helper for values lacking any other label. The TS wrapper classifies `value` into ShortIdInput (SidString s / SidObject id / SidNone — non-empty string, object with non-empty string `id`, or none); the body dispatches on the variant + truncates inline (`slice s 0 8 ++ \"…\"` when its UTF-16 code-unit length is greater than 8, else passthrough). The shared lexer `unitLen` helper preserves JavaScript `.length` semantics for astral characters, while `slice` already uses UTF-16 indexes. Ellipsis is U+2026 HORIZONTAL ELLIPSIS, byte-equivalent to the TS oracle. Boundary adapter; dispatched via `dispatchedShortIdOf`. Mirrors implementations/typescript/engine/src/identifiable.ts:shortIdOf."
@tags "engine" "identifiable" "boundary" "phase-10c"
shortIdOf : (input: ShortIdInput) -> Maybe String
shortIdOf input = case input of
  SidString { s = s } -> Just (if unitLen s > 8 then join [slice s 0 8, "…"] "" else s)
  SidObject { id = id } -> Just (if unitLen id > 8 then join [slice id 0 8, "…"] "" else id)
  SidNone -> Nothing
