module engine where

-- identifiable — type-level representational read-throughs.
--
-- Phase 10b sub-step 1 port. Mirrors the 16 type-level helpers in
-- implementations/typescript/engine/src/identifiable.ts:25-141 — each was a
-- single typeclassRegistry.resolve call + a method-field extract. Here they
-- become five-line Fenel bodies that pattern-match on the Maybe Value
-- returned by `dispatchLookupOne` (the codeName for `dispatch:lookupOne`,
-- shipped in Phase 10a sub-step 1; its sync native is registered in
-- engine/src/modules/dispatch.ts so the bodies evaluate synchronously from
-- in-process callers).
--
-- The legacy TS surface (`getLabel`, `getDescription`, …) collapses to
-- lazy-require shims over the `dispatched*` wrappers (engine-bodies-
-- dispatch.ts); consumers continue calling `getLabel(typeName)` from TS
-- unchanged.
--
-- `Just methods` is the positional pattern: it binds the payload `_0`, the
-- one encoding Maybe has (AGENTS.md "Encodings" — the named `value` form is
-- retired, in patterns too). Returning `Just methods` builds the same shape.
--
-- Why two fnIds for `Viewable` (getDefaultView + getDefaultInlineView)?
-- Same typeclass; two methods. The body for each extracts the matching
-- field — separate fnIds keep the public TS surface unchanged.
--
-- Why no-Just-wrap for `IOInvokable.stopAction` + `listInstancesAction`?
-- Those fields are themselves `Maybe String` in the IOInvokable spec
-- record, so the body returns `methods.stopAction` directly when the
-- instance is present (no `Just`-wrap — the inner Maybe is the outer
-- return value). `getIOAction` takes the ordinary path (`ioAction` field
-- is plain `String`).

-- ---------------------------------------------------------------------------
-- Representational read-throughs
-- ---------------------------------------------------------------------------

@label "identifiable: getLabel"
@description "Phase 10b sub-step 1 — display label for a type via the Labelable typeclass. Pattern-matches on `dispatchLookupOne \"Labelable\" typeName` and extracts the `label` field. Returns `Just LocaleString` on hit, `Nothing` on miss. Boundary adapter; dispatched via `dispatchedGetLabel`. Mirrors implementations/typescript/engine/src/identifiable.ts:getLabel."
@tags "engine" "identifiable" "representational" "dispatch" "phase-10b"
getLabel : (typeName: String) -> Maybe LocaleString
getLabel typeName = case dispatchLookupOne "Labelable" typeName of
  Just methods -> Just methods.label
  Nothing -> Nothing

@label "identifiable: getDescription"
@description "Phase 10b sub-step 1 — description / documentation for a type via the Describable typeclass. Returns `Just LocaleString` on hit, `Nothing` on miss. Boundary adapter; dispatched via `dispatchedGetDescription`. Mirrors implementations/typescript/engine/src/identifiable.ts:getDescription."
@tags "engine" "identifiable" "representational" "dispatch" "phase-10b"
getDescription : (typeName: String) -> Maybe LocaleString
getDescription typeName = case dispatchLookupOne "Describable" typeName of
  Just methods -> Just methods.description
  Nothing -> Nothing

