-- ---------------------------------------------------------------------------
-- IOInvokable trio. `ioAction` is plain `String`; `stopAction` and
-- `listInstancesAction` are `Maybe String` per the IOInvokable spec — the
-- body returns the inner Maybe directly (no outer `Just`-wrap) so the
-- wrapper sees a single canonical Maybe shape per fnId.
-- ---------------------------------------------------------------------------

@label "identifiable: getIOAction"
@description "Phase 10b sub-step 1 — runtime IO handler action name for a function via the IOInvokable typeclass. The `ioAction` field is plain `String` in the spec — the body wraps it in `Just`. Returns `Just String` on hit, `Nothing` on miss. Boundary adapter; dispatched via `dispatchedGetIOAction`. Mirrors implementations/typescript/engine/src/identifiable.ts:getIOAction."
@tags "engine" "identifiable" "representational" "dispatch" "phase-10b"
getIOAction : (fnId: String) -> Maybe String
getIOAction fnId = case dispatchLookupOne "IOInvokable" fnId of
  Just methods -> Just methods.ioAction
  Nothing -> Nothing

@label "identifiable: getStopAction"
@description "Phase 10b sub-step 1 — companion stop-action for an io-invokable function via the IOInvokable typeclass. The `stopAction` field is itself `Maybe String` — the body returns `methods.stopAction` directly (no outer `Just`-wrap), so the wrapper sees a single canonical Maybe. Returns `Just String` when the io call is stoppable; `Nothing` otherwise (no instance OR instance without `stopAction`). Boundary adapter; dispatched via `dispatchedGetStopAction`. Mirrors implementations/typescript/engine/src/identifiable.ts:getStopAction."
@tags "engine" "identifiable" "representational" "dispatch" "phase-10b"
getStopAction : (fnId: String) -> Maybe String
getStopAction fnId = case dispatchLookupOne "IOInvokable" fnId of
  Just methods -> methods.stopAction
  Nothing -> Nothing

@label "identifiable: getListInstancesAction"
@description "Phase 10b sub-step 1 — handler that returns the live deployments created by an io-invokable function, via the IOInvokable typeclass. Same Maybe-flatten pattern as `getStopAction`. Returns `Just String` when the io call has a list-instances handler; `Nothing` otherwise. Boundary adapter; dispatched via `dispatchedGetListInstancesAction`. Mirrors implementations/typescript/engine/src/identifiable.ts:getListInstancesAction."
@tags "engine" "identifiable" "representational" "dispatch" "phase-10b"
getListInstancesAction : (fnId: String) -> Maybe String
getListInstancesAction fnId = case dispatchLookupOne "IOInvokable" fnId of
  Just methods -> methods.listInstancesAction
  Nothing -> Nothing

