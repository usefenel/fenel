-- ---------------------------------------------------------------------------
-- Display fallbacks (Phase 3j — identity-as-fallback)
--
-- The loader (fenel-module.ts liftIdentityFacets) used to STORE a derived
-- display name (humanized codeName) + category (the module name) as Labelable
-- / Categorizable instances on EVERY migrated function — a precomputed fallback
-- masquerading as authored data. Phase 3j stops that: a function carries
-- Codeable (the mandatory dispatch key) + only the facets it explicitly
-- declares. The derived display moves HERE, computed at read time. getLabel /
-- getCategory above stay HONEST passthroughs ("is there an instance?"); these
-- two add the fallback chain that consumers route through so no catalog / editor
-- surface shows a blank.
--
--   displayLabel id    = getLabel id    ?? humanizeCodeName (canonical (getCodeName id)) ?? id
--   displayCategory id = getCategory id ?? the id's module-prefix           ?? "uncategorized"
--
-- humanizeCodeName is a sync native (engine:humanizeCodeName) — pure camel/
-- snake/kebab → Title Case string logic, kept as the F-permanent performance
-- branch for now (the char-fold Fenel port is a flagged follow-up; the std
-- string lib has no regex-with-backreference primitive to express the
-- camelCase-boundary insertion + all-caps preservation cleanly). The terminal
-- `id` rung is the seam where typed-function-references will later slot a
-- uuid→name lookup (note it, don't build it).
-- ---------------------------------------------------------------------------

@label "identifiable: displayLabel"
@description "Phase 3j (module-substrate) — display label for an id with a read-time fallback chain: `getLabel id` (the Labelable instance, when present) → the humanized canonical codeName (`humanizeCodeName (canonical codeName)`) → the id string itself. Always returns a value (never Nothing). Replaces the humanized-codeName default the `.fenel` loader used to STORE as a Labelable on every function; the loader is now symmetric with `defineFunction` (Labelable only when explicitly declared). Boundary adapter; dispatched via `dispatchedDisplayLabel`."
@tags "engine" "identifiable" "representational" "display" "fallback" "phase-3j"
displayLabel : (id: String) -> LocaleString
displayLabel id = case getLabel id of
  Just loc -> loc
  Nothing -> case labelFromRepresentations Nothing (getCodeName id) of
    Just loc -> loc
    Nothing -> id

@label "Label from captured representations"
@description "The shared display law over already selected facts: prefer Labelable, otherwise humanize canonical Codeable. An absent label and code name stays absent."
labelFromRepresentations : (label: Maybe LocaleString) -> (codeName: Maybe LocaleString) -> Maybe LocaleString
labelFromRepresentations label codeName = case label of
  Just loc -> Just loc
  Nothing -> case codeName of
    Just cn -> Just (humanizeCodeName (locale.canonical cn))
    Nothing -> Nothing

@label "Data presentation from captured representations"
@description "Projects the data name row from exact scoped selections. A picture precedes an own icon or emoji, which remain its loading/failure fallback. Structural icons remain available to type/body renderers; selection and raw method values stay unchanged."
readerPresentationFromSnapshot : (facts: { label: Maybe LocaleString, description: Maybe LocaleString, codeName: Maybe LocaleString, icon: Maybe String, emoji: Maybe String, iconKey: Maybe Any, picture: Maybe Anything }) -> { label: Maybe LocaleString, description: Maybe LocaleString, codeName: Maybe LocaleString, icon: Maybe String, emoji: Maybe String, picture: Maybe SurfaceGlyphPicture }
readerPresentationFromSnapshot facts =
  let ownIcon = case facts.iconKey of
    Just key -> if isString key then facts.icon else Nothing
    Nothing -> Nothing
  let picture = case facts.picture of
    Just value -> surfaceReaderGlyphPicture value
    _ -> Nothing
  let fallbackEmoji = case picture of
    Just _ -> facts.emoji
    _ -> case ownIcon of
      Just _ -> Nothing
      Nothing -> facts.emoji
  { label = labelFromRepresentations facts.label facts.codeName
  , description = facts.description
  , codeName = facts.codeName
  , icon = ownIcon
  , emoji = fallbackEmoji
  , picture = picture
  }

-- The module-prefix is the id segment before the first `:` (`dispatch:sample`
-- → `dispatch`). split always yields a non-empty list, so guard on `contains`
-- first — an unprefixed id (a bare entity name like `Event`) has no module and
-- falls back to "uncategorized".
@label "identifiable: displayCategory"
@description "Phase 3j (module-substrate) — category for an id with a read-time fallback chain: `getCategory id` (the Categorizable instance, when present) → the id's module-prefix (the segment before `:`, e.g. `dispatch:sample` → `dispatch`) → \"uncategorized\" for an unprefixed id. Always returns a String. Replaces the module-name default the `.fenel` loader used to STORE as a Categorizable on every function. Boundary adapter; dispatched via `dispatchedDisplayCategory`."
@tags "engine" "identifiable" "representational" "display" "fallback" "phase-3j"
displayCategory : (id: String) -> String
displayCategory id = case getCategory id of
  Just cat -> cat
  Nothing -> if contains id ":"
    then case head (split id ":") of
      Just prefix -> prefix
      Nothing -> "uncategorized"
    else "uncategorized"

-- ---------------------------------------------------------------------------
-- Value-level helpers (fall through to type-level)
--
-- Phase 10b sub-step 2 — the 4 *OfValue helpers + their shared
-- readStringField pure helper. Each *OfValue body takes (candidates,
-- typeName) where the wrapper pre-extracts candidate strings from the
-- value's NAME_FIELDS / ICON_FIELDS / SOUND_FIELDS / DESCRIPTION_FIELDS
-- (so the body operates on List String + Maybe String, never raw JS
-- objects). Resolution order: direct candidate hit (first non-empty
-- trimmed string) -> type-level helper (getLabel / getIcon / getSound
-- / getDescription) -> Nothing.
--
-- labelOfValue + descriptionOfValue lift the type-level helper's
-- Maybe LocaleString return through `canonical` to Maybe String
-- (the value-level surface returns plain String, not localized — the
-- canonical native picks the LocaleString's first translation or the
-- raw string for non-map LocaleStrings).
--
-- iconOfValue + soundOfValue skip canonical — getIcon / getSound
-- return String, not LocaleString.
-- ---------------------------------------------------------------------------

-- Pure helper: scan a pre-extracted candidate list for the first
-- non-empty trimmed string. The wrapper pre-filters on raw.length > 0
-- but the body's trim check catches whitespace-only candidates that
-- pass the cheap length filter. Tail-recursive walk via head/tail
-- over the bounded (2-4 element) array-repr opaque List — direct
-- Nil/Cons patterns don't bind against the array runtime shape (the
-- repr is JS array, not the constructor form); use std:head + std:tail
-- per the emit-js.fenel emitExprList / buildConstructFieldsLoop
-- precedent.

@label "identifiable: readStringField"
@description "Phase 10b sub-step 2 — pure helper: scan a pre-extracted candidate list for the first non-empty trimmed string. Tail-recursive walk over the bounded (2-4 element) list emitted by the *OfValue wrappers. Returns `Just first-non-empty` or `Nothing`. Mirrors implementations/typescript/engine/src/identifiable.ts:readStringField."
@tags "engine" "identifiable" "internal" "phase-10b"
readStringField : (candidates: List String) -> Maybe String
readStringField candidates = case head candidates of
  Nothing -> Nothing
  Just h -> if eq (trim h) ""
    then case tail candidates of
      Nothing -> Nothing
      Just rest -> readStringField rest
    else Just h

-- Phase 3j — the type-level rung now routes through `displayLabel` rather than
-- a bare `getLabel`, so a value whose type carries no explicit Labelable still
-- displays (the humanized type codeName / the type id) instead of returning
-- Nothing. `canonical` lifts displayLabel's LocaleString-or-String to a plain
-- String, exactly as the old `getLabel` path did.
@label "identifiable: labelOfValue"
@description "Phase 10b sub-step 2 — display label for a specific value, falling back to its type's Labelable instance. Resolution order: (1) value-side override field (`__name` / `name` / `title` / `label`); (2) `getLabel typeName` lifted to String via `canonical`; (3) Nothing. The wrapper pre-extracts the candidate strings from the value; the body falls through to the type-level helper on miss. Mirrors implementations/typescript/engine/src/identifiable.ts:labelOfValue."
@tags "engine" "identifiable" "representational" "value-level" "phase-10b"
labelOfValue : (candidates: List String) -> (typeName: Maybe String) -> Maybe String
labelOfValue candidates typeName = case readStringField candidates of
  Just direct -> Just direct
  Nothing -> case typeName of
    Just t -> Just (locale.canonical (displayLabel t))
    Nothing -> Nothing

@label "identifiable: descriptionOfValue"
@description "Phase 10b sub-step 2 — description for a specific value, falling back to its type's Describable instance. Same shape as labelOfValue (canonical-lifted) over the `__description` / `description` fields. Mirrors implementations/typescript/engine/src/identifiable.ts:descriptionOfValue."
@tags "engine" "identifiable" "representational" "value-level" "phase-10b"
descriptionOfValue : (candidates: List String) -> (typeName: Maybe String) -> Maybe String
descriptionOfValue candidates typeName = case readStringField candidates of
  Just direct -> Just direct
  Nothing -> case typeName of
    Just t -> case getDescription t of
      Just loc -> Just (locale.canonical loc)
      Nothing -> Nothing
    Nothing -> Nothing

@label "identifiable: iconOfValue"
@description "Phase 10b sub-step 2 — icon for a specific value, falling back to its type's Iconable instance. Resolution order over the `__icon` / `icon` fields then `getIcon typeName`. No `canonical` lift — getIcon already returns String. Mirrors implementations/typescript/engine/src/identifiable.ts:iconOfValue."
@tags "engine" "identifiable" "representational" "value-level" "phase-10b"
iconOfValue : (candidates: List String) -> (typeName: Maybe String) -> Maybe String
iconOfValue candidates typeName = case readStringField candidates of
  Just direct -> Just direct
  Nothing -> case typeName of
    Just t -> getIcon t
    Nothing -> Nothing

@label "identifiable: soundOfValue"
@description "Phase 10b sub-step 2 — sound identifier for a specific value, falling back to its type's Soundable instance. Same shape as iconOfValue over the `__sound` / `sound` fields. Mirrors implementations/typescript/engine/src/identifiable.ts:soundOfValue."
@tags "engine" "identifiable" "representational" "value-level" "phase-10b"
soundOfValue : (candidates: List String) -> (typeName: Maybe String) -> Maybe String
soundOfValue candidates typeName = case readStringField candidates of
  Just direct -> Just direct
  Nothing -> case typeName of
    Just t -> getSound t
    Nothing -> Nothing

-- ---------------------------------------------------------------------------
-- Representational marker walks (Phase 10b sub-step 3)
--
-- Ports the 6 publish-surface exports in
-- implementations/typescript/engine/src/representations.ts. The bodies
-- replace the TS helpers with dispatch-primitive walks. With this
-- sub-step, representations.ts becomes the second of the 4
-- representational files (joining identifiable.ts) to be fully
-- Fenel-bodied.
--
-- Substrate primitives used (registered in modules/dispatch.ts):
--   dispatchListAllInstances "Representational" -> List { args, methods,
--     scope, priority }   — every Representational instance, full record
--   dispatchGetType typeName                  -> Maybe Value (Typeclass)
--   dispatchLookupOne typeName targetId        -> Maybe Value (methods)
--   dispatchRegister typeName args methods scope -> Unit  (sync native)
--
-- All four are sync natives; the lookup/lookupOne/lookupAll ones also
-- have an async ioAction backing for runtime-side callers. The natives
-- win in-process per invokeFunction's resolution order.
-- ---------------------------------------------------------------------------

-- representationalClassNames — list every class tagged Representational.
-- Walks every Representational instance + extracts args[0] (the tagged
-- class name). Returns a List String. The wrapper filters non-strings
-- (no Representational instance ships with an empty args list today,
-- but the filter is defensive).

@label "representations: representationalClassNames"
@description "Phase 10b sub-step 3 — list every class tagged Representational. Walks every Representational marker instance via dispatchListAllInstances + extracts args[0] (the tagged class name). Returns List String. Boundary adapter; dispatched via `dispatchedRepresentationalClassNames`. Mirrors implementations/typescript/engine/src/representations.ts:representationalClassNames."
@tags "engine" "representations" "representational" "dispatch" "phase-10b"
representationalClassNames : List String
representationalClassNames =
  let insts = dispatchListAllInstances "Representational"
  map firstArgOf insts

@label "Representational classes in a captured snapshot"
@description "Pure family projection over already admitted visible marker rows and registered class names. Reuse firstArgOf without acquiring or enumerating a registry from the execution frame."
representationalClassNamesFromSnapshot : (instances: List ({ args: List Any, methods: Any, scope: Any, priority: Number })) -> (registeredNames: List String) -> List String
representationalClassNamesFromSnapshot instances registeredNames =
  filter (\name -> and (not (eq name "")) (includes registeredNames name)) (map firstArgOf instances)

@label "representations: firstArgOf"
@description "Phase 10b sub-step 3 / signature-substrate Phase 2 — internal helper for representationalClassNames. Extracts an instance row's args[0] only when it is a string; empty/non-string arguments become \"\" and the TS wrapper filters that fallthrough."
@tags "engine" "representations" "internal" "phase-10b"
firstArgOf : (inst: { args: List Any, methods: Any, scope: Any, priority: Number }) -> String
firstArgOf inst = case head inst.args of
  Just arg -> if isString arg then arg else ""
  Nothing -> ""

-- isRepresentational — predicate over the class-name list.

@label "representations: isRepresentational"
@description "Phase 10b sub-step 3 — predicate over representationalClassNames. Returns Bool. Boundary adapter; dispatched via `dispatchedIsRepresentational`. Mirrors implementations/typescript/engine/src/representations.ts:isRepresentational."
@tags "engine" "representations" "representational" "dispatch" "phase-10b"
isRepresentational : (typeName: String) -> Boolean
isRepresentational typeName =
  includes (representationalClassNames ()) typeName

-- representationalClasses — resolve each Representational class name to
-- its full Typeclass record (name + methods + laws + supers). Names
-- whose class isn't currently registered are dropped. Returns
-- List Value (the catalog has no Typeclass system entity yet — the
-- Value is untyped; the wrapper casts).
--
-- Accumulator-threaded walk (matching the lowerJlArrayItemsAcc shape
-- in normalise-to-core.fenel): each iteration appends the resolved
-- class to acc + recurses on tail. Snoc preserves order because we
-- process names left-to-right and append to the running acc.

@label "representations: representationalClasses"
@description "Phase 10b sub-step 3 — resolve every Representational class name to its full ClassSeed record via dispatchGetType. Names whose class isn't currently registered are dropped (defensive against stale instances). Returns List Value (untyped — the catalog has no ClassSeed entity yet; the wrapper recasts). Boundary adapter; dispatched via `dispatchedRepresentationalClasses`. Mirrors implementations/typescript/engine/src/representations.ts:representationalClasses."
@tags "engine" "representations" "representational" "dispatch" "phase-10b"
representationalClasses : List Any
representationalClasses =
  let names = representationalClassNames ()
  collectClassRecordsAcc names []

@label "representations: collectClassRecordsAcc"
@description "Phase 10b sub-step 3 — internal accumulator-threaded walk for representationalClasses. Iterates names left-to-right + snocs each resolved ClassSeed onto `acc`. Order preserved via appendItem (head -> tail processing pairs with snoc-acc to give input-order output)."
@tags "engine" "representations" "internal" "phase-10b"
collectClassRecordsAcc : (names: List String) -> (acc: List Any) -> List Any
collectClassRecordsAcc names acc = case head names of
  Nothing -> acc
  Just n ->
    let nextAcc = case dispatchGetType n of
      Just tc -> appendItem tc acc
      Nothing -> acc
    case tail names of
      Nothing -> nextAcc
      Just rest -> collectClassRecordsAcc rest nextAcc

-- getRepresentation — lookup one (typeName, targetId) instance. Returns
-- Maybe Value (methods-only — the wrapper reconstructs the full
-- TypeclassInstance shape from (typeName, [targetId], methods) with
-- default scope = "account" and priority = wrapper-side Date.now()).
-- scope/priority round-trip through the wrapper, NOT the body — see
-- representations.ts:setRepresentation for the matching write-side
-- override-via-higher-priority idiom.

@label "representations: getRepresentation"
@description "Phase 10b sub-step 3 — lookup a (typeName, targetId) representational instance. Returns Maybe Value (methods-only — the wrapper reconstructs a ClassInstance shape with NO scope and priority=wrapper-side Date.now(); rights R3a §4.8 dropped the fabricated scope=\"account\", which after the ownership flip made every reconstructed row invisible). The body is a thin pass-through over dispatchLookupOne; the surface preserves the legacy TS shape for backwards-compat. Boundary adapter; dispatched via `dispatchedGetRepresentation`. Mirrors implementations/typescript/engine/src/representations.ts:getRepresentation."
@tags "engine" "representations" "representational" "dispatch" "phase-10b"
getRepresentation : (typeName: String) -> (targetId: String) -> Maybe Any
getRepresentation typeName targetId =
  dispatchLookupOne typeName targetId

-- representationsForTarget — collect every representational instance
-- attached to a target. Nested walk: for each representational class
-- name, look up the target's instance + accumulate as {typeName,
-- instance} records. Returns List { typeName: String, instance: Value }
-- (untyped instance value). The wrapper converts to Map<String,
-- TypeclassInstance>.

@label "representations: representationsForTarget"
@description "Phase 10b sub-step 3 — collect every representational instance attached to a target. Nested walk: for each representational class name, look up the target's instance + accumulate. Returns List {typeName, instance} (Fenel doesn't have a first-class Map; the wrapper converts to Map<String, ClassInstance>). Boundary adapter; dispatched via `dispatchedRepresentationsForTarget`. Mirrors implementations/typescript/engine/src/representations.ts:representationsForTarget."
@tags "engine" "representations" "representational" "dispatch" "phase-10b"
representationsForTarget : (targetId: String) -> List ({ typeName: String, instance: Any })
representationsForTarget targetId =
  let names = representationalClassNames ()
  collectReprEntriesAcc names targetId []

@label "representations: collectReprEntriesAcc"
@description "Phase 10b sub-step 3 — internal accumulator-threaded walk for representationsForTarget. Iterates class names left-to-right + for each, snocs {typeName, instance} onto `acc` when dispatchLookupOne returns Just."
@tags "engine" "representations" "internal" "phase-10b"
collectReprEntriesAcc : (names: List String) -> (targetId: String) -> (acc: List ({ typeName: String, instance: Any })) -> List ({ typeName: String, instance: Any })
collectReprEntriesAcc names targetId acc = case head names of
  Nothing -> acc
  Just cn ->
    let nextAcc = appendResolvedReprEntry cn (dispatchLookupOne cn targetId) acc
    case tail names of
      Nothing -> nextAcc
      Just rest -> collectReprEntriesAcc rest targetId nextAcc

@category "engine-internal"
appendResolvedReprEntry : (typeName: String) -> (resolved: Maybe Any) -> (acc: List ({ typeName: String, instance: Any })) -> List ({ typeName: String, instance: Any })
appendResolvedReprEntry typeName resolved acc = case resolved of
  Just instance -> appendItem { typeName = typeName, instance = instance } acc
  Nothing -> acc

@label "Representations from captured resolution"
@description "Pure projection of canonical scoped resolution results captured by a reader. It reuses the same append rule as representationsForTarget without invoking registry-read effects."
representationEntriesFromSnapshot : (resolved: List ({ typeName: String, instance: Maybe Any })) -> List ({ typeName: String, instance: Any })
representationEntriesFromSnapshot resolved = fold (\acc row -> appendResolvedReprEntry row.typeName row.instance acc) [] resolved

-- setRepresentation — add a representational instance for a target.
-- Wraps dispatchRegister (sync native) with a typed `ByType { target =
-- targetId }` DispatchKey (NOT a bare list — `dispatchKeyToInstanceArgs`
-- /the runtime `coerceDispatchKey` reject a bare `[targetId]` → silent
-- no-op; the typed key resolves to the same stored `args = [targetId]`,
-- Phase 3v.6 Surprise #63 / Phase 3w fix). Body
-- returns the constructed instance record (matching the TS surface);
-- the registry-side priority is set by the native to Date.now() so
-- this body's record carries the wire-shape scope (`Maybe String`),
-- NOT the registry's normalised InstanceScope ADT — consumers of the
-- return value treat it as a confirmation echo rather than a queryable
-- record.

@label "representations: setRepresentation"
@description "Phase 10b sub-step 3 — add or replace a representational instance for a target via dispatchRegister (sync native). Wraps args = [targetId]; preserves the TS surface's overwrite-via-higher-priority idiom (the native sets priority=Date.now()). Returns a confirmation echo record ({typeName, args, methods, scope}); the registry-side priority lives in the registry, not in the echo (consumers treat the return as a confirmation, not a queryable). In-memory only — caller is responsible for persisting to typeclass_instances. Boundary adapter; dispatched via `dispatchedSetRepresentation`. Mirrors implementations/typescript/engine/src/representations.ts:setRepresentation."
@tags "engine" "representations" "representational" "dispatch" "write" "phase-10b"
setRepresentation : (typeName: String) -> (targetId: String) -> (methods: Any) -> (scope: Maybe String) -> { typeName: String, args: List String, methods: Any, scope: Maybe String }
setRepresentation typeName targetId methods scope =
  dispatchRegister typeName (ByType { target = targetId }) methods scope
  { typeName = typeName, args = [targetId], methods = methods, scope = scope }

-- Function-catalogue descriptions retain authored prose, including an empty
-- string. Only an absent Describable requests a signature snapshot. The old
-- type-catalog.ts formatter eagerly traversed every signature and discarded
-- that work for described functions; its compact grammar now lives here.
CatalogueDescriptionPlan =
  CatalogueDescribed description: LocaleString
  | CatalogueNeedsSignature

@label "Function catalogue description plan"
@description "Keep an authored function description exactly, including an empty string or LocaleString; request the compact signature only when Describable is absent."
@category "engine-internal"
catalogueDescriptionPlan : (id: String) -> CatalogueDescriptionPlan
catalogueDescriptionPlan id = case getDescription id of
  Just description -> CatalogueDescribed { description = description }
  Nothing -> CatalogueNeedsSignature

@native
@label "Catalogue type wire key"
@description "B3 wire-envelope observation: the first own enumerable key of a raw type, without reading its values. The caller supplies this host boundary; all formatting and fallback policy remain in Fenel."
@category "engine-internal"
catalogueTypeFirstKey : (raw: Any) -> Maybe String

@label "Compact function catalogue signature"
@description "The existing catalogue grammar over a captured signature: named parameters, compact type forms and a return arrow. It deliberately retains the former object-Codeable interpolation spelling."
@category "engine-internal"
catalogueSignature : (codeName: LocaleString) -> (params: List ({ name: String, type: TraversalType })) -> (returns: TraversalType) -> (listHeadKey: FieldKey) -> String
catalogueSignature codeName params returns listHeadKey =
  let nameText = toString codeName
  let parameterText = join (map (\param -> join [param.name, ": ", catalogueTypeShort param.type listHeadKey] "") params) ", "
  join [nameText, "(", parameterText, ") → ", catalogueTypeShort returns listHeadKey] ""

@category "engine-internal"
catalogueTypeShort : (node: TraversalType) -> (listHeadKey: FieldKey) -> String
catalogueTypeShort node listHeadKey = case node of
  TtNamed { name = name, origin = origin } ->
    if eq origin "ref" then name else catalogueTypeRecognized node listHeadKey
  TtVar { name = name } -> name
  TtEl -> "$el"
  TtApp -> "$el"
  _ -> catalogueTypeRecognized node listHeadKey

@category "engine-internal"
catalogueTypeRecognized : (node: TraversalType) -> (listHeadKey: FieldKey) -> String
catalogueTypeRecognized node listHeadKey =
  let firstKey = case catalogueTypeFirstKey node.raw of
        Just key -> key
        Nothing -> "?"
  if eq firstKey "$el" then "$el"
  else case peelList node listHeadKey of
    Just _ -> case catalogueSelectedListElement node listHeadKey of
      Just inner -> join ["List(", catalogueTypeShort inner listHeadKey, ")"] ""
      Nothing -> firstKey
    Nothing -> case catalogueMaybeElement node of
      Just inner -> join ["Maybe(", catalogueTypeShort inner listHeadKey, ")"] ""
      Nothing -> catalogueTypeStructural node firstKey listHeadKey

-- Selection after the existing strict List recognizer has succeeded. This
-- retrieves its already-validated field's TraversalType, rather than starting
-- a second raw-type marshalling pass for the returned raw payload.
@category "engine-internal"
catalogueSelectedListElement : (node: TraversalType) -> (listHeadKey: FieldKey) -> Maybe TraversalType
catalogueSelectedListElement node listHeadKey = case node of
  TtRefined { base = base } -> catalogueSelectedListElement base listHeadKey
  TtOpaque { pure = pure } -> catalogueSelectedListElement pure listHeadKey
  TtMu { body = body } -> catalogueSelectedListElement body listHeadKey
  TtVariant { cases = cases } -> case setAlgebraFindCaseByName cases "Cons" of
    Nothing -> Nothing
    Just cons -> case setAlgebraFindFieldByKey cons.fields listHeadKey of
      Nothing -> Nothing
      Just field -> Just field.type
  _ -> Nothing

@category "engine-internal"
catalogueMaybeElement : (node: TraversalType) -> Maybe TraversalType
catalogueMaybeElement node = case node of
  TtRefined { base = base } -> catalogueMaybeElement base
  TtVariant { cases = cases } -> typeTraversalMaybeInner cases
  _ -> Nothing

@category "engine-internal"
catalogueTypeStructural : (node: TraversalType) -> (firstKey: String) -> (listHeadKey: FieldKey) -> String
catalogueTypeStructural node firstKey listHeadKey = case node of
  TtArrow { params = params, returns = returns } ->
    let parameterText = join (map (\param -> catalogueTypeShort param.type listHeadKey) params) ", "
    join ["(", parameterText, ") → ", catalogueTypeShort returns listHeadKey] ""
  TtTuple { items = items } ->
    join ["(", join (map (\item -> catalogueTypeShort item listHeadKey) items) ", ", ")"] ""
  TtRecord -> "Record"
  TtVariant -> "Variant"
  _ -> firstKey
