module engine where

-- =========================================================================
-- search — inhabitation over ∪/∩/¬/diff composites (DPLL(T), Fenel-native).
-- decide-substrate Phase 4 (brief:
-- `workstreams/decide-substrate/briefs/phase-4-search-union-inhabitation.md`;
-- design: `design/deciding.md` §6 — "search = inhabitation over ∪-branches").
--
-- THE MISSING SEARCH CORE. Before this, `and`/`or`/`not` was connective algebra
-- over deterministic sub-results (inhabit's seWitnessUnion = first-child-only
-- walk; seWitnessIntersect = interval-only fold; SeDiff/SeComplement ⇒ Nothing).
-- This is the fuel-bounded, emptiness-pruned WITNESS SEARCH the composites need:
--   • DPLL case-split      = choosing a union branch;
--   • backtracking         = abandoning a branch decided empty (the prune);
--   • the T-oracle         = the DecidableMembership deciders (setAlgebraContains
--                            as the filter, setAlgebraDecideEmpty as the prune).
--
-- CERTIFICATES BY CONSTRUCTION. A verdict is a lattice judgment + witness, so the
-- (unchanged) kernel re-checks every `SvFound w` through the ALREADY-WIRED and
-- (since Phase 3 D) OBJECT-COMPLETE `{w} ⊆ s` witness-membership rule — ZERO new
-- kernel rules, ZERO new evidence kinds. Search is a PROPOSER-SIDE widening: the
-- driver is untrusted; only what the deciders/kernel re-check counts.
--
-- THE HONEST `SvEmpty` BAR (decide-substrate Phase 4 §0): `SvEmpty` ONLY when the
-- refutation is itself built from decidable pieces —
--   • a union: EVERY branch decidably empty (pruned) or searched-Empty; ANY
--     branch SvUnknown ⇒ SvUnknown;
--   • an intersect/diff: a COMPLETE finite generator (enumerate `Just xs` —
--     exactness is enumerate's contract; `exact = true`) with EVERY candidate
--     decidably rejected (`Just false` on some filter).
-- Any `Nothing` filter anywhere (a "poison"), an INEXACT generator (interval
-- endpoints / a search-fallback single witness), or fuel exhaustion ⇒
-- `SvUnknown`, NEVER `SvEmpty`. The kernel's re-check would refuse a dishonest
-- Empty anyway; the bar keeps the driver from claiming more than it can defend.
--
-- THE P5 RULE (never invent inhabitants). The untyped `search` steps a
-- type-erased SeInterval by its ≤2 INCLUSIVE endpoints ONLY (a bare interval
-- carries no base type — ℝ has no canonical enumeration). The typed `searchTyped
-- base` threads a caller-provided base through `enumerableSet base` (the
-- solver-extension de-fence) to step Int/Nat/Char intervals exactly — the base
-- is PROVIDED, never invented.
--
-- FUEL (totality under no-TCO). ONE Number budget, threaded DOWN and decremented
-- at every `searchCore` re-entry (each union/intersect/diff descent + the
-- nested-generator fallback) AND per candidate test in the filter scan; every
-- recursion strictly decreases it, so it terminates when fuel hits 0 ⇒
-- `SvUnknown "fuel"` (the `anaReachClose` CAP-fold precedent). Depth-budget
-- semantics: siblings share a level's budget (the budget bounds path DEPTH +
-- local candidate work, not a single global counter — simpler, total, and
-- honest for the SvEmpty bar, since fuel-out poisons a branch to SvUnknown).
--
-- NO named-field PATTERNS (the parser-substrate fence class): shapes dispatch by
-- `seTag` then read fields by `.` (s.branches / s.interval / s.left / s.inner)
-- — the judgment.fenel idiom. Named-field CONSTRUCTS (SeComplement { inner = b })
-- keep their field values let-bound (the Stage-B/F non-atomic-construct-value
-- respell rule). ONE new entity: `SearchVerdict` (module-migrate-engine +1).
-- =========================================================================

-- SearchVerdict — the driver's untrusted verdict. All three cases FIELDED
-- (empty-record audit +0): SvFound carries the witness (the kernel re-checks it
-- via {w} ⊆ s); SvEmpty / SvUnknown carry a diagnostic note/reason string.
SearchVerdict a = SvFound witness: a | SvEmpty note: String | SvUnknown reason: String

-- Nominal internal carriers keep cross-function field identity exact under the
-- repository source-handle mode. Neither value escapes the search driver.
SearchPartition = SearchPartition gen: SetExpr rest: List SetExpr
SearchCandidates = SearchCandidates vals: List Any exact: Boolean

-- ─────────────────────────────────────────────────────────────────────────
-- The entries.
-- ─────────────────────────────────────────────────────────────────────────

@label "Search"
@description "The fuel-bounded, emptiness-pruned witness search over a canonical `Se*` composite (decide-substrate Phase 4). `search fuel s` explores ∪ branches (DPLL case-split, empty-branch prune), generates + filters ∩/diff (the first generator-capable branch feeds candidates; the rest are membership filters via setAlgebraContains), and delegates leaves to `inhabit`. Verdict: `SvFound w` (a witness the kernel re-checks via {w} ⊆ s), `SvEmpty` (a decidably-empty refutation — the honest bar), or `SvUnknown` (fuel-out / a Nothing filter / an inexact generator / a bare complement). The untyped entry steps type-erased intervals by their inclusive endpoints only (the P5 rule); `searchTyped` threads a base for exact interval stepping."
@tags "engine" "solve" "search" "inhabit" "prover" "decide-substrate" "phase-4"
search : (fuel: Number) -> (s: SetExpr) -> SearchVerdict Any
search fuel s = searchCore "" fuel s

@label "Search typed"
@description "The typed sibling of `search` (decide-substrate Phase 4 — the P5 rule): given the free var's base type (Int / Nat / Char — CALLER-provided, never invented), a bounded SeInterval generator steps EXACTLY via `enumerableSet base` (the solver-extension de-fence) instead of only its ≤2 inclusive endpoints, so the emptiness/witness search over discrete-base interval composites is complete. Every other shape behaves as `search`. A non-discrete / absent base falls back to the endpoint sampling (inexact — SvEmpty is then withheld, honest)."
@tags "engine" "solve" "search" "inhabit" "prover" "enumerable" "decide-substrate" "phase-4"
searchTyped : (base: Any) -> (fuel: Number) -> (s: SetExpr) -> SearchVerdict Any
searchTyped base fuel s = searchCore base fuel s

@label "Search default"
@description "decide-substrate Phase 4 — `search` at the named default fuel budget `256` (the constant the composite witness faces widen onto in Step B). 256 bounds branch-descent depth + candidate tests; comfortably covers comprehend-emitted composites (depth ≤ ~10, a handful of candidates) with large headroom. Calls `searchCore` directly (untyped, base \"\") — NOT bare `search`, which is an AMBIGUOUS bare name (engine:search vs notion:search); every internal entry routes through the unambiguous searchCore."
@tags "engine" "solve" "search" "inhabit" "prover" "decide-substrate" "phase-4"
searchDefault : (s: SetExpr) -> SearchVerdict Any
searchDefault s = searchCore "" 256 s

@label "search: svToMaybe"
@description "decide-substrate Phase 4 — project a SearchVerdict onto the `Maybe witness` the inhabit faces return: SvFound w ⇒ Just w; SvEmpty / SvUnknown ⇒ Nothing (both are 'no witness produced'). The adapter the Step-B composite witness faces use (svToMaybe ∘ searchDefault). Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svToMaybe : (v: SearchVerdict a) -> Maybe a
svToMaybe v =
  case v of
    SvFound w -> Just w
    SvEmpty n -> Nothing
    SvUnknown r -> Nothing

-- ─────────────────────────────────────────────────────────────────────────
-- searchCore — the fuel-guarded shape dispatcher (base "" = untyped).
-- ─────────────────────────────────────────────────────────────────────────

@label "search: searchCore"
@description "decide-substrate Phase 4 — the fuel-guarded driver core: `lte fuel 0` ⇒ SvUnknown \"fuel\"; else dispatch by seTag — SeUnion ⇒ svUnion (ordered branch exploration + empty-prune); SeIntersect ⇒ svIntersect (generator + filters); SeDiff ⇒ svDiff (a ∩ ¬b); a bare SeComplement ⇒ SvUnknown (no generator — ¬x is only searchable inside an intersect that provides one); every leaf ⇒ svLeaf (inhabit ∘ decideEmpty). The base threads the typed interval stepping. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
searchCore : (base: Any) -> (fuel: Number) -> (s: SetExpr) -> SearchVerdict Any
searchCore base fuel s =
  if lte fuel 0 then SvUnknown "fuel"
  else
    let t = seTag s
    if eq t "SeUnion" then svUnion base fuel s
    else if eq t "SeIntersect" then svIntersect base fuel s
    else if eq t "SeDiff" then svDiff base fuel s
    else if eq t "SeComplement" then SvUnknown "bare-complement"
    else svLeaf s

-- svLeaf — a non-composite shape: try inhabit for a witness; else decideEmpty to
-- distinguish a decidably-empty set (SvEmpty) from an undecidable one (SvUnknown).
@label "search: svLeaf"
@description "decide-substrate Phase 4 — search a leaf Se* shape (SeEnum / SeInterval / SeAll / SeNone / SeRef / SePattern / SeWhere): `inhabit s` Just w ⇒ SvFound w (the per-shape witness face — first enum value / inclusive interval endpoint); Nothing ⇒ setAlgebraDecideEmptyCore s Just true ⇒ SvEmpty (SeNone, an empty SeEnum), else SvUnknown (SeAll / a both-exclusive interval / out-of-fragment SeRef/SePattern/SeWhere). Calls the connective-algebra CORE, not the widened public decideEmpty — the Phase 4T D′ cycle-break. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svLeaf : (s: SetExpr) -> SearchVerdict Any
svLeaf s =
  case inhabit s of
    Just w -> SvFound w
    Nothing ->
      case setAlgebraDecideEmptyCore s of
        Just true -> SvEmpty "decided-empty"
        Just false -> SvUnknown "leaf-nonempty-no-witness"
        Nothing -> SvUnknown "leaf-undecided"

-- ─────────────────────────────────────────────────────────────────────────
-- Union — ordered branch exploration with empty-branch pruning (backtracking).
-- All branches empty ⇒ SvEmpty; any Found ⇒ Found (first); any Unknown among
-- the non-Found ⇒ SvUnknown (the honest bar — an undecided branch withholds
-- SvEmpty).
-- ─────────────────────────────────────────────────────────────────────────

@label "search: svUnion"
@description "decide-substrate Phase 4 — search a SeUnion: explore branches in order (svUnionLoop). Each branch is PRUNED first (setAlgebraDecideEmptyCore Just true ⇒ skip — backtrack-as-emptiness; the CORE, not the widened public entry — the Phase 4T D′ cycle-break), else recursed. First SvFound wins; all branches empty/pruned ⇒ SvEmpty; any SvUnknown among the non-Found ⇒ SvUnknown (the honest bar). Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svUnion : (base: Any) -> (fuel: Number) -> (s: SetExpr) -> SearchVerdict Any
svUnion base fuel s = svUnionLoop base fuel s.branches false

@label "search: svUnionLoop"
@description "decide-substrate Phase 4 — the ordered union scan: for each branch, prune (setAlgebraDecideEmptyCore Just true ⇒ skip — the D′ cycle-break) else `searchCore base (fuel-1)`; SvFound ⇒ return; SvEmpty/pruned ⇒ continue; SvUnknown ⇒ continue with the sawUnknown bit set. End: sawUnknown ⇒ SvUnknown, else SvEmpty (every branch decidably empty). Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svUnionLoop : (base: Any) -> (fuel: Number) -> (branches: List SetExpr) -> (sawUnknown: Boolean) -> SearchVerdict Any
svUnionLoop base fuel branches sawUnknown =
  case head branches of
    Nothing -> svUnionDone sawUnknown
    Just b ->
      case setAlgebraDecideEmptyCore b of
        Just true -> svUnionNext base fuel branches sawUnknown
        _ ->
          case searchCore base (sub fuel 1) b of
            SvFound w -> SvFound w
            SvEmpty n -> svUnionNext base fuel branches sawUnknown
            SvUnknown r -> svUnionNext base fuel branches true

@label "search: svUnionNext"
@description "decide-substrate Phase 4 — advance the union scan to the tail (svUnionLoop) or finish (svUnionDone) when empty. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svUnionNext : (base: Any) -> (fuel: Number) -> (branches: List SetExpr) -> (sawUnknown: Boolean) -> SearchVerdict Any
svUnionNext base fuel branches sawUnknown =
  case tail branches of
    Nothing -> svUnionDone sawUnknown
    Just rest -> svUnionLoop base fuel rest sawUnknown

@label "search: svUnionDone"
@description "decide-substrate Phase 4 — the union terminal: sawUnknown ⇒ SvUnknown \"union-exhausted\" (an undecided branch withheld SvEmpty — the honest bar); else SvEmpty \"union-all-empty\" (every branch was decidably empty). Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svUnionDone : (sawUnknown: Boolean) -> SearchVerdict Any
svUnionDone sawUnknown =
  if sawUnknown then SvUnknown "union-exhausted" else SvEmpty "union-all-empty"

-- ─────────────────────────────────────────────────────────────────────────
-- Intersect — generator + filters. Pick the FIRST generator-capable branch; the
-- rest are membership filters. A candidate passes iff EVERY filter contains it
-- (Just true); Just false ⇒ next candidate; Nothing ⇒ drop AND poison (⇒ the
-- SvEmpty floor lifts to SvUnknown).
-- ─────────────────────────────────────────────────────────────────────────

@label "search: svIntersect"
@description "decide-substrate Phase 4 — search a SeIntersect: partition the branches into the FIRST generator-capable branch (SeEnum / SeInterval / nested SeUnion|SeIntersect) and the rest-as-filters (partitionGen); then svIntersectGen. No generator-capable branch ⇒ SvUnknown \"no-generator\". Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svIntersect : (base: Any) -> (fuel: Number) -> (s: SetExpr) -> SearchVerdict Any
svIntersect base fuel s =
  case partitionGen s.branches [] of
    Nothing -> SvUnknown "no-generator"
    Just p -> svIntersectGen base fuel p.gen p.rest

@label "search: svDiff"
@description "decide-substrate Phase 4 — search a SeDiff a b as a ∩ ¬b: the generator is `a`, the single filter is `SeComplement b` (a positive contains-check of ¬b IS the negative filter of b — contains(¬b, w) = Just true iff contains(b, w) = Just false). Reuses svIntersectGen — no second composite-witness engine. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svDiff : (base: Any) -> (fuel: Number) -> (s: SetExpr) -> SearchVerdict Any
svDiff base fuel s =
  let notB = SeComplement { inner = s.right }
  let filters = appendItem notB []
  svIntersectGen base fuel s.left filters

@label "search: svIntersectGen"
@description "decide-substrate Phase 4 — the shared generator+filters engine (fed by both svIntersect and svDiff): materialize the generator's candidate set (seCandidates — with an `exact` flag: a COMPLETE enumeration vs an inexact endpoint/search sample), then scan candidates against the filters (scanCandidates). A generator that produces no candidate set ⇒ SvUnknown \"generator-failed\". Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
svIntersectGen : (base: Any) -> (fuel: Number) -> (gen: SetExpr) -> (filters: List SetExpr) -> SearchVerdict Any
svIntersectGen base fuel gen filters =
  case seCandidates base fuel gen of
    Nothing -> SvUnknown "generator-failed"
    Just c -> scanCandidates fuel filters c.exact c.vals false

-- partitionGen — find the first generator-capable branch; rest = the others,
-- order-preserved (seen ++ afterB). Nothing when no branch is generator-capable.
@label "search: partitionGen"
@description "decide-substrate Phase 4 — scan an intersect's branches for the FIRST generator-capable shape (isGeneratorShape); return { gen, rest } with rest = the other branches (order-preserved) that become membership filters. No generator-capable branch ⇒ Nothing. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
partitionGen : (branches: List SetExpr) -> (seen: List SetExpr) -> Maybe SearchPartition
partitionGen branches seen =
  case head branches of
    Nothing -> Nothing
    Just b ->
      let afterB = case tail branches of
                     Nothing -> []
                     Just r -> r
      if isGeneratorShape b then Just (SearchPartition { gen = b, rest = concat seen afterB })
      else partitionGen afterB (appendItem b seen)

@label "search: isGeneratorShape"
@description "decide-substrate Phase 4 — true when a branch can act as a candidate generator: SeEnum (its values), SeInterval (its ≤2 inclusive endpoints / typed stepping), or a nested SeUnion / SeIntersect (its own enumeration / a single-witness search fallback). Every other shape (SeAll / SeComplement / SeRef / SePattern / SeWhere / SeDiff) is filter-only. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
isGeneratorShape : (s: SetExpr) -> Boolean
isGeneratorShape s =
  let t = seTag s
  or (eq t "SeEnum") (or (eq t "SeInterval") (or (eq t "SeUnion") (eq t "SeIntersect")))

-- ─────────────────────────────────────────────────────────────────────────
-- seCandidates — materialize a generator branch into { vals, exact }.
--   SeEnum      ⇒ its values, EXACT.
--   SeInterval  ⇒ enumerableSet base (typed exact stepping), else the ≤2
--                 inclusive endpoints, INEXACT (the untyped P5 fence).
--   SeUnion/SeIntersect ⇒ enumerateSet (type-erased EXACT enum-composites),
--                 else enumerableSet base (typed interval composites), else a
--                 single-witness `searchCore` fallback (INEXACT — one sample).
-- ─────────────────────────────────────────────────────────────────────────

@label "search: seCandidates"
@description "decide-substrate Phase 4 — materialize a generator branch's candidate set as `Maybe { vals, exact }`. SeEnum ⇒ its values (exact). SeInterval ⇒ `enumerableSet base` (typed exact ℤ/Char stepping) else the ≤2 inclusive endpoints (inexact — the untyped P5 endpoint fence). Nested SeUnion/SeIntersect ⇒ `enumerateSet` (type-erased exact enum-union/enum-intersect) else `enumerableSet base` (typed interval composite) else a single-witness `searchCore` fallback (inexact). `exact` gates the honest SvEmpty (only a complete enumeration can refute). Internal helper."
@tags "engine" "internal" "solve" "search" "enumerable" "decide-substrate" "phase-4"
@category "engine-internal"
seCandidates : (base: Any) -> (fuel: Number) -> (gen: SetExpr) -> Maybe SearchCandidates
seCandidates base fuel gen =
  let t = seTag gen
  if eq t "SeEnum" then Just (SearchCandidates { vals = gen.values, exact = true })
  else if eq t "SeInterval" then seCandidatesInterval base gen
  else seCandidatesComposite base fuel gen

@label "search: seCandidatesInterval"
@description "decide-substrate Phase 4 — candidates of a SeInterval generator: `enumerableSet base` steps a discrete-base bounded interval EXACTLY (Just xs ⇒ exact); an absent/non-discrete base or unbounded interval falls back to the ≤2 inclusive endpoints (inclusiveEndpoints — INEXACT, the P5 untyped fence). Internal helper."
@tags "engine" "internal" "solve" "search" "enumerable" "decide-substrate" "phase-4"
@category "engine-internal"
seCandidatesInterval : (base: Any) -> (gen: SetExpr) -> Maybe SearchCandidates
seCandidatesInterval base gen =
  case enumerableSet base gen of
    Just xs -> Just (SearchCandidates { vals = xs, exact = true })
    Nothing -> Just (SearchCandidates { vals = inclusiveEndpoints gen, exact = false })

@label "search: seCandidatesComposite"
@description "decide-substrate Phase 4 — candidates of a nested SeUnion/SeIntersect generator: try `enumerateSet` (type-erased exact enum-composites), then `enumerableSet base` (typed discrete-base interval composites), then a single-witness `searchCore base (fuel-1)` fallback (INEXACT — one sample witness). Nothing ⇒ the generator produced nothing searchable. Internal helper."
@tags "engine" "internal" "solve" "search" "enumerable" "decide-substrate" "phase-4"
@category "engine-internal"
seCandidatesComposite : (base: Any) -> (fuel: Number) -> (gen: SetExpr) -> Maybe SearchCandidates
seCandidatesComposite base fuel gen =
  case enumerateSet gen of
    Just xs -> Just (SearchCandidates { vals = xs, exact = true })
    Nothing ->
      case enumerableSet base gen of
        Just xs -> Just (SearchCandidates { vals = xs, exact = true })
        Nothing ->
          case searchCore base (sub fuel 1) gen of
            SvFound w -> Just (SearchCandidates { vals = appendItem w [], exact = false })
            SvEmpty n -> Just (SearchCandidates { vals = [], exact = false })
            SvUnknown r -> Nothing

-- inclusiveEndpoints — the ≤2 INCLUSIVE endpoints of an interval (the P5 rule:
-- an exclusive / unbounded side contributes no canonical untyped witness).
@label "search: inclusiveEndpoints"
@description "decide-substrate Phase 4 — the ≤2 inclusive endpoints of a SeInterval generator (the untyped P5 candidate set): the lo value when the lo bound is inclusive, the hi value when the hi bound is inclusive; an exclusive or unbounded side contributes nothing (ℝ has no canonical successor). Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
inclusiveEndpoints : (gen: SetExpr) -> List Any
inclusiveEndpoints gen =
  let iv = gen.interval
  concat (endpointOf iv.lo) (endpointOf iv.hi)

@label "search: endpointOf"
@description "decide-substrate Phase 4 — a one-element list of an interval bound's value when it is INCLUSIVE, else the empty list (exclusive / unbounded contribute no untyped witness). Internal helper for inclusiveEndpoints."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
endpointOf : (b: Maybe ({ value: Any, inclusive: Boolean })) -> List Any
endpointOf b =
  case b of
    Just bound -> if bound.inclusive then appendItem bound.value [] else []
    Nothing -> []

-- ─────────────────────────────────────────────────────────────────────────
-- The candidate scan — first passing candidate ⇒ SvFound; the honest terminal.
-- ─────────────────────────────────────────────────────────────────────────

@label "search: scanCandidates"
@description "decide-substrate Phase 4 — scan candidate witnesses against the filters (fuel-decremented per test): the first candidate that passes EVERY filter (testFilters ⇒ \"pass\") ⇒ SvFound; a \"reject\" (some filter Just false) ⇒ next candidate; a \"poison\" (some filter Nothing, none false) ⇒ next candidate with the poisoned bit set. Terminal (scanDone): poisoned ⇒ SvUnknown; else exact generator ⇒ SvEmpty (every candidate of the COMPLETE set decidably rejected); else SvUnknown (an inexact generator can't refute). Fuel-out ⇒ SvUnknown. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
scanCandidates : (fuel: Number) -> (filters: List SetExpr) -> (exact: Boolean) -> (vals: List Any) -> (poisoned: Boolean) -> SearchVerdict Any
scanCandidates fuel filters exact vals poisoned =
  if lte fuel 0 then SvUnknown "fuel"
  else
    case head vals of
      Nothing -> scanDone poisoned exact
      Just w ->
        let r = testFilters filters w
        if eq r "pass" then SvFound w
        else if eq r "reject" then scanNext (sub fuel 1) filters exact vals poisoned
        else scanNext (sub fuel 1) filters exact vals true

@label "search: scanNext"
@description "decide-substrate Phase 4 — advance the candidate scan to the tail (scanCandidates) or finish (scanDone) when the candidate list is exhausted. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
scanNext : (fuel: Number) -> (filters: List SetExpr) -> (exact: Boolean) -> (vals: List Any) -> (poisoned: Boolean) -> SearchVerdict Any
scanNext fuel filters exact vals poisoned =
  case tail vals of
    Nothing -> scanDone poisoned exact
    Just rest -> scanCandidates fuel filters exact rest poisoned

@label "search: scanDone"
@description "decide-substrate Phase 4 — the candidate-scan terminal (the honest SvEmpty bar): poisoned (a Nothing filter dropped some candidate) ⇒ SvUnknown \"filter-poisoned\"; else exact (a COMPLETE finite generator, every candidate decidably rejected) ⇒ SvEmpty \"intersect-exhausted\"; else (an INEXACT generator — endpoints / a search sample) ⇒ SvUnknown \"inexact-exhausted\". Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
scanDone : (poisoned: Boolean) -> (exact: Boolean) -> SearchVerdict Any
scanDone poisoned exact =
  if poisoned then SvUnknown "filter-poisoned"
  else if exact then SvEmpty "intersect-exhausted"
  else SvUnknown "inexact-exhausted"

-- testFilters — "pass" (all filters Just true), "reject" (some filter Just
-- false — a decidable rejection wins even past an earlier Nothing), or "poison"
-- (some filter Nothing, none false — the candidate can't be certified).
@label "search: testFilters"
@description "decide-substrate Phase 4 — classify a candidate against every filter branch (setAlgebraContains): a single Just false ⇒ \"reject\" (decidably not a member — clean, even if an earlier filter was Nothing); all Just true ⇒ \"pass\"; some Nothing and no Just false ⇒ \"poison\" (can't certify — withholds SvEmpty). Scans ALL filters so a decidable rejection is preferred over a poison (maximizes honest SvEmpty). Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
testFilters : (filters: List SetExpr) -> (w: Any) -> String
testFilters filters w = testFiltersLoop filters w false

@label "search: testFiltersLoop"
@description "decide-substrate Phase 4 — the filter classification scan threading sawNothing: Just false ⇒ \"reject\" (short-circuit); Just true ⇒ continue; Nothing ⇒ continue with sawNothing set. End: sawNothing ⇒ \"poison\", else \"pass\". SeWhere filters are trustworthy at ANY depth since Phase 4T Step W — setAlgebraContains's SeWhere arm threads the candidate as an argument (whereMember), so the old SeWhere poison guard (hasWhereLeaf) is RETIRED. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
testFiltersLoop : (filters: List SetExpr) -> (w: Any) -> (sawNothing: Boolean) -> String
testFiltersLoop filters w sawNothing =
  case head filters of
    Nothing -> if sawNothing then "poison" else "pass"
    Just f ->
      case setAlgebraContains f w of
        Just false -> "reject"
        Just true -> testFiltersNext filters w sawNothing
        Nothing -> testFiltersNext filters w true

@label "search: testFiltersNext"
@description "decide-substrate Phase 4 — advance the filter scan to the tail (testFiltersLoop) or finish (sawNothing ⇒ \"poison\" else \"pass\") when the filters are exhausted. Internal helper."
@tags "engine" "internal" "solve" "search" "decide-substrate" "phase-4"
@category "engine-internal"
testFiltersNext : (filters: List SetExpr) -> (w: Any) -> (sawNothing: Boolean) -> String
testFiltersNext filters w sawNothing =
  case tail filters of
    Nothing -> if sawNothing then "poison" else "pass"
    Just rest -> testFiltersLoop rest w sawNothing

-- (hasWhereLeaf / anyHasWhere are RETIRED — decide-substrate Phase 4T Step W:
