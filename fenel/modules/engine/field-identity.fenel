module engine where

-- field-identity — the Fenel-native field model and identity kernel.
--
-- This file is the semantic authority for field identity. The TypeScript seam
-- may classify `$`-keyed FieldDef/FenelType wire shapes into the inert,
-- `$`-free TraversalType + FieldKeyInput views, invoke this body, reattach a
-- raw field by its opaque token, and index the already-resolved result. It does
-- not classify names, construct owners/paths, resolve locks, compare
-- declarations, or decide reuse.

-- -------------------------------------------------------------------------
-- Public language model
-- -------------------------------------------------------------------------

-- Durable value stored in entity_instances with entity_type = "Field" and the
-- row id equal to this value's FieldRef UUID.  The id is intentionally not
-- duplicated inside the data payload.  Repository catalog fields are generated
-- immutable facts; account rows use the same value shape and retain tombstones.
Field = Field currentCodeName: String status: AccountFieldStatus realm: DurableFieldRealm reuseVisibility: FieldReuseVisibility origin: Maybe FieldOrigin

-- FieldRef and FieldKey are declared in field-key.fenel.

FieldOwner =
  TypeFieldOwner module: Maybe String localId: String
  | FunctionFieldOwner id: String
  | InlineNominalFieldOwner parent: FieldOwner name: String

FieldIdentityRealm = RepositorySource | AccountAuthored | TransientDraft

FieldIdentityMode = StrictEmbedded | CollectRequirements | SourceHandles

FieldPathSegment =
  FieldNamed name: String
  | FieldPosition index: Nat
  | FieldCase name: String
  | FieldArrowReturn
  | FieldTuple index: Nat
  | FieldTypeArg index: Nat
  | FieldMapValue
  | FieldRefinedBase
  | FieldUnion index: Nat
  | FieldIntersect index: Nat
  | FieldComplement
  | FieldTaggedValue
  | FieldTaggedPhantom

FieldIdentityIngress =
  OrdinaryNamedIngress
  | LegacyUuidNameIngress
  | ExplicitFieldRefIngress
  | PositionalIngress

FieldOrigin = FieldOrigin owner: FieldOwner path: List FieldPathSegment

FieldLockEntry = FieldLockEntry name: String id: String

FieldLockRequest =
  FieldLockRequest name: String preferredId: Maybe String

IdentityKindEntry = IdentityKindEntry handle: String kind: String

IdentityKindIndex = IdentityKindIndex entries: List IdentityKindEntry

ExternalFieldCatalog = ExternalFieldCatalog fields: List FieldEntity

FieldDeclarationRoot =
  TypeFieldDeclarationRoot realm: FieldIdentityRealm module: Maybe String id: String params: List String declaration: a token: String constructorFunction: Undefinable (Maybe String)
  | FunctionFieldDeclarationRoot realm: FieldIdentityRealm module: Maybe String id: String params: a returns: a token: String

ResolvedFieldOccurrence = ResolvedFieldOccurrence owner: FieldOwner path: List FieldPathSegment qualifiedName: String ownerLookupKey: String containerName: String sourceName: String key: FieldKey sourceKey: FieldKeyInput token: String occurrenceType: a ingress: FieldIdentityIngress realm: FieldIdentityRealm lockRequest: Maybe FieldLockRequest declaresEntity: Boolean referenceHandle: Maybe String

FieldEntity = FieldEntity id: FieldRef currentCodeName: String origin: Maybe FieldOrigin occurrences: List ResolvedFieldOccurrence

FieldIdentityNeed = NeedsMint owner: FieldOwner path: List FieldPathSegment sourceName: String token: String

FieldIdentityAttachment = FieldIdentityAttachment owner: FieldOwner actualToken: String templateToken: String templateQualifiedName: String

FieldIdentityCollection = FieldIdentityCollection occurrences: List ResolvedFieldOccurrence entities: List FieldEntity lockRequests: List FieldLockRequest needsMint: List FieldIdentityNeed attachments: List FieldIdentityAttachment

FieldIdentityCollectInput = FieldIdentityCollectInput roots: List FieldDeclarationRoot mode: FieldIdentityMode lockEntries: List FieldLockEntry externalFields: ExternalFieldCatalog identityKinds: IdentityKindIndex mutableExternalCodeables: List FieldRef

-- Structured diagnostics. Every error carries a ready-to-display message so
-- the host boundary only wraps it in Error; branching remains Fenel-owned.
FieldIdentityError =
  InvalidFieldRealmMode message: String
  | InvalidFieldUuid message: String handle: String
  | InvalidFieldKey message: String
  | InvalidPositionalName message: String name: String
  | InvalidPositionalIndex message: String index: Number
  | ReservedPositionalName message: String name: String
  | MissingRepositoryFieldLock message: String lockName: String
  | AccountFieldNeedsUuid message: String qualifiedName: String
  | PreferredFieldUuidConflict message: String lockName: String expected: String actual: String
  | UnresolvedFieldHandle message: String handle: String
  | UnresolvedFieldSpelling message: String owner: String path: String spelling: String candidates: List String kind: String
  | WrongFieldIdentityKind message: String handle: String actualKind: String
  | ReservedDefinitionIdentity message: String handle: String repositoryKind: String
  | DuplicateFieldIdentity message: String qualifiedName: String
  | DuplicateFieldPath message: String qualifiedName: String
  | ConflictingFieldDeclaration message: String owner: FieldOwner
  | ConflictingInlineNominal message: String owner: FieldOwner
  | AmbiguousNominalFieldOwner message: String name: String
  | InvalidNominalSpecialization message: String name: String
  | FieldCodeableConflict message: String handle: String firstName: String secondName: String
  | ConflictingFieldLockRequest message: String lockName: String

-- Internal classifier used for the reserved compatibility spelling.
FieldPositionName =
  NotFieldPosition
  | CanonicalFieldPosition index: Nat
  | InvalidFieldPosition message: String

-- -------------------------------------------------------------------------
-- Typed owner/path construction and the canonical lock serializer
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityNormalizeTypeOwner : (moduleName: Maybe String) -> (incomingId: String) -> FieldOwner
fieldIdentityNormalizeTypeOwner moduleName incomingId =
  case moduleName of
    Nothing -> TypeFieldOwner { module = Nothing, localId = incomingId }
    Just m ->
      let prefix = concat m ":"
      let local =
            if startsWith incomingId prefix
            then slice incomingId (length prefix) (length incomingId)
            else incomingId
      TypeFieldOwner { module = Just m, localId = local }

@category "engine-internal"
fieldIdentityOwnerText : (owner: FieldOwner) -> String
fieldIdentityOwnerText owner =
  case owner of
    TypeFieldOwner { module = Nothing, localId = local } -> concat "type:" local
    TypeFieldOwner { module = Just m, localId = local } ->
      concat "type:" (concat m (concat ":" local))
    FunctionFieldOwner { id = fnId } -> concat "function:" fnId
    InlineNominalFieldOwner { parent = parent, name = name } ->
      concat "type:inline:" (concat (fieldIdentityOwnerText parent) (concat ":" name))

@category "engine-internal"
fieldIdentityOwnerIndexKey : (owner: FieldOwner) -> String
fieldIdentityOwnerIndexKey owner =
  case owner of
    TypeFieldOwner { module = Nothing, localId = local } ->
      concat "type/none/" (urlEncode local)
    TypeFieldOwner { module = Just m, localId = local } ->
      concat "type/module/" (concat (urlEncode m) (concat "/" (urlEncode local)))
    FunctionFieldOwner { id = fnId } -> concat "function/" (urlEncode fnId)
    InlineNominalFieldOwner { parent = parent, name = name } ->
      concat "inline/" (concat (fieldIdentityOwnerIndexKey parent) (concat "/" (urlEncode name)))

@category "engine-internal"
fieldIdentityPathSegmentText : (segment: FieldPathSegment) -> String
fieldIdentityPathSegmentText segment =
  case segment of
    FieldNamed { name = name } -> concat "named:" name
    FieldPosition { index = index } -> concat "position:" (toString index)
    FieldCase { name = name } -> concat "case:" name
    FieldArrowReturn -> "arrow-return"
    FieldTuple { index = index } -> concat "tuple:" (toString index)
    FieldTypeArg { index = index } -> concat "type-arg:" (toString index)
    FieldMapValue -> "map-value"
    FieldRefinedBase -> "refined-base"
    FieldUnion { index = index } -> concat "union:" (toString index)
    FieldIntersect { index = index } -> concat "intersect:" (toString index)
    FieldComplement -> "complement"
    FieldTaggedValue -> "tagged-value"
    FieldTaggedPhantom -> "tagged-phantom"

@category "engine-internal"
fieldIdentityEncodedPath : (segments: List FieldPathSegment) -> (acc: String) -> String
fieldIdentityEncodedPath segments acc =
  case head segments of
    Nothing -> acc
    Just segment ->
      let encoded = urlEncode (fieldIdentityPathSegmentText segment)
      let next = if eq acc "" then encoded else concat acc (concat "/" encoded)
      case tail segments of
        Nothing -> next
        Just rest -> fieldIdentityEncodedPath rest next

@label "Field identity lock name"
@description "Serialize one typed field owner + role-tagged path to the canonical universal-lock name. Every component is independently percent-encoded through std:urlEncode."
@tags "engine" "field-identity" "lock" "phase-2a"
fieldIdentityQualifiedName : (owner: FieldOwner) -> (path: List FieldPathSegment) -> String
fieldIdentityQualifiedName owner path =
  concat "field:" (concat (urlEncode (fieldIdentityOwnerText owner)) (concat "/" (fieldIdentityEncodedPath path "")))

@category "engine-internal"
fieldIdentityContainerName : (owner: FieldOwner) -> (path: List FieldPathSegment) -> String
fieldIdentityContainerName owner path =
  concat (fieldIdentityOwnerText owner) (concat "|" (fieldIdentityEncodedPath path ""))

-- -------------------------------------------------------------------------
-- UUID and reserved-position validation (pure Fenel)
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityAllDigitsFrom : (value: String) -> (index: Number) -> Boolean
fieldIdentityAllDigitsFrom value index =
  if gte index (length value)
  then true
  else
    let c = slice value index (add index 1)
    if elem c "0123456789"
    then fieldIdentityAllDigitsFrom value (add index 1)
    else false

@category "engine-internal"
fieldIdentityPositionName : (name: String) -> FieldPositionName
fieldIdentityPositionName name =
  if not (startsWith name "_")
  then NotFieldPosition
  else
    let digits = slice name 1 (length name)
    if eq (length digits) 0
    then NotFieldPosition
    else if not (fieldIdentityAllDigitsFrom digits 0)
    then NotFieldPosition
    else if and (gt (length digits) 1) (eq (slice digits 0 1) "0")
    then InvalidFieldPosition { message = concat "field-identity: non-canonical positional field name \"" (concat name "\"; use _0, _1, ... without leading zeroes") }
    else
      case tryParseInt digits of
        Nothing -> InvalidFieldPosition { message = concat "field-identity: positional field index is not a safe integer: \"" (concat name "\"") }
        Just index ->
          if gt index 9007199254740991
          then InvalidFieldPosition { message = concat "field-identity: positional field index is not a safe integer: \"" (concat name "\"") }
          else CanonicalFieldPosition { index = index }

@category "engine-internal"
fieldIdentityLowerHex : (value: String) -> String
fieldIdentityLowerHex value =
  if and (isString value) (std.all (chars value) (\character -> elem character "0123456789abcdefABCDEF-|"))
  then fold (\text pair -> replaceAll text pair.upper pair.lower) value [
    { upper = "A", lower = "a" }, { upper = "B", lower = "b" },
    { upper = "C", lower = "c" }, { upper = "D", lower = "d" },
    { upper = "E", lower = "e" }, { upper = "F", lower = "f" }
  ]
  else lower value

-- Only version/variant slices through ASCII '~' take this shortcut.
-- Non-ASCII slices, DEL and nonstring carriers keep the existing host case tables.
@category "engine-internal"
fieldIdentityUuidVersion : (value: String) -> Boolean
fieldIdentityUuidVersion value =
  if not (isString value) then isUuidVersion value
  else
    let version = slice value 14 15
    let variant = slice value 19 20
    if eq (at (sortLex [version, variant, "~"]) (-1)) "~"
    then and (elem version "12345") (elem variant "89abAB")
    else isUuidVersion value

@category "engine-internal"
fieldIdentityUuidHexFrom : (value: String) -> (index: Number) -> Boolean
fieldIdentityUuidHexFrom value index =
  if gte index 36
  then true
  else
    let c = fieldIdentityLowerHex (slice value index (add index 1))
    if elem index [8, 13, 18, 23]
    then if eq c "-" then fieldIdentityUuidHexFrom value (add index 1) else false
    else if elem c "0123456789abcdef"
    then fieldIdentityUuidHexFrom value (add index 1)
    else false

@label "Field UUID syntax"
@description "Pure RFC-4122 UUID syntax predicate used by the field identity kernel (versions 1-5 and RFC variant)."
@tags "engine" "field-identity" "uuid" "phase-2a"
-- The syntax is `std:isUuid`'s. Reuse the batch shape checker rather than
-- consulting Unicode case tables for ASCII UUIDs. Non-ASCII shape failures
-- still use the old lower-backed check; nonstrings keep the character walk.
fieldIdentityIsUuid : (value: String) -> Boolean
fieldIdentityIsUuid value =
  if isString value
  then if not (eq (length (chars value)) 36) then false
       else and (fieldIdentityUuidShapes [value]) (fieldIdentityUuidVersion value)
  else if not (eq (length value) 36) then false
  else and (fieldIdentityUuidHexFrom value 0) (isUuidVersion value)

@category "engine-internal"
fieldIdentitySourceHandleComponentFrom : (value: String) -> (index: Number) -> Boolean
fieldIdentitySourceHandleComponentFrom value index =
  if gte index (length value) then true
  else
    let char = slice value index (add index 1)
    if eq char "%" then
      if gte (add index 2) (length value) then false
      else
        let first = fieldIdentityLowerHex (slice value (add index 1) (add index 2))
        let second = fieldIdentityLowerHex (slice value (add index 2) (add index 3))
        if and (elem first "0123456789abcdef") (elem second "0123456789abcdef")
        then fieldIdentitySourceHandleComponentFrom value (add index 3)
        else false
    else if elem char "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.!~*'()"
    then fieldIdentitySourceHandleComponentFrom value (add index 1)
    else false

@category "engine-internal"
fieldIdentitySourceHandleSegmentsValid : (segments: List String) -> Boolean
fieldIdentitySourceHandleSegmentsValid segments =
  case head segments of
    Nothing -> true
    Just segment ->
      if eq segment "" then false
      else if not (fieldIdentitySourceHandleComponentFrom segment 0) then false
      else fieldIdentitySourceHandleSegmentsValid (tailOr segments)

@label "Field SourceHandle syntax"
@description "Validate a lock-less field SourceHandle without consulting a repository lock: one nonempty encoded owner plus at least one nonempty encoded path segment, with every percent escape and URI component character checked."
@tags "engine" "field-identity" "source-handle" "phase-2a"
fieldIdentityIsSourceHandle : (handle: String) -> Boolean
fieldIdentityIsSourceHandle handle =
  if not (startsWith handle "field:") then false
  else
    let segments = split (slice handle 6 (length handle)) "/"
    and (gte (length segments) 2) (fieldIdentitySourceHandleSegmentsValid segments)

-- -------------------------------------------------------------------------
-- Phase 3 semantic slot helpers
--
-- Semantic SetExpr/type/validation/compiler markers cross the host `$` barrier
-- with the ordinary public FieldKey value. A NamedField's nested ref is the
-- universal `{$ref: UUID}` carrier; `mapGet "$ref"` is the one mechanical B3
-- read. Every identity decision below is Fenel-owned.
-- -------------------------------------------------------------------------

@label "Field key handle"
@description "Return the UUID handle of a host-marshalled NamedField key, or Nothing for a positional/malformed key. The `$ref` property read is the mechanical host boundary; callers never compare the surrounding object or a wire name."
@tags "engine" "field-identity" "semantic-slot" "phase-3"
fieldKeyHandle : (key: a) -> Maybe String
fieldKeyHandle key =
  case key of
    NamedField { ref = ref } ->
      case mapGet ref "$ref" of
        Just handle -> Just handle
        Nothing -> Nothing
    PositionalField -> Nothing

@category "engine-internal"
fieldKeyValidForBoundary : (key: a) -> (allowSourceHandles: Boolean) -> Boolean
fieldKeyValidForBoundary key allowSourceHandles =
  case key of
    NamedField ->
      case fieldKeyHandle key of
        Just handle -> or (fieldIdentityIsUuid handle) (and allowSourceHandles (fieldIdentityIsSourceHandle handle))
        Nothing -> false
    PositionalField { index = index } ->
      if not (isNumber index) then false
      else if not (eq index (floor index)) then false
      else and (gte index 0) (lte index 9007199254740991)

@label "Field key valid"
@description "Validate one embedded semantic FieldKey: named keys carry an RFC-4122 UUID and positional keys carry a non-negative safe ordinal. Lock-less SourceHandles require an explicitly source-aware boundary."
@tags "engine" "field-identity" "semantic-slot" "phase-3"
fieldKeyValid : (key: a) -> Boolean
fieldKeyValid key = fieldKeyValidForBoundary key false

@label "Field key valid with SourceHandles"
@description "Source-aware boundary predicate: retain UUID/ordinal validation while additionally admitting only rigorously validated lock-less field SourceHandles."
@tags "engine" "field-identity" "semantic-slot" "source-handle" "phase-3"
fieldKeyValidWithSourceHandles : (key: a) -> Boolean
fieldKeyValidWithSourceHandles key = fieldKeyValidForBoundary key true

@category "engine-internal"
fieldDecimalDigit : (digit: Number) -> String
fieldDecimalDigit digit =
  if eq digit 0 then "0"
  else if eq digit 1 then "1"
  else if eq digit 2 then "2"
  else if eq digit 3 then "3"
  else if eq digit 4 then "4"
  else if eq digit 5 then "5"
  else if eq digit 6 then "6"
  else if eq digit 7 then "7"
  else if eq digit 8 then "8"
  else "9"

@category "engine-internal"
fieldNaturalDecimal : (value: Number) -> String
fieldNaturalDecimal value =
  if lt value 10
  then fieldDecimalDigit value
  else concat (fieldNaturalDecimal (floor (div value 10))) (fieldDecimalDigit (mod value 10))

@label "Field key token"
@description "Lossless tagged semantic-key encoding used only for indexes and symbolic variables: `n:<uuid>` or `p:<ordinal>`. Returns an invalid token for a malformed key; callers validate first."
@tags "engine" "field-identity" "semantic-slot" "phase-3"
fieldKeyToken : (key: FieldKey) -> String
fieldKeyToken key =
  case key of
    NamedField ->
      case fieldKeyHandle key of
        Just handle -> concat "n:" (fieldIdentityLowerHex handle)
        Nothing -> "invalid:named"
    PositionalField { index = index } -> concat "p:" (fieldNaturalDecimal index)

@category "engine-internal"
fieldKeyEqForBoundary : (left: a) -> (right: b) -> (allowSourceHandles: Boolean) -> Boolean
fieldKeyEqForBoundary left right allowSourceHandles =
  if not (fieldKeyValidForBoundary left allowSourceHandles)
  then false
  else if not (fieldKeyValidForBoundary right allowSourceHandles)
  then false
  else eq (fieldKeyToken left) (fieldKeyToken right)

@label "Field key equality"
@description "Embedded semantic FieldKey equality: UUID for NamedField, ordinal for PositionalField, and named/positional are distinct. Malformed keys never compare equal."
@tags "engine" "field-identity" "semantic-slot" "phase-3"
fieldKeyEq : (left: a) -> (right: b) -> Boolean
fieldKeyEq left right = fieldKeyEqForBoundary left right false

@label "Field key equality with SourceHandles"
@description "Source-aware semantic equality for compiler/source-registry boundaries. Valid UUIDs and validated SourceHandles compare by the same lossless tagged token; malformed lookalikes never compare equal."
@tags "engine" "field-identity" "semantic-slot" "source-handle" "phase-3"
fieldKeyEqWithSourceHandles : (left: a) -> (right: b) -> Boolean
fieldKeyEqWithSourceHandles left right = fieldKeyEqForBoundary left right true

@label "Field key diagnostic"
@description "Readable semantic-key projection for diagnostics. This is not a source/wire field name."
@tags "engine" "field-identity" "semantic-slot" "diagnostic" "phase-3"
fieldKeyDiagnostic : (key: a) -> String
fieldKeyDiagnostic key =
  case key of
    NamedField ->
      case fieldKeyHandle key of
        Just handle -> concat "named field " handle
        Nothing -> "malformed named field"
    PositionalField { index = index } -> concat "positional field #" (fieldNaturalDecimal index)

@category "engine-internal"
fieldSemanticSlotsErrorFrom : (slots: List a) -> (ordinal: Number) -> (seenKeys: List String) -> (seenWireNames: List String) -> (allowSourceHandles: Boolean) -> Maybe String
fieldSemanticSlotsErrorFrom slots ordinal seenKeys seenWireNames allowSourceHandles =
  case head slots of
    Nothing -> Nothing
    Just slot ->
      if not (fieldKeyValidForBoundary slot.key allowSourceHandles)
      then Just (concat "field semantic slot: invalid " (fieldKeyDiagnostic slot.key))
      else
        let token = fieldKeyToken slot.key
        if elem token seenKeys
        then Just (concat "field semantic slot: duplicate semantic field key " token)
        else if eq slot.wireName ""
        then Just (concat "field semantic slot: empty wire field name for " token)
        else if elem slot.wireName seenWireNames
        then Just (concat "field semantic slot: duplicate wire field name " slot.wireName)
        else
          case slot.key of
            PositionalField { index = index } ->
              if not (eq index ordinal)
              then Just (concat "field semantic slot: positional field key index " (concat (fieldNaturalDecimal index) (concat " does not match ordinal " (fieldNaturalDecimal ordinal))))
              else
                let expected = concat "_" (fieldNaturalDecimal ordinal)
                if not (eq slot.wireName expected)
                then Just (concat "field semantic slot: positional wire field name must be " expected)
                else fieldSemanticSlotsErrorFrom (tailOr slots) (add ordinal 1) (appendItem token seenKeys) (appendItem slot.wireName seenWireNames) allowSourceHandles
            NamedField -> fieldSemanticSlotsErrorFrom (tailOr slots) (add ordinal 1) (appendItem token seenKeys) (appendItem slot.wireName seenWireNames) allowSourceHandles

@label "Field semantic slots error"
@description "Validate one constructor/arrow/plan field list for total keys, duplicate semantic axes, duplicate current wire projections, and positional ordinal/projection agreement. Nothing means valid; Just carries a readable structured boundary diagnostic."
@tags "engine" "field-identity" "semantic-slot" "phase-3"
fieldSemanticSlotsError : (slots: List a) -> Maybe String
fieldSemanticSlotsError slots = fieldSemanticSlotsErrorFrom slots 0 [] [] false

@label "Field semantic slots error with SourceHandles"
@description "Source-aware semantic-slot validation for pre-lock compiler/source-registry boundaries. It preserves duplicate, wire, ordinal, UUID, and hostile-input laws while admitting only syntactically valid lock-less SourceHandles."
@tags "engine" "field-identity" "semantic-slot" "source-handle" "phase-3"
fieldSemanticSlotsErrorWithSourceHandles : (slots: List a) -> Maybe String
fieldSemanticSlotsErrorWithSourceHandles slots = fieldSemanticSlotsErrorFrom slots 0 [] [] true

@label "Field semantic slots valid"
@description "Boolean projection of fieldSemanticSlotsError for trusted judgment preconditions."
@tags "engine" "field-identity" "semantic-slot" "phase-3"
fieldSemanticSlotsValid : (slots: List a) -> Boolean
fieldSemanticSlotsValid slots =
  case fieldSemanticSlotsError slots of
    Nothing -> true
    Just message -> false

-- -------------------------------------------------------------------------
-- Canonical declaration equivalence over TraversalType
--
-- `raw`, labels, ui, metadata, directives, function body, and requires never
-- participate. `eq` is used only for opaque semantic payloads (dependent
-- expression and SetExpr); it is structural and property-order independent.
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityTypeListEq : (left: List a) -> (right: List a) -> Boolean
fieldIdentityTypeListEq left right =
  case head left of
    Nothing -> eq (length right) 0
    Just l ->
      case head right of
        Nothing -> false
        Just r ->
          if not (fieldIdentityTypeEq l r)
          then false
          else fieldIdentityTypeListEq (tailOr left) (tailOr right)

@category "engine-internal"
fieldIdentityFieldListEq : (left: List a) -> (right: List a) -> Boolean
fieldIdentityFieldListEq left right =
  case head left of
    Nothing -> eq (length right) 0
    Just l ->
      case head right of
        Nothing -> false
        Just r ->
          if not (eq l.name r.name)
          then false
          else if not (eq l.key r.key)
          then false
          else if not (fieldIdentityTypeEq l.type r.type)
          then false
          else fieldIdentityFieldListEq (tailOr left) (tailOr right)

@category "engine-internal"
fieldIdentityCaseListEq : (left: List a) -> (right: List a) -> Boolean
fieldIdentityCaseListEq left right =
  case head left of
    Nothing -> eq (length right) 0
    Just l ->
      case head right of
        Nothing -> false
        Just r ->
          if not (eq l.name r.name)
          then false
          else if not (fieldIdentityFieldListEq l.fields r.fields)
          then false
          else fieldIdentityCaseListEq (tailOr left) (tailOr right)

@label "Field declaration type equivalence"
@description "Deep, property-order-independent equivalence of the canonical TraversalType declaration view. Presentation and raw wire payloads are deliberately excluded."
@tags "engine" "field-identity" "equivalence" "phase-2a"
fieldIdentityTypeEq : (left: TraversalType) -> (right: TraversalType) -> Boolean
fieldIdentityTypeEq left right =
  case left of
    TtNamed { name = ln } -> case right of TtNamed { name = rn } -> eq ln rn; TtUnknown -> false; TtVar -> false; TtUnit -> false; TtVoid -> false; TtTypeUniverse -> false; TtEl -> false; TtRecord -> false; TtVariant -> false; TtTuple -> false; TtMap -> false; TtApp -> false; TtRefined -> false; TtMu -> false; TtTagged -> false; TtOpaque -> false; TtArrow -> false; TtUnion -> false; TtIntersect -> false; TtComplement -> false
    TtVar { name = ln } -> case right of TtVar { name = rn } -> eq ln rn; TtUnknown -> false; TtNamed -> false; TtUnit -> false; TtVoid -> false; TtTypeUniverse -> false; TtEl -> false; TtRecord -> false; TtVariant -> false; TtTuple -> false; TtMap -> false; TtApp -> false; TtRefined -> false; TtMu -> false; TtTagged -> false; TtOpaque -> false; TtArrow -> false; TtUnion -> false; TtIntersect -> false; TtComplement -> false
    TtUnit -> case right of TtUnit -> true; TtUnknown -> false; TtNamed -> false; TtVar -> false; TtVoid -> false; TtTypeUniverse -> false; TtEl -> false; TtRecord -> false; TtVariant -> false; TtTuple -> false; TtMap -> false; TtApp -> false; TtRefined -> false; TtMu -> false; TtTagged -> false; TtOpaque -> false; TtArrow -> false; TtUnion -> false; TtIntersect -> false; TtComplement -> false
    TtVoid -> case right of TtVoid -> true; TtUnknown -> false; TtNamed -> false; TtVar -> false; TtUnit -> false; TtTypeUniverse -> false; TtEl -> false; TtRecord -> false; TtVariant -> false; TtTuple -> false; TtMap -> false; TtApp -> false; TtRefined -> false; TtMu -> false; TtTagged -> false; TtOpaque -> false; TtArrow -> false; TtUnion -> false; TtIntersect -> false; TtComplement -> false
    TtTypeUniverse -> case right of TtTypeUniverse -> true; TtUnknown -> false; TtNamed -> false; TtVar -> false; TtUnit -> false; TtVoid -> false; TtEl -> false; TtRecord -> false; TtVariant -> false; TtTuple -> false; TtMap -> false; TtApp -> false; TtRefined -> false; TtMu -> false; TtTagged -> false; TtOpaque -> false; TtArrow -> false; TtUnion -> false; TtIntersect -> false; TtComplement -> false
    TtEl { content = lc } -> case right of TtEl { content = rc } -> eq lc rc; TtUnknown -> false; TtNamed -> false; TtVar -> false; TtUnit -> false; TtVoid -> false; TtTypeUniverse -> false; TtRecord -> false; TtVariant -> false; TtTuple -> false; TtMap -> false; TtApp -> false; TtRefined -> false; TtMu -> false; TtTagged -> false; TtOpaque -> false; TtArrow -> false; TtUnion -> false; TtIntersect -> false; TtComplement -> false
    TtRecord { fields = lf } -> case right of TtRecord { fields = rf } -> fieldIdentityFieldListEq lf rf; TtUnknown -> false; TtNamed -> false; TtVar -> false; TtUnit -> false; TtVoid -> false; TtTypeUniverse -> false; TtEl -> false; TtVariant -> false; TtTuple -> false; TtMap -> false; TtApp -> false; TtRefined -> false; TtMu -> false; TtTagged -> false; TtOpaque -> false; TtArrow -> false; TtUnion -> false; TtIntersect -> false; TtComplement -> false
    TtVariant { cases = lc, discriminator = ld } -> case right of TtVariant { cases = rc, discriminator = rd } -> and (eq ld rd) (fieldIdentityCaseListEq lc rc); TtUnknown -> false; TtNamed -> false; TtVar -> false; TtUnit -> false; TtVoid -> false; TtTypeUniverse -> false; TtEl -> false; TtRecord -> false; TtTuple -> false; TtMap -> false; TtApp -> false; TtRefined -> false; TtMu -> false; TtTagged -> false; TtOpaque -> false; TtArrow -> false; TtUnion -> false; TtIntersect -> false; TtComplement -> false
