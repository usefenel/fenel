-- -------------------------------------------------------------------------
-- Root normalization and declaration deduplication
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityRootOwner : (root: FieldDeclarationRoot) -> FieldOwner
fieldIdentityRootOwner root =
  case root of
    TypeFieldDeclarationRoot { module = m, id = id } ->
      fieldIdentityNormalizeTypeOwner m id
    FunctionFieldDeclarationRoot { id = id } -> FunctionFieldOwner { id = id }

@category "engine-internal"
fieldIdentityRootModule : (root: FieldDeclarationRoot) -> Maybe String
fieldIdentityRootModule root =
  case root of
    TypeFieldDeclarationRoot { module = m } -> m
    FunctionFieldDeclarationRoot { module = m, id = id } ->
      case m of
        Just explicit -> Just explicit
        Nothing ->
          let pieces = split id ":"
          if gt (length pieces) 1 then head pieces else Nothing

@category "engine-internal"
fieldIdentityRootRealm : (root: FieldDeclarationRoot) -> FieldIdentityRealm
fieldIdentityRootRealm root =
  case root of
    TypeFieldDeclarationRoot { realm = realm } -> realm
    FunctionFieldDeclarationRoot { realm = realm } -> realm

@category "engine-internal"
fieldIdentityConstructorRefs : TraversalType -> List (Maybe String)
fieldIdentityConstructorRefs declaration =
  case declaration of
    TtVariant { cases = cases } -> map (\variantCase -> fromMaybe Nothing (lookup variantCase "constructorFunction")) cases
    TtOpaque { pure = pure } -> fieldIdentityConstructorRefs pure
    _ -> []

@category "engine-internal"
fieldIdentityConstructorOwnershipEq : (left: a) -> (right: a) -> Boolean
fieldIdentityConstructorOwnershipEq left right =
  and (eq (fromMaybe Nothing (lookup left "constructorFunction")) (fromMaybe Nothing (lookup right "constructorFunction")))
    (eq (fieldIdentityConstructorRefs left.declaration) (fieldIdentityConstructorRefs right.declaration))

@category "engine-internal"
fieldIdentityRootDeclarationEq : (left: FieldDeclarationRoot) -> (right: FieldDeclarationRoot) -> Boolean
fieldIdentityRootDeclarationEq left right =
  case left of
    TypeFieldDeclarationRoot { params = lp, declaration = ld } ->
      case right of
        TypeFieldDeclarationRoot { params = rp, declaration = rd } ->
          and (and (eq lp rp) (fieldIdentityTypeEq ld rd)) (fieldIdentityConstructorOwnershipEq left right)
        FunctionFieldDeclarationRoot -> false
    FunctionFieldDeclarationRoot { params = lp, returns = lr } ->
      case right of
        TypeFieldDeclarationRoot -> false
        FunctionFieldDeclarationRoot { params = rp, returns = rr } ->
          and (fieldIdentityFieldListEq lp rp) (fieldIdentityTypeEq lr rr)

@category "engine-internal"
fieldIdentityNominalParamsErrorFrom : (name: String) -> (params: List String) -> (seen: List String) -> Maybe FieldIdentityError
fieldIdentityNominalParamsErrorFrom name params seen =
  case head params of
    Nothing -> Nothing
    Just param ->
      if eq param ""
      then Just (InvalidNominalSpecialization {
        message = concat "field-identity: registered nominal \"" (concat name "\" declares an empty type parameter"),
        name = name
      })
      else if elem param seen
      then Just (InvalidNominalSpecialization {
        message = concat "field-identity: registered nominal \"" (concat name (concat "\" declares duplicate type parameter \"" (concat param "\""))),
        name = name
      })
      else fieldIdentityNominalParamsErrorFrom name (tailOr params) (appendItem param seen)

@category "engine-internal"
fieldIdentityNominalRootsParamsError : (roots: List FieldDeclarationRoot) -> Maybe FieldIdentityError
fieldIdentityNominalRootsParamsError roots =
  fold
    (\state root ->
      case state of
        Just err -> Just err
        Nothing ->
          case root of
            FunctionFieldDeclarationRoot -> Nothing
            TypeFieldDeclarationRoot { id = id, params = params } ->
              fieldIdentityNominalParamsErrorFrom id params [])
    Nothing
    roots

@category "engine-internal"
fieldIdentityRootOwnerIndexKey : (root: FieldDeclarationRoot) -> String
fieldIdentityRootOwnerIndexKey root =
  fieldIdentityOwnerIndexKey (fieldIdentityRootOwner root)

@category "engine-internal"
fieldIdentityUniqueRootStep : (groups: a) -> (state: a) -> (root: FieldDeclarationRoot) -> a
fieldIdentityUniqueRootStep groups state root =
  case state.error of
    Just err -> state
    Nothing ->
      let owner = fieldIdentityRootOwner root
      case mapGet groups (fieldIdentityRootOwnerIndexKey root) of
        Nothing -> state
        Just siblings ->
          case head siblings of
            Nothing -> state
            Just first ->
              if eq first.token root.token
              then state
              else
                if and
                  (eq (fieldIdentityRootRealm first) (fieldIdentityRootRealm root))
                  (fieldIdentityRootDeclarationEq first root)
                then {
                  duplicates = appendItem { canonical = first, duplicate = root } state.duplicates,
                  error = Nothing
                }
                else
                  { duplicates = state.duplicates,
                    error = Just (ConflictingFieldDeclaration {
                      message = concat "field-identity: conflicting declarations for \"" (concat (fieldIdentityOwnerText owner) "\""),
                      owner = owner
                    })
                  }

@category "engine-internal"
fieldIdentityFirstRootInGroup : (entry: a) -> a
fieldIdentityFirstRootInGroup entry =
  case head entry.value of
    Just root -> root
    Nothing -> {}

@category "engine-internal"
fieldIdentityUniqueRoots : (roots: List FieldDeclarationRoot) -> a
fieldIdentityUniqueRoots roots =
  let groups = groupBy fieldIdentityRootOwnerIndexKey roots
  let checked = fold (fieldIdentityUniqueRootStep groups) { duplicates = [], error = Nothing } roots
  {
    roots = map fieldIdentityFirstRootInGroup (entries groups),
    duplicates = checked.duplicates,
    error = checked.error
  }

@category "engine-internal"
fieldIdentityRealmModeAllowed : (realm: FieldIdentityRealm) -> (mode: FieldIdentityMode) -> Boolean
fieldIdentityRealmModeAllowed realm mode =
  case realm of
    RepositorySource -> true
    AccountAuthored -> case mode of StrictEmbedded -> true; CollectRequirements -> false; SourceHandles -> false
    TransientDraft -> case mode of SourceHandles -> true; StrictEmbedded -> true; CollectRequirements -> false

-- -------------------------------------------------------------------------
-- Inert lookup indexes. `fromEntries`/`mapGet` are the existing opaque-map
-- performance representation; the names, values, and every decision remain
-- visible in this Fenel body.
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityLockIndex : (entries: List FieldLockEntry) -> a
fieldIdentityLockIndex entries =
  fromEntries (map (\entry -> { key = entry.name, value = entry.id }) entries)

@category "engine-internal"
fieldIdentityKindIndex : (index: IdentityKindIndex) -> a
fieldIdentityKindIndex index =
  case index of
    IdentityKindIndex { entries = entries } ->
      fromEntries (map (\entry -> { key = entry.handle, value = entry.kind }) entries)

@category "engine-internal"
fieldIdentityExternalIndex : (catalog: ExternalFieldCatalog) -> a
fieldIdentityExternalIndex catalog =
  case catalog of
    ExternalFieldCatalog { fields = fields } ->
      fromEntries (map (\entity -> { key = entity.id.handle, value = entity }) fields)

@category "engine-internal"
fieldIdentityValidateLockStep : (state: Maybe FieldIdentityError) -> (entry: FieldLockEntry) -> Maybe FieldIdentityError
fieldIdentityValidateLockStep state entry =
  case state of
    Just err -> state
    Nothing ->
      if fieldIdentityIsUuid entry.id
      then Nothing
      else Just (InvalidFieldUuid {
        message = concat "field-identity: lock value for \"" (concat entry.name (concat "\" is not a UUID: " entry.id)),
        handle = entry.id
      })

-- The lock holds tens of thousands of ids and is validated on every registry
-- build. They are checked together first: one join, sixteen replaceAll
-- passes and one comparison establish that every id has the UUID shape, and
-- a per-row probe checks version and variant. Only when that fails does the
-- per-row fold run, so an error still names the same first failing row.
-- Measured 2026-09-23 over 31,151 rows: 9.3 s for the fold, 0.9 s batched.
@category "engine-internal"
fieldIdentityValidateLockEntries : (entries: List FieldLockEntry) -> Maybe FieldIdentityError
fieldIdentityValidateLockEntries entries =
  if fieldIdentityAllUuids (map (\entry -> entry.id) entries)
  then Nothing
  else fold fieldIdentityValidateLockStep Nothing entries

@category "engine-internal"
fieldIdentityAllUuids : (ids: List String) -> Boolean
fieldIdentityAllUuids ids =
  and (all ids (\id -> isString id)) (and (fieldIdentityUuidShapes ids) (all ids (\id -> fieldIdentityUuidVersion id)))

-- Every ASCII hex digit, in either case, becomes `x`; the joined result must be
-- exactly one `xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx` per id. An id that
-- already holds an `x`, or a `|`, cannot pass for one that does not. This is
-- the length and digit half of `std:isUuid` for many ids at once, and it must
-- never accept an id `std:isUuid` rejects: the fold runs only when the batch
-- rejects, so a false rejection costs time and a false acceptance goes unseen.
@category "engine-internal"
fieldIdentityUuidShapes : (ids: List String) -> Boolean
fieldIdentityUuidShapes ids =
  let joined = join ids "|"
  let expected = join (map (\id -> "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx") ids) "|"
  let shape = fold (\text digit -> replaceAll text digit "x") joined (chars "0123456789abcdefABCDEF")
  if and (not (std.contains joined "x")) (eq shape expected) then true
  else if eq (at (sortLex (concat (chars joined) ["~"])) (-1)) "~" then false
  else
    let lowered = lower joined
    if std.contains lowered "x" then false
    else eq (fold (\text digit -> replaceAll text digit "x") lowered (chars "0123456789abcdef")) expected

-- -------------------------------------------------------------------------
-- One field occurrence: positional classification + key/lock resolution
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityPositionError : (name: String) -> (message: String) -> FieldIdentityError
fieldIdentityPositionError name message =
  InvalidPositionalName { message = message, name = name }

@category "engine-internal"
fieldIdentityFieldSegment : (field: a) -> (occurrenceIndex: Number) -> Result FieldIdentityError a
fieldIdentityFieldSegment field occurrenceIndex =
  let position = fieldIdentityPositionName field.name
  case field.key of
    NamedFieldInput { handle = handle } ->
      case position of
        InvalidFieldPosition { message = message } -> Err (fieldIdentityPositionError field.name message)
        CanonicalFieldPosition ->
          Err (ReservedPositionalName {
            message = concat "field-identity: reserved positional name \"" (concat field.name "\" cannot carry NamedField identity"),
            name = field.name
          })
        NotFieldPosition -> Ok { segment = FieldNamed { name = field.name }, positional = false, sourceHandle = handle }
    PositionalFieldInput { index = explicitIndex } ->
      case position of
        InvalidFieldPosition { message = message } -> Err (fieldIdentityPositionError field.name message)
        NotFieldPosition ->
          Err (InvalidPositionalName {
            message = concat "field-identity: explicit PositionalField must keep a reserved _n compatibility name (got \"" (concat field.name "\")"),
            name = field.name
          })
        CanonicalFieldPosition ->
          if or (lt explicitIndex 0) (gt explicitIndex 9007199254740991)
          then Err (InvalidPositionalIndex {
            message = concat "field-identity: invalid positional index " (toString explicitIndex),
            index = explicitIndex
          })
          else if not (eq explicitIndex occurrenceIndex)
          then Err (InvalidPositionalIndex {
            message = concat "field-identity: explicit positional index " (concat (toString explicitIndex) (concat " does not match occurrence index " (toString occurrenceIndex))),
            index = explicitIndex
          })
          else Ok { segment = FieldPosition { index = occurrenceIndex }, positional = true, sourceHandle = "" }
    NoFieldKey ->
      case position of
        InvalidFieldPosition { message = message } -> Err (fieldIdentityPositionError field.name message)
        CanonicalFieldPosition -> Ok { segment = FieldPosition { index = occurrenceIndex }, positional = true, sourceHandle = "" }
        NotFieldPosition -> Ok { segment = FieldNamed { name = field.name }, positional = false, sourceHandle = "" }

@category "engine-internal"
fieldIdentityPreferredConflict : (lockIndex: a) -> (lockName: String) -> (preferred: String) -> Maybe FieldIdentityError
fieldIdentityPreferredConflict lockIndex lockName preferred =
  case mapGet lockIndex lockName of
    Nothing -> Nothing
    Just pinned ->
      if eq pinned preferred
      then Nothing
      else Just (PreferredFieldUuidConflict {
        message = concat "field-identity: preferred UUID conflict for \"" (concat lockName (concat "\": field requires " (concat preferred (concat ", lock pins " pinned)))),
        lockName = lockName,
        expected = preferred,
        actual = pinned
      })

@category "engine-internal"
fieldIdentityRequest : (realm: FieldIdentityRealm) -> (lockName: String) -> (preferred: Maybe String) -> Maybe FieldLockRequest
fieldIdentityRequest realm lockName preferred =
  case realm of
    RepositorySource -> Just (FieldLockRequest { name = lockName, preferredId = preferred })
    AccountAuthored -> Nothing
    TransientDraft -> Nothing

@category "engine-internal"
fieldIdentityResolvedNamed : (handle: String) -> (sourceKey: FieldKeyInput) -> (ingress: FieldIdentityIngress) -> (request: Maybe FieldLockRequest) -> (declaresEntity: Boolean) -> (needsMint: Boolean) -> a
fieldIdentityResolvedNamed handle sourceKey ingress request declaresEntity needsMint =
  { key = NamedField { ref = FieldRef { handle = handle } },
    sourceKey = sourceKey,
    ingress = ingress,
    request = request,
    declaresEntity = declaresEntity,
    needsMint = needsMint,
    referenceHandle = case sourceKey of NamedFieldInput { handle = h } -> Just h; NoFieldKey -> Nothing; PositionalFieldInput -> Nothing
  }

@category "engine-internal"
fieldIdentityResolveExplicitNamed : (field: a) -> (realm: FieldIdentityRealm) -> (mode: FieldIdentityMode) -> (qualifiedName: String) -> (lockIndex: a) -> (handle: String) -> Result FieldIdentityError a
fieldIdentityResolveExplicitNamed field realm mode qualifiedName lockIndex handle =
  if eq (length handle) 0
  then Err (InvalidFieldKey { message = concat "field-identity: empty explicit NamedField ref at " qualifiedName })
  else if fieldIdentityIsUuid handle
  then
    case fieldIdentityPreferredConflict lockIndex qualifiedName handle of
      Just err -> Err err
      Nothing ->
        Ok (fieldIdentityResolvedNamed handle field.key ExplicitFieldRefIngress (fieldIdentityRequest realm qualifiedName (Just handle)) false false)
  else if startsWith handle "field:"
  then
    case realm of
      AccountAuthored -> Err (AccountFieldNeedsUuid {
        message = concat "field-identity: account-authored named field must carry an explicit UUID at " qualifiedName,
        qualifiedName = qualifiedName
      })
      TransientDraft ->
        case mode of
          SourceHandles -> Ok (fieldIdentityResolvedNamed handle field.key ExplicitFieldRefIngress Nothing false false)
          StrictEmbedded -> Err (InvalidFieldKey { message = concat "field-identity: strict transient named field requires an explicit UUID at " qualifiedName })
          CollectRequirements -> Err (InvalidFieldRealmMode { message = "field-identity: transient roots require SourceHandles mode" })
      RepositorySource ->
        case mode of
          SourceHandles -> Ok (fieldIdentityResolvedNamed handle field.key ExplicitFieldRefIngress Nothing false false)
          StrictEmbedded ->
            case mapGet lockIndex handle of
              Nothing -> Err (UnresolvedFieldHandle { message = concat "field-identity: unresolved explicit field ref \"" (concat handle (concat "\" at " qualifiedName)), handle = handle })
              Just resolved ->
                case fieldIdentityPreferredConflict lockIndex qualifiedName resolved of
                  Just err -> Err err
                  Nothing -> Ok (fieldIdentityResolvedNamed resolved field.key ExplicitFieldRefIngress (fieldIdentityRequest realm qualifiedName (Just resolved)) false false)
          CollectRequirements ->
            case mapGet lockIndex handle of
              Nothing -> Err (UnresolvedFieldHandle { message = concat "field-identity: unresolved explicit field ref \"" (concat handle (concat "\" at " qualifiedName)), handle = handle })
              Just resolved ->
                case fieldIdentityPreferredConflict lockIndex qualifiedName resolved of
                  Just err -> Err err
                  Nothing -> Ok (fieldIdentityResolvedNamed resolved field.key ExplicitFieldRefIngress (fieldIdentityRequest realm qualifiedName (Just resolved)) false false)
  else Err (InvalidFieldKey {
    message = concat "field-identity: explicit NamedField ref must be a field handle or UUID (got \"" (concat handle (concat "\" at " qualifiedName))
  })

@category "engine-internal"
fieldIdentityResolveImplicitNamed : (field: a) -> (realm: FieldIdentityRealm) -> (mode: FieldIdentityMode) -> (qualifiedName: String) -> (lockIndex: a) -> Result FieldIdentityError a
fieldIdentityResolveImplicitNamed field realm mode qualifiedName lockIndex =
  if fieldIdentityIsUuid field.name
  then
    case realm of
      AccountAuthored -> Err (AccountFieldNeedsUuid {
        message = concat "field-identity: account-authored UUID-named field must carry that UUID as an explicit NamedField key at " qualifiedName,
        qualifiedName = qualifiedName
      })
      TransientDraft -> case mode of
        StrictEmbedded -> Err (InvalidFieldKey { message = concat "field-identity: strict transient UUID-named field requires an explicit NamedField key at " qualifiedName })
        _ -> case fieldIdentityPreferredConflict lockIndex qualifiedName field.name of
          Just err -> Err err
          Nothing -> Ok (fieldIdentityResolvedNamed field.name field.key LegacyUuidNameIngress Nothing true false)
      _ ->
        case fieldIdentityPreferredConflict lockIndex qualifiedName field.name of
          Just err -> Err err
          Nothing ->
            Ok (fieldIdentityResolvedNamed field.name field.key LegacyUuidNameIngress (fieldIdentityRequest realm qualifiedName (Just field.name)) true false)
  else
    case realm of
      AccountAuthored -> Err (AccountFieldNeedsUuid {
        message = concat "field-identity: account-authored named field must carry an explicit UUID at " qualifiedName,
        qualifiedName = qualifiedName
      })
      TransientDraft ->
        case mode of
          StrictEmbedded -> Err (InvalidFieldKey { message = concat "field-identity: strict transient named field requires an explicit UUID at " qualifiedName })
          _ -> Ok (fieldIdentityResolvedNamed qualifiedName field.key OrdinaryNamedIngress Nothing false true)
      RepositorySource ->
        case mode of
          StrictEmbedded ->
            case mapGet lockIndex qualifiedName of
              Nothing -> Err (MissingRepositoryFieldLock {
                message = concat "field-identity: missing embedded repository lock row \"" (concat qualifiedName "\""),
                lockName = qualifiedName
              })
              Just resolved -> Ok (fieldIdentityResolvedNamed resolved field.key OrdinaryNamedIngress (fieldIdentityRequest realm qualifiedName Nothing) true false)
          CollectRequirements ->
            case mapGet lockIndex qualifiedName of
              Nothing -> Ok (fieldIdentityResolvedNamed qualifiedName field.key OrdinaryNamedIngress (fieldIdentityRequest realm qualifiedName Nothing) true false)
              Just resolved -> Ok (fieldIdentityResolvedNamed resolved field.key OrdinaryNamedIngress (fieldIdentityRequest realm qualifiedName Nothing) true false)
          SourceHandles ->
            Ok (fieldIdentityResolvedNamed qualifiedName field.key OrdinaryNamedIngress (fieldIdentityRequest realm qualifiedName Nothing) true false)

@category "engine-internal"
fieldIdentityResolveField : (field: a) -> (realm: FieldIdentityRealm) -> (mode: FieldIdentityMode) -> (qualifiedName: String) -> (lockIndex: a) -> (positional: Boolean) -> (occurrenceIndex: Number) -> Result FieldIdentityError a
fieldIdentityResolveField field realm mode qualifiedName lockIndex positional occurrenceIndex =
  if positional
  then Ok {
    key = PositionalField { index = occurrenceIndex },
    sourceKey = field.key,
    ingress = PositionalIngress,
    request = Nothing,
    declaresEntity = false,
    needsMint = false,
    referenceHandle = Nothing
  }
  else
    case field.key of
      NamedFieldInput { handle = handle } -> fieldIdentityResolveExplicitNamed field realm mode qualifiedName lockIndex handle
      PositionalFieldInput -> Err (InvalidFieldKey { message = concat "field-identity: positional key classified as named at " qualifiedName })
      NoFieldKey -> fieldIdentityResolveImplicitNamed field realm mode qualifiedName lockIndex

-- -------------------------------------------------------------------------
-- Recursive traversal over the one TraversalType boundary
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityWalkWithError : (state: a) -> (error: FieldIdentityError) -> a
fieldIdentityWalkWithError state error =
  { occurrences = state.occurrences,
    inlineDefs = state.inlineDefs,
    needsMint = state.needsMint,
    attachments = state.attachments,
    ownedTokens = state.ownedTokens,
    error = Just error
  }

@category "engine-internal"
fieldIdentityRootIsType : (root: FieldDeclarationRoot) -> Boolean
fieldIdentityRootIsType root =
  case root of
    FunctionFieldDeclarationRoot -> false
    TypeFieldDeclarationRoot -> true

@category "engine-internal"
fieldIdentityTypeRootName : (root: FieldDeclarationRoot) -> String
fieldIdentityTypeRootName root =
  case fieldIdentityRootOwner root of
    TypeFieldOwner { localId = local } -> local
    FunctionFieldOwner -> ""
    InlineNominalFieldOwner -> ""

@category "engine-internal"
fieldIdentityNominalNameIndexKey : (name: String) -> String
fieldIdentityNominalNameIndexKey name = concat "name/" (urlEncode name)

@category "engine-internal"
fieldIdentityNominalModuleIndexKey : (moduleName: String) -> (name: String) -> String
fieldIdentityNominalModuleIndexKey moduleName name =
  concat "module/some/" (concat (urlEncode moduleName) (concat "/" (urlEncode name)))

@category "engine-internal"
fieldIdentityTypeRootNameIndexKey : (root: FieldDeclarationRoot) -> String
fieldIdentityTypeRootNameIndexKey root =
  fieldIdentityNominalNameIndexKey (fieldIdentityTypeRootName root)

@category "engine-internal"
fieldIdentityTypeRootModuleIndexKey : (root: FieldDeclarationRoot) -> String
fieldIdentityTypeRootModuleIndexKey root =
  case fieldIdentityRootModule root of
    Just m -> fieldIdentityNominalModuleIndexKey m (fieldIdentityTypeRootName root)
    Nothing -> concat "module/none/" (urlEncode (fieldIdentityTypeRootName root))

@category "engine-internal"
fieldIdentityNominalRootIndexes : (roots: List FieldDeclarationRoot) -> a
fieldIdentityNominalRootIndexes roots =
  let typeRoots = filter fieldIdentityRootIsType roots
  { byName = groupBy fieldIdentityTypeRootNameIndexKey typeRoots,
    byModuleName = groupBy fieldIdentityTypeRootModuleIndexKey typeRoots
  }

@category "engine-internal"
fieldIdentityFirstOrEmpty : (items: List a) -> a
fieldIdentityFirstOrEmpty items =
  case head items of
    Nothing -> {}
    Just item -> item

@category "engine-internal"
fieldIdentityNominalResolution : (indexes: a) -> (rootModule: Maybe String) -> (name: String) -> a
fieldIdentityNominalResolution indexes rootModule name =
  let candidates = fromMaybe [] (mapGet indexes.byName (fieldIdentityNominalNameIndexKey name))
  case rootModule of
    Just m ->
      let local = fromMaybe [] (mapGet indexes.byModuleName (fieldIdentityNominalModuleIndexKey m name))
      if eq (length local) 1
      then { tag = "Found", root = fieldIdentityFirstOrEmpty local, candidates = local }
      else if gt (length local) 1
      then { tag = "Ambiguous", candidates = local }
      else if eq (length candidates) 1
      then { tag = "Found", root = fieldIdentityFirstOrEmpty candidates, candidates = candidates }
      else if gt (length candidates) 1
      then { tag = "Ambiguous", candidates = candidates }
      else { tag = "Missing", candidates = [] }
    Nothing ->
      if eq (length candidates) 1
      then { tag = "Found", root = fieldIdentityFirstOrEmpty candidates, candidates = candidates }
      else if gt (length candidates) 1
      then { tag = "Ambiguous", candidates = candidates }
      else { tag = "Missing", candidates = [] }

@category "engine-internal"
fieldIdentityFindInlineDef : (defs: List a) -> (owner: FieldOwner) -> Maybe a
fieldIdentityFindInlineDef defs owner =
  find (\entry -> eq entry.owner owner) defs

@category "engine-internal"
fieldIdentitySpecializationMismatch : (state: a) -> a
fieldIdentitySpecializationMismatch state =
  {
    matched = false,
    bindings = state.bindings,
    walks = state.walks,
    aliases = state.aliases,
    attachments = state.attachments,
    attachmentOwner = state.attachmentOwner
  }

@category "engine-internal"
fieldIdentitySpecializationParamIndex : (name: String) -> (params: List String) -> (index: Number) -> Maybe Number
fieldIdentitySpecializationParamIndex name params index =
  case head params of
    Nothing -> Nothing
    Just param ->
      if eq param name
      then Just index
      else fieldIdentitySpecializationParamIndex name (tailOr params) (add index 1)

@category "engine-internal"
fieldIdentitySpecializationBind : (name: String) -> (actual: TraversalType) -> (params: List String) -> (state: a) -> a
fieldIdentitySpecializationBind name actual params state =
  if not state.matched
  then state
  else
    case find (\binding -> eq binding.name name) state.bindings of
      Nothing ->
        case fieldIdentitySpecializationParamIndex name params 0 of
          Nothing -> fieldIdentitySpecializationMismatch state
          Just index -> {
            matched = true,
            bindings = appendItem { name = name, type = actual, index = index } state.bindings,
            walks = state.walks,
            aliases = state.aliases,
            attachments = state.attachments,
            attachmentOwner = state.attachmentOwner
          }
      Just previous ->
        if fieldIdentityTypeEq previous.type actual
        then
          -- One formal may occur several times in a representation. Semantic
          -- equality proves the substitution, but every later marshaller token
          -- still needs an attachment-only proof to the first occurrence.  Do
          -- not use raw TraversalType equality as a shortcut: one shared host
          -- DAG is marshalled once per encounter and therefore carries fresh
          -- field tokens even when its raw source value is the same object.
          {
            matched = true,
            bindings = state.bindings,
            walks = state.walks,
            aliases = appendItem {
              actualType = actual,
              templateType = previous.type,
              path = [FieldTypeArg { index = previous.index }]
            } state.aliases,
            attachments = state.attachments,
            attachmentOwner = state.attachmentOwner
          }
        else fieldIdentitySpecializationMismatch state

@category "engine-internal"
fieldIdentitySpecializationHole : (name: String) -> (params: List String) -> (shadowed: List String) -> Boolean
fieldIdentitySpecializationHole name params shadowed =
  and (elem name params) (not (elem name shadowed))

@category "engine-internal"
fieldIdentitySpecializationInputMatchesResolved : (actual: FieldKeyInput) -> (resolved: FieldKey) -> Boolean
fieldIdentitySpecializationInputMatchesResolved actual resolved =
  case actual of
    NoFieldKey -> false
    NamedFieldInput { handle = actualHandle } ->
      case resolved of
        NamedField { ref = FieldRef { handle = resolvedHandle } } -> eq actualHandle resolvedHandle
        PositionalField -> false
    PositionalFieldInput { index = actualIndex } ->
      case resolved of
        PositionalField { index = resolvedIndex } -> eq actualIndex resolvedIndex
        NamedField -> false

-- Explicit template syntax is fixed and compares byte-for-byte.  A keyless
-- registered template may accept an already-identified use-site key only when
-- resolving that exact registered owner/path in the active realm+lock context
-- produces the same key.  Merely looking UUID-shaped or `field:`-shaped is no
-- proof: the carrier is not walked, so any unproved key would be discarded.
@category "engine-internal"
fieldIdentitySpecializationFieldKeyMatch : (actual: a) -> (template: a) -> (occurrenceIndex: Number) -> (templateOwner: FieldOwner) -> (templateParentPath: List FieldPathSegment) -> (templateRealm: FieldIdentityRealm) -> (context: a) -> (keyProofAllowed: Boolean) -> a
fieldIdentitySpecializationFieldKeyMatch actual template occurrenceIndex templateOwner templateParentPath templateRealm context keyProofAllowed =
  -- The false branch is a shape/binding prepass for nested opaques.  It must
  -- neither prove nor reject identity: every successful prepass is followed
  -- transactionally by one proof-enabled pass against either the registered
  -- nested root or the inline nominal owner.
  if not keyProofAllowed
  then { matched = true, attachment = Nothing }
  else
    case fieldIdentityFieldSegment template occurrenceIndex of
      Err -> { matched = false, attachment = Nothing }
      Ok role ->
        let templatePath = appendItem role.segment templateParentPath
        let qualifiedName = fieldIdentityQualifiedName templateOwner templatePath
        let attachment = Just { templateToken = template.token, templateQualifiedName = qualifiedName }
        case template.key of
          NoFieldKey ->
            case fieldIdentityResolveField template templateRealm context.mode qualifiedName context.lockIndex role.positional occurrenceIndex of
              Err ->
                case actual.key of
                  NoFieldKey -> { matched = true, attachment = Nothing }
                  identified -> { matched = false, attachment = Nothing }
              Ok resolved ->
                case actual.key of
                  NoFieldKey -> { matched = true, attachment = attachment }
                  identified -> {
                    matched = fieldIdentitySpecializationInputMatchesResolved identified resolved.key,
                    attachment = attachment
                  }
          NamedFieldInput { handle = templateHandle } ->
            case actual.key of
              NamedFieldInput { handle = actualHandle } ->
                if eq actualHandle templateHandle
                then { matched = true, attachment = attachment }
                else { matched = false, attachment = Nothing }
              NoFieldKey -> { matched = false, attachment = Nothing }
              PositionalFieldInput -> { matched = false, attachment = Nothing }
          PositionalFieldInput { index = templateIndex } ->
            case actual.key of
              PositionalFieldInput { index = actualIndex } ->
                if eq actualIndex templateIndex
                then { matched = true, attachment = attachment }
                else { matched = false, attachment = Nothing }
              NoFieldKey -> { matched = false, attachment = Nothing }
              NamedFieldInput -> { matched = false, attachment = Nothing }

@category "engine-internal"
fieldIdentitySpecializationUnifyFields : (actual: List a) -> (template: List a) -> (index: Number) -> (params: List String) -> (shadowed: List String) -> (templateOwner: FieldOwner) -> (templateParentPath: List FieldPathSegment) -> (templateRealm: FieldIdentityRealm) -> (context: a) -> (keyProofAllowed: Boolean) -> (state: a) -> a
fieldIdentitySpecializationUnifyFields actual template index params shadowed templateOwner templateParentPath templateRealm context keyProofAllowed state =
  if not state.matched
  then state
  else
    case head actual of
      Nothing ->
        if eq (length template) 0 then state else fieldIdentitySpecializationMismatch state
      Just actualField ->
        case head template of
          Nothing -> fieldIdentitySpecializationMismatch state
          Just templateField ->
            case fieldIdentityFieldSegment actualField index of
              Err -> fieldIdentitySpecializationMismatch state
              Ok actualRole ->
                case fieldIdentityFieldSegment templateField index of
                  Err -> fieldIdentitySpecializationMismatch state
                  Ok templateRole ->
                    if not (eq actualRole.segment templateRole.segment)
                    then fieldIdentitySpecializationMismatch state
                    else
                      let keyMatch = fieldIdentitySpecializationFieldKeyMatch actualField templateField index templateOwner templateParentPath templateRealm context keyProofAllowed
                      if not keyMatch.matched
                      then fieldIdentitySpecializationMismatch state
                      else
                        let withAttachment =
                          case keyMatch.attachment of
                            Nothing -> state
                            Just attachment -> {
                              matched = state.matched,
                              bindings = state.bindings,
                              walks = state.walks,
                              aliases = state.aliases,
                              attachments = appendItem (FieldIdentityAttachment {
                                owner = state.attachmentOwner,
                                actualToken = actualField.token,
                                templateToken = attachment.templateToken,
                                templateQualifiedName = attachment.templateQualifiedName
                              }) state.attachments,
                              attachmentOwner = state.attachmentOwner
                            }
                        let fieldPath = appendItem templateRole.segment templateParentPath
                        let next = fieldIdentitySpecializationUnifyType actualField.type templateField.type params shadowed templateOwner fieldPath templateRealm context keyProofAllowed withAttachment
                        fieldIdentitySpecializationUnifyFields (tailOr actual) (tailOr template) (add index 1) params shadowed templateOwner templateParentPath templateRealm context keyProofAllowed next

@category "engine-internal"
fieldIdentitySpecializationUnifyCases : (actual: List a) -> (template: List a) -> (params: List String) -> (shadowed: List String) -> (templateOwner: FieldOwner) -> (templateParentPath: List FieldPathSegment) -> (templateRealm: FieldIdentityRealm) -> (context: a) -> (keyProofAllowed: Boolean) -> (state: a) -> a
fieldIdentitySpecializationUnifyCases actual template params shadowed templateOwner templateParentPath templateRealm context keyProofAllowed state =
  if not state.matched
  then state
  else
    case head actual of
      Nothing ->
        if eq (length template) 0 then state else fieldIdentitySpecializationMismatch state
      Just actualCase ->
        case head template of
          Nothing -> fieldIdentitySpecializationMismatch state
          Just templateCase ->
            if not (eq actualCase.name templateCase.name)
            then fieldIdentitySpecializationMismatch state
            else
              let casePath = appendItem (FieldCase { name = templateCase.name }) templateParentPath
              let next = fieldIdentitySpecializationUnifyFields actualCase.fields templateCase.fields 0 params shadowed templateOwner casePath templateRealm context keyProofAllowed state
              fieldIdentitySpecializationUnifyCases (tailOr actual) (tailOr template) params shadowed templateOwner templateParentPath templateRealm context keyProofAllowed next

@category "engine-internal"
fieldIdentitySpecializationListPath : (kind: String) -> (index: Number) -> (parent: List FieldPathSegment) -> List FieldPathSegment
fieldIdentitySpecializationListPath kind index parent =
  if eq kind "tuple"
  then appendItem (FieldTuple { index = index }) parent
  else if eq kind "type-arg"
  then appendItem (FieldTypeArg { index = index }) parent
  else if eq kind "union"
  then appendItem (FieldUnion { index = index }) parent
  else appendItem (FieldIntersect { index = index }) parent

@category "engine-internal"
fieldIdentitySpecializationUnifyList : (actual: List TraversalType) -> (template: List TraversalType) -> (index: Number) -> (pathKind: String) -> (params: List String) -> (shadowed: List String) -> (templateOwner: FieldOwner) -> (templateParentPath: List FieldPathSegment) -> (templateRealm: FieldIdentityRealm) -> (context: a) -> (keyProofAllowed: Boolean) -> (state: a) -> a
fieldIdentitySpecializationUnifyList actual template index pathKind params shadowed templateOwner templateParentPath templateRealm context keyProofAllowed state =
  if not state.matched
  then state
  else
    case head actual of
      Nothing ->
        if eq (length template) 0 then state else fieldIdentitySpecializationMismatch state
      Just actualType ->
        case head template of
          Nothing -> fieldIdentitySpecializationMismatch state
          Just templateType ->
            let itemPath = fieldIdentitySpecializationListPath pathKind index templateParentPath
            let next = fieldIdentitySpecializationUnifyType actualType templateType params shadowed templateOwner itemPath templateRealm context keyProofAllowed state
            fieldIdentitySpecializationUnifyList (tailOr actual) (tailOr template) (add index 1) pathKind params shadowed templateOwner templateParentPath templateRealm context keyProofAllowed next

@category "engine-internal"
fieldIdentitySpecializationOwnerModule : (owner: FieldOwner) -> Maybe String
fieldIdentitySpecializationOwnerModule owner =
  case owner of
    TypeFieldOwner { module = moduleName } -> moduleName
    FunctionFieldOwner -> Nothing
    InlineNominalFieldOwner { parent = parent } -> fieldIdentitySpecializationOwnerModule parent

@category "engine-internal"
fieldIdentitySpecializationPrefixWalk : (prefix: List FieldPathSegment) -> (walk: a) -> a
fieldIdentitySpecializationPrefixWalk prefix walk =
  {
    actualType = walk.actualType,
    templateType = walk.templateType,
    path = concat prefix walk.path
  }

@category "engine-internal"
fieldIdentitySpecializationPairNestedBindings : (params: List String) -> (index: Number) -> (actualBindings: List a) -> (templateBindings: List a) -> (prefix: List FieldPathSegment) -> (state: a) -> a
fieldIdentitySpecializationPairNestedBindings params index actualBindings templateBindings prefix state =
  if not state.matched
  then state
  else
    case head params of
      Nothing -> state
      Just name ->
        let actual = find (\binding -> eq binding.name name) actualBindings
        let template = find (\binding -> eq binding.name name) templateBindings
        case actual of
          Nothing ->
            case template of
              Nothing -> fieldIdentitySpecializationPairNestedBindings (tailOr params) (add index 1) actualBindings templateBindings prefix state
              Just templateBinding -> fieldIdentitySpecializationMismatch state
          Just actualBinding ->
            case template of
              Nothing -> fieldIdentitySpecializationMismatch state
              Just templateBinding ->
                -- Binder spelling is used only inside this registered root's
                -- namespace to pair its own declared parameter.  Ownership is
                -- the typed ordinal path; no nested name enters outer bindings.
                let next = {
                  matched = true,
                  bindings = state.bindings,
                  walks = appendItem {
                    actualType = actualBinding.type,
                    templateType = templateBinding.type,
                    path = appendItem (FieldTypeArg { index = index }) prefix
                  } state.walks,
                  aliases = state.aliases,
                  attachments = state.attachments,
                  attachmentOwner = state.attachmentOwner
                }
                fieldIdentitySpecializationPairNestedBindings (tailOr params) (add index 1) actualBindings templateBindings prefix next

@category "engine-internal"
fieldIdentitySpecializationMergeNested : (prefix: List FieldPathSegment) -> (nestedParams: List String) -> (outer: a) -> (nested: a) -> (linked: a) -> a
fieldIdentitySpecializationMergeNested prefix nestedParams outer nested linked =
  if not nested.matched
  then fieldIdentitySpecializationMismatch outer
  else if not linked.matched
  then fieldIdentitySpecializationMismatch outer
  else
    let paired = fieldIdentitySpecializationPairNestedBindings nestedParams 0 nested.bindings linked.bindings prefix {
      matched = true,
      bindings = outer.bindings,
      walks = outer.walks,
      aliases = outer.aliases,
      attachments = outer.attachments,
      attachmentOwner = outer.attachmentOwner
    }
    if not paired.matched
    -- Roll back every nested binding/walk/attachment when any proof conflicts.
    then fieldIdentitySpecializationMismatch outer
    else {
      matched = outer.matched,
      bindings = outer.bindings,
      walks = concat paired.walks (map (fieldIdentitySpecializationPrefixWalk prefix) nested.walks),
      aliases = concat paired.aliases (map (fieldIdentitySpecializationPrefixWalk prefix) nested.aliases),
      attachments = concat outer.attachments nested.attachments,
      attachmentOwner = outer.attachmentOwner
    }

@category "engine-internal"
fieldIdentitySpecializationAliasAlreadyPresent : (aliases: List a) -> (candidate: a) -> Boolean
fieldIdentitySpecializationAliasAlreadyPresent aliases candidate =
  case find (\existing -> and (eq existing.actualType candidate.actualType) (eq existing.templateType candidate.templateType)) aliases of
    Nothing -> false
    Just existing -> true

@category "engine-internal"
fieldIdentitySpecializationMergeInline : (prefix: List FieldPathSegment) -> (outer: a) -> (proved: a) -> a
fieldIdentitySpecializationMergeInline prefix outer proved =
  if not proved.matched
  then fieldIdentitySpecializationMismatch outer
  else
    -- The proof-enabled inline pass runs with the enclosing binder namespace,
    -- so it repeats aliases already discovered by the structural prepass at
    -- their true outer FieldTypeArg paths.  Suppress only the exact tokenized
    -- pair already staged there.  Fresh aliases can belong to an independently
    -- registered nominal nested inside the missing inline carrier; those must
    -- survive, prefixed by the inline path.
    let freshAliases = filter (\alias -> not (fieldIdentitySpecializationAliasAlreadyPresent outer.aliases alias)) proved.aliases
    {
      matched = outer.matched,
      bindings = outer.bindings,
      walks = concat outer.walks (map (fieldIdentitySpecializationPrefixWalk prefix) proved.walks),
      aliases = concat outer.aliases (map (fieldIdentitySpecializationPrefixWalk prefix) freshAliases),
      attachments = concat outer.attachments proved.attachments,
      attachmentOwner = outer.attachmentOwner
    }

-- Unify a registered nominal template with the specialized `$opaque.pure`
-- supplied at a referring declaration. This discovers the actual value for
-- each declared type parameter without re-owning the nominal carrier's own
-- record/variant fields. Repeated formal occurrences must agree exactly.
@category "engine-internal"
fieldIdentitySpecializationUnifyType : (actual: TraversalType) -> (template: TraversalType) -> (params: List String) -> (shadowed: List String) -> (templateOwner: FieldOwner) -> (templatePath: List FieldPathSegment) -> (templateRealm: FieldIdentityRealm) -> (context: a) -> (keyProofAllowed: Boolean) -> (state: a) -> a
fieldIdentitySpecializationUnifyType actual template params shadowed templateOwner templatePath templateRealm context keyProofAllowed state =
  if not state.matched
  then state
  else
    case template of
      TtNamed { name = name } ->
        if fieldIdentitySpecializationHole name params shadowed
        then fieldIdentitySpecializationBind name actual params state
        else case actual of
          TtNamed { name = actualName } -> if eq name actualName then state else fieldIdentitySpecializationMismatch state
          other -> fieldIdentitySpecializationMismatch state
      TtVar { name = name } ->
        if fieldIdentitySpecializationHole name params shadowed
        then fieldIdentitySpecializationBind name actual params state
        else case actual of
          TtVar { name = actualName } -> if eq name actualName then state else fieldIdentitySpecializationMismatch state
          other -> fieldIdentitySpecializationMismatch state
      TtUnit -> case actual of TtUnit -> state; other -> fieldIdentitySpecializationMismatch state
      TtVoid -> case actual of TtVoid -> state; other -> fieldIdentitySpecializationMismatch state
      TtTypeUniverse -> case actual of TtTypeUniverse -> state; other -> fieldIdentitySpecializationMismatch state
      TtEl { content = templateContent } ->
        case actual of
          TtEl { content = actualContent } ->
            if eq actualContent templateContent then state else fieldIdentitySpecializationMismatch state
          other -> fieldIdentitySpecializationMismatch state
      TtUnknown -> case actual of TtUnknown -> state; other -> fieldIdentitySpecializationMismatch state
      TtRecord { fields = templateFields } ->
        case actual of
          TtRecord { fields = actualFields } ->
            fieldIdentitySpecializationUnifyFields actualFields templateFields 0 params shadowed templateOwner templatePath templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtVariant { cases = templateCases, discriminator = templateDiscriminator } ->
        case actual of
          TtVariant { cases = actualCases, discriminator = actualDiscriminator } ->
            if not (eq actualDiscriminator templateDiscriminator)
            then fieldIdentitySpecializationMismatch state
            else fieldIdentitySpecializationUnifyCases actualCases templateCases params shadowed templateOwner templatePath templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtTuple { items = templateItems } ->
        case actual of
          TtTuple { items = actualItems } ->
            fieldIdentitySpecializationUnifyList actualItems templateItems 0 "tuple" params shadowed templateOwner templatePath templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtMap { keys = templateKeys, values = templateValues } ->
        case actual of
          TtMap { keys = actualKeys, values = actualValues } ->
            if not (eq actualKeys templateKeys)
            then fieldIdentitySpecializationMismatch state
            else fieldIdentitySpecializationUnifyType actualValues templateValues params shadowed templateOwner (appendItem FieldMapValue templatePath) templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtApp { head = templateHead, args = templateArgs } ->
        case actual of
          TtApp { head = actualHead, args = actualArgs } ->
            if not (eq actualHead templateHead)
            then fieldIdentitySpecializationMismatch state
            else fieldIdentitySpecializationUnifyList actualArgs templateArgs 0 "type-arg" params shadowed templateOwner templatePath templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtRefined { base = templateBase, set = templateSet } ->
        case actual of
          TtRefined { base = actualBase, set = actualSet } ->
            if not (eq actualSet templateSet)
            then fieldIdentitySpecializationMismatch state
            else fieldIdentitySpecializationUnifyType actualBase templateBase params shadowed templateOwner (appendItem FieldRefinedBase templatePath) templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtMu { body = templateBody, var = templateVar } ->
        case actual of
          TtMu { body = actualBody, var = actualVar } ->
            if not (eq actualVar templateVar)
            then fieldIdentitySpecializationMismatch state
            else fieldIdentitySpecializationUnifyType actualBody templateBody params (appendItem templateVar shadowed) templateOwner templatePath templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtTagged { value = templateValue, phantom = templatePhantom } ->
        case actual of
          TtTagged { value = actualValue, phantom = actualPhantom } ->
            let afterValue = fieldIdentitySpecializationUnifyType actualValue templateValue params shadowed templateOwner (appendItem FieldTaggedValue templatePath) templateRealm context keyProofAllowed state
            fieldIdentitySpecializationUnifyType actualPhantom templatePhantom params shadowed templateOwner (appendItem FieldTaggedPhantom templatePath) templateRealm context keyProofAllowed afterValue
          other -> fieldIdentitySpecializationMismatch state
      TtOpaque { pure = templatePure, name = templateName } ->
        case actual of
          TtOpaque { pure = actualPure, name = actualName } ->
            if not (eq actualName templateName)
            then fieldIdentitySpecializationMismatch state
            else
              let structural = fieldIdentitySpecializationUnifyType actualPure templatePure params shadowed templateOwner templatePath templateRealm context false state
              if not structural.matched
              then structural
              else if not keyProofAllowed
              -- Nested identity is proved exactly once by the enclosing
              -- proof-enabled pass; this branch is shape/binding only.
              then structural
              else
                let nestedResolution = fieldIdentityNominalResolution context.nominalIndexes (fieldIdentitySpecializationOwnerModule templateOwner) templateName
                if eq nestedResolution.tag "Found"
                then
                  case nestedResolution.root of
                    FunctionFieldDeclarationRoot -> fieldIdentitySpecializationMismatch structural
                    TypeFieldDeclarationRoot { params = nestedParams, declaration = nestedDeclaration } ->
                      let nestedTemplate =
                        case nestedDeclaration of
                          TtOpaque { pure = registeredPure, name = registeredName } ->
                            if eq registeredName templateName then registeredPure else TtUnknown { raw = {}, invalid = true }
                          other -> nestedDeclaration
                      let nested = fieldIdentitySpecializationUnifyType actualPure nestedTemplate nestedParams [] (fieldIdentityRootOwner nestedResolution.root) [] (fieldIdentityRootRealm nestedResolution.root) context true {
                        matched = true,
                        bindings = [],
                        walks = [],
                        aliases = [],
                        attachments = [],
                        attachmentOwner = state.attachmentOwner
                      }
                      -- Independently specialize the enclosing canonical
                      -- representation against the registered root. This links
                      -- each nested ordinal to its canonical template value
                      -- without merging either binder namespace by spelling.
                      let linked = fieldIdentitySpecializationUnifyType templatePure nestedTemplate nestedParams [] (fieldIdentityRootOwner nestedResolution.root) [] (fieldIdentityRootRealm nestedResolution.root) context false {
                        matched = true,
                        bindings = [],
                        walks = [],
                        aliases = [],
                        attachments = [],
                        attachmentOwner = state.attachmentOwner
                      }
                      fieldIdentitySpecializationMergeNested templatePath nestedParams structural nested linked
                else if eq nestedResolution.tag "Ambiguous"
                then fieldIdentitySpecializationMismatch structural
                else
                  -- A missing nested registration denotes an inline nominal.
                  -- Its carrier fields are canonically owned by the inline
                  -- owner (and start at its local root path), so perform the
                  -- same proof-enabled pass used for registered nested roots.
                  let inlineOwner = InlineNominalFieldOwner { parent = templateOwner, name = templateName }
                  let proved = fieldIdentitySpecializationUnifyType actualPure templatePure params shadowed inlineOwner [] templateRealm context true {
                    matched = true,
                    bindings = [],
                    walks = [],
                    aliases = [],
                    attachments = [],
                    attachmentOwner = state.attachmentOwner
                  }
                  fieldIdentitySpecializationMergeInline templatePath structural proved
          other -> fieldIdentitySpecializationMismatch state
      TtArrow { params = templateFields, returns = templateReturns } ->
        case actual of
          TtArrow { params = actualFields, returns = actualReturns } ->
            let afterParams = fieldIdentitySpecializationUnifyFields actualFields templateFields 0 params shadowed templateOwner templatePath templateRealm context keyProofAllowed state
            fieldIdentitySpecializationUnifyType actualReturns templateReturns params shadowed templateOwner (appendItem FieldArrowReturn templatePath) templateRealm context keyProofAllowed afterParams
          other -> fieldIdentitySpecializationMismatch state
      TtUnion { branches = templateBranches } ->
        case actual of
          TtUnion { branches = actualBranches } ->
            fieldIdentitySpecializationUnifyList actualBranches templateBranches 0 "union" params shadowed templateOwner templatePath templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtIntersect { branches = templateBranches } ->
        case actual of
          TtIntersect { branches = actualBranches } ->
            fieldIdentitySpecializationUnifyList actualBranches templateBranches 0 "intersect" params shadowed templateOwner templatePath templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state
      TtComplement { inner = templateInner } ->
        case actual of
          TtComplement { inner = actualInner } ->
            fieldIdentitySpecializationUnifyType actualInner templateInner params shadowed templateOwner (appendItem FieldComplement templatePath) templateRealm context keyProofAllowed state
          other -> fieldIdentitySpecializationMismatch state

@category "engine-internal"
fieldIdentityWalkSpecializationBindings : (params: List String) -> (index: Number) -> (bindings: List a) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (context: a) -> (state: a) -> a
fieldIdentityWalkSpecializationBindings params index bindings owner path rootModule context state =
  case head params of
    Nothing -> state
    Just name ->
      let next =
        case find (\binding -> eq binding.name name) bindings of
          Nothing -> state
          Just binding ->
            fieldIdentityWalkType binding.type owner (appendItem (FieldTypeArg { index = index }) path) rootModule context state
      fieldIdentityWalkSpecializationBindings (tailOr params) (add index 1) bindings owner path rootModule context next

@category "engine-internal"
fieldIdentitySpecializationAttachmentTargetsAgree : (attachments: List FieldIdentityAttachment) -> (target: FieldIdentityAttachment) -> Boolean
fieldIdentitySpecializationAttachmentTargetsAgree attachments target =
  case head attachments of
    Nothing -> true
    Just attachment ->
      if and
        (eq attachment.templateToken target.templateToken)
        (eq attachment.templateQualifiedName target.templateQualifiedName)
      then fieldIdentitySpecializationAttachmentTargetsAgree (tailOr attachments) target
      else false

@category "engine-internal"
fieldIdentitySpecializationResolveAttachment : (attachments: List FieldIdentityAttachment) -> (occurrences: List a) -> (visited: List String) -> (attachment: FieldIdentityAttachment) -> a
fieldIdentitySpecializationResolveAttachment attachments occurrences visited attachment =
  -- A concrete occurrence is authoritative even if an attachment happens to
  -- expose the same token as an actual endpoint.  Token/qname disagreement is
  -- a semantic path conflict, never an invitation to follow a different edge.
  case find (\occurrence -> eq occurrence.token attachment.templateToken) occurrences of
    Just occurrence -> {
      matched = eq occurrence.qualifiedName attachment.templateQualifiedName,
      attachment = attachment
    }
    Nothing ->
      if elem attachment.templateToken visited
      then { matched = false, attachment = attachment }
      else
        let candidates = filter (\prior -> eq prior.actualToken attachment.templateToken) attachments
        case head candidates of
          Nothing ->
            -- Nested canonical occurrences may be authored after their alias
            -- proof.  Leave that terminal for the final host bridge to resolve;
            -- every actual attachment edge encountered here is exact-checked.
            { matched = true, attachment = attachment }
          Just prior ->
            if not (fieldIdentitySpecializationAttachmentTargetsAgree candidates prior)
            then { matched = false, attachment = attachment }
            else if not (eq prior.templateQualifiedName attachment.templateQualifiedName)
            then { matched = false, attachment = attachment }
            else fieldIdentitySpecializationResolveAttachment attachments occurrences (appendItem attachment.templateToken visited) (FieldIdentityAttachment {
              owner = attachment.owner,
              actualToken = attachment.actualToken,
              templateToken = prior.templateToken,
              templateQualifiedName = prior.templateQualifiedName
            })

@category "engine-internal"
fieldIdentitySpecializationAppendAttachments : (incoming: List FieldIdentityAttachment) -> (occurrences: List a) -> (attachments: List FieldIdentityAttachment) -> a
fieldIdentitySpecializationAppendAttachments incoming occurrences attachments =
  case head incoming of
    Nothing -> { matched = true, attachments = attachments }
    Just attachment ->
      let resolved = fieldIdentitySpecializationResolveAttachment attachments occurrences [] attachment
      if not resolved.matched
      then { matched = false, attachments = attachments }
      else fieldIdentitySpecializationAppendAttachments (tailOr incoming) occurrences (appendItem resolved.attachment attachments)

-- Exact attachment-only proof shared by repeated-formal aliases and duplicate
-- roots. Any nested walk/alias obligations discovered by an exact pair remain
-- attachment-only and are drained recursively; no occurrence row is authored.
@category "engine-internal"
fieldIdentitySpecializationAttachmentProofs : (proofs: List a) -> (templateOwner: FieldOwner) -> (templateRealm: FieldIdentityRealm) -> (attachmentOwner: FieldOwner) -> (occurrences: List a) -> (context: a) -> (state: a) -> a
fieldIdentitySpecializationAttachmentProofs proofs templateOwner templateRealm attachmentOwner occurrences context state =
  if not state.matched
  then state
  else
    case head proofs of
      Nothing -> state
      Just proof ->
        let proved = fieldIdentitySpecializationUnifyType proof.actualType proof.templateType [] [] templateOwner proof.path templateRealm context true {
          matched = true,
          bindings = [],
          walks = [],
          aliases = [],
          attachments = [],
          attachmentOwner = attachmentOwner
        }
        if not proved.matched
        then { matched = false, attachments = state.attachments }
        else
          let appended = fieldIdentitySpecializationAppendAttachments proved.attachments occurrences state.attachments
          if not appended.matched
          then { matched = false, attachments = state.attachments }
          else
            let nested = concat proved.walks proved.aliases
            fieldIdentitySpecializationAttachmentProofs (concat (tailOr proofs) nested) templateOwner templateRealm attachmentOwner occurrences context {
              matched = true,
              attachments = appended.attachments
            }

@category "engine-internal"
fieldIdentityWalkSpecializationWalks : (walks: List a) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (context: a) -> (state: a) -> a
fieldIdentityWalkSpecializationWalks walks owner path rootModule context state =
  case state.error of
    Just err -> state
    Nothing ->
      case head walks of
        Nothing -> state
        Just walk ->
          let next = fieldIdentityWalkType walk.actualType owner (concat path walk.path) rootModule context state
          fieldIdentityWalkSpecializationWalks (tailOr walks) owner path rootModule context next

@category "engine-internal"
fieldIdentityWalkRegisteredSpecialization : (name: String) -> (actual: TraversalType) -> (template: TraversalType) -> (params: List String) -> (templateOwner: FieldOwner) -> (templateRealm: FieldIdentityRealm) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (context: a) -> (state: a) -> a
fieldIdentityWalkRegisteredSpecialization name actual template params templateOwner templateRealm owner path rootModule context state =
  let unified = fieldIdentitySpecializationUnifyType actual template params [] templateOwner [] templateRealm context true {
    matched = true,
    bindings = [],
    walks = [],
    aliases = [],
    attachments = [],
    attachmentOwner = owner
  }
  if not unified.matched
  then fieldIdentityWalkWithError state (InvalidNominalSpecialization {
    message = concat "field-identity: invalid specialization of registered nominal \"" (concat name "\""),
    name = name
  })
  else
    let attached = {
      occurrences = state.occurrences,
      inlineDefs = state.inlineDefs,
      needsMint = state.needsMint,
      attachments = concat state.attachments unified.attachments,
      ownedTokens = concat state.ownedTokens (map (\attachment -> attachment.actualToken) unified.attachments),
      error = state.error
    }
    let withOuterBindings = fieldIdentityWalkSpecializationBindings params 0 unified.bindings owner path rootModule context attached
    let aliasProof = fieldIdentitySpecializationAttachmentProofs (map (fieldIdentitySpecializationPrefixWalk path) unified.aliases) owner context.realm owner withOuterBindings.occurrences context {
      matched = true,
      attachments = withOuterBindings.attachments
    }
    if not aliasProof.matched
    then fieldIdentityWalkWithError state (InvalidNominalSpecialization {
      message = concat "field-identity: repeated representation alias failed for registered nominal \"" (concat name "\""),
      name = name
    })
    else
      let withAliases = {
        occurrences = withOuterBindings.occurrences,
        inlineDefs = withOuterBindings.inlineDefs,
        needsMint = withOuterBindings.needsMint,
        attachments = aliasProof.attachments,
        ownedTokens = concat withOuterBindings.ownedTokens (map (\attachment -> attachment.actualToken) aliasProof.attachments),
        error = withOuterBindings.error
      }
      -- Outer substitutions own shared tokens first. Repeated equal reps are
      -- attachment-only; independent nested arguments then claim only tokens
      -- that remain unowned at their own typed paths.
      fieldIdentityWalkSpecializationWalks unified.walks owner path rootModule context withAliases

@category "engine-internal"
fieldIdentityWalkOpaque : (pure: TraversalType) -> (name: String) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (context: a) -> (state: a) -> a
fieldIdentityWalkOpaque pure name owner path rootModule context state =
  let resolution = fieldIdentityNominalResolution context.nominalIndexes rootModule name
  if eq resolution.tag "Found"
  then
    case resolution.root of
      TypeFieldDeclarationRoot { params = params, declaration = declaration } ->
        case declaration of
          TtOpaque { pure = templatePure, name = templateName } ->
            if eq templateName name
            then fieldIdentityWalkRegisteredSpecialization name pure templatePure params (fieldIdentityRootOwner resolution.root) (fieldIdentityRootRealm resolution.root) owner path rootModule context state
            else fieldIdentityWalkWithError state (InvalidNominalSpecialization {
              message = concat "field-identity: registered nominal name mismatch for \"" (concat name "\""),
              name = name
            })
          other -> fieldIdentityWalkRegisteredSpecialization name pure declaration params (fieldIdentityRootOwner resolution.root) (fieldIdentityRootRealm resolution.root) owner path rootModule context state
      FunctionFieldDeclarationRoot -> state
  else if eq resolution.tag "Ambiguous"
  then fieldIdentityWalkWithError state (AmbiguousNominalFieldOwner {
    message = concat "field-identity: ambiguous registered nominal owner for \"" (concat name "\""),
    name = name
  })
  else
    let inlineOwner = InlineNominalFieldOwner { parent = owner, name = name }
    case fieldIdentityFindInlineDef state.inlineDefs inlineOwner of
      Just previous ->
        if fieldIdentityTypeEq previous.pure pure
        then state
        else fieldIdentityWalkWithError state (ConflictingInlineNominal {
          message = concat "field-identity: conflicting nominal definitions for \"" (concat (fieldIdentityOwnerText inlineOwner) "\""),
          owner = inlineOwner
        })
      Nothing ->
        let next = {
          occurrences = state.occurrences,
          inlineDefs = appendItem { owner = inlineOwner, pure = pure } state.inlineDefs,
          needsMint = state.needsMint,
          attachments = state.attachments,
          ownedTokens = state.ownedTokens,
          error = Nothing
        }
        fieldIdentityWalkType pure inlineOwner [] rootModule context next

@category "engine-internal"
fieldIdentityWalkFieldStep : (owner: FieldOwner) -> (parentPath: List FieldPathSegment) -> (rootModule: Maybe String) -> (realm: FieldIdentityRealm) -> (context: a) -> (acc: a) -> (field: a) -> a
fieldIdentityWalkFieldStep owner parentPath rootModule realm context acc field =
  case acc.walk.error of
    Just err -> { walk = acc.walk, index = add acc.index 1, keys = acc.keys, names = acc.names }
    Nothing ->
      if elem field.token acc.walk.ownedTokens
      then { walk = acc.walk, index = add acc.index 1, keys = acc.keys, names = acc.names }
      else
        case fieldIdentityFieldSegment field acc.index of
          Err err ->
            { walk = fieldIdentityWalkWithError acc.walk err,
              index = add acc.index 1,
              keys = acc.keys,
              names = acc.names
            }
          Ok classification ->
            let path = appendItem classification.segment parentPath
            let qualifiedName =
                  case acc.names of
                    Nothing -> fieldIdentityQualifiedName owner path
                    Just names ->
                      let segment = urlEncode (fieldIdentityPathSegmentText classification.segment)
                      let encodedPath =
                            if eq names.parentPath ""
                            then segment
                            else concat names.parentPath (concat "/" segment)
                      concat names.ownerLookupKey encodedPath
            case fieldIdentityResolveField field realm context.mode qualifiedName context.lockIndex classification.positional acc.index of
              Err err ->
                { walk = fieldIdentityWalkWithError acc.walk err,
                  index = add acc.index 1,
                  keys = acc.keys,
                  names = acc.names
                }
              Ok resolved ->
                if elem resolved.key acc.keys
                then
                  { walk = fieldIdentityWalkWithError acc.walk (DuplicateFieldIdentity {
                      message = concat "field-identity: duplicate field identity in one field list at " qualifiedName,
                      qualifiedName = qualifiedName
                    }),
                    index = add acc.index 1,
                    keys = acc.keys,
                    names = acc.names
                  }
                else
                  -- Prepare only after the original resolution and duplicate
                  -- checks; sibling-local sharing preserves first-refusal order.
                  let names =
                        case acc.names of
                          Just previous -> previous
                          Nothing ->
                            let ownerText = fieldIdentityOwnerText owner
                            let ownerLookupKey = concat "field:" (concat (urlEncode ownerText) "/")
                            let encodedParentPath = fieldIdentityEncodedPath parentPath ""
                            {
                              ownerLookupKey = ownerLookupKey,
                              containerName = concat ownerText (concat "|" encodedParentPath),
                              parentPath = encodedParentPath
                            }
                  let occurrence = ResolvedFieldOccurrence {
                    owner = owner,
                    path = path,
                    qualifiedName = qualifiedName,
                    ownerLookupKey = names.ownerLookupKey,
                    containerName = names.containerName,
                    sourceName = field.name,
                    key = resolved.key,
                    sourceKey = resolved.sourceKey,
                    token = field.token,
                    occurrenceType = field.raw,
                    ingress = resolved.ingress,
                    realm = realm,
                    lockRequest = resolved.request,
                    declaresEntity = resolved.declaresEntity,
                    referenceHandle = resolved.referenceHandle
                  }
                  let needs =
                        if resolved.needsMint
                        then appendItem (NeedsMint { owner = owner, path = path, sourceName = field.name, token = field.token }) acc.walk.needsMint
                        else acc.walk.needsMint
                  let withOccurrence = {
                    occurrences = appendItem occurrence acc.walk.occurrences,
                    inlineDefs = acc.walk.inlineDefs,
                    needsMint = needs,
                    attachments = acc.walk.attachments,
                    ownedTokens = appendItem field.token acc.walk.ownedTokens,
                    error = Nothing
                  }
                  let walked = fieldIdentityWalkType field.type owner path rootModule context withOccurrence
                  { walk = walked,
                    index = add acc.index 1,
                    keys = appendItem resolved.key acc.keys,
                    names = Just names
                  }

@category "engine-internal"
fieldIdentityWalkFields : (fields: List a) -> (owner: FieldOwner) -> (parentPath: List FieldPathSegment) -> (rootModule: Maybe String) -> (realm: FieldIdentityRealm) -> (context: a) -> (state: a) -> a
fieldIdentityWalkFields fields owner parentPath rootModule realm context state =
  let out = fold (fieldIdentityWalkFieldStep owner parentPath rootModule realm context) { walk = state, index = 0, keys = [], names = Nothing } fields
  out.walk

@category "engine-internal"
fieldIdentityWalkCases : (cases: List a) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (realm: FieldIdentityRealm) -> (context: a) -> (state: a) -> a
fieldIdentityWalkCases cases owner path rootModule realm context state =
  case head cases of
    Nothing -> state
    Just c ->
      let casePath = appendItem (FieldCase { name = c.name }) path
      let next = fieldIdentityWalkFields c.fields owner casePath rootModule realm context state
      case tail cases of
        Nothing -> next
        Just rest -> fieldIdentityWalkCases rest owner path rootModule realm context next

@category "engine-internal"
fieldIdentityWalkTuple : (items: List TraversalType) -> (index: Number) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (realm: FieldIdentityRealm) -> (context: a) -> (state: a) -> a
fieldIdentityWalkTuple items index owner path rootModule realm context state =
  case head items of
    Nothing -> state
    Just item ->
      let next = fieldIdentityWalkType item owner (appendItem (FieldTuple { index = index }) path) rootModule context state
      case tail items of
        Nothing -> next
        Just rest -> fieldIdentityWalkTuple rest (add index 1) owner path rootModule realm context next

@category "engine-internal"
fieldIdentityWalkUnion : (items: List TraversalType) -> (index: Number) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (realm: FieldIdentityRealm) -> (context: a) -> (state: a) -> a
fieldIdentityWalkUnion items index owner path rootModule realm context state =
  case head items of
    Nothing -> state
    Just item ->
      let next = fieldIdentityWalkType item owner (appendItem (FieldUnion { index = index }) path) rootModule context state
      case tail items of
        Nothing -> next
        Just rest -> fieldIdentityWalkUnion rest (add index 1) owner path rootModule realm context next

@category "engine-internal"
fieldIdentityWalkIntersect : (items: List TraversalType) -> (index: Number) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (realm: FieldIdentityRealm) -> (context: a) -> (state: a) -> a
fieldIdentityWalkIntersect items index owner path rootModule realm context state =
  case head items of
    Nothing -> state
    Just item ->
      let next = fieldIdentityWalkType item owner (appendItem (FieldIntersect { index = index }) path) rootModule context state
      case tail items of
        Nothing -> next
        Just rest -> fieldIdentityWalkIntersect rest (add index 1) owner path rootModule realm context next

@category "engine-internal"
fieldIdentityWalkTypeArgs : (items: List TraversalType) -> (index: Number) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (context: a) -> (state: a) -> a
fieldIdentityWalkTypeArgs items index owner path rootModule context state =
  case head items of
    Nothing -> state
    Just item ->
      let next = fieldIdentityWalkType item owner (appendItem (FieldTypeArg { index = index }) path) rootModule context state
      case tail items of
        Nothing -> next
        Just rest -> fieldIdentityWalkTypeArgs rest (add index 1) owner path rootModule context next

@category "engine-internal"
fieldIdentityWalkType : (node: TraversalType) -> (owner: FieldOwner) -> (path: List FieldPathSegment) -> (rootModule: Maybe String) -> (context: a) -> (state: a) -> a
fieldIdentityWalkType node owner path rootModule context state =
  case state.error of
    Just err -> state
    Nothing ->
      case node of
        TtNamed -> state
        TtVar -> state
        TtOpaque { pure = pure, name = name } ->
          fieldIdentityWalkOpaque pure name owner path rootModule context state
        TtUnit -> state
        TtVoid -> state
        TtTypeUniverse -> state
        TtEl -> state
        TtUnknown -> state
        TtApp { args = args } ->
          fieldIdentityWalkTypeArgs args 0 owner path rootModule context state
        TtRecord { fields = fields } ->
          fieldIdentityWalkFields fields owner path rootModule context.realm context state
        TtVariant { cases = cases } ->
          fieldIdentityWalkCases cases owner path rootModule context.realm context state
        TtTuple { items = items } ->
          fieldIdentityWalkTuple items 0 owner path rootModule context.realm context state
        TtMap { values = values } ->
          fieldIdentityWalkType values owner (appendItem FieldMapValue path) rootModule context state
        TtRefined { base = base } ->
          fieldIdentityWalkType base owner (appendItem FieldRefinedBase path) rootModule context state
        TtMu { body = body } ->
          fieldIdentityWalkType body owner path rootModule context state
        TtTagged { value = value, phantom = phantom } ->
          let afterValue = fieldIdentityWalkType value owner (appendItem FieldTaggedValue path) rootModule context state
          fieldIdentityWalkType phantom owner (appendItem FieldTaggedPhantom path) rootModule context afterValue
        TtArrow { params = params, returns = returns } ->
          let afterParams = fieldIdentityWalkFields params owner path rootModule context.realm context state
          fieldIdentityWalkType returns owner (appendItem FieldArrowReturn path) rootModule context afterParams
        TtUnion { branches = branches } ->
          fieldIdentityWalkUnion branches 0 owner path rootModule context.realm context state
        TtIntersect { branches = branches } ->
          fieldIdentityWalkIntersect branches 0 owner path rootModule context.realm context state
        TtComplement { inner = inner } ->
          fieldIdentityWalkType inner owner (appendItem FieldComplement path) rootModule context state

@category "engine-internal"
fieldIdentityWalkRootStep : (baseContext: a) -> (state: a) -> (root: FieldDeclarationRoot) -> a
fieldIdentityWalkRootStep baseContext state root =
  case state.error of
    Just err -> state
    Nothing ->
      let realm = fieldIdentityRootRealm root
      if not (fieldIdentityRealmModeAllowed realm baseContext.mode)
      then fieldIdentityWalkWithError state (InvalidFieldRealmMode {
        message = "field-identity: invalid realm/mode combination"
      })
      else
        let owner = fieldIdentityRootOwner root
        let rootModule = fieldIdentityRootModule root
        let context = {
          roots = baseContext.roots,
          nominalIndexes = baseContext.nominalIndexes,
          mode = baseContext.mode,
          lockIndex = baseContext.lockIndex,
          kindIndex = baseContext.kindIndex,
          externalIndex = baseContext.externalIndex,
          realm = realm
        }
        case root of
          FunctionFieldDeclarationRoot { params = params, returns = returns } ->
            let afterParams = fieldIdentityWalkFields params owner [] rootModule realm context state
            fieldIdentityWalkType returns owner [FieldArrowReturn] rootModule context afterParams
          TypeFieldDeclarationRoot { declaration = declaration } ->
            case declaration of
              TtOpaque { pure = pure, name = name } ->
                case owner of
                  TypeFieldOwner { localId = local } ->
                    if eq name local
                    then fieldIdentityWalkType pure owner [] rootModule context state
                    else fieldIdentityWalkType declaration owner [] rootModule context state
                  FunctionFieldOwner -> fieldIdentityWalkType declaration owner [] rootModule context state
                  InlineNominalFieldOwner -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtNamed -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtVar -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtUnit -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtVoid -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtTypeUniverse -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtEl -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtRecord -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtVariant -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtTuple -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtMap -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtApp -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtRefined -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtMu -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtTagged -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtArrow -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtUnion -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtIntersect -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtComplement -> fieldIdentityWalkType declaration owner [] rootModule context state
              TtUnknown -> fieldIdentityWalkType declaration owner [] rootModule context state

@category "engine-internal"
fieldIdentityWalkOneRoot : (baseContext: a) -> (root: FieldDeclarationRoot) -> a
fieldIdentityWalkOneRoot baseContext root =
  fieldIdentityWalkRootStep baseContext {
    occurrences = [], inlineDefs = [], needsMint = [], attachments = [], ownedTokens = [], error = Nothing
  } root

@category "engine-internal"
fieldIdentityWalkStateHasError : (state: a) -> Boolean
fieldIdentityWalkStateHasError state =
  case state.error of
    Just err -> true
    Nothing -> false

@category "engine-internal"
fieldIdentityMergeWalkStateStep : (state: a) -> (next: a) -> a
fieldIdentityMergeWalkStateStep state next =
  case state.error of
    Just err -> state
    Nothing -> {
      occurrences = concat state.occurrences next.occurrences,
      inlineDefs = concat state.inlineDefs next.inlineDefs,
      needsMint = concat state.needsMint next.needsMint,
      attachments = concat state.attachments next.attachments,
      ownedTokens = concat state.ownedTokens next.ownedTokens,
      error = next.error
    }

-- The walk stage with its facts: the nominal indexes every walk consulted and
-- the state of each root's walk, in root order, beside the merged state.
@category "engine-internal"
fieldIdentityWalkRootsStaged : (roots: List FieldDeclarationRoot) -> (mode: FieldIdentityMode) -> (lockIndex: a) -> (kindIndex: a) -> (externalIndex: a) -> a
fieldIdentityWalkRootsStaged roots mode lockIndex kindIndex externalIndex =
  let nominalIndexes = fieldIdentityNominalRootIndexes roots
  let base = {
    roots = roots,
    nominalIndexes = nominalIndexes,
    mode = mode,
    lockIndex = lockIndex,
    kindIndex = kindIndex,
    externalIndex = externalIndex
  }
  let walked = map (fieldIdentityWalkOneRoot base) roots
  { nominalIndexes = nominalIndexes, perRoot = walked, merged = fieldIdentityMergeWalkedRoots walked }

@category "engine-internal"
fieldIdentityWalkRoots : (roots: List FieldDeclarationRoot) -> (mode: FieldIdentityMode) -> (lockIndex: a) -> (kindIndex: a) -> (externalIndex: a) -> a
fieldIdentityWalkRoots roots mode lockIndex kindIndex externalIndex =
  let staged = fieldIdentityWalkRootsStaged roots mode lockIndex kindIndex externalIndex
  staged.merged

@category "engine-internal"
fieldIdentityMergeWalkedRoots : (walked: List a) -> a
fieldIdentityMergeWalkedRoots walked =
  case find fieldIdentityWalkStateHasError walked of
    Just failed ->
      fold fieldIdentityMergeWalkStateStep {
        occurrences = [], inlineDefs = [], needsMint = [], attachments = [], ownedTokens = [], error = Nothing
      } walked
    Nothing -> {
      occurrences = flatMap (\state -> state.occurrences) walked,
      inlineDefs = flatMap (\state -> state.inlineDefs) walked,
      needsMint = flatMap (\state -> state.needsMint) walked,
      attachments = flatMap (\state -> state.attachments) walked,
      ownedTokens = flatMap (\state -> state.ownedTokens) walked,
      error = Nothing
    }

-- Equivalent duplicate roots share one semantic declaration/occurrence set,
-- but every host encounter still has its own opaque field tokens.  Prove the
-- duplicate against the retained declaration and stage token attachments only
-- after the entire root succeeds, exactly like nominal specialization.
@category "engine-internal"
fieldIdentityDuplicateWalkProofs : (walks: List a) -> (templateOwner: FieldOwner) -> (templateRealm: FieldIdentityRealm) -> (attachmentOwner: FieldOwner) -> (context: a) -> (state: a) -> a
fieldIdentityDuplicateWalkProofs walks templateOwner templateRealm attachmentOwner context state =
  fieldIdentitySpecializationAttachmentProofs walks templateOwner templateRealm attachmentOwner [] context state

@category "engine-internal"
fieldIdentityDuplicateRootProof : (pair: a) -> (context: a) -> a
fieldIdentityDuplicateRootProof pair context =
  let canonical = pair.canonical
  let duplicate = pair.duplicate
  let owner = fieldIdentityRootOwner canonical
  let realm = fieldIdentityRootRealm canonical
  let initial = {
    matched = true,
    bindings = [],
    walks = [],
    aliases = [],
    attachments = [],
    attachmentOwner = fieldIdentityRootOwner duplicate
  }
  let proved =
    case canonical of
      TypeFieldDeclarationRoot { declaration = template } ->
        case duplicate of
          TypeFieldDeclarationRoot { declaration = actual } ->
            -- Root equality already proved declared generic parameters equal.
            -- They remain literal syntax here; this pass maps carrier tokens,
            -- rather than discovering a use-site specialization.
            fieldIdentitySpecializationUnifyType actual template [] [] owner [] realm context true initial
          FunctionFieldDeclarationRoot -> fieldIdentitySpecializationMismatch initial
      FunctionFieldDeclarationRoot { params = templateParams, returns = templateReturns } ->
        case duplicate of
          TypeFieldDeclarationRoot -> fieldIdentitySpecializationMismatch initial
          FunctionFieldDeclarationRoot { params = actualParams, returns = actualReturns } ->
            let afterParams = fieldIdentitySpecializationUnifyFields actualParams templateParams 0 [] [] owner [] realm context true initial
            fieldIdentitySpecializationUnifyType actualReturns templateReturns [] [] owner [FieldArrowReturn] realm context true afterParams
  if not proved.matched
  then proved
  else
    let deep = fieldIdentityDuplicateWalkProofs (concat proved.walks proved.aliases) owner realm (fieldIdentityRootOwner duplicate) context {
      matched = true,
      attachments = proved.attachments
    }
    if not deep.matched
    then fieldIdentitySpecializationMismatch proved
    else {
      matched = true,
      bindings = proved.bindings,
      walks = [],
      aliases = [],
      attachments = deep.attachments,
      attachmentOwner = proved.attachmentOwner
    }

@category "engine-internal"
fieldIdentityDuplicateRootAttachmentsFrom : (pairs: List a) -> (context: a) -> (state: a) -> a
fieldIdentityDuplicateRootAttachmentsFrom pairs context state =
  case state.error of
    Just err -> state
    Nothing ->
      case head pairs of
        Nothing -> state
        Just pair ->
          let proved = fieldIdentityDuplicateRootProof pair context
          if not proved.matched
          then {
            attachments = state.attachments,
            error = Just (ConflictingFieldDeclaration {
              message = concat "field-identity: duplicate declaration token proof failed for \"" (concat (fieldIdentityOwnerText (fieldIdentityRootOwner pair.canonical)) "\""),
              owner = fieldIdentityRootOwner pair.canonical
            })
          }
          else fieldIdentityDuplicateRootAttachmentsFrom (tailOr pairs) context {
            attachments = concat state.attachments proved.attachments,
            error = Nothing
          }

@category "engine-internal"
fieldIdentityDuplicateRootAttachments : (pairs: List a) -> (roots: List FieldDeclarationRoot) -> (mode: FieldIdentityMode) -> (lockIndex: a) -> a
fieldIdentityDuplicateRootAttachments pairs roots mode lockIndex =
  let context = {
    roots = roots,
    nominalIndexes = fieldIdentityNominalRootIndexes roots,
    mode = mode,
    lockIndex = lockIndex
  }
  fieldIdentityDuplicateRootAttachmentsFrom pairs context { attachments = [], error = Nothing }

-- -------------------------------------------------------------------------
-- Global integrity checks, explicit-reuse normalization, entity grouping,
-- and deterministic lock projection
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityOccurrenceHandle : (occurrence: ResolvedFieldOccurrence) -> Maybe String
fieldIdentityOccurrenceHandle occurrence =
  case occurrence.key of
    NamedField { ref = FieldRef { handle = handle } } -> Just handle
    PositionalField -> Nothing

@category "engine-internal"
fieldIdentityOccurrenceIsNamed : (occurrence: ResolvedFieldOccurrence) -> Boolean
fieldIdentityOccurrenceIsNamed occurrence =
  case fieldIdentityOccurrenceHandle occurrence of
    Just handle -> true
    Nothing -> false

@category "engine-internal"
fieldIdentityOccurrenceHandleOrEmpty : (occurrence: ResolvedFieldOccurrence) -> String
fieldIdentityOccurrenceHandleOrEmpty occurrence =
  case fieldIdentityOccurrenceHandle occurrence of
    Just handle -> handle
    Nothing -> ""

@category "engine-internal"
fieldIdentityOccurrenceWithHandle : (occurrence: ResolvedFieldOccurrence) -> (handle: String) -> (declaresEntity: Boolean) -> ResolvedFieldOccurrence
fieldIdentityOccurrenceWithHandle occurrence handle declaresEntity =
  ResolvedFieldOccurrence {
    owner = occurrence.owner,
    path = occurrence.path,
    qualifiedName = occurrence.qualifiedName,
    ownerLookupKey = occurrence.ownerLookupKey,
    containerName = occurrence.containerName,
    sourceName = occurrence.sourceName,
    key = NamedField { ref = FieldRef { handle = handle } },
    sourceKey = occurrence.sourceKey,
    token = occurrence.token,
    occurrenceType = occurrence.occurrenceType,
    ingress = occurrence.ingress,
    realm = occurrence.realm,
    lockRequest = occurrence.lockRequest,
    declaresEntity = declaresEntity,
    referenceHandle = occurrence.referenceHandle
  }

@category "engine-internal"
fieldIdentitySameOccurrencePath : (left: ResolvedFieldOccurrence) -> (right: ResolvedFieldOccurrence) -> Boolean
fieldIdentitySameOccurrencePath left right =
  and (eq left.owner right.owner) (eq left.path right.path)

@category "engine-internal"
fieldIdentityPathCheckStep : (state: a) -> (occurrence: ResolvedFieldOccurrence) -> a
fieldIdentityPathCheckStep state occurrence =
  case state.error of
    Just err -> state
    Nothing ->
      case state.previous of
        Nothing -> { previous = Just occurrence, error = Nothing }
        Just previous ->
          if eq previous.qualifiedName occurrence.qualifiedName
          then
            if fieldIdentitySameOccurrencePath previous occurrence
            then {
              previous = Just occurrence,
              error = Just (DuplicateFieldPath {
                message = concat "field-identity: ambiguous declaration path \"" (concat occurrence.qualifiedName "\""),
                qualifiedName = occurrence.qualifiedName
              })
            }
            else {
              previous = Just occurrence,
              error = Just (DuplicateFieldPath {
                message = concat "field-identity: typed owner/path values collide in canonical encoding \"" (concat occurrence.qualifiedName "\""),
                qualifiedName = occurrence.qualifiedName
              })
            }
          else { previous = Just occurrence, error = Nothing }

@category "engine-internal"
fieldIdentitySortedStringBuckets : (buckets: List (List a)) -> (start: Number) -> (stop: Number) -> List a
fieldIdentitySortedStringBuckets buckets start stop =
  let size = sub stop start
  if lte size 0 then []
  else if eq size 1 then at buckets start
  else
    let middle = add start (floor (div size 2))
    concat (fieldIdentitySortedStringBuckets buckets start middle) (fieldIdentitySortedStringBuckets buckets middle stop)

-- Only the kernel's pure metadata selectors use this path. Captured primitive
-- String keys have the native comparator's UTF-16 order; a common prefix keeps
-- bucket names away from numeric/prototype properties. Buckets retain input
-- order, including ties. Index-range concatenation avoids a host argument-count
-- limit on one large bucket and keeps recursive depth logarithmic.
-- Preserve native sort's no-selector case for empty/singleton arrays and its
-- special handling of undefined elements. Other malformed/nonstring keys keep
-- the existing comparator and diagnostic path; this is not a general HOF sort.
@category "engine-internal"
fieldIdentitySortStringKeys : (key: (a -> String)) -> (items: List a) -> List a
fieldIdentitySortStringKeys key items =
  if not (isArray items) then sort key items
  else if lt (length items) 2 then concat [] items
  else if std.some items (\item -> isNull item) then sort key items
  else
    let keyed = map (\item -> { sortKey = key item, value = item }) items
    if not (std.all keyed (\entry -> isString entry.sortKey)) then sort key items
    else
      let groups = groupBy (\entry -> join ["field-sort/", entry.sortKey] "") keyed
      let keys = sortLex (map (\entry -> entry.key) (entries groups))
      let buckets = map (\key -> fromMaybe [] (mapGet groups key)) keys
      map (\entry -> entry.value) (fieldIdentitySortedStringBuckets buckets 0 (length buckets))

@category "engine-internal"
fieldIdentityCheckPaths : (occurrences: List ResolvedFieldOccurrence) -> Maybe FieldIdentityError
fieldIdentityCheckPaths occurrences =
  let sorted = fieldIdentitySortStringKeys (\occurrence -> occurrence.qualifiedName) occurrences
  let state = fold fieldIdentityPathCheckStep { previous = Nothing, error = Nothing } sorted
  state.error

@category "engine-internal"
fieldIdentityOccurrenceIndex : (occurrences: List ResolvedFieldOccurrence) -> a
fieldIdentityOccurrenceIndex occurrences =
  fromEntries (map (\occurrence -> { key = occurrence.qualifiedName, value = occurrence }) occurrences)

@category "engine-internal"
fieldIdentityDeclaringIndex : (occurrences: List ResolvedFieldOccurrence) -> a
fieldIdentityDeclaringIndex occurrences =
  let declaring = filter (\occurrence -> and occurrence.declaresEntity (fieldIdentityOccurrenceIsNamed occurrence)) occurrences
  fromEntries (map (\occurrence -> { key = fieldIdentityOccurrenceHandleOrEmpty occurrence, value = occurrence }) declaring)

@category "engine-internal"
fieldIdentityWrongKind : (kindIndex: a) -> (handle: String) -> Maybe FieldIdentityError
fieldIdentityWrongKind kindIndex handle =
  case mapGet kindIndex handle of
    Nothing -> Nothing
    Just kind ->
      if eq kind "field"
      then Nothing
      else Just (WrongFieldIdentityKind {
        message = concat "field-identity: handle \"" (concat handle (concat "\" belongs to identity kind " kind)),
        handle = handle,
        actualKind = kind
      })

@category "engine-internal"
fieldIdentityNormalizedOccurrence : (occurrence: ResolvedFieldOccurrence) -> a
fieldIdentityNormalizedOccurrence occurrence =
  { value = occurrence, error = Nothing }

@category "engine-internal"
fieldIdentityNormalizationError : (occurrence: ResolvedFieldOccurrence) -> (error: FieldIdentityError) -> a
fieldIdentityNormalizationError occurrence error =
  { value = occurrence, error = Just error }

@category "engine-internal"
fieldIdentityNormalizeOccurrence : (context: a) -> (occurrence: ResolvedFieldOccurrence) -> a
fieldIdentityNormalizeOccurrence context occurrence =
  case fieldIdentityOccurrenceHandle occurrence of
    Nothing -> fieldIdentityNormalizedOccurrence occurrence
    Just currentHandle ->
      case fieldIdentityWrongKind context.kindIndex currentHandle of
        Just err -> fieldIdentityNormalizationError occurrence err
        Nothing ->
          case occurrence.referenceHandle of
            Nothing -> fieldIdentityNormalizedOccurrence occurrence
            Just originalHandle ->
              if startsWith originalHandle "field:"
              then
                case mapGet context.occurrenceIndex originalHandle of
                  Just target ->
                    if eq target.token occurrence.token
                    then
                      -- A repository declaration may persist its own canonical
                      -- source handle before embedding. Once the physical lock
                      -- proves that exact qualified name -> UUID, this is a
                      -- declaration of that UUID rather than a circular alias.
                      -- SourceHandles mode and non-canonical self refs still
                      -- fail because their current handle is not a proved UUID.
                      if and (eq originalHandle occurrence.qualifiedName) (fieldIdentityIsUuid currentHandle)
                      then fieldIdentityNormalizedOccurrence (fieldIdentityOccurrenceWithHandle occurrence currentHandle true)
                      else fieldIdentityNormalizationError occurrence (UnresolvedFieldHandle {
                        message = concat "field-identity: explicit field ref resolves only to its own occurrence \"" (concat originalHandle "\""),
                        handle = originalHandle
                      })
                    else
                      case fieldIdentityOccurrenceHandle target of
                        Nothing -> fieldIdentityNormalizationError occurrence (UnresolvedFieldHandle {
                          message = concat "field-identity: explicit field ref targets a positional slot \"" (concat originalHandle "\""),
                          handle = originalHandle
                        })
                        Just targetHandle ->
                          case fieldIdentityWrongKind context.kindIndex targetHandle of
                            Just err -> fieldIdentityNormalizationError occurrence err
                            Nothing -> fieldIdentityNormalizedOccurrence (fieldIdentityOccurrenceWithHandle occurrence targetHandle false)
                  Nothing ->
                    case mapGet context.externalIndex currentHandle of
                      Just external -> fieldIdentityNormalizedOccurrence occurrence
                      Nothing -> fieldIdentityNormalizationError occurrence (UnresolvedFieldHandle {
                        message = concat "field-identity: field handle exists only as a lock row or is unresolved: \"" (concat originalHandle "\""),
                        handle = originalHandle
                      })
              else
                case mapGet context.declaringIndex currentHandle of
                  Just declaration -> fieldIdentityNormalizedOccurrence occurrence
                  Nothing ->
                    case mapGet context.externalIndex currentHandle of
                      Just external -> fieldIdentityNormalizedOccurrence occurrence
                      Nothing ->
                        case mapGet context.kindIndex currentHandle of
                          Just knownKind ->
                            -- A live-kind row proves reservation/kind, not
                            -- a live FieldEntity. Reuse requires either a
                            -- declaration in this result or the injected
                            -- external catalog; tombstones are never live.
                            fieldIdentityNormalizationError occurrence (UnresolvedFieldHandle {
                              message = concat "field-identity: known field UUID has no live declaration or external catalog entry: \"" (concat currentHandle "\""),
                              handle = currentHandle
                            })
                          Nothing ->
                            -- A genuinely unclaimed, well-formed UUID may
                            -- begin a realm-authorized field entity.
                            fieldIdentityNormalizedOccurrence (fieldIdentityOccurrenceWithHandle occurrence currentHandle true)

@category "engine-internal"
fieldIdentityNormalizationSucceeded : (result: a) -> Boolean
fieldIdentityNormalizationSucceeded result =
  case result.error of
    Nothing -> true
    Just err -> false

@category "engine-internal"
fieldIdentityNormalizationValue : (result: a) -> ResolvedFieldOccurrence
fieldIdentityNormalizationValue result = result.value

@category "engine-internal"
fieldIdentityNormalizationContext : (occurrences: List ResolvedFieldOccurrence) -> (kindIndex: a) -> (externalIndex: a) -> a
fieldIdentityNormalizationContext occurrences kindIndex externalIndex =
  {
    occurrenceIndex = fieldIdentityOccurrenceIndex occurrences,
    declaringIndex = fieldIdentityDeclaringIndex occurrences,
    kindIndex = kindIndex,
    externalIndex = externalIndex
  }

@category "engine-internal"
fieldIdentityNormalizeOccurrences : (occurrences: List ResolvedFieldOccurrence) -> (kindIndex: a) -> (externalIndex: a) -> a
fieldIdentityNormalizeOccurrences occurrences kindIndex externalIndex =
  fieldIdentityNormalizeWithContext (fieldIdentityNormalizationContext occurrences kindIndex externalIndex) occurrences

@category "engine-internal"
fieldIdentityNormalizeWithContext : (context: a) -> (occurrences: List ResolvedFieldOccurrence) -> a
fieldIdentityNormalizeWithContext context occurrences =
  let results = map (fieldIdentityNormalizeOccurrence context) occurrences
  case find (\result -> not (fieldIdentityNormalizationSucceeded result)) results of
    Nothing -> { occurrences = map fieldIdentityNormalizationValue results, error = Nothing }
    Just failed ->
      let accepted = takeWhile fieldIdentityNormalizationSucceeded results
      { occurrences = map fieldIdentityNormalizationValue accepted, error = failed.error }

@category "engine-internal"
fieldIdentityContainerIdentityKey : (occurrence: ResolvedFieldOccurrence) -> String
fieldIdentityContainerIdentityKey occurrence =
  case fieldIdentityOccurrenceHandle occurrence of
    Nothing -> concat occurrence.containerName (concat "|position:" (case occurrence.key of PositionalField { index = index } -> toString index; NamedField -> ""))
    Just handle -> concat occurrence.containerName (concat "|named:" handle)

@category "engine-internal"
fieldIdentityParentPath : (path: List FieldPathSegment) -> List FieldPathSegment
fieldIdentityParentPath path =
  if lte (length path) 1
  then []
  else
    case head path of
      Nothing -> []
      Just segment ->
        let rest = tailOr path
        let parent = fieldIdentityParentPath rest
        appendItem segment parent

@category "engine-internal"
fieldIdentityOccurrenceKeyEq : (left: ResolvedFieldOccurrence) -> (right: ResolvedFieldOccurrence) -> Boolean
fieldIdentityOccurrenceKeyEq left right =
  case left.key of
    NamedField { ref = FieldRef { handle = leftHandle } } ->
      case right.key of
        NamedField { ref = FieldRef { handle = rightHandle } } -> eq leftHandle rightHandle
        PositionalField -> false
    PositionalField { index = leftIndex } ->
      case right.key of
        NamedField -> false
        PositionalField { index = rightIndex } -> eq leftIndex rightIndex

@category "engine-internal"
fieldIdentitySameContainerIdentity : (left: ResolvedFieldOccurrence) -> (right: ResolvedFieldOccurrence) -> Boolean
fieldIdentitySameContainerIdentity left right =
  let leftParent = fieldIdentityParentPath left.path
  let rightParent = fieldIdentityParentPath right.path
  let sameOwner = eq left.owner right.owner
  let sameParent = eq leftParent rightParent
  let sameKey = fieldIdentityOccurrenceKeyEq left right
  and sameOwner (and sameParent sameKey)

@category "engine-internal"
fieldIdentityContainerCheckStep : (state: a) -> (occurrence: ResolvedFieldOccurrence) -> a
fieldIdentityContainerCheckStep state occurrence =
  let key = fieldIdentityContainerIdentityKey occurrence
  case state.error of
    Just err -> state
    Nothing ->
      case state.previous of
        Nothing -> { previous = Just occurrence, error = Nothing }
        Just previous ->
          if eq (fieldIdentityContainerIdentityKey previous) key
          then
            if fieldIdentitySameContainerIdentity previous occurrence
            then { previous = Just occurrence, error = Just (DuplicateFieldIdentity {
              message = concat "field-identity: duplicate field identity in one field list at " occurrence.qualifiedName,
              qualifiedName = occurrence.qualifiedName
            }) }
            else { previous = Just occurrence, error = Just (DuplicateFieldPath {
              message = concat "field-identity: typed container identities collide in canonical encoding at " occurrence.qualifiedName,
              qualifiedName = occurrence.qualifiedName
            }) }
          else { previous = Just occurrence, error = Nothing }

@category "engine-internal"
fieldIdentityCheckContainerDuplicates : (occurrences: List ResolvedFieldOccurrence) -> Maybe FieldIdentityError
fieldIdentityCheckContainerDuplicates occurrences =
  -- Keep the existing eager structural-key projection, including its malformed
  -- input behavior. The portable sorter only reads the captured String key.
  let keyed = map (\occurrence -> { sortKey = fieldIdentityContainerIdentityKey occurrence, value = occurrence }) occurrences
  let sorted = map (\entry -> entry.value) (fieldIdentitySortStringKeys (\entry -> entry.sortKey) keyed)
  let state = fold fieldIdentityContainerCheckStep { previous = Nothing, error = Nothing } sorted
  state.error

@category "engine-internal"
fieldIdentityCodeableLocalStep : (state: a) -> (occurrence: ResolvedFieldOccurrence) -> (handle: String) -> a
fieldIdentityCodeableLocalStep state occurrence handle =
  if and state.hasPrevious (eq state.previousHandle handle)
  then
    if eq state.previousName occurrence.sourceName
    then state
    else { previousHandle = handle, previousName = occurrence.sourceName, hasPrevious = true, error = Just (FieldCodeableConflict {
      message = concat "field-identity: one field UUID has two current Codeable names: \"" (concat state.previousName (concat "\" and \"" (concat occurrence.sourceName "\""))),
      handle = handle,
      firstName = state.previousName,
      secondName = occurrence.sourceName
    }) }
  else { previousHandle = handle, previousName = occurrence.sourceName, hasPrevious = true, error = Nothing }

@category "engine-internal"
fieldIdentityCodeableStep : (externalIndex: a) -> (mutableHandles: List String) -> (state: a) -> (occurrence: ResolvedFieldOccurrence) -> a
fieldIdentityCodeableStep externalIndex mutableHandles state occurrence =
  case state.error of
    Just err -> state
    Nothing ->
      case fieldIdentityOccurrenceHandle occurrence of
        Nothing -> state
        Just handle ->
          case mapGet externalIndex handle of
            Just external ->
              if elem handle mutableHandles
              then fieldIdentityCodeableLocalStep state occurrence handle
              else if not (eq external.currentCodeName occurrence.sourceName)
              then { previousHandle = handle, previousName = occurrence.sourceName, hasPrevious = true, error = Just (FieldCodeableConflict {
                message = concat "field-identity: one field UUID has two current Codeable names: \"" (concat external.currentCodeName (concat "\" and \"" (concat occurrence.sourceName "\""))),
                handle = handle,
                firstName = external.currentCodeName,
                secondName = occurrence.sourceName
              }) }
              else fieldIdentityCodeableLocalStep state occurrence handle
            Nothing -> fieldIdentityCodeableLocalStep state occurrence handle

@category "engine-internal"
fieldIdentityCheckCodeables : (occurrences: List ResolvedFieldOccurrence) -> (externalIndex: a) -> (mutableCodeables: List FieldRef) -> Maybe FieldIdentityError
fieldIdentityCheckCodeables occurrences externalIndex mutableCodeables =
  let named = filter fieldIdentityOccurrenceIsNamed occurrences
  let keyed = map (\occurrence -> { sortKey = fieldIdentityOccurrenceHandleOrEmpty occurrence, value = occurrence }) named
  let sorted = map (\entry -> entry.value) (fieldIdentitySortStringKeys (\entry -> entry.sortKey) keyed)
  let mutableHandles = map (\field -> field.handle) mutableCodeables
  let state = fold (fieldIdentityCodeableStep externalIndex mutableHandles) { previousHandle = "", previousName = "", hasPrevious = false, error = Nothing } sorted
  state.error

@category "engine-internal"
fieldIdentityFirstOrigin : (occurrences: List ResolvedFieldOccurrence) -> Maybe FieldOrigin
fieldIdentityFirstOrigin occurrences =
  case find (\occurrence -> occurrence.declaresEntity) occurrences of
    Nothing -> Nothing
    Just occurrence -> Just (FieldOrigin { owner = occurrence.owner, path = occurrence.path })

@category "engine-internal"
fieldIdentityEntitiesFromGroup : (externalIndex: a) -> (entry: a) -> List FieldEntity
fieldIdentityEntitiesFromGroup externalIndex entry =
  -- `groupBy` preserves first-encounter order and every group is non-empty.
  -- Returning a singleton list lets `flatMap` build the complete entity roster
  -- linearly through its purity-gated native representation; no growing-array
  -- `appendItem` chain remains at repository cardinality.
  case head entry.value of
    Nothing -> []
    Just first ->
      let localOrigin = fieldIdentityFirstOrigin entry.value
      case mapGet externalIndex entry.key of
        Just external ->
          let origin = case localOrigin of Just o -> Just o; Nothing -> external.origin
          [FieldEntity {
            id = FieldRef { handle = entry.key },
            currentCodeName = first.sourceName,
            origin = origin,
            occurrences = concat external.occurrences entry.value
          }]
        Nothing ->
          [FieldEntity {
            id = FieldRef { handle = entry.key },
            currentCodeName = first.sourceName,
            origin = localOrigin,
            occurrences = entry.value
          }]

@category "engine-internal"
fieldIdentityBuildEntities : (occurrences: List ResolvedFieldOccurrence) -> (externalIndex: a) -> List FieldEntity
fieldIdentityBuildEntities occurrences externalIndex =
  let named = filter fieldIdentityOccurrenceIsNamed occurrences
  let keyed = map (\occurrence -> { sortKey = fieldIdentityOccurrenceHandleOrEmpty occurrence, value = occurrence }) named
  let sorted = map (\entry -> entry.value) (fieldIdentitySortStringKeys (\entry -> entry.sortKey) keyed)
  let grouped = entries (groupBy fieldIdentityOccurrenceHandleOrEmpty sorted)
  flatMap (fieldIdentityEntitiesFromGroup externalIndex) grouped

@category "engine-internal"
fieldIdentityOccurrenceRequests : (occurrence: ResolvedFieldOccurrence) -> List FieldLockRequest
fieldIdentityOccurrenceRequests occurrence =
  case occurrence.lockRequest of
    Nothing -> []
    Just request -> [request]

@category "engine-internal"
fieldIdentityMergePreferred : (left: Maybe String) -> (right: Maybe String) -> a
fieldIdentityMergePreferred left right =
  case left of
    Just l ->
      case right of
        Just r -> if eq l r then { ok = true, preferred = Just l } else { ok = false, preferred = Nothing }
        Nothing -> { ok = true, preferred = Just l }
    Nothing -> { ok = true, preferred = right }

@category "engine-internal"
fieldIdentityMergeRequestGroupStep : (state: a) -> (request: FieldLockRequest) -> a
fieldIdentityMergeRequestGroupStep state request =
  case state.error of
    Just err -> state
    Nothing ->
      let merged = fieldIdentityMergePreferred state.preferred request.preferredId
      if merged.ok
      then { preferred = merged.preferred, error = Nothing }
      else { preferred = state.preferred, error = Just (ConflictingFieldLockRequest {
          message = concat "field-identity: conflicting preferred UUIDs for \"" (concat request.name "\""),
          lockName = request.name
        }) }

@category "engine-internal"
fieldIdentityRequestGroupPlan : (entry: a) -> a
fieldIdentityRequestGroupPlan entry =
  let merged = fold fieldIdentityMergeRequestGroupStep { preferred = Nothing, error = Nothing } entry.value
  {
    request = FieldLockRequest { name = entry.key, preferredId = merged.preferred },
    error = merged.error
  }

@category "engine-internal"
fieldIdentityRequestPlanHasError : (plan: a) -> Boolean
fieldIdentityRequestPlanHasError plan =
  case plan.error of
    Just err -> true
    Nothing -> false

@category "engine-internal"
fieldIdentityRequestPlanRequest : (plan: a) -> FieldLockRequest
fieldIdentityRequestPlanRequest plan = plan.request

@category "engine-internal"
fieldIdentityBuildLockRequests : (occurrences: List ResolvedFieldOccurrence) -> a
fieldIdentityBuildLockRequests occurrences =
  let collected = flatMap fieldIdentityOccurrenceRequests occurrences
  let sorted = fieldIdentitySortStringKeys (\request -> request.name) collected
  let grouped = entries (groupBy (\request -> request.name) sorted)
  let plans = map fieldIdentityRequestGroupPlan grouped
  case find fieldIdentityRequestPlanHasError plans of
    Just failed -> { requests = [], error = failed.error }
    Nothing -> { requests = map fieldIdentityRequestPlanRequest plans, error = Nothing }

@category "engine-internal"
fieldIdentityNeedKey : (need: FieldIdentityNeed) -> String
fieldIdentityNeedKey need =
  case need of
    NeedsMint { owner = owner, path = path } -> fieldIdentityQualifiedName owner path

-- -------------------------------------------------------------------------
-- Public registry-independent collection / normalization entry
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityStagedFailure : (error: FieldIdentityError) -> a
fieldIdentityStagedFailure error = { result = Err error, facts = {} }

-- The kernel's stages in their fixed order, returning the result together with
-- the facts each stage computed (empty on a refusal). S2's base retains these
-- facts; `collectFieldIdentitiesKernel` is exactly this function's result.
@label "Collect field identities (staged)"
@description "The Fenel-native field identity kernel with its stage facts: the same stages in the same order as collectFieldIdentitiesKernel, whose result is this function's `result`. On success `facts` holds the deduplicated roots, the lock/kind/external indexes, the nominal indexes, each root's walk state, the merged walk, the normalization context and the normalized occurrences."
@tags "engine" "field-identity" "kernel" "normalization" "s2"
collectFieldIdentitiesStaged : (input: FieldIdentityCollectInput) -> a
collectFieldIdentitiesStaged input =
  case fieldIdentityValidateLockEntries input.lockEntries of
    Just err -> fieldIdentityStagedFailure err
    Nothing ->
      case fieldIdentityNominalRootsParamsError input.roots of
        Just err -> fieldIdentityStagedFailure err
        Nothing ->
          let dedupedRoots = fieldIdentityUniqueRoots input.roots
          case dedupedRoots.error of
            Just err -> fieldIdentityStagedFailure err
            Nothing ->
              let lockIndex = fieldIdentityLockIndex input.lockEntries
              let kindIndex = fieldIdentityKindIndex input.identityKinds
              let externalIndex = fieldIdentityExternalIndex input.externalFields
              let duplicateAttachments = fieldIdentityDuplicateRootAttachments dedupedRoots.duplicates dedupedRoots.roots input.mode lockIndex
              case duplicateAttachments.error of
                Just err -> fieldIdentityStagedFailure err
                Nothing ->
                  let walkStage = fieldIdentityWalkRootsStaged dedupedRoots.roots input.mode lockIndex kindIndex externalIndex
                  let walked = walkStage.merged
                  case walked.error of
                    Just err -> fieldIdentityStagedFailure err
                    Nothing ->
                      case fieldIdentityCheckPaths walked.occurrences of
                        Just err -> fieldIdentityStagedFailure err
                        Nothing ->
                          let normalizationContext = fieldIdentityNormalizationContext walked.occurrences kindIndex externalIndex
                          let normalized = fieldIdentityNormalizeWithContext normalizationContext walked.occurrences
                          case normalized.error of
                            Just err -> fieldIdentityStagedFailure err
                            Nothing ->
                              case fieldIdentityCheckContainerDuplicates normalized.occurrences of
                                Just err -> fieldIdentityStagedFailure err
                                Nothing ->
                                  case fieldIdentityCheckCodeables normalized.occurrences externalIndex input.mutableExternalCodeables of
                                    Just err -> fieldIdentityStagedFailure err
                                    Nothing ->
                                      let requestResult = fieldIdentityBuildLockRequests normalized.occurrences
                                      case requestResult.error of
                                        Just err -> fieldIdentityStagedFailure err
                                        Nothing ->
                                          let orderedOccurrences = fieldIdentitySortStringKeys (\occurrence -> occurrence.qualifiedName) normalized.occurrences
                                          let entities = fieldIdentityBuildEntities orderedOccurrences externalIndex
                                          let needs = fieldIdentitySortStringKeys fieldIdentityNeedKey walked.needsMint
                                          {
                                            result = Ok (FieldIdentityCollection {
                                              occurrences = orderedOccurrences,
                                              entities = entities,
                                              lockRequests = requestResult.requests,
                                              needsMint = needs,
                                              attachments = concat walked.attachments duplicateAttachments.attachments
                                            }),
                                            facts = {
                                              dedupedRoots = dedupedRoots,
                                              lockIndex = lockIndex,
                                              kindIndex = kindIndex,
                                              externalIndex = externalIndex,
                                              duplicateAttachments = duplicateAttachments.attachments,
                                              nominalIndexes = walkStage.nominalIndexes,
                                              walkedRoots = walkStage.perRoot,
                                              walked = walked,
                                              normalizationContext = normalizationContext,
                                              normalized = normalized.occurrences
                                            }
                                          }

@label "Collect field identities"
@description "Fenel-native field identity kernel. Accepts typed declaration roots with explicit realm/mode, the physical/embedded lock view, external live fields, and an identity-kind index; returns structured errors or a complete deterministic occurrence/entity/lock projection."
@tags "engine" "field-identity" "kernel" "normalization" "phase-2a"
collectFieldIdentitiesKernel : (input: FieldIdentityCollectInput) -> Result FieldIdentityError FieldIdentityCollection
collectFieldIdentitiesKernel input =
  let staged = collectFieldIdentitiesStaged input
  staged.result

@label "Normalize field declarations"
@description "Registry-independent alias of collectFieldIdentitiesKernel for account/draft validation before insertion into a ModuleRegistry."
@tags "engine" "field-identity" "validation" "phase-2a"
normalizeFieldDeclarations : (input: FieldIdentityCollectInput) -> Result FieldIdentityError FieldIdentityCollection
normalizeFieldDeclarations input = collectFieldIdentitiesKernel input

-- -------------------------------------------------------------------------
-- Base + delta collection (S2, 2026-10-23)
--
-- A Local or account registry build differs from the repository build only by
-- a few non-repository roots placed after the repository module roots. The
-- base is the ordinary staged kernel run over exactly the repository roots,
-- retained with the stage facts the kernel computed on the way. The delta
-- walks and normalizes only the new roots against those facts and merges the
-- results into the base collection.
--
-- `collectFieldIdentitiesKernel` remains the specification: the delta returns
-- `DeltaCollected c` only when every guard below proves that the monolithic
-- kernel over the whole root list would return `Ok c`. Every other case,
-- including any delta-side error, is `DeltaFallback reason`, and the caller
-- runs the monolithic kernel, which then decides and reports. The delta never
-- produces a diagnostic. Ledger row: design/tcb-ledger.md `fi.kernel.delta`.
--
-- Why the guards suffice (stage by stage, R_b = base roots, D = delta roots):
--   S0 lock: the host reports every lock row that differs from the base lock;
--      any difference falls back.
--   S1/S2 params and dedup: D is checked alone; a D owner key that is a base
--      owner key, or a duplicate inside D, falls back.
--   S4/S5 walks: a base walk reads the nominal indexes only by the TtOpaque
--      names of base declarations and by base module names. A D type root
--      whose name is such a name or is already a base type-root name, or a D
--      root in a base module, falls back; so every base walk and duplicate
--      proof resolves exactly as it did, and D walks see the merged indexes
--      the monolithic walk would build.
--   S6 paths, S8 containers: keys are checked inside D and against the base.
--   S7 normalization: D roots are non-repository, so they never declare an
--      entity before normalization and the declaring index is the base's. A
--      base occurrence can change only through a kind entry for one of its
--      handles, or an external field for a handle the base promoted as
--      unclaimed; both fall back. A kind removed since the base is checked
--      against every base and D handle.
--   S9 codeables: the check is per handle group, so only groups that gained an
--      occurrence or an external field are rechecked.
--   S10 lock requests, needs: D occurrences carry none (else fallback).
--   S11 assembly: sorted merges by the same keys and comparison the kernel's
--      stable sort uses (keys are unique by S6 and by entity handle); touched
--      entity groups are rebuilt with the kernel's own group function; walk
--      attachments are spliced at the root split.
-- -------------------------------------------------------------------------

FieldIdentityBase = FieldIdentityBase collection: FieldIdentityCollection facts: a

FieldIdentityDeltaInput = FieldIdentityDeltaInput roots: List FieldDeclarationRoot split: Nat mode: FieldIdentityMode lockChanges: List String identityKinds: IdentityKindIndex removedKinds: List String externalFields: ExternalFieldCatalog mutableExternalCodeables: List FieldRef

FieldIdentityDeltaReason =
  DeltaModeNotStrict
  | DeltaBaseNotStrict
  | DeltaMutableCodeables
  | DeltaLockChanged
  | DeltaSplitChanged
  | DeltaRepositoryRoot
  | DeltaTypeRootWithoutModule
  | DeltaRootParams
  | DeltaRootDuplicates
  | DeltaOwnerCollision
  | DeltaModuleCollision
  | DeltaNominalCollision
  | DeltaWalkFailed
  | DeltaNeedsMint
  | DeltaLockRequest
  | DeltaDeclaration
  | DeltaPathCollision
  | DeltaKindsTouchBase
  | DeltaExternalTouchesPromotion
  | DeltaNormalizationFailed
  | DeltaKindsTouchDelta
  | DeltaContainerCollision
  | DeltaCodeableConflict

FieldIdentityDeltaOutcome =
  DeltaCollected collection: FieldIdentityCollection
  | DeltaFallback reason: FieldIdentityDeltaReason

@category "engine-internal"
fieldIdentityAnyOf : (items: List a) -> (pred: (a -> Boolean)) -> Boolean
fieldIdentityAnyOf items pred =
  case find pred items of
    Just found -> true
    Nothing -> false

@category "engine-internal"
fieldIdentityMaybeIsJust : (value: Maybe a) -> Boolean
fieldIdentityMaybeIsJust value =
  case value of
    Just present -> true
    Nothing -> false

@category "engine-internal"
fieldIdentityIndexHas : (index: a) -> (name: String) -> Boolean
fieldIdentityIndexHas index name =
  case mapGet index name of
    Just present -> true
    Nothing -> false

@category "engine-internal"
fieldIdentityKeySet : (names: List String) -> a
fieldIdentityKeySet names =
  fromEntries (map (\name -> { key = name, value = true }) names)

@category "engine-internal"
fieldIdentityUniqueKeys : (names: List String) -> List String
fieldIdentityUniqueKeys names =
  map (\entry -> entry.key) (entries (fieldIdentityKeySet names))

@category "engine-internal"
fieldIdentityOccurrenceHandleList : (occurrence: ResolvedFieldOccurrence) -> List String
fieldIdentityOccurrenceHandleList occurrence =
  case fieldIdentityOccurrenceHandle occurrence of
    Just handle -> [handle]
    Nothing -> []

@category "engine-internal"
fieldIdentityOccurrenceQualifiedName : (occurrence: ResolvedFieldOccurrence) -> String
fieldIdentityOccurrenceQualifiedName occurrence = occurrence.qualifiedName

@category "engine-internal"
fieldIdentityEntityHandle : (entity: FieldEntity) -> String
fieldIdentityEntityHandle entity = entity.id.handle

@category "engine-internal"
fieldIdentityRootModuleList : (root: FieldDeclarationRoot) -> List String
fieldIdentityRootModuleList root =
  case fieldIdentityRootModule root of
    Just moduleName -> [moduleName]
    Nothing -> []

@category "engine-internal"
fieldIdentityRootIsRepository : (root: FieldDeclarationRoot) -> Boolean
fieldIdentityRootIsRepository root =
  case fieldIdentityRootRealm root of
    RepositorySource -> true
    AccountAuthored -> false
    TransientDraft -> false
    _ -> true

@category "engine-internal"
fieldIdentityTypeRootWithoutModule : (root: FieldDeclarationRoot) -> Boolean
fieldIdentityTypeRootWithoutModule root =
  case root of
    TypeFieldDeclarationRoot { module = rootModule } ->
      case rootModule of
        Just moduleName -> false
        Nothing -> true
    FunctionFieldDeclarationRoot -> false
    _ -> true

@category "engine-internal"
fieldIdentityModeIsStrict : (mode: FieldIdentityMode) -> Boolean
fieldIdentityModeIsStrict mode =
  case mode of
    StrictEmbedded -> true
    CollectRequirements -> false
    SourceHandles -> false
    _ -> false

@category "engine-internal"
fieldIdentityKindEntries : (index: IdentityKindIndex) -> List IdentityKindEntry
fieldIdentityKindEntries index =
  case index of
    IdentityKindIndex { entries = kindRows } -> kindRows

@category "engine-internal"
fieldIdentityExternalHandles : (catalog: ExternalFieldCatalog) -> List String
fieldIdentityExternalHandles catalog =
  case catalog of
    ExternalFieldCatalog { fields = externalRows } -> map (\entity -> entity.id.handle) externalRows

-- Binary search over a list sorted ascending by `key`, under the order the
-- kernel's stable sort uses for string keys (`lt` on two strings is the host
-- `<`, as is the sort's comparison).
@category "engine-internal"
fieldIdentityLowerBound : (key: (a -> String)) -> (items: List a) -> (target: String) -> (low: Number) -> (high: Number) -> Number
fieldIdentityLowerBound key items target low high =
  if gte low high
  then low
  else
    let middle = floor (div (add low high) 2)
    let probe = key (at items middle)
    if lt probe target
    then fieldIdentityLowerBound key items target (add middle 1) high
    else fieldIdentityLowerBound key items target low middle

-- Insert one item into a list sorted by a key no other item shares (unique
-- by the guards that precede every call), keeping the list sorted.
@category "engine-internal"
fieldIdentityInsertSorted : (key: (a -> String)) -> (items: List a) -> (item: a) -> List a
fieldIdentityInsertSorted key items item =
  let position = fieldIdentityLowerBound key items (key item) 0 (length items)
  concat (take position items) (concat [item] (drop position items))

-- Insert, or replace the item that has the same key.
@category "engine-internal"
fieldIdentityUpsertSorted : (key: (a -> String)) -> (items: List a) -> (item: a) -> List a
fieldIdentityUpsertSorted key items item =
  let target = key item
  let position = fieldIdentityLowerBound key items target 0 (length items)
  if lt position (length items)
  then
    if eq (key (at items position)) target
    then concat (take position items) (concat [item] (drop (add position 1) items))
    else concat (take position items) (concat [item] (drop position items))
  else concat items [item]

-- Every TtOpaque name in a declaration: the only names a field walk or a
-- duplicate/specialization proof looks up in the nominal indexes.
@category "engine-internal"
fieldIdentityTypeOpaqueNames : (node: TraversalType) -> List String
fieldIdentityTypeOpaqueNames node =
  case node of
    TtOpaque { pure = pure, name = name } -> concat [name] (fieldIdentityTypeOpaqueNames pure)
    TtRecord { fields = fields } -> fieldIdentityFieldsOpaqueNames fields
    TtVariant { cases = cases } -> flatMap (\variantCase -> fieldIdentityFieldsOpaqueNames variantCase.fields) cases
    TtTuple { items = items } -> flatMap fieldIdentityTypeOpaqueNames items
    TtMap { values = values } -> fieldIdentityTypeOpaqueNames values
    TtApp { args = args } -> flatMap fieldIdentityTypeOpaqueNames args
    TtRefined { base = refinedBase } -> fieldIdentityTypeOpaqueNames refinedBase
    TtMu { body = body } -> fieldIdentityTypeOpaqueNames body
    TtTagged { value = value, phantom = phantom } -> concat (fieldIdentityTypeOpaqueNames value) (fieldIdentityTypeOpaqueNames phantom)
    TtArrow { params = params, returns = returns } -> concat (fieldIdentityFieldsOpaqueNames params) (fieldIdentityTypeOpaqueNames returns)
    TtUnion { branches = branches } -> flatMap fieldIdentityTypeOpaqueNames branches
    TtIntersect { branches = branches } -> flatMap fieldIdentityTypeOpaqueNames branches
    TtComplement { inner = inner } -> fieldIdentityTypeOpaqueNames inner
    _ -> []

@category "engine-internal"
fieldIdentityFieldsOpaqueNames : (fields: List a) -> List String
fieldIdentityFieldsOpaqueNames fields =
  flatMap (\field -> fieldIdentityTypeOpaqueNames field.type) fields

@category "engine-internal"
fieldIdentityRootOpaqueNames : (root: FieldDeclarationRoot) -> List String
fieldIdentityRootOpaqueNames root =
  case root of
    TypeFieldDeclarationRoot { declaration = declaration } -> fieldIdentityTypeOpaqueNames declaration
    FunctionFieldDeclarationRoot { params = params, returns = returns } ->
      concat (fieldIdentityFieldsOpaqueNames params) (fieldIdentityTypeOpaqueNames returns)

-- The handles a base occurrence may have claimed as unclaimed UUIDs: a
-- declaring result whose handle no walked occurrence declared. Only these can
-- change when an external field appears (normalization then keeps the
-- occurrence non-declaring instead).
@category "engine-internal"
fieldIdentityPromotedHandles : (declaringIndex: a) -> (occurrence: ResolvedFieldOccurrence) -> List String
fieldIdentityPromotedHandles declaringIndex occurrence =
  if not occurrence.declaresEntity
  then []
  else if fieldIdentityIndexHas declaringIndex (fieldIdentityOccurrenceHandleOrEmpty occurrence)
  then []
  else fieldIdentityOccurrenceHandleList occurrence

@category "engine-internal"
fieldIdentityBaseFromStaged : (input: FieldIdentityCollectInput) -> (rootSplit: Nat) -> (baseCollection: FieldIdentityCollection) -> (stagedFacts: a) -> FieldIdentityBase
fieldIdentityBaseFromStaged input rootSplit baseCollection stagedFacts =
  let beforeKeys = fieldIdentityKeySet (map fieldIdentityRootOwnerIndexKey (take rootSplit input.roots))
  let dedupedBefore = takeWhile (\root -> fieldIdentityIndexHas beforeKeys (fieldIdentityRootOwnerIndexKey root)) stagedFacts.dedupedRoots.roots
  let dedupedSplit = length dedupedBefore
  let attachmentsBefore = sum (map (\state -> length state.attachments) (take dedupedSplit stagedFacts.walkedRoots))
  let walkedOccurrences = stagedFacts.walked.occurrences
  let normalizedOccurrences = stagedFacts.normalized
  let declaringIndex = stagedFacts.normalizationContext.declaringIndex
  let baseHandles = concat (flatMap fieldIdentityOccurrenceHandleList walkedOccurrences) (flatMap fieldIdentityOccurrenceHandleList normalizedOccurrences)
  FieldIdentityBase {
    collection = baseCollection,
    facts = {
      mode = input.mode,
      split = rootSplit,
      dedupedSplit = dedupedSplit,
      walkAttachmentsBefore = attachmentsBefore,
      walkAttachmentCount = length stagedFacts.walked.attachments,
      ownerKeys = fieldIdentityKeySet (map fieldIdentityRootOwnerIndexKey input.roots),
      moduleNames = fieldIdentityKeySet (flatMap fieldIdentityRootModuleList input.roots),
      nominalIndexes = stagedFacts.nominalIndexes,
      opaqueNames = fieldIdentityKeySet (flatMap fieldIdentityRootOpaqueNames input.roots),
      lockIndex = stagedFacts.lockIndex,
      kindIndex = stagedFacts.kindIndex,
      occurrenceIndex = stagedFacts.normalizationContext.occurrenceIndex,
      declaringIndex = declaringIndex,
      handles = fieldIdentityKeySet baseHandles,
      promoted = fieldIdentityKeySet (flatMap (fieldIdentityPromotedHandles declaringIndex) normalizedOccurrences),
      containerKeys = fieldIdentityKeySet (map fieldIdentityContainerIdentityKey normalizedOccurrences),
      entityIndex = fromEntries (map (\entity -> { key = entity.id.handle, value = entity }) baseCollection.entities)
    }
  }

@label "Collect field identity base"
@description "Run the staged field identity kernel over the repository roots of a build and keep its result with the stage facts a later delta needs. `split` is the number of input roots before the place where delta roots sit in the full build. The collection is exactly collectFieldIdentitiesKernel's."
@tags "engine" "field-identity" "kernel" "delta" "s2"
collectFieldIdentitiesBase : (input: FieldIdentityCollectInput) -> (split: Nat) -> Result FieldIdentityError FieldIdentityBase
collectFieldIdentitiesBase input split =
  let staged = collectFieldIdentitiesStaged input
  case staged.result of
    Err err -> Err err
    Ok baseCollection -> Ok (fieldIdentityBaseFromStaged input split baseCollection staged.facts)

@category "engine-internal"
fieldIdentityDeltaFallback : (why: FieldIdentityDeltaReason) -> FieldIdentityDeltaOutcome
fieldIdentityDeltaFallback why = DeltaFallback { reason = why }

@category "engine-internal"
fieldIdentityDeltaNominalCollides : (facts: a) -> (root: FieldDeclarationRoot) -> Boolean
fieldIdentityDeltaNominalCollides facts root =
  if fieldIdentityIndexHas facts.nominalIndexes.byName (fieldIdentityTypeRootNameIndexKey root)
  then true
  else fieldIdentityIndexHas facts.opaqueNames (fieldIdentityTypeRootName root)

@category "engine-internal"
fieldIdentityBaseEntityOccurrences : (facts: a) -> (handle: String) -> List ResolvedFieldOccurrence
fieldIdentityBaseEntityOccurrences facts handle =
  case mapGet facts.entityIndex handle of
    Just entity -> entity.occurrences
    Nothing -> []

-- One handle's occurrences in the merged result, in qualified-name order: the
-- order the kernel's handle grouping keeps after its qualified-name sort.
@category "engine-internal"
fieldIdentityDeltaGroup : (facts: a) -> (sortedDelta: List ResolvedFieldOccurrence) -> (handle: String) -> List ResolvedFieldOccurrence
fieldIdentityDeltaGroup facts sortedDelta handle =
  let baseOccurrences = fieldIdentityBaseEntityOccurrences facts handle
  let deltaGroup = filter (\occurrence -> eq (fieldIdentityOccurrenceHandleOrEmpty occurrence) handle) sortedDelta
  fold (fieldIdentityInsertSorted fieldIdentityOccurrenceQualifiedName) baseOccurrences deltaGroup

@category "engine-internal"
fieldIdentityDeltaAssemble : (baseCollection: FieldIdentityCollection) -> (facts: a) -> (input: FieldIdentityDeltaInput) -> (externalIndex: a) -> (externalHandles: List String) -> (normalized: List ResolvedFieldOccurrence) -> (deltaAttachments: List FieldIdentityAttachment) -> FieldIdentityDeltaOutcome
fieldIdentityDeltaAssemble baseCollection facts input externalIndex externalHandles normalized deltaAttachments =
  let deltaHandles = flatMap fieldIdentityOccurrenceHandleList normalized
  let touchedExternal = filter (\handle -> fieldIdentityIndexHas facts.entityIndex handle) externalHandles
  let touched = fieldIdentityUniqueKeys (concat deltaHandles touchedExternal)
  let sortedDelta = sort (\occurrence -> occurrence.qualifiedName) normalized
  let groupOccurrences = flatMap (fieldIdentityDeltaGroup facts sortedDelta) touched
  case fieldIdentityCheckCodeables groupOccurrences externalIndex input.mutableExternalCodeables of
    Just err -> fieldIdentityDeltaFallback DeltaCodeableConflict
    Nothing ->
      let mergedOccurrences = fold (fieldIdentityInsertSorted fieldIdentityOccurrenceQualifiedName) baseCollection.occurrences sortedDelta
      let rebuilt = flatMap (\handle -> fieldIdentityEntitiesFromGroup externalIndex { key = handle, value = fieldIdentityDeltaGroup facts sortedDelta handle }) touched
      let mergedEntities = fold (fieldIdentityUpsertSorted fieldIdentityEntityHandle) baseCollection.entities rebuilt
      let baseWalk = take facts.walkAttachmentCount baseCollection.attachments
      let baseDuplicates = drop facts.walkAttachmentCount baseCollection.attachments
      let walkAttachments = concat (take facts.walkAttachmentsBefore baseWalk) (concat deltaAttachments (drop facts.walkAttachmentsBefore baseWalk))
      DeltaCollected {
        collection = FieldIdentityCollection {
          occurrences = mergedOccurrences,
          entities = mergedEntities,
          lockRequests = baseCollection.lockRequests,
          needsMint = baseCollection.needsMint,
          attachments = concat walkAttachments baseDuplicates
        }
      }

@category "engine-internal"
fieldIdentityDeltaNormalize : (baseCollection: FieldIdentityCollection) -> (facts: a) -> (input: FieldIdentityDeltaInput) -> (mergedKindIndex: a) -> (externalIndex: a) -> (deltaOccurrences: List ResolvedFieldOccurrence) -> (deltaAttachments: List FieldIdentityAttachment) -> FieldIdentityDeltaOutcome
fieldIdentityDeltaNormalize baseCollection facts input mergedKindIndex externalIndex deltaOccurrences deltaAttachments =
  if fieldIdentityAnyOf (fieldIdentityKindEntries input.identityKinds) (\entry -> fieldIdentityIndexHas facts.handles entry.handle)
  then fieldIdentityDeltaFallback DeltaKindsTouchBase
  else if fieldIdentityAnyOf input.removedKinds (\handle -> fieldIdentityIndexHas facts.handles handle)
  then fieldIdentityDeltaFallback DeltaKindsTouchBase
  else
    let externalHandles = fieldIdentityExternalHandles input.externalFields
    if fieldIdentityAnyOf externalHandles (\handle -> fieldIdentityIndexHas facts.promoted handle)
    then fieldIdentityDeltaFallback DeltaExternalTouchesPromotion
    else
      let deltaOccurrenceIndex = fieldIdentityOccurrenceIndex deltaOccurrences
      let context = {
        occurrenceIndex = mergeRecords facts.occurrenceIndex deltaOccurrenceIndex,
        declaringIndex = facts.declaringIndex,
        kindIndex = mergedKindIndex,
        externalIndex = externalIndex
      }
      let results = map (fieldIdentityNormalizeOccurrence context) deltaOccurrences
      if fieldIdentityAnyOf results (\result -> not (fieldIdentityNormalizationSucceeded result))
      then fieldIdentityDeltaFallback DeltaNormalizationFailed
      else
        let normalized = map fieldIdentityNormalizationValue results
        let removed = fieldIdentityKeySet input.removedKinds
        let deltaHandles = concat (flatMap fieldIdentityOccurrenceHandleList deltaOccurrences) (flatMap fieldIdentityOccurrenceHandleList normalized)
        if fieldIdentityAnyOf deltaHandles (\handle -> fieldIdentityIndexHas removed handle)
        then fieldIdentityDeltaFallback DeltaKindsTouchDelta
        else if fieldIdentityAnyOf normalized (\occurrence -> fieldIdentityIndexHas facts.containerKeys (fieldIdentityContainerIdentityKey occurrence))
        then fieldIdentityDeltaFallback DeltaContainerCollision
        else
          case fieldIdentityCheckContainerDuplicates normalized of
            Just err -> fieldIdentityDeltaFallback DeltaContainerCollision
            Nothing -> fieldIdentityDeltaAssemble baseCollection facts input externalIndex externalHandles normalized deltaAttachments

@category "engine-internal"
fieldIdentityDeltaWalk : (baseCollection: FieldIdentityCollection) -> (facts: a) -> (input: FieldIdentityDeltaInput) -> (deltaRoots: List FieldDeclarationRoot) -> FieldIdentityDeltaOutcome
fieldIdentityDeltaWalk baseCollection facts input deltaRoots =
  let deltaIndexes = fieldIdentityNominalRootIndexes deltaRoots
  let mergedIndexes = {
    byName = mergeRecords facts.nominalIndexes.byName deltaIndexes.byName,
    byModuleName = mergeRecords facts.nominalIndexes.byModuleName deltaIndexes.byModuleName
  }
  -- The same context fields the monolithic walk gets: the merged nominal and
  -- kind indexes and this build's external index (no walk step reads the kind
  -- or external index today; normalization below reuses both).
  let mergedKindIndex = mergeRecords facts.kindIndex (fieldIdentityKindIndex input.identityKinds)
  let externalIndex = fieldIdentityExternalIndex input.externalFields
  let context = {
    roots = deltaRoots,
    nominalIndexes = mergedIndexes,
    mode = input.mode,
    lockIndex = facts.lockIndex,
    kindIndex = mergedKindIndex,
    externalIndex = externalIndex
  }
  let walkedStates = map (fieldIdentityWalkOneRoot context) deltaRoots
  if fieldIdentityAnyOf walkedStates fieldIdentityWalkStateHasError
  then fieldIdentityDeltaFallback DeltaWalkFailed
  else
    let deltaOccurrences = flatMap (\state -> state.occurrences) walkedStates
    let deltaAttachments = flatMap (\state -> state.attachments) walkedStates
    let deltaNeeds = flatMap (\state -> state.needsMint) walkedStates
    if gt (length deltaNeeds) 0
    then fieldIdentityDeltaFallback DeltaNeedsMint
    else if fieldIdentityAnyOf deltaOccurrences (\occurrence -> fieldIdentityMaybeIsJust occurrence.lockRequest)
    then fieldIdentityDeltaFallback DeltaLockRequest
    else if fieldIdentityAnyOf deltaOccurrences (\occurrence -> occurrence.declaresEntity)
    then fieldIdentityDeltaFallback DeltaDeclaration
    else if fieldIdentityAnyOf deltaOccurrences (\occurrence -> fieldIdentityIndexHas facts.occurrenceIndex occurrence.qualifiedName)
    then fieldIdentityDeltaFallback DeltaPathCollision
    else
      case fieldIdentityCheckPaths deltaOccurrences of
        Just err -> fieldIdentityDeltaFallback DeltaPathCollision
        Nothing -> fieldIdentityDeltaNormalize baseCollection facts input mergedKindIndex externalIndex deltaOccurrences deltaAttachments

@category "engine-internal"
fieldIdentityDeltaRoots : (baseCollection: FieldIdentityCollection) -> (facts: a) -> (input: FieldIdentityDeltaInput) -> FieldIdentityDeltaOutcome
fieldIdentityDeltaRoots baseCollection facts input =
  let deduped = fieldIdentityUniqueRoots input.roots
  if fieldIdentityMaybeIsJust deduped.error
  then fieldIdentityDeltaFallback DeltaRootDuplicates
  else if gt (length deduped.duplicates) 0
  then fieldIdentityDeltaFallback DeltaRootDuplicates
  else if fieldIdentityAnyOf deduped.roots (\root -> fieldIdentityIndexHas facts.ownerKeys (fieldIdentityRootOwnerIndexKey root))
  then fieldIdentityDeltaFallback DeltaOwnerCollision
  else if fieldIdentityAnyOf input.roots (\root -> fieldIdentityAnyOf (fieldIdentityRootModuleList root) (\moduleName -> fieldIdentityIndexHas facts.moduleNames moduleName))
  then fieldIdentityDeltaFallback DeltaModuleCollision
  else if fieldIdentityAnyOf (filter fieldIdentityRootIsType deduped.roots) (fieldIdentityDeltaNominalCollides facts)
  then fieldIdentityDeltaFallback DeltaNominalCollision
  else fieldIdentityDeltaWalk baseCollection facts input deduped.roots

@label "Collect field identities over a base"
@description "Extend a field identity base with non-repository roots. Returns DeltaCollected with exactly the collection collectFieldIdentitiesKernel would return over the base roots plus these roots, or DeltaFallback with the reason the delta does not apply; the caller then runs the monolithic kernel. The delta never reports a diagnostic."
@tags "engine" "field-identity" "kernel" "delta" "s2"
collectFieldIdentitiesDelta : (base: FieldIdentityBase) -> (input: FieldIdentityDeltaInput) -> FieldIdentityDeltaOutcome
collectFieldIdentitiesDelta base input =
  case base of
    FieldIdentityBase { collection = baseCollection, facts = facts } ->
      if not (fieldIdentityModeIsStrict input.mode)
      then fieldIdentityDeltaFallback DeltaModeNotStrict
      else if not (fieldIdentityModeIsStrict facts.mode)
      then fieldIdentityDeltaFallback DeltaBaseNotStrict
      else if gt (length input.mutableExternalCodeables) 0
      then fieldIdentityDeltaFallback DeltaMutableCodeables
      else if gt (length input.lockChanges) 0
      then fieldIdentityDeltaFallback DeltaLockChanged
      else if not (eq input.split facts.split)
      then fieldIdentityDeltaFallback DeltaSplitChanged
      else if fieldIdentityAnyOf input.roots fieldIdentityRootIsRepository
      then fieldIdentityDeltaFallback DeltaRepositoryRoot
      else if fieldIdentityAnyOf input.roots fieldIdentityTypeRootWithoutModule
      then fieldIdentityDeltaFallback DeltaTypeRootWithoutModule
      else
        case fieldIdentityNominalRootsParamsError input.roots of
          Just err -> fieldIdentityDeltaFallback DeltaRootParams
          Nothing -> fieldIdentityDeltaRoots baseCollection facts input

-- -------------------------------------------------------------------------
-- Opaque-body spelling validation
--
-- The host boundary performs only a descriptor-safe syntax walk and supplies
-- inert occurrence/target records.  Resolution posture remains here: exactly
-- one matching registered table is authoritative; an unknown target or a
-- target with multiple tables has no name authority and is therefore lenient.
-- -------------------------------------------------------------------------

@category "engine-internal"
fieldIdentityBodySpellingTargetKind : (occurrenceKind: String) -> String
fieldIdentityBodySpellingTargetKind occurrenceKind =
  if eq occurrenceKind "named-call" then "function" else "constructor"

@category "engine-internal"
fieldIdentityBodySpellingTargetMatches : (occurrence: a) -> (target: a) -> Boolean
fieldIdentityBodySpellingTargetMatches occurrence target =
  and
    (eq target.target occurrence.target)
    (eq target.kind (fieldIdentityBodySpellingTargetKind occurrence.kind))

@category "engine-internal"
fieldIdentityBodySpellingTargets : (occurrence: a) -> (targets: a) -> List a
fieldIdentityBodySpellingTargets occurrence targets =
  let key = concat
        (fieldIdentityBodySpellingTargetKind occurrence.kind)
        (concat "/" occurrence.target)
  let bucket = fromMaybe [] (mapGet targets key)
  filter (fieldIdentityBodySpellingTargetMatches occurrence) bucket

@category "engine-internal"
fieldIdentityBodySpellingMessage : (occurrence: a) -> String
fieldIdentityBodySpellingMessage occurrence =
  let atPath = concat " at " occurrence.path
  let inOwner = concat " in " (concat occurrence.owner atPath)
  let forTarget = concat "\" for " (concat occurrence.target inOwner)
  let quotedSpelling = concat occurrence.spelling forTarget
  let spellingText = concat " field spelling \"" quotedSpelling
  concat "field-identity: unresolved " (concat occurrence.kind spellingText)

@category "engine-internal"
fieldIdentityBodySpellingErrorStep : (targets: a) -> (acc: Maybe FieldIdentityError) -> (occurrence: a) -> Maybe FieldIdentityError
fieldIdentityBodySpellingErrorStep targets acc occurrence =
  case acc of
    Just err -> Just err
    Nothing ->
      let matching = fieldIdentityBodySpellingTargets occurrence targets
      if not (eq (length matching) 1)
      then Nothing
      else
        case head matching of
          Nothing -> Nothing
          Just target ->
            if elem occurrence.spelling target.candidates
            then Nothing
            -- Constructor/call record payloads are source-ambiguous: the
            -- evaluator treats a non-total candidate match as one positional
            -- record argument.  Rejecting a miss here would break `f r` and
            -- `Just r` (including partial-overlap records).  Patterns are the
            -- only syntax whose named fields are unambiguously field
            -- spellings before Phase 5's type-directed classifier.
            else if not (eq occurrence.kind "constructor-pattern")
            then Nothing
            else Just (UnresolvedFieldSpelling {
              message = fieldIdentityBodySpellingMessage occurrence,
              owner = occurrence.owner,
              path = occurrence.path,
              spelling = occurrence.spelling,
              candidates = target.candidates,
              kind = "unresolved"
            })

@category "engine-internal"
fieldIdentityFirstBodySpellingError : (occurrences: List a) -> (targets: List a) -> Maybe FieldIdentityError
fieldIdentityFirstBodySpellingError occurrences targets =
  let targetIndex = groupBy (\target -> concat target.kind (concat "/" target.target)) targets
  fold (fieldIdentityBodySpellingErrorStep targetIndex) Nothing occurrences

@label "Validate body spellings"
@description "Validate one mechanically collected body-spelling batch against supplied constructor/function field tables. A known unambiguous constructor-pattern miss rejects structurally; unknown/ambiguous targets and record payloads that can denote positional arguments remain lenient because there is no unique name authority before Phase 5's type-directed classifier."
@tags "engine" "field-identity" "body" "validation" "phase-4b"
validateBodySpellings : (input: a) -> Result FieldIdentityError a
validateBodySpellings input =
  case fieldIdentityFirstBodySpellingError input.occurrences input.targets of
    Nothing -> Ok input.occurrences
    Just err -> Err err

-- -------------------------------------------------------------------------
-- Compiler constructor authority
--
-- The host enumerates registry rows and marshals each FenelType through the
-- shared TraversalType gateway.  Everything after that mechanical boundary --
-- owner discovery, constructor classification, semantic-profile deduplication,
-- owner scoping/preference, ambiguity and same-owner drift -- is decided here.
-- -------------------------------------------------------------------------

CompilerConstructorCatalogPlan =
  CccInvalid message: String
  | CccReady candidates: a baseCacheKey: String baseEntries: a baseConflicts: a ambiguousCandidates: a

CompilerConstructorCandidateBatch =
  CcbInvalid message: String
  | CcbReady candidates: a

CompilerConstructorProjectionPlan =
  CcpInvalid message: String
  | CcpReady cacheKey: String entries: a conflicts: a

CompilerConstructorProjectionGroup =
  CpgInvalid message: String
  | CpgSkip
  | CpgEntry entry: a resolvedPreference: Boolean
  | CpgConflict name: String

CompilerFunctionTypeOwnersPlan =
  CfopInvalid message: String
  | CfopReady owners: List String

@category "engine-internal"
compilerOwnerIdAdd : (name: String) -> (owners: List String) -> List String
compilerOwnerIdAdd name owners =
  if eq name "" then owners else appendItem name owners

@category "engine-internal"
compilerTypeOwnerIdsFields : (fields: List a) -> (owners: List String) -> List String
compilerTypeOwnerIdsFields fields owners =
  case head fields of
    Nothing -> owners
    Just field -> compilerTypeOwnerIdsFields (tailOr fields) (compilerTypeOwnerIdsInto field.type owners)

@category "engine-internal"
compilerTypeOwnerIdsCases : (cases: List a) -> (owners: List String) -> List String
compilerTypeOwnerIdsCases cases owners =
  case head cases of
    Nothing -> owners
    Just variantCase -> compilerTypeOwnerIdsCases (tailOr cases) (compilerTypeOwnerIdsFields variantCase.fields owners)

@category "engine-internal"
compilerTypeOwnerIdsList : (types: List TraversalType) -> (owners: List String) -> List String
compilerTypeOwnerIdsList types owners =
  case head types of
    Nothing -> owners
    Just t -> compilerTypeOwnerIdsList (tailOr types) (compilerTypeOwnerIdsInto t owners)

@category "engine-internal"
compilerTypeOwnerIdsInto : (t: TraversalType) -> (owners: List String) -> List String
compilerTypeOwnerIdsInto t owners =
  case t of
    TtNamed { name = name } -> compilerOwnerIdAdd name owners
    TtOpaque { name = name, pure = pure } ->
      compilerTypeOwnerIdsInto pure (compilerOwnerIdAdd name owners)
    TtRecord { fields = fields } -> compilerTypeOwnerIdsFields fields owners
    TtVariant { cases = cases } -> compilerTypeOwnerIdsCases cases owners
    TtTuple { items = items } -> compilerTypeOwnerIdsList items owners
    TtMap { values = values } -> compilerTypeOwnerIdsInto values owners
    TtApp { head = appHead, args = args } ->
      compilerTypeOwnerIdsList args (compilerOwnerIdAdd appHead owners)
    TtRefined { base = base } -> compilerTypeOwnerIdsInto base owners
    TtMu { body = body } -> compilerTypeOwnerIdsInto body owners
    TtTagged { value = value, phantom = phantom } ->
      compilerTypeOwnerIdsInto phantom (compilerTypeOwnerIdsInto value owners)
    TtArrow { params = params, returns = returns } ->
      compilerTypeOwnerIdsInto returns (compilerTypeOwnerIdsFields params owners)
    TtUnion { branches = branches } -> compilerTypeOwnerIdsList branches owners
    TtIntersect { branches = branches } -> compilerTypeOwnerIdsList branches owners
    TtComplement { inner = inner } -> compilerTypeOwnerIdsInto inner owners
    other -> owners

@category "engine-internal"
compilerFunctionTypesSemanticSlotsError : (types: List TraversalType) -> Maybe String
compilerFunctionTypesSemanticSlotsError types =
  case head types of
    Nothing -> Nothing
    Just t -> case traversalSemanticSlotsErrorWithSourceHandles t of
      Just message -> Just message
      Nothing -> compilerFunctionTypesSemanticSlotsError (tailOr types)

@label "Compiler function type owners"
@description "Validate the complete function-boundary TraversalType forest, then collect the canonical semantic owner ids explicitly named in type positions. Applied-type heads and their arguments are both visible; field keys, raw payloads, presentation metadata and SetExprs are deliberately invisible."
@tags "engine" "compiler" "field-identity" "owner" "phase-3"
compilerFunctionTypeOwnerIds : (types: List TraversalType) -> CompilerFunctionTypeOwnersPlan
compilerFunctionTypeOwnerIds types =
  case compilerFunctionTypesSemanticSlotsError types of
    Just message -> CfopInvalid { message = concat "compiler function type owners: invalid semantic slots: " message }
    Nothing -> CfopReady { owners = sort (\owner -> owner) (unique (compilerTypeOwnerIdsList types [])) }

@category "engine-internal"
compilerConstructorFieldViews : (fields: List a) -> (slots: List a) -> (markers: List a) -> a
compilerConstructorFieldViews fields slots markers =
  case head fields of
    Nothing -> { slots = slots, markers = markers }
    Just field ->
      let slot = { key = field.semanticKey, wireName = field.wireName, type = field.raw }
      let marker = { key = field.semanticKey, wireName = field.wireName, type = field.type }
      compilerConstructorFieldViews
        (tailOr fields)
        (appendItem slot slots)
        (appendItem marker markers)

@category "engine-internal"
compilerConstructorFunctionKey : Maybe String -> String -> String -> Maybe String
compilerConstructorFunctionKey ownerModule ownerId name =
  case ownerModule of
    Nothing -> Nothing
    Just namespace -> Just (concat namespace (concat "." (concat ownerId (concat "." name))))

@category "engine-internal"
compilerConstructorFunctionChoice : Maybe String -> Maybe String -> Result String (Maybe String)
compilerConstructorFunctionChoice retained locked =
  case retained of
    Nothing -> case locked of
      Nothing -> Ok Nothing
      Just identity -> if isUuid identity then Ok (Just identity) else Err "constructor Function lock identity must be a UUID"
    Just identity ->
      if not (isUuid identity) then Err "constructor Function reference must retain a UUID"
      else case locked of
        Nothing -> Ok (Just identity)
        Just expected ->
          if eq identity expected then Ok (Just identity)
          else Err "constructor Function reference disagrees with its physical declaration identity"

@category "engine-internal"
compilerConstructorFunctionKind : Maybe String -> Maybe String -> Result String (Maybe String)
compilerConstructorFunctionKind identity kind =
  case identity of
    Nothing -> Ok Nothing
    Just value -> case kind of
      Nothing -> Ok Nothing
      Just actual -> if eq actual "function" then Ok (Just value) else Err "constructor identity is not an ordinary Function identity"

@category "engine-internal"
constructorFunctionLockRequirements : List a -> List String -> List String
constructorFunctionLockRequirements candidates ordinary =
  let keys = flatMap (\candidate -> case lookup candidate "functionKey" of
    Nothing -> []
    Just key -> [key]) candidates
  let identities = flatMap (\candidate -> case lookup candidate "functionId" of
    Nothing -> []
    Just id -> [id]) candidates
  unique (concat keys (filter (\id -> not (elem id identities)) ordinary))

@category "engine-internal"
localConstructorFunctionAction : (row: a) -> (functionIds: List String) -> Result String ({ mint: Boolean, row: a })
localConstructorFunctionAction row functionIds =
  case row.retained of
    Nothing -> Ok { mint = true, row = row }
    Just id ->
      if not (isUuid id) then Err "constructor Function Ref must hold a UUID"
      else if eq id row.ownerId then Err "constructor Function identity cannot reuse its type identity"
      else if not (elem id functionIds) then Err "constructor Function Ref has no ordinary Function owner"
      else if and (elem id row.currentFunctions) (not (elem id row.priorFunctions))
        then Err "constructor Function identity already belongs to another occurrence"
      else Ok { mint = false, row = row }

@category "engine-internal"
localConstructorFunctionActions : List a -> List String -> Result String (List ({ mint: Boolean, row: a }))
localConstructorFunctionActions rows functionIds =
  fold (\state row -> case state of
    Err message -> Err message
    Ok actions -> case localConstructorFunctionAction row functionIds of
      Err message -> Err message
      Ok action -> Ok (appendItem action actions)) (Ok []) rows

@category "engine-internal"
localConstructorSelectedOwners : List ({ kind: String, ownerKey: String, ownerKind: String }) -> List String
localConstructorSelectedOwners mutations =
  flatMap (\mutation -> if and (eq mutation.kind "upsert") (eq mutation.ownerKind "type")
    then [mutation.ownerKey] else []) mutations

@category "engine-internal"
localConstructorRetainedChoice : String -> Maybe String -> Maybe String -> Result String (Maybe String)
localConstructorRetainedChoice kind desired retained =
  let prior = if eq kind "record" then retained else Nothing
  case desired of
    Nothing -> Ok prior
    Just identity -> case prior of
      Nothing -> Ok desired
      Just expected -> if eq identity expected then Ok desired else Err "constructor occurrence cannot replace its held Function identity"

@category "engine-internal"
localConstructorFunctionOwnerMetadata : String -> { ownerKey: String, kind: String, storageName: String }
localConstructorFunctionOwnerMetadata id =
  { ownerKey = fieldAuthoringCanonicalOwnerKey "function" id, kind = "function", storageName = id }

@category "engine-internal"
localConstructorMintIdentity : String -> List String -> Result String String
localConstructorMintIdentity id held =
  if not (isUuid id) then Err "constructor Function allocation must return a UUID"
  else if elem id held then Err "constructor Function allocation collided with a held identity"
  else Ok id

-- Definition declarations own their identities; references and reusable Field
-- occurrences do not. The host observes the canonical repository-only kind
-- map (including tombstones), then this admission rejects the first authored
-- declaration which would replace any reservation, even one of the same kind.
@category "engine-internal"
admitOwnedDefinitionIdentities : List ({ handle: String, repositoryKind: Maybe String }) -> Result FieldIdentityError Bool
admitOwnedDefinitionIdentities identities =
  fold (\state identity -> case state of
    Err error -> Err error
    Ok _ -> case identity.repositoryKind of
      Nothing -> Ok true
      Just kind -> Err (ReservedDefinitionIdentity { message = concat "Authored definition id is reserved by the repository: " identity.handle, handle = identity.handle, repositoryKind = kind })) (Ok true) identities

@category "engine-internal"
fieldOwnedDefinitionIdentityKinds : List FieldOwnerDefinition -> List ({ handle: String, kind: String })
fieldOwnedDefinitionIdentityKinds owners =
  flatMap (\owner -> if isUuid owner.definition.id
    then [{ handle = owner.definition.id, kind = owner.kind }] else []) owners

-- F0 (2026-11-01): a Local definition's id is its identity, a generated UUID;
-- its name is an optional Codeable projection of that identity. A Local id
-- spelled like a word can meet a name that repository bodies read (effect
-- inference reads a dotless variable as a possible callee), so a Local
-- `value` calling an effectful function gave every repository reader of
-- `{var: "value"}` that effect, and the reader's authority judge became
-- unresolvable. The Local snapshot admission therefore refuses a non-UUID id
-- instead of skipping it. Account owners keep fieldOwnedDefinitionIdentityKinds
-- (stored account names are still ids there) until the owner rules.
@category "engine-internal"
localOwnedDefinitionIdentityKinds : List FieldOwnerDefinition -> Result String (List ({ handle: String, kind: String }))
localOwnedDefinitionIdentityKinds owners =
  case find (\owner -> not (isUuid owner.definition.id)) owners of
    Just owner -> Err (concat "Local definition id is not a UUID: " (concat owner.definition.id ". A name belongs in the definition's Codeable facet; its id is a generated UUID."))
    Nothing -> Ok (fieldOwnedDefinitionIdentityKinds owners)

@category "engine-internal"
localConstructorSelectedTypes : List ({ kind: String, ownerKey: String, ownerKind: String }) -> List FieldOwnerDefinition -> List FieldOwnerDefinition
localConstructorSelectedTypes mutations owners =
  let selected = localConstructorSelectedOwners mutations
  filter (\owner -> and (eq owner.kind "type") (elem owner.ownerKey selected)) owners

@category "engine-internal"
localConstructorTouchedTypes : List ({ kind: String, ownerKey: String, ownerKind: String }) -> List FieldOwnerDefinition -> List FieldOwnerDefinition
localConstructorTouchedTypes mutations owners =
  let selected = flatMap (\mutation -> if eq mutation.ownerKind "type" then [mutation.ownerKey] else []) mutations
  filter (\owner -> and (eq owner.kind "type") (elem owner.ownerKey selected)) owners

@category "engine-internal"
localConstructorOwnedFunctionIds : List FieldOwnerDefinition -> List String
localConstructorOwnedFunctionIds owners =
  flatMap (\owner -> if eq owner.kind "function" then [owner.definition.id] else []) owners

@category "engine-internal"
ownedDefinitionIdentityKindPlan : List a -> Result String (List a)
ownedDefinitionIdentityKindPlan rows =
  fold (\state row -> case state of
    Err message -> Err message
    Ok selected -> case find (\prior -> eq prior.handle row.handle) selected of
      Nothing -> Ok (appendItem row selected)
      Just prior -> if eq prior.kind row.kind then Ok selected else Err "owned identity is used by different identity kinds") (Ok []) rows

@category "engine-internal"
localConstructorRemovedFunctions : List String -> List String -> List String
localConstructorRemovedFunctions prior desired = filter (\id -> not (elem id desired)) (unique prior)

@category "engine-internal"
compilerConstructorCandidate : (name: String) -> (row: a) -> (kind: String) -> (fields: List a) -> (functionPath: List a) -> CompilerConstructorCandidateBatch
compilerConstructorCandidate name row kind fields functionPath =
  let views = compilerConstructorFieldViews fields [] []
  case compileFieldSlotsErrorWithSourceHandles views.slots of
    Just message -> CcbInvalid { message = concat "compiler constructor slots: " message }
    Nothing -> CcbReady { candidates = appendItem {
      name = name,
      ownerId = row.ownerId,
      ownerModule = row.ownerModule,
      kind = kind,
      fields = views.slots,
      markerFields = views.markers,
      functionKey = compilerConstructorFunctionKey row.ownerModule row.ownerId name,
      functionPath = functionPath,
      entityIndex = fromMaybe 0 (lookup row "entityIndex")
    } [] }

@category "engine-internal"
compilerConstructorCases : (cases: List a) -> (row: a) -> (casePath: List a) -> (index: Nat) -> (acc: List a) -> CompilerConstructorCandidateBatch
compilerConstructorCases cases row casePath index acc =
  case head cases of
    Nothing -> CcbReady { candidates = acc }
    Just variantCase ->
      case compilerConstructorCandidate variantCase.name row "variant" variantCase.fields (concat casePath [index, "constructorFunction"]) of
        CcbInvalid { message = message } -> CcbInvalid { message = message }
        CcbReady { candidates = next } ->
          compilerConstructorCases (tailOr cases) row casePath (index + 1) (concat acc next)

@category "engine-internal"
compilerConstructorEntityType : (row: a) -> (t: TraversalType) -> CompilerConstructorCandidateBatch
compilerConstructorEntityType row t =
  case t of
    -- An entity may expose constructors through its own outer opaque wrapper
    -- (List, Bool, Nat), but a nested opaque is another nominal owner's
    -- representation.  Stop after this single declaration layer so aliases
    -- such as String = List Char do not re-export List's Nil/Cons constructors.
    TtOpaque { pure = TtVariant { cases = cases } } ->
      compilerConstructorCases cases row ["type", "$opaque", "pure", "$variant", "cases"] 0 []
    TtOpaque { pure = TtRecord { fields = fields } } ->
      compilerConstructorCandidate row.ownerId row "record" fields ["constructorFunction"]
    TtVariant { cases = cases } -> compilerConstructorCases cases row ["type", "$variant", "cases"] 0 []
    TtRecord { fields = fields } ->
      compilerConstructorCandidate row.ownerId row "record" fields ["constructorFunction"]
    other -> CcbReady { candidates = [] }

-- type-substrate P1(a.18) — this walk was a linear SELF-RECURSION over the
-- registry row list, one Fenel level per row (441 levels deep during
-- `createRepositoryRegistry` alone, measured).  It is now the step of a `fold`,
-- whose perf branch is a JS loop: each callback returns before the next runs,
-- so the walk costs O(1) host stack instead of O(rows).  The `CcbInvalid`
-- short-circuit is preserved as an identity step on an already-invalid batch —
-- the recursion stopped visiting rows, and the guard here is the FIRST case,
-- before any row work, so no row work happens after an invalid either.
@category "engine-internal"
compilerConstructorCatalogRowsStep : (batch: CompilerConstructorCandidateBatch) -> (row: a) -> CompilerConstructorCandidateBatch
compilerConstructorCatalogRowsStep batch row =
  case batch of
    CcbInvalid { message = message } -> CcbInvalid { message = message }
    CcbReady { candidates = acc } ->
      case traversalSemanticSlotsErrorWithSourceHandles row.type of
        Just message -> CcbInvalid { message = concat "compiler constructor type: invalid semantic slots: " message }
        Nothing ->
          case compilerConstructorEntityType row row.type of
            CcbInvalid { message = message } -> CcbInvalid { message = message }
            CcbReady { candidates = next } -> CcbReady { candidates = concat acc next }

@category "engine-internal"
compilerConstructorCatalogRows : (rows: List a) -> (acc: List a) -> CompilerConstructorCandidateBatch
compilerConstructorCatalogRows rows acc =
  fold compilerConstructorCatalogRowsStep (CcbReady { candidates = acc }) rows

@category "engine-internal"
compilerConstructorMarkerFieldsEq : (left: List a) -> (right: List a) -> Boolean
compilerConstructorMarkerFieldsEq left right =
  case head left of
    Nothing -> eq (length right) 0
    Just l ->
      case head right of
        Nothing -> false
        Just r ->
          if not (fieldKeyEqWithSourceHandles l.key r.key)
          then false
          else if not (eq l.wireName r.wireName)
          then false
          else if not (fieldIdentityTypeEq l.type r.type)
          then false
          else compilerConstructorMarkerFieldsEq (tailOr left) (tailOr right)

@category "engine-internal"
compilerConstructorCandidateEq : (left: a) -> (right: a) -> Boolean
compilerConstructorCandidateEq left right =
  if not (eq left.name right.name)
  then false
  else if not (eq left.ownerId right.ownerId)
  then false
  else if not (eq left.ownerModule right.ownerModule)
  then false
  else if not (eq left.kind right.kind)
  then false
  else compilerConstructorMarkerFieldsEq left.markerFields right.markerFields

@category "engine-internal"
compilerConstructorCandidateMember : (candidate: a) -> (candidates: List a) -> Boolean
compilerConstructorCandidateMember candidate candidates =
  case head candidates of
    Nothing -> false
    Just existing ->
      if compilerConstructorCandidateEq candidate existing
      then true
      else compilerConstructorCandidateMember candidate (tailOr candidates)

-- type-substrate P1(a.18) — the same rewrite as `compilerConstructorCatalogRows`
-- above, on the grouping walk: one Fenel level per candidate (2948 levels on
-- the compile-loop catalog, measured) became one `fold` step.  The four
-- recursion parameters that carried the group state are one accumulator record;
-- every arm below is the state its recursive call passed, and the line after
-- the fold is the old `Nothing` arm.
@category "engine-internal"
compilerConstructorCatalogDedupStep : (state: a) -> (candidate: a) -> a
compilerConstructorCatalogDedupStep state candidate =
  if not state.hasCurrent
  then { hasCurrent = true, currentName = candidate.name, current = appendItem candidate [], out = state.out }
  else if eq candidate.name state.currentName
  then
    let next = if compilerConstructorCandidateMember candidate state.current then state.current else appendItem candidate state.current
    { hasCurrent = true, currentName = state.currentName, current = next, out = state.out }
  else {
    hasCurrent = true,
    currentName = candidate.name,
    current = appendItem candidate [],
    out = concat state.out state.current
  }

@category "engine-internal"
compilerConstructorCatalogDedupGo : (candidates: List a) -> (hasCurrent: Boolean) -> (currentName: String) -> (current: List a) -> (out: List a) -> List a
compilerConstructorCatalogDedupGo candidates hasCurrent currentName current out =
  let final = fold compilerConstructorCatalogDedupStep {
    hasCurrent = hasCurrent,
    currentName = currentName,
    current = current,
    out = out
  } candidates
  if final.hasCurrent then concat final.out final.current else final.out

@category "engine-internal"
compilerConstructorCatalogDedup : (candidates: List a) -> List a
compilerConstructorCatalogDedup candidates =
  compilerConstructorCatalogDedupGo
    (sort (\candidate -> candidate.name) candidates)
    false
    ""
    []
    []

@category "engine-internal"
compilerConstructorAmbiguousCandidates : (candidates: List a) -> (conflicts: List String) -> List a
compilerConstructorAmbiguousCandidates candidates conflicts =
  filter (\candidate -> elem candidate.name conflicts) candidates

@label "Compiler constructor catalog plan"
@description "Classify record/variant constructors from registry TraversalTypes, validate identity-total fields, deduplicate repeated semantic profiles, and pre-plan the unscoped base/conflict slice. The result is a policy-owned immutable catalog for the host cache."
@tags "engine" "compiler" "constructor" "field-identity" "phase-3"
compilerConstructorCatalogPlan : (rows: List a) -> CompilerConstructorCatalogPlan
compilerConstructorCatalogPlan rows =
  case compilerConstructorCatalogRows rows [] of
    CcbInvalid { message = message } -> CccInvalid { message = message }
    CcbReady { candidates = candidates } ->
      let deduped = compilerConstructorCatalogDedup candidates
      case compilerConstructorProjectionPlan deduped Nothing [] of
        CcpInvalid { message = message } -> CccInvalid { message = message }
        CcpReady { cacheKey = cacheKey, entries = entries, conflicts = conflicts } ->
          CccReady {
            candidates = deduped,
            baseCacheKey = cacheKey,
            baseEntries = entries,
            baseConflicts = conflicts,
            ambiguousCandidates = compilerConstructorAmbiguousCandidates deduped conflicts
          }

@category "engine-internal"
compilerCanonicalOwnerIds : (ownerIds: List String) -> List String
compilerCanonicalOwnerIds ownerIds = sort (\owner -> owner) (unique ownerIds)

@category "engine-internal"
compilerStringListCacheKey : (values: List String) -> String
compilerStringListCacheKey values =
  case head values of
    Nothing -> ""
    Just value ->
      concat
        (fieldNaturalDecimal (length value))
        (concat ":" (concat value (compilerStringListCacheKey (tailOr values))))

@category "engine-internal"
compilerConstructorProjectionCacheKey : (ownerIds: Maybe (List String)) -> (preferredOwnerIds: List String) -> String
compilerConstructorProjectionCacheKey ownerIds preferredOwnerIds =
  let scope = case ownerIds of
        Nothing -> "all"
        Just owners -> concat "scope:" (compilerStringListCacheKey owners)
  concat scope (concat "|prefer:" (compilerStringListCacheKey preferredOwnerIds))

@category "engine-internal"
compilerConstructorCandidateInOwners : (ownerIds: List String) -> (candidate: a) -> Boolean
compilerConstructorCandidateInOwners ownerIds candidate = elem candidate.ownerId ownerIds

@category "engine-internal"
compilerConstructorCandidatesInOwners : (ownerIds: List String) -> (candidates: List a) -> List a
compilerConstructorCandidatesInOwners ownerIds candidates =
  filter (compilerConstructorCandidateInOwners ownerIds) candidates

@category "engine-internal"
compilerConstructorOwnerCount : (ownerId: String) -> (candidates: List a) -> Number
compilerConstructorOwnerCount ownerId candidates =
  length (filter (\candidate -> eq candidate.ownerId ownerId) candidates)

@category "engine-internal"
compilerConstructorFirstDrift : (candidates: List a) -> (remaining: List a) -> Maybe String
compilerConstructorFirstDrift candidates remaining =
  case head remaining of
    Nothing -> Nothing
    Just candidate ->
      if gt (compilerConstructorOwnerCount candidate.ownerId candidates) 1
      then Just candidate.ownerId
      else compilerConstructorFirstDrift candidates (tailOr remaining)

@category "engine-internal"
compilerConstructorModuleText : (candidate: a) -> String
compilerConstructorModuleText candidate =
  case candidate.ownerModule of
    Nothing -> "<unqualified>"
    Just moduleName -> moduleName

@category "engine-internal"
compilerConstructorOwnerModules : (ownerId: String) -> (candidates: List a) -> List String
compilerConstructorOwnerModules ownerId candidates =
  sort
    (\moduleName -> moduleName)
    (unique (map compilerConstructorModuleText (filter (\candidate -> eq candidate.ownerId ownerId) candidates)))

@category "engine-internal"
compilerConstructorJoinModules : (modules: List String) -> String
compilerConstructorJoinModules modules =
  case head modules of
    Nothing -> ""
    Just moduleName ->
      case tail modules of
        Nothing -> moduleName
        Just rest -> concat moduleName (concat "/" (compilerConstructorJoinModules rest))

@category "engine-internal"
compilerConstructorResolveGroup : (name: String) -> (scoped: List a) -> (preferredOwnerIds: List String) -> CompilerConstructorProjectionGroup
compilerConstructorResolveGroup name scoped preferredOwnerIds =
  let preferred = compilerConstructorCandidatesInOwners preferredOwnerIds scoped
  let resolved = if gt (length preferred) 0 then preferred else scoped
  if not (eq (length resolved) 1)
  then CpgConflict { name = name }
  else
    case head resolved of
      Nothing -> CpgConflict { name = name }
      Just candidate -> CpgEntry {
        entry = { name = name, fields = candidate.fields },
        resolvedPreference = and (gt (length scoped) 1) (eq (length preferred) 1)
      }

@category "engine-internal"
compilerConstructorProjectGroup : (name: String) -> (candidates: List a) -> (ownerIds: Maybe (List String)) -> (preferredOwnerIds: List String) -> CompilerConstructorProjectionGroup
compilerConstructorProjectGroup name candidates ownerIds preferredOwnerIds =
  let scoped = case ownerIds of
        Nothing -> candidates
        Just owners -> compilerConstructorCandidatesInOwners owners candidates
  if eq (length scoped) 0
  then CpgSkip
  else
    case ownerIds of
      Nothing -> compilerConstructorResolveGroup name scoped preferredOwnerIds
      Just owners ->
        case compilerConstructorFirstDrift scoped scoped of
          Nothing -> compilerConstructorResolveGroup name scoped preferredOwnerIds
          Just ownerId ->
            let modules = compilerConstructorJoinModules (compilerConstructorOwnerModules ownerId scoped)
            let message = concat "compiler constructor slots: owner " (concat ownerId (concat " has conflicting " (concat name (concat " definitions (" (concat modules ")")))))
            CpgInvalid { message = message }

@category "engine-internal"
compilerConstructorProjectionFlush : (state: a) -> (ownerIds: Maybe (List String)) -> (preferredOwnerIds: List String) -> a
compilerConstructorProjectionFlush state ownerIds preferredOwnerIds =
  if not state.hasCurrent
  then state
  else
    case compilerConstructorProjectGroup state.currentName state.current ownerIds preferredOwnerIds of
      CpgInvalid { message = message } -> {
        hasCurrent = false,
        currentName = "",
        current = [],
        entries = state.entries,
        conflicts = state.conflicts,
        resolvedPreference = state.resolvedPreference,
        error = Just message
      }
      CpgSkip -> {
        hasCurrent = false,
        currentName = "",
        current = [],
        entries = state.entries,
        conflicts = state.conflicts,
        resolvedPreference = state.resolvedPreference,
        error = state.error
      }
      CpgConflict { name = name } -> {
        hasCurrent = false,
        currentName = "",
        current = [],
        entries = state.entries,
        conflicts = appendItem name state.conflicts,
        resolvedPreference = state.resolvedPreference,
        error = state.error
      }
      CpgEntry { entry = entry, resolvedPreference = resolved } -> {
        hasCurrent = false,
        currentName = "",
        current = [],
        entries = appendItem entry state.entries,
        conflicts = state.conflicts,
        resolvedPreference = or state.resolvedPreference resolved,
        error = state.error
      }

-- type-substrate P1(a.18) — the deepest of the three walks (3492 Fenel levels
-- on the compile loop's projection, one per candidate plus one per group
-- boundary; this is the recursion the compiled-resolver render overflowed on).
-- Folded over the same accumulator.  The boundary arm is where the two shapes
-- differ TEXTUALLY and not semantically: the recursion re-entered itself with
-- the SAME candidate list after a flush, and a flush always clears
-- `hasCurrent`, so that re-entry could only take the `not hasCurrent` branch
-- and open a new group on that same candidate.  The step below opens it
-- directly.
@category "engine-internal"
compilerConstructorProjectionStep : (ownerIds: Maybe (List String)) -> (preferredOwnerIds: List String) -> (state: a) -> (candidate: a) -> a
compilerConstructorProjectionStep ownerIds preferredOwnerIds state candidate =
  case state.error of
    Just message -> state
    Nothing ->
      if not state.hasCurrent
      then {
        hasCurrent = true,
        currentName = candidate.name,
        current = appendItem candidate [],
        entries = state.entries,
        conflicts = state.conflicts,
        resolvedPreference = state.resolvedPreference,
        error = Nothing
      }
      else if eq candidate.name state.currentName
      then {
        hasCurrent = true,
        currentName = state.currentName,
        current = appendItem candidate state.current,
        entries = state.entries,
        conflicts = state.conflicts,
        resolvedPreference = state.resolvedPreference,
        error = Nothing
      }
      else
        let flushed = compilerConstructorProjectionFlush state ownerIds preferredOwnerIds
        case flushed.error of
          Just message -> flushed
          Nothing -> {
            hasCurrent = true,
            currentName = candidate.name,
            current = appendItem candidate [],
            entries = flushed.entries,
            conflicts = flushed.conflicts,
            resolvedPreference = flushed.resolvedPreference,
            error = Nothing
          }

@category "engine-internal"
compilerConstructorProjectionGroups : (candidates: List a) -> (ownerIds: Maybe (List String)) -> (preferredOwnerIds: List String) -> (state: a) -> a
compilerConstructorProjectionGroups candidates ownerIds preferredOwnerIds state =
  let final = fold (compilerConstructorProjectionStep ownerIds preferredOwnerIds) state candidates
  case final.error of
    Just message -> final
    Nothing -> compilerConstructorProjectionFlush final ownerIds preferredOwnerIds

@label "Compiler constructor projection plan"
@description "Apply canonical owner scope and function-boundary preferences to a Fenel-decided constructor catalog. Same-owner drift is rejected under explicit scope; unresolved spellings are reported as ambiguity metadata."
@tags "engine" "compiler" "constructor" "field-identity" "phase-3"
compilerConstructorProjectionPlan : (candidates: List a) -> (ownerIds: Maybe (List String)) -> (preferredOwnerIds: List String) -> CompilerConstructorProjectionPlan
compilerConstructorProjectionPlan candidates ownerIds preferredOwnerIds =
  let canonicalOwners = case ownerIds of
        Nothing -> Nothing
        Just owners -> Just (compilerCanonicalOwnerIds owners)
  let canonicalPreferred = compilerCanonicalOwnerIds preferredOwnerIds
  let projected = compilerConstructorProjectionGroups candidates canonicalOwners canonicalPreferred {
    hasCurrent = false,
    currentName = "",
    current = [],
    entries = [],
    conflicts = [],
    resolvedPreference = false,
    error = Nothing
  }
  case projected.error of
    Just message -> CcpInvalid { message = message }
    Nothing ->
      let effectivePreferred = case canonicalOwners of
            Nothing -> if projected.resolvedPreference then canonicalPreferred else []
            Just owners -> canonicalPreferred
      CcpReady {
        cacheKey = compilerConstructorProjectionCacheKey canonicalOwners effectivePreferred,
        entries = projected.entries,
        conflicts = projected.conflicts
      }

@label "Constructor function body syntax"
@description "Build the ordinary pure function body's existing Syntax from a verified constructor target and its declared parameter names. Explicit named slots preserve record payloads; nullary construction keeps the existing zero-argument representation."
@category "engine-internal"
constructorFunctionBodySyntax : String -> List String -> Syntax Any
constructorFunctionBodySyntax target names =
  let fields = map (\name -> { name = name, value = SVar { name = name } }) names
  SConstruct { ctor = target, args = if eq (length names) 0 then [] else [SRecord { fields = fields }], fields = [] }

@label "System value source plan"
@description "Project named source-declared Codeable facts from the current captured system type roster into ordinary record member bindings. Unnamed definitions have no name binding; identities remain independently available."
@category "engine-internal"
systemValueSourcePlan : List ({ id: String, codeName: Maybe String }) -> List ({ name: String, id: String })
systemValueSourcePlan rows =
  fold (\members row -> case row.codeName of
    Nothing -> members
    Just name -> if eq name "" then members else appendItem { name = name, id = row.id } members) [] rows
