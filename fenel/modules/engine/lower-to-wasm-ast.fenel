module engine where

-- lowerToWasmAst — lower a ClosuresExplicitProgram body to a WasmModule,
-- the Wasm 3.0 target's typed AST. The sixth Fenel-authored engine pass
-- and the final step on the Wasm pipeline before the (TS-only)
-- serializeWasmModule binary-encode step.
--
-- Mirrors the TS oracle at
-- implementations/typescript/engine/src/modules/compile-wasm.ts:lowerToWasmAstNative.
--
-- Phase 21.7 — closes the Wasm pipeline (modulo the binary encode). After
-- this body lands, every step from raw source to WasmModule has a Fenel
-- body when the production pipeline dispatches through engine-bodies-
-- dispatch. Sibling work to Phase 21.6's emitJs.
--
-- Architectural decisions for the port (recorded here so a future session
-- reading this file knows why):
--
--   1. ModuleBuilder state — Option B from the brief. The mutable
--      ModuleBuilder (string pool, type interning, import collection,
--      fresh-local counter, pending closure funcs/exports) is exposed to
--      the Fenel body via a `HasWasmBuilder` typeclass-capability. The
--      dispatch wrapper creates a fresh ModuleBuilder per call and
--      registers an instance whose methods are backed by the builder's
--      mutation. The Fenel body invokes the methods syntactically; no
--      state-threading boilerplate.
--
--   2. Domain inference — Option II from the brief (the inference engine
--      stays TS-side, marshalled to the body as a `List<DomainEntry>`).
--      The MVP closes the harder problem (the per-CeExpr lowering body)
--      without bundling in a second large port. Phase 21.7.1 follow-on
--      can port `inferDomains` once the substrate is exercised at scale.
--
--   3. WasmAst entities — Strategy A. Declare every variant from
--      ir/wasm-ast.ts in this file's entities array. The WasmAst is
--      closed-form (Wasm 3.0 spec); declaring everything once means
--      future bodies inherit the entities without re-declaration churn.
--
-- The body's input is `ClosuresExplicitProgram` — already a typed Fenel
-- ADT declared in `make-closures-explicit.fenel`. The dispatch wrapper
-- supplies a `List<DomainEntry>` carrying pre-computed param + intermediate
-- domains (marshalled from the TS `inferDomains` pass), and an empty-list
-- seed for in-body accumulator initialisation.
--
-- WasmValType / WasmDomain / DomainEntry / WasmFuncType / WasmStructField /
-- WasmStructType / WasmArrayType / WasmFuncImport / WasmMemImport /
-- WasmGlobalImport / WasmBlockType / WasmInstr / WasmLocalDecl / WasmFunc /
-- WasmExport / WasmComponentExport / WasmModule / WasmDirectOp / CallDomain
-- — declared canonically in `fenel/modules/compile-wasm/types.fenel`
-- (Phase 4j consolidation). The compile-wasm module loads that file via
-- `?raw` import and registers the entities with the system registry; this
-- body file references them by name via lazy `$named` lookup at runtime.

-- ---------------------------------------------------------------------------
-- domainToValType — 4-arm switch from WasmDomain to WasmValType. Mirrors
-- compile-wasm.ts:domainToValType. DomNum → F64, DomBool → I32, DomRef
-- and DomUnknown → Externref (the safe boundary type for unknown).
-- ---------------------------------------------------------------------------
@label "Domain → ValType"
@description "Map a source-level WasmDomain to its Wasm 3.0 numeric / reference value type. DomNum → F64; DomBool → I32; DomRef / DomUnknown → Externref (the safe boundary type for unknown). Mirrors compile-wasm.ts:domainToValType."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
domainToValType : (d: WasmDomain) -> WasmValType
domainToValType d =
  case d of
    DomNum -> F64
    DomBool -> I32
    DomRef -> Externref
    DomUnknown -> Externref

-- ---------------------------------------------------------------------------
-- directNumericOp — fnId → WasmDirectOp dispatch for the four standard
-- f64 numeric ops (add/sub/mul/div). Mirrors the DIRECT_NUMERIC_OPS
-- table in compile-wasm.ts; null-prototype safety on the TS side
-- translates to the explicit if-chain here (no Object.prototype
-- pollution risk).
-- ---------------------------------------------------------------------------
@label "Direct numeric op"
@description "Map a canonical codeName to its direct-Wasm-op + result-domain pair for the four standard f64 numeric ops (add/sub/mul/div). Returns WDNoDirectOp for everything else — caller falls through to the runtime-helper-import path. Mirrors compile-wasm.ts:DIRECT_NUMERIC_OPS."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
directNumericOp : (fnId: String) -> WasmDirectOp
directNumericOp fnId =
  if eq fnId "add" then WDNumeric { op = F64Add, resultDomain = DomNum }
  else if eq fnId "sub" then WDNumeric { op = F64Sub, resultDomain = DomNum }
  else if eq fnId "mul" then WDNumeric { op = F64Mul, resultDomain = DomNum }
  else if eq fnId "div" then WDNumeric { op = F64Div, resultDomain = DomNum }
  else WDNoDirectOp

-- ---------------------------------------------------------------------------
-- directComparisonOp — fnId → WasmDirectOp dispatch for the six f64
-- comparison ops (lt/lte/gt/gte/eq/neq). Mirrors DIRECT_COMPARISON_OPS
-- in compile-wasm.ts.
-- ---------------------------------------------------------------------------
@label "Direct comparison op"
@description "Map a canonical codeName to its direct-Wasm-op for the six f64 comparison ops (lt/lte/gt/gte/eq/neq, each producing i32 0/1 → DomBool). Returns WDNoDirectOp for everything else. Mirrors compile-wasm.ts:DIRECT_COMPARISON_OPS."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
directComparisonOp : (fnId: String) -> WasmDirectOp
directComparisonOp fnId =
  if eq fnId "lt" then WDComparison { op = F64Lt }
  else if eq fnId "lte" then WDComparison { op = F64Le }
  else if eq fnId "gt" then WDComparison { op = F64Gt }
  else if eq fnId "gte" then WDComparison { op = F64Ge }
  else if eq fnId "eq" then WDComparison { op = F64Eq }
  else if eq fnId "neq" then WDComparison { op = F64Ne }
  else WDNoDirectOp

-- ---------------------------------------------------------------------------
-- replicateDomain — produce a List<WasmDomain> of length `n` filled with
-- `d`. Used by callDomainOf to build argDomains lists uniformly when all
-- args share a domain (e.g. add expects N DomNum args). Forward recursion
-- via appendItem matches the Fenel `appendItem` snoc-list convention.
-- ---------------------------------------------------------------------------
@label "Replicate domain"
@description "Build a List<WasmDomain> of length n filled with d. Helper to callDomainOf when all args share a domain (e.g. add expects N DomNum args)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
replicateDomain : (n: Number) -> (d: WasmDomain) -> (emptyList: List a) -> a
replicateDomain n d emptyList =
  replicateDomainLoop n d 0 emptyList

@label "Replicate domain (loop)"
@description "Recursive helper to replicateDomain."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
replicateDomainLoop : (n: Number) -> (d: WasmDomain) -> (idx: Number) -> (acc: a) -> a
replicateDomainLoop n d idx acc =
  if lt idx n
  then replicateDomainLoop n d (add idx 1) (appendItem d acc)
  else acc

-- ---------------------------------------------------------------------------
-- callDomainOf — fnId × arity → CallDomain. Mirrors compile-wasm.ts:
-- callDomainOf. The unknown / default case returns N DomRef args + DomRef
-- result, matching the `$fenel.<fnId>(...)` externref-args runtime-helper
-- fallback. Per-fnId precise typings cover the std arithmetic / comparison
-- / boolean / concat / string ops the canary's bodies use.
-- ---------------------------------------------------------------------------
@label "Call domain of"
@description "Map a source-level call (fnId × arity) to its (argDomains, resultDomain) pair. Mirrors compile-wasm.ts:callDomainOf — precise per-fnId typings for std arithmetic / comparison / boolean / concat / string ops, with a default `DomRef^arity → DomRef` for the runtime-helper fallback path."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
callDomainOf : (fnId: String) -> (arity: Number) -> (emptyList: List a) -> CallDomain
callDomainOf fnId arity emptyList =
  if eq fnId "add" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomNum }
  else if eq fnId "sub" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomNum }
  else if eq fnId "mul" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomNum }
  else if eq fnId "div" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomNum }
  else if eq fnId "mod" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomNum }
  else if eq fnId "negate" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomNum }
  else if eq fnId "lt" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomBool }
  else if eq fnId "lte" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomBool }
  else if eq fnId "gt" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomBool }
  else if eq fnId "gte" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomBool }
  else if eq fnId "eq" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomBool }
  else if eq fnId "neq" then CallDomain { argDomains = replicateDomain arity (DomNum) emptyList, resultDomain = DomBool }
  else if eq fnId "and" then CallDomain { argDomains = replicateDomain arity (DomBool) emptyList, resultDomain = DomBool }
  else if eq fnId "or" then CallDomain { argDomains = replicateDomain arity (DomBool) emptyList, resultDomain = DomBool }
  else if eq fnId "not" then CallDomain { argDomains = appendItem (DomBool) emptyList, resultDomain = DomBool }
  else if eq fnId "concat" then CallDomain { argDomains = replicateDomain arity (DomRef) emptyList, resultDomain = DomRef }
  -- Phase 21.1 string ops surface: length / slice / startsWith / split /
  -- join. Each maps to a `$fenel.<fnId>(...)` runtime helper at lower-
  -- call time; declaring precise per-arg-position domains here lets the
  -- inference pass pick the right boxing at the boundaries (e.g.
  -- `length(x) == 0` infers DomNum for the eq site instead of DomRef +
  -- boxed-comparison).
  else if eq fnId "length" then CallDomain { argDomains = appendItem (DomRef) emptyList, resultDomain = DomNum }
  else if eq fnId "slice" then CallDomain {
    argDomains = appendItem (DomNum) (appendItem (DomNum) (appendItem (DomRef) emptyList)),
    resultDomain = DomRef
  }
  else if eq fnId "startsWith" then CallDomain {
    argDomains = appendItem (DomRef) (appendItem (DomRef) emptyList),
    resultDomain = DomBool
  }
  else if eq fnId "split" then CallDomain {
    argDomains = appendItem (DomRef) (appendItem (DomRef) emptyList),
    resultDomain = DomRef
  }
  else if eq fnId "join" then CallDomain {
    argDomains = appendItem (DomRef) (appendItem (DomRef) emptyList),
    resultDomain = DomRef
  }
  else if eq fnId "head" then CallDomain { argDomains = appendItem (DomRef) emptyList, resultDomain = DomRef }
  else if eq fnId "tail" then CallDomain { argDomains = appendItem (DomRef) emptyList, resultDomain = DomRef }
  else CallDomain { argDomains = replicateDomain arity (DomRef) emptyList, resultDomain = DomRef }

-- LowerOutput — declared canonically in
-- `fenel/modules/compile-wasm/types.fenel` (Phase 4j consolidation).

-- ---------------------------------------------------------------------------
-- litStringFuncType — the (i32) -> externref signature of the
-- `$fenel.litString` runtime helper that materialises an interned string
-- into an externref at runtime. Pure function; no builder state.
-- ---------------------------------------------------------------------------
@label "litString func type"
@description "Build the (i32) -> externref WasmFuncType for the $fenel.litString runtime helper. Pure constant; takes an emptyList sentinel for the params/results list construction in pure-FP style."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
litStringFuncType : (emptyList: List a) -> WasmFuncType
litStringFuncType emptyList =
  WasmFuncType {
    params = appendItem (I32) emptyList,
    results = appendItem (Externref) emptyList
  }

-- ---------------------------------------------------------------------------
-- box/unbox helper func types — each Phase 21.7 coerceDomain insert path
-- registers an import with one of these signatures. Pure constants, no
-- builder state. Mirrors the `funcType([...], [...])` call sites at
-- compile-wasm.ts:1661/1667/1673/1679 (coerceDomain) and 1735/1745
-- (CeVar dotted chain).
-- ---------------------------------------------------------------------------
@label "boxNum func type"
@description "Build the (f64) -> externref WasmFuncType for the $fenel.boxNum runtime helper used by coerceDomain when produced=DomNum, target=DomRef."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
boxNumFuncType : (emptyList: List a) -> WasmFuncType
boxNumFuncType emptyList =
  WasmFuncType {
    params = appendItem (F64) emptyList,
    results = appendItem (Externref) emptyList
  }

@label "unboxNum func type"
@description "Build the (externref) -> f64 WasmFuncType for the $fenel.unboxNum runtime helper used by coerceDomain when produced=DomRef, target=DomNum."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
unboxNumFuncType : (emptyList: List a) -> WasmFuncType
unboxNumFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) emptyList,
    results = appendItem (F64) emptyList
  }

@label "boxBool func type"
@description "Build the (i32) -> externref WasmFuncType for the $fenel.boxBool runtime helper used by coerceDomain when produced=DomBool, target=DomRef."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
boxBoolFuncType : (emptyList: List a) -> WasmFuncType
boxBoolFuncType emptyList =
  WasmFuncType {
    params = appendItem (I32) emptyList,
    results = appendItem (Externref) emptyList
  }

@label "unboxBool func type"
@description "Build the (externref) -> i32 WasmFuncType for the $fenel.unboxBool runtime helper used by coerceDomain when produced=DomRef, target=DomBool."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
unboxBoolFuncType : (emptyList: List a) -> WasmFuncType
unboxBoolFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) emptyList,
    results = appendItem (I32) emptyList
  }

-- getFieldNamedFuncType — (externref, externref) -> externref. Used by
-- the dotted CeVar chain (each `.<seg>` calls getFieldNamed (prev,
-- segNameStr) -> nextValue).
@label "getFieldNamed func type"
@description "Build the (externref, externref) -> externref WasmFuncType for the $fenel.getFieldNamed runtime helper used by the dotted CeVar chain."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
getFieldNamedFuncType : (emptyList: List a) -> WasmFuncType
getFieldNamedFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) (appendItem (Externref) emptyList),
    results = appendItem (Externref) emptyList
  }

-- ---------------------------------------------------------------------------
-- isUnknownDomain / domainEq — small pure predicates over WasmDomain that
-- coerceDomain's case discrimination relies on. Kept as separate helpers
-- (rather than nested case-of patterns inside coerceDomain) so the eight
-- box/unbox arms read uniformly.
-- ---------------------------------------------------------------------------
@label "Is unknown domain"
@description "Predicate: is the WasmDomain DomUnknown? Helper to coerceDomain's short-circuit and inferBranchDom's then/else picking."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
isUnknownDomain : (d: WasmDomain) -> Boolean
isUnknownDomain d =
  case d of
    DomUnknown -> true
    _ -> false

@label "Domain equal"
@description "Structural equality on WasmDomain values. Used internally by tests + by coerceDomain's no-op short-circuit (when produced and target agree)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
domainEq : (a: WasmDomain) -> (b: WasmDomain) -> Boolean
domainEq a b =
  case a of
    DomNum ->
      case b of
        DomNum -> true
        _ -> false
    DomBool ->
      case b of
        DomBool -> true
        _ -> false
    DomRef ->
      case b of
        DomRef -> true
        _ -> false
    DomUnknown ->
      case b of
        DomUnknown -> true
        _ -> false

-- ---------------------------------------------------------------------------
-- coerceDomain — insert box/unbox helpers when produced and target domains
-- differ. Returns the (instrs, domain) pair with helpers appended. Mirrors
-- the 6-arm switch at compile-wasm.ts:coerceDomain.
--
-- target=DomUnknown short-circuits to "no coercion needed" — the caller
-- doesn't care about the produced type. produced==target short-circuits
-- to "no-op". The remaining six cases each append one helper call (or a
-- 2-instr F64Const+F64Ne for f64 -> bool truthy-coerce).
-- ---------------------------------------------------------------------------
@label "Coerce domain"
@description "Append box/unbox helper calls when the produced domain doesn't match the target. Returns a LowerOutput with the augmented instrs + target domain. 6 productive arms (DomNum→Ref boxNum, DomRef→Num unboxNum, DomBool→Ref boxBool, DomRef→Bool unboxBool, DomBool→Num F64ConvertI32S, DomNum→Bool F64Const 0 + F64Ne) + 2 short-circuits (target=DomUnknown, produced=target)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
coerceDomain : (instrs: List a) -> (produced: WasmDomain) -> (target: WasmDomain) -> (emptyList: List a) -> LowerOutput
coerceDomain instrs produced target emptyList =
  case target of
    DomUnknown -> LowerOutput { instrs = instrs, domain = produced }
    DomNum -> coerceToNum instrs produced emptyList
    DomBool -> coerceToBool instrs produced emptyList
    DomRef -> coerceToRef instrs produced emptyList

@label "Coerce to DomNum"
@description "coerceDomain sub-helper for target=DomNum."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
coerceToNum : (instrs: List a) -> (produced: WasmDomain) -> (emptyList: List a) -> LowerOutput
coerceToNum instrs produced emptyList =
  case produced of
    DomNum -> LowerOutput { instrs = instrs, domain = DomNum }
    DomBool ->
      let withConv = appendItem (F64ConvertI32S) instrs
      LowerOutput { instrs = withConv, domain = DomNum }
    DomRef ->
      let idx = internImport "unboxNum" (unboxNumFuncType emptyList)
      let withCall = appendItem (Call { funcIdx = idx }) instrs
      LowerOutput { instrs = withCall, domain = DomNum }
    DomUnknown -> LowerOutput { instrs = instrs, domain = DomNum }

@label "Coerce to DomBool"
@description "coerceDomain sub-helper for target=DomBool."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
coerceToBool : (instrs: List a) -> (produced: WasmDomain) -> (emptyList: List a) -> LowerOutput
coerceToBool instrs produced emptyList =
  case produced of
    DomBool -> LowerOutput { instrs = instrs, domain = DomBool }
    DomNum ->
      let with0 = appendItem (F64Const { value = 0 }) instrs
      let withNe = appendItem (F64Ne) with0
      LowerOutput { instrs = withNe, domain = DomBool }
    DomRef ->
      let idx = internImport "unboxBool" (unboxBoolFuncType emptyList)
      let withCall = appendItem (Call { funcIdx = idx }) instrs
      LowerOutput { instrs = withCall, domain = DomBool }
    DomUnknown -> LowerOutput { instrs = instrs, domain = DomBool }

@label "Coerce to DomRef"
@description "coerceDomain sub-helper for target=DomRef."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
coerceToRef : (instrs: List a) -> (produced: WasmDomain) -> (emptyList: List a) -> LowerOutput
coerceToRef instrs produced emptyList =
  case produced of
    DomRef -> LowerOutput { instrs = instrs, domain = DomRef }
    DomNum ->
      let idx = internImport "boxNum" (boxNumFuncType emptyList)
      let withCall = appendItem (Call { funcIdx = idx }) instrs
      LowerOutput { instrs = withCall, domain = DomRef }
    DomBool ->
      let idx = internImport "boxBool" (boxBoolFuncType emptyList)
      let withCall = appendItem (Call { funcIdx = idx }) instrs
      LowerOutput { instrs = withCall, domain = DomRef }
    DomUnknown -> LowerOutput { instrs = instrs, domain = DomRef }

-- ---------------------------------------------------------------------------
-- domainOf / inferBranchDom — light CeExpr-domain inferrer used by CeIf
-- to pick the if-block's result domain when no outer target is supplied.
-- TS oracle's `inferDomains` walks the entire expression tree with an
-- environment; this commit-4 port handles the three productive cases
-- (CeLit / CeVar / CeCall) and falls through to DomUnknown for the rest,
-- matching the brief's "simplest port" guidance. inferBranchDom mirrors
-- compile-wasm.ts:988 exactly (then-dom if known, else else-dom, else
-- DomRef as the safe fallback).
-- ---------------------------------------------------------------------------
@label "Domain of expression"
@description "Light CeExpr-domain inferrer. CeLit → number/bool/null/string → DomNum/Bool/Ref. CeVar → lookupLocal's domain or DomUnknown. CeCall → callDomainOf's resultDomain. Everything else → DomUnknown. Used by inferBranchDom to pick the CeIf result domain."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
domainOf : (expr: (CeExpr Any)) -> (emptyList: List a) -> WasmDomain
domainOf expr emptyList =
  case expr of
    CeLit { value = v } -> domainOfLit v
    CeVar { name = n } -> domainOfVar n
    CeCall { fnId = fnId, args = args } ->
      let cd = callDomainOf fnId (length args) emptyList
      cd.resultDomain
    -- Phase 5b13: zero-arg `True` / `False` are the opaque-Bool repr, so
    -- a CeIf with one of them in either branch can converge at DomBool
    -- without falling back to DomRef.
    CeConstruct { ctor = c, args = a } ->
      if eq (length a) 0
      then
        if eq c "True" then DomBool
        else if eq c "False" then DomBool
        else DomUnknown
      else DomUnknown
    _ -> DomUnknown

@label "Domain of literal"
@description "Map a JS literal to its source-level domain: number → DomNum, boolean → DomBool, null/string → DomRef."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
domainOfLit : (v: a) -> WasmDomain
domainOfLit v =
  if isNumber v then DomNum
  else if isBoolean v then DomBool
  else if isNull v then DomRef
  else if isString v then DomRef
  else DomUnknown

@label "Domain of CeVar"
@description "Resolve a variable name to its domain via HasWasmBuilder.lookupLocal. Out-of-scope name returns DomUnknown."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
domainOfVar : (n: String) -> WasmDomain
domainOfVar n =
  let loc = lookupLocal n
  case loc of
    Nothing -> DomUnknown
    Just entry -> entry.domain

@label "Infer branch domain"
@description "Decide the result domain of a CeIf when no outer target is supplied. Returns then-branch's domainOf if known, else else-branch's, else DomRef as the safe fallback. Mirrors compile-wasm.ts:988."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferBranchDom : (thenExpr: (CeExpr Any)) -> (elseExpr: (CeExpr Any)) -> (emptyList: List a) -> WasmDomain
inferBranchDom thenExpr elseExpr emptyList =
  let thenDom = domainOf thenExpr emptyList
  if isUnknownDomain thenDom
  then
    let elseDom = domainOf elseExpr emptyList
    if isUnknownDomain elseDom then DomRef else elseDom
  else thenDom

-- ---------------------------------------------------------------------------
-- lowerExprWithTarget — wrapper around lowerWasmExpr that applies
-- coerceDomain to the produced domain when it doesn't match the caller's
-- target. Mirrors compile-wasm.ts:656 (TS-side `lowerExpr`). The wrapped
-- form is what CeIf / CeLet / CeDo / dotted-CeVar / future-CeCall use for
-- recursive descent so the caller's target-domain demand is respected at
-- each composition point.
--
-- Named `lowerExprWithTarget` rather than `lowerExpr` because the
-- normalise-to-core.fenel module already registers an `engine:lowerExpr`
-- function (the JsonLogic → CoreExpr lowering pass). Fenel's parser
-- resolves identifiers globally by codeName so the two must be distinct.
-- ---------------------------------------------------------------------------
@label "Lower expression with target"
@description "Wrapper around lowerWasmExpr that applies coerceDomain to bring the produced domain into alignment with the caller's target. Used internally by CeIf / CeLet / CeDo / dotted CeVar / (future) CeCall arms for each recursive descent so coerceDomain inserts box/unbox helpers wherever sub-expression domains don't line up. Named with the WithTarget suffix because normalise-to-core's `lowerExpr` already occupies the bare codeName."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerExprWithTarget : (expr: (CeExpr Any)) -> (target: WasmDomain) -> (emptyList: List a) -> Result a LowerOutput
lowerExprWithTarget expr target emptyList =
  let r = lowerWasmExpr expr emptyList
  case r of
    Err err -> Err err
    Ok out -> Ok (coerceDomain out.instrs out.domain target emptyList)

-- ---------------------------------------------------------------------------
-- chainGetFieldNamed — emit the per-segment `(I32Const segIdx, Call
-- litStrIdx, Call getFieldNamedIdx)` triple for each remaining segment
-- of a dotted CeVar chain. The acc starts at the head local's pushed
-- (and coerced-to-DomRef) instructions; each iteration adds three more.
-- Mirrors compile-wasm.ts:741-746.
-- ---------------------------------------------------------------------------
@label "Chain getFieldNamed"
@description "Append (I32Const segIdx, Call litStrIdx, Call getFieldNamedIdx) for each remaining segment in a dotted CeVar chain. Recursion via head/tail to follow the snoc-list convention."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
chainGetFieldNamed : (segs: List String) -> (acc: List a) -> (litStrIdx: Number) -> (getFieldNamedIdx: Number) -> List a
chainGetFieldNamed segs acc litStrIdx getFieldNamedIdx =
  case head segs of
    Nothing -> acc
    Just seg ->
      let segIdx = internString seg
      let with1 = appendItem (I32Const { value = segIdx }) acc
      let with2 = appendItem (Call { funcIdx = litStrIdx }) with1
      let with3 = appendItem (Call { funcIdx = getFieldNamedIdx }) with2
      case tail segs of
        Nothing -> with3
        Just rest -> chainGetFieldNamed rest with3 litStrIdx getFieldNamedIdx

-- ---------------------------------------------------------------------------
-- processLetBindings — fold over a CeLet's bindings list emitting per-
-- binding `(value instrs, LocalSet idx)` pairs and allocating a fresh
-- local index per binding via HasWasmBuilder.allocLocal. Mirrors the
-- for-loop body at compile-wasm.ts:786-799 (CeLet arm).
-- ---------------------------------------------------------------------------
@label "Process let bindings"
@description "Fold over a CeLet's bindings list emitting per-binding (value instrs, LocalSet idx) pairs and allocating a fresh local per binding via HasWasmBuilder.allocLocal. Mirrors the for-loop at compile-wasm.ts:786-799."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
processLetBindings : (bindings: a) -> (acc: List a) -> (emptyList: List a) -> Result a (List a)
processLetBindings bindings acc emptyList =
  case head bindings of
    Nothing -> Ok acc
    Just binding ->
      let valueR = lowerExprWithTarget (binding.value) (DomUnknown) emptyList
      case valueR of
        Err err -> Err err
        Ok valueOut ->
          let idx = allocLocal (binding.name) (valueOut.domain)
          let withSet = appendItem (LocalSet { index = idx }) (valueOut.instrs)
          let newAcc = concat acc withSet
          case tail bindings of
            Nothing -> Ok newAcc
            Just rest -> processLetBindings rest newAcc emptyList

-- ---------------------------------------------------------------------------
-- processDoExprs — fold over a CeDo's exprs list emitting per-expr instrs
-- with target=DomUnknown for all but the last (with a Drop after when
-- produced != DomUnknown to clear the stack), and target=outer-target for
-- the last (whose produced domain becomes the CeDo's result domain).
-- Mirrors the for-loop at compile-wasm.ts:802-822 (CeDo arm).
--
-- "Last" is detected by peeking at the head of the tail: if the tail
-- has no head (empty list), the current expr IS the last. `tail [x]`
-- returns `Just []` (not `Nothing`), so we can't discriminate via
-- `case tail exprs of` alone — the head-of-tail peek is the only
-- way to tell "this is the final element" from "there's at least one
-- more". The TS oracle uses `i === expr.exprs.length - 1`.
-- ---------------------------------------------------------------------------
@label "Process do exprs"
@description "Fold over a CeDo's exprs emitting per-expr instrs with target=DomUnknown for all but the last (with a Drop after when produced != DomUnknown to clear the stack), and target=outer-target for the last (whose produced domain becomes the CeDo's result domain). Mirrors compile-wasm.ts:802-822."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
processDoExprs : (exprs: a) -> (target: WasmDomain) -> (acc: List a) -> (emptyList: List a) -> Result a LowerOutput
processDoExprs exprs target acc emptyList =
  case head exprs of
    Nothing -> Ok (LowerOutput { instrs = acc, domain = DomUnknown })
    Just e ->
      let restM = tail exprs
      case restM of
        Nothing -> processDoLast e target acc emptyList
        Just rest ->
          case head rest of
            Nothing -> processDoLast e target acc emptyList
            Just _ -> processDoInter e rest target acc emptyList

-- Lower the last expr in a CeDo at the outer target; concat its instrs
-- onto the accumulator; result domain = that expr's produced.
@label "Process do last expr"
@description "processDoExprs sub-helper for the last (target-domain) expr in a CeDo. Lowers e with target, concats its instrs onto acc, returns the result with the produced domain."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
processDoLast : (e: (CeExpr Any)) -> (target: WasmDomain) -> (acc: List a) -> (emptyList: List a) -> Result a LowerOutput
processDoLast e target acc emptyList =
  let lastR = lowerExprWithTarget e target emptyList
  case lastR of
    Err err -> Err err
    Ok lastOut ->
      Ok (LowerOutput {
        instrs = concat acc (lastOut.instrs),
        domain = lastOut.domain
      })

-- Lower a non-last expr at target=DomUnknown; concat its instrs; drop
-- the stack residue when produced != DomUnknown; recurse on the rest.
@label "Process do interior expr"
@description "processDoExprs sub-helper for non-last exprs. Lowers e at DomUnknown, concats its instrs, appends Drop when produced != DomUnknown, and recurses on the remaining exprs."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
processDoInter : (e: (CeExpr Any)) -> (rest: a) -> (target: WasmDomain) -> (acc: List a) -> (emptyList: List a) -> Result a LowerOutput
processDoInter e rest target acc emptyList =
  let interR = lowerExprWithTarget e (DomUnknown) emptyList
  case interR of
    Err err -> Err err
    Ok interOut ->
      let withE = concat acc (interOut.instrs)
      let withDrop =
        if isUnknownDomain (interOut.domain)
        then withE
        else appendItem (Drop) withE
      processDoExprs rest target withDrop emptyList

-- ---------------------------------------------------------------------------
-- lowerWasmLit — 5-arm dispatch on JS value type for CeLit lowering.
-- Strings and nulls call into HasWasmBuilder (internString / internImport)
-- for interning + import registration; numbers / booleans emit constants
-- directly. Mirrors compile-wasm.ts:lowerExprInternal CeLit arm.
--
-- The dispatch wrapper binds `internString` and `internImport` natives
-- onto ctx.natives at evaluation time so the bare codeName calls below
-- resolve through the per-call ModuleBuilder. The same wrapper also
-- exposes the `$effect:HasWasmBuilder:<method>` sentinel form so a
-- future Wasm-compiled body can reach the same handlers.
-- ---------------------------------------------------------------------------
@label "Lower Wasm CeLit"
@description "5-arm dispatch on JS value type for CeLit lowering. Numbers → F64Const + DomNum; booleans → I32Const 0/1 + DomBool; null → RefNull externref + DomRef; strings → intern + I32Const idx + Call litString import → DomRef; other → Err Unsupported. Mirrors compile-wasm.ts:lowerExprInternal CeLit arm."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerWasmLit : (v: a) -> (emptyList: List a) -> Result a LowerOutput
lowerWasmLit v emptyList =
  if isNumber v
  then Ok (LowerOutput {
    instrs = appendItem (F64Const { value = v }) emptyList,
    domain = DomNum
  })
  else if isBoolean v
  then Ok (LowerOutput {
    instrs = appendItem (I32Const { value = if v then 1 else 0 }) emptyList,
    domain = DomBool
  })
  else if isNull v
  then Ok (LowerOutput {
    instrs = appendItem (RefNull { heapType = "externref" }) emptyList,
    domain = DomRef
  })
  else if isArray v
  then Ok (LowerOutput {
    instrs = appendItem (RefNull { heapType = "externref" }) emptyList,
    domain = DomRef
  })
  else if isString v
  then
    let idx = internString v
    let litFnIdx = internImport "litString" (litStringFuncType emptyList)
    let pushIdx = appendItem (I32Const { value = idx }) emptyList
    let pushIdxThenCall = appendItem (Call { funcIdx = litFnIdx }) pushIdx
    Ok (LowerOutput {
      instrs = pushIdxThenCall,
      domain = DomRef
    })
  else Err (Unsupported {
    reason = "CeLit of unsupported value type",
    node = v
  })

-- ---------------------------------------------------------------------------
-- lowerWasmVar — CeVar lookup. Undotted names resolve through
-- HasWasmBuilder.lookupLocal to (LocalGet idx, domain). Dotted names
-- (input.body, r1.handlerSites) split into head-local + per-segment
-- chained `getFieldNamed` calls — Phase 21.7 commit 4 ports the chain
-- (mirroring compile-wasm.ts:720-748). Out-of-scope head → Unsupported
-- Err with the offending name in the diagnostic.
--
-- Mirrors compile-wasm.ts:lowerExprInternal CeVar arm — both halves.
-- ---------------------------------------------------------------------------
@label "Lower Wasm CeVar"
@description "CeVar undotted lookup: HasWasmBuilder.lookupLocal n → LocalGet idx + entry.domain. Dotted names are deferred to a follow-on commit and return Err Unsupported here. Out-of-scope name → Err Unsupported. Mirrors the undotted half of compile-wasm.ts:lowerExprInternal CeVar arm."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerWasmVar : (n: String) -> (emptyList: List a) -> Result a LowerOutput
lowerWasmVar n emptyList =
  if contains n "."
  then lowerWasmVarDotted n emptyList
  else lowerWasmVarUndotted n emptyList

@label "Lower undotted CeVar"
@description "Undotted-name lookup: HasWasmBuilder.lookupLocal n → LocalGet idx + entry.domain. Out-of-scope name → Err Unsupported. Split out of lowerWasmVar so the dotted vs undotted halves each read cleanly."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerWasmVarUndotted : (n: String) -> (emptyList: List a) -> Result a LowerOutput
lowerWasmVarUndotted n emptyList =
  let loc = lookupLocal n
  case loc of
    Nothing -> Err (Unsupported {
      reason = "CeVar is not in scope at Wasm lowering",
      node = n
    })
    Just entry -> Ok (LowerOutput {
      instrs = appendItem (LocalGet { index = entry.index }) emptyList,
      domain = entry.domain
    })

-- Dotted-CeVar lowering: split on '.', look up the head local, push
-- LocalGet + coerce-to-DomRef, then chain a (I32Const segIdx, Call
-- litStr, Call getFieldNamed) triple per remaining segment. Result
-- domain DomRef.
@label "Lower dotted CeVar"
@description "Dotted CeVar chain: split on '.', look up the head local, push LocalGet + coerce-to-DomRef, then chain a (I32Const segIdx, Call litStr, Call getFieldNamed) triple per remaining segment. Result domain is always DomRef. Out-of-scope head → Err Unsupported. Mirrors compile-wasm.ts:720-748."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerWasmVarDotted : (n: String) -> (emptyList: List a) -> Result a LowerOutput
lowerWasmVarDotted n emptyList =
  let parts = split n "."
  let headM = head parts
  let segsM = tail parts
  case headM of
    Nothing -> Err (Unsupported {
      reason = "CeVar dotted access with empty head",
      node = n
    })
    Just headStr ->
      let loc = lookupLocal headStr
      case loc of
        Nothing -> Err (Unsupported {
          reason = join ["CeVar dotted head '", headStr, "' not in scope"] "",
          node = n
        })
        Just entry ->
          let baseInstrs = appendItem (LocalGet { index = entry.index }) emptyList
          let coerced = coerceDomain baseInstrs (entry.domain) (DomRef) emptyList
          case segsM of
            Nothing -> Ok (LowerOutput {
              instrs = coerced.instrs,
              domain = DomRef
            })
            Just segs ->
              let litStrIdx = internImport "litString" (litStringFuncType emptyList)
              let getFieldNamedIdx = internImport "getFieldNamed" (getFieldNamedFuncType emptyList)
              let finalInstrs = chainGetFieldNamed segs (coerced.instrs) litStrIdx getFieldNamedIdx
              Ok (LowerOutput {
                instrs = finalInstrs,
                domain = DomRef
              })

-- ---------------------------------------------------------------------------
-- lowerWasmExpr — entry into the per-CeExpr lowering. Dispatches on
-- $tag and delegates to per-arm helpers. Mirrors the TS oracle's
-- `lowerExprInternal` (compile-wasm.ts:668) without the `target` arg:
-- target-domain coercion is the lowerExpr wrapper's concern (which
-- recursive descents go through). Each compositional arm (CeIf, CeDo,
-- CeLet, dotted CeVar) calls `lowerExpr` with the appropriate sub-
-- expression target for its children so coerceDomain inserts box/unbox
-- helpers wherever the produced domain doesn't line up.
--
-- Commit 4 ships CeLit / CeVar (both halves) / CeIf / CeDo / CeLet;
-- commit 5 added CeCall; commit 6 added CeConstruct + CeRecord; commit
-- 7 added CeMatch (the pattern-matching trio); commit 8 closes the
-- per-CeExpr surface with CeClosure (this arm). After commit 8 every
-- CeExpr variant has a Fenel-bodied lowering; the remaining work is
-- the program-level entry + production dispatch flip.
-- ---------------------------------------------------------------------------
@label "Lower Wasm CeExpr"
@description "Entry into per-CeExpr Wasm lowering. Dispatches on $tag and delegates to per-arm helpers. Commits 3-7 ship CeLit / CeVar (both halves) / CeIf / CeDo / CeLet / CeCall / CeConstruct / CeRecord / CeMatch; the remaining arm (CeClosure) returns Err Unsupported so the production call site stays gated on the TS oracle until it's ported. Mirrors compile-wasm.ts:lowerExprInternal — the central walker — without the explicit target arg (lowerExpr's coerceDomain wrapper threads target through recursive descents instead)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerWasmExpr : (expr: (CeExpr Any)) -> (emptyList: List a) -> Result a LowerOutput
lowerWasmExpr expr emptyList =
  case expr of
    CeLit { value = v } -> lowerWasmLit v emptyList
    CeVar { name = n } -> lowerWasmVar n emptyList
    CeIf { cond = c, then = t, else = e } ->
      let resultDom = inferBranchDom t e emptyList
      let condR = lowerExprWithTarget c (DomBool) emptyList
      case condR of
        Err err -> Err err
        Ok condOut ->
          let thenR = lowerExprWithTarget t resultDom emptyList
          case thenR of
            Err err -> Err err
            Ok thenOut ->
              let elseR = lowerExprWithTarget e resultDom emptyList
              case elseR of
                Err err -> Err err
                Ok elseOut ->
                  let valType = domainToValType resultDom
                  let ifInstr = If {
                    blockType = BlockTypeValue { valType = valType },
                    then = thenOut.instrs,
                    else = elseOut.instrs
                  }
                  let outInstrs = appendItem ifInstr (condOut.instrs)
                  Ok (LowerOutput { instrs = outInstrs, domain = resultDom })
    CeDo { exprs = es } -> processDoExprs es (DomUnknown) emptyList emptyList
    CeLet { bindings = bs, body = bd } ->
      let bindingsR = processLetBindings bs emptyList emptyList
      case bindingsR of
        Err err -> Err err
        Ok bindingsInstrs ->
          let bodyR = lowerExprWithTarget bd (DomUnknown) emptyList
          case bodyR of
            Err err -> Err err
            Ok bodyOut ->
              Ok (LowerOutput {
                instrs = concat bindingsInstrs (bodyOut.instrs),
                domain = bodyOut.domain
              })
    CeCall { fnId = fnId, args = args } ->
      if or (eq fnId "$structuralTruthy") (and (elem fnId ["if", "?:", "and", "or", "std:and", "std:or"]) (eq (lookup expr "structural") (Just false)))
      then Err (Unsupported { reason = "target has no exact Boolean runtime ABI", node = fnId })
      else lowerCall fnId args emptyList
    CeClosure { params = ps, captures = cs, body = b } ->
      lowerClosure ps cs b emptyList
    -- CeConstruct.fields is OPTIONAL — make-closures-explicit emits it
    -- only when the source-side CoreConstruct carried named-field metadata
    -- (see convert at line 116 vs the fallback at 122). The pattern below
    -- binds only ctor + args and reads .fields via dot-access (which
    -- returns undefined when absent — isNull catches both null and
    -- undefined inside lowerWasmConstruct).
    CeConstruct { ctor = c, args = a } ->
      lowerWasmConstruct c a (expr.fields) emptyList
    CeRecord { fields = fs } -> lowerWasmRecord fs emptyList
    CeMatch { scrutinee = s, arms = a } -> lowerMatch s a emptyList

-- ---------------------------------------------------------------------------
-- Phase 21.7 commit 5 — CeCall arm. Seven dispatch paths over the
-- (fnId, args) pair, mirroring compile-wasm.ts:lowerCall at lines
-- 1395-1604 (~210 lines in TS). The dispatch order below is exact:
-- first match wins.
--
--   1. directNumericOp fnId → left-fold at DomNum + op interleave
--      (add / sub / mul / div). Result: DomNum.
--   2. isStringTypedEq fnId args → both args lower at DomRef, call
--      $fenel.litEq; neq appends I32Eqz to flip the result. Result:
--      DomBool. Runs BEFORE directComparisonOp so any string-typed eq
--      routes through litEq instead of the numeric f64.eq fast path.
--   3. directComparisonOp fnId → exactly-2-arg at DomNum + cmp op
--      (lt / lte / gt / gte / eq / neq). Result: DomBool.
--   4. and / or → at-least-2-arg fold at DomBool + I32And / I32Or
--      interleave. Eager evaluation (matches the Phase 13 TS oracle).
--      Source-level short-circuit `if c then x else y` lives in the
--      CeIf arm, not here. Result: DomBool.
--   5. not / negate → exactly-1-arg at DomBool / DomNum + I32Eqz /
--      F64Neg. Result: DomBool / DomNum.
--   6. $dyn:<varName> → indirect closure call. LocalGet of the closure
--      handle (coerced to DomRef), each arg at DomRef, Call
--      $fenel.callClosure_<N>. Result: DomRef.
--   7. $effect:<Class>:<method> → effect-dispatch sentinel. Each arg at
--      DomRef, Call (import "$effect.<Class>" "<method>") via
--      internImportInModule. Result: DomRef.
--   8. Default → $fenel.<fnId> runtime helper. Each arg at DomRef,
--      Call import. Result: DomRef.
-- ---------------------------------------------------------------------------

-- hasStringTypedArg / argIsStringTyped / isStringTypedEq — structural
-- string-typed detection for Phase 21.5.2's polymorphic-eq routing.
-- Mirrors compile-wasm.ts:175-189. Iterate args via head/tail; for
-- each arg, check $tag-specific signals (CeLit string literal, CeVar
-- dotted access, CeCall whose callDomainOf returns DomRef).
@label "Has string-typed arg"
@description "Walk args looking for the Phase 21.5.2 string-typed signal: CeLit string, CeVar with dotted access, or CeCall whose callDomainOf returns DomRef. Used by isStringTypedEq to route eq/neq through litEq when at least one arg is structurally string-typed."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
hasStringTypedArg : (args: a) -> (emptyList: List a) -> Boolean
hasStringTypedArg args emptyList =
  case head args of
    Nothing -> false
    Just a ->
      if argIsStringTyped a emptyList
      then true
      else
        case tail args of
          Nothing -> false
          Just rest -> hasStringTypedArg rest emptyList

@label "Arg is string-typed"
@description "Per-arg string-typed predicate. CeLit string → True; CeVar with dotted access → True; CeCall with callDomainOf.resultDomain=DomRef → True; otherwise False."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
argIsStringTyped : (a: (CeExpr Any)) -> (emptyList: List a) -> Boolean
argIsStringTyped a emptyList =
  case a of
    CeLit { value = v } -> isString v
    CeVar { name = n } -> contains n "."
    CeCall { fnId = fnId, args = aargs } ->
      let cd = callDomainOf fnId (length aargs) emptyList
      case cd.resultDomain of
        DomRef -> true
        _ -> false
    _ -> false

-- Short-circuit on fnId first so non-comparison fnIds skip the args walk.
@label "Is string-typed eq"
@description "Phase 21.5.2 polymorphic-eq detection. True iff fnId is 'eq' or 'neq' AND at least one arg is structurally string-typed (CeLit string / dotted CeVar / DomRef-returning CeCall). Short-circuits on fnId first so non-comparison fnIds skip the args walk."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
isStringTypedEq : (fnId: String) -> (args: a) -> (emptyList: List a) -> Boolean
isStringTypedEq fnId args emptyList =
  if eq fnId "eq" then hasStringTypedArg args emptyList
  else if eq fnId "neq" then hasStringTypedArg args emptyList
  else false

-- ---------------------------------------------------------------------------
-- lowerArgsAt — fold over args, lowering each at the given target
-- domain and concatenating the resulting instrs onto acc. Shared by
-- the $dyn: / $effect: / default / isStringTypedEq paths (all of which
-- want every arg at DomRef) and by lowerCmpPath (both args at DomNum).
-- Returns Result<List<WasmInstr>>.
-- ---------------------------------------------------------------------------
@label "Lower args at target"
@description "Fold over args lowering each at the supplied target domain and concatenating the resulting instrs onto acc. Shared by lowerCmpPath (DomNum) / lowerLitEqPath / lowerDynPath / lowerEffectPath / lowerDefaultPath (DomRef) / lowerNotPath (DomBool) / lowerNegatePath (DomNum). Returns Result<List<WasmInstr>>."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerArgsAt : (args: a) -> (target: WasmDomain) -> (acc: List a) -> (emptyList: List a) -> Result a (List a)
lowerArgsAt args target acc emptyList =
  case head args of
    Nothing -> Ok acc
    Just a ->
      let r = lowerExprWithTarget a target emptyList
      case r of
        Err err -> Err err
        Ok out ->
          let newAcc = concat acc (out.instrs)
          case tail args of
            Nothing -> Ok newAcc
            Just rest -> lowerArgsAt rest target newAcc emptyList

-- ---------------------------------------------------------------------------
-- lowerNumericFold / lowerNumericFoldRest — left-fold the args list,
-- emitting arg0 instrs then for each subsequent arg its instrs + the
-- binop. Used by direct-numeric paths (add/sub/mul/div). Returns
-- Result<List<WasmInstr>>; the caller wraps in LowerOutput with the
-- per-op resultDomain.
-- ---------------------------------------------------------------------------
@label "Lower numeric fold"
@description "Left-fold over args emitting arg0 instrs then for each subsequent arg its instrs + the binop. Used by direct-numeric paths (add/sub/mul/div). Each arg lowers at DomNum."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerNumericFold : (opInstr: a) -> (args: a) -> (acc: List a) -> (emptyList: List a) -> Result a (List a)
lowerNumericFold opInstr args acc emptyList =
  case head args of
    Nothing -> Err (Unsupported {
      reason = "numeric fold requires at least 1 arg",
      node = args
    })
    Just a0 ->
      let r0 = lowerExprWithTarget a0 (DomNum) emptyList
      case r0 of
        Err err -> Err err
        Ok out0 ->
          let acc0 = concat acc (out0.instrs)
          case tail args of
            Nothing -> Ok acc0
            Just rest -> lowerNumericFoldRest opInstr rest acc0 emptyList

@label "Lower numeric fold (rest)"
@description "lowerNumericFold sub-helper: per-iteration emit arg instrs + binop. Recurses through the args list."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerNumericFoldRest : (opInstr: a) -> (args: a) -> (acc: List a) -> (emptyList: List a) -> Result a (List a)
lowerNumericFoldRest opInstr args acc emptyList =
  case head args of
    Nothing -> Ok acc
    Just a ->
      let r = lowerExprWithTarget a (DomNum) emptyList
      case r of
        Err err -> Err err
        Ok out ->
          let withArg = concat acc (out.instrs)
          let withOp = appendItem opInstr withArg
          case tail args of
            Nothing -> Ok withOp
            Just rest -> lowerNumericFoldRest opInstr rest withOp emptyList

-- ---------------------------------------------------------------------------
-- lowerBoolFold / lowerBoolFoldRest — same shape as numeric but at
-- DomBool with I32And / I32Or as the binop. Returns
-- Result<LowerOutput> directly (caller doesn't need to wrap).
-- ---------------------------------------------------------------------------
@label "Lower boolean fold"
@description "Left-fold over args at DomBool emitting I32And / I32Or between each pair. Used by the 'and' / 'or' paths in lowerCall. Eager evaluation matching the Phase 13 TS oracle (source-level short-circuit `if c then x else y` lives in CeIf)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerBoolFold : (opInstr: a) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerBoolFold opInstr args emptyList =
  case head args of
    Nothing -> Err (Unsupported {
      reason = "boolean fold requires at least 1 arg",
      node = args
    })
    Just a0 ->
      let r0 = lowerExprWithTarget a0 (DomBool) emptyList
      case r0 of
        Err err -> Err err
        Ok out0 ->
          case tail args of
            Nothing -> Ok (LowerOutput { instrs = out0.instrs, domain = DomBool })
            Just rest -> lowerBoolFoldRest opInstr rest (out0.instrs) emptyList

@label "Lower boolean fold (rest)"
@description "lowerBoolFold sub-helper: per-iteration emit arg instrs + I32And/I32Or. Recurses through the args list."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerBoolFoldRest : (opInstr: a) -> (args: a) -> (acc: List a) -> (emptyList: List a) -> Result a LowerOutput
lowerBoolFoldRest opInstr args acc emptyList =
  case head args of
    Nothing -> Ok (LowerOutput { instrs = acc, domain = DomBool })
    Just a ->
      let r = lowerExprWithTarget a (DomBool) emptyList
      case r of
        Err err -> Err err
        Ok out ->
          let withArg = concat acc (out.instrs)
          let withOp = appendItem opInstr withArg
          case tail args of
            Nothing -> Ok (LowerOutput { instrs = withOp, domain = DomBool })
            Just rest -> lowerBoolFoldRest opInstr rest withOp emptyList

-- ---------------------------------------------------------------------------
-- repeatExternref / externrefArgsFuncType / callClosureFuncType /
-- litEqFuncType — pure funcType helpers for the variable-arity import
-- signatures used by the $dyn: / $effect: / default / isStringTypedEq
-- paths. Each builds a WasmFuncType with N externref params + 1
-- externref / i32 result. Snoc-list accumulation preserves order.
-- ---------------------------------------------------------------------------
@label "Repeat externref"
@description "Build a list of N Externref WasmValType values by snoc-list accumulation. Used by externrefArgsFuncType and callClosureFuncType to construct variable-arity import signatures."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
repeatExternref : (n: Number) -> (acc: List a) -> List a
repeatExternref n acc =
  if lt n 1 then acc
  else repeatExternref (sub n 1) (appendItem (Externref) acc)

@label "Externref-args func type"
@description "Build a (externref^N) -> externref WasmFuncType for the $effect: and default paths' variable-arity imports."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
externrefArgsFuncType : (arity: Number) -> (emptyList: List a) -> WasmFuncType
externrefArgsFuncType arity emptyList =
  WasmFuncType {
    params = repeatExternref arity emptyList,
    results = appendItem (Externref) emptyList
  }

@label "callClosure_<N> func type"
@description "Build a (externref^(N+1)) -> externref WasmFuncType for the $dyn: path's callClosure_<N> imports. N+1 because the closure handle is the first param."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
callClosureFuncType : (arity: Number) -> (emptyList: List a) -> WasmFuncType
callClosureFuncType arity emptyList =
  WasmFuncType {
    params = repeatExternref (add arity 1) emptyList,
    results = appendItem (Externref) emptyList
  }

@label "litEq func type"
@description "Build the (externref, externref) -> i32 WasmFuncType for the $fenel.litEq runtime helper used by the Phase 21.5.2 string-typed eq path."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
litEqFuncType : (emptyList: List a) -> WasmFuncType
litEqFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) (appendItem (Externref) emptyList),
    results = appendItem (I32) emptyList
  }

-- ---------------------------------------------------------------------------
-- lowerCall — central CeCall dispatch. Mirrors compile-wasm.ts:1395.
-- Decomposed into a chain of sub-helpers (lowerNumericFoldPath,
-- lowerCallDispatch, lowerCallNonStringEq, lowerDirectCmpPath,
-- lowerCallNonCmp, lowerCallEffectOrDefault) to keep each function's
-- nested-case-of layout simple. Total dispatch order matches the TS
-- oracle exactly: numeric → string-typed-eq → comparison → and/or →
-- not → negate → $dyn: → $effect: → default.
-- ---------------------------------------------------------------------------
@label "Lower CeCall"
@description "Central CeCall dispatch. Mirrors compile-wasm.ts:1395 (lines 1395-1604). Seven dispatch paths over (fnId, args): direct numeric (add/sub/mul/div), string-typed eq via litEq (Phase 21.5.2), direct comparison (lt/lte/gt/gte/eq/neq), and/or (I32And/I32Or eager fold), not (I32Eqz), negate (F64Neg), $dyn:<varName> (indirect closure call via callClosure_<N>), $effect:<Class>:<method> (effect-dispatch via internImportInModule), default ($fenel.<fnId> runtime helper)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerCall : (fnId: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerCall fnId args emptyList =
  let directNum = directNumericOp fnId
  case directNum of
    WDNumeric { op = opInstr, resultDomain = resDom } ->
      lowerNumericFoldPath fnId opInstr resDom args emptyList
    _ -> lowerCallDispatch fnId args emptyList

@label "Lower numeric fold path"
@description "lowerCall sub-helper: arity-check (>= 2) then lowerNumericFold + LowerOutput wrap with the per-op resultDomain."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerNumericFoldPath : (fnId: String) -> (opInstr: a) -> (resDom: WasmDomain) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerNumericFoldPath fnId opInstr resDom args emptyList =
  if lt (length args) 2
  then Err (Unsupported {
    reason = join ["'", fnId, "' expects at least 2 args"] "",
    node = fnId
  })
  else
    let foldR = lowerNumericFold opInstr args emptyList emptyList
    case foldR of
      Err err -> Err err
      Ok instrs ->
        Ok (LowerOutput { instrs = instrs, domain = resDom })

@label "Lower call dispatch (post-numeric)"
@description "lowerCall sub-helper: routes to lowerLitEqPath when isStringTypedEq fires, else to lowerCallNonStringEq."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerCallDispatch : (fnId: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerCallDispatch fnId args emptyList =
  if isStringTypedEq fnId args emptyList
  then lowerLitEqPath fnId args emptyList
  else lowerCallNonStringEq fnId args emptyList

@label "Lower call non-string-eq"
@description "lowerCall sub-helper: checks directComparisonOp and routes to lowerDirectCmpPath when matched, else to lowerCallNonCmp."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerCallNonStringEq : (fnId: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerCallNonStringEq fnId args emptyList =
  let directCmp = directComparisonOp fnId
  case directCmp of
    WDComparison { op = cmpOp } -> lowerDirectCmpPath fnId cmpOp args emptyList
    _ -> lowerCallNonCmp fnId args emptyList

@label "Lower direct cmp path"
@description "lowerCall sub-helper: arity-check (== 2) for direct comparison ops, then lowerCmpPath."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerDirectCmpPath : (fnId: String) -> (cmpOp: a) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerDirectCmpPath fnId cmpOp args emptyList =
  if eq (length args) 2
  then lowerCmpPath cmpOp args emptyList
  else Err (Unsupported {
    reason = join ["comparison '", fnId, "' expects 2 args"] "",
    node = fnId
  })

@label "Lower call non-cmp"
@description "lowerCall sub-helper: chain over fnId for the remaining paths (and/or via lowerAndOrPath → lowerBoolFold, not, negate, $dyn:, then $effect: / default via lowerCallEffectOrDefault)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerCallNonCmp : (fnId: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerCallNonCmp fnId args emptyList =
  if eq fnId "and" then lowerAndOrPath fnId (I32And) args emptyList
  else if eq fnId "or" then lowerAndOrPath fnId (I32Or) args emptyList
  else if eq fnId "not" then lowerNotPath args emptyList
  else if eq fnId "negate" then lowerNegatePath args emptyList
  else if startsWith fnId "$dyn:" then lowerDynPath fnId args emptyList
  else lowerCallEffectOrDefault fnId args emptyList

-- and / or — arity check (>= 2) then delegate to lowerBoolFold. The
-- TS oracle errors with the specific fnId in the message; we mirror.
@label "Lower and/or path"
@description "lowerCall sub-helper for and / or: arity-check (>= 2) then delegate to lowerBoolFold with I32And / I32Or. Error message carries the specific fnId."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerAndOrPath : (fnId: String) -> (opInstr: a) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerAndOrPath fnId opInstr args emptyList =
  if lt (length args) 2
  then Err (Unsupported {
    reason = join ["'", fnId, "' expects at least 2 args"] "",
    node = fnId
  })
  else lowerBoolFold opInstr args emptyList

@label "Lower effect-or-default path"
@description "lowerCall sub-helper: calls parseEffectFnId and routes to lowerEffectPath on Just, lowerDefaultPath on Nothing. This is the Fenel-body-calling-Fenel-body case (parseEffectFnId is Phase 21.0-ported)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerCallEffectOrDefault : (fnId: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerCallEffectOrDefault fnId args emptyList =
  let effectM = parseEffectFnId fnId
  case effectM of
    Just parsed ->
      lowerEffectPath (parsed.typeName) (parsed.methodName) args emptyList
    Nothing -> lowerDefaultPath fnId args emptyList

-- ---------------------------------------------------------------------------
-- Per-path lowerings. Each takes the lowered-arg accumulator pattern
-- (lowerArgsAt at the appropriate target) and emits the path's
-- terminating instr (the cmp op, the litEq Call, the not/negate op,
-- the indirect / effect / default Call).
-- ---------------------------------------------------------------------------
@label "Lower direct comparison path"
@description "Both args at DomNum, then append the cmp op (F64Lt / F64Le / F64Gt / F64Ge / F64Eq / F64Ne). Result domain DomBool."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerCmpPath : (cmpOp: a) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerCmpPath cmpOp args emptyList =
  let argsR = lowerArgsAt args (DomNum) emptyList emptyList
  case argsR of
    Err err -> Err err
    Ok argsInstrs ->
      let withCmp = appendItem cmpOp argsInstrs
      Ok (LowerOutput { instrs = withCmp, domain = DomBool })

@label "Lower string-typed eq path"
@description "Phase 21.5.2 string-typed eq / neq. Both args lower at DomRef, then Call $fenel.litEq(externref, externref) -> i32. For neq, append I32Eqz to flip the result. Arity must be exactly 2; else Err Unsupported."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerLitEqPath : (fnId: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerLitEqPath fnId args emptyList =
  if eq (length args) 2
  then
    let argsR = lowerArgsAt args (DomRef) emptyList emptyList
    case argsR of
      Err err -> Err err
      Ok argsInstrs ->
        let litEqIdx = internImport "litEq" (litEqFuncType emptyList)
        let withCall = appendItem (Call { funcIdx = litEqIdx }) argsInstrs
        let final =
          if eq fnId "neq"
          then appendItem (I32Eqz) withCall
          else withCall
        Ok (LowerOutput { instrs = final, domain = DomBool })
  else Err (Unsupported {
    reason = join ["comparison '", fnId, "' expects 2 args"] "",
    node = fnId
  })

@label "Lower not path"
@description "Exactly-1-arg at DomBool, then append I32Eqz. Result DomBool."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerNotPath : (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerNotPath args emptyList =
  if eq (length args) 1
  then
    let argsR = lowerArgsAt args (DomBool) emptyList emptyList
    case argsR of
      Err err -> Err err
      Ok argsInstrs ->
        let withEqz = appendItem (I32Eqz) argsInstrs
        Ok (LowerOutput { instrs = withEqz, domain = DomBool })
  else Err (Unsupported {
    reason = "'not' expects exactly 1 arg",
    node = args
  })

@label "Lower negate path"
@description "Exactly-1-arg at DomNum, then append F64Neg. Result DomNum."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerNegatePath : (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerNegatePath args emptyList =
  if eq (length args) 1
  then
    let argsR = lowerArgsAt args (DomNum) emptyList emptyList
    case argsR of
      Err err -> Err err
      Ok argsInstrs ->
        let withNeg = appendItem (F64Neg) argsInstrs
        Ok (LowerOutput { instrs = withNeg, domain = DomNum })
  else Err (Unsupported {
    reason = "'negate' expects exactly 1 arg",
    node = args
  })

@label "Lower $dyn: path"
@description "Indirect closure call via $dyn:<varName>. LocalGet the closure handle, coerce to DomRef, lower each arg at DomRef, then Call $fenel.callClosure_<N>(externref^(N+1)) -> externref. Result domain DomRef. Out-of-scope varName → Err Unsupported."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerDynPath : (fnId: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerDynPath fnId args emptyList =
  let varName = slice fnId 5 (length fnId)
  let loc = lookupLocal varName
  case loc of
    Nothing -> Err (Unsupported {
      reason = join ["indirect call target '", varName, "' not in scope at Wasm lowering"] "",
      node = fnId
    })
    Just entry ->
      let pushLocal = appendItem (LocalGet { index = entry.index }) emptyList
      let coerced = coerceDomain pushLocal (entry.domain) (DomRef) emptyList
      let argsR = lowerArgsAt args (DomRef) (coerced.instrs) emptyList
      case argsR of
        Err err -> Err err
        Ok withArgs ->
          let arity = length args
          let importName = join ["callClosure_", toString arity] ""
          let ft = callClosureFuncType arity emptyList
          let callIdx = internImport importName ft
          let final = appendItem (Call { funcIdx = callIdx }) withArgs
          Ok (LowerOutput { instrs = final, domain = DomRef })

@label "Lower $effect: path"
@description "Effect-dispatch sentinel ($effect:<Class>:<method>). Lower each arg at DomRef, then Call (import \"$effect.<Class>\" \"<method>\" (externref^N) -> externref) via internImportInModule (the module name differs from the default $fenel). Result DomRef."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerEffectPath : (typeName: String) -> (methodName: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerEffectPath typeName methodName args emptyList =
  let argsR = lowerArgsAt args (DomRef) emptyList emptyList
  case argsR of
    Err err -> Err err
    Ok argsInstrs ->
      let arity = length args
      let ft = externrefArgsFuncType arity emptyList
      let moduleName = join ["$effect.", typeName] ""
      let fnIdx = internImportInModule moduleName methodName ft
      let final = appendItem (Call { funcIdx = fnIdx }) argsInstrs
      Ok (LowerOutput { instrs = final, domain = DomRef })

@label "Lower default path"
@description "Default fallback: $fenel.<fnId> runtime helper. Lower each arg at DomRef, then Call (import \"$fenel\" \"<fnId>\" (externref^N) -> externref) via internImport. Result DomRef."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerDefaultPath : (fnId: String) -> (args: a) -> (emptyList: List a) -> Result a LowerOutput
lowerDefaultPath fnId args emptyList =
  let argsR = lowerArgsAt args (DomRef) emptyList emptyList
  case argsR of
    Err err -> Err err
    Ok argsInstrs ->
      let arity = length args
      let ft = externrefArgsFuncType arity emptyList
      let fnIdx = internImport fnId ft
      let final = appendItem (Call { funcIdx = fnIdx }) argsInstrs
      Ok (LowerOutput { instrs = final, domain = DomRef })

-- ---------------------------------------------------------------------------
-- Phase 21.7 commit 6 — CeConstruct + CeRecord arms. Both arms share a
-- single helper `lowerWasmTaggedRecord` mirroring compile-wasm.ts:1060.
-- The TS oracle's algorithm:
--
--   1. Push the tag string + n_fields, Call $fenel.construct → externref.
--   2. Stash the externref in a fresh local (allocLocal).
--   3. For each field: LocalGet handle, I32Const i, then either
--      - Named (fieldNames[i] present): I32Const nameIdx, Call litString,
--        lower field at DomRef, Call setFieldNamed.
--      - Positional (fieldNames[i] absent): lower field at DomRef, Call
--        setField.
--   4. Push the value (LocalGet handle) as the result. Returns DomRef.
--
-- CeConstruct passes (expr.ctor, expr.args, expr.fields) — fields may be
-- absent/null for pre-Phase-21.1 unregistered ctors. CeRecord always
-- passes "$record" sentinel + a fully-named field list.
-- ---------------------------------------------------------------------------

-- Three new funcType helpers. Pure constants, no builder state.
-- `construct`: (externref, i32) -> externref
-- `setField`: (externref, i32, externref) -> ()
-- `setFieldNamed`: (externref, i32, externref, externref) -> ()
@label "construct func type"
@description "Build the (externref, i32) -> externref WasmFuncType for the $fenel.construct runtime helper. Used by lowerWasmTaggedRecord to materialise a freshly-tagged AdtHandle of the given $tag with N fields."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
constructFuncType : (emptyList: List a) -> WasmFuncType
constructFuncType emptyList =
  WasmFuncType {
    params = appendItem (I32) (appendItem (Externref) emptyList),
    results = appendItem (Externref) emptyList
  }

@label "setField func type"
@description "Build the (externref, i32, externref) -> () WasmFuncType for the $fenel.setField runtime helper. Positional field mutation: writes fieldValue into the AdtHandle's slot at index. Used when fieldNames metadata is absent (legacy / unregistered ctors)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
setFieldFuncType : (emptyList: List a) -> WasmFuncType
setFieldFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) (appendItem (I32) (appendItem (Externref) emptyList)),
    results = emptyList
  }

@label "setFieldNamed func type"
@description "Build the (externref, i32, externref, externref) -> () WasmFuncType for the $fenel.setFieldNamed runtime helper. Phase 21.1 named-field path: writes (fieldValue, name) into the AdtHandle's slot at index. Used when CeConstruct.fields supplies a name list or for every CeRecord field."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
setFieldNamedFuncType : (emptyList: List a) -> WasmFuncType
setFieldNamedFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) (appendItem (Externref) (appendItem (I32) (appendItem (Externref) emptyList))),
    results = emptyList
  }

-- listIndex — return Just element when 0 <= i < length, else Nothing.
-- Not in std (yet); local helper for picking the per-field name at idx
-- when fieldNames is a list rather than a name-indexed map.
@label "listIndex"
@description "Return Just element when 0 <= i < length, else Nothing. Local helper not yet in std; lifted into engine to keep the CeConstruct + CeRecord arms self-contained."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
listIndex : (xs: a) -> (i: Number) -> a
listIndex xs i =
  if lt i 0 then Nothing
  else listIndexLoop xs i 0

@label "listIndexLoop"
@description "listIndex sub-helper: walk xs with a counter; emit Just element on match, Nothing on exhaustion."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
listIndexLoop : (xs: a) -> (i: Number) -> (cur: Number) -> a
listIndexLoop xs i cur =
  case head xs of
    Nothing -> Nothing
    Just x ->
      if eq cur i then Just x
      else
        case tail xs of
          Nothing -> Nothing
          Just rest -> listIndexLoop rest i (add cur 1)

-- lowerWasmTaggedRecord — central helper shared by CeConstruct + CeRecord.
-- Mirrors compile-wasm.ts:1060.
@label "Lower tagged record"
@description "Central CeConstruct + CeRecord helper. Mirrors compile-wasm.ts:1060. Algorithm: push tag + n_fields, Call $fenel.construct → externref; stash in fresh allocLocal; per-field push handle + index, then named (Call setFieldNamed with interned name) or positional (Call setField) lower-and-emit; finally LocalGet handle as the result. Returns DomRef."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerWasmTaggedRecord : (tag: String) -> (fields: a) -> (fieldNames: a) -> (emptyList: List a) -> Result a LowerOutput
lowerWasmTaggedRecord tag fields fieldNames emptyList =
  let tagIdx = internString tag
  let litStrIdx = internImport "litString" (litStringFuncType emptyList)
  let constructIdx = internImport "construct" (constructFuncType emptyList)
  let push1 = appendItem (I32Const { value = tagIdx }) emptyList
  let push2 = appendItem (Call { funcIdx = litStrIdx }) push1
  let push3 = appendItem (I32Const { value = length fields }) push2
  let push4 = appendItem (Call { funcIdx = constructIdx }) push3
  let valLocalIdx = allocLocal (join ["$ctor_", toString (length fields)] "") (DomRef)
  let push5 = appendItem (LocalSet { index = valLocalIdx }) push4
  let perFieldR = lowerTaggedRecordFields fields fieldNames 0 valLocalIdx push5 emptyList
  case perFieldR of
    Err err -> Err err
    Ok withFields ->
      let final = appendItem (LocalGet { index = valLocalIdx }) withFields
      Ok (LowerOutput { instrs = final, domain = DomRef })

-- Per-field iteration: walks the fields list alongside an index counter,
-- dispatching per-field on whether the matching fieldNames entry exists.
-- Mirrors the for-loop at compile-wasm.ts:1102-1121.
@label "Lower tagged record fields (iteration)"
@description "lowerWasmTaggedRecord sub-helper: walks fields list with an index counter, dispatching per-field on whether listIndex fieldNames idx is Just (named) or Nothing (positional). Mirrors compile-wasm.ts:1102-1121 for-loop."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerTaggedRecordFields : (fields: a) -> (fieldNames: a) -> (idx: Number) -> (valLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> Result a a
lowerTaggedRecordFields fields fieldNames idx valLocalIdx acc emptyList =
  case head fields of
    Nothing -> Ok acc
    Just fieldExpr ->
      let nameAtIdxM = listIndex fieldNames idx
      let perFieldR = lowerOneTaggedRecordField fieldExpr nameAtIdxM idx valLocalIdx acc emptyList
      case perFieldR of
        Err err -> Err err
        Ok withField ->
          case tail fields of
            Nothing -> Ok withField
            Just rest ->
              lowerTaggedRecordFields rest fieldNames (add idx 1) valLocalIdx withField emptyList

-- Per-field dispatcher: push the handle + the index, then route to the
-- named or positional helper based on whether fieldNames[idx] is Just.
@label "Lower one tagged record field"
@description "Per-field dispatcher: push handle (LocalGet valLocalIdx) + index (I32Const idx), then route to lowerNamedField (when nameAtIdxM = Just name) or lowerPositionalField (when Nothing)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerOneTaggedRecordField : (fieldExpr: a) -> (nameAtIdxM: a) -> (idx: Number) -> (valLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> Result a a
lowerOneTaggedRecordField fieldExpr nameAtIdxM idx valLocalIdx acc emptyList =
  let push1 = appendItem (LocalGet { index = valLocalIdx }) acc
  let push2 = appendItem (I32Const { value = idx }) push1
  case nameAtIdxM of
    Nothing -> lowerPositionalField fieldExpr push2 emptyList
    Just name -> lowerNamedField fieldExpr name push2 emptyList

-- Positional: lower field at DomRef, Call setField.
@label "Lower positional field"
@description "Per-field positional mode: lower fieldExpr at DomRef, append its instrs, then Call $fenel.setField. Used when the source-side construct didn't supply named-field metadata (legacy ctors)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerPositionalField : (fieldExpr: a) -> (acc: a) -> (emptyList: List a) -> Result a a
lowerPositionalField fieldExpr acc emptyList =
  let setFieldIdx = internImport "setField" (setFieldFuncType emptyList)
  let fieldR = lowerExprWithTarget fieldExpr (DomRef) emptyList
  case fieldR of
    Err err -> Err err
    Ok fieldOut ->
      let withValue = concat acc (fieldOut.instrs)
      let withCall = appendItem (Call { funcIdx = setFieldIdx }) withValue
      Ok withCall

-- Named: push interned name + litString call, lower field at DomRef,
-- Call setFieldNamed.
@label "Lower named field"
@description "Per-field named mode (Phase 21.1): push interned name + Call litString, lower fieldExpr at DomRef, then Call $fenel.setFieldNamed. Used for every CeRecord field and for CeConstruct fields when fieldNames metadata is present."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerNamedField : (fieldExpr: a) -> (name: String) -> (acc: a) -> (emptyList: List a) -> Result a a
lowerNamedField fieldExpr name acc emptyList =
  let litStrIdx = internImport "litString" (litStringFuncType emptyList)
  let setFieldNamedIdx = internImport "setFieldNamed" (setFieldNamedFuncType emptyList)
  let nameIdx = internString name
  let push3 = appendItem (I32Const { value = nameIdx }) acc
  let push4 = appendItem (Call { funcIdx = litStrIdx }) push3
  let fieldR = lowerExprWithTarget fieldExpr (DomRef) emptyList
  case fieldR of
    Err err -> Err err
    Ok fieldOut ->
      let withValue = concat push4 (fieldOut.instrs)
      let withCall = appendItem (Call { funcIdx = setFieldNamedIdx }) withValue
      Ok withCall

-- CeConstruct arm. `fields` (the optional named-field metadata) may be
-- null/undefined when the source-side ctor didn't supply names; pass
-- through the empty list in that case so per-field iteration routes
-- every field through positional mode.
--
-- Phase 5b13 Bool-construct emitter alignment: zero-arg `True` / `False`
-- short-circuit to an i32 `1` / `0` with DomBool, matching the engine's
-- opaque-repr semantics (`construct ["True"|"False"]` evaluates to native
-- JS bool — `json-logic.ts:675-676`). At the function boundary the
-- DomBool→DomRef coercion (`engine-bodies-dispatch.ts:914-915`) inserts
-- `boxBool` so the JS host receives the native bool naturally; nested
-- True/False inside `Just (True)` etc. ride the same boxBool path via
-- the per-field `lowerExprWithTarget DomRef` coercion. Every other ctor
-- falls through to the canonical tagged-record lowering.
@label "Lower Wasm CeConstruct"
@description "CeConstruct arm. Delegates to lowerWasmTaggedRecord with the ctor name as the tag. Guards against the `fields` metadata being absent (null/undefined for pre-Phase-21.1 unregistered ctors) by passing through the empty list, which routes every field through positional mode."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerWasmConstruct : (ctor: String) -> (args: a) -> (fields: a) -> (emptyList: List a) -> Result a LowerOutput
lowerWasmConstruct ctor args fields emptyList =
  if eq (length args) 0
  then
    if eq ctor "True"
    then Ok (LowerOutput {
      instrs = appendItem (I32Const { value = 1 }) emptyList,
      domain = DomBool
    })
    else if eq ctor "False"
    then Ok (LowerOutput {
      instrs = appendItem (I32Const { value = 0 }) emptyList,
      domain = DomBool
    })
    else
      let fieldNamesList = if isNull fields then emptyList else compileSlotWireNames fields emptyList
      lowerWasmTaggedRecord ctor args fieldNamesList emptyList
  else
    let fieldNamesList = if isNull fields then emptyList else compileSlotWireNames fields emptyList
    lowerWasmTaggedRecord ctor args fieldNamesList emptyList

-- CeRecord arm. Records are always named (CeRecord.fields is a list of
-- {name, value} per make-closures-explicit:convertRecordFields). Extract
-- both columns and delegate with the sentinel "$record" tag.
@label "Lower Wasm CeRecord"
@description "CeRecord arm. Anonymous records use sentinel tag \"$record\". Extracts field values + names from the list of {name, value} entries (always named, by construction) and delegates to lowerWasmTaggedRecord."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerWasmRecord : (recordFields: a) -> (emptyList: List a) -> Result a LowerOutput
lowerWasmRecord recordFields emptyList =
  let values = extractRecordValues recordFields emptyList
  let names = extractRecordNames recordFields emptyList
  lowerWasmTaggedRecord "$record" values names emptyList

@label "Extract record values"
@description "Project the .value field of each entry in a {name, value} list. Used by lowerWasmRecord to build the field-values list for lowerWasmTaggedRecord."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
extractRecordValues : (fs: List ({ name: String, value: (CeExpr Any) })) -> (acc: List (CeExpr Any)) -> List (CeExpr Any)
extractRecordValues fs acc =
  case head fs of
    Nothing -> acc
    Just f ->
      let next = appendItem (f.value) acc
      case tail fs of
        Nothing -> next
        Just rest -> extractRecordValues rest next

@label "Extract record names"
@description "Project the .name field of each entry in a {name, value} list. Used by lowerWasmRecord to build the field-names list for lowerWasmTaggedRecord."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
extractRecordNames : (fs: List ({ name: String, value: (CeExpr Any) })) -> (acc: List String) -> List String
extractRecordNames fs acc =
  case head fs of
    Nothing -> acc
    Just f ->
      let next = appendItem (f.name) acc
      case tail fs of
        Nothing -> next
        Just rest -> extractRecordNames rest next

-- ---------------------------------------------------------------------------
-- Phase 21.7 commit 7 — CeMatch arm + the pattern-matching trio
-- (lowerMatch + emitWasmMatchArms + emitWasmPatternGuard + bindWasmPattern).
-- Mirrors compile-wasm.ts:1128-1388. The lowering walks the arms list
-- as a nested if/else chain; each arm emits an i32 guard (presence +
-- equality checks AND-folded into a single i32 0/1) and a then-branch
-- that binds pattern names + lowers the arm body. The base case falls
-- through to $fenel.matchFail which raises the run-time match-failure
-- error.
--
-- Five new imports the helpers register (via internImport, module = $fenel):
--   tagEq        : (externref, externref) -> i32   — tag-equality probe
--   matchFail    : (externref) -> externref        — fallthrough trap
--   getField     : (externref, i32) -> externref   — positional field load
--   hasField     : (externref, i32) -> i32         — positional presence
--   hasFieldNamed: (externref, externref) -> i32   — named presence
--
-- `getFieldNamed` + `litString` + `litEq` were already registered by
-- earlier commits (4 / 4 / 5 respectively); the func-type helpers are
-- reused unchanged here.
--
-- Three new HasWasmBuilder methods get exercised: setLocalAlias (PatVar
-- aliases the scrutinee local), snapshotLocals + restoreLocals (per-arm
-- scoping so bindings introduced in one arm don't leak into the others).
-- ---------------------------------------------------------------------------

-- Five new funcType helpers — pure constants, no builder state. Mirror
-- the shape of litEqFuncType / setFieldFuncType from commits 5-6.
@label "tagEq func type"
@description "Build the (externref, externref) -> i32 WasmFuncType for the $fenel.tagEq runtime helper. PatConstruct's tag-check pushes the scrutinee + the interned ctor-name string then calls tagEq to get a 0/1 i32 on the stack."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
tagEqFuncType : (emptyList: List a) -> WasmFuncType
tagEqFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) (appendItem (Externref) emptyList),
    results = appendItem (I32) emptyList
  }

@label "matchFail func type"
@description "Build the (externref) -> externref WasmFuncType for the $fenel.matchFail runtime helper. Called at the terminal fallthrough of a CeMatch's nested-if/else chain when no arm matched; produces a match-failure runtime error."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
matchFailFuncType : (emptyList: List a) -> WasmFuncType
matchFailFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) emptyList,
    results = appendItem (Externref) emptyList
  }

@label "getField func type"
@description "Build the (externref, i32) -> externref WasmFuncType for the $fenel.getField runtime helper. Used by PatConstruct's sub-pattern recursion when the pattern lacks named-field metadata (positional fallback)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
getFieldFuncType : (emptyList: List a) -> WasmFuncType
getFieldFuncType emptyList =
  WasmFuncType {
    params = appendItem (I32) (appendItem (Externref) emptyList),
    results = appendItem (Externref) emptyList
  }

@label "hasField func type"
@description "Build the (externref, i32) -> i32 WasmFuncType for the $fenel.hasField runtime helper. PatConstruct's per-sub-position presence check (positional) — strictness gate so a two-arm pattern that distinguishes with-field vs without-field on the same ctor fails the with-field arm correctly."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
hasFieldFuncType : (emptyList: List a) -> WasmFuncType
hasFieldFuncType emptyList =
  WasmFuncType {
    params = appendItem (I32) (appendItem (Externref) emptyList),
    results = appendItem (I32) emptyList
  }

@label "hasFieldNamed func type"
@description "Build the (externref, externref) -> i32 WasmFuncType for the $fenel.hasFieldNamed runtime helper. Phase 21.1 named-field presence check; symmetric with hasField but keyed by interned field name."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
hasFieldNamedFuncType : (emptyList: List a) -> WasmFuncType
hasFieldNamedFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) (appendItem (Externref) emptyList),
    results = appendItem (I32) emptyList
  }

-- ---------------------------------------------------------------------------
-- emitWasmPatternGuard — emit i32-pattern-match-result instructions onto
-- `acc` for `pattern` against the scrutinee in `scrutLocalIdx`. Combined
-- sub-pattern checks I32And-fold into the final result. Mirrors
-- compile-wasm.ts:1198-1322.
--
-- PatVar / PatWildcard match trivially (push I32Const 1).
-- PatLit pushes the scrutinee + the boxed literal + Call $fenel.litEq.
-- PatConstruct emits tag-check then per-sub-position presence + recursive
-- sub-guard AND-folded together.
-- ---------------------------------------------------------------------------
@label "Emit Wasm pattern guard"
@description "Emit i32 pattern-match-result (0/1) instructions for a CorePattern against the scrutinee local. PatVar / PatWildcard match trivially (I32Const 1); PatLit calls $fenel.litEq; PatConstruct emits tag-check + AND-folded per-sub-position presence + recursive sub-guard. Mirrors compile-wasm.ts:emitWasmPatternGuard."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitWasmPatternGuard : (pattern: a) -> (scrutLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> Result a a
emitWasmPatternGuard pattern scrutLocalIdx acc emptyList =
  case pattern of
    PatVar { name = _n } -> Ok (appendItem (I32Const { value = 1 }) acc)
    PatWildcard -> Ok (appendItem (I32Const { value = 1 }) acc)
    PatLit { value = v } ->
      let push1 = appendItem (LocalGet { index = scrutLocalIdx }) acc
      let litR = lowerExprWithTarget (CeLit { value = v }) (DomRef) emptyList
      case litR of
        Err err -> Err err
        Ok litOut ->
          let withLit = concat push1 (litOut.instrs)
          let litEqIdx = internImport "litEq" (litEqFuncType emptyList)
          let withCall = appendItem (Call { funcIdx = litEqIdx }) withLit
          Ok withCall
    PatConstruct { ctor = c, args = subs } ->
      -- Tag check: LocalGet scrut, I32Const tagIdx, Call litString, Call tagEq.
      let push1 = appendItem (LocalGet { index = scrutLocalIdx }) acc
      let tagIdx = internString c
      let push2 = appendItem (I32Const { value = tagIdx }) push1
      let litStrIdx = internImport "litString" (litStringFuncType emptyList)
      let push3 = appendItem (Call { funcIdx = litStrIdx }) push2
      let tagEqIdx = internImport "tagEq" (tagEqFuncType emptyList)
      let push4 = appendItem (Call { funcIdx = tagEqIdx }) push3
      -- Sub-patterns: walk subs alongside an index counter, AND-folding
      -- each position's presence + recursive-sub-guard contribution.
      let fieldNames = if isNull pattern.fields then emptyList else compileSlotWireNames pattern.fields emptyList
      emitConstructGuardSubs subs fieldNames 0 scrutLocalIdx push4 emptyList

-- emitConstructGuardSubs — per-sub-pattern iteration for PatConstruct's
-- guard. Walks subs alongside an index counter; per sub: presence check
-- (hasField or hasFieldNamed based on fieldNames[idx]) + I32And;
-- then if sub is non-trivial (NOT PatVar / PatWildcard), field-load
-- into a fresh local + recursive emitWasmPatternGuard + I32And.
@label "Emit construct guard subs (iteration)"
@description "Per-sub-pattern iteration for PatConstruct's guard. Walks subs alongside an index counter; per sub: presence check (hasField/hasFieldNamed based on fieldNames[idx]) + I32And, then if sub is non-trivial, field-load + allocLocal + LocalSet + recursive emitWasmPatternGuard + I32And."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitConstructGuardSubs : (subs: a) -> (fieldNames: a) -> (idx: Number) -> (scrutLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> Result a a
emitConstructGuardSubs subs fieldNames idx scrutLocalIdx acc emptyList =
  case head subs of
    Nothing -> Ok acc
    Just sub ->
      let nameAtIdxM =
        if isNull fieldNames then Nothing
        else listIndex fieldNames idx
      -- Presence check: LocalGet scrut, then either (I32Const nameIdx,
      -- Call litString, Call hasFieldNamed) for named or (I32Const idx,
      -- Call hasField) for positional. Followed by I32And.
      let withPresence = emitGuardPresence nameAtIdxM idx scrutLocalIdx acc emptyList
      let withPresAnd = appendItem (I32And) withPresence
      -- Sub-guard: skip on PatVar / PatWildcard (presence is the only
      -- contribution); else emit field-load + allocLocal + LocalSet +
      -- recursive emitWasmPatternGuard + I32And.
      let subR = emitGuardSubRecurse sub nameAtIdxM idx scrutLocalIdx withPresAnd emptyList
      case subR of
        Err err -> Err err
        Ok afterSub ->
          case tail subs of
            Nothing -> Ok afterSub
            Just rest ->
              emitConstructGuardSubs rest fieldNames (add idx 1) scrutLocalIdx afterSub emptyList

-- emitGuardPresence — emit the presence check (hasField / hasFieldNamed)
-- for one sub-pattern's slot. Returns the accumulator with the call
-- appended; the caller appends I32And.
@label "Emit guard presence check"
@description "Emit the presence check (hasField / hasFieldNamed) instructions for one PatConstruct sub-position. Named path: I32Const nameIdx, Call litString, Call hasFieldNamed. Positional path: I32Const idx, Call hasField. Returns the updated accumulator; the caller appends I32And."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitGuardPresence : (nameAtIdxM: a) -> (idx: Number) -> (scrutLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> a
emitGuardPresence nameAtIdxM idx scrutLocalIdx acc emptyList =
  let push1 = appendItem (LocalGet { index = scrutLocalIdx }) acc
  case nameAtIdxM of
    Just name ->
      let nameIdx = internString name
      let push2 = appendItem (I32Const { value = nameIdx }) push1
      let litStrIdx = internImport "litString" (litStringFuncType emptyList)
      let push3 = appendItem (Call { funcIdx = litStrIdx }) push2
      let hasFieldNamedIdx = internImport "hasFieldNamed" (hasFieldNamedFuncType emptyList)
      appendItem (Call { funcIdx = hasFieldNamedIdx }) push3
    Nothing ->
      let push2 = appendItem (I32Const { value = idx }) push1
      let hasFieldIdx = internImport "hasField" (hasFieldFuncType emptyList)
      appendItem (Call { funcIdx = hasFieldIdx }) push2

-- emitGuardSubRecurse — emit the field-load + recursive sub-guard for
-- one sub-pattern slot. Skips field-load + recurse when sub is
-- PatVar / PatWildcard (the presence check above already covers them);
-- in that case returns acc unchanged.
@label "Emit guard sub recurse"
@description "Emit the field-load + recursive sub-guard for one PatConstruct sub-position. Skips on PatVar / PatWildcard (the presence check above already covers them); returns acc unchanged. Else: LocalGet scrut + field-load + allocLocal + LocalSet + recursive emitWasmPatternGuard + I32And."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitGuardSubRecurse : (sub: a) -> (nameAtIdxM: a) -> (idx: Number) -> (scrutLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> Result a a
emitGuardSubRecurse sub nameAtIdxM idx scrutLocalIdx acc emptyList =
  case sub of
    PatVar { name = _n } -> Ok acc
    PatWildcard -> Ok acc
    _ ->
      -- Field-load: LocalGet scrut + getField/getFieldNamed.
      let push1 = appendItem (LocalGet { index = scrutLocalIdx }) acc
      let withLoad = emitGuardFieldLoad nameAtIdxM idx push1 emptyList
      let fieldLocalIdx = allocLocal "$match_field" (DomRef)
      let withSet = appendItem (LocalSet { index = fieldLocalIdx }) withLoad
      let subR = emitWasmPatternGuard sub fieldLocalIdx withSet emptyList
      case subR of
        Err err -> Err err
        Ok afterSub -> Ok (appendItem (I32And) afterSub)

-- emitGuardFieldLoad — push (I32Const nameIdx, Call litString, Call
-- getFieldNamed) for named or (I32Const idx, Call getField) for
-- positional. Sibling of emitGuardPresence but with the LOAD calls.
@label "Emit guard field load"
@description "Push the field-load instructions (I32Const + Call litString + Call getFieldNamed) for named, or (I32Const idx + Call getField) for positional. Sibling of emitGuardPresence but with the LOAD imports instead of HAS imports; shared by emitGuardSubRecurse + bindOneConstructSub."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitGuardFieldLoad : (nameAtIdxM: a) -> (idx: Number) -> (acc: a) -> (emptyList: List a) -> a
emitGuardFieldLoad nameAtIdxM idx acc emptyList =
  case nameAtIdxM of
    Just name ->
      let nameIdx = internString name
      let push2 = appendItem (I32Const { value = nameIdx }) acc
      let litStrIdx = internImport "litString" (litStringFuncType emptyList)
      let push3 = appendItem (Call { funcIdx = litStrIdx }) push2
      let getFieldNamedIdx = internImport "getFieldNamed" (getFieldNamedFuncType emptyList)
      appendItem (Call { funcIdx = getFieldNamedIdx }) push3
    Nothing ->
      let push2 = appendItem (I32Const { value = idx }) acc
      let getFieldIdx = internImport "getField" (getFieldFuncType emptyList)
      appendItem (Call { funcIdx = getFieldIdx }) push2

-- ---------------------------------------------------------------------------
-- bindWasmPattern — emit field-load instructions into `acc` AND bind
-- every name introduced by `pattern` into ctx.locals (via setLocalAlias
-- for top-level PatVar, via allocLocal+setLocalAlias for nested PatVar
-- inside a PatConstruct). PatLit + PatWildcard contribute nothing.
-- Mirrors compile-wasm.ts:1329-1388.
--
-- The side-effect-on-locals discipline is: the caller (emitWasmMatchArms)
-- snapshots `locals` before this call and restores after lowering the
-- arm body, so bindings introduced here don't leak across arms or out
-- of the match.
-- ---------------------------------------------------------------------------
@label "Bind Wasm pattern"
@description "Emit field-load instructions AND bind every name introduced by pattern into ctx.locals. Top-level PatVar aliases the scrutinee local via setLocalAlias; PatConstruct iterates args, allocLocal+LocalSet for each non-trivial sub then recurse. PatLit + PatWildcard are no-ops. The caller (emitWasmMatchArms) snapshots/restores around this so bindings don't leak."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
bindWasmPattern : (pattern: a) -> (scrutLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> a
bindWasmPattern pattern scrutLocalIdx acc emptyList =
  case pattern of
    PatLit { value = _v } -> acc
    PatWildcard -> acc
    PatVar { name = n } ->
      let _alias = setLocalAlias n scrutLocalIdx (DomRef)
      acc
    PatConstruct { ctor = _c, args = subs } ->
      let fieldNames = if isNull pattern.fields then emptyList else compileSlotWireNames pattern.fields emptyList
      bindConstructPatternSubs subs fieldNames 0 scrutLocalIdx acc emptyList

-- bindConstructPatternSubs — per-sub-pattern iteration for PatConstruct's
-- bind. Walks subs alongside an index counter; for each non-trivial
-- sub (NOT PatLit / PatWildcard — note the skip predicate differs from
-- the guard's): field-load + allocLocal + LocalSet + recursive bind.
-- NB: PatVar IS recursed into here (it'll alias the field local).
@label "Bind construct pattern subs (iteration)"
@description "Per-sub-pattern iteration for PatConstruct's bind. Walks subs alongside an index counter; for each non-trivial sub (NOT PatLit / PatWildcard — note the skip differs from the guard's): field-load + allocLocal + LocalSet + recursive bindWasmPattern. PatVar IS recursed into here (aliases the field local)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
bindConstructPatternSubs : (subs: a) -> (fieldNames: a) -> (idx: Number) -> (scrutLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> a
bindConstructPatternSubs subs fieldNames idx scrutLocalIdx acc emptyList =
  case head subs of
    Nothing -> acc
    Just sub ->
      let nameAtIdxM =
        if isNull fieldNames then Nothing
        else listIndex fieldNames idx
      let withSub = bindOneConstructSub sub nameAtIdxM idx scrutLocalIdx acc emptyList
      case tail subs of
        Nothing -> withSub
        Just rest ->
          bindConstructPatternSubs rest fieldNames (add idx 1) scrutLocalIdx withSub emptyList

@label "Bind one construct sub"
@description "Per-sub-pattern bind for PatConstruct. Skip on PatLit / PatWildcard. Else: LocalGet scrut + field-load + allocLocal + LocalSet + recursive bindWasmPattern. The bind recursion is what makes nested PatVar inside PatConstruct alias the field local (not the outer scrutinee)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
bindOneConstructSub : (sub: a) -> (nameAtIdxM: a) -> (idx: Number) -> (scrutLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> a
bindOneConstructSub sub nameAtIdxM idx scrutLocalIdx acc emptyList =
  case sub of
    PatLit { value = _v } -> acc
    PatWildcard -> acc
    _ ->
      let push1 = appendItem (LocalGet { index = scrutLocalIdx }) acc
      let withLoad = emitGuardFieldLoad nameAtIdxM idx push1 emptyList
      let fieldLocalIdx = allocLocal "$match_bind" (DomRef)
      let withSet = appendItem (LocalSet { index = fieldLocalIdx }) withLoad
      bindWasmPattern sub fieldLocalIdx withSet emptyList

-- ---------------------------------------------------------------------------
-- emitWasmMatchArms — recursive base case + inductive case for the
-- nested-if/else chain. Base case (arms exhausted) emits matchFail; the
-- inductive case emits the i32 guard + an If wrapping (bindings + body)
-- and (recursion into remaining arms). Per-arm locals snapshot +
-- restore preserves bindings scope. Mirrors compile-wasm.ts:1145-1191.
-- ---------------------------------------------------------------------------
@label "Emit Wasm match arms"
@description "Recursive walker for a CeMatch's arms list. Base case (arms exhausted): emit LocalGet scrut + Call matchFail → DomRef. Inductive case: emit guard onto acc, then If wrapping (bind + body) and (recursion into remaining arms). Per-arm locals snapshot/restore preserves bindings scope. Mirrors compile-wasm.ts:emitWasmMatchArms."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitWasmMatchArms : (arms: a) -> (idx: Number) -> (scrutLocalIdx: Number) -> (acc: a) -> (emptyList: List a) -> Result a LowerOutput
emitWasmMatchArms arms idx scrutLocalIdx acc emptyList =
  case listIndex arms idx of
    Nothing ->
      -- Base case: terminal fallthrough. LocalGet scrut, Call matchFail.
      let push1 = appendItem (LocalGet { index = scrutLocalIdx }) acc
      let matchFailIdx = internImport "matchFail" (matchFailFuncType emptyList)
      let push2 = appendItem (Call { funcIdx = matchFailIdx }) push1
      Ok (LowerOutput { instrs = push2, domain = DomRef })
    Just arm ->
      -- Inductive case: emit guard onto acc, then If wrapping
      -- (bindings ++ body) and (recursion into remaining arms).
      let guardR = emitWasmPatternGuard (arm.pattern) scrutLocalIdx acc emptyList
      case guardR of
        Err err -> Err err
        Ok withGuard ->
          emitWasmMatchArmThen arm arms idx scrutLocalIdx withGuard emptyList

-- emitWasmMatchArmThen — handle one arm's then-branch: snapshot, bind,
-- lower body, restore, then recurse on remaining arms for the else-
-- branch and wrap in If. Split out from emitWasmMatchArms so the body
-- of each case-of layer stays at a manageable depth.
@label "Emit Wasm match arm then-branch"
@description "emitWasmMatchArms sub-helper: snapshot locals, bind pattern + lower body for the then-branch, restore locals, then recurse on remaining arms for the else-branch and wrap in If(externref). Split out from emitWasmMatchArms so each case-of layer's body stays at manageable depth."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitWasmMatchArmThen : (arm: a) -> (arms: a) -> (idx: Number) -> (scrutLocalIdx: Number) -> (accWithGuard: a) -> (emptyList: List a) -> Result a LowerOutput
emitWasmMatchArmThen arm arms idx scrutLocalIdx accWithGuard emptyList =
  -- 0-arg dispatcher methods need explicit `()` so the parser emits a
  -- {call:[...]} shape instead of {var:...} — a bare `snapshotLocals`
  -- would resolve to the function reference, not invoke it.
  let snap = snapshotLocals ()
  let bindAcc = bindWasmPattern (arm.pattern) scrutLocalIdx emptyList emptyList
  let bodyR = lowerExprWithTarget (arm.body) (DomRef) emptyList
  let _restore = restoreLocals snap
  case bodyR of
    Err err -> Err err
    Ok bodyOut ->
      let thenInstrs = concat bindAcc (bodyOut.instrs)
      let elseR = emitWasmMatchArms arms (add idx 1) scrutLocalIdx emptyList emptyList
      case elseR of
        Err err -> Err err
        Ok elseOut ->
          let ifInstr = If {
            blockType = BlockTypeValue { valType = Externref },
            then = thenInstrs,
            else = elseOut.instrs
          }
          Ok (LowerOutput {
            instrs = appendItem ifInstr accWithGuard,
            domain = DomRef
          })

-- ---------------------------------------------------------------------------
-- lowerMatch — entry into the CeMatch arm. Lower scrutinee at DomRef,
-- stash in a fresh local, delegate to the recursive arms walker.
-- Mirrors compile-wasm.ts:1128-1143.
-- ---------------------------------------------------------------------------
@label "Lower Wasm CeMatch"
@description "CeMatch arm entry. Lower scrutinee at DomRef, stash in a fresh local via allocLocal, then delegate to emitWasmMatchArms. Result domain: DomRef (match always produces externref). Mirrors compile-wasm.ts:lowerMatch."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerMatch : (scrutinee: a) -> (arms: a) -> (emptyList: List a) -> Result a LowerOutput
lowerMatch scrutinee arms emptyList =
  let scrutR = lowerExprWithTarget scrutinee (DomRef) emptyList
  case scrutR of
    Err err -> Err err
    Ok scrutOut ->
      let scrutLocalIdx = allocLocal "$match" (DomRef)
      let withSet = appendItem (LocalSet { index = scrutLocalIdx }) (scrutOut.instrs)
      emitWasmMatchArms arms 0 scrutLocalIdx withSet emptyList

-- ---------------------------------------------------------------------------
-- Phase 21.7 commit 8 — CeClosure arm. The single arm is recursive (the
-- closure body is itself a CeExpr lowered via lowerExprWithTarget) AND
-- emits TWO instruction streams (caller's `out` + the body's `bodyOut`)
-- into separate WasmFuncs within the same compilation.
--
-- Algorithm (mirrors compile-wasm.ts:lowerClosure at 872-985):
--   1. Allocate a fresh closure id + name.
--   2. Resolve captures from the CALLER's scope (LocalGet + coerce-to-DomRef).
--      MUST happen BEFORE enterClosureBody — once the body frame is
--      installed, the caller's locals are no longer reachable via
--      lookupLocal.
--   3. enterClosureBody params — swap to a fresh frame with [$env, ...params]
--      pre-bound at indices 0..N.
--   4. Emit the body's capture-loading prologue (one envGet call per
--      capture, allocating fresh body-frame locals).
--   5. Lower the closure body proper at target=DomRef.
--   6. exitClosureBody snap — extract the body's declaredLocals,
--      restore the caller's frame.
--   7. Assemble the body's WasmFunc (with rleLocals-compressed locals)
--      and matching WasmExport; push via addPendingFunc + addPendingExport.
--   8. Emit the closure-construction sequence into the caller's out
--      (envAlloc + per-capture envSet + makeClosure → externref handle).
-- ---------------------------------------------------------------------------

-- ---------------------------------------------------------------------------
-- envAllocFuncType / envSetFuncType / envGetFuncType / makeClosureFuncType
-- — pure funcType helpers for the four runtime-helper imports the closure
-- ABI uses. Mirrors compile-wasm.ts:872-985 funcType(...) call sites.
--
-- closureBodyFuncType is NOT re-declared here — its shape ((externref^(N+1))
-- -> externref) is identical to callClosureFuncType (commit 5), which the
-- CeCall $dyn: arm already uses. The body invokes callClosureFuncType
-- directly so the two stay structurally identical.
-- ---------------------------------------------------------------------------
@label "Env-alloc func type"
@description "Build the (i32) -> externref WasmFuncType for the $fenel.envAlloc runtime helper. Used by lowerClosure to allocate the env handle that backs a closure's captures."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
envAllocFuncType : (emptyList: List a) -> WasmFuncType
envAllocFuncType emptyList =
  WasmFuncType {
    params = appendItem (I32) emptyList,
    results = appendItem (Externref) emptyList
  }

@label "Env-set func type"
@description "Build the (externref, i32, externref) -> () WasmFuncType for the $fenel.envSet runtime helper. Used by lowerClosure to populate captured values into the closure env at allocation time."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
envSetFuncType : (emptyList: List a) -> WasmFuncType
envSetFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) (appendItem (I32) (appendItem (Externref) emptyList)),
    results = emptyList
  }

@label "Env-get func type"
@description "Build the (externref, i32) -> externref WasmFuncType for the $fenel.envGet runtime helper. Used by lowerClosure's body-prologue emission to load each capture from the env at body entry."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
envGetFuncType : (emptyList: List a) -> WasmFuncType
envGetFuncType emptyList =
  WasmFuncType {
    params = appendItem (I32) (appendItem (Externref) emptyList),
    results = appendItem (Externref) emptyList
  }

@label "Make-closure func type"
@description "Build the (externref, externref) -> externref WasmFuncType for the $fenel.makeClosure runtime helper. Used by lowerClosure to materialise the (body-export-name, env-handle) closure value."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
makeClosureFuncType : (emptyList: List a) -> WasmFuncType
makeClosureFuncType emptyList =
  WasmFuncType {
    params = appendItem (Externref) (appendItem (Externref) emptyList),
    results = appendItem (Externref) emptyList
  }

-- ---------------------------------------------------------------------------
-- valTypeEq — structural equality on the simple WasmValType variants the
-- closure-body lowering emits (I32 / F64 / Externref). RefStruct / RefArray
-- carry a typeIdx; the closure body never emits them so $tag equality is
-- sufficient. Mirrors compile-wasm.ts:valTypeEqual (561-567) for the
-- subset Phase 21.7 commit 8 needs.
-- ---------------------------------------------------------------------------
@label "Wasm valType equality"
@description "Structural $tag-equality on the simple WasmValType variants the closure-body lowering emits (I32 / I64 / F32 / F64 / Externref / Funcref). RefStruct / RefArray fall through to false since the closure body never emits them; full structural equality (with typeIdx compare) is deferred to a future commit if needed."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
valTypeEq : (a: WasmValType) -> (b: WasmValType) -> Boolean
valTypeEq a b =
  case a of
    I32 ->
      case b of
        I32 -> true
        _ -> false
    I64 ->
      case b of
        I64 -> true
        _ -> false
    F32 ->
      case b of
        F32 -> true
        _ -> false
    F64 ->
      case b of
        F64 -> true
        _ -> false
    Externref ->
      case b of
        Externref -> true
        _ -> false
    Funcref ->
      case b of
        Funcref -> true
        _ -> false
    _ -> false

-- ---------------------------------------------------------------------------
-- mapDomainsToValTypes — extract WasmValType from each {domain} entry in a
-- declaredLocals list. Forward-recursive walk + appendItem snoc. The output
-- is the input to rleLocals.
-- ---------------------------------------------------------------------------
@label "Map domains to valTypes"
@description "Extract WasmValType from each {domain} entry in a declaredLocals list. Forward-recursive walk + appendItem snoc; output feeds rleLocals."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
mapDomainsToValTypes : (decls: List ({ domain: WasmDomain })) -> (acc: List WasmValType) -> List WasmValType
mapDomainsToValTypes decls acc =
  case head decls of
    Nothing -> acc
    Just d ->
      let vt = domainToValType (d.domain)
      let next = appendItem vt acc
      case tail decls of
        Nothing -> next
        Just rest -> mapDomainsToValTypes rest next

-- ---------------------------------------------------------------------------
-- rleLocals — run-length-encode a flat WasmValType list into Wasm's
-- preferred shape (consecutive locals of the same type are coalesced into
-- one WasmLocalDecl). Mirrors compile-wasm.ts:rleLocals (1819-1834).
--
-- Two-state walker: tracks a `current = {count, valType}` and an
-- accumulator. On match: bump count. On mismatch: push current, start
-- new. At end: push final current.
-- ---------------------------------------------------------------------------
@label "RLE-encode Wasm locals"
@description "Run-length-encode a flat WasmValType list into Wasm's preferred shape (consecutive locals of the same type are coalesced into one WasmLocalDecl). Mirrors compile-wasm.ts:rleLocals."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
rleLocals : (types: a) -> (emptyList: List a) -> a
rleLocals types emptyList =
  case head types of
    Nothing -> emptyList
    Just t0 ->
      case tail types of
        Nothing -> appendItem (WasmLocalDecl { count = 1, valType = t0 }) emptyList
        Just rest ->
          rleLocalsLoop rest 1 t0 emptyList

@label "RLE-encode Wasm locals (loop)"
@description "Tail-recursive loop body for rleLocals. Two-state walker: tracks (curCount, curVt) + an accumulator. On match: bump count. On mismatch: push current, start new. At end of list: push final."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
rleLocalsLoop : (rest: a) -> (curCount: Number) -> (curVt: WasmValType) -> (acc: a) -> a
rleLocalsLoop rest curCount curVt acc =
  case head rest of
    Nothing ->
      appendItem (WasmLocalDecl { count = curCount, valType = curVt }) acc
    Just t ->
      if valTypeEq curVt t
      then
        case tail rest of
          Nothing ->
            appendItem (WasmLocalDecl { count = add curCount 1, valType = curVt }) acc
          Just more -> rleLocalsLoop more (add curCount 1) curVt acc
      else
        let acc2 = appendItem (WasmLocalDecl { count = curCount, valType = curVt }) acc
        case tail rest of
          Nothing ->
            appendItem (WasmLocalDecl { count = 1, valType = t }) acc2
          Just more -> rleLocalsLoop more 1 t acc2

-- ---------------------------------------------------------------------------
-- buildClosureBodyParams — produce a List<{name, domain=DomRef}> from
-- [$env, ...lambdaParams]. The output is the arg to enterClosureBody;
-- each entry pre-binds one positional slot at indices 0..N in the body
-- frame. Forward-recursive walk + appendItem snoc.
-- ---------------------------------------------------------------------------
@label "Build closure body params"
@description "Produce a List<{name, domain=DomRef}> from a List<String> of names. Each entry pre-binds one positional slot at indices 0..N in the body frame. Forward-recursive walk + appendItem snoc."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
buildClosureBodyParams : (params: List String) -> (acc: List ({ name: String, domain: WasmDomain })) -> List ({ name: String, domain: WasmDomain })
buildClosureBodyParams params acc =
  case head params of
    Nothing -> acc
    Just p ->
      let next = appendItem { name = p, domain = DomRef } acc
      case tail params of
        Nothing -> next
        Just rest -> buildClosureBodyParams rest next

-- buildClosureBodyParamsWithEnv — seed the param-record accumulator with
-- the $env entry first, THEN fold the lambda params after. The order is
-- load-bearing: enterClosureBody binds entries at indices 0..N in the
-- order they appear in the list, so "$env" MUST be the first entry to
-- match the closure ABI ($env at idx 0, lambda params at 1..N).
@label "Build closure body params (with env)"
@description "Prepend \"$env\" to the lambda params and delegate to buildClosureBodyParams. Two-step so the body file can keep the empty-acc seeding explicit."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
buildClosureBodyParamsWithEnv : (params: a) -> (emptyList: List a) -> a
buildClosureBodyParamsWithEnv params emptyList =
  let withEnv = appendItem { name = "$env", domain = DomRef } emptyList
  buildClosureBodyParams params withEnv

-- ---------------------------------------------------------------------------
-- resolveCaptureOperands — for each capture name, look it up in the
-- CALLER's locals and build a mini-instr-list: LocalGet + coerce-to-DomRef.
-- Returns Result<List<List<WasmInstr>>>; Err on out-of-scope.
--
-- MUST run BEFORE enterClosureBody since the capture names live in the
-- caller's scope (the captured-from-outer names, not the body's). Mirrors
-- compile-wasm.ts:885-900.
-- ---------------------------------------------------------------------------
@label "Resolve closure capture operands"
@description "For each capture name, look it up in the CALLER's locals and build a mini-instr-list: LocalGet + coerce-to-DomRef. Returns Result<List<List<WasmInstr>>>; Err on out-of-scope. MUST run BEFORE enterClosureBody since the capture names live in the caller's scope. Mirrors compile-wasm.ts:885-900."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
resolveCaptureOperands : (captures: a) -> (emptyList: List a) -> a
resolveCaptureOperands captures emptyList =
  resolveCaptureOperandsLoop captures emptyList emptyList

@label "Resolve closure capture operands (loop)"
@description "Tail-recursive loop body for resolveCaptureOperands. Per-iteration: lookupLocal name → Err if Nothing, else LocalGet + coerce-to-DomRef + append + recurse."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
resolveCaptureOperandsLoop : (captures: a) -> (acc: a) -> (emptyList: List a) -> a
resolveCaptureOperandsLoop captures acc emptyList =
  case head captures of
    Nothing -> Ok acc
    Just name ->
      let loc = lookupLocal name
      case loc of
        Nothing -> Err (Unsupported {
          reason = join ["CeClosure capture '", name, "' not in scope at Wasm lowering"] "",
          node = name
        })
        Just entry ->
          let base = appendItem (LocalGet { index = entry.index }) emptyList
          let coerced = coerceDomain base (entry.domain) (DomRef) emptyList
          let next = appendItem (coerced.instrs) acc
          case tail captures of
            Nothing -> Ok next
            Just rest -> resolveCaptureOperandsLoop rest next emptyList

-- ---------------------------------------------------------------------------
-- emitCaptureLoadPrologue — emit the body's capture-loading prologue. For
-- each i in 0..captures.length-1, with name = captures[i]:
--   LocalGet $env_idx; I32Const i; Call envGetIdx; allocLocal name DomRef;
--   LocalSet captureLocalIdx.
-- Returns the accumulated body-prologue instr list (consumed by step 5's
-- body-lowering as the seed). Mirrors compile-wasm.ts:910-922.
--
-- Runs INSIDE the body frame (after enterClosureBody) — allocLocal here
-- pushes into the body's declaredLocals + sets the name in the body's
-- locals map at the body-frame index.
-- ---------------------------------------------------------------------------
@label "Emit closure capture-load prologue"
@description "Emit the body's capture-loading prologue. For each i in 0..captures.length-1: LocalGet $env_idx + I32Const i + Call envGet + allocLocal name DomRef + LocalSet. Runs INSIDE the body frame so allocLocal pushes into the body's declaredLocals + sets the name in the body's locals map. Mirrors compile-wasm.ts:910-922."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitCaptureLoadPrologue : (captures: a) -> (envIdx: Number) -> (envGetIdx: Number) -> (idx: Number) -> (acc: a) -> a
emitCaptureLoadPrologue captures envIdx envGetIdx idx acc =
  case head captures of
    Nothing -> acc
    Just name ->
      let with1 = appendItem (LocalGet { index = envIdx }) acc
      let with2 = appendItem (I32Const { value = idx }) with1
      let with3 = appendItem (Call { funcIdx = envGetIdx }) with2
      let captureLocalIdx = allocLocal name (DomRef)
      let with4 = appendItem (LocalSet { index = captureLocalIdx }) with3
      case tail captures of
        Nothing -> with4
        Just rest ->
          emitCaptureLoadPrologue rest envIdx envGetIdx (add idx 1) with4

-- ---------------------------------------------------------------------------
-- emitClosureConstruction — emit the closure-construction sequence into
-- the caller's `out` (after the body WasmFunc has been registered). For
-- each capture i:
--   LocalGet envLocalIdx; I32Const i; <capture-mini-instrs>; Call envSetIdx.
-- Followed by:
--   I32Const (internString clName); Call litStringIdx;
--   LocalGet envLocalIdx; Call makeClosureIdx.
-- Mirrors compile-wasm.ts:965-982.
-- ---------------------------------------------------------------------------
@label "Emit closure construction"
@description "Emit the closure-construction sequence into the caller's out (after the body WasmFunc has been registered). For each capture i: LocalGet envLocalIdx + I32Const i + <capture-mini-instrs> + Call envSet. Mirrors compile-wasm.ts:965-975."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
emitClosureConstruction : (captureOperands: a) -> (envLocalIdx: Number) -> (envSetIdx: Number) -> (idx: Number) -> (acc: a) -> a
emitClosureConstruction captureOperands envLocalIdx envSetIdx idx acc =
  case head captureOperands of
    Nothing -> acc
    Just capInstrs ->
      let with1 = appendItem (LocalGet { index = envLocalIdx }) acc
      let with2 = appendItem (I32Const { value = idx }) with1
      let with3 = concat with2 capInstrs
      let with4 = appendItem (Call { funcIdx = envSetIdx }) with3
      case tail captureOperands of
        Nothing -> with4
        Just rest ->
          emitClosureConstruction rest envLocalIdx envSetIdx (add idx 1) with4

-- ---------------------------------------------------------------------------
-- lowerClosure — the CeClosure arm entry. Orchestrates steps 1-8 of the
-- algorithm above. Returns Result<LowerOutput> with domain=DomRef (the
-- closure handle is an externref).
-- ---------------------------------------------------------------------------
@label "Lower Wasm CeClosure"
@description "CeClosure arm entry. Allocates a fresh closure id + name; resolves captures in the CALLER's scope; enterClosureBody installs a fresh frame with [$env, ...params]; emits the capture-load prologue; lowers the body at DomRef; exitClosureBody restores the caller's frame; assembles + registers the body WasmFunc + WasmExport; emits the closure-construction sequence (envAlloc + per-capture envSet + makeClosure → externref handle) into the caller's out. Mirrors compile-wasm.ts:lowerClosure (872-985)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
lowerClosure : (params: a) -> (captures: a) -> (body: a) -> (emptyList: List a) -> Result a LowerOutput
lowerClosure params captures body emptyList =
  -- Step 1: fresh closure id + name.
  let clId = nextClosureId ()
  let entryName = getEntryName ()
  let clName = join [entryName, "__cl", toString clId] ""
  -- Step 2: resolve captures in the CALLER's scope.
  let capOperandsR = resolveCaptureOperands captures emptyList
  case capOperandsR of
    Err err -> Err err
    Ok captureOperands ->
      -- Step 3: enter body frame with [$env, ...params] pre-bound.
      let bodyParams = buildClosureBodyParamsWithEnv params emptyList
      let snap = enterClosureBody bodyParams
      -- Step 4: capture-loading prologue inside the body.
      let envLocM = lookupLocal "$env"
      case envLocM of
        Nothing ->
          -- Should never happen — enterClosureBody just pre-bound it. Bail
          -- defensively rather than crashing if a future refactor breaks
          -- the invariant.
          let _restore = exitClosureBody snap
          Err (Unsupported {
            reason = "CeClosure body frame missing $env after enterClosureBody",
            node = clName
          })
        Just envLocEntry ->
          let envIdx = envLocEntry.index
          -- Gate envGet intern on non-empty captures (mirrors TS oracle's
          -- for-loop structure: the import is registered inside the loop,
          -- so it never fires when captures is []). Empty-prologue path
          -- returns the seed acc unchanged.
          let bodyPrologue = case head captures of
            Nothing -> emptyList
            Just _ ->
              let envGetIdx = internImport "envGet" (envGetFuncType emptyList)
              emitCaptureLoadPrologue captures envIdx envGetIdx 0 emptyList
          -- Step 5: lower the body proper at target=DomRef.
          let bodyR = lowerExprWithTarget body (DomRef) emptyList
          case bodyR of
            Err err ->
              let _restore = exitClosureBody snap
              Err err
            Ok bodyOut ->
              let bodyInstrs = concat bodyPrologue (bodyOut.instrs)
              -- Step 6: exit body frame; retrieve body's declaredLocals.
              let bodyDecls = exitClosureBody snap
              -- Step 7: assemble WasmFunc + WasmExport.
              let bodyFt = callClosureFuncType (length params) emptyList
              let _typeIdx = internType bodyFt
              let bodyValTypes = mapDomainsToValTypes bodyDecls emptyList
              let bodyLocals = rleLocals bodyValTypes emptyList
              let bodyFunc = WasmFunc {
                name = clName,
                funcType = bodyFt,
                locals = bodyLocals,
                body = bodyInstrs
              }
              let _addFn = addPendingFunc bodyFunc
              let bodyExp = WasmExport {
                name = clName,
                kind = "func",
                index = -1
              }
              let _addExp = addPendingExport bodyExp
              -- Step 8: closure-construction sequence into caller's out.
              let envAllocIdx = internImport "envAlloc" (envAllocFuncType emptyList)
              let envSetIdx = internImport "envSet" (envSetFuncType emptyList)
              let makeClosureIdx = internImport "makeClosure" (makeClosureFuncType emptyList)
              let litStringIdx = internImport "litString" (litStringFuncType emptyList)
              let envLocalIdx = allocLocal (join ["$env_", toString clId] "") (DomRef)
              -- Build env: I32Const N; Call envAlloc; LocalSet envLocalIdx.
              let withAlloc1 = appendItem (I32Const { value = length captures }) emptyList
              let withAlloc2 = appendItem (Call { funcIdx = envAllocIdx }) withAlloc1
              let withAlloc3 = appendItem (LocalSet { index = envLocalIdx }) withAlloc2
              -- Populate env: per-capture envSet sequence.
              let withSets = emitClosureConstruction captureOperands envLocalIdx envSetIdx 0 withAlloc3
              -- Push (clName, env) and call makeClosure.
              let nameIdx = internString clName
              let withName1 = appendItem (I32Const { value = nameIdx }) withSets
              let withName2 = appendItem (Call { funcIdx = litStringIdx }) withName1
              let withName3 = appendItem (LocalGet { index = envLocalIdx }) withName2
              let final = appendItem (Call { funcIdx = makeClosureIdx }) withName3
              Ok (LowerOutput { instrs = final, domain = DomRef })

-- ---------------------------------------------------------------------------
-- Phase 21.7 commit 9 — program-level `lowerToWasmAst` entry. Takes a
-- ClosuresExplicitProgram + pre-computed (paramDomains, externalReturn)
-- from the dispatch wrapper's TS-side `inferDomains` walk; assembles the
-- WasmModule envelope by orchestrating: per-CeExpr body lowering →
-- entry-function assembly → builder-state read → closure-export index
-- fixup → import shape rebuild → component-export metadata → final
-- WasmModule construction.
--
-- Mirrors compile-wasm.ts:lowerProgramToWasm (1713-1815). The two
-- substantive divergences from a literal port are:
--
--   1. Domain inference stays TS-side (Option II from the brief) — the
--      dispatch wrapper runs `inferDomains` and marshals the result as
--      (paramDomains, externalReturn) body args. The body never walks
--      the inference itself; the per-CeExpr lowering's `domainOf` covers
--      only the local branch-domain inference for CeIf.
--   2. The body always carries `stringPool` (empty list when no strings
--      were interned); the dispatch wrapper strips the field from the
--      wire shape when empty to match the TS oracle's conditional
--      `...(stringPool.length > 0 ? { stringPool } : {})`.
--
-- componentExports — the entry uses a plain Fenel record literal
-- `{name = ..., params = ...}` rather than a tagged `WasmComponentExport
-- { ... }` constructor because the TS oracle emits an untagged
-- record (the WasmComponentExport type at ir/wasm-ast.ts:355 has no `$tag`
-- field and no `returnType` field on the wire). Using a plain record
-- keeps the body's output byte-equal to the oracle's; the declared
-- WasmComponentExport entity stays in the registry for catalog
-- completeness but isn't used as a constructor here.
-- ---------------------------------------------------------------------------

-- fixupClosureExportIndices — walk pendingExports replacing each `index = -1`
-- sentinel (from commit 8's addPendingExport at lowerClosure step 7) with
-- the definitive `importCount + idx`. Mirrors compile-wasm.ts:1776-1779
-- (`b.pendingExports.map((exp, i) => ({ ...exp, index: importCount + i }))`).
@label "Fix up closure export indices"
@description "Walk the builder's pendingExports list (each with sentinel `index = -1` from commit 8's addPendingExport) replacing each index with `importCount + i` so closure-body exports land at the correct function-index space position. Mirrors compile-wasm.ts:1776-1779."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
fixupClosureExportIndices : (pendingExports: a) -> (importCount: Number) -> (idx: Number) -> (acc: a) -> a
fixupClosureExportIndices pendingExports importCount idx acc =
  case head pendingExports of
    Nothing -> acc
    Just exp ->
      let fixed = WasmExport {
        name = exp.name,
        kind = exp.kind,
        index = add importCount idx
      }
      let next = appendItem fixed acc
      case tail pendingExports of
        Nothing -> next
        Just rest ->
          fixupClosureExportIndices rest importCount (add idx 1) next

-- buildWasmImports — walk the builder's raw imports (each {module, name,
-- typeIdx}) building a List<WasmFuncImport> with funcType resolved from
-- `types[imp.typeIdx]`. Mirrors compile-wasm.ts:1790-1795. The defensive
-- Nothing branch on listIndex should never fire (typeIdx was set by
-- internImport when the import was registered); we keep it as a safety
-- net rather than crashing.
@label "Build WasmFuncImport list"
@description "Walk the builder's raw imports list (each {module, name, typeIdx}), dereferencing `imp.typeIdx` against the types list to resolve each import's funcType. Emits WasmFuncImport records with the resolved funcType inline. Mirrors compile-wasm.ts:1790-1795."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
buildWasmImports : (imports: a) -> (types: a) -> (emptyList: List a) -> (acc: a) -> a
buildWasmImports imports types emptyList acc =
  case head imports of
    Nothing -> acc
    Just imp ->
      let ftM = listIndex types (imp.typeIdx)
      let ft = case ftM of
        Nothing -> WasmFuncType { params = emptyList, results = emptyList }
        Just t -> t
      let wfi = WasmFuncImport {
        module = imp.module,
        name = imp.name,
        funcType = ft
      }
      let next = appendItem wfi acc
      case tail imports of
        Nothing -> next
        Just rest ->
          buildWasmImports rest types emptyList next

-- lowerToWasmAst — entry point. The dispatch wrapper feeds paramDomains
-- (the inferred + DomUnknown-defaulted-to-DomNum-then-DomBool-to-DomRef
-- coerced result) and externalReturn (the externally-visible boundary
-- domain) so the body doesn't need to know about inferDomains. The
-- emptyList is the universal accumulator seed.
@label "Lower ClosuresExplicit to WasmModule"
@description "Program-level entry on the Wasm pipeline. Takes a ClosuresExplicitProgram + pre-computed (paramDomains, externalReturn) from the dispatch wrapper's TS-side `inferDomains` walk and assembles a typed WasmModule. Algorithm: seedEntryParams → lowerExprWithTarget at externalReturn → entry WasmFunc assembly via mapDomainsToValTypes + rleLocals → builder-state read via 6 getter natives → closure-export index fixup → WasmFuncImport list reconstruction → component-export metadata → WasmModule envelope. Mirrors compile-wasm.ts:lowerProgramToWasm (1713-1815). Phase 21.7 commit 9 — closes the per-CeExpr surface from commit 8 with the program-level entry, making 'Fenel compiles itself to a typed Wasm AST' an end-to-end claim through the engine evaluator (modulo serializeWasmModule, the final binary encode)."
@tags "engine" "ir" "wasm" "self-host" "phase-21"
lowerToWasmAst : (program: { name: String, params: a, body: (CeExpr Any) }) -> (paramDomains: a) -> (externalReturn: WasmDomain) -> (emptyList: List a) -> Result a WasmModule
lowerToWasmAst program paramDomains externalReturn emptyList =
  let _seed = seedEntryParams paramDomains
  let bodyR = lowerExprWithTarget (program.body) externalReturn emptyList
  case bodyR of
    Err err -> Err err
    Ok bodyOut ->
      let bodyDecls = getEntryDeclaredLocals ()
      let paramValTypes = mapDomainsToValTypes paramDomains emptyList
      let entryFt = WasmFuncType {
        params = paramValTypes,
        results = appendItem (domainToValType externalReturn) emptyList
      }
      let _typeIdx = internType entryFt
      let bodyValTypes = mapDomainsToValTypes bodyDecls emptyList
      let entryLocals = rleLocals bodyValTypes emptyList
      let entryFunc = WasmFunc {
        name = program.name,
        funcType = entryFt,
        locals = entryLocals,
        body = bodyOut.instrs
      }
      let imports = getImports ()
      let types = getTypes ()
      let pendingFuncs = getPendingFuncs ()
      let pendingExports = getPendingExports ()
      let stringPool = getStringPool ()
      let importCount = length imports
      let allFuncs = concat pendingFuncs (appendItem entryFunc emptyList)
      let entryExportIdx = add importCount (length pendingFuncs)
      let fixedClosureExports = fixupClosureExportIndices pendingExports importCount 0 emptyList
      let entryExport = WasmExport {
        name = program.name,
        kind = "func",
        index = entryExportIdx
      }
      let allExports = concat fixedClosureExports (appendItem entryExport emptyList)
      let wasmImports = buildWasmImports imports types emptyList emptyList
      let compExport = { name = program.name, params = program.params }
      let compExports = appendItem compExport emptyList
      Ok (WasmModule {
        name = program.name,
        fieldSlots = program.params,
        types = types,
        imports = wasmImports,
        funcs = allFuncs,
        exports = allExports,
        componentExports = compExports,
        stringPool = stringPool
      })

-- ---------------------------------------------------------------------------
-- Phase 21.7.1 — forward-walk type inference (inferDomains +
-- propagateCeVarDomain + walkForDomainPropagation). Closes the last
-- TS-only piece of the Wasm lowering pipeline.
--
-- Substrate: a `HasDomainEnv` capability backed by a per-call mutable
-- Map<String, WasmDomain> on the TS side. The dispatch wrapper binds
-- three natives — `getDomain`, `setDomain`, `getEnvEntries` — onto
-- ctx.natives at evaluation time; the body invokes them syntactically
-- as bare codeName calls (matching the HasWasmBuilder pattern from
-- commit 2). Second application of the per-call-mutable-state typeclass
-- pattern; the substrate work is identical in shape to commit 2's.
--
-- Algorithm: a forward walker over CeExpr that propagates expected
-- argument domains into the env. Each binding's domain refines (one-way:
-- `undefined` or DomUnknown → expected) the first time a typed context
-- demands it; downstream uses see the refined domain. The 4
-- externref-producing arms (CeClosure / CeConstruct / CeRecord /
-- CeMatch) delegate to `walkForDomainPropagation` for child-CeVar
-- refinement and return DomRef directly.
--
-- Watch-outs preserved from the TS oracle:
--   - propagateCeVarDomain is ONE-WAY: never overwrites a concrete
--     domain. Flipping DomNum→DomRef mid-walk would corrupt the
--     function-signature inference.
--   - Dotted-CeVar HEAD propagation: both `propagateCeVarDomain` and
--     the CeVar arm of `inferDomains` force the HEAD binding to DomRef.
--     Load-bearing for `bot.token`-style access — without it the head
--     local settles on the caller's default (usually DomNum) and the
--     call-boundary unboxes the record handle to NaN.
--   - CeIf branch agreement: when then/else dom-tags match, return that
--     domain; otherwise DomRef (the safe boundary type). Mirrors the
--     TS oracle's `body.$tag === elseDom.$tag` check.
--   - CeConstruct / CeRecord / CeMatch CeVar-field/scrutinee →
--     propagate(DomRef). Phase 21.5.2's substrate fix; without it
--     string-typed fields unbox to F64 at the call boundary and the
--     downstream comparison-vs-NaN cascade fails silently.
-- ---------------------------------------------------------------------------

-- refineDomain — one-way refinement primitive. setDomain iff the current
-- entry is absent (Nothing) or DomUnknown. Returns True as a unit-like
-- placeholder so call sites can use `let _x = refineDomain ...` to
-- sequence the mutation. Mirrors compile-wasm.ts:propagateCeVarDomain's
-- inner `current === undefined || current.$tag === "DomUnknown"` guard.
@label "Refine domain (one-way)"
@description "One-way env refinement primitive. setDomain iff the current entry is Nothing or DomUnknown — never overwrites a concrete domain. Returns True as a unit-like placeholder. Mirrors the inner guard at compile-wasm.ts:propagateCeVarDomain."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
refineDomain : (name: String) -> (expected: WasmDomain) -> Boolean
refineDomain name expected =
  let cur = getDomain name
  case cur of
    Nothing ->
      let _set = setDomain name expected
      true
    Just d ->
      case d of
        DomUnknown ->
          let _set = setDomain name expected
          true
        _ -> true

-- propagateCeVarDomain — refine a CeVar's binding domain, honouring the
-- dotted-name HEAD special case. Mirrors compile-wasm.ts:263. For dotted
-- names the HEAD binding refines to DomRef (the record/ADT handle); the
-- leaf domain is DomRef regardless of `expected`. For undotted names the
-- binding refines to `expected`.
@label "Propagate CeVar domain"
@description "Refine a CeVar's binding domain in the env, honouring the dotted-name HEAD special case. For dotted names the HEAD binding refines to DomRef regardless of `expected` (the record/ADT handle MUST be externref so the getFieldNamed chain can dereference it). For undotted names the binding refines to `expected`. Mirrors compile-wasm.ts:263."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
propagateCeVarDomain : (varName: String) -> (expected: WasmDomain) -> Boolean
propagateCeVarDomain varName expected =
  if contains varName "."
  then
    let parts = split varName "."
    case head parts of
      Nothing -> true
      Just headName -> refineDomain headName (DomRef)
  else refineDomain varName expected

-- inferOrPropagate — small dispatch helper used by every CeCall /
-- CeConstruct / CeRecord / CeMatch arg-walk site. If `a` is a CeVar,
-- propagate the expected domain into the env; otherwise recurse via
-- inferDomains (ignoring the returned result domain — we only care
-- about the env-mutation side effects from nested CeVar references).
@label "Propagate or recurse"
@description "Dispatch helper used by every CeCall / CeConstruct / CeRecord / CeMatch arg-walk site. CeVar → propagateCeVarDomain; else → inferDomains (recurse for nested CeVar references; the returned domain is discarded)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferOrPropagate : (a: (CeExpr Any)) -> (expected: WasmDomain) -> (emptyList: List a) -> Boolean
inferOrPropagate a expected emptyList =
  case a of
    CeVar { name = n } -> propagateCeVarDomain n expected
    _ ->
      let _d = inferDomains a emptyList
      true

-- ---------------------------------------------------------------------------
-- Phase 5b23 — constructor-tag-to-closure-param-domain table.
--
-- Maps ctor name → expected closure-body param domains. Used by the
-- CeConstruct arm of `inferDomains` to seed the inner CeClosure's param
-- domains in the inference env BEFORE the body walk recurses. Without
-- this seed the closure body's CeVar references default to DomUnknown
-- (only the dotted-CeVar HEAD rule refines them — captured-var-only or
-- bare param-arg bodies miss the refinement, then box at the boundary).
--
-- Today's table covers the three ctor-wrapping-arity-1-closure shapes
-- in the std modules:
--   - Field (picture)  → Point → RgbaPixel   (closure param Point)
--   - Animate (animation) → Time → Picture (closure param Time)
--   - Wave (sound)     → Time → Amplitude (closure param Time)
--
-- Each closure param's expected domain is DomRef (Point / Time / record
-- handles all flow as externref through the WASM ABI). The List<DomRef>
-- structure leaves room for future multi-arg / mixed-domain ctor-
-- wrapping-closure shapes — extend the table per new shape; no
-- inferDomains-walker changes needed.
--
-- Returns `Maybe (List WasmDomain)` so the seeding helper can short-
-- circuit on non-matching ctors. Watch-out: the table is name-keyed
-- (string equality). Future parametric tag types or constructor
-- renames need to update the entries here.
-- ---------------------------------------------------------------------------
@label "Constructor → inner-closure param domains"
@description "Phase 5b23 — tag-keyed table from constructor name to its inner closure's expected param-domain list (Maybe (List WasmDomain)). Today covers Field (picture) / Animate (animation) / Wave (sound) — all arity-1 closures whose param is a record-handle (Point / Time). Returns Nothing for non-closure-wrapping ctors so the seeding short-circuits."
@tags "engine" "internal" "wasm" "phase-5b23"
@category "engine-internal"
ctorClosureParamDomains : (ctorName: String) -> a
ctorClosureParamDomains ctorName =
  if eq ctorName "Field" then
    Just (appendItem (DomRef) [])
  else if eq ctorName "Animate" then
    Just (appendItem (DomRef) [])
  else if eq ctorName "Wave" then
    Just (appendItem (DomRef) [])
  else Nothing

-- seedCtorClosureParams — for ctors in the table, walk the CeConstruct's
-- args looking for CeClosure entries; seed each closure's param names
-- AND each closure's capture names with DomRef in the inference env
-- via refineDomain.
--
-- Param seeding ensures non-dotted body references to the lambda's
-- params (e.g. `p` passed directly to `dist p c` in picture:circle)
-- infer the closure body's references to DomRef. Without it the
-- DomUnknown default propagates through and downstream value-shape
-- mismatches manifest as runtime NaN / null.
--
-- Capture seeding ensures the OUTER-scope binding for each capture
-- name infers to DomRef so the caller-side capture-loading
-- (resolveCaptureOperands → coerceDomain entry.domain DomRef)
-- becomes a no-op rather than inserting a `boxNum` coercion that
-- mangles a record handle into NaN. For Field / Animate / Wave
-- inner closures the captures always carry record-like ADT
-- handles (Point / RgbaPixel / Time / Animation / Sound), so DomRef
-- refinement is correct at the outer boundary.
--
-- One-way refinement: never overwrites a concrete DomNum / DomBool /
-- DomRef already in the env. A number captured into the closure
-- AND used arithmetically in the body (e.g. `r` in picture:circle
-- via `lte r ...`) keeps its body-walk-propagated DomNum at the
-- outer boundary — the capture-load's coerceDomain then inserts
-- boxNum to bridge into the externref env, which boxNum handles
-- correctly for primitives.
--
-- Returns True as a unit-like placeholder; the side effect is env
-- mutation through refineDomain.
@label "Seed ctor-wrapped closure param + capture domains"
@description "Phase 5b23 — for ctors with a CTOR_CLOSURE_PARAM_DOMAINS entry, walk the CeConstruct's args looking for CeClosure values and seed each closure's param + capture names with DomRef in the inference env (via refineDomain). Param seeding ensures non-dotted body references infer DomRef; capture seeding ensures the OUTER-scope binding for each capture name doesn't boxNum a record into NaN at the caller-side capture-loading step. Side-effecting; returns True as a unit-like placeholder."
@tags "engine" "internal" "wasm" "phase-5b23"
@category "engine-internal"
seedCtorClosureParams : (ctorName: String) -> (args: a) -> Boolean
seedCtorClosureParams ctorName args =
  case ctorClosureParamDomains ctorName of
    Nothing -> true
    Just domList -> seedCtorArgsLoop args domList

@label "Loop over ctor args dispatching seedCtorArgMaybe"
@description "Phase 5b23 — iterate over a CeConstruct's args list, calling seedCtorArgMaybe per arg with the table-declared domain list. Forward-recursive walk via head / tail."
@tags "engine" "internal" "wasm" "phase-5b23"
@category "engine-internal"
seedCtorArgsLoop : (args: a) -> (domList: a) -> Boolean
seedCtorArgsLoop args domList =
  case head args of
    Nothing -> true
    Just a ->
      let _s = seedCtorArgMaybe a domList
      case tail args of
        Nothing -> true
        Just rest -> seedCtorArgsLoop rest domList

-- seedCtorArgMaybe — single-arg dispatcher. Splits the case on `a`'s
-- shape into a top-level helper so the multi-statement CeClosure arm
-- can use let-sequencing without nesting inside another let-binding's
-- case-arm body (which the layout rule treats as one expression).
@label "Per-arg dispatch for ctor-wrapped closure seeding"
@description "Phase 5b23 — pattern-match a single CeConstruct arg. CeClosure shape → seedClosureParamsAt + seedClosureCapturesAt; other shapes → no-op. Split into a top-level helper so the CeClosure arm's two-statement body uses let-sequencing without nesting inside a let-binding's value (the layout rule treats that as a single expression)."
@tags "engine" "internal" "wasm" "phase-5b23"
@category "engine-internal"
seedCtorArgMaybe : (a: a) -> (domList: a) -> Boolean
seedCtorArgMaybe a domList =
  case a of
    CeClosure { params = ps, captures = cs, body = _b } ->
      let _p = seedClosureParamsAt ps domList
      let _c = seedClosureCapturesAt cs
      true
    _ -> true

-- seedClosureCapturesAt — refine each capture name in the outer scope
-- to DomRef. Uses one-way refineDomain so number captures already
-- constrained to DomNum keep their resolved domain — the seed only
-- fires for as-yet-unresolved names (Nothing / DomUnknown), which is
-- the record-handle capture class for Field / Animate / Wave bodies.
@label "Refine each closure capture to DomRef"
@description "Phase 5b23 — walk the closure's captures list refining each name in the outer-scope inference env to DomRef via refineDomain (one-way). Closes the boxNum-on-record-capture bug at the closure-construction step for picture:solid / circle / checkerboard."
@tags "engine" "internal" "wasm" "phase-5b23"
@category "engine-internal"
seedClosureCapturesAt : (captures: a) -> Boolean
seedClosureCapturesAt captures =
  case head captures of
    Nothing -> true
    Just name ->
      let _r = refineDomain name (DomRef)
      case tail captures of
        Nothing -> true
        Just rest -> seedClosureCapturesAt rest

-- seedClosureParamsAt — zip a closure's param-name list with the table-
-- declared domain list; refine each name to the matched domain. When
-- the domain list runs short, default extras to DomNum (mirrors
-- inferCallArgsWithDomains' `argDomains[i] ?? DOM_NUM` fallback shape,
-- adapted for the seeding direction — though today's table is arity-1
-- across all entries so the extras path is unexercised).
@label "Zip closure params with table domains; refine each"
@description "Phase 5b23 — zip a closure's param-name list with the table-declared domain list; refine each name to the matched domain via refineDomain. Extras (params beyond the domain list) default to DomNum, mirroring inferCallArgsWithDomains' argDomains[i] fallback shape. Today's table is arity-1 across all entries so the extras path is unexercised."
@tags "engine" "internal" "wasm" "phase-5b23"
@category "engine-internal"
seedClosureParamsAt : (params: a) -> (domains: a) -> Boolean
seedClosureParamsAt params domains =
  case head params of
    Nothing -> true
    Just p ->
      let expected = case head domains of
        Nothing -> DomNum
        Just e -> e
      let _r = refineDomain p expected
      let restDoms = case tail domains of
        Nothing -> []
        Just rd -> rd
      case tail params of
        Nothing -> true
        Just rest -> seedClosureParamsAt rest restDoms

-- ---------------------------------------------------------------------------
-- inferDomains — entry. 10-arm dispatch over CeExpr.
-- Mirrors compile-wasm.ts:290 (the TS oracle).
-- ---------------------------------------------------------------------------
@label "Forward-walk type inference"
@description "Forward-walk type inference. 10-arm CeExpr dispatch propagating expected argument domains into the per-call HasDomainEnv via getDomain / setDomain natives. Param domains start DomUnknown; refine the first time the body uses them in a typed context. Lets the lowering pick f64 for `add a b` and externref for `concat a b` without source-level annotations. Mirrors compile-wasm.ts:290 (the TS oracle deleted in Phase 21.7.1)."
@tags "engine" "ir" "wasm" "self-host" "phase-21"
inferDomains : (body: (CeExpr Any)) -> (emptyList: List a) -> WasmDomain
inferDomains body emptyList =
  case body of
    CeLit { value = v } -> domainOfLit v
    CeVar { name = n } -> inferCeVarDom n
    CeCall { fnId = fnId, args = args } -> inferCeCall fnId args emptyList
    CeIf { cond = c, then = t, else = e } -> inferCeIf c t e emptyList
    CeLet { bindings = bs, body = bd } -> inferCeLet bs bd emptyList
    CeDo { exprs = es } -> inferCeDo es (DomUnknown) emptyList
    CeClosure { params = _ps, captures = _cs, body = _b } ->
      let _w = walkForDomainPropagation body emptyList
      DomRef
    CeConstruct { ctor = c, args = a } ->
      -- Phase 5b23: seed constructor-wrapped lambda params with their
      -- closure-body param domains from CTOR_CLOSURE_PARAM_DOMAINS BEFORE
      -- the child walk recurses into the closure body. Without this seed
      -- the inner CeClosure's params default to DomUnknown; downstream
      -- inference of `p.x` etc. only refines via the dotted-CeVar HEAD
      -- rule, leaving non-dotted lambda-param references (and the
      -- captured-var-only body shape used by `picture:solid`) to box at
      -- the JS-target boundary or NaN at the WASM callClosure_<arity>
      -- ABI. Tag-keyed table (Field / Animate / Wave today) supplies the
      -- expected domain list; the seeding fires only for ctors with a
      -- registered entry so non-closure-wrapping ctors keep current
      -- walk behaviour.
      let _s = seedCtorClosureParams c a
      let _w = walkForDomainPropagation body emptyList
      -- Phase 5b13: zero-arg `True` / `False` infer to DomBool so a CeIf
      -- with such a branch + a CeVar branch can refine the CeVar to
      -- DomBool via inferBranchPropagation rather than defaulting to
      -- DomNum at the boundary.
      if eq (length a) 0
      then
        if eq c "True" then DomBool
        else if eq c "False" then DomBool
        else DomRef
      else DomRef
    CeRecord { fields = _fs } ->
      let _w = walkForDomainPropagation body emptyList
      DomRef
    CeMatch { scrutinee = _s, arms = _a } ->
      let _w = walkForDomainPropagation body emptyList
      DomRef

-- CeVar inference. Dotted: refine HEAD to DomRef, return DomRef (the
-- chain's leaf is always externref). Undotted: read the env entry,
-- default to DomUnknown when absent. Mirrors compile-wasm.ts:301-318.
@label "Infer CeVar domain"
@description "CeVar arm of inferDomains. Dotted names refine the HEAD to DomRef and return DomRef (the chain's leaf is always externref). Undotted names read the env entry, defaulting to DomUnknown when absent."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferCeVarDom : (n: String) -> WasmDomain
inferCeVarDom n =
  if contains n "."
  then
    let parts = split n "."
    let _h = case head parts of
      Nothing -> true
      Just headName -> refineDomain headName (DomRef)
    DomRef
  else
    let cur = getDomain n
    case cur of
      Nothing -> DomUnknown
      Just d -> d

-- CeCall inference. Three dispatch paths matching the TS oracle's CeCall
-- arm at compile-wasm.ts:319-367:
--   1. $dyn:<varName> — indirect call. Refine `varName` to DomRef; each
--      arg propagates DomRef. Result: DomRef.
--   2. isStringTypedEq — string-typed eq/neq. Each arg propagates DomRef.
--      Result: DomBool.
--   3. Default — callDomainOf's per-arg expected domains; each CeVar
--      arg propagates that domain. Result: cd.resultDomain.
@label "Infer CeCall domain"
@description "CeCall arm of inferDomains. Three dispatch paths: $dyn:<varName> indirect (each arg propagates DomRef, result DomRef); isStringTypedEq (each arg propagates DomRef, result DomBool); default (per-arg expected from callDomainOf, result from callDomainOf.resultDomain)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferCeCall : (fnId: String) -> (args: a) -> (emptyList: List a) -> WasmDomain
inferCeCall fnId args emptyList =
  if startsWith fnId "$dyn:"
  then inferDynCall fnId args emptyList
  else if isStringTypedEq fnId args emptyList
  then
    let _w = inferArgsAtDom args (DomRef) emptyList
    DomBool
  else
    let cd = callDomainOf fnId (length args) emptyList
    let _w = inferCallArgsWithDomains args (cd.argDomains) emptyList
    cd.resultDomain

@label "Infer $dyn: indirect call domain"
@description "$dyn:<varName> branch of inferCeCall. Refines the indirect-call var to DomRef; each arg propagates DomRef. Returns DomRef (closures travel as externref handles through the call boundary)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferDynCall : (fnId: String) -> (args: a) -> (emptyList: List a) -> WasmDomain
inferDynCall fnId args emptyList =
  let varName = slice fnId 5 (length fnId)
  let _r = refineDomain varName (DomRef)
  let _w = inferArgsAtDom args (DomRef) emptyList
  DomRef

-- For each arg, propagate `target` when CeVar, else recurse via
-- inferDomains. Used by the $dyn: and isStringTypedEq paths (both want
-- every arg at DomRef).
@label "Infer args at uniform domain"
@description "Walk args; for each one inferOrPropagate at the supplied target domain. Used by the $dyn: + isStringTypedEq paths (both want every arg at DomRef)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferArgsAtDom : (args: a) -> (target: WasmDomain) -> (emptyList: List a) -> Boolean
inferArgsAtDom args target emptyList =
  case head args of
    Nothing -> true
    Just a ->
      let _r = inferOrPropagate a target emptyList
      case tail args of
        Nothing -> true
        Just rest -> inferArgsAtDom rest target emptyList

-- Parallel walk over args + argDomains. When argDomains runs out before
-- args, default to DomRef per the TS oracle's `argDomains[i] ?? DOM_REF`.
@label "Infer args with per-position expected domains"
@description "Parallel walk over args + argDomains. Per-position expected domain drives inferOrPropagate. When argDomains runs out before args, defaults to DomRef (mirrors the TS oracle's `argDomains[i] ?? DOM_REF`)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferCallArgsWithDomains : (args: a) -> (argDomains: a) -> (emptyList: List a) -> Boolean
inferCallArgsWithDomains args argDomains emptyList =
  case head args of
    Nothing -> true
    Just a ->
      let expected = case head argDomains of
        Nothing -> DomRef
        Just e -> e
      let _r = inferOrPropagate a expected emptyList
      let restDoms = case tail argDomains of
        Nothing -> emptyList
        Just rd -> rd
      case tail args of
        Nothing -> true
        Just rest -> inferCallArgsWithDomains rest restDoms emptyList

-- CeIf inference. Cond propagates DomBool; then/else recurse; if both
-- branches agree on domain return that domain, else DomRef. Mirrors
-- compile-wasm.ts:368-382.
--
-- Phase 5b13 cross-arm refinement: when one branch is a CeVar whose env
-- entry is DomUnknown and the other branch has a known concrete domain
-- (DomBool / DomNum), propagate the concrete domain to the CeVar's
-- binding so the body's downstream lowering matches. Without this the
-- DomBool-vs-Unknown mismatch falls to DomRef and the CeVar's param
-- defaults to DomNum at the wrapper boundary — wrong representation for
-- a Bool-typed argument (manifests as compiled `and(true, true) → 1` vs
-- engine `true`). Knownness is asymmetric: DomUnknown / DomRef are
-- "don't know"; DomBool / DomNum are "do know".
@label "Infer CeIf domain"
@description "CeIf arm of inferDomains. Cond propagates DomBool; then/else recurse via inferDomains. Branch agreement: same dom-tag → that domain; otherwise DomRef (the safe boundary type)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferCeIf : (c: (CeExpr Any)) -> (t: (CeExpr Any)) -> (e: (CeExpr Any)) -> (emptyList: List a) -> WasmDomain
inferCeIf c t e emptyList =
  let _cond = inferOrPropagate c (DomBool) emptyList
  let thenDom = inferDomains t emptyList
  let elseDom = inferDomains e emptyList
  let refined = refineCeIfBranches t thenDom e elseDom
  if domainEq refined.thenDom refined.elseDom then refined.thenDom else DomRef

-- refineCeIfBranches — when one branch's CeVar is DomUnknown and the
-- other branch has a known concrete domain (DomBool / DomNum), refine
-- the CeVar's env to match. Returns the (possibly updated) (thenDom,
-- elseDom) pair. Pure helper — env mutation happens via the same
-- one-way `refineDomain` used by propagateCeVarDomain.
@label "Refine CeIf branches"
@description "Phase 5b13 cross-arm domain refinement for CeIf. When one branch's CeVar is DomUnknown and the other branch has a known concrete domain (DomBool / DomNum), propagate the concrete domain to the CeVar's env entry so a Bool-typed parameter used in a then-arm doesn't default to DomNum at the wrapper boundary. Returns the (possibly updated) {thenDom, elseDom} pair."
@tags "engine" "internal" "wasm" "phase-5b13"
@category "engine-internal"
refineCeIfBranches : (t: (CeExpr Any)) -> (thenDom: WasmDomain) -> (e: (CeExpr Any)) -> (elseDom: WasmDomain) -> a
refineCeIfBranches t thenDom e elseDom =
  if isConcreteDomain elseDom
  then
    case t of
      CeVar { name = n } ->
        let _r = refineDomain n elseDom
        { thenDom = elseDom, elseDom = elseDom }
      _ -> { thenDom = thenDom, elseDom = elseDom }
  else if isConcreteDomain thenDom
  then
    case e of
      CeVar { name = n } ->
        let _r = refineDomain n thenDom
        { thenDom = thenDom, elseDom = thenDom }
      _ -> { thenDom = thenDom, elseDom = elseDom }
  else { thenDom = thenDom, elseDom = elseDom }

@label "Is concrete domain"
@description "Phase 5b13 helper for refineCeIfBranches. True iff the domain carries representation info (DomBool / DomNum); False for DomUnknown / DomRef (which are 'don't-know' boundaries)."
@tags "engine" "internal" "wasm" "phase-5b13"
@category "engine-internal"
isConcreteDomain : (d: WasmDomain) -> Boolean
isConcreteDomain d =
  case d of
    DomBool -> true
    DomNum -> true
    _ -> false

-- CeLet inference. Each binding's value recurses; the binding's name
-- gets the inferred value-domain unconditionally (NOT one-way, since
-- this is a fresh binding rather than a param refinement). Then the
-- body recurses. Mirrors compile-wasm.ts:383-389.
@label "Infer CeLet domain"
@description "CeLet arm of inferDomains. Each binding's value recurses; the binding's name gets the inferred value-domain unconditionally (fresh binding, not a param refinement). Then the body recurses; the body's domain is the let's result domain."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferCeLet : (bs: a) -> (bd: (CeExpr Any)) -> (emptyList: List a) -> WasmDomain
inferCeLet bs bd emptyList =
  let _bs = inferLetBindings bs emptyList
  inferDomains bd emptyList

@label "Infer + set let-binding domains"
@description "Walk CeLet.bindings, inferring each binding's value domain and setting the env entry for its name. Unlike propagateCeVarDomain this is unconditional (fresh binding, not a refinement)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferLetBindings : (bs: a) -> (emptyList: List a) -> Boolean
inferLetBindings bs emptyList =
  case head bs of
    Nothing -> true
    Just binding ->
      let valDom = inferDomains (binding.value) emptyList
      let _s = setDomain (binding.name) valDom
      case tail bs of
        Nothing -> true
        Just rest -> inferLetBindings rest emptyList

-- CeDo inference. Sequential walk; the return domain is the last expr's.
-- Mirrors compile-wasm.ts:390-394 (which uses `let last = DOM_UNKNOWN`
-- as the initial value; the seed `DomUnknown` argument here serves the
-- same purpose for the empty-list base case).
@label "Infer CeDo domain"
@description "CeDo arm of inferDomains. Sequential walk; the return domain is the last expr's. Seeded with `last = DomUnknown` so the empty-exprs base case returns DomUnknown (mirrors the TS oracle's `let last = DOM_UNKNOWN`)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
inferCeDo : (exprs: a) -> (last: WasmDomain) -> (emptyList: List a) -> WasmDomain
inferCeDo exprs last emptyList =
  case head exprs of
    Nothing -> last
    Just e ->
      let d = inferDomains e emptyList
      case tail exprs of
        Nothing -> d
        Just rest -> inferCeDo rest d emptyList

-- ---------------------------------------------------------------------------
-- walkForDomainPropagation — child-recursion helper for the 4 externref-
-- producing arms (CeClosure / CeConstruct / CeRecord / CeMatch). Mirrors
-- compile-wasm.ts:407-475. Returns True as a unit-like placeholder; the
-- side effect is env mutation via nested propagate / inferDomains calls.
-- ---------------------------------------------------------------------------
@label "Walk for child domain propagation"
@description "Child-recursion helper for the 4 externref-producing arms (CeClosure / CeConstruct / CeRecord / CeMatch). Mutates env via nested propagateCeVarDomain / inferDomains calls; returns True as a unit-like placeholder. Mirrors compile-wasm.ts:407."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
walkForDomainPropagation : (expr: (CeExpr Any)) -> (emptyList: List a) -> Boolean
walkForDomainPropagation expr emptyList =
  case expr of
    CeLit { value = _v } -> true
    CeVar { name = _n } -> true
    CeCall { fnId = _f, args = args } -> walkInferEach args emptyList
    CeIf { cond = c, then = t, else = e } ->
      let _c = inferDomains c emptyList
      let _t = inferDomains t emptyList
      let _e = inferDomains e emptyList
      true
    CeLet { bindings = bs, body = bd } ->
      let _bs = walkLetBindings bs emptyList
      let _b = inferDomains bd emptyList
      true
    CeDo { exprs = es } -> walkInferEach es emptyList
    CeClosure { params = _ps, captures = _cs, body = b } ->
      let _b = inferDomains b emptyList
      true
    CeConstruct { ctor = _c, args = args } -> walkPropagateOrInfer args emptyList
    CeRecord { fields = fs } -> walkRecordFields fs emptyList
    CeMatch { scrutinee = s, arms = a } -> walkMatch s a emptyList

-- For each expr in a list, recurse via inferDomains (discard the result).
@label "Walk each expr (recurse via inferDomains)"
@description "For each expr in a list, recurse via inferDomains and discard the result. Used by walkForDomainPropagation's CeCall + CeDo arms."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
walkInferEach : (exprs: a) -> (emptyList: List a) -> Boolean
walkInferEach exprs emptyList =
  case head exprs of
    Nothing -> true
    Just e ->
      let _d = inferDomains e emptyList
      case tail exprs of
        Nothing -> true
        Just rest -> walkInferEach rest emptyList

@label "Walk CeLet bindings (recurse via inferDomains)"
@description "For each CeLet binding, recurse on .value via inferDomains and discard the result. Used by walkForDomainPropagation's CeLet arm (does NOT setDomain — distinct from inferLetBindings which is the inference-side walker)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
walkLetBindings : (bs: a) -> (emptyList: List a) -> Boolean
walkLetBindings bs emptyList =
  case head bs of
    Nothing -> true
    Just binding ->
      let _d = inferDomains (binding.value) emptyList
      case tail bs of
        Nothing -> true
        Just rest -> walkLetBindings rest emptyList

-- CeConstruct.args walker: CeVar fields propagate DomRef, others recurse.
-- Mirrors the CeConstruct case at compile-wasm.ts:430-444.
@label "Walk CeConstruct.args with DomRef propagation"
@description "CeConstruct.args walker. CeVar fields propagate DomRef; others recurse via inferDomains. Phase 21.5.2 substrate fix — without DomRef propagation here, CeVar fields holding string-typed values unbox to F64 at the call boundary."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
walkPropagateOrInfer : (args: a) -> (emptyList: List a) -> Boolean
walkPropagateOrInfer args emptyList =
  case head args of
    Nothing -> true
    Just a ->
      let _r = inferOrPropagate a (DomRef) emptyList
      case tail args of
        Nothing -> true
        Just rest -> walkPropagateOrInfer rest emptyList

-- CeRecord.fields walker: each field is a {name, value} record; same
-- shape as walkPropagateOrInfer but reaches inside `.value`. Mirrors
-- compile-wasm.ts:445-457.
@label "Walk CeRecord.fields with DomRef propagation"
@description "CeRecord.fields walker. Same shape as walkPropagateOrInfer but reaches inside `.value` of each {name, value} field. CeVar values propagate DomRef; others recurse via inferDomains."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
walkRecordFields : (fs: a) -> (emptyList: List a) -> Boolean
walkRecordFields fs emptyList =
  case head fs of
    Nothing -> true
    Just f ->
      let _r = inferOrPropagate (f.value) (DomRef) emptyList
      case tail fs of
        Nothing -> true
        Just rest -> walkRecordFields rest emptyList

-- CeMatch walker. Scrutinee propagates DomRef when CeVar; each arm body
-- recurses. The env is shared across arms (mirrors the TS oracle's
-- single-env-shared-across-iterations loop body). Mirrors
-- compile-wasm.ts:458-473.
@label "Walk CeMatch scrutinee + arms"
@description "CeMatch walker. Scrutinee propagates DomRef when CeVar (force-externref so PatConstruct patterns get the right signature); each arm body recurses via inferDomains. Env is shared across arms (mirrors the TS oracle's single-env-across-iterations loop body)."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
walkMatch : (scrutinee: (CeExpr Any)) -> (arms: a) -> (emptyList: List a) -> Boolean
walkMatch scrutinee arms emptyList =
  let _s = inferOrPropagate scrutinee (DomRef) emptyList
  walkMatchArms arms emptyList

@label "Walk CeMatch arm bodies"
@description "For each CeMatch arm, recurse on .body via inferDomains and discard the result. Splits the per-arm recursion out of walkMatch so the scrutinee + arms walks read uniformly."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
walkMatchArms : (arms: a) -> (emptyList: List a) -> Boolean
walkMatchArms arms emptyList =
  case head arms of
    Nothing -> true
    Just arm ->
      let _d = inferDomains (arm.body) emptyList
      case tail arms of
        Nothing -> true
        Just rest -> walkMatchArms rest emptyList

-- ===========================================================================
-- Phase 21.10.1 — Wasm binary serialiser (encodeWasmModule + ~40 helpers).
--
-- The LAST TS-only step on the Wasm pipeline ports here. Pattern-matches
-- the Fenel-native WasmModule shape and produces a `List Number` byte
-- sequence (each entry 0..255) that the dispatch wrapper converts to a
-- Uint8Array at the boundary.
--
-- Mirrors compile-wasm.ts:294-763 (ByteWriter / encodeU32LEB / encodeS32LEB /
-- encodeValType / encodeBlockType / encodeFuncType / INSTR_OPCODES table /
-- encodeInstr / encodeSection / encodeWasmModule), all deleted in this
-- phase.
--
-- The encoder is pure (no per-call mutable state; every helper is a
-- list-builder over read-only typed values). No HasXxxBuilder typeclass
-- needed — distinct from the lowering body's HasWasmBuilder capability.
-- Same posture as Phase 21.10's LLVM emitter.
--
-- Decision notes recorded here for future sessions:
--
--   1. Binary output — Option A from the brief. Each helper returns a
--      `List Number` and outer composition concatenates via `std:concat`.
--      The dispatch wrapper converts to Uint8Array. No HasWasmByteWriter
--      typeclass needed — the encoder is pure composition over read-only
--      values.
--
--   2. INSTR_OPCODES — Option 3 from the brief. The 50+ entry table is
--      inlined per-arm in `encodeWasmInstr`. Mirrors Phase 21.10's LLVM
--      precedent (27-arm inline dispatch). Cleaner in Fenel; per-arm
--      pattern match already knows the constructor.
--
--   3. I64Const — unused by the Phase 13 bootstrap lowering (grep
--      confirmed: only the ADT variant declaration references it).
--      `encodeS64Leb` is not implemented; passing an `I64Const` instr to
--      `encodeWasmInstr` triggers a Fenel pattern-match failure at runtime
--      which the dispatch wrapper surfaces as an Err. Same posture as
--      Phase 21.10's "unsupported instruction" handling.
--
--   4. F32/F64 → bytes — three new std primitives. `std:float64ToBytesLE`
--      / `std:float32ToBytesLE` wrap the JS typed-array round-trip;
--      `std:shiftRightU` is the unsigned-shift counterpart of std's
--      sign-preserving `shiftRight` (general-purpose for binary
--      serializers and unused here in favor of `floor (div n 128)` — the
--      mathematically-equivalent formulation sidesteps the JS bitwise-
--      coerce-to-int32 trap for u32 values past 2^31).
-- ===========================================================================

-- ---------------------------------------------------------------------------
-- encodeU32Leb — unsigned LEB128 over a non-negative integer (u32 range).
-- Recursive: low 7 bits → byte, with continuation bit (0x80) when more
-- bits remain. Uses `floor (div n 128)` for the zero-fill shift —
-- mathematically equivalent on non-negative Numbers, avoiding the JS
-- bitwise-coerce-to-int32 trap for u32 values past 2^31.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeU32Leb"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeU32Leb : (n: Number) -> (emptyList: List Number) -> List Number
encodeU32Leb n emptyList =
  let byte = mod n 128
  let rest = floor (div n 128)
  if eq rest 0
  then appendItem byte emptyList
  else concat (appendItem (add byte 128) emptyList) (encodeU32Leb rest emptyList)

-- ---------------------------------------------------------------------------
-- encodeS32Leb — signed LEB128 over an integer-valued Number. Uses
-- `floor (div n 128)`, the exact arithmetic right-shift-by-seven formula over
-- that carrier (including negatives), without crossing the nominal Int ABI.
-- `byte = n - rest*128` extracts the low 7 bits
-- mathematically (always 0..127) regardless of n's sign. Termination: the
-- continuation stops when `rest` converges to 0 (positive) or -1
-- (negative) AND the sign bit (bit 6 of byte) agrees with that sign.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeS32Leb"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeS32Leb : (n: Number) -> (emptyList: List Number) -> List Number
encodeS32Leb n emptyList =
  let rest = floor (div n 128)
  let byte = sub n (mul rest 128)
  let signBit = gte byte 64
  if eq rest 0
  then
    if signBit
    then encodeS32LebCont byte rest emptyList
    else appendItem byte emptyList
  else if eq rest (sub 0 1)
  then
    if signBit
    then appendItem byte emptyList
    else encodeS32LebCont byte rest emptyList
  else encodeS32LebCont byte rest emptyList

-- Helper: continuation-bit byte (byte | 0x80) + recurse. Separated so the
-- four arms of encodeS32Leb stay readable.
@label "Wasm serialiser: encodeS32LebCont"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeS32LebCont : (byte: Number) -> (rest: Number) -> (emptyList: List Number) -> List Number
encodeS32LebCont byte rest emptyList =
  concat (appendItem (add byte 128) emptyList) (encodeS32Leb rest emptyList)

-- ---------------------------------------------------------------------------
-- encodeWasmName — UTF-8 length-prefixed name. Mirrors compile-wasm.ts:
-- ByteWriter.pushName. The byte length comes from `length (utf8Bytes s)`
-- (NOT `length s`, which returns code-point count).
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmName"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmName : (s: String) -> (emptyList: List Number) -> List Number
encodeWasmName s emptyList =
  let bytes = utf8Bytes s
  let lenBytes = encodeU32Leb (length bytes) emptyList
  concat lenBytes bytes

-- ---------------------------------------------------------------------------
-- encodeWasmValType — 8-arm WasmValType → byte tag dispatcher. The two
-- typed-ref variants (RefStruct / RefArray) carry a typeidx and encode as
-- `0x64 + s32leb(typeidx)`. Mirrors compile-wasm.ts:encodeValType.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmValType"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmValType : (t: WasmValType) -> (emptyList: List Number) -> List Number
encodeWasmValType t emptyList =
  case t of
    I32 -> appendItem 127 emptyList
    I64 -> appendItem 126 emptyList
    F32 -> appendItem 125 emptyList
    F64 -> appendItem 124 emptyList
    Funcref -> appendItem 112 emptyList
    Externref -> appendItem 111 emptyList
    RefStruct { typeIdx = idx } ->
      concat (appendItem 100 emptyList) (encodeS32Leb idx emptyList)
    RefArray { typeIdx = idx } ->
      concat (appendItem 100 emptyList) (encodeS32Leb idx emptyList)

-- Map encodeWasmValType over a list of WasmValType, concatenating outputs.
@label "Wasm serialiser: encodeWasmValTypeList"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmValTypeList : (ts: List WasmValType) -> (emptyList: List Number) -> (acc: List Number) -> List Number
encodeWasmValTypeList ts emptyList acc =
  case head ts of
    Nothing -> acc
    Just t ->
      let bytes = encodeWasmValType t emptyList
      let accNext = concat acc bytes
      case tail ts of
        Nothing -> accNext
        Just rest -> encodeWasmValTypeList rest emptyList accNext

-- ---------------------------------------------------------------------------
-- encodeWasmBlockType — 3-arm WasmBlockType → byte sequence. Mirrors
-- compile-wasm.ts:encodeBlockType. BlockTypeEmpty = 0x40; BlockTypeValue
-- delegates to encodeWasmValType; BlockTypeFunc emits s32leb of the type
-- index.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmBlockType"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmBlockType : (bt: WasmBlockType) -> (emptyList: List Number) -> List Number
encodeWasmBlockType bt emptyList =
  case bt of
    BlockTypeEmpty -> appendItem 64 emptyList
    BlockTypeValue { valType = vt } -> encodeWasmValType vt emptyList
    BlockTypeFunc { typeIdx = idx } -> encodeS32Leb idx emptyList

-- ---------------------------------------------------------------------------
-- encodeWasmFuncType — function-type entry. Format:
-- `0x60 + leb(|params|) + params + leb(|results|) + results`.
-- Mirrors compile-wasm.ts:encodeFuncType.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmFuncType"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmFuncType : (ft: WasmFuncType) -> (emptyList: List Number) -> List Number
encodeWasmFuncType ft emptyList =
  case ft of
    WasmFuncType { params = ps, results = rs } ->
      let tag = appendItem 96 emptyList
      let paramsCount = encodeU32Leb (length ps) emptyList
      let paramsBytes = encodeWasmValTypeList ps emptyList emptyList
      let resultsCount = encodeU32Leb (length rs) emptyList
      let resultsBytes = encodeWasmValTypeList rs emptyList emptyList
      let p1 = concat tag paramsCount
      let p2 = concat p1 paramsBytes
      let p3 = concat p2 resultsCount
      concat p3 resultsBytes

-- ---------------------------------------------------------------------------
-- wasmExportKindByte — WasmExport.kind string → kind byte. Mirrors the
-- inline ternary at compile-wasm.ts:encodeWasmModule (line 731).
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: wasmExportKindByte"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
wasmExportKindByte : (k: String) -> Number
wasmExportKindByte k =
  if eq k "func" then 0
  else if eq k "table" then 1
  else if eq k "memory" then 2
  else 3

-- ---------------------------------------------------------------------------
-- wasmValTypeEqual — structural equality on two WasmValType values.
-- Mirrors compile-wasm.ts:valTypeEqual. The two ref-typed variants
-- compare typeIdx; the atomic variants check tag-equality. Nested case
-- discrimination mirrors the existing `domainEq` shape in this file.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: wasmValTypeEqual"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
wasmValTypeEqual : (a: WasmValType) -> (b: WasmValType) -> Boolean
wasmValTypeEqual a b =
  case a of
    I32 ->
      case b of
        I32 -> true
        _ -> false
    I64 ->
      case b of
        I64 -> true
        _ -> false
    F32 ->
      case b of
        F32 -> true
        _ -> false
    F64 ->
      case b of
        F64 -> true
        _ -> false
    Funcref ->
      case b of
        Funcref -> true
        _ -> false
    Externref ->
      case b of
        Externref -> true
        _ -> false
    RefStruct { typeIdx = aIdx } ->
      case b of
        RefStruct { typeIdx = bIdx } -> eq aIdx bIdx
        _ -> false
    RefArray { typeIdx = aIdx } ->
      case b of
        RefArray { typeIdx = bIdx } -> eq aIdx bIdx
        _ -> false

-- ---------------------------------------------------------------------------
-- wasmValTypeListEqual — pointwise equality on two List<WasmValType>.
-- Length check first (fast path); then a parallel walk via
-- wasmValTypeListEqualLoop. Mirrors compile-wasm.ts:funcTypeEqual's
-- params/results comparison.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: wasmValTypeListEqual"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
wasmValTypeListEqual : (xs: List WasmValType) -> (ys: List WasmValType) -> Boolean
wasmValTypeListEqual xs ys =
  if neq (length xs) (length ys)
  then false
  else wasmValTypeListEqualLoop xs ys

@label "Wasm serialiser: wasmValTypeListEqualLoop"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
wasmValTypeListEqualLoop : (xs: List WasmValType) -> (ys: List WasmValType) -> Boolean
wasmValTypeListEqualLoop xs ys =
  case head xs of
    Nothing -> true
    Just x ->
      case head ys of
        Nothing -> false
        Just y ->
          if wasmValTypeEqual x y
          then
            case tail xs of
              Nothing -> true
              Just restX ->
                case tail ys of
                  Nothing -> true
                  Just restY -> wasmValTypeListEqualLoop restX restY
          else false

-- ---------------------------------------------------------------------------
-- wasmFuncTypeEqual — structural equality on two WasmFuncType. Mirrors
-- compile-wasm.ts:funcTypeEqual. Caller is responsible for confirming
-- both values are `WasmFuncType { params, results }` constructors; the
-- type-section may also contain WasmStructType / WasmArrayType variants
-- which this helper does NOT match (returns False via pattern-fall-
-- through — the encoder's caller short-circuits before reaching here).
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: wasmFuncTypeEqual"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
wasmFuncTypeEqual : (a: WasmFuncType) -> (b: WasmFuncType) -> Boolean
wasmFuncTypeEqual a b =
  case a of
    WasmFuncType { params = pa, results = ra } ->
      case b of
        WasmFuncType { params = pb, results = rb } ->
          if wasmValTypeListEqual pa pb
          then wasmValTypeListEqual ra rb
          else false
        _ -> false
    _ -> false

-- ---------------------------------------------------------------------------
-- findWasmFuncTypeIdx — linear scan over `types` returning the position
-- of the first WasmFuncType structurally equal to `ft`. Mirrors the
-- inline `mod.types.findIndex(...)` in compile-wasm.ts:encodeWasmModule.
-- Returns -1 when not found (the encoder treats this as a usage error;
-- the dispatch wrapper surfaces it as a runtime exception).
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: findWasmFuncTypeIdx"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
findWasmFuncTypeIdx : (types: List WasmFuncType) -> (ft: WasmFuncType) -> Number
findWasmFuncTypeIdx types ft = findWasmFuncTypeIdxFrom types ft 0

@label "Wasm serialiser: findWasmFuncTypeIdxFrom"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
findWasmFuncTypeIdxFrom : (types: List WasmFuncType) -> (ft: WasmFuncType) -> (idx: Number) -> Number
findWasmFuncTypeIdxFrom types ft idx =
  case head types of
    Nothing -> sub 0 1
    Just t ->
      if wasmFuncTypeEqual t ft
      then idx
      else
        case tail types of
          Nothing -> sub 0 1
          Just rest -> findWasmFuncTypeIdxFrom rest ft (add idx 1)

-- ---------------------------------------------------------------------------
-- encodeWasmInstr — 50+ arm WasmInstr dispatcher. Each arm emits the
-- opcode byte (or multi-byte GC-prefix sequence) inline + the operand
-- encoding. Mirrors compile-wasm.ts:encodeInstr.
--
-- Opcode bytes (decimal here; hex in the TS oracle for spec alignment):
--   I32Const 0x41=65   F64Const 0x44=68   F32Const 0x43=67
--   LocalGet 0x20=32   LocalSet 0x21=33   LocalTee 0x22=34
--   I32Add..I32GeS     F64Add..F64Ge      I32WrapI64..I32TruncF64S
--   If 0x04=4          Block 0x02=2        Loop 0x03=3
--   Br 0x0c=12         BrIf 0x0d=13        Return 0x0f=15
--   Unreachable 0x00   Nop 0x01            Drop 0x1a=26  Select 0x1b=27
--   Call 0x10=16       CallIndirect 0x11=17
--   RefNull 0xd0=208   RefIsNull 0xd1=209
--   GC-prefix 0xfb=251 (StructNew=0, StructGet=2, StructSet=5,
--                       ArrayNew=6, ArrayGet=11, ArraySet=14,
--                       ArrayLen=15)
--   Throw 0x08=8
--   `end` opcode 0x0b=11 (terminates If/Block/Loop bodies)
--
-- I64Const is UNHANDLED — the Phase 13 lowering doesn't emit it (grep
-- confirmed). A future I64Const usage would surface as a pattern-match
-- failure here, caught by the dispatch wrapper.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmInstr"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmInstr : (instr: WasmInstr) -> (emptyList: List Number) -> List Number
encodeWasmInstr instr emptyList =
  case instr of
    -- Constants
    I32Const { value = v } ->
      concat (appendItem 65 emptyList) (encodeS32Leb v emptyList)
    F32Const { value = v } ->
      concat (appendItem 67 emptyList) (float32ToBytesLE v)
    F64Const { value = v } ->
      concat (appendItem 68 emptyList) (float64ToBytesLE v)
    -- Locals
    LocalGet { index = i } ->
      concat (appendItem 32 emptyList) (encodeU32Leb i emptyList)
    LocalSet { index = i } ->
      concat (appendItem 33 emptyList) (encodeU32Leb i emptyList)
    LocalTee { index = i } ->
      concat (appendItem 34 emptyList) (encodeU32Leb i emptyList)
    -- i32 arith / logic
    I32Add -> appendItem 106 emptyList
    I32Sub -> appendItem 107 emptyList
    I32Mul -> appendItem 108 emptyList
    I32DivS -> appendItem 109 emptyList
    I32RemS -> appendItem 111 emptyList
    I32And -> appendItem 113 emptyList
    I32Or -> appendItem 114 emptyList
    I32Xor -> appendItem 115 emptyList
    I32Eqz -> appendItem 69 emptyList
    I32Eq -> appendItem 70 emptyList
    I32Ne -> appendItem 71 emptyList
    I32LtS -> appendItem 72 emptyList
    I32GtS -> appendItem 74 emptyList
    I32LeS -> appendItem 76 emptyList
    I32GeS -> appendItem 78 emptyList
    -- f64 arith
    F64Add -> appendItem 160 emptyList
    F64Sub -> appendItem 161 emptyList
    F64Mul -> appendItem 162 emptyList
    F64Div -> appendItem 163 emptyList
    F64Neg -> appendItem 154 emptyList
    F64Abs -> appendItem 153 emptyList
    -- f64 cmp
    F64Eq -> appendItem 97 emptyList
    F64Ne -> appendItem 98 emptyList
    F64Lt -> appendItem 99 emptyList
    F64Gt -> appendItem 100 emptyList
    F64Le -> appendItem 101 emptyList
    F64Ge -> appendItem 102 emptyList
    -- Conversions
    I32WrapI64 -> appendItem 167 emptyList
    I64ExtendI32S -> appendItem 172 emptyList
    F64ConvertI32S -> appendItem 183 emptyList
    I32TruncF64S -> appendItem 170 emptyList
    -- Control flow
    If { blockType = bt, then = thenInstrs, else = elseInstrs } ->
      let tag = appendItem 4 emptyList
      let btBytes = encodeWasmBlockType bt emptyList
      let thenBytes = encodeWasmInstrList thenInstrs emptyList emptyList
      let p1 = concat tag btBytes
      let p2 = concat p1 thenBytes
      let withMaybeElse =
        if eq (length elseInstrs) 0
        then p2
        else
          let elseTag = appendItem 5 emptyList
          let elseBytes = encodeWasmInstrList elseInstrs emptyList emptyList
          concat (concat p2 elseTag) elseBytes
      concat withMaybeElse (appendItem 11 emptyList)
    Block { blockType = bt, body = body } ->
      let tag = appendItem 2 emptyList
      let btBytes = encodeWasmBlockType bt emptyList
      let bodyBytes = encodeWasmInstrList body emptyList emptyList
      let p1 = concat tag btBytes
      let p2 = concat p1 bodyBytes
      concat p2 (appendItem 11 emptyList)
    Loop { blockType = bt, body = body } ->
      let tag = appendItem 3 emptyList
      let btBytes = encodeWasmBlockType bt emptyList
      let bodyBytes = encodeWasmInstrList body emptyList emptyList
      let p1 = concat tag btBytes
      let p2 = concat p1 bodyBytes
      concat p2 (appendItem 11 emptyList)
    Br { depth = d } ->
      concat (appendItem 12 emptyList) (encodeU32Leb d emptyList)
    BrIf { depth = d } ->
      concat (appendItem 13 emptyList) (encodeU32Leb d emptyList)
    Return -> appendItem 15 emptyList
    Unreachable -> appendItem 0 emptyList
    Nop -> appendItem 1 emptyList
    Drop -> appendItem 26 emptyList
    Select -> appendItem 27 emptyList
    Call { funcIdx = idx } ->
      concat (appendItem 16 emptyList) (encodeU32Leb idx emptyList)
    CallIndirect { typeIdx = tIdx, tableIdx = tabIdx } ->
      let tag = appendItem 17 emptyList
      let typeBytes = encodeU32Leb tIdx emptyList
      let tabBytes = encodeU32Leb tabIdx emptyList
      concat (concat tag typeBytes) tabBytes
    RefNull { heapType = ht } ->
      let tag = appendItem 208 emptyList
      let heapByte = if eq ht "externref" then 111 else 112
      concat tag (appendItem heapByte emptyList)
    RefIsNull -> appendItem 209 emptyList
    StructNew { typeIdx = idx } ->
      let prefix = appendItem 251 emptyList
      let sub = encodeU32Leb 0 emptyList
      let tBytes = encodeU32Leb idx emptyList
      concat (concat prefix sub) tBytes
    StructGet { typeIdx = idx, fieldIdx = fIdx } ->
      let prefix = appendItem 251 emptyList
      let sub = encodeU32Leb 2 emptyList
      let tBytes = encodeU32Leb idx emptyList
      let fBytes = encodeU32Leb fIdx emptyList
      concat (concat (concat prefix sub) tBytes) fBytes
    StructSet { typeIdx = idx, fieldIdx = fIdx } ->
      let prefix = appendItem 251 emptyList
      let sub = encodeU32Leb 5 emptyList
      let tBytes = encodeU32Leb idx emptyList
      let fBytes = encodeU32Leb fIdx emptyList
      concat (concat (concat prefix sub) tBytes) fBytes
    ArrayNew { typeIdx = idx } ->
      let prefix = appendItem 251 emptyList
      let sub = encodeU32Leb 6 emptyList
      let tBytes = encodeU32Leb idx emptyList
      concat (concat prefix sub) tBytes
    ArrayGet { typeIdx = idx } ->
      let prefix = appendItem 251 emptyList
      let sub = encodeU32Leb 11 emptyList
      let tBytes = encodeU32Leb idx emptyList
      concat (concat prefix sub) tBytes
    ArraySet { typeIdx = idx } ->
      let prefix = appendItem 251 emptyList
      let sub = encodeU32Leb 14 emptyList
      let tBytes = encodeU32Leb idx emptyList
      concat (concat prefix sub) tBytes
    ArrayLen ->
      let prefix = appendItem 251 emptyList
      concat prefix (encodeU32Leb 15 emptyList)
    Throw { tagIdx = idx } ->
      concat (appendItem 8 emptyList) (encodeU32Leb idx emptyList)

-- Map encodeWasmInstr over a list of WasmInstr, concatenating outputs.
@label "Wasm serialiser: encodeWasmInstrList"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmInstrList : (instrs: List WasmInstr) -> (emptyList: List Number) -> (acc: List Number) -> List Number
encodeWasmInstrList instrs emptyList acc =
  case head instrs of
    Nothing -> acc
    Just i ->
      let bytes = encodeWasmInstr i emptyList
      let accNext = concat acc bytes
      case tail instrs of
        Nothing -> accNext
        Just rest -> encodeWasmInstrList rest emptyList accNext

-- ---------------------------------------------------------------------------
-- encodeWasmLocalDecl — one RLE-encoded local declaration:
-- `leb(count) + valType`.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmLocalDecl"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmLocalDecl : (loc: WasmLocalDecl) -> (emptyList: List Number) -> List Number
encodeWasmLocalDecl loc emptyList =
  case loc of
    WasmLocalDecl { count = c, valType = vt } ->
      concat (encodeU32Leb c emptyList) (encodeWasmValType vt emptyList)

-- Map encodeWasmLocalDecl over a list, concatenating outputs.
@label "Wasm serialiser: encodeWasmLocalDeclList"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmLocalDeclList : (locals: List WasmLocalDecl) -> (emptyList: List Number) -> (acc: List Number) -> List Number
encodeWasmLocalDeclList locals emptyList acc =
  case head locals of
    Nothing -> acc
    Just loc ->
      let bytes = encodeWasmLocalDecl loc emptyList
      let accNext = concat acc bytes
      case tail locals of
        Nothing -> accNext
        Just rest -> encodeWasmLocalDeclList rest emptyList accNext

-- ---------------------------------------------------------------------------
-- encodeWasmFuncBody — one function's body bytes:
-- `leb(|locals|) + (per-local: leb(count) + valType) + (per-instr) + 0x0b end`.
-- The body bytes are then size-prefixed by encodeWasmFuncCodeEntry.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmFuncBody"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmFuncBody : (f: WasmFunc) -> (emptyList: List Number) -> List Number
encodeWasmFuncBody f emptyList =
  let localsCount = encodeU32Leb (length (f.locals)) emptyList
  let localsBytes = encodeWasmLocalDeclList (f.locals) emptyList emptyList
  let instrBytes = encodeWasmInstrList (f.body) emptyList emptyList
  let p1 = concat localsCount localsBytes
  let p2 = concat p1 instrBytes
  concat p2 (appendItem 11 emptyList)

-- ---------------------------------------------------------------------------
-- encodeWasmFuncCodeEntry — `leb(|body|) + body` for one function's code-
-- section entry. The size prefix is the byte length of the encoded body
-- (NOT the count of source-level instructions).
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmFuncCodeEntry"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmFuncCodeEntry : (f: WasmFunc) -> (emptyList: List Number) -> List Number
encodeWasmFuncCodeEntry f emptyList =
  let body = encodeWasmFuncBody f emptyList
  let sizeBytes = encodeU32Leb (length body) emptyList
  concat sizeBytes body

@label "Wasm serialiser: encodeWasmFuncCodeEntries"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmFuncCodeEntries : (funcs: List WasmFunc) -> (emptyList: List Number) -> (acc: List Number) -> List Number
encodeWasmFuncCodeEntries funcs emptyList acc =
  case head funcs of
    Nothing -> acc
    Just f ->
      let entry = encodeWasmFuncCodeEntry f emptyList
      let accNext = concat acc entry
      case tail funcs of
        Nothing -> accNext
        Just rest -> encodeWasmFuncCodeEntries rest emptyList accNext

-- ---------------------------------------------------------------------------
-- encodeWasmCodeSectionContent — `leb(|funcs|) + (per-func code entry)`.
-- The section header (id=10 + size prefix) wraps this via encodeWasmSection.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmCodeSectionContent"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmCodeSectionContent : (funcs: List WasmFunc) -> (emptyList: List Number) -> List Number
encodeWasmCodeSectionContent funcs emptyList =
  let countBytes = encodeU32Leb (length funcs) emptyList
  let entries = encodeWasmFuncCodeEntries funcs emptyList emptyList
  concat countBytes entries

-- ---------------------------------------------------------------------------
-- encodeWasmTypeEntries — walk `types` (each a WasmFuncType — the Phase
-- 13 lowering only emits function-type declarations; WasmStructType /
-- WasmArrayType raise via encodeWasmFuncType's pattern-match failure).
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmTypeEntries"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmTypeEntries : (types: List WasmFuncType) -> (emptyList: List Number) -> (acc: List Number) -> List Number
encodeWasmTypeEntries types emptyList acc =
  case head types of
    Nothing -> acc
    Just t ->
      let bytes = encodeWasmFuncType t emptyList
      let accNext = concat acc bytes
      case tail types of
        Nothing -> accNext
        Just rest -> encodeWasmTypeEntries rest emptyList accNext

@label "Wasm serialiser: encodeWasmTypeSectionContent"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmTypeSectionContent : (types: List WasmFuncType) -> (emptyList: List Number) -> List Number
encodeWasmTypeSectionContent types emptyList =
  let countBytes = encodeU32Leb (length types) emptyList
  let entries = encodeWasmTypeEntries types emptyList emptyList
  concat countBytes entries

-- ---------------------------------------------------------------------------
-- encodeWasmImportEntry — one function-import entry:
-- `name(module) + name(name) + 0x00(funcKind) + leb(typeIdx)`.
-- Only the WasmFuncImport variant is encoded; WasmMemImport /
-- WasmGlobalImport raise via pattern-match failure (Phase 13 lowering
-- doesn't emit them).
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmImportEntry"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmImportEntry : (imp: WasmFuncImport) -> (types: List WasmFuncType) -> (emptyList: List Number) -> List Number
encodeWasmImportEntry imp types emptyList =
  case imp of
    WasmFuncImport { module = m, name = n, funcType = ft } ->
      let moduleBytes = encodeWasmName m emptyList
      let nameBytes = encodeWasmName n emptyList
      let kindByte = appendItem 0 emptyList
      let typeIdx = findWasmFuncTypeIdx types ft
      let idxBytes = encodeU32Leb typeIdx emptyList
      let p1 = concat moduleBytes nameBytes
      let p2 = concat p1 kindByte
      concat p2 idxBytes

@label "Wasm serialiser: encodeWasmImportEntries"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmImportEntries : (imports: List WasmFuncImport) -> (types: List WasmFuncType) -> (emptyList: List Number) -> (acc: List Number) -> List Number
encodeWasmImportEntries imports types emptyList acc =
  case head imports of
    Nothing -> acc
    Just imp ->
      let bytes = encodeWasmImportEntry imp types emptyList
      let accNext = concat acc bytes
      case tail imports of
        Nothing -> accNext
        Just rest -> encodeWasmImportEntries rest types emptyList accNext

@label "Wasm serialiser: encodeWasmImportSectionContent"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmImportSectionContent : (imports: List WasmFuncImport) -> (types: List WasmFuncType) -> (emptyList: List Number) -> List Number
encodeWasmImportSectionContent imports types emptyList =
  let countBytes = encodeU32Leb (length imports) emptyList
  let entries = encodeWasmImportEntries imports types emptyList emptyList
  concat countBytes entries

-- ---------------------------------------------------------------------------
-- encodeWasmFunctionSectionEntries — one type-index entry per locally-
-- defined function. The function-index space contains imports first then
-- locals; this section only carries the per-local type indices.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmFunctionSectionEntries"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmFunctionSectionEntries : (funcs: List WasmFunc) -> (types: List WasmFuncType) -> (emptyList: List z) -> (acc: List Number) -> List Number
encodeWasmFunctionSectionEntries funcs types emptyList acc =
  case head funcs of
    Nothing -> acc
    Just f ->
      let typeIdx = findWasmFuncTypeIdx types (f.funcType)
      let idxBytes = encodeU32Leb typeIdx emptyList
      let accNext = concat acc idxBytes
      case tail funcs of
        Nothing -> accNext
        Just rest -> encodeWasmFunctionSectionEntries rest types emptyList accNext

@label "Wasm serialiser: encodeWasmFunctionSectionContent"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmFunctionSectionContent : (funcs: List WasmFunc) -> (types: List WasmFuncType) -> (emptyList: List Number) -> List Number
encodeWasmFunctionSectionContent funcs types emptyList =
  let countBytes = encodeU32Leb (length funcs) emptyList
  let entries = encodeWasmFunctionSectionEntries funcs types emptyList emptyList
  concat countBytes entries

-- ---------------------------------------------------------------------------
-- encodeWasmExportEntry — one export entry:
-- `name + kindByte + leb(index)`.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmExportEntry"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmExportEntry : (exp: WasmExport) -> (emptyList: List Number) -> List Number
encodeWasmExportEntry exp emptyList =
  let nameBytes = encodeWasmName (exp.name) emptyList
  let kindByte = wasmExportKindByte (exp.kind)
  let idxBytes = encodeU32Leb (exp.index) emptyList
  let p1 = concat nameBytes (appendItem kindByte emptyList)
  concat p1 idxBytes

@label "Wasm serialiser: encodeWasmExportEntries"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmExportEntries : (exports: List WasmExport) -> (emptyList: List Number) -> (acc: List Number) -> List Number
encodeWasmExportEntries exports emptyList acc =
  case head exports of
    Nothing -> acc
    Just exp ->
      let bytes = encodeWasmExportEntry exp emptyList
      let accNext = concat acc bytes
      case tail exports of
        Nothing -> accNext
        Just rest -> encodeWasmExportEntries rest emptyList accNext

@label "Wasm serialiser: encodeWasmExportSectionContent"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmExportSectionContent : (exports: List WasmExport) -> (emptyList: List Number) -> List Number
encodeWasmExportSectionContent exports emptyList =
  let countBytes = encodeU32Leb (length exports) emptyList
  let entries = encodeWasmExportEntries exports emptyList emptyList
  concat countBytes entries

-- ---------------------------------------------------------------------------
-- encodeWasmSection — `sectionId + leb(|content|) + content`. The size
-- prefix is the byte length of the section content (count + entries).
-- Mirrors compile-wasm.ts:encodeSection.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmSection"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
encodeWasmSection : (sectionId: Number) -> (content: List Number) -> (emptyList: List Number) -> List Number
encodeWasmSection sectionId content emptyList =
  let id = appendItem sectionId emptyList
  let sizeBytes = encodeU32Leb (length content) emptyList
  let p1 = concat id sizeBytes
  concat p1 content

-- ---------------------------------------------------------------------------
-- wasmHeader — magic bytes ('\0asm' = [0x00, 0x61, 0x73, 0x6d]) +
-- version 1 little-endian (= [0x01, 0x00, 0x00, 0x00]). Mirrors the
-- first two pushBytes calls in compile-wasm.ts:encodeWasmModule.
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: wasmHeader"
@description "Phase 21.10.1 — Wasm binary serialiser. See fenel/modules/engine/lower-to-wasm-ast.fenel for the per-function comment block."
@tags "engine" "internal" "wasm" "phase-21"
@category "engine-internal"
wasmHeader : (emptyList: List Number) -> List Number
wasmHeader emptyList =
  let h0 = appendItem 0 emptyList
  let h1 = appendItem 97 h0
  let h2 = appendItem 115 h1
  let h3 = appendItem 109 h2
  let h4 = appendItem 1 h3
  let h5 = appendItem 0 h4
  let h6 = appendItem 0 h5
  appendItem 0 h6

-- ---------------------------------------------------------------------------
-- encodeWasmModule — program-level entry. Mirrors compile-wasm.ts:
-- encodeWasmModule (655-763). Header + 5 conditional sections (each
-- emitted only when its source list is non-empty):
--   1 = Type section (mod.types)
--   2 = Import section (mod.imports, indexed against mod.types)
--   3 = Function section (mod.funcs, indexed against mod.types)
--   7 = Export section (mod.exports)
--  10 = Code section (mod.funcs)
-- ---------------------------------------------------------------------------
@label "Wasm serialiser: encodeWasmModule"
@description "Phase 21.10.1 — Wasm binary serialiser entry. Takes a Fenel-native WasmModule and returns the `.wasm` binary bytes as a List Number (the dispatch wrapper converts to Uint8Array at the boundary). Mirrors compile-wasm.ts:encodeWasmModule (deleted in Phase 21.10.1)."
@tags "engine" "ir" "wasm" "self-host" "phase-21"
encodeWasmModule : (mod: WasmModule) -> (emptyList: List Number) -> List Number
encodeWasmModule mod emptyList =
  let header = wasmHeader emptyList
  let lenTypes = length (mod.types)
  let withTypes =
    if eq lenTypes 0
    then header
    else
      let typesContent = encodeWasmTypeSectionContent (mod.types) emptyList
      concat header (encodeWasmSection 1 typesContent emptyList)
  let lenImports = length (mod.imports)
  let withImports =
    if eq lenImports 0
    then withTypes
    else
      let importsContent = encodeWasmImportSectionContent (mod.imports) (mod.types) emptyList
      concat withTypes (encodeWasmSection 2 importsContent emptyList)
  let lenFuncs = length (mod.funcs)
  let withFuncs =
    if eq lenFuncs 0
    then withImports
    else
      let funcsContent = encodeWasmFunctionSectionContent (mod.funcs) (mod.types) emptyList
      concat withImports (encodeWasmSection 3 funcsContent emptyList)
  let lenExports = length (mod.exports)
  let withExports =
    if eq lenExports 0
    then withFuncs
    else
      let exportsContent = encodeWasmExportSectionContent (mod.exports) emptyList
      concat withFuncs (encodeWasmSection 7 exportsContent emptyList)
  if eq lenFuncs 0
  then withExports
  else
    let codeContent = encodeWasmCodeSectionContent (mod.funcs) emptyList
    concat withExports (encodeWasmSection 10 codeContent emptyList)
