module engine where

-- =========================================================================
-- comprehend — ⟦{x | P x}⟧: the ONE comprehension-builder over the canonical
-- SetExpr (`Se*`). decide-substrate Phase 1 Stage A (brief:
-- `workstreams/decide-substrate/briefs/phase-1-representation-collapse.md`;
-- design: `design/deciding.md` §3 — "the recognizer convergence collapses
-- onto ONE comprehension-builder over the floor").
--
-- Absorbs the fragment MATH of the historical recognizers:
--   • `predicateToSet` (solve.fenel, Expr→WitSet, + the P12 affine widening)
--     — RETIRED (Stage B): comprehend is the sole recognizer; `inhabit`
--     (inhabit.fenel) is its constructive dual; the Ws world is gone.
--   • `whereToSetExpr` (set-algebra-deciders.fenel, Jle*→Wes*) — DELETED;
--     `comprehendWhere` (below) walks the marshalled Jle nodes, routing
--     every non-JSON-Logic-specific leaf through `comprehend`. **The
--     `$where`/decider path GAINS the P12 affine inversion this way** (the
--     Stage-A capability gain: `{$where: 2*value+5 == 6}` now extracts to
--     `{$enum: [0.5]}` where the old third recognizer fenced it).
--   • `typeToSetExpr` (type-to-set.fenel) — UNCHANGED this stage; its
--     Se*-output refit rides Stage E with the Sm* kill (it feeds the Sm*
--     consumers — fenel-check — so flipping its output belongs with them).
--
-- OUTPUT LANGUAGE — the canonical registered `Se*` ADT (set-expr-types
-- .fenel), constructed directly (`SeEnum { values = … }`): the `$tag`
-- encoding IS authorable from a `.fenel` body (the construct op writes the
-- `$tag`; the `$`-key barrier only fences literal `$`-keys). The SeInterval
-- payload byte-matches the live wire — `{ lo, hi : Maybe {value, inclusive} }`
-- (the SAME Maybe-wrapped bound shape WitSet used; verified against
-- `setExprToTag` / `marshalBound` / `refineOutcomeToSet`, Stage-0 inventory
-- §5). `Just { value = v, inclusive = b }` is positional application (the
-- record's keys don't match Maybe's `_0` formal), producing the canonical
-- `{$tag:"Just", _0:{value,inclusive}}`.
--
-- THE FENCE — comprehend is TOTAL: out-of-fragment ⇒ `SeWhere { pred = e }`
-- where `pred` carries the residual predicate AS `Expr` (the judgment
-- core's term language; the `pred: a` slot is language-loose by design —
-- set-expr-types.fenel). A comprehend-fence SeWhere must NOT leak into the
-- `$`-key world (its pred is not JSON-Logic): `comprehendClosed` is the
-- all-or-nothing face (any fence anywhere ⇒ Nothing) every boundary
-- consumer routes through; the witness/enumerate side (inhabit.fenel /
-- enumerate.fenel) fences SeWhere to Nothing.
--
-- DIVERGENCES from the absorbed recognizers (deliberate, oracle-visible):
--   1. String ordered-comparisons build PRECISE string-bound intervals
--      (`value >= "apple"` ⇒ SeInterval lo="apple"). The old `compToSet`
--      returned CtsAll (a universe over-approximation) for them — wrong as
--      an EXACT extraction (the canonical subset judgment consumes SeWhere
--      extractions on either side of ⊆, where over-approximating b is unsound).
--      Soundness fix + gain.
--   2. Boolean-bound ordered-comparisons (`x > true`) FENCE. The old Ws
--      path built a bool-bound interval (a witnessable-nonsense value); the
--      old Jle path returned CtsAll. The fence is the sound floor.
--   3. neq (`!=`) is recognized on the Expr path too (SeDiff SeAll (SeEnum
--      [v])) — old predicateToSet fenced it; the Jle path already had it.
--   4. NOT absorbed (documented residuals): mod-eq → `multiple:N` named-set
--      naming stays at the `$where` marshal (JleModEq — a JSON-Logic-key
--      shape recognition; moves here only when that marshal neutralizes);
--      `in` stays a Jle-level arm (`jsonLogicToExpr` rejects the `in` op —
--      the compile-shared recognized-form set); `compToSet` SURVIVES as the
--      Aggregable lift's leaf-builder (reconciles in Phase 3, the
--      family-completion tail — `design/deciding.md` §4 "Aggregable
--      reconciles beside the family").
--
-- REUSE (cross-file through the `module engine where` union): `p2sExtract`
-- (orientation/literal extraction), the `affineOf` family (the P12 affine
-- math — representation-neutral `{ok, coeff, k}` records), `flipRel`,
-- `opNotationToCodeName` (all UNCHANGED in their home files). Only the
-- OUTPUT-language tails are (re)authored here.
--
-- NO ENTITY DECLS (the law-freeze rule — DischargeStats bit-stable): this
-- file adds FUNCTIONS only. The one entity edit this stage is the additive
-- `JleExpr` case on the existing JsonLogicExpr ADT (set-algebra-deciders).
-- =========================================================================

-- ─────────────────────────────────────────────────────────────────────────
-- comprehend — the entry: a predicate Expr over `varName` → SetExpr.
-- ─────────────────────────────────────────────────────────────────────────

@label "Comprehend"
@description "The shared comprehension-builder over canonical SetExpr. Literal true/false, literal equality/inequality, String ordering and Boolean composition retain their existing fragment. Numeric ordering retains its original SeWhere predicate because an ordered interval admits exact integer records that native scalar comparison refuses. Affine equality retains its inversion; unsupported expressions retain the residual Expr, and comprehendClosed abstains on any residual."
@tags "engine" "comprehend" "solve" "set-algebra" "decide-substrate" "phase-1"
comprehend : (varName: String) -> (body: Expr) -> SetExpr
comprehend varName body =
  case body of
    ELit { value = v } ->
      if eq v true then SeAll
      else if eq v false then SeNone
      else SeWhere { pred = body }
    ECall { fnId = f, args = args } -> cphDispatch varName f args body
    _ -> SeWhere { pred = body }

-- cphDispatch — route the call head to the matching fragment builder.
@label "comprehend: cphDispatch"
@description "Stage A — route an `ECall` head to the matching comprehend fragment builder (eq / neq / and / or / not / comparisons); unknown heads ⇒ the SeWhere fence. Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphDispatch : (varName: String) -> (f: String) -> (args: a) -> (orig: Expr) -> SetExpr
cphDispatch varName f args orig =
  if eq f "eq" then cphEq varName args orig
  else if eq f "and" then SeIntersect { branches = cphBranches varName args [] }
  else if eq f "or" then SeUnion { branches = cphBranches varName args [] }
  else if eq f "not" then cphNot varName args orig
  else if eq f "neq" then cphNeq varName args orig
  else if eq f "lt" then cphCompare varName "lt" args orig
  else if eq f "lte" then cphCompare varName "lte" args orig
  else if eq f "gt" then cphCompare varName "gt" args orig
  else if eq f "gte" then cphCompare varName "gte" args orig
  else SeWhere { pred = orig }

-- cphEq — `x == v` / `v == x` ⇒ SeEnum [v]; else the affine fall-through.
@label "comprehend: cphEq"
@description "Stage A — `varName == lit` (either orientation) ⇒ SeEnum [lit]; anything else falls through to the affine path (cphAffine), which inverts a compound `coeff·x + k == …`, or fences. Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphEq : (varName: String) -> (args: a) -> (orig: Expr) -> SetExpr
cphEq varName args orig =
  let r = p2sExtract varName args
  if r.ok then SeEnum { values = [r.lit] } else cphAffine varName "eq" args orig

-- cphNeq — `x != v` / `v != x` ⇒ SeDiff SeAll (SeEnum [v]); else fence.
-- (No affine-neq anywhere at HEAD — a possible later widening, not parity.)
@label "comprehend: cphNeq"
@description "Stage A — `varName != lit` (either orientation) ⇒ SeDiff SeAll (SeEnum [lit]) — the complement-of-singleton the old compToSet CtsDiffEnum arm emitted; non-var-vs-lit fences (no affine-neq exists at HEAD). Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphNeq : (varName: String) -> (args: a) -> (orig: Expr) -> SetExpr
cphNeq varName args orig =
  let r = p2sExtract varName args
  if r.ok then SeDiff { left = SeAll, right = SeEnum { values = [r.lit] } } else SeWhere { pred = orig }

-- cphCompare — ordered comparison; number/string bounds only (bool fences).
@label "comprehend: cphCompare"
@description "Compare a variable with a literal in either orientation. String bounds lower to precise intervals; numeric bounds retain their native comparison predicate. Other bounds fence, and nonliteral comparisons reach the existing affine recognizer."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphCompare : (varName: String) -> (f: String) -> (args: a) -> (orig: Expr) -> SetExpr
cphCompare varName f args orig =
  let r = p2sExtract varName args
  if r.ok
  then
    if cphBoundOk r.lit
    then (if r.left then cphVarLeft f r.lit orig else cphVarRight f r.lit orig)
    else SeWhere { pred = orig }
  else cphAffine varName f args orig

-- cphBoundOk — an interval bound must be a number or a string.
@label "comprehend: cphBoundOk"
@description "Stage A — interval bounds must be number- or string-valued (BoundNumber / BoundString are the decidable bound kinds); anything else fences. Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphBoundOk : (v: a) -> Bool
cphBoundOk v =
  if isNumber v then true else isString v

-- cphVarLeft — `var OP lit` (var on the LEFT) ⇒ the natural interval.
@label "comprehend: cphVarLeft"
@description "Variable-left comparison builder: String bounds emit the corresponding ordered interval; numeric bounds retain the original predicate under the native-carrier fence."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphVarLeft : (f: String) -> (v: a) -> (orig: Expr) -> SetExpr
cphVarLeft f v orig =
  -- A native numeric comparison refuses exact integer records which the
  -- ordered interval admits. Preserve the actual predicate until a carrier
  -- proof permits an exact extraction. String intervals keep their fragment.
  if isNumber v then SeWhere { pred = orig }
  else if eq f "lt" then SeInterval { interval = { lo = Nothing, hi = Just { value = v, inclusive = false } } }
  else if eq f "lte" then SeInterval { interval = { lo = Nothing, hi = Just { value = v, inclusive = true } } }
  else if eq f "gt" then SeInterval { interval = { lo = Just { value = v, inclusive = false }, hi = Nothing } }
  else if eq f "gte" then SeInterval { interval = { lo = Just { value = v, inclusive = true }, hi = Nothing } }
  else SeWhere { pred = orig }

-- cphVarRight — `lit OP var` (var on the RIGHT) ⇒ the FLIPPED interval.
@label "comprehend: cphVarRight"
@description "Variable-right comparison builder: String bounds emit the flipped ordered interval; numeric bounds retain the original predicate under the native-carrier fence."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphVarRight : (f: String) -> (v: a) -> (orig: Expr) -> SetExpr
cphVarRight f v orig =
  if isNumber v then SeWhere { pred = orig }
  else if eq f "lt" then SeInterval { interval = { lo = Just { value = v, inclusive = false }, hi = Nothing } }
  else if eq f "lte" then SeInterval { interval = { lo = Just { value = v, inclusive = true }, hi = Nothing } }
  else if eq f "gt" then SeInterval { interval = { lo = Nothing, hi = Just { value = v, inclusive = false } } }
  else if eq f "gte" then SeInterval { interval = { lo = Nothing, hi = Just { value = v, inclusive = true } } }
  else SeWhere { pred = orig }

-- cphNot — `not p` ⇒ SeComplement (recurse on the operand).
@label "comprehend: cphNot"
@description "Stage A — `not p` ⇒ SeComplement over `comprehend p`; empty operands fence. Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphNot : (varName: String) -> (args: a) -> (orig: Expr) -> SetExpr
cphNot varName args orig =
  case head args of
    Nothing -> SeWhere { pred = orig }
    Just a -> SeComplement { inner = comprehend varName a }

-- cphBranches — recurse comprehend over an and/or operand list.
-- NO 0/1 shortcuts here (predicateToSet never had them — the raw
-- comprehension); the `$where` path's shortcuts live in cphwAnd/cphwOr.
@label "comprehend: cphBranches"
@description "Stage A — map `comprehend varName` over an `and`/`or` operand list, accumulating SetExpr branches (no 0/1 shortcuts — those are the `$where` path's convention, applied in cphwAnd/cphwOr). Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphBranches : (varName: String) -> (args: a) -> (acc: a) -> a
cphBranches varName args acc =
  case head args of
    Nothing -> acc
    Just a ->
      let s = comprehend varName a
      let acc2 = appendItem s acc
      case tail args of
        Nothing -> acc2
        Just rest -> cphBranches varName rest acc2

-- ─────────────────────────────────────────────────────────────────────────
-- The affine tail (P12) — REUSES affineOf/flipRel; only the Se-emitting
-- output arms live here. (solve.fenel's Ws-emitting p2sAffine* arms are
-- deleted — this is their sole successor.)
-- ─────────────────────────────────────────────────────────────────────────

-- cphAffine — the affine fall-through entry (from cphEq / cphCompare).
@label "comprehend: cphAffine"
@description "Stage A — the affine fall-through (P12 math via the reused affineOf family): extract BOTH operands, normalise `lhs REL rhs` to `a·x REL k` (a = l.coeff − r.coeff, k = r.k − l.k), then orient (a>0), flip (a<0), or constant-fold (a=0). Either side non-affine ⇒ the SeWhere fence. Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1" "phase-12"
@category "engine-internal"
cphAffine : (varName: String) -> (f: String) -> (args: a) -> (orig: Expr) -> SetExpr
cphAffine varName f args orig =
  case head args of
    Nothing -> SeWhere { pred = orig }
    Just a0 ->
      case tail args of
        Nothing -> SeWhere { pred = orig }
        Just rest ->
          case head rest of
            Nothing -> SeWhere { pred = orig }
            Just a1 ->
              let la = affineOf varName a0
              if la.ok
              then
                let ra = affineOf varName a1
                if ra.ok
                then cphAffineBuild f (sub la.coeff ra.coeff) (sub ra.k la.k) orig
                else SeWhere { pred = orig }
              else SeWhere { pred = orig }

-- cphAffineBuild — orient `a·x REL k`: a>0 reuse builders; a<0 flip; a=0 fold.
@label "comprehend: cphAffineBuild"
@description "Stage A — build the SetExpr from the normalised `a·x REL k`: a = 0 ⇒ a constant comparison `0 REL k` (cphAffineConst ⇒ SeAll/SeNone); a > 0 ⇒ `x REL (k/a)` (op unchanged); a < 0 ⇒ the same with REL flipped (flipRel — reused). Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1" "phase-12"
@category "engine-internal"
cphAffineBuild : (f: String) -> (a: a) -> (k: a) -> (orig: Expr) -> SetExpr
cphAffineBuild f a k orig =
  if eq a 0 then cphAffineConst f k orig
  else if gt a 0 then cphAffineOriented f (div k a) orig
  else cphAffineOriented (flipRel f) (div k a) orig

-- cphAffineConst — `0 REL k` over constants ⇒ SeAll (true) / SeNone (false).
@label "comprehend: cphAffineConst"
@description "Stage A — the zero-coefficient (constant) case: evaluate `0 REL k` ⇒ SeAll when true, SeNone when false (`x == x` ⇒ SeAll, `x + 1 == x` ⇒ SeNone fall out here). Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1" "phase-12"
@category "engine-internal"
cphAffineConst : (f: String) -> (k: a) -> (orig: Expr) -> SetExpr
cphAffineConst f k orig =
  if eq f "eq" then (if eq k 0 then SeAll else SeNone)
  else if eq f "lt" then (if lt 0 k then SeAll else SeNone)
  else if eq f "lte" then (if lte 0 k then SeAll else SeNone)
  else if eq f "gt" then (if gt 0 k then SeAll else SeNone)
  else if eq f "gte" then (if gte 0 k then SeAll else SeNone)
  else SeWhere { pred = orig }

-- cphAffineOriented — `x REL bound` ⇒ SeEnum (eq) or the natural interval.
@label "comprehend: cphAffineOriented"
@description "Stage A — build `x REL bound` post-normalisation: eq ⇒ SeEnum [bound] (the headline `2*x+5==6 ⇒ 0.5`); lt/lte/gt/gte ⇒ cphVarLeft (the var-on-left builder — var-on-right is already folded into the normalisation, so routing it again would double-flip). Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1" "phase-12"
@category "engine-internal"
cphAffineOriented : (f: String) -> (bound: a) -> (orig: Expr) -> SetExpr
cphAffineOriented f bound orig =
  if eq f "eq" then SeEnum { values = [bound] }
  else cphVarLeft f bound orig

-- ─────────────────────────────────────────────────────────────────────────
-- comprehendClosed — the all-or-nothing face (no fence escapes).
-- ─────────────────────────────────────────────────────────────────────────

@label "Comprehend (closed)"
@description "The all-or-nothing face of comprehend: Just the SetExpr when the WHOLE predicate lowered into the decidable fragment; Nothing when any SeWhere fence appears anywhere in the result (a comprehend-fence SeWhere carries the residual predicate as `Expr`, which must not leak into `$`-key/JSON-Logic consumers). The boundary consumers (the `$where` extraction wrapper) route through this. decide-substrate Phase 1 Stage A."
@tags "engine" "comprehend" "decide-substrate" "phase-1"
comprehendClosed : (varName: String) -> (body: Expr) -> Maybe SetExpr
comprehendClosed varName body =
  let s = comprehend varName body
  if seHasWhere s then Nothing else Just s

-- seHasWhere — does a SeWhere occur anywhere in the tree?
@label "comprehend: seHasWhere"
@description "Stage A — recursive check: does any SeWhere node occur in the SetExpr tree? (comprehendClosed's fence detector.) Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
seHasWhere : (s: SetExpr) -> Bool
seHasWhere s =
  case s of
    SeWhere {} -> true
    SeComplement { inner = i } -> seHasWhere i
    SeUnion { branches = bs } -> cphAnyWhere bs
    SeIntersect { branches = bs } -> cphAnyWhere bs
    SeDiff { left = l, right = r } -> if seHasWhere l then true else seHasWhere r
    _ -> false

-- cphAnyWhere — seHasWhere over a branch list.
@label "comprehend: cphAnyWhere"
@description "Stage A — true when any branch in the list contains a SeWhere (seHasWhere lifted over lists). Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphAnyWhere : (bs: a) -> Bool
cphAnyWhere bs =
  case head bs of
    Nothing -> false
    Just b ->
      if seHasWhere b then true
      else
        case tail bs of
          Nothing -> false
          Just rest -> cphAnyWhere rest

-- ─────────────────────────────────────────────────────────────────────────
-- comprehendWhere — the `$where` entry (replaces whereToSetExpr). Walks the
-- marshalled JsonLogicExpr nodes; the JSON-Logic-specific arms (JleModEq /
-- JleIn) answer directly; everything else routes through comprehend (the
-- JleExpr neutral lift is where the affine gain enters). The 0/1/n and/or
-- shortcuts replicate the old wtsBuildAnd/wtsBuildOr conventions exactly.
-- ─────────────────────────────────────────────────────────────────────────

@label "Comprehend (where)"
@description "The `$where`-predicate entry of the ONE recognizer (replaces `whereToSetExpr`): walk the pre-marshalled JsonLogicExpr ADT to Maybe SetExpr. JleAnd/JleOr fold all-or-nothing with the 0 ⇒ SeAll/SeNone, 1 ⇒ child-as-is, n ⇒ SeIntersect/SeUnion shortcuts; JleNot ⇒ SeComplement; JleModEq ⇒ SeRef (the `multiple:N` named set); JleIn ⇒ SeEnum; JleComp (legacy, no longer marshalled) reconstructs the comparison Expr and routes through comprehendClosed; JleExpr (the NEUTRAL lift — the marshal's fall-through via jsonLogicToExpr) ⇒ comprehendClosed over the lifted Expr — the arm through which the `$where` path inherits the affine inversion. JleOther ⇒ Nothing. decide-substrate Phase 1 Stage A."
@tags "engine" "comprehend" "set-algebra" "where-to-set-expr" "decide-substrate" "phase-1"
comprehendWhere : (jle: JsonLogicExpr) -> Maybe SetExpr
comprehendWhere jle =
  case jle of
    JleOther -> Nothing
    JleAnd { children = cs } -> cphwAnd cs
    JleOr { children = cs } -> cphwOr cs
    JleNot { inner = i } ->
      case comprehendWhere i of
        Nothing -> Nothing
        Just s -> Just (SeComplement { inner = s })
    JleModEq { name = n } -> Just (SeRef { handle = n })
    JleIn { values = vs } -> Just (SeEnum { values = vs })
    JleComp { op = op, value = v, varSide = side, isNumeric = num } -> cphwComp op v side
    JleExpr { expr = e } -> comprehendClosed "value" e

-- cphwComp — legacy JleComp arm: rebuild the comparison Expr, route through
-- the one math. (The marshal no longer emits JleComp — comparisons ride the
-- JleExpr neutral lift — but the ctor stays on the entity; keep it faithful.)
@label "comprehend: cphwComp"
@description "Stage A — the legacy JleComp arm: map the op notation to its codeName (opNotationToCodeName — reused), rebuild the two-operand comparison Expr in the marshalled orientation, and route through comprehendClosed. Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphwComp : (op: String) -> (v: a) -> (side: String) -> Maybe SetExpr
cphwComp op v side =
  case opNotationToCodeName op of
    Nothing -> Nothing
    Just code ->
      if eq side "left"
      then comprehendClosed "value" (ECall { fnId = code, args = [EVar { name = "value" }, ELit { value = v }] })
      else comprehendClosed "value" (ECall { fnId = code, args = [ELit { value = v }, EVar { name = "value" }] })

-- cphwAnd — fold JleAnd children (all-or-nothing) + the 0/1/n shortcuts.
@label "comprehend: cphwAnd"
@description "Stage A / floor-kernel Phase 4 — fold the children of a JleAnd via cphwFold (short-circuit on Nothing), then the 0 ⇒ SeAll / 1 ⇒ child-as-is / n ⇒ normalized SeIntersect shortcuts. Bottom-up intersect normalization is Fenel-owned here; the former recursive TS wrapper walk is retired. Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphwAnd : (cs: a) -> Maybe SetExpr
cphwAnd cs =
  case cphwFold cs [] of
    Nothing -> Nothing
    Just parts ->
      if eq (length parts) 0 then Just (SeAll)
      else if eq (length parts) 1 then head parts
      else Just (setAlgebraNormalize (SeIntersect { branches = parts }))

-- cphwOr — fold JleOr children (all-or-nothing) + the 0/1/n shortcuts.
@label "comprehend: cphwOr"
@description "Stage A — fold the children of a JleOr via cphwFold (short-circuit on Nothing), then the 0 ⇒ SeNone / 1 ⇒ child-as-is / n ⇒ SeUnion shortcuts (the old wtsBuildOr convention). Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphwOr : (cs: a) -> Maybe SetExpr
cphwOr cs =
  case cphwFold cs [] of
    Nothing -> Nothing
    Just parts ->
      if eq (length parts) 0 then Just (SeNone)
      else if eq (length parts) 1 then head parts
      else Just (SeUnion { branches = parts })

-- cphwFold — left-fold comprehendWhere over children; Nothing short-circuits.
@label "comprehend: cphwFold"
@description "Stage A — left-fold comprehendWhere over a JleAnd/JleOr children list threading the accumulated SetExpr list; short-circuits to Nothing on the first non-extractable child (the all-or-nothing extraction contract). Internal helper."
@tags "engine" "internal" "comprehend" "decide-substrate" "phase-1"
@category "engine-internal"
cphwFold : (cs: a) -> (acc: a) -> Maybe a
cphwFold cs acc =
  case head cs of
    Nothing -> Just acc
    Just c ->
      case comprehendWhere c of
        Nothing -> Nothing
        Just s ->
          let acc2 = appendItem s acc
          case tail cs of
            Nothing -> Just acc2
            Just rest -> cphwFold rest acc2

-- (The TEMPORARY WitSet face — wsOfSe / wsOfSeBranches — is DELETED,
-- decide-substrate Phase 1 Stage B: the whole Ws marker world retired with
-- predicateToSet/witnessOfSet; `inhabit` (inhabit.fenel) reads the canonical
-- `Se*` this file emits, directly. `solve = inhabit ∘ comprehend`.)
