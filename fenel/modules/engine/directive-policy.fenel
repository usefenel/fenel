-- =========================================================================
-- directive-policy — the ONE table every `@directive` occurrence is validated
-- against BEFORE it is collated by name and BEFORE any LOAD-STAGE consumer runs.
-- (`@discriminator` is the one directive interpreted at the PARSE stage, by
-- whichever parser produced the AST, so validation cannot precede its
-- consumption — it is still validated. That split is the `stage` column below.)
-- declaration-annotations Phase 1 (Part A.0).
--
-- WHY THIS FILE EXISTS. The directive surface used to be FAIL-OPEN: an unknown
-- name (`@lable`) was silently dropped, a duplicate scalar silently kept only
-- its first occurrence, and a directive placed on the wrong declaration kind
-- was silently ignored. Each is silent data loss. This table is what makes the
-- surface fail CLOSED — every raw occurrence is checked against the row for its
-- name, and anything the table does not admit is a module-LOAD ERROR.
--
-- THIS TABLE IS THE SOURCE OF TRUTH. `implementations/typescript/engine/src/
-- fenel-module.ts` carries a MECHANICAL MIRROR of it (`DIRECTIVE_POLICY`),
-- because the gate runs at the loader's bootstrap position — before this file
-- has itself been loaded. The mirror is a law-bound projection of this Fenel
-- fact, NOT freestanding TypeScript: `fenel-directive-policy.test.ts` parses
-- this file, structurally decodes the rows below, and asserts deep equality
-- with the mirror. Edit THIS file first; the mirror follows in the same commit.
--
-- SCOPE FENCE. The name -> policy mapping here is CLOSED, exactly as the
-- surface it describes is closed today. The OPEN, registry-driven mapping
-- (`design/declaration-annotations.md` §2 defect 1 — "the directive-name ->
-- class mapping is a TypeScript enumeration ... the substrate is open; its only
-- ergonomic surface is closed") is deliberately NOT this phase's. It belongs to
-- the P2+ headless elaborator, which derives the payload type from the class
-- record itself. Do not grow this table into an elaborator.
-- =========================================================================


-- -------------------------------------------------------------------------
-- The three policy axes.
-- -------------------------------------------------------------------------

@entity
@label "Directive multiplicity"
@description "How many times one directive name may occur on a single declaration. DmScalar: at most once (a second occurrence is a LOAD ERROR — the old reader kept only the first, silently discarding the rest). DmAccumulating: repeats are legal and their arguments CONCATENATE in source order (`@requires` is intentionally repeated at fenel/modules/dispatch/types.fenel). DmSelectorKeyed: repeats are legal and keyed by the leading selector argument (`@fieldLabel \"a.b\" \"…\"` — 18 declarations repeat it); a duplicate selector key is a LOAD ERROR."
@tags "engine" "loader" "directive" "declaration-annotations" "phase-1"
@category "engine-internal"
DirectiveMultiplicity = DmScalar | DmAccumulating | DmSelectorKeyed

@entity
@label "Directive context"
@description "Which declaration kinds a directive may be placed on. DcAnyDecl: any declaration (the identity facets are form-agnostic — a refined-String atom carries `@label` exactly as a variant entity does). DcFunctionDecl: a function signature or definition only. DcTypeDecl: a type declaration only. A directive on the wrong kind is a LOAD ERROR — it used to be read by no consumer and silently dropped."
@tags "engine" "loader" "directive" "declaration-annotations" "phase-1"
@category "engine-internal"
DirectiveContext = DcAnyDecl | DcFunctionDecl | DcTypeDecl

@entity
@label "Directive stage"
@description "Which stage INTERPRETS the directive. DsLoad: the module loader (fenel-module.ts) consumes it. DsParse: the PARSE stage consumes it — `@discriminator` is the one such directive, lifted into the type_def's discriminator slot by syntax-to-jsonlogic.fenel's typedefFrame and its fenel-parser.ts mirror, never by the loader. The stage records who CONSUMES a directive; every row, at either stage, is still VALIDATED by the load gate."
@tags "engine" "loader" "directive" "declaration-annotations" "phase-1"
@category "engine-internal"
DirectiveStage = DsLoad | DsParse


-- -------------------------------------------------------------------------
-- One row per admitted directive name.
-- -------------------------------------------------------------------------

@entity
@label "Directive policy"
@description "One admitted directive name and everything the load gate checks about it: the argument-count schema (minArgs / maxArgs, where Nothing means unbounded — `@tags` legitimately carries 1..12 arguments today and the grammar admits any number), the multiplicity policy, the number of leading arguments that form the selector key (0 unless DmSelectorKeyed), the declaration kinds it may be placed on, and the stage that consumes it. A directive name with NO row here is rejected at module load."
@tags "engine" "loader" "directive" "declaration-annotations" "phase-1"
@category "engine-internal"
DirectivePolicy = DirectivePolicy
  name: String
  minArgs: Number
  maxArgs: Maybe Number
  multiplicity: DirectiveMultiplicity
  keyArity: Number
  context: DirectiveContext
  stage: DirectiveStage


-- -------------------------------------------------------------------------
-- THE TABLE. Ordered by family: identity facets, then the structural markers,
-- then the function-side markers, then the field-selector family.
--
-- Argument counts are the live corpus census at declaration-annotations P1
-- (345 files): label 5542x1 · description 5541x1 · tags 25x1 186x2 541x3
-- 1121x4 1749x5 1282x6 383x7 122x8 18x9 5x10 1x12 · category 4472x1 ·
-- native 543x0 · ioAction 240x1 · requires 196x1 · codeName 86x1 ·
-- fieldLabel 73x2 · icon 58x1 · emoji 6x1 · valueLabel 5x2 · widget 2x2 ·
-- helpText 2x2 · discriminator 2x1 · stopAction 1x1 · listInstancesAction 1x1 ·
-- fieldReusable 1x1. Zero unknown names are in live use.
-- -------------------------------------------------------------------------

@label "Directive policy table"
@description "The closed set of directive names the loader admits, one DirectivePolicy row each. The source of truth for fenel-module.ts's DIRECTIVE_POLICY mirror (pinned byte-for-byte by fenel-directive-policy.test.ts). Adding a directive name means adding a row HERE first."
@tags "engine" "loader" "directive" "declaration-annotations" "phase-1"
directivePolicyTable : [DirectivePolicy]
directivePolicyTable =
  [ DirectivePolicy { name = "label", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcAnyDecl, stage = DsLoad }
  , DirectivePolicy { name = "description", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcAnyDecl, stage = DsLoad }
  , DirectivePolicy { name = "tags", minArgs = 1, maxArgs = Nothing, multiplicity = DmAccumulating, keyArity = 0, context = DcAnyDecl, stage = DsLoad }
  , DirectivePolicy { name = "category", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcAnyDecl, stage = DsLoad }
  , DirectivePolicy { name = "icon", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcAnyDecl, stage = DsLoad }
  , DirectivePolicy { name = "emoji", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcAnyDecl, stage = DsLoad }
  , DirectivePolicy { name = "codeName", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcAnyDecl, stage = DsLoad }
  , DirectivePolicy { name = "entity", minArgs = 0, maxArgs = Just 0, multiplicity = DmScalar, keyArity = 0, context = DcTypeDecl, stage = DsLoad }
  , DirectivePolicy { name = "discriminator", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcTypeDecl, stage = DsParse }
  , DirectivePolicy { name = "native", minArgs = 0, maxArgs = Just 0, multiplicity = DmScalar, keyArity = 0, context = DcFunctionDecl, stage = DsLoad }
  , DirectivePolicy { name = "requires", minArgs = 1, maxArgs = Nothing, multiplicity = DmAccumulating, keyArity = 0, context = DcFunctionDecl, stage = DsLoad }
  , DirectivePolicy { name = "ioAction", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcFunctionDecl, stage = DsLoad }
  , DirectivePolicy { name = "stopAction", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcFunctionDecl, stage = DsLoad }
  , DirectivePolicy { name = "listInstancesAction", minArgs = 1, maxArgs = Just 1, multiplicity = DmScalar, keyArity = 0, context = DcFunctionDecl, stage = DsLoad }
  , DirectivePolicy { name = "fieldLabel", minArgs = 2, maxArgs = Just 2, multiplicity = DmSelectorKeyed, keyArity = 1, context = DcAnyDecl, stage = DsLoad }
  , DirectivePolicy { name = "valueLabel", minArgs = 2, maxArgs = Just 2, multiplicity = DmSelectorKeyed, keyArity = 1, context = DcTypeDecl, stage = DsLoad }
  , DirectivePolicy { name = "widget", minArgs = 2, maxArgs = Just 2, multiplicity = DmSelectorKeyed, keyArity = 1, context = DcTypeDecl, stage = DsLoad }
  , DirectivePolicy { name = "helpText", minArgs = 2, maxArgs = Just 2, multiplicity = DmSelectorKeyed, keyArity = 1, context = DcTypeDecl, stage = DsLoad }
  , DirectivePolicy { name = "fieldReusable", minArgs = 1, maxArgs = Just 1, multiplicity = DmSelectorKeyed, keyArity = 1, context = DcTypeDecl, stage = DsLoad }
  ]
