module engine where

-- =========================================================================
-- validation.fenel — the Phase 4+4b contract/certificate data (P4-D1).
--
-- Registered data for scheme-aware annotation validation: the closed reason
-- and eligibility ADTs, the judgment-1 verdict + provenance, the certificate
-- reference/payload records, occurrence authority, the typed use-site path
-- vocabulary, and the signature-use evidence carrier. Normative: the
-- combined P4+4b brief (D1, with the 2026-07-24 amended S0/S1/S3 gates) +
-- design/signatures-and-contracts.md. Constructor names carry family
-- prefixes (Rsn/Elig/Vd/Mco/Osa/Tse/Nsu/Prs/Vps/Vur/Vus/Vul) because
-- constructor ids are repo-global (the P2 Sp*/Llvm* collision precedent).
--
-- SLICE-2 POSTURE: this module is INERT EVIDENCE DATA — no checker, decider,
-- kernel, or dispatch path consumes it, and no authority-producing API is
-- public (the phase-4 static gate proves non-judgment-reachability until the
-- slice-3 cutover wires the validator).
--
-- DISCIPLINE PINS (enforced by the slice-3 checker/publisher; restated here
-- so the data model reads correctly):
--  * A public `VdValidated` exists only with its current certificate ref;
--    `VdIndeterminate` never upgrades; a raw primitive certificate, public
--    verdict, authored declaration, or inference derivation is NEVER checker
--    input — only `TrustedSignatureUseEvidence` is.
--  * `checkedAt` is observation metadata: outside every semantic hash.
--  * Hash slots are `ValidationHash {domain, hex}` — runtime-domain-tagged;
--    a cross-domain comparison is a boundary rejection, never an equality.
--  * judgment2/judgment3 slots are explicit Pending values in this phase.
--  * Negative rows are cache/invalidation material only — never
--    `OccurrenceAuthority`, never checker input.
-- =========================================================================

-- One domain-tagged digest (the S2 canonical-byte + SHA-256 leaf output;
-- `domain` is the `fenel.validation.<kind>.v1` literal the encoder prefixed).
ValidationHash = ValidationHash domain: String hex: String

-- ---- closed reasons ------------------------------------------------------

ValidationReason =
  RsnEffectfulScEff requires: [String]
  | RsnCapture detail: String
  | RsnUnsupportedSyntax form: String path: [UsePathSeg]
  | RsnQuantifiedReflection channel: String path: [UsePathSeg]
  | RsnUnsupportedRankOrKind detail: String
  | RsnUnsupportedKindedRigidApplication path: [UsePathSeg]
  | RsnDependentEl path: [UsePathSeg]
  | RsnMissingEvidence useId: String observed: String
  | RsnStaleEvidence useId: String observed: String
  | RsnUnresolvedSignatureUse useId: String status: String
  | RsnScopeDependentDispatch useId: String
  | RsnUnsupportedRegisteredReference useId: String
  | RsnUnsupportedPartialApplication useId: String
  | RsnDynamicOrReflectiveUse useId: String detail: String
  | RsnParserRepresentationDivergence bodyHash: String provenance: String
  | RsnTotalityUnknown detail: String
  | RsnMissingPrimitiveCertificate functionId: String
  | RsnMissingActiveHandler functionId: String
  | RsnPrimitiveClaimMismatch functionId: String detail: String
  | RsnHostileInput detail: String
  | RsnSccAssumptionNotValidated sccId: String
  | RsnUnsolvedUseInstance useId: String
  | RsnCheckerAbstained detail: String
  -- SLICE 3h. The executor-profile refusal (O1) and the pre-checker
  -- classifier's closed class vocabulary (D6). Each names ONE class so a
  -- census can count them separately; a shared "unsupported" reason would
  -- make the classes unreportable, which is the whole point of censusing them.
  | RsnExecutorProfileUnsupported profile: String
  | RsnUnclassifiedOccurrence useId: String detail: String
  | RsnUncertifiedStagewiseOverapplication useId: String detail: String
  | RsnNonFenelOriginOverapplication useId: String origin: String
  | RsnNamedArgumentUndecidable useId: String detail: String
  | RsnUnsupportedLambdaArgument useId: String detail: String

-- ---- the typed use-site path vocabulary (amended S1: never a string) ------

UsePathSeg =
  VpsCallee
  | VpsArg index: Nat
  | VpsSeq index: Nat
  | VpsBinding name: String index: Nat
  | VpsArmPattern index: Nat
  | VpsArmGuard index: Nat
  | VpsArmBody index: Nat
  | VpsPatternArg index: Nat
  | VpsPatternField key: String
  | VpsField key: String
  | VpsLambdaBody
  | VpsScrutinee
  | VpsCond
  | VpsThen
  | VpsElse
  | VpsWhereBinding name: String index: Nat

-- The syntactic ROLE of a use site. Locality, saturation, authority kind, and
-- enters-target are ORTHOGONAL resolved fields (amended S1: a same-SCC
-- underapplication is not two overlapping kinds).
UseRole =
  VurCall
  | VurReference
  | VurConstructor
  | VurIntrinsic
  | VurCapabilityDispatch
  | VurLexical

UseSaturation =
  VusExact
  | VusUnder supplied: Nat
  | VusOver supplied: Nat

UseLocality =
  VulExternal
  | VulCurrentScc
  | VulLexical

SignatureUseSite = SignatureUseSite callerId: String role: UseRole path: [UsePathSeg]

-- ---- eligibility ---------------------------------------------------------

ValidationEligibility =
  EligUnsupported reason: ValidationReason
  | EligEvidenceIncomplete reason: ValidationReason
  | EligEvidenceComplete

PrimitiveClaimPolicyDecision =
  ClaimFenced reason: ValidationReason
  | ClaimAdmissible functionId: String schemeHash: ValidationHash implementationHash: ValidationHash requiredSignatureHonesty: Boolean requiredPurityEffect: String requiredTotality: String

-- ---- provenance + verdicts ----------------------------------------------

ValidationProvenance = ValidationProvenance validatorId: String validatorVersion: String contextKey: ValidationHash invalidationHash: ValidationHash checkedAt: String

SccCertificateRef = SccCertificateRef sccId: String certificateHash: ValidationHash memberEvidenceHash: ValidationHash

DependencyCertificateRef = DependencyCertificateRef functionId: String dependencyCertificateHash: ValidationHash

VerifiedPrimitiveCertificateRef = VerifiedPrimitiveCertificateRef functionId: String schemeHash: ValidationHash implementationHash: ValidationHash implementationOrigin: String authorityHash: ValidationHash

ValidationCertificateRef =
  FenelSccValidation sccRef: SccCertificateRef
  | PrimitiveValidation rootRef: VerifiedPrimitiveCertificateRef

ValidationVerdict =
  VdUnchecked
  | VdValidated provenance: ValidationProvenance certificate: ValidationCertificateRef
  | VdRefuted provenance: ValidationProvenance counterexample: Maybe Any
  | VdIndeterminate provenance: ValidationProvenance reason: ValidationReason

MemberCheckOutcome =
  McoPassed evidence: MemberEvidence
  | McoRefuted evidence: MemberEvidence counterexample: Maybe Any
  | McoIndeterminate evidence: MemberEvidence reason: ValidationReason

MemberEvidence = MemberEvidence functionId: String schemeHash: ValidationHash bodyJudgmentHash: ValidationHash occurrenceEvidenceHashes: [ValidationHash] totalityEvidenceHash: ValidationHash

-- The pending judgment-2/3 slots (explicit registered values, never omitted).
PendingJudgment = PendingJudgment reason: String

FunctionValidationInfo = FunctionValidationInfo functionId: String effectiveSchemeHash: ValidationHash eligibility: ValidationEligibility judgment1: ValidationVerdict judgment2Pending: PendingJudgment judgment3Pending: PendingJudgment

-- ---- occurrence authority + signature-use evidence -----------------------

OccurrenceAuthority =
  OsaExternalDependency depRef: DependencyCertificateRef
  | OsaVerifiedPrimitive rootRef: VerifiedPrimitiveCertificateRef
  | OsaCurrentSccAssumption sccId: String targetFunctionId: String schemeHash: ValidationHash
  | OsaLexicalBinding binderId: String monotypeHash: ValidationHash
  | OsaLexicalRegisteredCallable binderId: String originUseId: String targetFunctionId: String residualArrowHash: ValidationHash
  | OsaConstructorRule ownerIdentity: String targetId: String schemeHash: ValidationHash ruleVersion: String wireProjectionHash: ValidationHash
  | OsaIntrinsicRule ruleId: String ruleVersion: String

TrustedSignatureUseEvidence =
  TseCertifiedFenelDependency depRef: DependencyCertificateRef
  | TseVerifiedPrimitiveRoot rootRef: VerifiedPrimitiveCertificateRef

-- Negative rows are a CLOSED ADT (not one loose optional record): the
-- status-specific payloads distinguish fenced / missing / ambiguous (with
-- the complete sorted candidates) / dynamic-reflective / parser-divergent /
-- resolved-but-unevidenced states. Cache/invalidation material only.
NegativeSignatureUseState =
  NsuFenced targetId: String diagnostics: [Any]
  | NsuMissing spelling: String
  | NsuAmbiguous candidates: [String]
  | NsuDynamicOrReflective detail: String
  | NsuParserDivergent bodyHash: String provenance: String
  | NsuNoCertificate targetId: String
  | NsuUnchecked targetId: String
  | NsuIndeterminate targetId: String
  | NsuRefuted targetId: String
  | NsuStaleEvidence targetId: String expected: ValidationHash observed: ValidationHash

SignatureUseEvidence =
  SueAuthorized site: SignatureUseSite resolvedUseId: String locality: UseLocality saturation: UseSaturation entersTarget: Boolean groundInstanceHash: ValidationHash authority: OccurrenceAuthority
  | SueNegative site: SignatureUseSite state: NegativeSignatureUseState reason: ValidationReason

-- ---- primitive roots -----------------------------------------------------

PrimitiveRootStateEvidence =
  PrsVerified rootRef: VerifiedPrimitiveCertificateRef
  | PrsNegative functionId: String inventoryKey: String claimPolicy: PrimitiveClaimPolicyDecision observedAuthorityState: String reason: ValidationReason

-- Full certificate payloads (registry-local; the refs above are their join
-- keys; every hash slot's domain literal is fixed by the brief's D1 table).

DependencyCertificate = DependencyCertificate functionId: String schemeHash: ValidationHash implementationHash: ValidationHash implementationOrigin: String sourceSccId: String sourceSccCertificateHash: ValidationHash memberEvidenceHash: ValidationHash validatedEvidenceHash: ValidationHash dependencyCertificateHash: ValidationHash

PrimitiveCertificate = PrimitiveCertificate functionId: String schemeHash: ValidationHash implementationHash: ValidationHash implementationOrigin: String signatureHonestyClaim: Boolean purityEffectClaim: String totalityClaim: String signatureHonestyClaimHash: ValidationHash purityEffectClaimHash: ValidationHash totalityClaimHash: ValidationHash manifestKey: String manifestDigest: String issuer: String issuerVersion: String authorityHash: ValidationHash

SccCertificate = SccCertificate sccId: String members: [String] effectiveSchemeHashes: [ValidationHash] occurrenceEvidenceHashes: [ValidationHash] dependencies: [DependencyCertificateRef] totalityEvidenceHash: ValidationHash memberEvidence: [MemberEvidence] sccInvalidationHash: ValidationHash
