-- =========================================================================
-- Compile-pipeline IR deep-ADT canonical declarations — CoreExpr,
-- CorePattern, CeExpr. Shared across the three compile targets
-- (compile-js / compile-llvm / compile-wasm) and consumed by the body
-- fenel files in this directory (normalise-to-core.fenel,
-- make-effects-explicit.fenel, make-closures-explicit.fenel, emit-js.fenel,
-- lower-to-wasm-ast.fenel, lower-to-llvm-ast.fenel).
--
-- Phase 4i of ts-elimination: pre-4i these three ADTs were declared inside
-- multiple body fenel files with shape-divergent field counts that the
-- `_extraEntities` first-registration-wins dedup silently papered over.
-- Concretely, `normalise-to-core.fenel`'s `CoreConstruct` declared 3 fields
-- (`ctor: String args: a fields: a`) matching the TS source-of-truth at
-- `ir/core.ts:133-138` (`fields?` is the Phase 21.1 named-field metadata),
-- while `make-effects-explicit.fenel`'s `CoreConstruct` declared only 2
-- (`ctor: String args: a`, no `fields`). Same divergence on `PatConstruct`.
-- Whichever module loaded first won the dedup; runtime values supplied the
-- missing field so byte-equal self-host stayed green, but the catalog
-- recorded the leaner shape whenever `make-effects-explicit.fenel` won the
-- race — and the editor / inspector / dependent-type-checker saw the wrong
-- surface.
--
-- This file is the single canonical declaration site. The body fenel files
-- no longer redeclare these ADTs; their function bodies reference the
-- entities through the catalog. `engine.ts` spreads `irAstModule.entities`
-- FIRST into `engineBodyEntities` (before `irTypesModule.entities` and
-- before any body-file entities) so the canonical 3-field shape wins the
-- first-registration-wins tiebreak unconditionally — even if a future body
-- file accidentally reintroduces a leaner declaration.
--
-- The shared file loads into the `engine` module. The catalog walk through
-- `system-entities.ts` / `type-catalog.ts` surfaces these entities as
-- recognisable rows for the editor's constructor picker; the engine's
-- `construct` op + pattern matcher both consume the registered shape; the
-- function-spec `{$named: "CoreExpr"}` etc. tokens resolve through it.
-- =========================================================================


-- -------------------------------------------------------------------------
-- CoreExpr — RETIRED (expr-substrate Phase 4c). The compile front-end's
-- inter-pass IR is now the irreducible core `Expr` (7 cases, `fenel/std/
-- expr.fenel`): `normaliseToCore` delegates to `jsonLogicToExpr` and the
-- effects/closures passes walk `Expr`, reconstituting `CeIf`/`CeLet`/`CeDo`
-- into the downstream `CeExpr` (which KEEPS those cases — P0-locked). The
-- 10-case `CoreExpr` decl (CoreLit/CoreVar/CoreCall/CoreIf/CoreLet/CoreDo/
-- CoreLambda/CoreConstruct/CoreRecord/CoreMatch) is gone; `Expr` is the honest
-- type the program-envelope bodies now point at. `CorePattern` (below) STAYS —
-- the engine-side pattern decl (its `Pat*` tags are shared with std `Pattern`
-- by design; the CorePattern/Pattern collapse is a flagged follow-up).
-- -------------------------------------------------------------------------


-- -------------------------------------------------------------------------
-- CorePattern — Core IR pattern. Mirrors `ir/core.ts:CorePattern`
-- (~lines 166-185). 4-case variant for CoreMatch arms.
--
-- `PatConstruct.fields` — Phase 21.1 named-field metadata, same shape and
-- semantics as `CoreConstruct.fields`. Per-target pattern guards read
-- named fields via `<scrut>.<field>` instead of positional `_N` indexing
-- when `fields` is present; absence preserves Phase 19 positional-index
-- read for unregistered ADTs.
-- -------------------------------------------------------------------------

CorePattern a =
  PatLit value: a
  | PatVar name: String
  | PatWildcard
  | PatConstruct ctor: String args: a fields: a


-- -------------------------------------------------------------------------
-- CeExpr — ClosuresExplicit IR expression. Mirrors
-- `ir/closures-explicit.ts:CeExpr` (~lines 110-120). 10-case variant
-- produced by `makeClosuresExplicit`, consumed by the per-target lowering
-- passes (emit-js, lower-to-wasm-ast, lower-to-llvm-ast).
--
-- Field-for-field mirror of `CoreExpr` with ONE change: `CoreLambda`
-- becomes `CeClosure` carrying an explicit `captures: List<String>` free-
-- variable list (per `ir/closures-explicit.ts:33-36`). The closure-
-- conversion pass surfaces what was implicit lexical capture in CoreExpr
-- as a first-class field; load-bearing for Wasm / native targets that
-- materialise the capture environment as a record passed alongside the
-- function pointer. Do not "unify" CoreExpr and CeExpr — the `captures`
-- slot is exactly the difference.
--
-- `CeConstruct.fields` — passes through unchanged from `CoreConstruct.fields`
-- (per `ir/closures-explicit.ts:87-97`). Same 3-field shape, same named-
-- field-metadata semantics.
-- -------------------------------------------------------------------------

CeExpr a =
  CeLit value: a
  | CeVar name: String
  | CeCall fnId: String args: a
  | CeIf cond: a then: a else: a
  | CeLet bindings: a body: a
  | CeDo exprs: a
  | CeClosure params: a captures: a body: a
  | CeConstruct ctor: String args: a fields: a
  | CeRecord fields: a
  | CeMatch scrutinee: a arms: a
