module engine where

using prover (EpistemicStatus)

-- Recipe-functions S3 shared ABI. This file owns data shapes only. A value of
-- CheckedRecipeDomain is data, not a trust token: a live reader revalidates the
-- source snapshot before reusing it. Primitive admissions are supplied by the
-- reader's actual-routing observer, never inferred from OpaqueBody identity.

RecipePrimitiveRole = RecipeEq | RecipeHead | RecipeTail | RecipeFromMaybe
  | RecipeLength | RecipeConcat | RecipeAppendItem | RecipeLess | RecipeLessEqual
  | RecipeGreater | RecipeGreaterEqual | RecipeNot | RecipeIncludes
  | RecipeUnique | RecipeDistinctCount | RecipeFilter | RecipeSome
  | RecipeElem | RecipeAll | RecipeMap | RecipeFold

RecipePrimitiveAdmission = RecipePrimitiveAdmission identity: String role: RecipePrimitiveRole admitted: Bool constructors: List ConstructorRef

RecipeFoodRank = RecipeFoodRank identity: String value: ReflectionValue rank: Nat

RecipeDeclarationRole = RecipeFoodDeclaration | RecipePantryDeclaration | RecipeIngredientsDeclaration
RecipeNameBinding = RecipeNameBinding name: String target: String
RecipeDeclarationScope = RecipeDeclarationScope declaration: RecipeDeclarationRole owner: String bindings: List RecipeNameBinding

RecipeDomainSnapshot = RecipeDomainSnapshot foodType: ReflectionValue pantryType: ReflectionValue ingredientsType: ReflectionValue foods: List RecipeFoodRank rankVersion: Nat rankFunction: ReifiedFunction canonicalFunction: ReifiedFunction canonicalAfterFunction: ReifiedFunction scopes: List RecipeDeclarationScope

RecipeSourceOwner = RootSource | ExtraSource index: Nat | NamedSource identity: String
  | CapturedSource parent: RecipeSourceOwner capture: String path: List String

RecipeCallableObservation = RecipeCallableObservation owner: RecipeSourceOwner capture: String path: List String outcome: ReifyOutcome
RecipeConstructorIdentity = RecipeConstructorIdentity target: String functionId: String
RecipeSourceAdmission = RecipeSourceAdmission source: ReifiedFunction admitted: Bool
RecipeRepresentationAdmission = RecipeRepresentationAdmission constructor: String owner: String admitted: Bool

RecipeAnalysisSnapshot = RecipeAnalysisSnapshot recipe: ReifiedFunction domain: RecipeDomainSnapshot facts: ReflectionValue rule: ReifyOutcome primitives: List RecipePrimitiveAdmission generation: Maybe Number callables: List RecipeCallableObservation constructorIdentities: List RecipeConstructorIdentity sources: List RecipeSourceAdmission functions: List ReifyOutcome representations: List RecipeRepresentationAdmission

CheckedRecipeDomain = CheckedRecipeDomain source: RecipeDomainSnapshot foods: List RecipeFoodRank generation: Maybe Number

-- path is an Expr-child address, invocation identifies the call-site stack.
-- The owner is a typed source scope. Only NamedSource contains an actual
-- function identity; other scopes are proof coordinates, never dispatch keys.
-- Shared child numbering: ECall/EConstruct args use their ordinal; lambda
-- body uses 0; record field values use their ordinal; match scrutinee uses 0,
-- then arm i guard uses 1+2*i and body uses 2+2*i. No byte offsets required.
RecipeOccurrence = RecipeOccurrence owner: RecipeSourceOwner path: List Nat invocation: List Nat

RecipeRefusal = RecipeUnavailable | RecipeOpaque | RecipeUnsupported
  | RecipeBudgetExhausted | RecipeRecursive | RecipeInvalidDomain
  | RecipeInvalidPreparation | RecipeStaleSnapshot | RecipePrimitiveUnadmitted
  | RecipeConstructorUnresolved | RecipeUnknownFact | RecipeCertificateRejected

RecipeResidual = RecipeResidual occurrence: RecipeOccurrence expression: (Expr ReflectionValue) reason: RecipeRefusal correlation: String

-- Cardinality counts DISTINCT ranks. The checker validates ranks/domain and
-- filter lowering; it never infers uniqueness merely from this constructor.
-- Unknown identities correlate repeated observations in the same snapshot.
RecipeConstraint = RcAll | RcNone | RcHasFood rank: Nat
  | RcAnd terms: List RecipeConstraint | RcOr terms: List RecipeConstraint
  | RcNot inner: RecipeConstraint
  | RcCardinality ranks: List Nat lower: Nat upper: Nat
  | RcUnknown identity: String reason: RecipeRefusal

RecipeConditionOrigin = RecipeConditionOrigin occurrence: RecipeOccurrence expression: (Expr ReflectionValue) constraint: RecipeConstraint helper: Maybe String family: Maybe String facts: List String

RecipeFoodSelection = RecipeFoodSelection rank: Nat included: RecipeConstraint
RecipeSummaryEntry = RecipeSummaryEntry value: RecipeSymbolicValue included: RecipeConstraint
RecipePreparation = RecipePreparation available: RecipeConstraint foods: List RecipeFoodSelection
RecipeOutcome = RecipeOutcome condition: RecipeConstraint preparations: List RecipePreparation

-- Logical recipe metadata has explicit absence. Raw reflected Expr/Pattern
-- metadata and the compiler's optional raw Type wire remain unchanged.
RecipeSemanticSlot = RecipeSemanticSlot key: FieldKey wireName: String type: (Maybe Type)

-- Symbolic values preserve sharing in conditionals and lexical closures. A
-- closure stores the environment at its definition, not the caller's scope.
RecipeSymbolicValue = RvLiteral value: ReflectionValue | RvFood rank: Nat | RvPantry
  | RvList items: List RecipeSymbolicValue
  | RvRecord fields: List RecipeSymbolicField
  | RvConstruct identity: String args: List RecipeSymbolicValue fields: List RecipeSemanticSlot
  | RvClosure params: List String body: (Expr ReflectionValue) bindings: List RecipeSymbolicBinding occurrence: RecipeOccurrence
  | RvPrimitive admission: RecipePrimitiveAdmission collected: List RecipeSymbolicValue
  | RvConditional condition: RecipeConstraint whenTrue: RecipeSymbolicValue whenFalse: RecipeSymbolicValue
  | RvFiltered foods: List RecipeFoodSelection
  | RvCount foods: List RecipeFoodSelection
  | RvBoolean constraint: RecipeConstraint
  | RvResidual residual: RecipeResidual

RecipeSymbolicField = RecipeSymbolicField name: String value: RecipeSymbolicValue
RecipeSymbolicBinding = RecipeSymbolicBinding name: String value: RecipeSymbolicValue

RecipeTransitionRule = RtLiteral | RtVariable | RtConstructor | RtRecord
  | RtLambda | RtApply | RtHelper | RtBranch | RtMatch | RtPrimitive
  | RtSummary | RtResidual

-- Premises refer to transition ordinals. The checker validates acyclicity,
-- exact original Expr, environment, demand/path condition and rule, and then
-- independently rederives result and coverage. `result` is only a proposal.
RecipeTransition = RecipeTransition rule: RecipeTransitionRule occurrence: RecipeOccurrence expression: (Expr ReflectionValue) bindings: List RecipeSymbolicBinding condition: RecipeConstraint result: RecipeSymbolicValue premises: List Nat

RecipeExtraction = RecipeExtraction source: ReifiedFunction snapshot: RecipeAnalysisSnapshot outcomes: List RecipeOutcome residuals: List RecipeResidual origins: List RecipeConditionOrigin transitions: List RecipeTransition

RecipeApplicationRequest = RecipeApplicationRequest arguments: List RecipeSymbolicValue proposal: RecipeApplicationProposal
RecipeApplicationProposal = RecipeApplicationProposal source: ReifiedFunction arguments: List RecipeSymbolicValue result: RecipeSymbolicValue snapshot: RecipeAnalysisSnapshot transitions: List RecipeTransition origins: List RecipeConditionOrigin residuals: List RecipeResidual

RecipeExtractionCheck = RecipeAnalysisChecked analysis: RecipeExtraction domain: CheckedRecipeDomain status: EpistemicStatus
  | RecipeAnalysisRefused residuals: List RecipeResidual

-- Constraint search is a widening of emptiness/inhabitation over rank
-- languages, not evaluation of the recipe on a table of pantries.
RecipeConstraintVerdict = RecipeConstraintEmpty | RecipeConstraintWitness ranks: List Nat
  | RecipeConstraintUnknown reason: RecipeRefusal
