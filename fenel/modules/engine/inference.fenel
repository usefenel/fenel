module engine where

-- =========================================================================
-- inference.fenel — kinded, bounded rank-1 signature inference.
--
-- This is the semantic owner of signature-substrate Phase 2.  Host code may
-- descriptor-safely marshal TraversalType/Syntax values and store the plans
-- returned here, but it does not decide a type equation, choose a diagnostic,
-- generalize a variable, or classify trust.
--
-- Four roles are intentionally disjoint:
--   * SchemeVar / ItRigid — declaration-scoped and rigid;
--   * ItMeta             — fresh solver state, never published;
--   * Absent             — a loader obligation, never a type;
--   * ItNamed            — nominal identity (the compatibility view is $ref).
--
-- The inference representation is a `$`-free plain-record tree whose `tag`
-- field is one of the It* names below.  Keeping the work representation above
-- FenelType prevents metas/schemes from entering SetExpr.  Ground types arrive
-- through the audited TraversalType boundary; `inferenceTypeToCompatibility`
-- returns a `$`-free CompatibilityType marker which the boundary decoder turns
-- into FenelType without semantic branching.
--
-- Supported fragment: surface Syntax, syntactic unification + occurs check,
-- instantiation at use sites, sequential SLet/SWhere polymorphism,
-- monomorphic top-level recursive SCC assumptions, exact structural products by
-- semantic FieldKey token, output-only branch unions, and residual refinement
-- obligations.  Every unsupported form returns AnnotationRequired/Invalid;
-- there is no Any/Value/SeAll/shared-a fallback.
-- =========================================================================

Kind =
  KType
  | KArrow input: a output: a

SchemeVar = SchemeVar id: String sourceName: String kind: a

TypeScheme = TypeScheme quantified: a body: a

SlotDeclaration =
  Authored source: String
  | Inferred engine: String version: String derivation: String
  | Absent

SignatureTrust =
  Advisory evidence: a
  | InferredDerivation evidence: a
  | TrustedPrimitive evidence: a

InferenceOutcome =
  Solved plan: a
  | AnnotationRequired diagnostics: a
  | Invalid diagnostics: a

InferenceConstraint =
  TypeEquation left: a right: a path: String
  | DirectionalResidual inferred: a declared: a path: String

-- The registered ADT documents/exports the work vocabulary.  Recursive child
-- slots are deliberately loose carriers: well-formedness is checked by the
-- constructors/marshal boundary before any solver walk.
InferenceType =
  ItRigid id: String sourceName: String kind: a
  | ItMeta id: String kind: a
  | ItNamed name: String publicName: String
  | ItUnit
  | ItVoid
  | ItTypeUniverse
  | ItApp head: a args: a headKind: a kind: a
  | ItRecord fields: a
  | ItVariant cases: a discriminator: a
  | ItTuple items: a
  | ItMap keys: a values: a
  | ItRefined base: a set: a
  | ItMu identity: String body: a
  | ItTagged value: a phantom: a
  | ItOpaque identity: String pure: a
  | ItArrow params: a returns: a
  | ItUnion branches: a
  | ItIntersect branches: a
  | ItComplement inner: a


-- -------------------------------------------------------------------------
-- Outcomes and deterministic diagnostics
-- -------------------------------------------------------------------------

@label "Inference diagnostic"
@description "Build one stable signature-inference diagnostic record."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceDiagnostic : (code: String) -> (path: String) -> (message: String) -> a
inferenceDiagnostic code path message = { code = code, path = path, message = message }

@label "Inference annotation required"
@description "Return an AnnotationRequired outcome containing one stable diagnostic."
@tags "engine" "signature" "inference" "phase-2"
inferenceAnnotation : (code: String) -> (path: String) -> (message: String) -> InferenceOutcome
inferenceAnnotation code path message =
  AnnotationRequired { diagnostics = [inferenceDiagnostic code path message] }

@label "Inference invalid"
@description "Return an Invalid outcome containing one stable diagnostic."
@tags "engine" "signature" "inference" "phase-2"
inferenceInvalid : (code: String) -> (path: String) -> (message: String) -> InferenceOutcome
inferenceInvalid code path message =
  Invalid { diagnostics = [inferenceDiagnostic code path message] }

@label "Authoring literal membership checks"
@description "Retain a reader-scoped literal membership refusal without treating an undecided check as a mismatch or inventing another typing fact."
@tags "engine" "internal" "signature" "inference" "authoring"
@category "engine-internal"
inferenceAuthoringLiteralChecks : (checks: List ({ verdict: Maybe Boolean, path: String })) -> Maybe InferenceOutcome
inferenceAuthoringLiteralChecks checks =
  case head checks of
    Nothing -> Nothing
    Just check ->
      case check.verdict of
        Nothing -> inferenceAuthoringLiteralChecks (tailOr checks)
        Just accepted ->
          if eq accepted false then
            let diagnostics = [{
              code = "authoring.literal-membership",
              path = [check.path],
              functionId = "<authoring-expression>",
              message = "This value does not satisfy the required input type."
            }]
            Just (Invalid { diagnostics = diagnostics })
          else inferenceAuthoringLiteralChecks (tailOr checks)
        other -> inferenceAuthoringLiteralChecks (tailOr checks)

@label "Inference error"
@description "Build the Err payload used internally by the solver."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceErr : (code: String) -> (path: String) -> (message: String) -> Result a b
inferenceErr code path message = Err (inferenceDiagnostic code path message)

@label "Inference prepend item"
@description "Construct a list in source/structural order; appendItem is snoc, so recursive builders use an explicit singleton prefix."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePrependItem : (item: a) -> (items: b) -> b
inferencePrependItem item items = concat (appendItem item []) items


-- -------------------------------------------------------------------------
-- State, fresh metas, substitutions
-- -------------------------------------------------------------------------

@label "Inference initial state"
@description "Create deterministic solver state; fresh ids derive from the supplied declaration/SCC path."
@tags "engine" "signature" "inference" "phase-2"
inferenceInitialState : (path: String) -> a
inferenceInitialState path = inferenceInitialStateWith path []

@label "Inference initial state with declarations"
@description "modules-as-values Phase 5a — solver state carrying the host's nominal declaration rows, the evidence a field projection needs to unfold a nominal record application (inferenceProjectNominal). Rows ride in the state so a deferred projection discharged later by unification sees them too. `opaqueProvenance` records the field types read through an opaque type's pure view and the nominal owners whose declarations were unfolded (inferenceOpaqueProvenanceSettled)."
@tags "engine" "signature" "inference" "projection" "modules-as-values"
inferenceInitialStateWith : (path: String) -> (declarations: a) -> b
inferenceInitialStateWith path declarations = { path = path, next = 0, subst = [], residuals = [], projections = [], effectOpaque = false, localRecursiveOpaque = false, declarations = declarations, opaqueProvenance = { reads = [], unfolded = [] } }

@label "Inference fresh meta"
@description "Allocate one KType metavariable and return {type,state}; no process-global counter is used."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFresh : (state: a) -> b
inferenceFresh state =
  inferenceFreshKind KType state

@label "Inference fresh meta of kind"
@description "Allocate one metavariable of an explicit kind; higher-kinded scheme variables therefore never collapse to KType while instantiating."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFreshKind : (kind: a) -> (state: b) -> c
inferenceFreshKind kind state =
  let id = concat state.path (concat "#m" (toString state.next))
  { type = { tag = "ItMeta", id = id, kind = kind }, state = { path = state.path, next = add state.next 1, subst = state.subst, residuals = state.residuals, projections = state.projections, effectOpaque = state.effectOpaque, localRecursiveOpaque = state.localRecursiveOpaque, declarations = state.declarations, opaqueProvenance = state.opaqueProvenance } }

@label "Inference substitution lookup"
@description "Look up a metavariable in the immutable substitution list."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSubstLookup : (id: String) -> (subst: a) -> Maybe a
inferenceSubstLookup id subst =
  case head subst of
    Nothing -> Nothing
    Just entry ->
      if eq entry.id id then Just entry.type
      else inferenceSubstLookup id (tailOr subst)

@label "Inference prune"
@description "Follow metavariable substitutions to the current representative."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePrune : (type: a) -> (state: b) -> a
inferencePrune type state =
  if eq type.tag "ItMeta" then
    case inferenceSubstLookup type.id state.subst of
      Nothing -> type
      Just replacement -> inferencePrune replacement state
  else type

@label "Inference bind meta"
@description "Extend the immutable substitution with one solved metavariable."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceBindMetaState : (id: String) -> (type: a) -> (state: b) -> b
inferenceBindMetaState id type state =
  { path = state.path, next = state.next, subst = appendItem { id = id, type = type } state.subst, residuals = state.residuals, projections = state.projections, effectOpaque = state.effectOpaque, localRecursiveOpaque = state.localRecursiveOpaque, declarations = state.declarations, opaqueProvenance = state.opaqueProvenance }

@label "Inference append residual"
@description "Append a ground directional refinement residual to solver state."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAppendResidual : (residual: a) -> (state: b) -> b
inferenceAppendResidual residual state =
  { path = state.path, next = state.next, subst = state.subst, residuals = appendItem residual state.residuals, projections = state.projections, effectOpaque = state.effectOpaque, localRecursiveOpaque = state.localRecursiveOpaque, declarations = state.declarations, opaqueProvenance = state.opaqueProvenance }

@label "Inference mark effect-opaque"
@description "Record that an indirect higher-order call occurred. The HM type remains useful, but no registered scheme containing this call may be promoted as a trusted pure arrow without effect-row evidence."
@tags "engine" "internal" "signature" "inference" "effect" "phase-2"
@category "engine-internal"
inferenceMarkEffectOpaque : (state: a) -> a
inferenceMarkEffectOpaque state =
  { path = state.path, next = state.next, subst = state.subst, residuals = state.residuals, projections = state.projections, effectOpaque = true, localRecursiveOpaque = state.localRecursiveOpaque, declarations = state.declarations, opaqueProvenance = state.opaqueProvenance }

-- -------------------------------------------------------------------------
-- TraversalType -> InferenceType (the audited host boundary lands here)
-- -------------------------------------------------------------------------

@label "Inference quantified variable lookup"
@description "Find a declaration-scoped SchemeVar by source spelling."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceQuantifiedByName : (name: String) -> (quantified: a) -> Maybe a
inferenceQuantifiedByName name quantified =
  case head quantified of
    Nothing -> Nothing
    Just variable ->
      if eq variable.sourceName name then Just variable
      else inferenceQuantifiedByName name (tailOr quantified)

@label "Inference quantified variable lookup by identity"
@description "Find a declaration-scoped SchemeVar by its authoritative binder id. Source spelling is diagnostic only."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceQuantifiedById : (id: String) -> (quantified: a) -> Maybe a
inferenceQuantifiedById id quantified =
  case head quantified of
    Nothing -> Nothing
    Just variable ->
      let sourceId = if isNull variable.sourceId then variable.id else variable.sourceId
      if eq sourceId id then Just variable
      else inferenceQuantifiedById id (tailOr quantified)

@label "Inference field from traversal"
@description "Convert one identity-total TraversalType field to the solver field shape."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFieldFromTraversal : (field: a) -> (quantified: b) -> Result c d
inferenceFieldFromTraversal field quantified =
  case inferenceFromTraversal field.type quantified of
    Err e -> Err e
    Ok type -> Ok {
      key = field.semanticKey,
      keyToken = fieldKeyToken field.semanticKey,
      wireName = field.wireName,
      type = type
    }

@label "Inference raw fields from traversal"
@description "Convert a list of TraversalType fields in calling/source order; public wrappers validate semantic-key uniqueness and optionally canonicalize structural products."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRawFieldsFromTraversal : (fields: a) -> (quantified: b) -> Result c d
inferenceRawFieldsFromTraversal fields quantified =
  case head fields of
    Nothing -> Ok []
    Just field ->
      case inferenceFieldFromTraversal field quantified of
        Err e -> Err e
        Ok first ->
          case inferenceRawFieldsFromTraversal (tailOr fields) quantified of
            Err e -> Err e
            Ok rest -> Ok (inferencePrependItem first rest)

@label "Inference field tokens unique"
@description "Reject duplicate semantic FieldKeys at every authored traversal boundary."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFieldTokensUnique : (fields: a) -> (seen: b) -> Boolean
inferenceFieldTokensUnique fields seen =
  case head fields of
    Nothing -> true
    Just field ->
      if elem field.keyToken seen then false
      else inferenceFieldTokensUnique (tailOr fields) (appendItem field.keyToken seen)

@label "Inference field by token"
@description "Lookup a validated internal field by canonical semantic token."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFieldByToken : (token: String) -> (fields: a) -> Maybe a
inferenceFieldByToken token fields =
  case head fields of
    Nothing -> Nothing
    Just field -> if eq field.keyToken token then Just field else inferenceFieldByToken token (tailOr fields)

@label "Inference fields from tokens"
@description "Rebuild fields in sorted semantic-token order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFieldsFromTokens : (tokens: a) -> (fields: b) -> c
inferenceFieldsFromTokens tokens fields =
  case head tokens of
    Nothing -> []
    Just token ->
      case inferenceFieldByToken token fields of
        Nothing -> inferenceFieldsFromTokens (tailOr tokens) fields
        Just field -> inferencePrependItem field (inferenceFieldsFromTokens (tailOr tokens) fields)

@label "Inference fields from traversal"
@description "Convert calling-convention fields in source order while enforcing exact semantic FieldKey uniqueness."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFieldsFromTraversal : (fields: a) -> (quantified: b) -> Result c d
inferenceFieldsFromTraversal fields quantified =
  case inferenceRawFieldsFromTraversal fields quantified of
    Err e -> Err e
    Ok converted ->
      if inferenceFieldTokensUnique converted [] then Ok converted
      else inferenceErr "inference.duplicate-field-key" "type" "authored type contains duplicate semantic FieldKeys"

@label "Inference canonical structural fields from traversal"
@description "Convert and sort record/variant fields by semantic FieldKey so host/source insertion order cannot affect schemes."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalFieldsFromTraversal : (fields: a) -> (quantified: b) -> Result c d
inferenceCanonicalFieldsFromTraversal fields quantified =
  case inferenceFieldsFromTraversal fields quantified of
    Err e -> Err e
    Ok converted ->
      let tokens = sortLex (map (\field -> field.keyToken) converted)
      Ok (inferenceFieldsFromTokens tokens converted)

@label "Inference variant case from traversal"
@description "Convert one TraversalType variant case."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCaseFromTraversal : (variantCase: a) -> (quantified: b) -> Result c d
inferenceCaseFromTraversal variantCase quantified =
  case inferenceCanonicalFieldsFromTraversal variantCase.fields quantified of
    Err e -> Err e
    Ok fields -> Ok { name = variantCase.name, fields = fields }

@label "Inference raw variant cases from traversal"
@description "Convert a list of TraversalType variant cases before constructor-name validation/canonicalization."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRawCasesFromTraversal : (cases: a) -> (quantified: b) -> Result c d
inferenceRawCasesFromTraversal cases quantified =
  case head cases of
    Nothing -> Ok []
    Just variantCase ->
      case inferenceCaseFromTraversal variantCase quantified of
        Err e -> Err e
        Ok first ->
          case inferenceRawCasesFromTraversal (tailOr cases) quantified of
            Err e -> Err e
            Ok rest -> Ok (inferencePrependItem first rest)

@label "Inference constructor names unique"
@description "Reject duplicate variant constructors at the authored traversal boundary."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCaseNamesUnique : (cases: a) -> (seen: b) -> Boolean
inferenceCaseNamesUnique cases seen =
  case head cases of
    Nothing -> true
    Just variantCase ->
      if elem variantCase.name seen then false
      else inferenceCaseNamesUnique (tailOr cases) (appendItem variantCase.name seen)

@label "Inference variant case by name"
@description "Lookup one unique converted constructor by nominal name."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCaseByName : (name: String) -> (cases: a) -> Maybe a
inferenceCaseByName name cases =
  case head cases of
    Nothing -> Nothing
    Just variantCase -> if eq variantCase.name name then Just variantCase else inferenceCaseByName name (tailOr cases)

@label "Inference variant cases from names"
@description "Rebuild converted constructors in sorted nominal order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCasesFromNames : (names: a) -> (cases: b) -> c
inferenceCasesFromNames names cases =
  case head names of
    Nothing -> []
    Just name ->
      case inferenceCaseByName name cases of
        Nothing -> inferenceCasesFromNames (tailOr names) cases
        Just variantCase -> inferencePrependItem variantCase (inferenceCasesFromNames (tailOr names) cases)

@label "Inference variant cases from traversal"
@description "Convert, validate unique constructors, and canonicalize variants independently of declaration insertion order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCasesFromTraversal : (cases: a) -> (quantified: b) -> Result c d
inferenceCasesFromTraversal cases quantified =
  case inferenceRawCasesFromTraversal cases quantified of
    Err e -> Err e
    Ok converted ->
      if not (inferenceCaseNamesUnique converted [])
      then inferenceErr "inference.duplicate-constructor" "type" "authored variant contains duplicate constructor names"
      else
        let names = sortLex (map (\variantCase -> variantCase.name) converted)
        Ok (inferenceCasesFromNames names converted)

@label "Inference types from traversal"
@description "Convert a list of TraversalType children."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTypesFromTraversal : (types: a) -> (quantified: b) -> Result c d
inferenceTypesFromTraversal types quantified =
  case head types of
    Nothing -> Ok []
    Just type ->
      case inferenceFromTraversal type quantified of
        Err e -> Err e
        Ok first ->
          case inferenceTypesFromTraversal (tailOr types) quantified of
            Err e -> Err e
            Ok rest -> Ok (inferencePrependItem first rest)

@label "Inference kind after application"
@description "Consume one KArrow input per type argument, validating every argument kind and returning the residual/result kind."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceKindAfterApplication : (kind: a) -> (args: b) -> (path: String) -> Result c d
inferenceKindAfterApplication kind args path =
  case head args of
    Nothing -> Ok kind
    Just arg ->
      case kind of
        KType -> inferenceErr "inference.kind-arity" path "type constructor received more arguments than its kind permits"
        KArrow { input = input, output = output } ->
          if not (inferenceKindEq input (inferenceTypeKind arg))
          then inferenceErr "inference.kind-mismatch" path "type argument kind does not match the constructor input kind"
          else inferenceKindAfterApplication output (tailOr args) path

@label "Inference application from traversal"
@description "Interpret TtApp only through its mechanically reattached authoritative scheme sidecar. Binder identity and nominal reference are disjoint; an untagged TtApp is genuinely value-dependent and fences."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAppFromTraversal : (node: a) -> (quantified: b) -> Result c d
inferenceAppFromTraversal node quantified =
  if isNull node.schemeApplication then
    inferenceErr "inference.value-dependent-type" node.head "value-dependent type application is outside bounded rank-1 inference"
  else
    case inferenceTypesFromTraversal node.args quantified of
      Err e -> Err e
      Ok args ->
        let application = node.schemeApplication
        if not (isNull application.headVarId) then
          case inferenceQuantifiedById application.headVarId quantified of
            Nothing -> inferenceErr "inference.unbound-scheme-variable" node.head "scheme application names an unknown binder identity"
            Just variable ->
              if not (eq node.head variable.sourceName)
              then inferenceErr "inference.scheme-application-mismatch" node.head "scheme application spelling and binder identity disagree"
              else if not (inferenceKindEq variable.kind application.kind)
              then inferenceErr "inference.kind-mismatch" node.head "scheme application sidecar and binder kinds disagree"
              else
                case inferenceKindAfterApplication variable.kind args node.head of
                  Err e -> Err e
                  Ok resultKind -> Ok {
                    tag = "ItApp",
                    head = { tag = "ItRigid", id = variable.id, sourceName = variable.sourceName, kind = variable.kind },
                    args = args,
                    headKind = application.kind,
                    kind = resultKind
                  }
        else if not (isNull application.headRef) then
          if not (eq node.head application.headRef)
          then inferenceErr "inference.scheme-application-mismatch" node.head "nominal scheme application sidecar and traversal head disagree"
          else
            case inferenceKindAfterApplication application.kind args node.head of
              Err e -> Err e
              Ok resultKind -> Ok {
                tag = "ItApp",
                head = {
                  tag = "ItNamed",
                  name = if isString node.nominalIdentity then node.nominalIdentity else application.headRef,
                  publicName = application.headRef
                },
                args = args,
                headKind = application.kind,
                kind = resultKind
              }
        else inferenceErr "inference.malformed-scheme-application" node.head "scheme application sidecar has neither binder identity nor nominal reference"

@label "Inference arrow from traversal"
@description "Convert one TraversalType arrow and its semantic-keyed parameters."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceArrowFromTraversal : (node: a) -> (quantified: b) -> Result c d
inferenceArrowFromTraversal node quantified =
  case inferenceFieldsFromTraversal node.params quantified of
    Err e -> Err e
    Ok params ->
      case inferenceFromTraversal node.returns quantified of
        Err e -> Err e
        Ok returns -> Ok { tag = "ItArrow", params = params, returns = returns }

@label "Inference from traversal type"
@description "Convert the complete audited TraversalType vocabulary to InferenceType. TtUnknown/accessor/cycle and genuine TtEl values fail closed."
@tags "engine" "signature" "inference" "phase-2"
inferenceFromTraversal : (node: a) -> (quantified: b) -> Result c d
inferenceFromTraversal node quantified =
  case node of
    TtNamed { name = publicName } -> Ok {
      tag = "ItNamed",
      name = if isString node.nominalIdentity then node.nominalIdentity else publicName,
      publicName = publicName
    }
    TtVar { name = name } ->
      case inferenceQuantifiedByName name quantified of
        Just variable -> Ok { tag = "ItRigid", id = variable.id, sourceName = variable.sourceName, kind = variable.kind }
        Nothing -> inferenceErr "inference.unbound-scheme-variable" name (concat "unbound scheme variable " name)
    TtUnit -> Ok { tag = "ItUnit", value = true }
    TtVoid -> Ok { tag = "ItVoid", value = true }
    TtTypeUniverse -> Ok { tag = "ItTypeUniverse", value = true }
    TtEl -> inferenceErr "inference.value-dependent-type" "type" "genuinely value-dependent type is an inference fence"
    TtApp -> inferenceAppFromTraversal node quantified
    TtRecord { fields = fields } ->
      case inferenceCanonicalFieldsFromTraversal fields quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItRecord", fields = converted }
    TtVariant { cases = cases, discriminator = discriminator } ->
      case inferenceCasesFromTraversal cases quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItVariant", cases = converted, discriminator = discriminator }
    TtTuple { items = items } ->
      case inferenceTypesFromTraversal items quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItTuple", items = converted }
    TtMap { canonicalKeys = keys, values = values } ->
      case inferenceFromTraversal values quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItMap", keys = keys, values = converted }
    TtRefined { base = base, setView = set } ->
      case inferenceFromTraversal base quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItRefined", base = converted, set = set }
    TtMu { var = identity, body = body } ->
      let muVariable = SchemeVar { id = concat "$mu/" identity, sourceName = identity, kind = KType }
      case inferenceFromTraversal body (inferencePrependItem muVariable quantified) of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItMu", identity = identity, body = converted }
    TtTagged { value = value, phantom = phantom } ->
      case inferenceFromTraversal value quantified of
        Err e -> Err e
        Ok convertedValue ->
          case inferenceFromTraversal phantom quantified of
            Err e -> Err e
            Ok convertedPhantom -> Ok { tag = "ItTagged", value = convertedValue, phantom = convertedPhantom }
    TtOpaque { name = name, pure = pure } ->
      case inferenceFromTraversal pure quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItOpaque", identity = name, pure = converted }
    TtArrow -> inferenceArrowFromTraversal node quantified
    TtUnion { branches = branches } ->
      case inferenceTypesFromTraversal branches quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItUnion", branches = converted }
    TtIntersect { branches = branches } ->
      case inferenceTypesFromTraversal branches quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItIntersect", branches = converted }
    TtComplement { inner = inner } ->
      case inferenceFromTraversal inner quantified of
        Err e -> Err e
        Ok converted -> Ok { tag = "ItComplement", inner = converted }
    TtUnknown { invalid = invalid } ->
      if invalid
      then inferenceErr "inference.malformed-type" "type" "malformed/accessor-bearing type data was rejected"
      else inferenceErr "inference.cyclic-type" "type" "cyclic type data requires an annotation"


-- -------------------------------------------------------------------------
-- Occurs check and substitution application
-- -------------------------------------------------------------------------

@label "Inference occurs in type list"
@description "Occurs-check helper over a list of InferenceType values."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceOccursList : (id: String) -> (types: a) -> (state: b) -> Boolean
inferenceOccursList id types state =
  case head types of
    Nothing -> false
    Just type ->
      if inferenceOccurs id type state then true
      else inferenceOccursList id (tailOr types) state

@label "Inference occurs in fields"
@description "Occurs-check helper over semantic fields."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceOccursFields : (id: String) -> (fields: a) -> (state: b) -> Boolean
inferenceOccursFields id fields state =
  case head fields of
    Nothing -> false
    Just field ->
      if inferenceOccurs id field.type state then true
      else inferenceOccursFields id (tailOr fields) state

@label "Inference occurs in cases"
@description "Occurs-check helper over variant cases."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceOccursCases : (id: String) -> (cases: a) -> (state: b) -> Boolean
inferenceOccursCases id cases state =
  case head cases of
    Nothing -> false
    Just variantCase ->
      if inferenceOccursFields id variantCase.fields state then true
      else inferenceOccursCases id (tailOr cases) state

@label "Inference occurs check"
@description "True when an unsolved meta occurs structurally in a candidate replacement."
@tags "engine" "signature" "inference" "phase-2"
inferenceOccurs : (id: String) -> (type: a) -> (state: b) -> Boolean
inferenceOccurs id type state =
  let current = inferencePrune type state
  if eq current.tag "ItMeta" then eq id current.id
  else if eq current.tag "ItApp" then
    if inferenceOccurs id current.head state then true else inferenceOccursList id current.args state
  else if eq current.tag "ItRecord" then inferenceOccursFields id current.fields state
  else if eq current.tag "ItVariant" then inferenceOccursCases id current.cases state
  else if eq current.tag "ItTuple" then inferenceOccursList id current.items state
  else if eq current.tag "ItMap" then inferenceOccurs id current.values state
  else if eq current.tag "ItRefined" then inferenceOccurs id current.base state
  else if eq current.tag "ItMu" then inferenceOccurs id current.body state
  else if eq current.tag "ItTagged" then
    if inferenceOccurs id current.value state then true else inferenceOccurs id current.phantom state
  else if eq current.tag "ItOpaque" then inferenceOccurs id current.pure state
  else if eq current.tag "ItArrow" then
    if inferenceOccursFields id current.params state then true else inferenceOccurs id current.returns state
  else if eq current.tag "ItUnion" then inferenceOccursList id current.branches state
  else if eq current.tag "ItIntersect" then inferenceOccursList id current.branches state
  else if eq current.tag "ItComplement" then inferenceOccurs id current.inner state
  else false

@label "Inference apply substitution to fields"
@description "Apply the solved substitution recursively to semantic fields."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceApplyFields : (fields: a) -> (state: b) -> a
inferenceApplyFields fields state =
  case head fields of
    Nothing -> []
    Just field ->
      let converted = {
        key = field.key,
        keyToken = field.keyToken,
        wireName = field.wireName,
        type = inferenceApply field.type state
      }
      inferencePrependItem converted (inferenceApplyFields (tailOr fields) state)

@label "Inference apply substitution to cases"
@description "Apply the solved substitution recursively to variant cases."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceApplyCases : (cases: a) -> (state: b) -> a
inferenceApplyCases cases state =
  case head cases of
    Nothing -> []
    Just variantCase ->
      let converted = { name = variantCase.name, fields = inferenceApplyFields variantCase.fields state }
      inferencePrependItem converted (inferenceApplyCases (tailOr cases) state)

@label "Inference apply substitution to list"
@description "Apply the solved substitution recursively to a list of types."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceApplyList : (types: a) -> (state: b) -> a
inferenceApplyList types state =
  case head types of
    Nothing -> []
    Just type -> inferencePrependItem (inferenceApply type state) (inferenceApplyList (tailOr types) state)

@label "Inference apply substitution"
@description "Recursively replace every solved meta; the result is used before generalization/publication."
@tags "engine" "signature" "inference" "phase-2"
inferenceApply : (type: a) -> (state: b) -> a
inferenceApply type state =
  let current = inferencePrune type state
  if eq current.tag "ItApp" then { tag = "ItApp", head = inferenceApply current.head state, args = inferenceApplyList current.args state, headKind = current.headKind, kind = current.kind }
  else if eq current.tag "ItRecord" then { tag = "ItRecord", fields = inferenceApplyFields current.fields state }
  else if eq current.tag "ItVariant" then { tag = "ItVariant", cases = inferenceApplyCases current.cases state, discriminator = current.discriminator }
  else if eq current.tag "ItTuple" then { tag = "ItTuple", items = inferenceApplyList current.items state }
  else if eq current.tag "ItMap" then { tag = "ItMap", keys = current.keys, values = inferenceApply current.values state }
  else if eq current.tag "ItRefined" then { tag = "ItRefined", base = inferenceApply current.base state, set = current.set }
  else if eq current.tag "ItMu" then { tag = "ItMu", identity = current.identity, body = inferenceApply current.body state }
  else if eq current.tag "ItTagged" then { tag = "ItTagged", value = inferenceApply current.value state, phantom = inferenceApply current.phantom state }
  else if eq current.tag "ItOpaque" then { tag = "ItOpaque", identity = current.identity, pure = inferenceApply current.pure state }
  else if eq current.tag "ItArrow" then { tag = "ItArrow", params = inferenceApplyFields current.params state, returns = inferenceApply current.returns state }
  else if eq current.tag "ItUnion" then { tag = "ItUnion", branches = inferenceApplyList current.branches state }
  else if eq current.tag "ItIntersect" then { tag = "ItIntersect", branches = inferenceApplyList current.branches state }
  else if eq current.tag "ItComplement" then { tag = "ItComplement", inner = inferenceApply current.inner state }
  else current


-- -------------------------------------------------------------------------
-- Syntactic unification
-- -------------------------------------------------------------------------

@label "Inference kind equality"
@description "Structural equality over KType/KArrow kinds."
@tags "engine" "signature" "inference" "phase-2"
inferenceKindEq : (left: a) -> (right: b) -> Boolean
inferenceKindEq left right =
  case left of
    KType -> case right of KType -> true; KArrow -> false
    KArrow { input = li, output = lo } ->
      case right of
        KType -> false
        KArrow { input = ri, output = ro } ->
          if inferenceKindEq li ri then inferenceKindEq lo ro else false

@label "Inference type kind"
@description "Read the kind carried by a solver leaf/application; every ground FenelType constructor has KType."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTypeKind : (type: a) -> b
inferenceTypeKind type =
  if eq type.tag "ItMeta" then type.kind
  else if eq type.tag "ItRigid" then type.kind
  else if eq type.tag "ItApp" then type.kind
  else KType

@label "Inference bind meta"
@description "Bind a fresh meta after kind and occurs checks."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceBindMeta : (meta: a) -> (type: b) -> (state: c) -> (path: String) -> Result d e
inferenceBindMeta meta type state path =
  let current = inferencePrune type state
  if eq current.tag "ItMeta" then
    if eq meta.id current.id then Ok state
    else if not (inferenceKindEq meta.kind current.kind) then inferenceErr "inference.kind-mismatch" path "metavariable kinds do not agree"
    else inferenceDischargeReadyProjections (inferenceBindMetaState meta.id current state)
  else if inferenceOccurs meta.id current state then
    inferenceErr "inference.occurs-check" path (concat "occurs check failed for " meta.id)
  else if not (inferenceKindEq meta.kind (inferenceTypeKind current)) then
    inferenceErr "inference.kind-mismatch" path "metavariable and solved type kinds do not agree"
  else inferenceDischargeReadyProjections (inferenceBindMetaState meta.id current state)

@label "Inference find field"
@description "Find a field by its canonical semantic FieldKey token, never wire spelling."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFindField : (keyToken: String) -> (fields: a) -> Maybe a
inferenceFindField keyToken fields =
  case head fields of
    Nothing -> Nothing
    Just field ->
      if eq keyToken field.keyToken then Just field
      else inferenceFindField keyToken (tailOr fields)

@label "Inference find case"
@description "Find a variant case by nominal constructor name."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFindCase : (name: String) -> (cases: a) -> Maybe a
inferenceFindCase name cases =
  case head cases of
    Nothing -> Nothing
    Just variantCase ->
      if eq name variantCase.name then Just variantCase
      else inferenceFindCase name (tailOr cases)

@label "Inference unify type lists"
@description "Unify two equal-width ordered type lists, threading substitution state."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyLists : (left: a) -> (right: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnifyLists left right state path =
  if not (eq (length left) (length right)) then inferenceErr "inference.width-mismatch" path "type constructor widths do not agree"
  else
    case head left of
      Nothing -> Ok state
      Just leftType ->
        case head right of
          Nothing -> inferenceErr "inference.width-mismatch" path "type constructor widths do not agree"
          Just rightType ->
            case inferenceUnify leftType rightType state path of
              Err e ->
                if inferenceSetFormerFence e then inferenceAfterSetFormerFence e (inferenceUnifyLists (tailOr left) (tailOr right) state path)
                else Err e
              Ok next -> inferenceUnifyLists (tailOr left) (tailOr right) next path

@label "Inference unify fields"
@description "Width-exact field unification by semantic FieldKey token, independent of declaration/insertion order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyFields : (left: a) -> (right: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnifyFields left right state path =
  if not (eq (length left) (length right)) then inferenceErr "inference.field-width-mismatch" path "record/variant field widths do not agree"
  else inferenceUnifyFieldsGo left right state path

@label "Inference unify fields walk"
@description "Walk the left field set after the wrapper has checked width once; right remains the complete semantic-key index."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyFieldsGo : (left: a) -> (right: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnifyFieldsGo left right state path =
  case head left of
    Nothing -> Ok state
    Just leftField ->
      case inferenceFindField leftField.keyToken right of
        Nothing -> inferenceErr "inference.field-key-mismatch" path (concat "missing semantic field " leftField.keyToken)
        Just rightField ->
          case inferenceUnify leftField.type rightField.type state (concat path (concat "/" leftField.keyToken)) of
            Err e ->
              if inferenceSetFormerFence e then inferenceAfterSetFormerFence e (inferenceUnifyFieldsGo (tailOr left) right state path)
              else Err e
            Ok next -> inferenceUnifyFieldsGo (tailOr left) right next path

@label "Inference unify cases"
@description "Width-exact variant unification by constructor identity, then semantic FieldKey."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyCases : (left: a) -> (right: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnifyCases left right state path =
  if not (eq (length left) (length right)) then inferenceErr "inference.variant-width-mismatch" path "variant constructor sets do not agree"
  else inferenceUnifyCasesGo left right state path

@label "Inference unify cases walk"
@description "Walk the left constructor set after one width check; right remains the complete constructor index."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyCasesGo : (left: a) -> (right: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnifyCasesGo left right state path =
  case head left of
    Nothing -> Ok state
    Just leftCase ->
      case inferenceFindCase leftCase.name right of
        Nothing -> inferenceErr "inference.constructor-mismatch" path (concat "missing constructor " leftCase.name)
        Just rightCase ->
          case inferenceUnifyFields leftCase.fields rightCase.fields state (concat path (concat "/" leftCase.name)) of
            Err e ->
              if inferenceSetFormerFence e then inferenceAfterSetFormerFence e (inferenceUnifyCasesGo (tailOr left) right state path)
              else Err e
            Ok next -> inferenceUnifyCasesGo (tailOr left) right next path

@label "Inference map-key equality"
@description "Decide exact equality of two ground map key domains by mutual subset."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceMapKeysEq : (left: a) -> (right: b) -> Maybe Boolean
inferenceMapKeysEq left right =
  case decideSubset left right of
    Nothing -> Nothing
    Just false -> Just false
    Just true -> decideSubset right left

@label "Inference reindex arrow param"
@description "Re-derive one internal positional parameter's flattened key, token, and wire name; named FieldKeys are representation-stable."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceReindexArrowParam : (param: a) -> (ordinal: Number) -> a
inferenceReindexArrowParam param ordinal =
  case param.key of
    PositionalField ->
      let key = PositionalField { index = ordinal }
      {
        key = key,
        keyToken = fieldKeyToken key,
        wireName = concat "_" (fieldNaturalDecimal ordinal),
        type = param.type
      }
    NamedField -> param

@label "Inference reindex arrow params"
@description "Apply the shipped arrow container law to an internal inference parameter list."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceReindexArrowParams : (params: a) -> (ordinal: Number) -> a
inferenceReindexArrowParams params ordinal =
  case head params of
    Nothing -> []
    Just param ->
      inferencePrependItem
        (inferenceReindexArrowParam param ordinal)
        (inferenceReindexArrowParams (tailOr params) (add ordinal 1))

@label "Inference flatten arrow"
@description "Normalize a curried arrow to the shipped flat calling-convention form, then re-derive positional keys, tokens, and wire names at their flattened ordinals."
@tags "engine" "signature" "inference" "phase-2"
inferenceFlattenArrow : (type: a) -> a
inferenceFlattenArrow type =
  if not (eq type.tag "ItArrow") then type
  else
    let returns = inferenceFlattenArrow type.returns
    let params = if eq returns.tag "ItArrow" then concat type.params returns.params else type.params
    let finalReturn = if eq returns.tag "ItArrow" then returns.returns else returns
    { tag = "ItArrow", params = inferenceReindexArrowParams params 0, returns = finalReturn }

@label "Inference arrow field key valid"
@description "Arrow schemes may carry either embedded UUID NamedFields or syntactically valid lock-less SourceHandles. Positional validity stays delegated to the FieldKey kernel."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceArrowFieldKeyValid : (key: a) -> Boolean
inferenceArrowFieldKeyValid key =
  case key of
    NamedField ->
      case fieldKeyHandle key of
        Nothing -> false
        Just handle -> or (fieldIdentityIsUuid handle) (fieldIdentityIsSourceHandle handle)
    PositionalField -> fieldKeyValid key

@label "Inference arrow semantic slots error from"
@description "Inference-local arrow container validation: retain duplicate key/wire and positional ordinal laws while admitting valid repository SourceHandles before lock embedding."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceArrowSlotsErrorFrom : (slots: a) -> (ordinal: Number) -> (seenKeys: a) -> (seenWireNames: a) -> Maybe String
inferenceArrowSlotsErrorFrom slots ordinal seenKeys seenWireNames =
  case head slots of
    Nothing -> Nothing
    Just slot ->
      if not (inferenceArrowFieldKeyValid slot.key)
      then Just (concat "field semantic slot: invalid " (fieldKeyDiagnostic slot.key))
      else
        let token = fieldKeyToken slot.key
        if elem token seenKeys
        then Just (concat "field semantic slot: duplicate semantic field key " token)
        else if eq slot.wireName ""
        then Just (concat "field semantic slot: empty wire field name for " token)
        else if elem slot.wireName seenWireNames
        then Just (concat "field semantic slot: duplicate wire field name " slot.wireName)
        else
          case slot.key of
            PositionalField { index = index } ->
              if not (eq index ordinal)
              then Just (concat "field semantic slot: positional field key index " (concat (fieldNaturalDecimal index) (concat " does not match ordinal " (fieldNaturalDecimal ordinal))))
              else
                let expected = concat "_" (fieldNaturalDecimal ordinal)
                if not (eq slot.wireName expected)
                then Just (concat "field semantic slot: positional wire field name must be " expected)
                else inferenceArrowSlotsErrorFrom (tailOr slots) (add ordinal 1) (appendItem token seenKeys) (appendItem slot.wireName seenWireNames)
            NamedField -> inferenceArrowSlotsErrorFrom (tailOr slots) (add ordinal 1) (appendItem token seenKeys) (appendItem slot.wireName seenWireNames)

@label "Inference arrow semantic slots error"
@description "Validate the flattened arrow parameter container under UUID-or-SourceHandle named identity."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceArrowSlotsError : (slots: a) -> Maybe String
inferenceArrowSlotsError slots = inferenceArrowSlotsErrorFrom slots 0 [] []

@label "Inference checked arrow flatten"
@description "Flatten one arrow through the shipped law and reject any merged container that violates semantic-key, wire-name, or positional-ordinal identity; lock-less SourceHandles remain valid named identities."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceFlattenArrowChecked : (type: a) -> (path: String) -> Result a b
inferenceFlattenArrowChecked type path =
  let flattened = inferenceFlattenArrow type
  if not (eq flattened.tag "ItArrow") then Ok flattened
  else
    case inferenceArrowSlotsError flattened.params of
      Nothing -> Ok flattened
      Just message -> inferenceErr "inference.invalid-arrow-fields" (concat path "/params") message

@label "Inference unify refined types"
@description "Unify refinement bases and retain the directional inferred-to-declared subset obligation for post-solve discharge."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyRefined : (left: a) -> (right: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnifyRefined left right state path =
  case inferenceUnify left.base right.base state path of
    Err e -> Err e
    Ok next -> Ok (inferenceAppendResidual { inferred = left, declared = right, path = path } next)

@label "Inference canonical variant discriminator"
@description "The standard expanded Maybe/Result/List views are undiscriminated variants; tagged lookalikes never enter the nominal/structural bridge."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalVariantDiscriminator : (discriminator: a) -> Boolean
inferenceCanonicalVariantDiscriminator discriminator =
  case discriminator of
    Nothing -> true
    Just value -> false

@label "Inference canonical positional payload"
@description "Extract the sole p:0 payload of one canonical standard constructor case."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalPositionalPayload : (variantCase: a) -> Maybe b
inferenceCanonicalPositionalPayload variantCase =
  if not (eq (length variantCase.fields) 1) then Nothing
  else
    case inferenceFindField "p:0" variantCase.fields of
      Nothing -> Nothing
      Just field -> Just field.type

@label "Inference canonical Maybe view"
@description "Recognize only the parser-canonical undiscriminated Nothing | Just p:0 structural expansion and expose its type argument."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalMaybeView : (type: a) -> Maybe b
inferenceCanonicalMaybeView type =
  if not (eq type.tag "ItVariant") then Nothing
  else if not (eq (length type.cases) 2) then Nothing
  else if not (inferenceCanonicalVariantDiscriminator type.discriminator) then Nothing
  else
    case inferenceFindCase "Nothing" type.cases of
      Nothing -> Nothing
      Just nothingCase ->
        if not (eq (length nothingCase.fields) 0) then Nothing
        else
          case inferenceFindCase "Just" type.cases of
            Nothing -> Nothing
            Just justCase ->
              case inferenceCanonicalPositionalPayload justCase of
                Nothing -> Nothing
                Just value -> Just { name = "Maybe", args = [value] }

@label "Inference canonical Result view"
@description "Recognize only the parser-canonical undiscriminated Err p:0 | Ok p:0 structural expansion and expose both type arguments."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalResultView : (type: a) -> Maybe b
inferenceCanonicalResultView type =
  if not (eq type.tag "ItVariant") then Nothing
  else if not (eq (length type.cases) 2) then Nothing
  else if not (inferenceCanonicalVariantDiscriminator type.discriminator) then Nothing
  else
    case inferenceFindCase "Err" type.cases of
      Nothing -> Nothing
      Just errCase ->
        case inferenceCanonicalPositionalPayload errCase of
          Nothing -> Nothing
          Just errType ->
            case inferenceFindCase "Ok" type.cases of
              Nothing -> Nothing
              Just okCase ->
                case inferenceCanonicalPositionalPayload okCase of
                  Nothing -> Nothing
                  Just okType -> Just { name = "Result", args = [errType, okType] }

@label "Inference field other than token"
@description "Return the sole non-matching field after a caller has established an exact width-two canonical payload."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFieldOtherThanToken : (token: String) -> (fields: a) -> Maybe b
inferenceFieldOtherThanToken token fields =
  case head fields of
    Nothing -> Nothing
    Just field ->
      if eq field.keyToken token then inferenceFieldOtherThanToken token (tailOr fields)
      else Just field

@label "Inference canonical List tail type"
@description "Recognize the nominal recursive List tail type without consulting wire spelling or field order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalListTailType : (type: a) -> Boolean
inferenceCanonicalListTailType type =
  if not (eq type.tag "ItNamed") then false
  else if not (eq type.publicName "List") then false
  else or (eq type.name "List") (eq type.name "[\"system\",\"List\"]")

@label "Inference canonical List tail field"
@description "Find the unique semantic Cons field whose type is the recursive nominal List tail; two recursive candidates are not a canonical spine."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalListTailField : (fields: a) -> Maybe b
inferenceCanonicalListTailField fields =
  case head fields of
    Nothing -> Nothing
    Just field ->
      if inferenceCanonicalListTailType field.type then
        case inferenceCanonicalListTailField (tailOr fields) of
          Nothing -> Just field
          Just duplicate -> Nothing
      else inferenceCanonicalListTailField (tailOr fields)

@label "Inference canonical List view"
@description "Recognize the exact opaque List Nil/Cons spine, locate its unique recursive tail by type, and expose the sole other semantic field as the element argument."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalListView : (type: a) -> Maybe b
inferenceCanonicalListView type =
  if not (eq type.tag "ItOpaque") then Nothing
  else if not (eq type.identity "List") then Nothing
  else
    let pure = type.pure
    if not (eq pure.tag "ItVariant") then Nothing
    else if not (eq (length pure.cases) 2) then Nothing
    else if not (inferenceCanonicalVariantDiscriminator pure.discriminator) then Nothing
    else
      case inferenceFindCase "Nil" pure.cases of
        Nothing -> Nothing
        Just nilCase ->
          if not (eq (length nilCase.fields) 0) then Nothing
          else
            case inferenceFindCase "Cons" pure.cases of
              Nothing -> Nothing
              Just consCase ->
                if not (eq (length consCase.fields) 2) then Nothing
                else
                  case inferenceCanonicalListTailField consCase.fields of
                    Nothing -> Nothing
                    Just tailField ->
                      case inferenceFieldOtherThanToken tailField.keyToken consCase.fields of
                        Nothing -> Nothing
                        Just elementField -> Just { name = "List", args = [elementField.type] }

@label "Inference canonical application view"
@description "Expose arguments only for exact system-owned Maybe/Result/List applications. Intrinsic list literals carry that same durable List identity so public scheme round-trips preserve the bridge; public spelling alone is never authority."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalApplicationView : (type: a) -> Maybe b
inferenceCanonicalApplicationView type =
  if not (eq type.tag "ItApp") then Nothing
  else if not (eq type.head.tag "ItNamed") then Nothing
  else
    let name = type.head.name
    let publicName = type.head.publicName
    let unaryKind = KArrow { input = KType, output = KType }
    let binaryKind = KArrow { input = KType, output = unaryKind }
    if and (and (and (eq name "[\"system\",\"Maybe\"]") (eq publicName "Maybe")) (eq (length type.args) 1)) (and (inferenceKindEq type.headKind unaryKind) (inferenceKindEq type.kind KType))
    then Just { name = "Maybe", args = type.args }
    else if and (and (and (eq name "[\"system\",\"Result\"]") (eq publicName "Result")) (eq (length type.args) 2)) (and (inferenceKindEq type.headKind binaryKind) (inferenceKindEq type.kind KType))
    then Just { name = "Result", args = type.args }
    else if and (and (and (eq name "[\"system\",\"List\"]") (eq publicName "List")) (eq (length type.args) 1)) (and (inferenceKindEq type.headKind unaryKind) (inferenceKindEq type.kind KType))
    then Just { name = "List", args = type.args }
    else Nothing

@label "Inference canonical container view"
@description "Project exact standard nominal applications and their parser-canonical structural expansions to a unifier-only name/argument view."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalContainerView : (type: a) -> Maybe b
inferenceCanonicalContainerView type =
  case inferenceCanonicalApplicationView type of
    Just view -> Just view
    Nothing ->
      case inferenceCanonicalMaybeView type of
        Just view -> Just view
        Nothing ->
          case inferenceCanonicalResultView type of
            Just view -> Just view
            Nothing -> inferenceCanonicalListView type

@label "Inference canonical container pair"
@description "True only when two non-app/application-or-structural standard views name the same constructor; ordinary application pairs retain exact nominal head comparison."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalContainerPair : (left: a) -> (right: b) -> Boolean
inferenceCanonicalContainerPair left right =
  if and (eq left.tag "ItApp") (eq right.tag "ItApp") then false
  else
    case inferenceCanonicalContainerView left of
      Nothing -> false
      Just leftView ->
        case inferenceCanonicalContainerView right of
          Nothing -> false
          Just rightView -> eq leftView.name rightView.name

@label "Inference system nominal identity"
@description "Construct the stable semantic owner identity for a system-owned nominal. Scalar literal/guard synthesis uses this helper for String, Number, and Boolean instead of publishing an unowned public spelling."
@tags "engine" "internal" "signature" "inference" "nominal" "phase-2"
@category "engine-internal"
inferenceSystemNominalIdentity : (publicName: String) -> String
inferenceSystemNominalIdentity publicName = concat "[\"system\",\"" (concat publicName "\"]")

@label "Inference system ground builtin"
@description "Build an exact system-owned scalar nominal for literal and Boolean-obligation synthesis. Callers supply only String, Number, or Boolean."
@tags "engine" "internal" "signature" "inference" "nominal" "phase-2"
@category "engine-internal"
inferenceSystemGroundBuiltin : (publicName: String) -> a
inferenceSystemGroundBuiltin publicName = {
  tag = "ItNamed",
  name = inferenceSystemNominalIdentity publicName,
  publicName = publicName
}

@label "Inference admitted ground builtin identity"
@description "Admit only raw intrinsic compatibility spelling or the exact system owner for String, Number, and Boolean. The raw form exists for isolated authoring fixtures; custom owners, Int, and Bool remain distinct."
@tags "engine" "internal" "signature" "inference" "nominal" "phase-2"
@category "engine-internal"
inferenceGroundBuiltinNominalIdentity : (publicName: String) -> (identity: String) -> Boolean
inferenceGroundBuiltinNominalIdentity publicName identity =
  if or (eq publicName "String") (or (eq publicName "Number") (eq publicName "Boolean"))
  then or (eq identity publicName) (eq identity (inferenceSystemNominalIdentity publicName))
  else false

@label "Inference ground builtin nominal pair"
@description "Recognize only the intrinsic and exact-system representations of String, Number, and Boolean; public spelling alone never equates a custom nominal owner."
@tags "engine" "internal" "signature" "inference" "nominal" "phase-2"
@category "engine-internal"
inferenceGroundBuiltinNominalPair : (left: a) -> (right: b) -> Boolean
inferenceGroundBuiltinNominalPair left right =
  if not (and (eq left.tag "ItNamed") (eq right.tag "ItNamed")) then false
  else if not (eq left.publicName right.publicName) then false
  else and (inferenceGroundBuiltinNominalIdentity left.publicName left.name) (inferenceGroundBuiltinNominalIdentity right.publicName right.name)

@label "Inference unify canonical container arguments"
@description "Unify arguments extracted by an already-established exact standard container pair without changing either published representation."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyCanonicalContainerArguments : (left: a) -> (right: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnifyCanonicalContainerArguments left right state path =
  case inferenceCanonicalContainerView left of
    Nothing -> inferenceErr "inference.malformed-type" path "canonical container left view disappeared"
    Just leftView ->
      case inferenceCanonicalContainerView right of
        Nothing -> inferenceErr "inference.malformed-type" path "canonical container right view disappeared"
        Just rightView -> inferenceUnifyLists leftView.args rightView.args state (concat path "/canonical-args")

-- Types are sets (cornerstone 2). For the constructor formers below, two
-- ground types are contained in one another only when they are equal, so a
-- failed equation refutes the call. For the Boolean-lattice formers (Void,
-- union, intersection, complement) containment never reduces to syntactic
-- equality: String is in Anything (= not Void) although the two do not
-- unify, and A and B equals B and A. A failed equation at or beneath such a
-- former is therefore an abstention (an annotation fence), never a mismatch.
-- A successful equation is still sound evidence: equal sets contain each other.

@label "Inference set former"
@description "Recognize the Boolean-lattice formers and exact system universal nominal whose containment is not decided by syntactic equality."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSetFormer : (type: a) -> Boolean
inferenceSetFormer type =
  -- Keep the named type and captured owner intact. A public spelling or a
  -- private declaration called Anything does not establish this lattice fact.
  if eq type.tag "ItNamed" then eq type.name (inferenceSystemNominalIdentity "Anything")
  else or (eq type.tag "ItVoid") (or (eq type.tag "ItUnion") (or (eq type.tag "ItIntersect") (eq type.tag "ItComplement")))

@label "Inference known type tag"
@description "Recognize the inference type constructors the unifier handles; any other tag is malformed type data, never a set-former abstention."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceKnownTypeTag : (type: a) -> Boolean
inferenceKnownTypeTag type =
  std.some ["ItMeta", "ItRigid", "ItNamed", "ItUnit", "ItVoid", "ItTypeUniverse", "ItApp", "ItRecord", "ItVariant", "ItTuple", "ItMap", "ItRefined", "ItMu", "ItTagged", "ItOpaque", "ItArrow", "ItUnion", "ItIntersect", "ItComplement"] (\tag -> eq tag type.tag)

@label "Inference set-former abstention"
@description "Recognize the set-former abstention diagnostic, the only failure the unifier continues past."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSetFormerFence : (diagnostic: a) -> Boolean
inferenceSetFormerFence diagnostic = eq diagnostic.code "inference.set-former-indeterminate"

-- A set-former abstention in one component must not hide a refutation in a
-- sibling component (record fields, constructor cases, list items, arrow
-- parameters and result, call arguments): a product is refuted when any one
-- component is, whatever the walk order. After an abstention the walk goes on
-- from the state before the abstaining component, so no binding of that
-- component is used; it returns a later refutation, else the first abstention.

@label "Inference continue after a set-former abstention"
@description "Combine a component's set-former abstention with the result of the remaining components: a later refutation wins; otherwise the first abstention is kept."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAfterSetFormerFence : (fence: a) -> (rest: Result b a) -> Result b a
inferenceAfterSetFormerFence fence rest = case rest of
  Ok next -> Err fence
  Err e -> if inferenceSetFormerFence e then Err fence else Err e

@label "Inference failure beneath a set former"
@description "Keep a successful equation beneath a union, intersection or complement, and turn its failure into the set-former abstention. Malformed type data keeps its own diagnostic."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceBeneathSetFormer : (former: String) -> (result: Result a b) -> (path: String) -> Result a b
inferenceBeneathSetFormer former result path = case result of
  Ok next -> Ok next
  Err e ->
    if eq e.code "inference.malformed-type" then Err e
    else inferenceErr "inference.set-former-indeterminate" path (concat "unification does not decide containment beneath " (concat former (concat " (" (concat e.code "); a union, intersection or complement type requires an annotation here"))))

@label "Inference unify"
@description "Syntactic rank-1 unification with substitution composition, occurs check, nominal constructor congruence, ordered flattened arrows, and FieldKey-exact record/variant products."
@tags "engine" "signature" "inference" "phase-2"
inferenceUnify : (left: a) -> (right: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnify left right state path =
  let left0 = inferencePrune left state
  let right0 = inferencePrune right state
  case inferenceFlattenArrowChecked left0 path of
    Err e -> Err e
    Ok left1 ->
      case inferenceFlattenArrowChecked right0 path of
        Err e -> Err e
        Ok right1 -> inferenceUnifyNormalized left1 right1 state path

@label "Inference unify normalized"
@description "Unify two already checked arrow-normal-form roots. Recursive equations re-enter inferenceUnify and therefore repeat checked normalization at every nested arrow."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyNormalized : (left1: a) -> (right1: b) -> (state: c) -> (path: String) -> Result d e
inferenceUnifyNormalized left1 right1 state path =
  if eq left1.tag "ItMeta" then inferenceBindMeta left1 right1 state path
  else if eq right1.tag "ItMeta" then inferenceBindMeta right1 left1 state path
  else if inferenceCanonicalContainerPair left1 right1 then
    inferenceUnifyCanonicalContainerArguments left1 right1 state path
  else if not (eq left1.tag right1.tag) then
    if eq left1.tag "ItRefined" then
      case inferenceUnify left1.base right1 state path of
        Err e -> Err e
        Ok next -> Ok (inferenceAppendResidual { inferred = left1, declared = right1, path = path } next)
    else if eq right1.tag "ItRefined" then
      case inferenceUnify left1 right1.base state path of
        Err e -> Err e
        Ok next -> Ok (inferenceAppendResidual { inferred = left1, declared = right1, path = path } next)
    else if or (not (inferenceKnownTypeTag left1)) (not (inferenceKnownTypeTag right1)) then
      inferenceErr "inference.malformed-type" path "unknown inference type constructor"
    else if or (inferenceSetFormer left1) (inferenceSetFormer right1) then
      inferenceErr "inference.set-former-indeterminate" path (concat "unification does not decide containment between " (concat left1.tag (concat " and " (concat right1.tag "; a union, intersection, complement or Void type requires an annotation here"))))
    else inferenceErr "inference.constructor-mismatch" path (concat "cannot unify " (concat left1.tag (concat " with " right1.tag)))
  else if eq left1.tag "ItRigid" then
    if eq left1.id right1.id then Ok state else inferenceErr "inference.rigid-mismatch" path "distinct authored scheme variables cannot unify"
  else if eq left1.tag "ItNamed" then
    if or (eq left1.name right1.name) (inferenceGroundBuiltinNominalPair left1 right1)
    then Ok state
    else if or (inferenceSetFormer left1) (inferenceSetFormer right1) then
      inferenceErr "inference.set-former-indeterminate" path "unification does not decide containment involving the system universal type; an annotation is required here"
    else inferenceErr "inference.nominal-mismatch" path (if eq left1.publicName right1.publicName then concat "Both types are called " (concat left1.publicName ", but they do not refer to the same type declaration.") else concat left1.publicName (concat " is not " right1.publicName))
  else if eq left1.tag "ItUnit" then Ok state
  else if eq left1.tag "ItVoid" then Ok state
  else if eq left1.tag "ItTypeUniverse" then Ok state
  else if eq left1.tag "ItApp" then
    if not (inferenceKindEq left1.headKind right1.headKind) then inferenceErr "inference.kind-mismatch" path "type application heads have different kinds"
    else if not (inferenceKindEq left1.kind right1.kind) then inferenceErr "inference.kind-mismatch" path "type applications have different result kinds"
    else
      case inferenceUnify left1.head right1.head state (concat path "/head") of
        Err e ->
          if inferenceSetFormerFence e then inferenceAfterSetFormerFence e (inferenceUnifyLists left1.args right1.args state (concat path "/args"))
          else Err e
        Ok next -> inferenceUnifyLists left1.args right1.args next (concat path "/args")
  else if eq left1.tag "ItRecord" then inferenceUnifyFields left1.fields right1.fields state path
  else if eq left1.tag "ItVariant" then inferenceUnifyCases left1.cases right1.cases state path
  else if eq left1.tag "ItTuple" then inferenceUnifyLists left1.items right1.items state path
  else if eq left1.tag "ItMap" then
    case inferenceMapKeysEq left1.keys right1.keys of
      Nothing -> inferenceErr "inference.map-key-indeterminate" path "map key-domain equality is indeterminate"
      Just false -> inferenceErr "inference.map-key-mismatch" path "map key domains do not agree"
      Just true -> inferenceUnify left1.values right1.values state (concat path "/values")
  else if eq left1.tag "ItRefined" then inferenceUnifyRefined left1 right1 state path
  else if eq left1.tag "ItMu" then
    if eq left1.identity right1.identity then Ok state else inferenceErr "inference.mu-identity-mismatch" path "recursive type identities do not agree"
  else if eq left1.tag "ItTagged" then
    case inferenceUnify left1.value right1.value state (concat path "/value") of
      Err e ->
        if inferenceSetFormerFence e then inferenceAfterSetFormerFence e (inferenceUnify left1.phantom right1.phantom state (concat path "/phantom"))
        else Err e
      Ok next -> inferenceUnify left1.phantom right1.phantom next (concat path "/phantom")
  else if eq left1.tag "ItOpaque" then
    if eq left1.identity right1.identity then Ok state else inferenceErr "inference.opaque-identity-mismatch" path "opaque type identities do not agree"
  else if eq left1.tag "ItArrow" then
    if not (eq (length left1.params) (length right1.params)) then inferenceErr "inference.arity-mismatch" path "arrow arities do not agree after flattening"
    else
      case inferenceUnifyLists (map (\param -> param.type) left1.params) (map (\param -> param.type) right1.params) state (concat path "/params") of
        Err e ->
          if inferenceSetFormerFence e then inferenceAfterSetFormerFence e (inferenceUnify left1.returns right1.returns state (concat path "/returns"))
          else Err e
        Ok next -> inferenceUnify left1.returns right1.returns next (concat path "/returns")
  else if eq left1.tag "ItUnion" then inferenceBeneathSetFormer left1.tag (inferenceUnifyLists left1.branches right1.branches state path) path
  else if eq left1.tag "ItIntersect" then inferenceBeneathSetFormer left1.tag (inferenceUnifyLists left1.branches right1.branches state path) path
  else if eq left1.tag "ItComplement" then inferenceBeneathSetFormer left1.tag (inferenceUnify left1.inner right1.inner state path) path
  else inferenceErr "inference.malformed-type" path "unknown inference type constructor"


-- -------------------------------------------------------------------------
-- Instantiation and deterministic generalization
-- -------------------------------------------------------------------------

@label "Inference fresh quantified mapping"
@description "Allocate one fresh meta per quantified variable, in scheme order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFreshQuantified : (quantified: a) -> (state: b) -> c
inferenceFreshQuantified quantified state =
  case head quantified of
    Nothing -> { mapping = [], state = state }
    Just variable ->
      let fresh = inferenceFreshKind variable.kind state
      let row = { id = variable.id, sourceName = variable.sourceName, type = fresh.type }
      let rest = inferenceFreshQuantified (tailOr quantified) fresh.state
      { mapping = inferencePrependItem row rest.mapping, state = rest.state }

@label "Inference rigid replacement lookup"
@description "Find an instantiation/generalization replacement by rigid/meta id."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceReplacementLookup : (id: String) -> (mapping: a) -> Maybe a
inferenceReplacementLookup id mapping =
  case head mapping of
    Nothing -> Nothing
    Just row ->
      if eq id row.id then Just row.type
      else inferenceReplacementLookup id (tailOr mapping)

@label "Inference replace fields"
@description "Apply a rigid/meta replacement mapping through fields."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceReplaceFields : (fields: a) -> (mapping: b) -> a
inferenceReplaceFields fields mapping =
  case head fields of
    Nothing -> []
    Just field ->
      let converted = {
        key = field.key,
        keyToken = field.keyToken,
        wireName = field.wireName,
        type = inferenceReplace field.type mapping
      }
      inferencePrependItem converted (inferenceReplaceFields (tailOr fields) mapping)

@label "Inference replace cases"
@description "Apply a rigid/meta replacement mapping through variant cases."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceReplaceCases : (cases: a) -> (mapping: b) -> a
inferenceReplaceCases cases mapping =
  case head cases of
    Nothing -> []
    Just variantCase ->
      let converted = { name = variantCase.name, fields = inferenceReplaceFields variantCase.fields mapping }
      inferencePrependItem converted (inferenceReplaceCases (tailOr cases) mapping)

@label "Inference replace type list"
@description "Apply a rigid/meta replacement mapping through a type list."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceReplaceList : (types: a) -> (mapping: b) -> a
inferenceReplaceList types mapping =
  case head types of
    Nothing -> []
    Just type -> inferencePrependItem (inferenceReplace type mapping) (inferenceReplaceList (tailOr types) mapping)

@label "Inference replace variables"
@description "Replace rigid variables or metas according to an explicit mapping, recursively."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceReplace : (type: a) -> (mapping: b) -> a
inferenceReplace type mapping =
  if eq type.tag "ItRigid" then
    case inferenceReplacementLookup type.id mapping of Nothing -> type; Just replacement -> replacement
  else if eq type.tag "ItMeta" then
    case inferenceReplacementLookup type.id mapping of Nothing -> type; Just replacement -> replacement
  else if eq type.tag "ItApp" then { tag = "ItApp", head = inferenceReplace type.head mapping, args = inferenceReplaceList type.args mapping, headKind = type.headKind, kind = type.kind }
  else if eq type.tag "ItRecord" then { tag = "ItRecord", fields = inferenceReplaceFields type.fields mapping }
  else if eq type.tag "ItVariant" then { tag = "ItVariant", cases = inferenceReplaceCases type.cases mapping, discriminator = type.discriminator }
  else if eq type.tag "ItTuple" then { tag = "ItTuple", items = inferenceReplaceList type.items mapping }
  else if eq type.tag "ItMap" then { tag = "ItMap", keys = type.keys, values = inferenceReplace type.values mapping }
  else if eq type.tag "ItRefined" then { tag = "ItRefined", base = inferenceReplace type.base mapping, set = type.set }
  else if eq type.tag "ItMu" then { tag = "ItMu", identity = type.identity, body = inferenceReplace type.body mapping }
  else if eq type.tag "ItTagged" then { tag = "ItTagged", value = inferenceReplace type.value mapping, phantom = inferenceReplace type.phantom mapping }
  else if eq type.tag "ItOpaque" then { tag = "ItOpaque", identity = type.identity, pure = inferenceReplace type.pure mapping }
  else if eq type.tag "ItArrow" then { tag = "ItArrow", params = inferenceReplaceFields type.params mapping, returns = inferenceReplace type.returns mapping }
  else if eq type.tag "ItUnion" then { tag = "ItUnion", branches = inferenceReplaceList type.branches mapping }
  else if eq type.tag "ItIntersect" then { tag = "ItIntersect", branches = inferenceReplaceList type.branches mapping }
  else if eq type.tag "ItComplement" then { tag = "ItComplement", inner = inferenceReplace type.inner mapping }
  else type

@label "Inference instantiate scheme"
@description "Instantiate every quantified rigid at a use site with independent fresh metas."
@tags "engine" "signature" "inference" "phase-2"
inferenceInstantiate : (scheme: a) -> (state: b) -> c
inferenceInstantiate scheme state =
  let fresh = inferenceFreshQuantified scheme.quantified state
  { type = inferenceReplace scheme.body fresh.mapping, state = fresh.state }

@label "Inference instantiate lexical binding"
@description "Instantiate a lexical binding's scheme (inferenceInstantiate) and re-record, at this use's fresh metas, every opaque read its generalization carried (inferenceGeneralizedOpaqueReads): a use of a let-generalized value whose type came from a field read through an opaque type's pure view is that read again, so the nominal owners its instance reaches are never unfolded (modules-as-values Phase 5a, re-review 2026-10-02)."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceInstantiateBinding : (binding: a) -> (state: b) -> c
inferenceInstantiateBinding binding state =
  let fresh = inferenceFreshQuantified binding.scheme.quantified state
  let reads = map (\read -> inferenceReplace read fresh.mapping) binding.opaqueReads
  { type = inferenceReplace binding.scheme.body fresh.mapping, state = inferenceRecordOpaqueReads reads fresh.state }

@label "Inference add free meta"
@description "Append a meta descriptor once, retaining first structural occurrence."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAddMeta : (meta: a) -> (acc: b) -> b
inferenceAddMeta meta acc =
  if elem meta.id (map (\m -> m.id) acc) then acc else appendItem meta acc

@label "Inference collect metas from list"
@description "Collect free metas from a list in structural order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCollectMetasList : (types: a) -> (acc: b) -> b
inferenceCollectMetasList types acc =
  case head types of
    Nothing -> acc
    Just type -> inferenceCollectMetasList (tailOr types) (inferenceCollectMetas type acc)

@label "Inference collect metas from fields"
@description "Collect free metas from semantic fields in their canonical order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCollectMetasFields : (fields: a) -> (acc: b) -> b
inferenceCollectMetasFields fields acc =
  case head fields of
    Nothing -> acc
    Just field -> inferenceCollectMetasFields (tailOr fields) (inferenceCollectMetas field.type acc)

@label "Inference collect metas from cases"
@description "Collect free metas from variant cases in canonical order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCollectMetasCases : (cases: a) -> (acc: b) -> b
inferenceCollectMetasCases cases acc =
  case head cases of
    Nothing -> acc
    Just variantCase -> inferenceCollectMetasCases (tailOr cases) (inferenceCollectMetasFields variantCase.fields acc)

@label "Inference collect free metas"
@description "Collect free metas by first structural occurrence."
@tags "engine" "signature" "inference" "phase-2"
inferenceCollectMetas : (type: a) -> (acc: b) -> b
inferenceCollectMetas type acc =
  if eq type.tag "ItMeta" then inferenceAddMeta type acc
  else if eq type.tag "ItApp" then inferenceCollectMetasList type.args (inferenceCollectMetas type.head acc)
  else if eq type.tag "ItRecord" then inferenceCollectMetasFields type.fields acc
  else if eq type.tag "ItVariant" then inferenceCollectMetasCases type.cases acc
  else if eq type.tag "ItTuple" then inferenceCollectMetasList type.items acc
  else if eq type.tag "ItMap" then inferenceCollectMetas type.values acc
  else if eq type.tag "ItRefined" then inferenceCollectMetas type.base acc
  else if eq type.tag "ItMu" then inferenceCollectMetas type.body acc
  else if eq type.tag "ItTagged" then inferenceCollectMetas type.phantom (inferenceCollectMetas type.value acc)
  else if eq type.tag "ItOpaque" then inferenceCollectMetas type.pure acc
  else if eq type.tag "ItArrow" then inferenceCollectMetas type.returns (inferenceCollectMetasFields type.params acc)
  else if eq type.tag "ItUnion" then inferenceCollectMetasList type.branches acc
  else if eq type.tag "ItIntersect" then inferenceCollectMetasList type.branches acc
  else if eq type.tag "ItComplement" then inferenceCollectMetas type.inner acc
  else acc

@label "Inference collect environment metas"
@description "Collect metas reachable from monomorphic environment schemes under the current substitution (a parameter meta solved to {a: t} blocks t too); generalized rigids do not contribute."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceEnvironmentMetas : (environment: a) -> (state: b) -> (acc: c) -> c
inferenceEnvironmentMetas environment state acc =
  case head environment of
    Nothing -> acc
    Just binding -> inferenceEnvironmentMetas (tailOr environment) state (inferenceCollectMetas (inferenceApply binding.scheme.body state) acc)

@label "Inference collect residual metas"
@description "Collect metas reachable from undischarged refinement residuals; these are never generalized."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceResidualMetas : (residuals: a) -> (state: b) -> (acc: c) -> c
inferenceResidualMetas residuals state acc =
  case head residuals of
    Nothing -> acc
    Just residual ->
      let left = inferenceApply residual.inferred state
      let right = inferenceApply residual.declared state
      let next = inferenceCollectMetas right (inferenceCollectMetas left acc)
      inferenceResidualMetas (tailOr residuals) state next

@label "Inference discharge one refinement residual"
@description "After substitution is ground, prove the directional inferred-set subset of the declared refinement. Plain declared bases accept a more precise inferred refinement; a plain inferred base denotes SeAll."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceDischargeResidual : (residual: a) -> (state: b) -> Result c d
inferenceDischargeResidual residual state =
  let inferred = inferenceApply residual.inferred state
  let declared = inferenceApply residual.declared state
  let metas = inferenceCollectMetas declared (inferenceCollectMetas inferred [])
  if gt (length metas) 0 then
    inferenceErr "inference.refinement-indeterminate" residual.path "refinement containment still depends on an unsolved metavariable"
  else if not (eq declared.tag "ItRefined") then Ok state
  else
    let inferredSet = if eq inferred.tag "ItRefined" then inferred.set else SeAll
    case decideSubset inferredSet declared.set of
      Nothing -> inferenceErr "inference.refinement-indeterminate" residual.path "ground refinement containment is outside the shipped decision procedure"
      Just false -> inferenceErr "inference.refinement-refuted" residual.path "inferred refinement is not contained by the declared refinement"
      Just true -> Ok state

@label "Inference discharge refinement residuals"
@description "Discharge every post-solve refinement obligation with decideSubset; no residual may be generalized or silently retained."
@tags "engine" "signature" "inference" "phase-2"
inferenceDischargeResiduals : (residuals: a) -> (state: b) -> Result c d
inferenceDischargeResiduals residuals state =
  case head residuals of
    Nothing -> Ok state
    Just residual ->
      case inferenceDischargeResidual residual state of
        Err e -> Err e
        Ok next -> inferenceDischargeResiduals (tailOr residuals) next

@label "Inference filter generalizable metas"
@description "Remove environment- and residual-reachable metas before quantification."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceGeneralizableMetas : (metas: a) -> (blocked: b) -> a
inferenceGeneralizableMetas metas blocked =
  case head metas of
    Nothing -> []
    Just meta ->
      let rest = inferenceGeneralizableMetas (tailOr metas) blocked
      if elem meta.id (map (\m -> m.id) blocked) then rest else inferencePrependItem meta rest

@label "Inference alpha mapping"
@description "Alpha-normalize generalized metas to the first collision-free a0,a1,… names in structural order, reserving authored ids and source spellings."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAlphaMapping : (metas: a) -> (index: Number) -> (reserved: b) -> c
inferenceAlphaMapping metas index reserved =
  case head metas of
    Nothing -> []
    Just meta ->
      let name = concat "a" (toString index)
      if elem name reserved then inferenceAlphaMapping metas (add index 1) reserved
      else
        let rigid = { tag = "ItRigid", id = name, sourceName = name, kind = meta.kind }
        inferencePrependItem { id = meta.id, type = rigid } (inferenceAlphaMapping (tailOr metas) (add index 1) (appendItem name reserved))

@label "Inference quantified rows"
@description "Build SchemeVar values corresponding to an alpha mapping."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceQuantifiedRows : (mapping: a) -> b
inferenceQuantifiedRows mapping =
  case head mapping of
    Nothing -> []
    Just row ->
      inferencePrependItem (SchemeVar { id = row.type.id, sourceName = row.type.sourceName, kind = row.type.kind }) (inferenceQuantifiedRows (tailOr mapping))

@label "Inference generalize"
@description "Apply substitution and the shipped FieldKey-normalized arrow flattening law, then deterministically quantify free metas not free in the environment or an undischarged residual."
@tags "engine" "signature" "inference" "phase-2"
inferenceGeneralize : (type: a) -> (environment: b) -> (state: c) -> d
inferenceGeneralize type environment state =
  let solved = inferenceFlattenArrow (inferenceApply type state)
  let mapping = inferenceGeneralizationMapping solved environment state
  TypeScheme { quantified = inferenceQuantifiedRows mapping, body = inferenceReplace solved mapping }

@label "Inference generalization mapping"
@description "The deterministic meta-to-rigid mapping inferenceGeneralize quantifies a solved, flattened type with: its free metas not free in the environment or an undischarged residual, alpha-normalized to a0, a1, … in structural order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceGeneralizationMapping : (solved: a) -> (environment: b) -> (state: c) -> d
inferenceGeneralizationMapping solved environment state =
  let all = inferenceCollectMetas solved []
  let envMetas = inferenceEnvironmentMetas environment state []
  let residualMetas = inferenceResidualMetas state.residuals state []
  let blocked = concat envMetas residualMetas
  let metas = inferenceGeneralizableMetas all blocked
  inferenceAlphaMapping metas 0 []

@label "Inference generalized opaque reads"
@description "modules-as-values Phase 5a (re-review 2026-10-02): the opaque reads a let generalization must carry. A remembered field read through an opaque type's pure view (inferenceRecordOpaqueRead) that mentions a metavariable inferenceGeneralize quantifies would otherwise lose its provenance: each use instantiates that variable afresh, and the original stays unsolved. Every such read is returned over the scheme's own rigids (the same mapping, inferenceGeneralizationMapping), for inferenceInstantiateBinding to re-record at each use. Reads that mention no generalized variable stay in the state as they are; the generalization itself is unchanged."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceGeneralizedOpaqueReads : (type: a) -> (environment: b) -> (state: c) -> d
inferenceGeneralizedOpaqueReads type environment state =
  if eq (length state.opaqueProvenance.reads) 0 then []
  else
    let mapping = inferenceGeneralizationMapping (inferenceFlattenArrow (inferenceApply type state)) environment state
    let generalized = map (\row -> row.id) mapping
    let reads = map (\read -> inferenceApply read state) state.opaqueProvenance.reads
    let carried = filter (\read -> gt (length (filter (\meta -> elem meta.id generalized) (inferenceCollectMetas read []))) 0) reads
    map (\read -> inferenceReplace read mapping) carried

@label "Inference generalize with authored variables"
@description "Generalize a top-level assumption at its own parameter width while retaining the declaration-scoped authored rigid prefix in its original order. The source parameters stay the top-level arrow (positional ones re-derived at their ordinals, as the flattening law does); a returned function (a solved return arrow) is flattened and re-keyed positionally (_0, _1, …) as a nested arrow, the shape the loader gives an authored a -> (b -> b). Flattening it into the source parameters would change the published width and merge two parameter containers."
@tags "engine" "signature" "inference" "phase-2"
inferenceGeneralizeWith : (authored: a) -> (type: b) -> (environment: c) -> (state: d) -> e
inferenceGeneralizeWith authored type environment state =
  let applied = inferenceApply type state
  let remainder = if eq applied.tag "ItArrow" then inferenceFlattenArrow applied.returns else applied
  let positional = if eq remainder.tag "ItArrow" then map (\param -> { key = PositionalField { index = 0 }, keyToken = "", wireName = "", type = param.type }) remainder.params else []
  let nested = if eq remainder.tag "ItArrow" then { tag = "ItArrow", params = inferenceReindexArrowParams positional 0, returns = remainder.returns } else remainder
  let solved = if eq applied.tag "ItArrow" then { tag = "ItArrow", params = inferenceReindexArrowParams applied.params 0, returns = nested } else inferenceFlattenArrow applied
  let all = inferenceCollectMetas solved []
  let envMetas = inferenceEnvironmentMetas environment state []
  let residualMetas = inferenceResidualMetas state.residuals state []
  let blocked = concat envMetas residualMetas
  let metas = inferenceGeneralizableMetas all blocked
  let authoredIds = map (\variable -> if isNull variable.sourceId then variable.id else variable.sourceId) authored
  let authoredNames = map (\variable -> variable.sourceName) authored
  let mapping = inferenceAlphaMapping metas 0 (concat authoredIds authoredNames)
  let inferred = TypeScheme { quantified = inferenceQuantifiedRows mapping, body = inferenceReplace solved mapping }
  let publicMapping = map (\variable ->
    { id = variable.id, type = { tag = "ItRigid", id = if isNull variable.sourceId then variable.id else variable.sourceId, sourceName = variable.sourceName, kind = variable.kind } }
  ) authored
  let publicAuthored = map (\variable ->
    SchemeVar { id = if isNull variable.sourceId then variable.id else variable.sourceId, sourceName = variable.sourceName, kind = variable.kind }
  ) authored
  TypeScheme { quantified = concat publicAuthored inferred.quantified, body = inferenceReplace inferred.body publicMapping }

@label "Inference validate arrow list"
@description "Reject an invalid flattened arrow container anywhere in an ordered child-type list."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceValidateArrowList : (types: a) -> (path: String) -> Result Boolean b
inferenceValidateArrowList types path =
  case head types of
    Nothing -> Ok true
    Just type ->
      case inferenceValidateTypeArrows type path of
        Err e -> Err e
        Ok valid -> inferenceValidateArrowList (tailOr types) path

@label "Inference validate arrow fields"
@description "Reject an invalid flattened arrow container in any semantic field type."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceValidateArrowFields : (fields: a) -> (path: String) -> Result Boolean b
inferenceValidateArrowFields fields path =
  case head fields of
    Nothing -> Ok true
    Just field ->
      case inferenceValidateTypeArrows field.type (concat path (concat "/" field.keyToken)) of
        Err e -> Err e
        Ok valid -> inferenceValidateArrowFields (tailOr fields) path

@label "Inference validate arrow cases"
@description "Reject an invalid flattened arrow container in any variant payload type."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceValidateArrowCases : (cases: a) -> (path: String) -> Result Boolean b
inferenceValidateArrowCases cases path =
  case head cases of
    Nothing -> Ok true
    Just variantCase ->
      case inferenceValidateArrowFields variantCase.fields (concat path (concat "/" variantCase.name)) of
        Err e -> Err e
        Ok valid -> inferenceValidateArrowCases (tailOr cases) path

@label "Inference validate type arrows"
@description "Walk a complete inference type and apply checked flattening to every arrow occurrence before a scheme may enter an environment or cross a publication boundary."
@tags "engine" "signature" "inference" "field-identity" "phase-2"
inferenceValidateTypeArrows : (type: a) -> (path: String) -> Result Boolean b
inferenceValidateTypeArrows type path =
  if eq type.tag "ItNamed" then Ok true
  else if eq type.tag "ItRigid" then Ok true
  else if eq type.tag "ItApp" then
    case inferenceValidateTypeArrows type.head (concat path "/head") of
      Err e -> Err e
      Ok valid -> inferenceValidateArrowList type.args (concat path "/args")
  else if eq type.tag "ItRecord" then inferenceValidateArrowFields type.fields path
  else if eq type.tag "ItVariant" then inferenceValidateArrowCases type.cases path
  else if eq type.tag "ItTuple" then inferenceValidateArrowList type.items path
  else if eq type.tag "ItMap" then inferenceValidateTypeArrows type.values (concat path "/values")
  else if eq type.tag "ItRefined" then inferenceValidateTypeArrows type.base (concat path "/base")
  else if eq type.tag "ItMu" then inferenceValidateTypeArrows type.body (concat path "/body")
  else if eq type.tag "ItTagged" then
    case inferenceValidateTypeArrows type.value (concat path "/value") of
      Err e -> Err e
      Ok valid -> inferenceValidateTypeArrows type.phantom (concat path "/phantom")
  else if eq type.tag "ItOpaque" then inferenceValidateTypeArrows type.pure (concat path "/pure")
  else if eq type.tag "ItArrow" then
    case inferenceFlattenArrowChecked type path of
      Err e -> Err e
      Ok flattened ->
        case inferenceValidateArrowFields flattened.params (concat path "/params") of
          Err e -> Err e
          Ok valid -> inferenceValidateTypeArrows flattened.returns (concat path "/returns")
  else if eq type.tag "ItUnion" then inferenceValidateArrowList type.branches path
  else if eq type.tag "ItIntersect" then inferenceValidateArrowList type.branches path
  else if eq type.tag "ItComplement" then inferenceValidateTypeArrows type.inner (concat path "/inner")
  else Ok true

@label "Inference validate scheme arrows"
@description "Return a scheme only when every arrow occurrence has an identity-total flattened parameter container."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceValidateSchemeArrows : (scheme: a) -> (path: String) -> Result a b
inferenceValidateSchemeArrows scheme path =
  case inferenceValidateTypeArrows scheme.body path of
    Err e -> Err e
    Ok valid -> Ok scheme

@label "Inference checked generalization"
@description "Generalize only after every deferred record projection is solved, and refuse an invalid post-flatten arrow container."
@tags "engine" "internal" "signature" "inference" "projection" "field-identity" "phase-2"
@category "engine-internal"
inferenceGeneralizeChecked : (type: a) -> (environment: b) -> (state: c) -> (path: String) -> Result d e
inferenceGeneralizeChecked type environment state path =
  case inferenceEnsureProjectionsDischarged state path of
    Err e -> Err e
    Ok clear -> inferenceValidateSchemeArrows (inferenceGeneralize type environment state) path

@label "Inference checked generalization with authored variables"
@description "Retain authored variables only after every deferred record projection is solved, and refuse invalid post-flatten arrow publication."
@tags "engine" "internal" "signature" "inference" "projection" "field-identity" "phase-2"
@category "engine-internal"
inferenceGeneralizeWithChecked : (authored: a) -> (type: b) -> (environment: c) -> (state: d) -> (path: String) -> Result e f
inferenceGeneralizeWithChecked authored type environment state path =
  case inferenceEnsureProjectionsDischarged state path of
    Err e -> Err e
    Ok clear -> inferenceValidateSchemeArrows (inferenceGeneralizeWith authored type environment state) path


-- -------------------------------------------------------------------------
-- Environments, literals, and callable application
-- -------------------------------------------------------------------------

@label "Inference prepare scheme"
@description "Convert a boundary scheme carrying bodyTraversal into the internal TypeScheme representation."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePrepareScheme : (scheme: a) -> Result b c
inferencePrepareScheme scheme =
  case inferenceFromTraversal scheme.bodyTraversal scheme.quantified of
    Err e -> Err e
    Ok body -> inferenceValidateSchemeArrows (TypeScheme { quantified = scheme.quantified, body = body }) "type"

@label "Inference prepare environment"
@description "Convert boundary environment rows `{name,scheme:{quantified,bodyTraversal}}` to internal schemes."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePrepareEnvironment : (rows: a) -> Result b c
inferencePrepareEnvironment rows =
  fold
    (\prepared row ->
      case prepared of
        Err e -> Err e
        Ok acc ->
          case inferencePrepareScheme row.scheme of
            Err e -> Err e
            Ok scheme -> Ok (appendItem { name = row.name, scheme = scheme, dynamicOpaque = true, opaqueReads = [] } acc))
    (Ok [])
    rows

@label "Inference prepare callables"
@description "Convert exact-resolution callable rows to internal schemes, retaining status/target/trust facts. A modules-as-values Phase 5a member value row whose declared type does not prepare becomes a terminal fenced row for its own spelling (inferenceUnpreparedMemberRow) instead of failing the batch."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePrepareCallables : (rows: a) -> Result b c
inferencePrepareCallables rows =
  fold
    (\prepared row ->
      case prepared of
        Err e -> Err e
        Ok acc ->
          if not (eq row.status "resolved") then Ok (appendItem row acc)
          else
            case inferencePrepareScheme row.scheme of
              Err e ->
                if startsWith row.name "$member:" then Ok (appendItem (inferenceUnpreparedMemberRow row e) acc)
                else Err e
              Ok scheme -> Ok (appendItem (inferencePreparedCallableRow row scheme) acc))
    (Ok [])
    rows

@label "Inference unprepared member row"
@description "modules-as-values Phase 5a — a member's declared type that rank-1 inference cannot represent (e.g. `Monoid List`: Fenel keys instances on a bare constructor at a Type-kinded binder, so the argument's kind differs from the binder's) says nothing about the expression mentioning it. The member fences (`inference.host-scheme-sidecar`), only where it is read, with the preparation diagnostic quoted; it never becomes a definite Invalid and never fails the other rows."
@tags "engine" "internal" "signature" "inference" "modules-as-values"
@category "engine-internal"
inferenceUnpreparedMemberRow : (row: a) -> (diagnostic: b) -> c
inferenceUnpreparedMemberRow row diagnostic =
  let memberName = slice row.name 8 (length row.name)
  let message = concat "the declared type of " (concat memberName (concat " is outside rank-1 inference (" (concat diagnostic.code (concat ": " (concat diagnostic.message ")")))))
  { name = row.name, targetId = row.targetId, status = "fenced", verdict = "AnnotationRequired", diagnostics = [inferenceDiagnostic "inference.host-scheme-sidecar" diagnostic.path message] }

@label "Inference prepared callable row"
@description "The prepared form of one resolved row. A modules-as-values Phase 5a member value row (`$member:bundle.member`) also keeps the field names its frozen value carries (`valueFields`) and, among them, those whose value is not closed data (`openFields`: unevaluated loader source or a reference, a host fact)."
@tags "engine" "internal" "signature" "inference" "modules-as-values"
@category "engine-internal"
inferencePreparedCallableRow : (row: a) -> (scheme: b) -> c
inferencePreparedCallableRow row scheme =
  if startsWith row.name "$member:"
  then { name = row.name, targetId = row.targetId, status = row.status, scheme = scheme, trust = row.trust, valueFields = row.valueFields, openFields = row.openFields }
  else { name = row.name, targetId = row.targetId, status = row.status, scheme = scheme, trust = row.trust, projectedValue = row.projectedValue }

@label "Inference fenced row key"
@description "Build an injective sortable key from the exact source spelling and canonical target identity."
@tags "engine" "internal" "signature" "inference" "fence" "phase-2"
@category "engine-internal"
inferenceFencedRowKey : (row: a) -> String
inferenceFencedRowKey row =
  concat (toString (length row.name)) (concat ":" (concat row.name row.targetId))

@label "Inference fenced row keys"
@description "Collect each exact fenced (source spelling, target identity) pair once before deterministic verdict joining."
@tags "engine" "internal" "signature" "inference" "fence" "phase-2"
@category "engine-internal"
inferenceFencedRowKeys : (rows: a) -> (keys: b) -> b
inferenceFencedRowKeys rows keys =
  case head rows of
    Nothing -> keys
    Just row ->
      let rest = tailOr rows
      if not (eq row.status "fenced") then inferenceFencedRowKeys rest keys
      else
        let key = inferenceFencedRowKey row
        if elem key keys then inferenceFencedRowKeys rest keys
        else inferenceFencedRowKeys rest (appendItem key keys)

@label "Inference fenced row lookup"
@description "Lookup one exact fenced row by its already-canonical source spelling."
@tags "engine" "internal" "signature" "inference" "fence" "phase-2"
@category "engine-internal"
inferenceFencedRowLookup : (key: String) -> (rows: a) -> Maybe a
inferenceFencedRowLookup key rows =
  case head rows of
    Nothing -> Nothing
    Just row ->
      if and (eq row.status "fenced") (eq (inferenceFencedRowKey row) key) then Just row
      else inferenceFencedRowLookup key (tailOr rows)

@label "Inference fenced diagnostics"
@description "Concatenate exact carried diagnostics in lexical target order without rewriting them."
@tags "engine" "internal" "signature" "inference" "fence" "phase-2"
@category "engine-internal"
inferenceFencedDiagnostics : (keys: a) -> (rows: b) -> c
inferenceFencedDiagnostics keys rows =
  case head keys of
    Nothing -> []
    Just key ->
      let rest = inferenceFencedDiagnostics (tailOr keys) rows
      case inferenceFencedRowLookup key rows of
        Nothing -> rest
        Just row -> concat row.diagnostics rest

@label "Inference fenced rows contain invalid"
@description "Compute the fence verdict join: Invalid dominates AnnotationRequired."
@tags "engine" "internal" "signature" "inference" "fence" "phase-2"
@category "engine-internal"
inferenceFencedRowsContainInvalid : (keys: a) -> (rows: b) -> Boolean
inferenceFencedRowsContainInvalid keys rows =
  case head keys of
    Nothing -> false
    Just key ->
      case inferenceFencedRowLookup key rows of
        Just row ->
          if eq row.verdict "Invalid" then true
          else inferenceFencedRowsContainInvalid (tailOr keys) rows
        Nothing -> inferenceFencedRowsContainInvalid (tailOr keys) rows

@label "Inference fenced rows outcome"
@description "Join every relevant exact callable fence in Fenel, independent of host resolver iteration order."
@tags "engine" "signature" "inference" "fence" "phase-2"
inferenceFencedRowsOutcome : (rows: a) -> Maybe InferenceOutcome
inferenceFencedRowsOutcome rows =
  let keys = sortLex (inferenceFencedRowKeys rows [])
  case head keys of
    Nothing -> Nothing
    Just key ->
      let diagnostics = inferenceFencedDiagnostics keys rows
      if inferenceFencedRowsContainInvalid keys rows
      then Just (Invalid { diagnostics = diagnostics })
      else Just (AnnotationRequired { diagnostics = diagnostics })

@label "Inference top-level exact rows"
@description "Flatten candidate-local exact routing projections for one atomic fence join."
@tags "engine" "internal" "signature" "inference" "fence" "phase-2"
@category "engine-internal"
inferenceTopLevelExactRows : (candidates: a) -> (fallback: b) -> c
inferenceTopLevelExactRows candidates fallback =
  case head candidates of
    Nothing -> []
    Just candidate ->
      let exact = if isNull candidate.resolutions then fallback else candidate.resolutions
      concat exact (inferenceTopLevelExactRows (tailOr candidates) fallback)

@label "Inference constructor result arguments"
@description "Project an entity's declaration-scoped binders to rigid result arguments in source order."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceConstructorResultArguments : (quantified: a) -> b
inferenceConstructorResultArguments quantified =
  map (\variable -> { tag = "ItRigid", id = variable.id, sourceName = variable.sourceName, kind = variable.kind }) quantified

@label "Inference constructor head kind"
@description "Derive the authoritative nominal constructor kind from the registered entity's declaration-scoped binders."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceConstructorHeadKind : (quantified: a) -> Kind
inferenceConstructorHeadKind quantified =
  case head quantified of
    Nothing -> KType
    Just variable -> KArrow { input = variable.kind, output = inferenceConstructorHeadKind (tailOr quantified) }

@label "Inference constructor result"
@description "Build the nominal result of a data constructor; parameterized owners retain an explicit kinded scheme application."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceConstructorResult : (ownerIdentity: String) -> (ownerName: String) -> (quantified: a) -> b
inferenceConstructorResult ownerIdentity ownerName quantified =
  let args = inferenceConstructorResultArguments quantified
  case head args of
    Nothing -> { tag = "ItNamed", name = ownerIdentity, publicName = ownerName }
    Just first -> { tag = "ItApp", head = { tag = "ItNamed", name = ownerIdentity, publicName = ownerName }, args = args, headKind = inferenceConstructorHeadKind quantified, kind = KType }

@label "Inference constructor scheme body"
@description "Every constructor is callable from SConstruct; nullary constructors therefore have an exact zero-parameter arrow into their nominal owner."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceConstructorSchemeBody : (fields: a) -> (returns: b) -> c
inferenceConstructorSchemeBody fields returns =
  { tag = "ItArrow", params = fields, returns = returns }

@label "Inference constructor callable"
@description "Convert one TraversalType constructor payload to a trusted, total polymorphic callable scheme."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceConstructorCallable : (entity: a) -> (ctorName: String) -> (fields: b) -> Result c d
inferenceConstructorCallable entity ctorName fields =
  case inferenceFieldsFromTraversal fields entity.quantified of
    Err e -> Err e
    Ok params ->
      let targetId = concat entity.targetPrefix ctorName
      let result = inferenceConstructorResult entity.ownerIdentity entity.ownerName entity.quantified
      let scheme = TypeScheme { quantified = entity.quantified, body = inferenceConstructorSchemeBody params result }
      Ok { name = targetId, targetId = targetId, status = "resolved", scheme = scheme, trust = "TrustedPrimitive" }

@label "Inference source diagnostic applies to constructor"
@description "Conservatively associate a source-scheme diagnostic with one constructor index. Exact constructors/<index> paths affect only that constructor; malformed or owner-wide paths affect every selected constructor."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceSourceDiagnosticAppliesToConstructor : (diagnostic: a) -> (index: Int) -> Boolean
inferenceSourceDiagnosticAppliesToConstructor diagnostic index =
  case head diagnostic.path of
    Nothing -> true
    Just root ->
      if not (eq root "constructors") then true
      else
        case head (tailOr diagnostic.path) of
          Nothing -> true
          Just sourceIndex -> eq sourceIndex (toString index)

@label "Inference constructor has source diagnostics"
@description "Report whether any declaration-binding diagnostic applies to the selected constructor index."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceConstructorHasSourceDiagnostics : (diagnostics: a) -> (index: Int) -> Boolean
inferenceConstructorHasSourceDiagnostics diagnostics index =
  case head diagnostics of
    Nothing -> false
    Just diagnostic ->
      if inferenceSourceDiagnosticAppliesToConstructor diagnostic index then true
      else inferenceConstructorHasSourceDiagnostics (tailOr diagnostics) index

@label "Inference variant constructor callables"
@description "Build trusted callable schemes only for exact registry-selected cases of one registered variant entity."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceVariantConstructorCallables : (entity: a) -> (cases: b) -> (selected: c) -> (index: Int) -> Result d e
inferenceVariantConstructorCallables entity cases selected index =
  case head cases of
    Nothing -> Ok []
    Just variantCase ->
      if not (elem variantCase.name selected) then
        inferenceVariantConstructorCallables entity (tailOr cases) selected (add index 1)
      else if inferenceConstructorHasSourceDiagnostics entity.diagnostics index then
        inferenceErr "inference.source-scheme" entity.ownerName (concat "constructor " (concat variantCase.name (concat " of " (concat entity.ownerName " has unresolved source binding diagnostics"))))
      else
        case inferenceConstructorCallable entity variantCase.name variantCase.fields of
          Err e -> Err e
          Ok callable ->
            case inferenceVariantConstructorCallables entity (tailOr cases) selected (add index 1) of
              Err e -> Err e
              Ok rest -> Ok (inferencePrependItem callable rest)

@label "Inference entity constructor callables"
@description "Peel declaration wrappers and derive the value-level constructor surface from a registered entity TraversalType."
@tags "engine" "internal" "signature" "inference" "constructor" "phase-2"
@category "engine-internal"
inferenceEntityConstructorCallables : (entity: a) -> (type: b) -> Result c d
inferenceEntityConstructorCallables entity type =
  case type of
    TtVariant { cases = cases } -> inferenceVariantConstructorCallables entity cases entity.selectedConstructors 0
    TtRecord { fields = fields } ->
      if not (elem entity.ownerName entity.selectedConstructors) then Ok []
      else if inferenceConstructorHasSourceDiagnostics entity.diagnostics 0 then
        inferenceErr "inference.source-scheme" entity.ownerName (concat "constructor " (concat entity.ownerName " has unresolved source binding diagnostics"))
      else
        case inferenceConstructorCallable entity entity.ownerName fields of
          Err e -> Err e
          Ok callable -> Ok [callable]
    TtOpaque { pure = pure } -> inferenceEntityConstructorCallables entity pure
    TtMu { body = body } -> inferenceEntityConstructorCallables entity body
    other -> Ok []

@label "Inference registered constructor callables"
@description "Derive constructor schemes for registry entity rows entirely in Fenel; the host supplies only audited type traversal, binders, owner, and stable target prefix."
@tags "engine" "signature" "inference" "constructor" "phase-2"
inferenceRegisteredConstructorCallables : (entities: a) -> Result b c
inferenceRegisteredConstructorCallables entities =
  fold
    (\prepared entity ->
      case prepared of
        Err e -> Err e
        Ok acc ->
          case head entity.unresolvedNominalNames of
            Just nominal ->
              inferenceErr
                "inference.constructor-nominal-provenance"
                entity.ownerName
                (concat "constructor scheme has no defining source provenance for nominal reference " nominal)
            Nothing ->
              case inferenceEntityConstructorCallables entity entity.typeTraversal of
                Err e -> Err e
                Ok current -> Ok (concat acc current))
    (Ok [])
    entities


-- -------------------------------------------------------------------------
-- Dispatch-interface method schemes
-- -------------------------------------------------------------------------

@label "Inference capability method callable"
@description "Project one source record field into an exact callable scheme. Curried arrows flatten through the shipped law; a scalar field is a nullary method, never a host-synthesized arrow."
@tags "engine" "internal" "signature" "inference" "dispatch" "phase-2"
@category "engine-internal"
inferenceCapabilityMethodCallable : (entity: a) -> (field: b) -> Result c d
inferenceCapabilityMethodCallable entity field =
  case inferenceFromTraversal field.type entity.quantified of
    Err e -> Err e
    Ok sourceType ->
      let flattened = inferenceFlattenArrow sourceType
      let body = if eq flattened.tag "ItArrow" then flattened else { tag = "ItArrow", params = [], returns = flattened }
      let scheme = TypeScheme { quantified = entity.quantified, body = body }
      case inferenceValidateSchemeArrows scheme (concat entity.ownerName (concat "." field.wireName)) of
        Err e -> Err e
        Ok valid ->
          let targetId = concat entity.ownerName (concat "." field.wireName)
          Ok {
            name = targetId,
            targetId = targetId,
            ownerName = entity.ownerName,
            methodName = field.wireName,
            status = "resolved",
            scheme = valid,
            trust = Advisory { evidence = {
              authority = "RegisteredDispatchInterfaceContract",
              reason = "registered dispatch-interface contracts are not SC-sig certificates"
            } }
          }

@label "Inference capability method fields"
@description "Derive only the exact method names selected from one registered dispatch-interface record. Source binding diagnostics fence the record instead of licensing a partial host reconstruction."
@tags "engine" "internal" "signature" "inference" "dispatch" "phase-2"
@category "engine-internal"
inferenceCapabilityMethodFields : (entity: a) -> (fields: b) -> Result c d
inferenceCapabilityMethodFields entity fields =
  case head fields of
    Nothing -> Ok []
    Just field ->
      if not (elem field.wireName entity.selectedMethods) then
        inferenceCapabilityMethodFields entity (tailOr fields)
      else if gt (length entity.diagnostics) 0 then
        inferenceErr "inference.source-scheme" entity.ownerName (concat "capability method " (concat field.wireName (concat " of " (concat entity.ownerName " has unresolved source binding diagnostics"))))
      else
        case inferenceCapabilityMethodCallable entity field of
          Err e -> Err e
          Ok callable ->
            case inferenceCapabilityMethodFields entity (tailOr fields) of
              Err e -> Err e
              Ok rest -> Ok (inferencePrependItem callable rest)

@label "Inference capability method entity"
@description "Peel declaration wrappers and project method callables from a registered dispatch-interface record scheme."
@tags "engine" "internal" "signature" "inference" "dispatch" "phase-2"
@category "engine-internal"
inferenceCapabilityMethodEntity : (entity: a) -> (type: b) -> Result c d
inferenceCapabilityMethodEntity entity type =
  case type of
    TtRecord { fields = fields } -> inferenceCapabilityMethodFields entity fields
    TtOpaque { pure = pure } -> inferenceCapabilityMethodEntity entity pure
    TtMu { body = body } -> inferenceCapabilityMethodEntity entity body
    other -> inferenceErr "inference.capability-shape" entity.ownerName "capability source scheme is not a record type"

@label "Inference registered capability method callables"
@description "Derive exact kinded callable schemes for selected dispatch-interface methods entirely in Fenel."
@tags "engine" "signature" "inference" "dispatch" "phase-2"
inferenceRegisteredCapabilityMethodCallables : (entities: a) -> Result b c
inferenceRegisteredCapabilityMethodCallables entities =
  fold
    (\prepared entity ->
      case prepared of
        Err e -> Err e
        Ok acc ->
          case head entity.unresolvedNominalNames of
            Just nominal ->
              inferenceErr
                "inference.capability-nominal-provenance"
                entity.ownerName
                (concat "capability scheme has no defining source provenance for nominal reference " nominal)
            Nothing ->
              case inferenceCapabilityMethodEntity entity entity.typeTraversal of
                Err e -> Err e
                Ok current -> Ok (concat acc current))
    (Ok [])
    entities

@label "Inference environment lookup"
@description "Head-first lexical lookup; new bindings are prepended so inner scope wins."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceEnvironmentLookup : (name: String) -> (environment: a) -> Maybe a
inferenceEnvironmentLookup name environment =
  case inferenceEnvironmentLookupBinding name environment of
    Nothing -> Nothing
    Just binding -> Just binding.scheme

@label "Inference environment binding lookup"
@description "Head-first lexical lookup of the whole binding (its scheme and the opaque reads its generalization carried); new bindings are prepended so inner scope wins."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceEnvironmentLookupBinding : (name: String) -> (environment: a) -> Maybe b
inferenceEnvironmentLookupBinding name environment =
  fold
    (\found binding ->
      case found of
        Just match -> Just match
        Nothing -> if eq name binding.name then Just binding else Nothing)
    Nothing
    environment

@label "Inference dotted value path"
@description "Split a dotted runtime value spelling into its lexical root and nonempty projection tail. A dotless spelling and malformed empty root remain exact names."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceDottedValuePath : (name: String) -> Maybe a
inferenceDottedValuePath name =
  let parts = split name "."
  if lte (length parts) 1 then Nothing
  else
    case head parts of
      Nothing -> Nothing
      Just root -> if eq root "" then Nothing else Just { root = root, segments = tailOr parts }

@label "Inference lexical spelling is bound"
@description "A dotted runtime value is lexical when its root is bound; otherwise the complete spelling remains available to exact qualified module/function routing."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceLexicalSpellingBound : (name: String) -> (bound: a) -> Boolean
inferenceLexicalSpellingBound name bound =
  if elem name bound then true
  else
    case inferenceDottedValuePath name of
      Nothing -> false
      Just path -> elem path.root bound

@label "Inference environment dynamic call is opaque"
@description "Distinguish unknown higher-order parameters/host bindings from locally inferred let/where functions whose bodies were already checked in this solve."
@tags "engine" "internal" "signature" "inference" "effect" "phase-2"
@category "engine-internal"
inferenceEnvironmentDynamicOpaque : (name: String) -> (environment: a) -> Boolean
inferenceEnvironmentDynamicOpaque name environment =
  case inferenceEnvironmentLookup name environment of
    Just exact -> inferenceEnvironmentDynamicOpaqueName name environment
    Nothing ->
      case inferenceDottedValuePath name of
        Nothing -> inferenceEnvironmentDynamicOpaqueName name environment
        Just path -> inferenceEnvironmentDynamicOpaqueName path.root environment

@label "Inference environment dynamic call opacity by exact name"
@description "Read the dynamic-call provenance flag for one already-selected lexical binder. A miss is conservatively opaque."
@tags "engine" "internal" "signature" "inference" "effect" "phase-2"
@category "engine-internal"
inferenceEnvironmentDynamicOpaqueName : (name: String) -> (environment: a) -> Boolean
inferenceEnvironmentDynamicOpaqueName name environment =
  case head environment of
    Nothing -> true
    Just binding ->
      if eq binding.name name then binding.dynamicOpaque
      else inferenceEnvironmentDynamicOpaqueName name (tailOr environment)

@label "Inference callable lookup"
@description "Lookup an exact registry-resolution row by source call spelling."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCallableLookup : (name: String) -> (callables: a) -> Maybe a
inferenceCallableLookup name callables =
  case find (\row -> and (eq row.name name) (eq row.projectedValue true)) callables of
    Just projected -> Just projected
    Nothing ->
      fold
        (\found row ->
          case found of
            Just existing -> Just existing
            Nothing -> if eq name row.name then Just row else Nothing)
        Nothing
        callables

@label "Inference prepend binding"
@description "Prepend one lexical scheme binding (newest-first shadowing)."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePrependBinding : (name: String) -> (scheme: a) -> (dynamicOpaque: Boolean) -> (environment: b) -> b
inferencePrependBinding name scheme dynamicOpaque environment =
  concat (appendItem { name = name, scheme = scheme, dynamicOpaque = dynamicOpaque, opaqueReads = [] } []) environment

@label "Inference prepend generalized binding"
@description "Prepend one let/where binding: its generalized scheme and the opaque reads that generalization carried (inferenceGeneralizedOpaqueReads), re-recorded at each use (inferenceInstantiateBinding). A local let/where value was checked in this solve, so a dynamic call through it is not effect-opaque."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferencePrependGeneralizedBinding : (name: String) -> (scheme: a) -> (opaqueReads: b) -> (environment: c) -> c
inferencePrependGeneralizedBinding name scheme opaqueReads environment =
  concat (appendItem { name = name, scheme = scheme, dynamicOpaque = false, opaqueReads = opaqueReads } []) environment

@label "Inference monomorphic scheme"
@description "Wrap an inference type as a scheme with no quantified variables."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceMonoScheme : (type: a) -> TypeScheme
inferenceMonoScheme type = TypeScheme { quantified = [], body = type }

@label "Inference positional parameter"
@description "Build one internal arrow parameter with stable positional identity."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePositionalParam : (index: Number) -> (type: a) -> b
inferencePositionalParam index type = {
  key = PositionalField { index = index },
  keyToken = concat "p:" (toString index),
  wireName = concat "_" (toString index),
  type = type
}

@label "Inference params from types"
@description "Build stable positional arrow params from a type list."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceParamsFromTypes : (types: a) -> (index: Number) -> b
inferenceParamsFromTypes types index =
  case head types of
    Nothing -> []
    Just type -> inferencePrependItem (inferencePositionalParam index type) (inferenceParamsFromTypes (tailOr types) (add index 1))

@label "Inference infer expression list"
@description "Infer a Syntax list left-to-right, threading substitutions and fresh ids."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceInferList : (nodes: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferenceInferList nodes environment callables state path =
  case head nodes of
    Nothing -> Ok { types = [], state = state }
    Just node ->
      case inferenceInfer node environment callables state path of
        Err e -> Err e
        Ok first ->
          case inferenceInferList (tailOr nodes) environment callables first.state path of
            Err e -> Err e
            Ok rest -> Ok { types = inferencePrependItem first.type rest.types, state = rest.state }

@label "Inference type list contains union"
@description "Detect an output-only union anywhere below a type-list consumer boundary."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTypeListContainsUnion : (types: a) -> Boolean
inferenceTypeListContainsUnion types =
  case head types of
    Nothing -> false
    Just type ->
      if inferenceTypeContainsUnion type then true
      else inferenceTypeListContainsUnion (tailOr types)

@label "Inference field list contains union"
@description "Detect an output-only union below any semantic field type."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFieldListContainsUnion : (fields: a) -> Boolean
inferenceFieldListContainsUnion fields =
  case head fields of
    Nothing -> false
    Just field ->
      if inferenceTypeContainsUnion field.type then true
      else inferenceFieldListContainsUnion (tailOr fields)

@label "Inference case list contains union"
@description "Detect an output-only union below any variant payload."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCaseListContainsUnion : (cases: a) -> Boolean
inferenceCaseListContainsUnion cases =
  case head cases of
    Nothing -> false
    Just variantCase ->
      if inferenceFieldListContainsUnion variantCase.fields then true
      else inferenceCaseListContainsUnion (tailOr cases)

@label "Inference type contains union"
@description "Recursively recognize output-only unions before a value reaches any consumer or elimination boundary. Callers apply the current substitution first."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTypeContainsUnion : (type: a) -> Boolean
inferenceTypeContainsUnion type =
  if eq type.tag "ItUnion" then true
  else if eq type.tag "ItApp" then
    if inferenceTypeContainsUnion type.head then true else inferenceTypeListContainsUnion type.args
  else if eq type.tag "ItRecord" then inferenceFieldListContainsUnion type.fields
  else if eq type.tag "ItVariant" then inferenceCaseListContainsUnion type.cases
  else if eq type.tag "ItTuple" then inferenceTypeListContainsUnion type.items
  else if eq type.tag "ItMap" then inferenceTypeContainsUnion type.values
  else if eq type.tag "ItRefined" then inferenceTypeContainsUnion type.base
  else if eq type.tag "ItMu" then inferenceTypeContainsUnion type.body
  else if eq type.tag "ItTagged" then
    if inferenceTypeContainsUnion type.value then true else inferenceTypeContainsUnion type.phantom
  else if eq type.tag "ItOpaque" then inferenceTypeContainsUnion type.pure
  else if eq type.tag "ItArrow" then
    if inferenceFieldListContainsUnion type.params then true else inferenceTypeContainsUnion type.returns
  else if eq type.tag "ItIntersect" then inferenceTypeListContainsUnion type.branches
  else if eq type.tag "ItComplement" then inferenceTypeContainsUnion type.inner
  else false

@label "Inference environment owns monomorphic meta"
@description "Recognize a still-monomorphic lexical binder by exact meta identity; this provenance distinguishes a higher-rank-required use from an ordinary ground mismatch."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceEnvironmentOwnsMonomorphicMeta : (type: a) -> (environment: b) -> Boolean
inferenceEnvironmentOwnsMonomorphicMeta type environment =
  if not (eq type.tag "ItMeta") then false
  else
    case head environment of
      Nothing -> false
      Just binding ->
        let body = binding.scheme.body
        if and (eq (length binding.scheme.quantified) 0) (and (eq body.tag "ItMeta") (eq body.id type.id))
        then true
        else inferenceEnvironmentOwnsMonomorphicMeta type (tailOr environment)

@label "Inference exact mismatch needs higher rank"
@description "Classify only exact unification disagreements that can arise from incompatible callable instances; occurs-check and ordinary fence diagnostics retain their own verdicts."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceMismatchNeedsHigherRank : (diagnostic: a) -> Boolean
inferenceMismatchNeedsHigherRank diagnostic =
  if eq diagnostic.code "inference.arity-mismatch" then true
  else if eq diagnostic.code "inference.constructor-mismatch" then true
  else if eq diagnostic.code "inference.field-key-mismatch" then true
  else if eq diagnostic.code "inference.field-width-mismatch" then true
  else if eq diagnostic.code "inference.kind-mismatch" then true
  else if eq diagnostic.code "inference.map-key-mismatch" then true
  else if eq diagnostic.code "inference.mu-identity-mismatch" then true
  else if eq diagnostic.code "inference.nominal-mismatch" then true
  else if eq diagnostic.code "inference.opaque-identity-mismatch" then true
  else if eq diagnostic.code "inference.rigid-mismatch" then true
  else if eq diagnostic.code "inference.variant-width-mismatch" then true
  else if eq diagnostic.code "inference.width-mismatch" then true
  else false

@label "Inference recursive monomorphic call"
@description "Identify an exact current-SCC call after lexical shadowing, so only occurs-shapes created by recursive monomorphic reuse become the polymorphic-recursion fence."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecursiveMonomorphicCall : (name: String) -> (environment: a) -> (callables: b) -> Boolean
inferenceRecursiveMonomorphicCall name environment callables =
  case inferenceEnvironmentLookup name environment of
    Just lexical -> false
    Nothing ->
      case inferenceCallableLookup name callables of
        Nothing -> false
        Just row -> and (eq row.status "resolved") (eq row.trust "recursive-monomorphic")

@label "Inference unify call arguments"
@description "Unify call arguments with the matching positional parameter prefix, recursively fencing union consumers and preserving lexical provenance for higher-rank diagnostics."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnifyCallArgs : (args: a) -> (params: b) -> (environment: c) -> (state: d) -> (path: String) -> Result e f
inferenceUnifyCallArgs args params environment state path =
  case head args of
    Nothing -> Ok state
    Just arg ->
      case head params of
        Nothing -> inferenceErr "inference.overapplication" path "over-application reached a non-callable result"
        Just param ->
          let appliedArg = inferenceApply arg state
          let appliedParam = inferenceApply param.type state
          let rankCandidate = and (inferenceEnvironmentOwnsMonomorphicMeta arg environment) (and (eq appliedArg.tag "ItArrow") (eq appliedParam.tag "ItArrow"))
          if or (inferenceTypeContainsUnion appliedArg) (inferenceTypeContainsUnion appliedParam) then
            inferenceErr "inference.union-consumer" path "union injection/elimination at a consumer boundary requires an annotation"
          else
            case inferenceUnify appliedArg appliedParam state (concat path (concat "/arg/" param.keyToken)) of
              Err e ->
                if and rankCandidate (inferenceMismatchNeedsHigherRank e)
                then inferenceErr "inference.higher-rank" path "a monomorphic function parameter is required at incompatible instances; higher-rank use requires an annotation"
                else if inferenceSetFormerFence e then inferenceAfterSetFormerFence e (inferenceUnifyCallArgs (tailOr args) (tailOr params) environment state path)
                else Err e
              Ok next -> inferenceUnifyCallArgs (tailOr args) (tailOr params) environment next path

@label "Inference drop types"
@description "Drop n entries from a list (bounded by list length)."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceDrop : (count: Number) -> (items: a) -> a
inferenceDrop count items =
  if lte count 0 then items
  else case head items of Nothing -> []; Just item -> inferenceDrop (sub count 1) (tailOr items)

@label "Inference take types"
@description "Take n entries from a list."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTake : (count: Number) -> (items: a) -> a
inferenceTake count items =
  if lte count 0 then []
  else case head items of Nothing -> []; Just item -> inferencePrependItem item (inferenceTake (sub count 1) (tailOr items))

@label "Inference apply callable type"
@description "Apply inferred argument types to a callable: exact call, partial result arrow, or proven callable-result spill; scalar overapplication fences."
@tags "engine" "signature" "inference" "phase-2"
inferenceApplyCallable : (callee: a) -> (args: b) -> (environment: c) -> (state: d) -> (path: String) -> (higherRankCandidate: Boolean) -> (polymorphicRecursionCandidate: Boolean) -> Result e f
inferenceApplyCallable callee args environment state path higherRankCandidate polymorphicRecursionCandidate =
  let current = inferenceFlattenArrow (inferencePrune callee state)
  if eq current.tag "ItMeta" then
    let fresh = inferenceFresh state
    let expected = { tag = "ItArrow", params = inferenceParamsFromTypes args 0, returns = fresh.type }
    case inferenceUnify current expected fresh.state path of
      Err e ->
        if and polymorphicRecursionCandidate (eq e.code "inference.occurs-check")
        then inferenceErr "inference.polymorphic-recursion" path "a recursive SCC call requires polymorphic recursion, which is outside bounded rank-1 inference"
        else Err e
      Ok next -> Ok { type = fresh.type, state = next }
  else if eq current.tag "ItUnion" then inferenceErr "inference.union-callee" path "union elimination/calling a union-typed value requires an annotation"
  else if not (eq current.tag "ItArrow") then inferenceErr "inference.not-callable" path "attempted to apply a non-callable value"
  else
    let arity = length current.params
    let argc = length args
    let prefixArgs = inferenceTake arity args
    case inferenceUnifyCallArgs prefixArgs current.params environment state path of
      Err e ->
        if and polymorphicRecursionCandidate (eq e.code "inference.occurs-check")
        then inferenceErr "inference.polymorphic-recursion" path "a recursive SCC call requires polymorphic recursion, which is outside bounded rank-1 inference"
        else if and higherRankCandidate (inferenceMismatchNeedsHigherRank e)
        then inferenceErr "inference.higher-rank" path "a monomorphic function parameter is required at incompatible instances; higher-rank use requires an annotation"
        else Err e
      Ok next ->
        if lt argc arity then Ok { type = { tag = "ItArrow", params = inferenceDrop argc current.params, returns = current.returns }, state = next }
        else if eq argc arity then Ok { type = current.returns, state = next }
        else inferenceApplyCallable current.returns (inferenceDrop arity args) environment next (concat path "/result") false false

@label "Inference literal array items"
@description "Infer a homogeneous list literal, unifying every item with one fresh element meta."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceLiteralArrayItems : (items: a) -> (element: b) -> (state: c) -> (path: String) -> Result d e
inferenceLiteralArrayItems items element state path =
  case head items of
    Nothing -> Ok state
    Just value ->
      case inferenceLiteral value state path of
        Err e -> Err e
        Ok inferred ->
          case inferenceUnify inferred.type element inferred.state path of
            Err e -> Err e
            Ok next -> inferenceLiteralArrayItems (tailOr items) element next path

@label "Inference pure-data literal"
@description "Infer a pureData-marked SLit (a list literal of plain data, `syntaxListLiteral`) exactly as the Syntax it replaced: scalars as literals, a record through the SRecord rule (its fields as pureData SLits), a list by folding its items into one fresh element type. Linear in the data; no recursion over list length."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferencePureData : (raw: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferencePureData raw environment callables state path =
  if isArray raw then inferencePureList raw environment callables state path
  else if or (isString raw) (or (isNumber raw) (or (isBoolean raw) (isNull raw))) then inferenceLiteral raw state path
  else inferenceInfer (SRecord { fields = map (\entry -> { name = entry.key, value = inferencePureNode entry.value }) (entries raw) }) environment callables state path

@label "Inference pure-data node"
@description "A pureData-marked SLit around one raw plain-data value (a record field value or list item)."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferencePureNode : (raw: a) -> b
inferencePureNode raw = mapSet (SLit { value = raw }) "pureData" true

@label "Inference pure-data list"
@description "Infer a plain-data list: every item's type is unified with one fresh element meta, folding over the items (native fold) so a long list never recurses. An item with the same flat shape as the item before it (same field names, same scalar kinds) has the same ground type, already unified, and is skipped. The List type itself comes from one application of the resolved `std.appendItem` (its declared result, exactly as each link of the lit-marked chain gave it), unified with the folded element type."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferencePureList : (items: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferencePureList items environment callables state path =
  let fresh = inferenceFresh state
  case fold (\acc item -> inferencePureListStep acc item fresh.type environment callables path) (Ok { state = fresh.state, shape = "" }) items of
    Err e -> Err e
    Ok done ->
      let literal = { tag = "ItApp", head = { tag = "ItNamed", name = "[\"system\",\"List\"]", publicName = "List" }, args = [fresh.type], headKind = KArrow { input = KType, output = KType }, kind = KType }
      case head items of
        Nothing -> Ok { type = literal, state = done.state }
        Just first ->
          case inferenceApplyResolvedCall (inferenceResolveExactCallable "std.appendItem" callables done.state (concat path "/callee")) [inferencePureNode first, SLit { value = [] }] environment callables path false of
            Err e -> Err e
            Ok linked ->
              case inferenceUnify linked.type literal linked.state path of
                Err e -> Err e
                Ok next -> Ok { type = linked.type, state = next }

@label "Inference pure-data list step"
@description "One fold step of inferencePureList: skip an item whose flat shape equals the previous item's; otherwise infer the item and unify its type with the element meta. The first error is kept."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferencePureListStep : (acc: a) -> (item: b) -> (element: c) -> (environment: d) -> (callables: e) -> (path: String) -> a
inferencePureListStep acc item element environment callables path =
  case acc of
    Err e -> acc
    Ok current ->
      let shape = inferencePureShape item
      if and (not (eq shape "")) (eq shape current.shape) then acc
      else
        case inferencePureData item environment callables current.state path of
          Err e -> Err e
          Ok inferred ->
            case inferenceUnify inferred.type element inferred.state path of
              Err e -> Err e
              Ok next -> Ok { state = next, shape = shape }

@label "Inference pure-data shape"
@description "A key equal for two plain-data values exactly when their inferred types are the same ground type without fresh metas: a scalar's kind, or a record of scalars as its field names (in order; none may contain a key delimiter) and their kinds. Any other value (lists, nested records) has the empty key and is always inferred."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferencePureShape : (raw: a) -> String
inferencePureShape raw =
  if isArray raw then ""
  else if or (isString raw) (or (isNumber raw) (or (isBoolean raw) (isNull raw))) then inferencePureScalarKind raw
  else
    let fields = entries raw
    let kinds = map (\entry -> concat entry.key (concat ":" (inferencePureScalarKind entry.value))) fields
    if not (all fields (\entry -> inferencePureShapeName entry.key)) then ""
    else if all kinds (\kind -> not (endsWith kind ":")) then concat "{" (concat (join kinds ",") "}")
    else ""

@label "Inference pure-data shape name"
@description "A field name the shape key spells unambiguously: it contains none of the key's delimiters (colon, comma, braces)."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferencePureShapeName : (name: String) -> Boolean
inferencePureShapeName name =
  not (or (contains name ":") (or (contains name ",") (or (contains name "{") (contains name "}"))))

@label "Inference pure-data scalar kind"
@description "The literal kind of a scalar (s, n, b or u, as inferenceLiteral types it); empty for anything else."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferencePureScalarKind : (raw: a) -> String
inferencePureScalarKind raw =
  if isString raw then "s"
  else if isNumber raw then "n"
  else if isBoolean raw then "b"
  else if isNull raw then "u"
  else ""

@label "Inference literal"
@description "Infer ground scalar and homogeneous array literals; arbitrary host objects require structural Syntax."
@tags "engine" "signature" "inference" "phase-2"
inferenceLiteral : (value: a) -> (state: b) -> (path: String) -> Result c d
inferenceLiteral value state path =
  if isString value then Ok { type = inferenceSystemGroundBuiltin "String", state = state }
  else if isNumber value then Ok { type = inferenceSystemGroundBuiltin "Number", state = state }
  else if isBoolean value then Ok { type = inferenceSystemGroundBuiltin "Boolean", state = state }
  else if isNull value then Ok { type = { tag = "ItUnit", value = true }, state = state }
  else if isArray value then
    let fresh = inferenceFresh state
    case inferenceLiteralArrayItems value fresh.type fresh.state path of
      Err e -> Err e
      Ok next -> Ok { type = { tag = "ItApp", head = { tag = "ItNamed", name = "[\"system\",\"List\"]", publicName = "List" }, args = [fresh.type], headKind = KArrow { input = KType, output = KType }, kind = KType }, state = next }
  else inferenceErr "inference.literal-object" path "object literals must reach inference as SRecord/SConstruct Syntax"

@label "Inference state with projections"
@description "Replace only the pending record-projection obligations in an immutable solver state."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceStateWithProjections : (projections: a) -> (state: b) -> b
inferenceStateWithProjections projections state = {
  path = state.path,
  next = state.next,
  subst = state.subst,
  residuals = state.residuals,
  projections = projections,
  effectOpaque = state.effectOpaque,
  localRecursiveOpaque = state.localRecursiveOpaque,
  declarations = state.declarations,
  opaqueProvenance = state.opaqueProvenance
}

@label "Inference append projection"
@description "Retain a deferred field obligation until later equations reveal the receiver's structural record type."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceAppendProjection : (projection: a) -> (state: b) -> b
inferenceAppendProjection projection state =
  inferenceStateWithProjections (appendItem projection state.projections) state

@label "Inference record field by wire spelling"
@description "Resolve one runtime dotted-path segment against the record's wire projection. Semantic FieldKey remains the unifier identity; duplicate wire projections are rejected as ambiguous."
@tags "engine" "internal" "signature" "inference" "projection" "field-identity" "phase-2"
@category "engine-internal"
inferenceRecordFieldByWire : (wireName: String) -> (fields: a) -> (path: String) -> Result b c
inferenceRecordFieldByWire wireName fields path =
  let matches = filter (\field -> eq field.wireName wireName) fields
  if eq (length matches) 0 then
    inferenceErr "inference.projection-field-missing" path (concat "record has no field projection named " wireName)
  else if gt (length matches) 1 then
    inferenceErr "inference.projection-field-ambiguous" path (concat "record has more than one field projection named " wireName)
  else
    case head matches of
      Nothing -> inferenceErr "inference.projection-field-missing" path (concat "record has no field projection named " wireName)
      Just field -> Ok field.type

@label "Inference defer record projection"
@description "Create a result meta for a field read whose receiver is not solved yet. This is an obligation, not an open-row type, and cannot escape generalization."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceDeferProjection : (receiver: a) -> (fieldName: String) -> (state: b) -> (path: String) -> Result c d
inferenceDeferProjection receiver fieldName state path =
  let fresh = inferenceFresh state
  let projection = { receiver = receiver, fieldName = fieldName, result = fresh.type, path = path }
  Ok { type = fresh.type, state = inferenceAppendProjection projection fresh.state }

-- -------------------------------------------------------------------------
-- modules-as-values Phase 5a (amendment A6) — nominal record projection.
--
-- A field read on a nominal application `T a1 … an` unfolds T through the
-- host's declaration row for exactly T's owner identity (carried in the
-- solver state, `inferenceInitialStateWith`). Only the requested field's
-- declared type is converted, so an erased law or a value-dependent sibling
-- never has to be a value; the declaration's binders are instantiated once and
-- the declared self type (the constructor-result shape the constructor
-- callables use) is unified with the receiver, which substitutes the
-- arguments and checks the owner and the kinds. Each unfold consumes one
-- projected segment and never chases an alias, a μ body or an opaque pure
-- view, so it cannot recurse without bound. Every gap is an explicit fence.
--
-- A declaration describes the fields a value is built with, not the fields a
-- value of the type carries: an erased obligation (a law or superclass field,
-- per the erasure verdict inferenceDeclarationWithErasure settles from the
-- row's field facts) need not be carried, and a nominal value may retain data
-- its declaration does not declare (an instance's `label` / `priority`). Both
-- fence, whatever the receiver's spelling (a member path, an alias, a deferred
-- projection) — never a type for a field a value may lack, never "no such
-- field" for one it may hold. A constructor pattern obeys the same rule
-- (inferencePatternObligationFence).
--
-- A nominal reached through an opaque type's pure view is never unfolded: the
-- host carrier holds only its own data. That holds directly
-- (inferenceProjectOpaqueView) and after any structural field read through the
-- view: the read is remembered in the solver state, so the nominal owners it
-- mentions never unfold, whether the value is projected at once, through a let
-- alias, or by a deferred projection discharged later, and whatever the
-- inference order (inferenceOpaqueProvenanceSettled); a let generalization
-- carries the read, and every use of the generalized binding records it again
-- at its own instance (inferenceGeneralizedOpaqueReads).
-- -------------------------------------------------------------------------

@label "Inference declaration rows"
@description "Select the host's nominal declaration rows (status `declaration`) carried beside the exact callable rows, each with its erasure verdict settled here (inferenceDeclarationWithErasure). They are projection evidence, never callables: no source spelling starts with `$decl:`."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDeclarationRows : (rows: a) -> b
inferenceDeclarationRows rows = map (\row -> inferenceDeclarationWithErasure row) (filter (\row -> eq row.status "declaration") rows)

@label "Inference append nominal declaration requests"
@description "Select unique captured nominal owner identities from validated scheme sidecars. A missing identity never becomes a source-name request; existing and attempted owners are excluded."
@tags "engine" "internal" "signature" "inference" "projection"
@category "engine-internal"
inferenceAppendNominalDeclarationRequests : (nominals: a) -> (known: b) -> (requests: c) -> c
inferenceAppendNominalDeclarationRequests nominals known requests =
  if not (isArray nominals) then requests
  else
    fold
      (\acc nominal ->
        if and (and (isString nominal.identity) (not (eq nominal.identity ""))) (and (isString nominal.publicName) (not (eq nominal.publicName "")))
        then
          if or (elem nominal.identity known) (std.some acc (\request -> eq request.identity nominal.identity)) then acc
          else appendItem { identity = nominal.identity, publicName = nominal.publicName } acc
        else acc)
      requests
      nominals

@label "Inference nominal declaration requests"
@description "Request declaration evidence only for the complete binding/callable schemes of this inference query and the captured declaration dependencies they reach. Existing declaration rows and attempted owners terminate cycles. This selects facts; the existing nominal projection rule alone decides whether they justify a field read."
@tags "engine" "internal" "signature" "inference" "projection"
@category "engine-internal"
inferenceNominalDeclarationRequests : (bindingRows: a) -> (callableRows: b) -> (attempted: c) -> d
inferenceNominalDeclarationRequests bindingRows callableRows attempted =
  let declarations = filter (\row -> eq row.status "declaration") callableRows
  let known = concat attempted (map (\row -> row.ownerIdentity) declarations)
  let bound = fold (\requests row -> inferenceAppendNominalDeclarationRequests row.scheme.nominals known requests) [] bindingRows
  let called = fold (\requests row -> if eq row.status "resolved" then inferenceAppendNominalDeclarationRequests row.scheme.nominals known requests else requests) bound callableRows
  fold (\requests row -> inferenceAppendNominalDeclarationRequests row.nominals known requests) called declarations

@label "Inference declaration with erasure verdict"
@description "One declaration row with its erasure verdict decided in Fenel from the facts the host marshalled: `erasureFields` (per field: its name, whether it is a law field by the registry's own rule, and the head of a superclass-shaped field, a head applied to the class parameter) and `erasureHeads` (per such head: whether a capability is registered for it and its owners). `obligations` lists every field a value of the type need not carry (a definite or an undecided obligation, so a read of it fences); `undecidedObligations` the subset whose classhood the facts cannot settle (so a value lacking it is never excused, inferenceDefiniteObligation)."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDeclarationWithErasure : (row: a) -> b
inferenceDeclarationWithErasure row =
  let verdicts = map (\field -> { name = field.name, verdict = inferenceErasureVerdict field row.erasureHeads }) row.erasureFields
  {
    name = row.name,
    targetId = row.targetId,
    status = row.status,
    ownerIdentity = row.ownerIdentity,
    ownerName = row.ownerName,
    quantified = row.quantified,
    typeTraversal = row.typeTraversal,
    diagnostics = row.diagnostics,
    obligations = map (\entry -> entry.name) (filter (\entry -> not (eq entry.verdict "ordinary")) verdicts),
    undecidedObligations = map (\entry -> entry.name) (filter (\entry -> eq entry.verdict "undecided") verdicts)
  }

@label "Inference erasure verdict"
@description "The erasure verdict of one declaration field (`obligation`, `undecided` or `ordinary`), the obligation-erasure rule of `seedFromType`: a law field (`Verified P`) is a definite obligation; a field without the superclass shape is ordinary; a superclass-shaped field is an obligation exactly when its head is a registered class: definite when a capability is registered for the head; ordinary when the head has no owner, or exactly one owner that is no registered class; undecided otherwise (several owners, or one the registry cannot key), and undecided when the host marshalled no facts for the head."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceErasureVerdict : (field: a) -> (heads: b) -> String
inferenceErasureVerdict field heads =
  if field.law then "obligation"
  else
    case field.superHead of
      Nothing -> "ordinary"
      Just headName ->
        case head (filter (\facts -> eq facts.name headName) heads) of
          Nothing -> "undecided"
          Just facts ->
            if facts.capability then "obligation"
            else if eq facts.owners "none" then "ordinary"
            else if eq facts.owners "one" then "ordinary"
            else "undecided"

-- -------------------------------------------------------------------------
-- Opaque provenance (final review 2026-10-02): a field type read through an
-- opaque type's pure view is remembered, and no nominal owner it mentions is
-- unfolded through its declaration anywhere in the same inference. This is
-- tracked per owner, not per value: a genuine value of that owner elsewhere in
-- the same expression fences too. Coarser than per-value provenance, never a
-- guess; and it does not depend on the order equations are solved in. A read
-- whose type mentions a variable a let generalizes is carried by the binding
-- (inferenceGeneralizedOpaqueReads) and recorded again, over fresh metas, at
-- every use (inferenceInstantiateBinding): the generalization is unchanged.
-- -------------------------------------------------------------------------

@label "Inference state with opaque provenance"
@description "Replace only the opaque-provenance record (field types read through an opaque pure view; nominal owners unfolded) in an immutable solver state."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceStateWithOpaqueProvenance : (provenance: a) -> (state: b) -> b
inferenceStateWithOpaqueProvenance provenance state = {
  path = state.path,
  next = state.next,
  subst = state.subst,
  residuals = state.residuals,
  projections = state.projections,
  effectOpaque = state.effectOpaque,
  localRecursiveOpaque = state.localRecursiveOpaque,
  declarations = state.declarations,
  opaqueProvenance = provenance
}

@label "Inference record opaque read"
@description "Remember a field type read through an opaque type's pure view. Every nominal owner it mentions, now or once its metavariables are solved, was reached through the opaque value's host carrier."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceRecordOpaqueRead : (fieldType: a) -> (state: b) -> b
inferenceRecordOpaqueRead fieldType state =
  inferenceStateWithOpaqueProvenance { reads = appendItem fieldType state.opaqueProvenance.reads, unfolded = state.opaqueProvenance.unfolded } state

@label "Inference record opaque reads"
@description "Remember several field types read through an opaque type's pure view (inferenceRecordOpaqueRead): a use of a let-generalized binding re-records the reads its generalization carried, at this use's fresh metas (inferenceInstantiateBinding)."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceRecordOpaqueReads : (fieldTypes: a) -> (state: b) -> b
inferenceRecordOpaqueReads fieldTypes state =
  if eq (length fieldTypes) 0 then state
  else inferenceStateWithOpaqueProvenance { reads = concat state.opaqueProvenance.reads fieldTypes, unfolded = state.opaqueProvenance.unfolded } state

@label "Inference record nominal unfold"
@description "Remember that a field was typed through the declaration of a nominal owner, so a later opaque read reaching that owner still fences (inferenceOpaqueProvenanceSettled)."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceRecordNominalUnfold : (nominal: a) -> (state: b) -> b
inferenceRecordNominalUnfold nominal state =
  inferenceStateWithOpaqueProvenance { reads = state.opaqueProvenance.reads, unfolded = appendItem { identity = nominal.name, publicName = nominal.publicName } state.opaqueProvenance.unfolded } state

@label "Inference nominal identities in type list"
@description "Collect the nominal owner identities mentioned by a list of inference types."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceNominalIdentitiesList : (types: a) -> (acc: b) -> b
inferenceNominalIdentitiesList types acc =
  case head types of
    Nothing -> acc
    Just type -> inferenceNominalIdentitiesList (tailOr types) (inferenceNominalIdentities type acc)

@label "Inference nominal identities in fields"
@description "Collect the nominal owner identities mentioned by a field list."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceNominalIdentitiesFields : (fields: a) -> (acc: b) -> b
inferenceNominalIdentitiesFields fields acc = inferenceNominalIdentitiesList (map (\field -> field.type) fields) acc

@label "Inference nominal identities in cases"
@description "Collect the nominal owner identities mentioned by a variant's payloads."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceNominalIdentitiesCases : (cases: a) -> (acc: b) -> b
inferenceNominalIdentitiesCases cases acc =
  case head cases of
    Nothing -> acc
    Just variantCase -> inferenceNominalIdentitiesCases (tailOr cases) (inferenceNominalIdentitiesFields variantCase.fields acc)

@label "Inference nominal identities"
@description "Collect, once each, the owner identity of every nominal (a named type or an application head) anywhere in an inference type."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceNominalIdentities : (type: a) -> (acc: b) -> b
inferenceNominalIdentities type acc =
  if eq type.tag "ItNamed" then (if elem type.name acc then acc else appendItem type.name acc)
  else if eq type.tag "ItApp" then inferenceNominalIdentitiesList type.args (inferenceNominalIdentities type.head acc)
  else if eq type.tag "ItRecord" then inferenceNominalIdentitiesFields type.fields acc
  else if eq type.tag "ItVariant" then inferenceNominalIdentitiesCases type.cases acc
  else if eq type.tag "ItTuple" then inferenceNominalIdentitiesList type.items acc
  else if eq type.tag "ItMap" then inferenceNominalIdentities type.values acc
  else if eq type.tag "ItRefined" then inferenceNominalIdentities type.base acc
  else if eq type.tag "ItMu" then inferenceNominalIdentities type.body acc
  else if eq type.tag "ItTagged" then inferenceNominalIdentitiesList [type.value, type.phantom] acc
  else if eq type.tag "ItOpaque" then inferenceNominalIdentities type.pure acc
  else if eq type.tag "ItArrow" then inferenceNominalIdentities type.returns (inferenceNominalIdentitiesFields type.params acc)
  else if eq type.tag "ItUnion" then inferenceNominalIdentitiesList type.branches acc
  else if eq type.tag "ItIntersect" then inferenceNominalIdentitiesList type.branches acc
  else if eq type.tag "ItComplement" then inferenceNominalIdentities type.inner acc
  else acc

@label "Inference opaque-reached identities"
@description "The nominal owners reached through an opaque type's pure view so far: those mentioned by every remembered opaque read under the current substitution."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceOpaqueReachedIdentities : (state: a) -> b
inferenceOpaqueReachedIdentities state =
  inferenceNominalIdentitiesList (map (\read -> inferenceApply read state) state.opaqueProvenance.reads) []

@label "Inference opaque provenance settled"
@description "After the whole expression is solved: no nominal owner whose declaration typed a field was also reached through an opaque type's pure view. inferenceProjectNominal refuses such an unfold when the opaque read came first; this closes the other order (the projection was typed before the equation that made its receiver an opaque read was solved). A violation is a fence, never Invalid."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceOpaqueProvenanceSettled : (state: a) -> (path: String) -> Result Boolean b
inferenceOpaqueProvenanceSettled state path =
  let reached = inferenceOpaqueReachedIdentities state
  case head (filter (\unfold -> elem unfold.identity reached) state.opaqueProvenance.unfolded) of
    Nothing -> Ok true
    Just unfold -> inferenceErr "inference.record-projection" path (concat "a field of " (concat unfold.publicName (concat " was typed through its declaration, but " (concat unfold.publicName " is also reached through an opaque type's pure view in this expression, and an opaque value's host carrier holds only its own data: the field's type is unknown"))))

@label "Inference declaration constructor fields"
@description "The field list of a declaration's only constructor: a record, or a variant with exactly one case, seen through a refinement or a tag. A multi-case variant (a value may hold another constructor), an opaque declaration (its values are host carriers; its pure view is never unfolded), a μ body or an alias is Nothing, so projection fences instead of guessing."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDeclarationFields : (type: a) -> Maybe b
inferenceDeclarationFields type =
  case type of
    TtRecord { fields = fields } -> Just fields
    TtVariant { cases = cases } ->
      case head cases of
        Nothing -> Nothing
        Just only -> if eq (length cases) 1 then Just only.fields else Nothing
    TtRefined { base = base } -> inferenceDeclarationFields base
    TtTagged { value = value } -> inferenceDeclarationFields value
    other -> Nothing

@label "Inference unowned nominal in type list"
@description "First unowned nominal spelling in a list of inference types."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceUnownedNominalList : (types: a) -> Maybe String
inferenceUnownedNominalList types =
  case head types of
    Nothing -> Nothing
    Just type ->
      case inferenceUnownedNominal type of
        Just name -> Just name
        Nothing -> inferenceUnownedNominalList (tailOr types)

@label "Inference unowned nominal in fields"
@description "First unowned nominal spelling below a field list."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceUnownedNominalFields : (fields: a) -> Maybe String
inferenceUnownedNominalFields fields = inferenceUnownedNominalList (map (\field -> field.type) fields)

@label "Inference unowned nominal in cases"
@description "First unowned nominal spelling below a variant's payloads."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceUnownedNominalCases : (cases: a) -> Maybe String
inferenceUnownedNominalCases cases =
  case head cases of
    Nothing -> Nothing
    Just variantCase ->
      case inferenceUnownedNominalFields variantCase.fields of
        Just name -> Just name
        Nothing -> inferenceUnownedNominalCases (tailOr cases)

@label "Inference unowned nominal"
@description "First nominal in a projected declaration field that carries no owner identity (its name is its bare spelling), other than String, Number and Boolean, which the unifier already equates with their system owners. A declaration row carries no nominal resolution, so any other bare spelling has no owner proof and the projection fences rather than publish an unowned name."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceUnownedNominal : (type: a) -> Maybe String
inferenceUnownedNominal type =
  if eq type.tag "ItNamed" then
    if and (eq type.name type.publicName) (not (inferenceGroundBuiltinNominalIdentity type.publicName type.name))
    then Just type.publicName
    else Nothing
  else if eq type.tag "ItApp" then inferenceUnownedNominalList (concat [type.head] type.args)
  else if eq type.tag "ItRecord" then inferenceUnownedNominalFields type.fields
  else if eq type.tag "ItVariant" then inferenceUnownedNominalCases type.cases
  else if eq type.tag "ItTuple" then inferenceUnownedNominalList type.items
  else if eq type.tag "ItMap" then inferenceUnownedNominal type.values
  else if eq type.tag "ItRefined" then inferenceUnownedNominal type.base
  else if eq type.tag "ItMu" then inferenceUnownedNominal type.body
  else if eq type.tag "ItTagged" then inferenceUnownedNominalList [type.value, type.phantom]
  else if eq type.tag "ItOpaque" then inferenceUnownedNominal type.pure
  else if eq type.tag "ItArrow" then
    case inferenceUnownedNominalFields type.params of
      Just name -> Just name
      Nothing -> inferenceUnownedNominal type.returns
  else if eq type.tag "ItUnion" then inferenceUnownedNominalList type.branches
  else if eq type.tag "ItIntersect" then inferenceUnownedNominalList type.branches
  else if eq type.tag "ItComplement" then inferenceUnownedNominal type.inner
  else Nothing

@label "Inference higher-kinded binders"
@description "Does a declaration bind a type constructor (a binder of kind other than Type)? Substituting a constructor into an application head needs application-head normalization the unifier does not have, so such an unfold fences."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceHigherKindedBinders : (quantified: a) -> Boolean
inferenceHigherKindedBinders quantified =
  gt (length (filter (\variable -> not (inferenceKindEq variable.kind KType)) quantified)) 0

@label "Inference instantiate declaration field"
@description "Instantiate a declaration's binders once with fresh metas across its self type and one converted field type, then unify the self type with the receiver: nominal congruence substitutes the receiver's arguments. The receiver's shape is checked against the declaration first (inferenceDeclarationReceiverShape), and a unification failure here is a fence too: this step only instantiates the declaration, so a disagreement says the receiver's type and its declaration evidence disagree, never that the expression is ill-typed."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceInstantiateDeclarationField : (receiver: a) -> (declaration: b) -> (fieldType: c) -> (state: d) -> (path: String) -> Result e f
inferenceInstantiateDeclarationField receiver declaration fieldType state path =
  case inferenceDeclarationReceiverShape receiver declaration path of
    Err e -> Err e
    Ok shaped ->
      let self = inferenceConstructorResult declaration.ownerIdentity declaration.ownerName declaration.quantified
      let fresh = inferenceInstantiate (TypeScheme { quantified = declaration.quantified, body = { tag = "ItTuple", items = [self, fieldType] } }) state
      case head fresh.type.items of
        Nothing -> inferenceErr "inference.malformed-type" path "declaration instantiation lost its self type"
        Just instantiatedSelf ->
          case head (tailOr fresh.type.items) of
            Nothing -> inferenceErr "inference.malformed-type" path "declaration instantiation lost its field type"
            Just instantiatedField ->
              case inferenceUnify instantiatedSelf receiver fresh.state path of
                Err e -> inferenceErr "inference.record-projection" path (concat "the receiver's type does not instantiate the declaration of " (concat declaration.ownerName (concat " (" (concat e.code (concat ": " (concat e.message ")"))))))
                Ok next -> Ok { type = instantiatedField, state = next }

@label "Inference declaration receiver shape"
@description "Does a nominal receiver have the shape of a value of its declaration's type? A bare nominal (`ItNamed`) fits only a declaration with no binders; an application must apply every binder and have kind Type. A bare or partially applied receiver (a host binding typed `Iso`, or `Iso String`) is no value type of the declaration, so its fields are unknown: an explicit fence, as it was before any declaration evidence was in scope."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDeclarationReceiverShape : (receiver: a) -> (declaration: b) -> (path: String) -> Result Boolean c
inferenceDeclarationReceiverShape receiver declaration path =
  let binders = length declaration.quantified
  if eq receiver.tag "ItNamed" then
    if eq binders 0 then Ok true
    else inferenceErr "inference.record-projection" path (concat "the receiver's type names " (concat declaration.ownerName (concat " without the " (concat (toString binders) " type arguments its declaration binds: it types no value, so its fields are unknown"))))
  else if eq receiver.tag "ItApp" then
    if not (eq (length receiver.args) binders) then
      inferenceErr "inference.record-projection" path (concat "the receiver's type applies " (concat declaration.ownerName (concat " to " (concat (toString (length receiver.args)) (concat " arguments where its declaration binds " (concat (toString binders) ": its fields are unknown"))))))
    else if not (inferenceKindEq receiver.kind KType) then
      inferenceErr "inference.record-projection" path (concat "the receiver's type " (concat declaration.ownerName " is not of kind Type: it types no value, so its fields are unknown"))
    else Ok true
  else inferenceErr "inference.record-projection" path (concat "field projection needs a nominal receiver of " declaration.ownerName)

@label "Inference declaration field type"
@description "Convert only the requested field of a single-constructor declaration, under the declaration's own binders. An erased obligation (the row's `obligations` verdict: a law or superclass field) fences, since a value of the type need not carry it; a field the declaration does not declare fences, since a nominal value may retain undeclared data (never the definite `projection-field-missing`); a value-dependent field fences in the converter, and an unowned nominal spelling fences here."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDeclarationFieldType : (declaration: a) -> (fieldName: String) -> (path: String) -> Result b c
inferenceDeclarationFieldType declaration fieldName path =
  case inferenceDeclarationFields declaration.typeTraversal of
    Nothing -> inferenceErr "inference.record-projection" path (concat "field projection needs a single-constructor record declaration; " (concat declaration.ownerName " is not one"))
    Just fields ->
      if elem fieldName declaration.obligations
      then inferenceErr "inference.record-projection" path (concat "the field " (concat fieldName (concat " of " (concat declaration.ownerName " is an erased obligation (a law or superclass field): a value of the type need not carry it"))))
      else inferenceDeclarationDeclaredField declaration fields fieldName path

@label "Inference declaration declared field"
@description "The declared type of one non-obligation field of a single-constructor declaration. A field the declaration does not declare is unknown (a nominal value may retain undeclared data), so it fences instead of being reported missing. Any other failure to read or convert the declared field (an unbound scheme variable, a kind error, duplicate field keys, two fields with one spelling, a value-dependent type, …) says the DECLARATION evidence is unusable, not that the expression is ill-typed: it fences too, quoting the original diagnostic (inferenceDeclarationEvidenceFence)."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDeclarationDeclaredField : (declaration: a) -> (fields: b) -> (fieldName: String) -> (path: String) -> Result c d
inferenceDeclarationDeclaredField declaration fields fieldName path =
  case inferenceRecordFieldByWire fieldName fields path of
    Err e ->
      if eq e.code "inference.projection-field-missing"
      then inferenceErr "inference.record-projection" path (concat declaration.ownerName (concat " declares no field " (concat fieldName ", and a nominal value may retain data its declaration does not declare: the field's type is unknown")))
      else inferenceDeclarationEvidenceFence declaration fieldName e path
    Ok fieldTraversal ->
      case inferenceFromTraversal fieldTraversal declaration.quantified of
        Err e -> inferenceDeclarationEvidenceFence declaration fieldName e path
        Ok fieldType ->
          case inferenceUnownedNominal fieldType of
            Just spelling -> inferenceErr "inference.record-projection" path (concat "the declared type of " (concat declaration.ownerName (concat "." (concat fieldName (concat " names " (concat spelling " without an owner identity"))))))
            Nothing -> Ok fieldType

@label "Inference declaration evidence fence"
@description "Turn a failure to read a declaration field's type into the record-projection fence, quoting the original diagnostic code and message, as inferenceInstantiateDeclarationField does for unification."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDeclarationEvidenceFence : (declaration: a) -> (fieldName: String) -> (diagnostic: b) -> (path: String) -> Result c d
inferenceDeclarationEvidenceFence declaration fieldName diagnostic path =
  inferenceErr "inference.record-projection" path (concat "the declared type of " (concat declaration.ownerName (concat "." (concat fieldName (concat " cannot be read from its declaration (" (concat diagnostic.code (concat ": " (concat diagnostic.message ")"))))))))

@label "Inference project nominal field"
@description "Project one field of a nominal (application) receiver through the one declaration row for its exact owner identity. A nominal owner reached through an opaque type's pure view in this expression (inferenceOpaqueReachedIdentities) is never unfolded; an unfold is remembered so a later opaque read still fences (inferenceOpaqueProvenanceSettled)."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceProjectNominal : (receiver: a) -> (nominal: b) -> (fieldName: String) -> (state: c) -> (path: String) -> Result d e
inferenceProjectNominal receiver nominal fieldName state path =
  if elem nominal.name (inferenceOpaqueReachedIdentities state) then
    inferenceErr "inference.record-projection" path (concat "the nominal type " (concat nominal.publicName (concat " is reached through an opaque type's pure view in this expression, and an opaque value's host carrier holds only its own data: its declaration is never unfolded to project " fieldName)))
  else
    case inferenceProjectNominalEvidence receiver nominal fieldName state path of
      Err e -> Err e
      Ok projected -> Ok { type = projected.type, state = inferenceRecordNominalUnfold nominal projected.state }

@label "Inference project nominal field by evidence"
@description "Project one field of a nominal (application) receiver through the one declaration row for its exact owner identity. Missing or duplicated evidence, source-binding diagnostics and higher-kinded binders fence before any field is read."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceProjectNominalEvidence : (receiver: a) -> (nominal: b) -> (fieldName: String) -> (state: c) -> (path: String) -> Result d e
inferenceProjectNominalEvidence receiver nominal fieldName state path =
  let matches = filter (\row -> eq row.ownerIdentity nominal.name) state.declarations
  case head matches of
    Nothing -> inferenceErr "inference.record-projection" path (concat "no declaration evidence is available to project " (concat fieldName (concat " from the nominal type " nominal.publicName)))
    Just declaration ->
      if gt (length matches) 1 then inferenceErr "inference.record-projection" path (concat "more than one declaration row claims the nominal type " nominal.publicName)
      else if gt (length declaration.diagnostics) 0 then inferenceErr "inference.source-scheme" path (concat "the declaration of " (concat declaration.ownerName " has unresolved source binding diagnostics"))
      else if inferenceHigherKindedBinders declaration.quantified then inferenceErr "inference.record-projection" path (concat "projecting from " (concat declaration.ownerName " would substitute a type constructor into an application head"))
      else
        case inferenceDeclarationFieldType declaration fieldName path of
          Err e -> Err e
          Ok fieldType -> inferenceInstantiateDeclarationField receiver declaration fieldType state path

@label "Inference project one field"
@description "Project one dotted-path segment from an exact structural record, transparently peeling refinement/tag wrappers and an opaque wrapper whose pure view is a structural record (inferenceProjectOpaqueView), or from a nominal (application) whose single-constructor record declaration the state carries (inferenceProjectNominal); unresolved metas become deferred obligations."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceProjectOne : (receiver: a) -> (fieldName: String) -> (state: b) -> (path: String) -> Result c d
inferenceProjectOne receiver fieldName state path =
  let current = inferencePrune receiver state
  if eq current.tag "ItMeta" then inferenceDeferProjection current fieldName state path
  else if eq current.tag "ItRecord" then
    case inferenceRecordFieldByWire fieldName current.fields path of
      Err e -> Err e
      Ok fieldType -> Ok { type = fieldType, state = state }
  else if eq current.tag "ItRefined" then inferenceProjectOne current.base fieldName state path
  else if eq current.tag "ItTagged" then inferenceProjectOne current.value fieldName state path
  else if eq current.tag "ItOpaque" then inferenceProjectOpaqueView current.pure fieldName state path
  else if eq current.tag "ItNamed" then inferenceProjectNominal current current fieldName state path
  else if eq current.tag "ItApp" then inferenceProjectApplication current fieldName state path
  else inferenceErr "inference.record-projection" path (concat "field projection requires an exact structural record view: " fieldName)

@label "Inference project opaque view"
@description "Project one field through an opaque type's pure view. Only an exact structural record there (seen through refinements, tags and nested opaque views) is read, and the field type read is remembered (inferenceRecordOpaqueRead), so no nominal it mentions is unfolded later. A nominal (application) reached here is never unfolded: the opaque value is its host carrier, which holds only its own data, and nothing evidences that the declaration's fields are accessible on it. An unsolved view is not deferred either (its later solution would be projected without the opaque context). Both fence."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceProjectOpaqueView : (view: a) -> (fieldName: String) -> (state: b) -> (path: String) -> Result c d
inferenceProjectOpaqueView view fieldName state path =
  let current = inferencePrune view state
  if eq current.tag "ItRecord" then
    case inferenceRecordFieldByWire fieldName current.fields path of
      Err e -> Err e
      Ok fieldType -> Ok { type = fieldType, state = inferenceRecordOpaqueRead fieldType state }
  else if eq current.tag "ItRefined" then inferenceProjectOpaqueView current.base fieldName state path
  else if eq current.tag "ItTagged" then inferenceProjectOpaqueView current.value fieldName state path
  else if eq current.tag "ItOpaque" then inferenceProjectOpaqueView current.pure fieldName state path
  else inferenceErr "inference.record-projection" path (concat "field projection through an opaque type's pure view needs an exact structural record there (the host carrier holds only its own data): " fieldName)

@label "Inference project application field"
@description "A nominal application receiver projects through its head's declaration; an application whose head is a type variable has no declaration and fences."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceProjectApplication : (receiver: a) -> (fieldName: String) -> (state: b) -> (path: String) -> Result c d
inferenceProjectApplication receiver fieldName state path =
  let nominal = inferencePrune receiver.head state
  if eq nominal.tag "ItNamed" then inferenceProjectNominal receiver nominal fieldName state path
  else inferenceErr "inference.record-projection" path (concat "field projection requires an exact structural record view: " fieldName)

@label "Inference project dotted path"
@description "Walk every runtime dotted-path segment left-to-right, threading deferred obligations and substitutions."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceProjectPath : (receiver: a) -> (segments: b) -> (state: c) -> (path: String) -> Result d e
inferenceProjectPath receiver segments state path =
  case head segments of
    Nothing -> Ok { type = receiver, state = state }
    Just segment ->
      case inferenceProjectOne receiver segment state (concat path (concat "/field/" segment)) of
        Err e -> Err e
        Ok projected -> inferenceProjectPath projected.type (tailOr segments) projected.state path

@label "Inference first ready projection"
@description "Find the first pending field obligation whose receiver has become structural under the current substitution."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceFirstReadyProjection : (projections: a) -> (state: b) -> Maybe a
inferenceFirstReadyProjection projections state =
  case head projections of
    Nothing -> Nothing
    Just projection ->
      let current = inferencePrune projection.receiver state
      if eq current.tag "ItMeta"
      then inferenceFirstReadyProjection (tailOr projections) state
      else Just projection

@label "Inference remove projection"
@description "Remove one pending projection by its unique result-meta identity."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceRemoveProjection : (resultId: String) -> (projections: a) -> a
inferenceRemoveProjection resultId projections =
  filter (\projection -> not (eq projection.result.id resultId)) projections

@label "Inference discharge ready projections"
@description "Whenever unification solves a receiver, discharge every newly ready field obligation before returning the state. Unsolved obligations remain explicit and fence at generalization."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceDischargeReadyProjections : (state: a) -> Result a b
inferenceDischargeReadyProjections state =
  case inferenceFirstReadyProjection state.projections state of
    Nothing -> Ok state
    Just projection ->
      let remaining = inferenceRemoveProjection projection.result.id state.projections
      let without = inferenceStateWithProjections remaining state
      case inferenceProjectOne (inferencePrune projection.receiver without) projection.fieldName without projection.path of
        Err e -> Err e
        Ok projected ->
          case inferenceUnify projection.result projected.type projected.state projection.path of
            Err e -> Err e
            Ok next -> inferenceDischargeReadyProjections next

@label "Inference ensure projections discharged"
@description "Open-row polymorphism is outside the shipped scheme representation, so an unresolved receiver obligation must fence instead of publishing a guessed closed record."
@tags "engine" "internal" "signature" "inference" "projection" "phase-2"
@category "engine-internal"
inferenceEnsureProjectionsDischarged : (state: a) -> (path: String) -> Result Boolean b
inferenceEnsureProjectionsDischarged state path =
  case head state.projections of
    Nothing -> Ok true
    Just projection -> inferenceErr "inference.record-projection" path (concat "field projection receiver remains underdetermined: " projection.fieldName)

@label "Inference resolve exact callable"
@description "Resolve a complete source spelling through registry routing after lexical exact/root lookup has missed. Qualified module/function spellings are never split here."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceResolveExactCallable : (name: String) -> (callables: a) -> (state: b) -> (path: String) -> Result c d
inferenceResolveExactCallable name callables state path =
  case inferenceCallableLookup name callables of
    Nothing -> inferenceErr "inference.unknown-name" path (concat "no exact scheme is available for " name)
    Just row ->
      if eq row.status "ambiguous" then inferenceErr "inference.ambiguous-call" path (concat "call target is ambiguous: " name)
      else if eq row.status "missing" then inferenceErr "inference.unknown-name" path (concat "no exact scheme is available for " name)
      else if eq row.status "fenced" then
        case head row.diagnostics of
          Just diagnostic -> Err diagnostic
          Nothing -> inferenceErr "inference.malformed-fence" path (concat "exact callable fence has no diagnostics: " name)
      else Ok (inferenceInstantiate row.scheme state)

@label "Inference bare type constructor"
@description "Does a member's type hold a type constructor applied to nothing (the host's spelling of a higher-kinded argument such as the `Maybe` in `Functor Maybe`)? The solver has no application-head normalization, so such a member fences instead of letting the constructor reach an application head."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceBareTypeConstructor : (type: a) -> Boolean
inferenceBareTypeConstructor type =
  if not (eq type.tag "ItApp") then false
  else if eq (length type.args) 0 then true
  else gt (length (filter (\arg -> inferenceBareTypeConstructor arg) type.args)) 0

@label "Inference member first field"
@description "Project the first segment after `bundle.member`. The member row lists the fields its frozen value carries: a field the value does not carry (an erased law or superclass obligation, or no such field) fences. A carried field projects through the member's nominal type (inferenceMemberProjectCarried), which also fences retained data the declared type does not declare (an instance's `label` / `priority`). A carried field whose value is not closed data (unevaluated loader source or a reference, `openFields`) inhabits its declared type only when that type is a function type or `Maybe` of one (inferenceArrowLike): any other declared type fences."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceMemberFirstField : (row: a) -> (member: b) -> (fieldName: String) -> (path: String) -> Result c d
inferenceMemberFirstField row member fieldName path =
  let memberName = slice row.name 8 (length row.name)
  if not (elem fieldName row.valueFields) then
    inferenceErr "inference.record-projection" path (concat "the value of " (concat memberName (concat " carries no field " fieldName)))
  else
    case inferenceMemberProjectCarried member fieldName path of
      Err e -> Err e
      Ok projected ->
        if and (elem fieldName row.openFields) (not (inferenceArrowLike (inferenceApply projected.type projected.state)))
        then inferenceErr "inference.record-projection" path (concat "the value of " (concat memberName (concat " holds unevaluated source or a reference in its field " (concat fieldName ", not data of that field's declared type: the field's type is unknown"))))
        else Ok projected

@label "Inference member project carried field"
@description "Project a field the member's frozen value is known to carry through the member's nominal type. The value is the registry's own record, never an opaque carrier, so this read neither consults nor extends the opaque provenance (inferenceProjectNominalEvidence); any other declared type projects as usual."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceMemberProjectCarried : (member: a) -> (fieldName: String) -> (path: String) -> Result b c
inferenceMemberProjectCarried member fieldName path =
  let current = inferencePrune member.type member.state
  let nominal = if eq current.tag "ItApp" then inferencePrune current.head member.state else current
  if eq nominal.tag "ItNamed" then inferenceProjectNominalEvidence current nominal fieldName member.state path
  else inferenceProjectOne member.type fieldName member.state path

@label "Inference arrow-like type"
@description "Is a type a function type, or exactly the system `Maybe` of one? These are the declared types a lowered reference or a closure inhabits (a method field holds a reference; a `Maybe (a -> b)` field holds `Just` one). Anything else, a type variable included, is not."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceArrowLike : (type: a) -> Boolean
inferenceArrowLike type =
  if eq type.tag "ItArrow" then true
  else
    case inferenceCanonicalContainerView type of
      Nothing -> false
      Just view ->
        if not (eq view.name "Maybe") then false
        else
          case head view.args of
            Nothing -> false
            Just payload -> eq payload.tag "ItArrow"

@label "Inference declared field arrow-like"
@description "Is a declaration field's declared type (converted under the declaration's own binders) arrow-like (inferenceArrowLike)? A field type that does not convert is not."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDeclaredFieldArrowLike : (declaration: a) -> (field: b) -> Boolean
inferenceDeclaredFieldArrowLike declaration field =
  case inferenceFromTraversal field.type declaration.quantified of
    Err e -> false
    Ok converted -> inferenceArrowLike converted

@label "Inference member value"
@description "Type one `bundle.member` value row and project the remaining segments. The member's declared scheme is instantiated once; an ambiguous, fenced or unmarshalled row is terminal. A value's type has kind Type: a declared type whose kind is not Type (a constructor the instance under-applies, e.g. `Iso` or `Iso String`, whose arity the host carries as application-kind evidence) is no value type and fences."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceMemberValue : (row: a) -> (segments: b) -> (state: c) -> (path: String) -> Result d e
inferenceMemberValue row segments state path =
  if eq row.status "ambiguous" then inferenceErr "inference.ambiguous-call" path row.message
  else if eq row.status "fenced" then
    case head row.diagnostics of
      Just diagnostic -> Err diagnostic
      Nothing -> inferenceErr "inference.malformed-fence" path (concat "member fence has no diagnostics: " row.name)
  else if not (eq row.status "resolved") then inferenceErr "inference.host-scheme-sidecar" path row.message
  else
    let member = inferenceInstantiate row.scheme state
    if not (inferenceKindEq (inferenceTypeKind member.type) KType) then
      inferenceErr "inference.host-scheme-sidecar" path (concat "the declared type of " (concat (slice row.name 8 (length row.name)) " is under-applied: its kind is not Type, so it types no value"))
    else if inferenceBareTypeConstructor member.type then
      inferenceErr "inference.record-projection" path (concat (slice row.name 8 (length row.name)) " has a higher-kinded type argument; its type needs application-head normalization")
    else
      case head segments of
        Nothing ->
          case inferenceMemberCarriesDeclaredFields row member.type member.state path of
            Err e -> Err e
            Ok carried -> Ok member
        Just fieldName ->
          case inferenceMemberFirstField row member fieldName (concat path (concat "/field/" fieldName)) of
            Err e -> Err e
            Ok projected -> inferenceProjectPath projected.type (tailOr segments) projected.state path

@label "Inference member carries declared fields"
@description "May a member be used as a whole value of its declared type (bound by a let, passed to a lambda or a function, returned)? Only when its value carries every field the declaration declares, except a definite erased obligation (a law or superclass field; one whose erasure is undecided is not excused), and every carried declared field whose value is not closed data (`openFields`) is declared arrow-like (inferenceDeclaredFieldArrowLike). A named instance often omits declared fields (no completeness check at load; class defaults are filled by dispatch only), and once the member flows on, every later projection reads the declaration, not the value: so a missing field, missing declaration evidence or a declaration that is not one single-constructor record fences here. A type member's value is a type and carries no fields. A direct projection `b.m.f` does not come here: its first field is read against the value (inferenceMemberFirstField)."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceMemberCarriesDeclaredFields : (row: a) -> (memberType: b) -> (state: c) -> (path: String) -> Result Boolean d
inferenceMemberCarriesDeclaredFields row memberType state path =
  let memberName = slice row.name 8 (length row.name)
  let current = inferencePrune memberType state
  if eq current.tag "ItTypeUniverse" then Ok true
  else
    let nominal = if eq current.tag "ItApp" then inferencePrune current.head state else current
    if not (eq nominal.tag "ItNamed") then
      inferenceErr "inference.record-projection" path (concat "the declared type of " (concat memberName " is not a nominal type whose declared fields its value can be checked against"))
    else
      let matches = filter (\declaration -> eq declaration.ownerIdentity nominal.name) state.declarations
      case head matches of
        Nothing -> inferenceErr "inference.record-projection" path (concat "no declaration evidence is available to check that the value of " (concat memberName " carries the fields its declared type declares"))
        Just declaration ->
          if gt (length matches) 1 then inferenceErr "inference.record-projection" path (concat "more than one declaration row claims the nominal type " nominal.publicName)
          else
            case inferenceDeclarationFields declaration.typeTraversal of
              Nothing -> inferenceErr "inference.record-projection" path (concat declaration.ownerName (concat " is not a single-constructor record declaration, so whether the value of " (concat memberName " carries its fields is unknown")))
              Just fields ->
                let missing = filter (\field -> and (not (elem field.wireName row.valueFields)) (not (inferenceDefiniteObligation declaration field.wireName))) fields
                case head missing of
                  Just field -> inferenceErr "inference.record-projection" path (concat "the value of " (concat memberName (concat " does not carry its declared field " (concat field.wireName (concat " (not a definite erased obligation), so it is not known to inhabit its declared type " declaration.ownerName)))))
                  Nothing ->
                    let open = filter (\field -> and (elem field.wireName row.openFields) (and (not (elem field.wireName declaration.obligations)) (not (inferenceDeclaredFieldArrowLike declaration field)))) fields
                    case head open of
                      Nothing -> Ok true
                      Just field -> inferenceErr "inference.record-projection" path (concat "the value of " (concat memberName (concat " holds unevaluated source or a reference in its declared field " (concat field.wireName (concat ", not data of that field's declared type, so it is not known to inhabit its declared type " declaration.ownerName)))))

@label "Inference definite obligation"
@description "Is a declaration field a definite erased obligation (in the row's `obligations` verdict and not among its `undecidedObligations`)? Only such a field may be absent from a value of the type."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceDefiniteObligation : (declaration: a) -> (fieldName: String) -> Boolean
inferenceDefiniteObligation declaration fieldName =
  and (elem fieldName declaration.obligations) (not (elem fieldName declaration.undecidedObligations))

@label "Inference resolve qualified member"
@description "modules-as-values Phase 5a (A6): after lexical exact/root lookup missed, read `bundle.member` (exactly the first two segments) against the host's member value row; later segments are projections. A function member or a miss has no member row and keeps the exact callable route; a member row, once found, is terminal (no shorter prefix, no callable fallback)."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferenceResolveQualifiedMember : (name: String) -> (dotted: a) -> (callables: b) -> (state: c) -> (path: String) -> Result d e
inferenceResolveQualifiedMember name dotted callables state path =
  case find (\row -> and (eq row.name name) (eq row.projectedValue true)) callables of
    Just projected -> inferenceResolveExactCallable name [projected] state path
    Nothing ->
      case head dotted.segments of
        Nothing -> inferenceResolveExactCallable name callables state path
        Just member ->
          case inferenceCallableLookup (concat "$member:" (concat dotted.root (concat "." member))) callables of
            Nothing -> inferenceResolveExactCallable name callables state path
            Just row -> inferenceMemberValue row (tailOr dotted.segments) state path

@label "Inference resolve value scheme"
@description "Resolve an exact lexical value, then a bound-root dotted field projection, then (modules-as-values Phase 5a) a host member value row for an unbound `bundle.member` prefix, then an exact registry callable row. Unbound qualified names without a member row retain their complete spelling."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceResolveValue : (name: String) -> (environment: a) -> (callables: b) -> (state: c) -> (path: String) -> Result d e
inferenceResolveValue name environment callables state path =
  case inferenceEnvironmentLookupBinding name environment of
    Just binding -> Ok (inferenceInstantiateBinding binding state)
    Nothing ->
      case inferenceDottedValuePath name of
        Nothing -> inferenceResolveExactCallable name callables state path
        Just dotted ->
          case inferenceEnvironmentLookupBinding dotted.root environment of
            Nothing -> inferenceResolveQualifiedMember name dotted callables state path
            Just rootBinding ->
              let root = inferenceInstantiateBinding rootBinding state
              inferenceProjectPath root.type dotted.segments root.state path

@label "Inference call"
@description "Infer a named/local call with independent callee instantiation and left-to-right argument inference."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCall : (name: String) -> (args: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferenceCall name args environment callables state path =
  let dynamic = startsWith name "$dyn:"
  let resolvedName = if dynamic then slice name 5 (length name) else name
  let polymorphicRecursionCandidate = inferenceRecursiveMonomorphicCall resolvedName environment callables
  let callState = if dynamic then
                    if inferenceEnvironmentDynamicOpaque resolvedName environment then inferenceMarkEffectOpaque state else state
                  else state
  inferenceApplyResolvedCall (inferenceResolveValue resolvedName environment callables callState (concat path "/callee")) args environment callables path polymorphicRecursionCandidate

@label "Inference apply resolved call"
@description "Continue the existing call judgment from its resolved callee. Synthetic list construction can acquire its exact canonical signature without changing lexical lookup for the argument expressions or adding a type equation."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferenceApplyResolvedCall : (resolved: a) -> (args: b) -> (environment: c) -> (callables: d) -> (path: String) -> (polymorphicRecursionCandidate: Boolean) -> Result e f
inferenceApplyResolvedCall resolved args environment callables path polymorphicRecursionCandidate =
  case resolved of
    Err e -> Err e
    Ok callee ->
      let higherRankCandidate = inferenceEnvironmentOwnsMonomorphicMeta callee.type environment
      case inferenceInferList args environment callables callee.state (concat path "/args") of
        Err e -> Err e
        Ok inferredArgs -> inferenceApplyCallable callee.type inferredArgs.types environment inferredArgs.state path higherRankCandidate polymorphicRecursionCandidate

@label "Inference fresh lambda params"
@description "Allocate one monomorphic meta per lambda binder and prepend it to the lexical environment."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFreshLambdaParams : (names: a) -> (environment: b) -> (state: c) -> (index: Number) -> d
inferenceFreshLambdaParams names environment state index =
  case head names of
    Nothing -> { params = [], environment = environment, state = state }
    Just name ->
      let fresh = inferenceFresh state
      let param = inferencePositionalParam index fresh.type
      let env2 = inferencePrependBinding name (inferenceMonoScheme fresh.type) true environment
      let rest = inferenceFreshLambdaParams (tailOr names) env2 fresh.state (add index 1)
      { params = inferencePrependItem param rest.params, environment = rest.environment, state = rest.state }

@label "Inference lambda"
@description "Infer a rank-1 lambda with fresh monomorphic binders."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceLambda : (params: a) -> (body: b) -> (environment: c) -> (callables: d) -> (state: e) -> (path: String) -> Result f g
inferenceLambda params body environment callables state path =
  let fresh = inferenceFreshLambdaParams params environment state 0
  case inferenceInfer body fresh.environment callables fresh.state (concat path "/body") of
    Err e -> Err e
    Ok inferred -> Ok { type = { tag = "ItArrow", params = fresh.params, returns = inferred.type }, state = inferred.state }

@label "Inference record fields"
@description "Infer structural record fields, retaining supplied semantic tokens or stable local tokens when the Syntax has no registered owner."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecordFields : (fields: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> (index: Number) -> Result e f
inferenceRecordFields fields environment callables state path index =
  case head fields of
    Nothing -> Ok { fields = [], state = state }
    Just field ->
      case inferenceInfer field.value environment callables state (concat path (concat "/" field.name)) of
        Err e -> Err e
        Ok inferred ->
          let semanticKey = if isNull field.semanticKey then PositionalField { index = index } else field.semanticKey
          let token = fieldKeyToken semanticKey
          let converted = { key = semanticKey, keyToken = token, wireName = field.name, type = inferred.type }
          case inferenceRecordFields (tailOr fields) environment callables inferred.state path (add index 1) of
            Err e -> Err e
            Ok rest -> Ok { fields = inferencePrependItem converted rest.fields, state = rest.state }

@label "Inference Syntax field sort key"
@description "Canonicalize registered fields by semantic FieldKey and anonymous surface-record fields by their unique wire spelling before assigning local positional identities."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSyntaxFieldSortKey : (field: a) -> String
inferenceSyntaxFieldSortKey field =
  if isNull field.semanticKey
  then concat "local:" field.name
  else concat "semantic:" (fieldKeyToken field.semanticKey)

@label "Inference Syntax field keys unique"
@description "Reject duplicate anonymous spellings or duplicate semantic identities rather than silently collapsing them during canonical ordering."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSyntaxFieldKeysUnique : (fields: a) -> (seen: b) -> Boolean
inferenceSyntaxFieldKeysUnique fields seen =
  case head fields of
    Nothing -> true
    Just field ->
      let key = inferenceSyntaxFieldSortKey field
      if elem key seen then false
      else inferenceSyntaxFieldKeysUnique (tailOr fields) (appendItem key seen)

@label "Inference Syntax field by sort key"
@description "Lookup one unique Syntax record field by its canonical sort key."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSyntaxFieldBySortKey : (key: String) -> (fields: a) -> Maybe a
inferenceSyntaxFieldBySortKey key fields =
  case head fields of
    Nothing -> Nothing
    Just field ->
      if eq key (inferenceSyntaxFieldSortKey field) then Just field
      else inferenceSyntaxFieldBySortKey key (tailOr fields)

@label "Inference Syntax fields from sort keys"
@description "Rebuild the Syntax field list in canonical key order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSyntaxFieldsFromSortKeys : (keys: a) -> (fields: b) -> c
inferenceSyntaxFieldsFromSortKeys keys fields =
  case head keys of
    Nothing -> []
    Just key ->
      case inferenceSyntaxFieldBySortKey key fields of
        Nothing -> inferenceSyntaxFieldsFromSortKeys (tailOr keys) fields
        Just field -> inferencePrependItem field (inferenceSyntaxFieldsFromSortKeys (tailOr keys) fields)

@label "Inference canonical Syntax record fields"
@description "Stable field ordering independent of host object insertion order."
@tags "engine" "signature" "inference" "phase-2"
inferenceCanonicalSyntaxFields : (fields: a) -> a
inferenceCanonicalSyntaxFields fields =
  let keys = sortLex (map inferenceSyntaxFieldSortKey fields)
  inferenceSyntaxFieldsFromSortKeys keys fields

@label "Inference do sequence"
@description "Infer every SDo expression in order and return the final expression's type."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceDo : (exprs: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferenceDo exprs environment callables state path =
  case head exprs of
    Nothing -> Ok { type = { tag = "ItUnit", value = true }, state = state }
    Just expr ->
      case inferenceInfer expr environment callables state path of
        Err e -> Err e
        Ok inferred ->
          case head (tailOr exprs) of
            Nothing -> Ok inferred
            Just nextExpr -> inferenceDo (tailOr exprs) environment callables inferred.state path

@label "Inference let bindings"
@description "Sequential SLet inference: infer then generalize each value before extending the environment; the binding carries the opaque reads its generalization quantified over (inferenceGeneralizedOpaqueReads). The generalization context is the lexical environment plus the current SCC's recursive-monomorphic callable rows: those rows are the recursive bindings of the textbook ftv(SΓ), so a nested let can never quantify a member's own monomorphic metas."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceLetBindings : (bindings: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferenceLetBindings bindings environment callables state path =
  case head bindings of
    Nothing -> Ok { environment = environment, state = state }
    Just binding ->
      case inferenceInfer binding.value environment callables state (concat path (concat "/" binding.name)) of
        Err e -> Err e
        Ok inferred ->
          let context = concat environment (filter (\row -> eq row.trust "recursive-monomorphic") callables)
          case inferenceGeneralizeChecked inferred.type context inferred.state (concat path (concat "/" binding.name)) of
            Err e -> Err e
            Ok scheme ->
              let env2 = inferencePrependGeneralizedBinding binding.name scheme (inferenceGeneralizedOpaqueReads inferred.type context inferred.state) environment
              inferenceLetBindings (tailOr bindings) env2 callables inferred.state path

@label "Inference where bindings"
@description "Infer SWhere bindings with the same sequential scoped-let semantics as desugaring: each value sees earlier bindings only and is generalized before the next binding."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceWhere : (body: a) -> (bindings: b) -> (environment: c) -> (callables: d) -> (state: e) -> (path: String) -> Result f g
inferenceWhere body bindings environment callables state path =
  case inferenceLetBindings bindings environment callables state path of
    Err e -> Err e
    Ok scoped -> inferenceInfer body scoped.environment callables scoped.state (concat path "/body")

@label "Inference branch join"
@description "Build a canonical output-only branch union: recursively flatten, structurally key, deduplicate, and lexicographically order branches."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceJoin : (left: a) -> (right: b) -> c
inferenceJoin left right =
  inferenceNormalizeUnion (inferenceUnionFlatten [left, right] [])

@label "Inference flatten union branches"
@description "Flatten nested ItUnion values into one branch list before canonicalization."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnionFlatten : (branches: a) -> (acc: b) -> b
inferenceUnionFlatten branches acc =
  case head branches of
    Nothing -> acc
    Just branch ->
      if eq branch.tag "ItUnion"
      then inferenceUnionFlatten (tailOr branches) (inferenceUnionFlatten branch.branches acc)
      else inferenceUnionFlatten (tailOr branches) (appendItem branch acc)

@label "Inference unique union rows"
@description "Deduplicate structurally identical internal types by a stable JSON key emitted from Fenel-owned solver values."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUniqueUnionRows : (branches: a) -> (seen: b) -> c
inferenceUniqueUnionRows branches seen =
  case head branches of
    Nothing -> seen
    Just branch ->
      let key = jsLit branch
      if elem key (map (\row -> row.key) seen)
      then inferenceUniqueUnionRows (tailOr branches) seen
      else inferenceUniqueUnionRows (tailOr branches) (appendItem { key = key, type = branch } seen)

@label "Inference union row by key"
@description "Recover the unique branch paired with a canonical structural key."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnionRowByKey : (key: String) -> (rows: a) -> Maybe a
inferenceUnionRowByKey key rows =
  case head rows of
    Nothing -> Nothing
    Just row -> if eq row.key key then Just row else inferenceUnionRowByKey key (tailOr rows)

@label "Inference union branches from keys"
@description "Rebuild canonical branches from their sorted structural keys."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceUnionBranchesFromKeys : (keys: a) -> (rows: b) -> c
inferenceUnionBranchesFromKeys keys rows =
  case head keys of
    Nothing -> []
    Just key ->
      case inferenceUnionRowByKey key rows of
        Nothing -> inferenceUnionBranchesFromKeys (tailOr keys) rows
        Just row -> inferencePrependItem row.type (inferenceUnionBranchesFromKeys (tailOr keys) rows)

@label "Inference normalize union"
@description "Canonical union normalization used for every branch join; singleton unions collapse to their branch."
@tags "engine" "signature" "inference" "phase-2"
inferenceNormalizeUnion : (branches: a) -> b
inferenceNormalizeUnion branches =
  let rows = inferenceUniqueUnionRows branches []
  let keys = sortLex (map (\row -> row.key) rows)
  let normalized = inferenceUnionBranchesFromKeys keys rows
  case head normalized of
    Nothing -> { tag = "ItVoid", value = true }
    Just first ->
      case head (tailOr normalized) of
        Nothing -> first
        Just second -> { tag = "ItUnion", branches = normalized }

@label "Inference if"
@description "Require a Boolean condition and synthesize the normalized union of both branch outputs."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceIf : (cond: a) -> (thenBranch: b) -> (elseBranch: c) -> (environment: d) -> (callables: e) -> (state: f) -> (path: String) -> Result g h
inferenceIf cond thenBranch elseBranch environment callables state path =
  case inferenceInfer cond environment callables state (concat path "/cond") of
    Err e -> Err e
    Ok inferredCond ->
      let consumedCond = inferenceApply inferredCond.type inferredCond.state
      if inferenceTypeContainsUnion consumedCond then
        inferenceErr "inference.union-consumer" (concat path "/cond") "a union-typed condition requires elimination outside the bounded rank-1 fragment"
      else
        case inferenceUnify consumedCond (inferenceSystemGroundBuiltin "Boolean") inferredCond.state (concat path "/cond") of
          Err e -> Err e
          Ok afterCond ->
            case inferenceInfer thenBranch environment callables afterCond (concat path "/then") of
              Err e -> Err e
              Ok inferredThen ->
                case inferenceInfer elseBranch environment callables inferredThen.state (concat path "/else") of
                  Err e -> Err e
                  Ok inferredElse -> Ok { type = inferenceJoin (inferenceApply inferredThen.type inferredElse.state) (inferenceApply inferredElse.type inferredElse.state), state = inferredElse.state }


-- -------------------------------------------------------------------------
-- Match patterns and the complete surface Syntax walk
-- -------------------------------------------------------------------------

@label "Inference pattern list"
@description "Check constructor sub-patterns against payload parameter types, extending the arm environment."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePatternList : (patterns: a) -> (params: b) -> (environment: c) -> (callables: d) -> (state: e) -> (path: String) -> Result f g
inferencePatternList patterns params environment callables state path =
  if not (eq (length patterns) (length params)) then inferenceErr "inference.pattern-arity" path "constructor pattern arity does not match its semantic payload"
  else
    case head patterns of
      Nothing -> Ok { environment = environment, state = state }
      Just pattern ->
        case head params of
          Nothing -> inferenceErr "inference.pattern-arity" path "constructor pattern has no matching payload"
          Just param ->
            case inferencePattern pattern param.type environment callables state (concat path (concat "/" param.keyToken)) of
              Err e -> Err e
              Ok first -> inferencePatternList (tailOr patterns) (tailOr params) first.environment callables first.state path

@label "Inference pattern field keys unique"
@description "Validate the identity-bearing slots attached to a named constructor pattern before any payload binding is published."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferencePatternFieldKeysUnique : (fields: a) -> (seen: b) -> Boolean
inferencePatternFieldKeysUnique fields seen =
  case head fields of
    Nothing -> true
    Just field ->
      if not (fieldKeyValidWithSourceHandles field.key) then false
      else
        let token = fieldKeyToken field.key
        if elem token seen then false
        else inferencePatternFieldKeysUnique (tailOr fields) (appendItem token seen)

@label "Inference named pattern list"
@description "Check the selected named constructor sub-patterns against payload parameters by semantic FieldKey, never source/wire order. Named record patterns may omit payload fields; every supplied field must still resolve exactly."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceNamedPatternList : (patterns: a) -> (fields: b) -> (params: c) -> (environment: d) -> (callables: e) -> (state: f) -> (path: String) -> Result g h
inferenceNamedPatternList patterns fields params environment callables state path =
  if not (eq (length patterns) (length fields)) then inferenceErr "inference.pattern-field-key" path "named constructor pattern metadata does not align with its arguments"
  else if not (inferencePatternFieldKeysUnique fields []) then inferenceErr "inference.pattern-field-key" path "named constructor pattern contains a malformed or duplicate semantic field key"
  else inferenceNamedPatternListGo patterns fields params environment callables state path

@label "Inference named pattern list go"
@description "Walk an already key-validated named constructor pattern, resolving each supplied payload solely by semantic FieldKey. Omitted constructor fields bind nothing."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceNamedPatternListGo : (patterns: a) -> (fields: b) -> (params: c) -> (environment: d) -> (callables: e) -> (state: f) -> (path: String) -> Result g h
inferenceNamedPatternListGo patterns fields params environment callables state path =
  case head patterns of
    Nothing -> Ok { environment = environment, state = state }
    Just pattern ->
      case head fields of
        Nothing -> inferenceErr "inference.pattern-field-key" path "named constructor pattern is missing semantic field metadata"
        Just field ->
          let token = fieldKeyToken field.key
          case inferenceFindField token params of
            Nothing -> inferenceErr "inference.pattern-field-key" path (concat "constructor payload has no semantic field " token)
            Just param ->
              case inferencePattern pattern param.type environment callables state (concat path (concat "/" token)) of
                Err e -> Err e
                Ok first -> inferenceNamedPatternListGo (tailOr patterns) (tailOr fields) params first.environment callables first.state path

@label "Inference constructor pattern"
@description "Instantiate a constructor scheme, unify its result with the scrutinee, then bind payload patterns."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceConstructorPattern : (ctor: String) -> (patterns: a) -> (scrutinee: b) -> (environment: c) -> (callables: d) -> (state: e) -> (path: String) -> Result f g
inferenceConstructorPattern ctor patterns scrutinee environment callables state path =
  case inferenceResolveValue (concat "$ctor:" ctor) environment callables state (concat path "/ctor") of
    Err e -> Err e
    Ok resolved ->
      let constructorType = inferenceFlattenArrow resolved.type
      if not (eq constructorType.tag "ItArrow") then
        inferenceErr "inference.not-callable" (concat path "/ctor") "constructor pattern resolved to a non-callable scheme"
      else
        case inferenceUnify scrutinee constructorType.returns resolved.state (concat path "/result") of
          Err e -> Err e
          Ok next ->
            let mentioned = if eq (length patterns) (length constructorType.params) then map (\param -> param.wireName) constructorType.params else []
            case inferencePatternObligationFence mentioned constructorType.returns next path of
              Err e -> Err e
              Ok clear -> inferencePatternList patterns constructorType.params environment callables next path

@label "Inference named constructor pattern"
@description "Instantiate a constructor scheme, unify its result, then align every named payload pattern by its resolved semantic FieldKey."
@tags "engine" "internal" "signature" "inference" "field-identity" "phase-2"
@category "engine-internal"
inferenceNamedConstructorPattern : (ctor: String) -> (patterns: a) -> (fields: b) -> (scrutinee: c) -> (environment: d) -> (callables: e) -> (state: f) -> (path: String) -> Result g h
inferenceNamedConstructorPattern ctor patterns fields scrutinee environment callables state path =
  case inferenceResolveValue (concat "$ctor:" ctor) environment callables state (concat path "/ctor") of
    Err e -> Err e
    Ok resolved ->
      let constructorType = inferenceFlattenArrow resolved.type
      if not (eq constructorType.tag "ItArrow") then
        inferenceErr "inference.not-callable" (concat path "/ctor") "constructor pattern resolved to a non-callable scheme"
      else
        case inferenceUnify scrutinee constructorType.returns resolved.state (concat path "/result") of
          Err e -> Err e
          Ok next ->
            case inferencePatternObligationFence (inferenceNamedPatternFieldNames patterns fields constructorType.params) constructorType.returns next path of
              Err e -> Err e
              Ok clear -> inferenceNamedPatternList patterns fields constructorType.params environment callables next path

@label "Inference named pattern field names"
@description "The wire names of the constructor payload fields a well-formed named constructor pattern mentions (each selected by its semantic FieldKey). A malformed pattern mentions none here; inferenceNamedPatternList reports it."
@tags "engine" "internal" "signature" "inference" "field-identity" "modules-as-values"
@category "engine-internal"
inferenceNamedPatternFieldNames : (patterns: a) -> (fields: b) -> (params: c) -> d
inferenceNamedPatternFieldNames patterns fields params =
  if not (eq (length patterns) (length fields)) then []
  else if not (inferencePatternFieldKeysUnique fields []) then []
  else
    fold
      (\names field ->
        case inferenceFindField (fieldKeyToken field.key) params of
          Nothing -> names
          Just param -> appendItem param.wireName names)
      []
      fields

@label "Inference pattern obligation fence"
@description "modules-as-values Phase 5a — a constructor pattern types its fields from the constructor's parameters, laws and superclass fields included, but a value of the type need not carry an erased obligation (a named instance's value never does), and the match reads every field the pattern mentions. So a pattern mentioning a field that the scrutinee owner's declaration row lists as an obligation (the check inferenceDeclarationFieldType applies to projection) fences, named or positional. Without a declaration row in the state, nothing changes."
@tags "engine" "internal" "signature" "inference" "projection" "modules-as-values"
@category "engine-internal"
inferencePatternObligationFence : (fieldNames: a) -> (result: b) -> (state: c) -> (path: String) -> Result Boolean d
inferencePatternObligationFence fieldNames result state path =
  let owner = inferenceApply result state
  let nominal = if eq owner.tag "ItApp" then owner.head else owner
  if not (eq nominal.tag "ItNamed") then Ok true
  else
    let declarations = filter (\declaration -> eq declaration.ownerIdentity nominal.name) state.declarations
    let erased = filter (\name -> gt (length (filter (\declaration -> elem name declaration.obligations) declarations)) 0) fieldNames
    case head erased of
      Nothing -> Ok true
      Just name -> inferenceErr "inference.record-projection" path (concat "the constructor pattern reads the field " (concat name (concat " of " (concat nominal.publicName ", which its declaration lists as an erased obligation (a law or superclass field): a value of the type need not carry it, so the pattern's bindings are unknown"))))

@label "Inference pattern"
@description "Infer/check the four Pattern cases and return the arm-local environment."
@tags "engine" "signature" "inference" "phase-2"
inferencePattern : (pattern: (Pattern Any)) -> (scrutinee: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferencePattern pattern scrutinee environment callables state path =
  let consumedScrutinee = inferenceApply scrutinee state
  if inferenceTypeContainsUnion consumedScrutinee then
    inferenceErr "inference.union-consumer" path "a union-typed match scrutinee requires elimination outside the bounded rank-1 fragment"
  else
    case pattern of
      PatWildcard -> Ok { environment = environment, state = state }
      PatVar { name = name } -> Ok { environment = inferencePrependBinding name (inferenceMonoScheme consumedScrutinee) true environment, state = state }
      PatLit { value = value } ->
        if and (isString value) (eq value "_") then Ok { environment = environment, state = state }
        else
          case inferenceLiteral value state path of
            Err e -> Err e
            Ok literal ->
              case inferenceUnify consumedScrutinee literal.type literal.state path of
                Err e -> Err e
                Ok next -> Ok { environment = environment, state = next }
      PatConstruct { ctor = ctor, args = args, fields = fields } -> inferenceNamedConstructorPattern ctor args fields consumedScrutinee environment callables state path
      PatConstruct { ctor = ctor, args = args } -> inferenceConstructorPattern ctor args consumedScrutinee environment callables state path

@label "Inference optional match guard"
@description "Infer an optional arm guard and require Boolean when present."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceMatchGuard : (guard: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferenceMatchGuard guard environment callables state path =
  if isNull guard then Ok state
  else
    case inferenceInfer guard environment callables state path of
      Err e -> Err e
      Ok inferred ->
        let consumedGuard = inferenceApply inferred.type inferred.state
        if inferenceTypeContainsUnion consumedGuard
        then inferenceErr "inference.union-consumer" path "a union-typed match guard requires elimination outside the bounded rank-1 fragment"
        else inferenceUnify consumedGuard (inferenceSystemGroundBuiltin "Boolean") inferred.state path

@label "Inference match arms"
@description "Infer every reachable arm under pattern bindings and join branch outputs as an output-only union."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceMatchArms : (arms: a) -> (scrutinee: b) -> (environment: c) -> (callables: d) -> (state: e) -> (path: String) -> Result f g
inferenceMatchArms arms scrutinee environment callables state path =
  case head arms of
    Nothing -> inferenceErr "inference.empty-match" path "an empty match has no inferable result"
    Just arm ->
      case inferencePattern arm.pattern scrutinee environment callables state (concat path "/pattern") of
        Err e -> Err e
        Ok patterned ->
          case inferenceMatchGuard arm.guard patterned.environment callables patterned.state (concat path "/guard") of
            Err e -> Err e
            Ok guarded ->
              case inferenceInfer arm.body patterned.environment callables guarded (concat path "/body") of
                Err e -> Err e
                Ok body ->
                  case head (tailOr arms) of
                    Nothing -> Ok body
                    Just nextArm ->
                      case inferenceMatchArms (tailOr arms) scrutinee environment callables body.state path of
                        Err e -> Err e
                        Ok rest -> Ok { type = inferenceJoin (inferenceApply body.type rest.state) (inferenceApply rest.type rest.state), state = rest.state }

@label "Inference match"
@description "Infer the scrutinee, pattern environments, guards, and output union of a surface match."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceMatch : (scrutinee: a) -> (arms: b) -> (environment: c) -> (callables: d) -> (state: e) -> (path: String) -> Result f g
inferenceMatch scrutinee arms environment callables state path =
  case inferenceInfer scrutinee environment callables state (concat path "/scrutinee") of
    Err e -> Err e
    Ok inferred ->
      let consumedScrutinee = inferenceApply inferred.type inferred.state
      if inferenceTypeContainsUnion consumedScrutinee
      then inferenceErr "inference.union-consumer" (concat path "/scrutinee") "a union-typed match scrutinee requires elimination outside the bounded rank-1 fragment"
      else inferenceMatchArms arms consumedScrutinee environment callables inferred.state (concat path "/arms")


-- -------------------------------------------------------------------------
-- Exact surface call graph (registry resolution is supplied as data)
-- -------------------------------------------------------------------------

@label "Inference add unique name"
@description "Append one canonical target id once while retaining deterministic first occurrence."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAddUniqueName : (name: String) -> (names: a) -> a
inferenceAddUniqueName name names = if elem name names then names else appendItem name names

@label "Inference add bound names"
@description "Extend a lexical-name set without relying on host map insertion order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAddBoundNames : (names: a) -> (bound: b) -> b
inferenceAddBoundNames names bound =
  case head names of
    Nothing -> bound
    Just name -> inferenceAddBoundNames (tailOr names) (inferenceAddUniqueName name bound)

@label "Inference pattern bound names"
@description "Collect every lexical binder introduced by a Pattern."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePatternBoundNames : (pattern: (Pattern Any)) -> (acc: a) -> a
inferencePatternBoundNames pattern acc =
  case pattern of
    PatWildcard -> acc
    PatLit { value = _ } -> acc
    PatVar { name = name } -> inferenceAddUniqueName name acc
    PatConstruct { args = args } -> inferencePatternListBoundNames args acc

@label "Inference pattern-list bound names"
@description "Collect binders from constructor sub-patterns."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePatternListBoundNames : (patterns: a) -> (acc: b) -> b
inferencePatternListBoundNames patterns acc =
  case head patterns of
    Nothing -> acc
    Just pattern -> inferencePatternListBoundNames (tailOr patterns) (inferencePatternBoundNames pattern acc)

@label "Inference pattern constructor references"
@description "Collect constructor-namespace references from one Pattern while recursively visiting its payload patterns."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePatternReferences : (pattern: (Pattern Any)) -> (resolutions: a) -> (targets: b) -> b
inferencePatternReferences pattern resolutions targets =
  case pattern of
    PatWildcard -> targets
    PatLit { value = _ } -> targets
    PatVar { name = _ } -> targets
    PatConstruct { ctor = ctor, args = args } ->
      let withCtor = inferenceCollectResolvedReference (concat "$ctor:" ctor) [] resolutions targets
      inferencePatternListReferences args resolutions withCtor

@label "Inference pattern-list constructor references"
@description "Collect constructor-namespace references from nested Pattern payloads."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePatternListReferences : (patterns: a) -> (resolutions: b) -> (targets: c) -> c
inferencePatternListReferences patterns resolutions targets =
  case head patterns of
    Nothing -> targets
    Just pattern -> inferencePatternListReferences (tailOr patterns) resolutions (inferencePatternReferences pattern resolutions targets)

@label "Inference resolution lookup"
@description "Resolve one source spelling through the registry-authored exact routing rows."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceResolutionLookup : (name: String) -> (rows: a) -> Maybe a
inferenceResolutionLookup name rows =
  case head rows of
    Nothing -> Nothing
    Just row -> if eq row.name name then Just row else inferenceResolutionLookup name (tailOr rows)

@label "Inference collect resolved reference"
@description "Record a canonical call-graph target for an unbound value/call spelling; unresolved or ambiguous rows are left for the inference diagnostic path."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCollectResolvedReference : (name: String) -> (bound: a) -> (resolutions: b) -> (targets: c) -> c
inferenceCollectResolvedReference name bound resolutions targets =
  let localName = if eq (slice name 0 5) "$dyn:" then slice name 5 (length name) else name
  if inferenceLexicalSpellingBound localName bound then targets
  else
    case head resolutions of
      Just mode ->
        if eq mode.status "collect" then inferenceAddUniqueName localName targets
        else
          case inferenceResolutionLookup localName resolutions of
            Nothing -> targets
            Just row -> if eq row.status "resolved" then inferenceAddUniqueName row.targetId targets else targets
      Nothing -> targets

@label "Inference calls in Syntax list"
@description "Surface call-graph fold over a Syntax list."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCallsInList : (nodes: a) -> (bound: b) -> (resolutions: c) -> (targets: d) -> d
inferenceCallsInList nodes bound resolutions targets =
  case head nodes of
    Nothing -> targets
    Just node -> inferenceCallsInList (tailOr nodes) bound resolutions (inferenceCallsIn node bound resolutions targets)

@label "Inference calls in record fields"
@description "Collect graph edges from every SRecord field value."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCallsInFields : (fields: a) -> (bound: b) -> (resolutions: c) -> (targets: d) -> d
inferenceCallsInFields fields bound resolutions targets =
  case head fields of
    Nothing -> targets
    Just field -> inferenceCallsInFields (tailOr fields) bound resolutions (inferenceCallsIn field.value bound resolutions targets)

@label "Inference calls in let bindings"
@description "Collect a sequential SLet graph: each initializer sees only earlier binders; the returned bound set includes every binding."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCallsInLetBindings : (bindings: a) -> (bound: b) -> (resolutions: c) -> (targets: d) -> e
inferenceCallsInLetBindings bindings bound resolutions targets =
  case head bindings of
    Nothing -> { bound = bound, targets = targets }
    Just binding ->
      let nextTargets = inferenceCallsIn binding.value bound resolutions targets
      let nextBound = inferenceAddUniqueName binding.name bound
      inferenceCallsInLetBindings (tailOr bindings) nextBound resolutions nextTargets

@label "Inference calls in match arms"
@description "Collect graph edges under each arm's pattern binders and optional guard."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCallsInMatchArms : (arms: a) -> (bound: b) -> (resolutions: c) -> (targets: d) -> d
inferenceCallsInMatchArms arms bound resolutions targets =
  case head arms of
    Nothing -> targets
    Just arm ->
      let armBound = inferencePatternBoundNames arm.pattern bound
      let patternTargets = inferencePatternReferences arm.pattern resolutions targets
      let guarded = if isNull arm.guard then patternTargets else inferenceCallsIn arm.guard armBound resolutions patternTargets
      let bodyTargets = inferenceCallsIn arm.body armBound resolutions guarded
      inferenceCallsInMatchArms (tailOr arms) bound resolutions bodyTargets

@label "Inference synthetic list call"
@description "Recognize exactly a marked appendItem chain that collectList lowers to a list literal, with no identity-head override taking precedence. The existing serializer owns that shape judgment; the marker supplies no type evidence by itself. Genuine calls retain their scoped lookup."
@tags "engine" "internal" "signature" "inference"
@category "engine-internal"
inferenceSyntheticListCall : (node: a) -> (name: String) -> Boolean
inferenceSyntheticListCall node name =
  if and (eq name "appendItem") (and (eq node.lit true) (not (eq node.identityHead.identity true))) then
    case collectList node of
      Just items -> true
      Nothing -> false
  else false

@label "Inference calls in surface Syntax"
@description "Exact, lexical-scope-aware call/reference walk over all surface Syntax cases; registry rows contribute canonical target ids."
@tags "engine" "signature" "inference" "phase-2"
inferenceCallsIn : (node: (Syntax Any)) -> (bound: a) -> (resolutions: b) -> (targets: c) -> c
inferenceCallsIn node bound resolutions targets =
  case node of
    SLit { value = v } ->
      -- A non-empty pureData list is typed through std.appendItem, as its chain was.
      if and (eq node.pureData true) (and (isArray v) (lt 0 (length v)))
      then inferenceCollectResolvedReference "std.appendItem" [] resolutions targets
      else targets
    SVar { name = name } ->
      if eq node.identity true then inferenceCollectResolvedReference (concat "$identity:" name) [] resolutions targets
      else inferenceCollectResolvedReference name bound resolutions targets
    SCall { fnId = name, args = args } ->
      let literal = inferenceSyntheticListCall node name
      let withHead = inferenceCollectResolvedReference (if literal then "std.appendItem" else name) (if literal then [] else bound) resolutions targets
      inferenceCallsInList args bound resolutions withHead
    SLambda { params = params, body = body } -> inferenceCallsIn body (inferenceAddBoundNames params bound) resolutions targets
    SMatch { scrutinee = scrutinee, arms = arms } ->
      let first = inferenceCallsIn scrutinee bound resolutions targets
      inferenceCallsInMatchArms arms bound resolutions first
    SConstruct { ctor = ctor, args = args } ->
      let withHead = inferenceCollectResolvedReference (concat "$ctor:" ctor) [] resolutions targets
      inferenceCallsInList args bound resolutions withHead
    SRecord { fields = fields } -> inferenceCallsInFields fields bound resolutions targets
    SIf { cond = cond, then = thenBranch, else = elseBranch } ->
      let first = inferenceCallsIn cond bound resolutions targets
      let second = inferenceCallsIn thenBranch bound resolutions first
      inferenceCallsIn elseBranch bound resolutions second
    SLet { bindings = bindings, body = body } ->
      let bindingsResult = inferenceCallsInLetBindings bindings bound resolutions targets
      inferenceCallsIn body bindingsResult.bound resolutions bindingsResult.targets
    SDo { exprs = exprs } -> inferenceCallsInList exprs bound resolutions targets
    SOp { op = op, operands = operands } ->
      let withHead = inferenceCollectResolvedReference op bound resolutions targets
      inferenceCallsInList operands bound resolutions withHead
    SWhere { body = body, bindings = bindings } ->
      let bindingsResult = inferenceCallsInLetBindings bindings bound resolutions targets
      inferenceCallsIn body bindingsResult.bound resolutions bindingsResult.targets
    SMethod { cls = cls, method = method, args = args } ->
      let withHead = inferenceCollectResolvedReference (concat cls (concat "." method)) [] resolutions targets
      inferenceCallsInList args bound resolutions withHead
    -- SAnn (modules-as-values Phase 2d): a type annotation adds no call edge —
    -- its written type names types, not callables; walk the expression.
    SAnn { expr = expr } -> inferenceCallsIn expr bound resolutions targets

@label "Inference top-level candidate callees"
@description "Compute canonical callees for one top-level body, starting with its parameter binders."
@tags "engine" "signature" "inference" "phase-2"
inferenceCandidateCallees : (candidate: a) -> (resolutions: b) -> c
inferenceCandidateCallees candidate resolutions =
  let exact = if isNull candidate.resolutions then resolutions else candidate.resolutions
  inferenceCallsIn candidate.body candidate.paramNames exact []

@label "Inference surface references"
@description "Public descriptor-boundary helper returning the lexical-scope-aware external spellings needed from an authoring resolver."
@tags "engine" "signature" "inference" "phase-2"
inferenceSurfaceReferences : (syntax: (Syntax Any)) -> a
inferenceSurfaceReferences syntax =
  inferenceCallsIn syntax [] [{ name = "*", targetId = "", status = "collect" }] []

@label "Inference pattern reference rows"
@description "Project constructor-namespace references to separate callable and resolver spellings for the descriptor-only authoring bridge."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePatternReferenceRows : (references: a) -> b
inferencePatternReferenceRows references =
  map (\reference -> {
    name = reference,
    lookupName = slice reference 6 (length reference)
  }) references

@label "Inference match-arm pattern references"
@description "Collect constructor-namespace references from every arm pattern of one match expression."
@tags "engine" "internal" "signature" "inference" "authoring" "phase-2"
@category "engine-internal"
inferenceMatchArmPatternReferences : (arms: a) -> (resolutions: b) -> (targets: c) -> c
inferenceMatchArmPatternReferences arms resolutions targets =
  case head arms of
    Nothing -> targets
    Just arm ->
      let current = inferencePatternReferences arm.pattern resolutions targets
      inferenceMatchArmPatternReferences (tailOr arms) resolutions current

@label "Inference match pattern references"
@description "Public authoring-boundary projection of the exact constructor spellings needed by every arm of a converted match; unsupported surface patterns require no host lookup."
@tags "engine" "signature" "inference" "authoring" "phase-2"
inferenceMatchPatternReferences : (surfaceResult: a) -> b
inferenceMatchPatternReferences surfaceResult =
  case surfaceResult of
    Err e -> []
    Ok syntax ->
      case syntax of
        SMatch { arms = arms } ->
          let references = inferenceMatchArmPatternReferences arms [{ name = "*", targetId = "", status = "collect" }] []
          inferencePatternReferenceRows references
        other -> []

@label "Inference top-level match scrutinee"
@description "Expose only a top-level match scrutinee Syntax node so the descriptor boundary can ask the Fenel solver for its exact nominal owner before resolving colliding arm constructors."
@tags "engine" "signature" "inference" "authoring" "phase-2"
inferenceTopLevelMatchScrutinee : (syntax: (Syntax Any)) -> Maybe (Syntax Any)
inferenceTopLevelMatchScrutinee syntax =
  case syntax of
    SMatch { scrutinee = scrutinee } -> Just scrutinee
    other -> Nothing

@label "Inference SCC name index"
@description "Build a hostile-key-safe constant-time membership index for canonical graph node ids."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccNameIndex : (names: a) -> b
inferenceSccNameIndex names =
  fromEntries (map (\name -> { key = name, value = true }) names)

@label "Inference SCC index contains"
@description "Read one canonical graph id from an opaque null-prototype index."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccIndexContains : (index: a) -> (name: String) -> Boolean
inferenceSccIndexContains index name =
  case mapGet index name of
    Nothing -> false
    Just present -> true

@label "Inference SCC direct rows"
@description "Project each candidate's already-resolved callees to the internal candidate graph; external sinks cannot participate in mutual reachability."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccDirectRows : (candidates: a) -> (candidateIndex: b) -> c
inferenceSccDirectRows candidates candidateIndex =
  map
    (\candidate -> {
      id = candidate.id,
      direct = filter (\target -> inferenceSccIndexContains candidateIndex target) candidate.callees
    })
    candidates

@label "Inference SCC open reach row"
@description "Seed one source's exact reachability frontier from its direct internal callees."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccOpenReachRow : (row: a) -> b
inferenceSccOpenReachRow row = {
  id = row.id,
  seen = row.direct,
  seenIndex = inferenceSccNameIndex row.direct,
  frontier = row.direct
}

@label "Inference SCC advance reach row"
@description "Advance one source by one graph layer, expanding only its fresh frontier through the immutable direct-adjacency index."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccAdvanceReachRow : (row: a) -> (directIndex: b) -> c
inferenceSccAdvanceReachRow row directIndex =
  let expanded =
        flatMap
          (\target ->
            case mapGet directIndex target of
              Nothing -> []
              Just directRow -> directRow.direct)
          row.frontier
  let expandedIndex = inferenceSccNameIndex expanded
  let expandedNames = map (\entry -> entry.key) (entries expandedIndex)
  let frontier = filter (\target -> not (inferenceSccIndexContains row.seenIndex target)) expandedNames
  let seen = concat row.seen frontier
  { id = row.id, seen = seen, seenIndex = inferenceSccNameIndex seen, frontier = frontier }

@label "Inference SCC frontier active"
@description "Whether any source still has a fresh reachability layer to expand."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccFrontierActive : (rows: a) -> Boolean
inferenceSccFrontierActive rows =
  fold (\active row -> if active then true else gt (length row.frontier) 0) false rows

@label "Inference SCC close reach rows"
@description "Compute exact transitive reachability with a node-count-bounded native fold; every source expands each reachable node at most once."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccCloseReachRows : (directRows: a) -> b
inferenceSccCloseReachRows directRows =
  let directIndex = fromEntries (map (\row -> { key = row.id, value = row }) directRows)
  let opened = map inferenceSccOpenReachRow directRows
  let closed =
        fold
          (\state _tick ->
            if state.done then state
            else
              let rows = map (\row -> inferenceSccAdvanceReachRow row directIndex) state.rows
              { rows = rows, done = not (inferenceSccFrontierActive rows) })
          { rows = opened, done = not (inferenceSccFrontierActive opened) }
          directRows
  closed.rows

@label "Inference SCC indexed mutual reachability"
@description "Two candidate ids share an SCC exactly when identical or mutually present in the closed per-source reachability indexes."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccSameIndexed : (left: String) -> (right: String) -> (rowIndex: a) -> Boolean
inferenceSccSameIndexed left right rowIndex =
  if eq left right then true
  else
    case mapGet rowIndex left of
      Nothing -> false
      Just leftRow ->
        if not (inferenceSccIndexContains leftRow.seenIndex right) then false
        else
          case mapGet rowIndex right of
            Nothing -> false
            Just rightRow -> inferenceSccIndexContains rightRow.seenIndex left

@label "Inference SCC indexed groups"
@description "Emit SCCs by first unassigned candidate and retain member order, byte-identical to the prior mutual-reachability grouping law."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccIndexedGroups : (candidates: a) -> (closedRows: b) -> c
inferenceSccIndexedGroups candidates closedRows =
  let rowIndex = fromEntries (map (\row -> { key = row.id, value = row }) closedRows)
  let partitioned =
        fold
          (\state candidate ->
            if elem candidate.id state.assigned then state
            else
              let members = filter (\member -> inferenceSccSameIndexed candidate.id member.id rowIndex) candidates
              { groups = appendItem members state.groups, assigned = concat (inferenceCandidateIds members) state.assigned })
          { groups = [], assigned = [] }
          candidates
  partitioned.groups

@label "Inference top-level SCC partition"
@description "Partition the exact cached surface-call graph through shallow indexed reachability or bounded linked DFS, preserving the same candidate-order grouping law."
@tags "engine" "signature" "inference" "phase-2"
inferenceTopLevelSccPartition : (candidates: a) -> (resolutions: b) -> c
inferenceTopLevelSccPartition candidates resolutions =
  let roots = inferenceCandidateIds candidates
  let candidateIndex = inferenceSccNameIndex roots
  let directRows = inferenceSccDirectRows candidates candidateIndex
  inferenceSccAdaptivePartitionFromRows roots directRows candidates


InferenceSccWalkFrame = InferenceSccWalkFrame id: String next: Number rest: Maybe InferenceSccWalkFrame

InferenceSccWalkState = InferenceSccWalkState rootOffset: Number stack: Maybe InferenceSccWalkFrame visited: Map String String finished: List String component: String

@label "Inference SCC walk step"
@description "Advance one explicit DFS frame or root. Linked frames retain adjacency cursors, so no recursive host frame or all-source reachability table is required."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccWalkStep : (graph: Map String (List String)) -> (roots: List String) -> (retainFinishes: Boolean) -> (state: InferenceSccWalkState) -> InferenceSccWalkState
inferenceSccWalkStep graph roots retainFinishes state =
  case state.stack of
    Nothing ->
      if lt state.rootOffset (length roots) then
        let root = at roots state.rootOffset
        let nextRoot = add state.rootOffset 1
        if inferenceSccIndexContains state.visited root then
          InferenceSccWalkState { rootOffset = nextRoot, stack = Nothing, visited = state.visited, finished = state.finished, component = state.component }
        else
          InferenceSccWalkState { rootOffset = nextRoot,
            stack = Just (InferenceSccWalkFrame { id = root, next = 0, rest = Nothing }),
            visited = mapSet state.visited root root,
            finished = state.finished,
            component = root
          }
      else state
    Just frame ->
      let neighbors = fromMaybe [] (mapGet graph (concat "scc/" frame.id))
      if lt frame.next (length neighbors) then
        let target = at neighbors frame.next
        let advanced = Just (InferenceSccWalkFrame { id = frame.id, next = add frame.next 1, rest = frame.rest })
        if inferenceSccIndexContains state.visited target then
          InferenceSccWalkState { rootOffset = state.rootOffset, stack = advanced, visited = state.visited, finished = state.finished, component = state.component }
        else
          InferenceSccWalkState { rootOffset = state.rootOffset,
            stack = Just (InferenceSccWalkFrame { id = target, next = 0, rest = advanced }),
            visited = mapSet state.visited target state.component,
            finished = state.finished,
            component = state.component
          }
      else
        InferenceSccWalkState { rootOffset = state.rootOffset,
          stack = frame.rest,
          visited = state.visited,
          finished = if retainFinishes then inferencePrependItem frame.id state.finished else state.finished,
          component = state.component
        }

@label "Inference SCC bounded walk"
@description "Run DFS through a native fold bounded by root visits, node exits and edge advances. Immutable map writes still copy; this is not a linear-time representation claim."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccWalk : (graph: Map String (List String)) -> (roots: List String) -> (ticks: List Boolean) -> (retainFinishes: Boolean) -> InferenceSccWalkState
inferenceSccWalk graph roots ticks retainFinishes =
  fold
    (\state _tick -> inferenceSccWalkStep graph roots retainFinishes state)
    (InferenceSccWalkState { rootOffset = 0, stack = Nothing, visited = fromEntries [], finished = [], component = "" })
    ticks

@label "Inference SCC walk component key"
@description "Project an injective prefixed group key for the second DFS pass's component representative. The prefix also keeps groupBy's host-record representation away from prototype spellings."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccWalkComponentKey : (components: Map String String) -> (candidateId: String) -> String
inferenceSccWalkComponentKey components candidateId =
  concat "scc/" (fromMaybe candidateId (mapGet components candidateId))

@label "Inference SCC ordered walk groups"
@description "Group original candidate values by component and emit groups at their first original occurrence. Numeric and prototype-like ids cannot reorder groups or discard duplicate candidates."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccOrderedWalkGroups : (ids: List String) -> (candidates: List a) -> (components: Map String String) -> List (List a)
inferenceSccOrderedWalkGroups ids candidates components =
  let rows = zipWith (\id value -> { id = id, value = value }) ids candidates
  let grouped = groupBy (\row -> inferenceSccWalkComponentKey components row.id) rows
  let emitGroup = \state row ->
        if inferenceSccIndexContains state.seen (inferenceSccWalkComponentKey components row.id) then state
        else
          { seen = mapSet state.seen (inferenceSccWalkComponentKey components row.id) true,
            groups = appendItem (fromMaybe [] (mapGet grouped (inferenceSccWalkComponentKey components row.id))) state.groups
          }
  let emitted = fold emitGroup { seen = fromEntries [], groups = [] } rows
  map (\group -> map (\row -> row.value) group) emitted.groups

@label "Inference SCC walk partition from rows"
@description "Reuse an already prepared internal adjacency roster in the two-pass DFS partition. Original candidate values remain parametric and ordered."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccWalkPartitionFromRows : (roots: List String) -> (directRows: List ({ id: String, direct: List String })) -> (candidates: List a) -> List (List a)
inferenceSccWalkPartitionFromRows roots directRows candidates =
  let directIndex = fromEntries (map (\row -> { key = row.id, value = row }) directRows)
  let graph = fromEntries (map (\entry -> { key = concat "scc/" entry.key, value = entry.value.direct }) (entries directIndex))
  let edges = flatMap (\entry -> map (\target -> { from = entry.key, to = target }) entry.value.direct) (entries directIndex)
  let reversed = groupBy (\edge -> concat "scc/" edge.to) edges
  let reverseGraph = fromEntries (map (\entry -> { key = entry.key, value = map (\edge -> edge.from) entry.value }) (entries reversed))
  let nodeTicks = map (\_candidate -> true) candidates
  let ticks = concat nodeTicks (concat nodeTicks (map (\_edge -> true) edges))
  let forward = inferenceSccWalk graph roots ticks true
  let backward = inferenceSccWalk reverseGraph forward.finished ticks false
  inferenceSccOrderedWalkGroups roots candidates backward.visited

@label "Inference SCC shallow reach rows"
@description "Probe at most two existing reachability layers. A done result carries the complete current closure; an unfinished result is used only to select the exact DFS algorithm."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccShallowReachRows : (directRows: List ({ id: String, direct: List String })) -> { done: Boolean, rows: List ({ id: String, seen: List String, seenIndex: Map String Boolean, frontier: List String }) }
inferenceSccShallowReachRows directRows =
  let directIndex = fromEntries (map (\row -> { key = row.id, value = row }) directRows)
  let opened = map inferenceSccOpenReachRow directRows
  let advance = \state _tick ->
        if state.done then state
        else
          let rows = map (\row -> inferenceSccAdvanceReachRow row directIndex) state.rows
          { rows = rows, done = not (inferenceSccFrontierActive rows) }
  fold advance { rows = opened, done = not (inferenceSccFrontierActive opened) } [true, true]

@label "Inference adaptive SCC partition from rows"
@description "Keep the current partition for at most four candidates. Larger graphs retain existing grouping when their exact closure finishes within two reach layers; otherwise bounded DFS partitions the same prepared graph with the existing group/member order."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSccAdaptivePartitionFromRows : (roots: List String) -> (directRows: List ({ id: String, direct: List String })) -> (candidates: List a) -> List (List a)
inferenceSccAdaptivePartitionFromRows roots directRows candidates =
  if lte (length roots) 4 then inferenceSccIndexedGroups candidates (inferenceSccCloseReachRows directRows)
  else
    let closed = inferenceSccShallowReachRows directRows
    if closed.done then inferenceSccIndexedGroups candidates closed.rows
    else inferenceSccWalkPartitionFromRows roots directRows candidates


-- -------------------------------------------------------------------------
-- Top-level/SCC constraint planning and atomic publication
-- -------------------------------------------------------------------------

@label "Inference candidate ids"
@description "Project deterministic canonical ids from a candidate list."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCandidateIds : (candidates: a) -> b
inferenceCandidateIds candidates =
  map (\candidate -> candidate.id) candidates

@label "Inference group contains id"
@description "Test canonical membership in an SCC group."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceGroupContainsId : (id: String) -> (group: a) -> Boolean
inferenceGroupContainsId id group = elem id (inferenceCandidateIds group)

@label "Inference published lookup"
@description "Find an atomically published top-level scheme by canonical function id."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePublishedLookup : (id: String) -> (published: a) -> Maybe a
inferencePublishedLookup id published =
  fold
    (\found row ->
      case found of
        Just existing -> Just existing
        Nothing -> if eq row.id id then Just row else Nothing)
    Nothing
    published

@label "Inference dependency targets ready"
@description "A target is ready when external, in the current SCC, or already atomically published."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceDependencyTargetsReady : (targets: a) -> (candidateIds: b) -> (group: c) -> (published: d) -> Boolean
inferenceDependencyTargetsReady targets candidateIds group published =
  case head targets of
    Nothing -> true
    Just target ->
      let internal = elem target candidateIds
      let inGroup = inferenceGroupContainsId target group
      let already = inferencePublishedLookup target published
      let thisReady = if not internal then true else if inGroup then true else case already of Nothing -> false; Just row -> true
      if thisReady then inferenceDependencyTargetsReady (tailOr targets) candidateIds group published else false

@label "Inference candidate dependencies ready"
@description "Check every canonical dependency of one candidate against the current publication frontier."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCandidateDependenciesReady : (candidate: a) -> (candidateIds: b) -> (group: c) -> (published: d) -> (resolutions: e) -> Boolean
inferenceCandidateDependenciesReady candidate candidateIds group published resolutions =
  inferenceDependencyTargetsReady candidate.callees candidateIds group published

@label "Inference SCC dependencies ready loop"
@description "Check each remaining member against the complete SCC. Keeping wholeGroup fixed is load-bearing for mutual recursion: shrinking the membership group with the iteration tail would misclassify a back-edge as an unpublished outside dependency."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceGroupDependenciesReadyGo : (remaining: a) -> (wholeGroup: b) -> (candidateIds: c) -> (published: d) -> (resolutions: e) -> Boolean
inferenceGroupDependenciesReadyGo remaining wholeGroup candidateIds published resolutions =
  case head remaining of
    Nothing -> true
    Just candidate ->
      if inferenceCandidateDependenciesReady candidate candidateIds wholeGroup published resolutions
      then inferenceGroupDependenciesReadyGo (tailOr remaining) wholeGroup candidateIds published resolutions
      else false

@label "Inference SCC dependencies ready"
@description "An SCC is schedulable only after every outside inferred dependency has a generalized published scheme."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceGroupDependenciesReady : (group: a) -> (candidateIds: b) -> (published: c) -> (resolutions: d) -> Boolean
inferenceGroupDependenciesReady group candidateIds published resolutions =
  inferenceGroupDependenciesReadyGo group group candidateIds published resolutions

@label "Inference pick ready SCC"
@description "Pick the first dependency-ready SCC and return it with the remaining groups; sorted input makes the choice canonical."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePickReadyGroup : (groups: a) -> (candidateIds: b) -> (published: c) -> (resolutions: d) -> Maybe e
inferencePickReadyGroup groups candidateIds published resolutions =
  case head groups of
    Nothing -> Nothing
    Just group ->
      if inferenceGroupDependenciesReady group candidateIds published resolutions
      then Just { group = group, rest = tailOr groups }
      else
        case inferencePickReadyGroup (tailOr groups) candidateIds published resolutions of
          Nothing -> Nothing
          Just picked -> Just { group = picked.group, rest = inferencePrependItem group picked.rest }

@label "Inference host compatibility binder"
@description "Add one free host-spec TtVar as a deterministic KType SchemeVar. Lexically bound mu variables and prior structural occurrences do not create binders."
@tags "engine" "internal" "signature" "inference" "binding" "phase-2"
@category "engine-internal"
inferenceHostAddBinder : (name: String) -> (boundMu: a) -> (quantified: b) -> b
inferenceHostAddBinder name boundMu quantified =
  if or (elem name boundMu) (elem name (map (\variable -> variable.sourceName) quantified))
  then quantified
  else appendItem (SchemeVar { id = concat "q" (toString (length quantified)), sourceName = name, kind = KType }) quantified

@label "Inference host traversal field lookup"
@description "Lookup a raw traversal field by its canonical semantic FieldKey token."
@tags "engine" "internal" "signature" "inference" "binding" "field-identity" "phase-2"
@category "engine-internal"
inferenceHostTraversalFieldByToken : (token: String) -> (fields: a) -> Maybe a
inferenceHostTraversalFieldByToken token fields =
  case head fields of
    Nothing -> Nothing
    Just field ->
      if eq (fieldKeyToken field.semanticKey) token then Just field
      else inferenceHostTraversalFieldByToken token (tailOr fields)

@label "Inference host traversal case lookup"
@description "Lookup a raw traversal variant case by constructor name."
@tags "engine" "internal" "signature" "inference" "binding" "phase-2"
@category "engine-internal"
inferenceHostTraversalCaseByName : (name: String) -> (cases: a) -> Maybe a
inferenceHostTraversalCaseByName name cases =
  case head cases of
    Nothing -> Nothing
    Just variantCase ->
      if eq variantCase.name name then Just variantCase
      else inferenceHostTraversalCaseByName name (tailOr cases)

@label "Inference host binder traversal list"
@description "Collect host compatibility binders through an ordered list of TraversalType children."
@tags "engine" "internal" "signature" "inference" "binding" "phase-2"
@category "engine-internal"
inferenceHostCollectTypes : (types: a) -> (boundMu: b) -> (quantified: c) -> (path: String) -> Result c d
inferenceHostCollectTypes types boundMu quantified path =
  case head types of
    Nothing -> Ok quantified
    Just type ->
      case inferenceHostCollectTraversal type boundMu quantified path of
        Err e -> Err e
        Ok next -> inferenceHostCollectTypes (tailOr types) boundMu next path

@label "Inference host binder fields in calling order"
@description "Collect binders through arrow parameters in their already-flattened calling order."
@tags "engine" "internal" "signature" "inference" "binding" "phase-2"
@category "engine-internal"
inferenceHostCollectArrowFields : (fields: a) -> (boundMu: b) -> (quantified: c) -> (path: String) -> Result c d
inferenceHostCollectArrowFields fields boundMu quantified path =
  case head fields of
    Nothing -> Ok quantified
    Just field ->
      case inferenceHostCollectTraversal field.type boundMu quantified path of
        Err e -> Err e
        Ok next -> inferenceHostCollectArrowFields (tailOr fields) boundMu next path

@label "Inference host binder canonical fields"
@description "Collect binders through structural record/variant fields in canonical semantic FieldKey order."
@tags "engine" "internal" "signature" "inference" "binding" "field-identity" "phase-2"
@category "engine-internal"
inferenceHostCollectFieldTokens : (tokens: a) -> (fields: b) -> (boundMu: c) -> (quantified: d) -> (path: String) -> Result d e
inferenceHostCollectFieldTokens tokens fields boundMu quantified path =
  case head tokens of
    Nothing -> Ok quantified
    Just token ->
      case inferenceHostTraversalFieldByToken token fields of
        Nothing -> inferenceErr "inference.malformed-signature" path "canonical host field token has no traversal occurrence"
        Just field ->
          case inferenceHostCollectTraversal field.type boundMu quantified (concat path (concat "/" token)) of
            Err e -> Err e
            Ok next -> inferenceHostCollectFieldTokens (tailOr tokens) fields boundMu next path

@label "Inference host binder structural fields"
@description "Canonicalize structural field order before assigning q0,q1,... compatibility identities."
@tags "engine" "internal" "signature" "inference" "binding" "field-identity" "phase-2"
@category "engine-internal"
inferenceHostCollectStructuralFields : (fields: a) -> (boundMu: b) -> (quantified: c) -> (path: String) -> Result c d
inferenceHostCollectStructuralFields fields boundMu quantified path =
  let tokens = sortLex (map (\field -> fieldKeyToken field.semanticKey) fields)
  inferenceHostCollectFieldTokens tokens fields boundMu quantified path

@label "Inference host binder variant cases"
@description "Collect variant payload binders in canonical constructor then semantic FieldKey order."
@tags "engine" "internal" "signature" "inference" "binding" "field-identity" "phase-2"
@category "engine-internal"
inferenceHostCollectCaseNames : (names: a) -> (cases: b) -> (boundMu: c) -> (quantified: d) -> (path: String) -> Result d e
inferenceHostCollectCaseNames names cases boundMu quantified path =
  case head names of
    Nothing -> Ok quantified
    Just name ->
      case inferenceHostTraversalCaseByName name cases of
        Nothing -> inferenceErr "inference.malformed-signature" path "canonical host constructor name has no traversal occurrence"
        Just variantCase ->
          case inferenceHostCollectStructuralFields variantCase.fields boundMu quantified (concat path (concat "/" name)) of
            Err e -> Err e
            Ok next -> inferenceHostCollectCaseNames (tailOr names) cases boundMu next path

@label "Inference host binder traversal"
@description "Fenel-owned compatibility binder discovery over the audited TraversalType semantic spine. TtEl/TtApp require an explicit kinded sidecar rather than a host guess."
@tags "engine" "signature" "inference" "binding" "kind" "phase-2"
inferenceHostCollectTraversal : (node: a) -> (boundMu: b) -> (quantified: c) -> (path: String) -> Result c d
inferenceHostCollectTraversal node boundMu quantified path =
  case node of
    TtNamed -> Ok quantified
    TtVar { name = name } -> Ok (inferenceHostAddBinder name boundMu quantified)
    TtUnit -> Ok quantified
    TtVoid -> Ok quantified
    TtTypeUniverse -> Ok quantified
    TtEl -> inferenceErr "inference.host-scheme-sidecar" path "host compatibility signature contains a dependent type; author an explicit kinded TypeScheme sidecar"
    TtApp -> inferenceErr "inference.host-scheme-sidecar" path "host compatibility signature contains a type application; author an explicit kinded TypeScheme sidecar"
    TtRecord { fields = fields } -> inferenceHostCollectStructuralFields fields boundMu quantified path
    TtVariant { cases = cases } ->
      inferenceHostCollectCaseNames (sortLex (map (\variantCase -> variantCase.name) cases)) cases boundMu quantified path
    TtTuple { items = items } -> inferenceHostCollectTypes items boundMu quantified path
    TtMap { values = values } -> inferenceHostCollectTraversal values boundMu quantified (concat path "/values")
    TtRefined { base = base } -> inferenceHostCollectTraversal base boundMu quantified (concat path "/base")
    TtMu { var = identity, body = body } -> inferenceHostCollectTraversal body (appendItem identity boundMu) quantified (concat path "/body")
    TtTagged { value = value, phantom = phantom } ->
      case inferenceHostCollectTraversal value boundMu quantified (concat path "/value") of
        Err e -> Err e
        Ok next -> inferenceHostCollectTraversal phantom boundMu next (concat path "/phantom")
    TtOpaque { pure = pure } -> inferenceHostCollectTraversal pure boundMu quantified (concat path "/pure")
    TtArrow { params = params, returns = returns } ->
      case inferenceHostCollectArrowFields params boundMu quantified (concat path "/params") of
        Err e -> Err e
        Ok next -> inferenceHostCollectTraversal returns boundMu next (concat path "/returns")
    TtUnion { branches = branches } -> inferenceHostCollectTypes branches boundMu quantified path
    TtIntersect { branches = branches } -> inferenceHostCollectTypes branches boundMu quantified path
    TtComplement { inner = inner } -> inferenceHostCollectTraversal inner boundMu quantified (concat path "/inner")
    TtUnknown { invalid = invalid } ->
      if invalid
      then inferenceErr "inference.malformed-type" path "malformed/accessor-bearing host signature type was rejected"
      else inferenceErr "inference.cyclic-type" path "cyclic host signature type requires an explicit annotation"

@label "Inference host binder authored params"
@description "Collect only Authored HostSpec parameter slots; source-sidecar and Absent placeholder TraversalTypes cannot manufacture compatibility binders."
@tags "engine" "internal" "signature" "inference" "binding" "provenance" "phase-2"
@category "engine-internal"
inferenceHostCollectCandidateParams : (provenance: a) -> (params: b) -> (quantified: c) -> (path: String) -> Result c d
inferenceHostCollectCandidateParams provenance params quantified path =
  case head provenance of
    Nothing ->
      if eq (length params) 0 then Ok quantified
      else inferenceErr "inference.slot-arity" path "parameter provenance/traversal widths do not agree"
    Just source ->
      case head params of
        Nothing -> inferenceErr "inference.slot-arity" path "parameter provenance/traversal widths do not agree"
        Just param ->
          let prepared =
                if eq source "host-spec"
                then inferenceHostCollectTraversal param.type [] quantified path
                else Ok quantified
          case prepared of
            Err e -> Err e
            Ok next -> inferenceHostCollectCandidateParams (tailOr provenance) (tailOr params) next path

@label "Inference candidate quantified sidecar"
@description "Use an explicit source/type scheme unchanged, or derive KType host compatibility binders in Fenel from Authored HostSpec slots only."
@tags "engine" "signature" "inference" "binding" "provenance" "phase-2"
inferenceCandidateQuantified : (candidate: a) -> (path: String) -> Result b c
inferenceCandidateQuantified candidate path =
  if not candidate.hostCompatibility then Ok candidate.quantified
  else if gt (length candidate.quantified) 0 then
    inferenceErr "inference.host-scheme-sidecar" path "host compatibility input cannot combine inferred KType binders with an explicit quantified sidecar"
  else
    case candidate.signatureTraversal of
      TtArrow { params = params, returns = returns } ->
        case inferenceHostCollectCandidateParams candidate.paramProvenance params [] (concat path "/params") of
          Err e -> Err e
          Ok quantified ->
            if eq candidate.returnProvenance "host-spec"
            then inferenceHostCollectTraversal returns [] quantified (concat path "/returns")
            else Ok quantified
      other -> inferenceErr "inference.malformed-signature" path "candidate signature traversal is not an arrow"

@label "Inference candidate params"
@description "Allocate independent absent parameter metas and convert authored parameter slots through the audited traversal boundary."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCandidateParams : (slots: a) -> (params: b) -> (quantified: c) -> (environment: d) -> (state: e) -> (path: String) -> Result f g
inferenceCandidateParams slots params quantified environment state path =
  case head slots of
    Nothing ->
      if eq (length params) 0 then Ok { params = [], environment = environment, state = state }
      else inferenceErr "inference.slot-arity" path "parameter declaration/traversal widths do not agree"
    Just slot ->
      case head params of
        Nothing -> inferenceErr "inference.slot-arity" path "parameter declaration/traversal widths do not agree"
        Just param ->
          let prepared = if eq slot "absent" then Ok (inferenceFresh state) else
            case inferenceFromTraversal param.type quantified of
              Err e -> Err e
              Ok authored -> Ok { type = authored, state = state }
          case prepared of
            Err e -> Err e
            Ok current ->
              let token = fieldKeyToken param.semanticKey
              let field = { key = param.semanticKey, keyToken = token, wireName = param.wireName, type = current.type }
              let env2 = inferencePrependBinding param.wireName (inferenceMonoScheme current.type) true environment
              case inferenceCandidateParams (tailOr slots) (tailOr params) quantified env2 current.state path of
                Err e -> Err e
                Ok rest -> Ok { params = inferencePrependItem field rest.params, environment = rest.environment, state = rest.state }

@label "Inference candidate return"
@description "Allocate an independent absent return meta or convert the authored return traversal."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCandidateReturn : (slot: String) -> (returns: a) -> (quantified: b) -> (state: c) -> Result d e
inferenceCandidateReturn slot returns quantified state =
  if eq slot "absent" then Ok (inferenceFresh state)
  else
    case inferenceFromTraversal returns quantified of
      Err e -> Err e
      Ok authored -> Ok { type = authored, state = state }

@label "Inference preallocate candidate"
@description "Build one monomorphic top-level arrow assumption from authored slots plus fresh independent absent metas."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePreallocateCandidate : (candidate: a) -> (state: b) -> (path: String) -> Result c d
inferencePreallocateCandidate candidate state path =
  if gt (length candidate.diagnostics) 0 then inferenceErr "inference.source-scheme" path "source scheme diagnostics require an annotation repair"
  else
    case inferenceCandidateQuantified candidate path of
      Err e -> Err e
      Ok candidateQuantified ->
        let scopedQuantified = map (\variable -> {
          id = concat path (concat "/rigid/" variable.id),
          sourceId = variable.id,
          sourceName = variable.sourceName,
          kind = variable.kind
        }) candidateQuantified
        case candidate.signatureTraversal of
          TtArrow { params = params, returns = returns } ->
            case inferenceCandidateParams candidate.paramSlots params scopedQuantified [] state path of
              Err e -> Err e
              Ok preparedParams ->
                case inferenceCandidateReturn candidate.returnSlot returns scopedQuantified preparedParams.state of
                  Err e -> Err e
                  Ok preparedReturn -> Ok {
                    candidate = candidate,
                    quantified = scopedQuantified,
                    type = { tag = "ItArrow", params = preparedParams.params, returns = preparedReturn.type },
                    environment = preparedParams.environment,
                    state = preparedReturn.state
                  }
          other -> inferenceErr "inference.malformed-signature" path "candidate signature traversal is not an arrow"

@label "Inference preallocate SCC"
@description "Preallocate every member of an SCC before checking any body, preserving monomorphic recursion."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePreallocateGroup : (group: a) -> (state: b) -> (path: String) -> Result c d
inferencePreallocateGroup group state path =
  case head group of
    Nothing -> Ok { assumptions = [], state = state }
    Just candidate ->
      case inferencePreallocateCandidate candidate state (concat path (concat "/" candidate.id)) of
        Err e -> Err e
        Ok assumption ->
          case inferencePreallocateGroup (tailOr group) assumption.state path of
            Err e -> Err e
            Ok rest -> Ok { assumptions = inferencePrependItem assumption rest.assumptions, state = rest.state }

@label "Inference SCC assumption lookup"
@description "Find a current-SCC monomorphic arrow assumption by canonical id."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAssumptionLookup : (id: String) -> (assumptions: a) -> Maybe a
inferenceAssumptionLookup id assumptions =
  fold
    (\found assumption ->
      case found of
        Just existing -> Just existing
        Nothing -> if eq assumption.candidate.id id then Just assumption else Nothing)
    Nothing
    assumptions

@label "Inference external callable lookup"
@description "Find a prepared external callable by exact source spelling."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceExternalCallableLookup : (name: String) -> (callables: a) -> Maybe a
inferenceExternalCallableLookup name callables = inferenceCallableLookup name callables

@label "Inference callable row for resolution"
@description "Project one exact routing row to the current SCC assumption, an already-published generalized scheme, or an authored external scheme."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCallableForResolution : (row: a) -> (assumptions: b) -> (published: c) -> (external: d) -> e
inferenceCallableForResolution row assumptions published external =
  if not (eq row.status "resolved") then row
  else
    case inferenceAssumptionLookup row.targetId assumptions of
      Just assumption -> { name = row.name, targetId = row.targetId, status = "resolved", scheme = inferenceMonoScheme assumption.type, trust = "recursive-monomorphic" }
      Nothing ->
        case inferencePublishedLookup row.targetId published of
          Just plan -> { name = row.name, targetId = row.targetId, status = "resolved", scheme = plan.scheme, trust = plan.trust }
          Nothing ->
            case inferenceExternalCallableByTarget row.targetId external of
              Just callable -> { name = row.name, targetId = row.targetId, status = "resolved", scheme = callable.scheme, trust = callable.trust }
              Nothing -> { name = row.name, targetId = row.targetId, status = "missing" }

@label "Inference effective callable rows"
@description "Build the one callable view used while solving an SCC; current assumptions override published/external rows."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceEffectiveCallables : (resolutions: a) -> (assumptions: b) -> (published: c) -> (external: d) -> e
inferenceEffectiveCallables resolutions assumptions published external =
  map (\row -> inferenceCallableForResolution row assumptions published external) resolutions

@label "Inference recursive return meta ids"
@description "Collect the original preallocated return metas which identify direct output dependencies inside the current SCC."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecursiveReturnMetaIds : (assumptions: a) -> b
inferenceRecursiveReturnMetaIds assumptions =
  fold inferenceAddRecursiveReturnMetaId [] assumptions

@label "Inference add recursive return meta id"
@description "Add one preallocated meta result to the SCC return-id set."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAddRecursiveReturnMetaId : (ids: a) -> (assumption: b) -> a
inferenceAddRecursiveReturnMetaId ids assumption =
  let result = assumption.type.returns
  if not (eq result.tag "ItMeta") then ids
  else if elem result.id ids then ids
  else appendItem result.id ids

@label "Inference direct recursive return branch"
@description "Test whether one already-applied top-level union branch is an unsolved current-SCC return meta."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceDirectRecursiveReturnBranch : (branch: a) -> (returnMetaIds: b) -> (state: c) -> Boolean
inferenceDirectRecursiveReturnBranch branch returnMetaIds state =
  let direct = inferencePrune branch state
  and (eq direct.tag "ItMeta") (elem direct.id returnMetaIds)

@label "Inference deferred recursive return union"
@description "Recognize only an output union with a direct branch that is one of the current SCC's preallocated return metas. Nested recursive occurrences are deliberately excluded and retain the ordinary occurs-check fence."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceDeferredRecursiveReturnUnion : (type: a) -> (returnMetaIds: b) -> (state: c) -> Boolean
inferenceDeferredRecursiveReturnUnion type returnMetaIds state =
  let current = inferenceApply type state
  if not (eq current.tag "ItUnion") then false
  else
    fold
      (\found branch ->
        if found then true
        else inferenceDirectRecursiveReturnBranch branch returnMetaIds state)
      false
      (inferenceUnionFlatten current.branches [])

@label "Inference recursive return equation by meta"
@description "Resolve one original SCC return meta to its deferred output equation."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecursiveReturnEquationByMeta : (id: String) -> (equations: a) -> Maybe a
inferenceRecursiveReturnEquationByMeta id equations =
  case head equations of
    Nothing -> Nothing
    Just equation ->
      let result = equation.result
      if and (eq result.tag "ItMeta") (eq result.id id)
      then Just equation
      else inferenceRecursiveReturnEquationByMeta id (tailOr equations)

@label "Inference classify recursive return branches"
@description "Partition top-level normalized output branches into concrete branches and direct deferred-return dependencies after applying all non-return constraints."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceClassifyRecursiveReturnBranches : (types: a) -> (equations: b) -> (state: c) -> d
inferenceClassifyRecursiveReturnBranches types equations state =
  fold
    (\classified type -> inferenceClassifyRecursiveReturnBranch classified type equations state)
    { branches = [], dependencies = [] }
    types

@label "Inference classify recursive return branch"
@description "Classify one applied top-level branch, recursively flattening unions and retaining direct SCC-return edges as dependencies."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceClassifyRecursiveReturnBranch : (classified: a) -> (type: b) -> (equations: c) -> (state: d) -> a
inferenceClassifyRecursiveReturnBranch classified type equations state =
  let current = inferenceApply type state
  if eq current.tag "ItUnion" then
    let nested = inferenceClassifyRecursiveReturnBranches current.branches equations state
    {
      branches = concat classified.branches nested.branches,
      dependencies = concat classified.dependencies nested.dependencies
    }
  else if eq current.tag "ItMeta" then
    case inferenceRecursiveReturnEquationByMeta current.id equations of
      Nothing -> {
        branches = appendItem current classified.branches,
        dependencies = classified.dependencies
      }
      Just dependency -> {
        branches = classified.branches,
        dependencies = if elem current.id classified.dependencies then classified.dependencies else appendItem current.id classified.dependencies
      }
  else {
    branches = appendItem current classified.branches,
    dependencies = classified.dependencies
  }

@label "Inference canonical recursive return branches"
@description "Reuse the output-union normalizer while retaining an explicit empty branch worklist."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceCanonicalRecursiveReturnBranches : (branches: a) -> a
inferenceCanonicalRecursiveReturnBranches branches =
  case head branches of
    Nothing -> []
    Just branch ->
      let normalized = inferenceNormalizeUnion (inferenceUnionFlatten branches [])
      if eq normalized.tag "ItUnion" then normalized.branches else [normalized]

@label "Inference recursive return plans"
@description "Build one finite output-equation plan per deferred SCC return. A return already constrained elsewhere contributes an anchor branch, so that fact propagates through the same closure."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecursiveReturnPlans : (remaining: a) -> (whole: b) -> (state: c) -> d
inferenceRecursiveReturnPlans remaining whole state =
  case head remaining of
    Nothing -> []
    Just equation ->
      let original = equation.result
      let currentResult = inferenceApply original state
      let originalUnsolved = and (eq original.tag "ItMeta") (and (eq currentResult.tag "ItMeta") (eq original.id currentResult.id))
      let anchor = if originalUnsolved then [] else [currentResult]
      let inferred = inferenceUnionFlatten [inferenceApply equation.inferred state] []
      let classified = inferenceClassifyRecursiveReturnBranches (concat inferred anchor) whole state
      let plan = {
        metaId = if eq original.tag "ItMeta" then original.id else "",
        result = original,
        inferred = equation.inferred,
        path = equation.path,
        branches = inferenceCanonicalRecursiveReturnBranches classified.branches,
        dependencies = classified.dependencies
      }
      inferencePrependItem plan (inferenceRecursiveReturnPlans (tailOr remaining) whole state)

@label "Inference recursive return plan by meta"
@description "Lookup one deferred output plan by its original SCC return meta."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecursiveReturnPlanByMeta : (id: String) -> (plans: a) -> Maybe a
inferenceRecursiveReturnPlanByMeta id plans =
  case head plans of
    Nothing -> Nothing
    Just plan ->
      if and (not (eq plan.metaId "")) (eq plan.metaId id)
      then Just plan
      else inferenceRecursiveReturnPlanByMeta id (tailOr plans)

@label "Inference recursive return closure pass"
@description "Propagate the current concrete output branches across direct SCC-return dependencies, then canonicalize to prevent duplicate-growth."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecursiveReturnClosurePass : (plans: a) -> a
inferenceRecursiveReturnClosurePass plans =
  map (\plan -> inferenceRecursiveReturnClosurePlan plan plans) plans

@label "Inference recursive return closure plan"
@description "Expand one plan from the previous closure snapshot; same-pass writes never leak into peers."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecursiveReturnClosurePlan : (plan: a) -> (plans: b) -> a
inferenceRecursiveReturnClosurePlan plan plans =
  let expanded = fold
    (\branches dependencyId ->
      case inferenceRecursiveReturnPlanByMeta dependencyId plans of
        Nothing -> branches
        Just dependency -> concat branches dependency.branches)
    plan.branches
    plan.dependencies
  {
    metaId = plan.metaId,
    result = plan.result,
    inferred = plan.inferred,
    path = plan.path,
    branches = inferenceCanonicalRecursiveReturnBranches expanded,
    dependencies = plan.dependencies
  }

@label "Inference recursive return residual dependencies"
@description "Retain an unconstrained representative only for dependency components with no concrete output anchor; dropping it would guess a narrower return."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceRecursiveReturnResidualDependencies : (dependencies: a) -> (plans: b) -> c
inferenceRecursiveReturnResidualDependencies dependencies plans =
  fold
    (\types dependencyId ->
      case inferenceRecursiveReturnPlanByMeta dependencyId plans of
        Nothing -> types
        Just dependency ->
          case head dependency.branches of
            Nothing -> appendItem dependency.result types
            Just branch -> types)
    []
    dependencies

@label "Inference solve recursive return plans"
@description "Bind each SCC return to its finite normalized concrete closure plus any genuinely unconstrained dependency representative."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSolveRecursiveReturnPlans : (remaining: a) -> (whole: b) -> (state: c) -> Result c d
inferenceSolveRecursiveReturnPlans remaining whole state =
  case head remaining of
    Nothing -> Ok state
    Just plan ->
      let residual = inferenceRecursiveReturnResidualDependencies plan.dependencies whole
      let branches = inferenceCanonicalRecursiveReturnBranches (inferenceApplyList (concat plan.branches residual) state)
      let solved = case head branches of
        Nothing -> inferenceUnify plan.result plan.inferred state plan.path
        Just branch -> inferenceUnify plan.result (inferenceNormalizeUnion branches) state plan.path
      case solved of
        Err e -> Err e
        Ok next -> inferenceSolveRecursiveReturnPlans (tailOr remaining) whole next

@label "Inference verify recursive return equations"
@description "Re-check every deferred equation after closure with current substitutions and canonical top-level union normalization."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceVerifyRecursiveReturnEquations : (remaining: a) -> (state: b) -> Result b c
inferenceVerifyRecursiveReturnEquations remaining state =
  case head remaining of
    Nothing -> Ok state
    Just equation ->
      let result = inferenceNormalizeUnion (inferenceUnionFlatten [inferenceApply equation.result state] [])
      let inferred = inferenceNormalizeUnion (inferenceUnionFlatten [inferenceApply equation.inferred state] [])
      case inferenceUnify result inferred state equation.path of
        Err e -> Err e
        Ok next -> inferenceVerifyRecursiveReturnEquations (tailOr remaining) next

@label "Inference resolve recursive return equations"
@description "Compute a bounded fixed point over one SCC's deferred output-union equations. Fuel is exactly the equation count: enough for every simple dependency path, with no repository-size ceiling or widening."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceResolveRecursiveReturnEquations : (equations: a) -> (state: b) -> Result b c
inferenceResolveRecursiveReturnEquations equations state =
  case head equations of
    Nothing -> Ok state
    Just equation ->
      let initial = inferenceRecursiveReturnPlans equations equations state
      let closed = fold (\plans tick -> inferenceRecursiveReturnClosurePass plans) initial equations
      case inferenceSolveRecursiveReturnPlans closed closed state of
        Err e -> Err e
        Ok solved -> inferenceVerifyRecursiveReturnEquations equations solved

@label "Inference solve SCC assumptions loop"
@description "Infer each remaining body against the complete SCC's shared monomorphic assumptions. Direct recursive-return branches of output unions are deferred as finite equations; every other constraint is unified immediately."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSolveGroupAssumptionsGo : (remaining: a) -> (wholeAssumptions: b) -> (returnMetaIds: c) -> (resolutions: d) -> (published: e) -> (external: f) -> (state: g) -> (equations: h) -> (path: String) -> Result i j
inferenceSolveGroupAssumptionsGo remaining wholeAssumptions returnMetaIds resolutions published external state equations path =
  case head remaining of
    Nothing -> Ok { state = state, equations = equations }
    Just assumption ->
      let candidate = assumption.candidate
      let exact = if isNull candidate.resolutions then resolutions else candidate.resolutions
      let callables = inferenceEffectiveCallables exact wholeAssumptions published external
      case inferenceInfer candidate.body assumption.environment callables state (concat path (concat "/" candidate.id)) of
        Err e -> Err e
        Ok inferred ->
          let returnPath = concat path (concat "/" (concat candidate.id "/return"))
          if inferenceDeferredRecursiveReturnUnion inferred.type returnMetaIds inferred.state then
            let equation = { result = assumption.type.returns, inferred = inferred.type, path = returnPath }
            inferenceSolveGroupAssumptionsGo (tailOr remaining) wholeAssumptions returnMetaIds resolutions published external inferred.state (appendItem equation equations) path
          else
            case inferenceUnify inferred.type assumption.type.returns inferred.state returnPath of
              Err e -> Err e
              Ok next -> inferenceSolveGroupAssumptionsGo (tailOr remaining) wholeAssumptions returnMetaIds resolutions published external next equations path

@label "Inference solve SCC assumptions"
@description "Infer every body against the SCC's shared monomorphic assumptions and its own exact module/import routing rows, threading one substitution; no member publishes early."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSolveGroupAssumptions : (assumptions: a) -> (resolutions: b) -> (published: c) -> (external: d) -> (state: e) -> (path: String) -> Result f g
inferenceSolveGroupAssumptions assumptions resolutions published external state path =
  let returnMetaIds = inferenceRecursiveReturnMetaIds assumptions
  case inferenceSolveGroupAssumptionsGo assumptions assumptions returnMetaIds resolutions published external state [] path of
    Err e -> Err e
    Ok inferred -> inferenceResolveRecursiveReturnEquations inferred.equations inferred.state

@label "Inference SCC is recursive"
@description "A multi-member SCC or a singleton with a self edge is recursive."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceGroupIsRecursive : (group: a) -> (resolutions: b) -> Boolean
inferenceGroupIsRecursive group resolutions =
  if gt (length group) 1 then true
  else
    case head group of
      Nothing -> false
      Just candidate -> elem candidate.id candidate.callees

@label "Inference SCC totality proved"
@description "Run the shipped mutual size-change/structural totality checker over the exact current SCC after resolving its source call spellings to canonical member ids and lowering to core Expr. Fails closed when the projection did not account for the dependency walk: a recursive SCC whose projected totality graph is empty (instead of the checker's non-recursive vacuity rule), or any member-to-member dependency edge (candidate.callees) with no size-change graph beside it, so a recognised decreasing call can never hide an unchecked edge."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceGroupTotal : (group: a) -> (resolutions: b) -> Boolean
inferenceGroupTotal group resolutions =
  let projected = inferenceTotalityGroup group resolutions
  let graphs = totCollectAllMembers projected projected
  let memberIds = inferenceTotalityGroupIds group
  let uncovered = filter (\candidate -> gt (length (filter (\target -> and (elem target memberIds) (not (fold (\found graph -> or found (and (eq graph.from candidate.id) (eq graph.to target))) false graphs))) (if isNull candidate.callees then [] else candidate.callees))) 0) group
  if totIsEmptyList graphs then false
  else if gt (length uncovered) 0 then false
  else
    case checkMutualTotality projected of
      Total -> true
      Unknown -> false
      Partial -> false

@label "Inference totality group ids"
@description "Collect the canonical member ids of one current inference SCC."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTotalityGroupIds : (group: a) -> b
inferenceTotalityGroupIds group =
  map (\candidate -> candidate.id) group

@label "Inference totality call head"
@description "Resolve one source ECall head or EVar spelling through the candidate's exact routing rows, stripping a var-head call's `$dyn:` marker exactly as the surface dependency walk does (inferenceCollectResolvedReference). A spelling resolved to a current-SCC member becomes the member's canonical id (a graph call, or a value escape for checkMutualTotality); one resolved to a trusted std primitive (totIsTrustedPrimitive: std:gt, std:sub, …) becomes that canonical id, the only form the size-change oracle reads facts off (2026-10-03: a user function named `gt` or `sub` must yield none); one resolved elsewhere keeps its source spelling minus `$dyn:` (an outside callee). An unresolved or ambiguous spelling stays unchanged, so the checker's unresolved-dynamic-call rule still sees it."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTotalityCallHead : (name: String) -> (resolutions: a) -> (memberIds: b) -> String
inferenceTotalityCallHead name resolutions memberIds =
  let localName = if startsWith name "$dyn:" then slice name 5 (length name) else name
  case inferenceResolutionLookup localName resolutions of
    Nothing -> name
    Just row ->
      if not (eq row.status "resolved") then name
      else if elem row.targetId memberIds then row.targetId
      else if totIsTrustedPrimitive row.targetId then row.targetId
      else localName

@label "Inference totality resolve Expr list"
@description "Resolve exact SCC call heads recursively in a core Expr list."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTotalityResolveList : (exprs: a) -> (resolutions: b) -> (memberIds: c) -> d
inferenceTotalityResolveList exprs resolutions memberIds =
  case head exprs of
    Nothing -> []
    Just expr -> inferencePrependItem (inferenceTotalityResolveExpr expr resolutions memberIds) (inferenceTotalityResolveList (tailOr exprs) resolutions memberIds)

@label "Inference totality resolve Expr fields"
@description "Resolve exact SCC call heads in record field values."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTotalityResolveFields : (fields: a) -> (resolutions: b) -> (memberIds: c) -> d
inferenceTotalityResolveFields fields resolutions memberIds =
  case head fields of
    Nothing -> []
    Just field ->
      let resolved = { name = field.name, value = inferenceTotalityResolveExpr field.value resolutions memberIds }
      inferencePrependItem resolved (inferenceTotalityResolveFields (tailOr fields) resolutions memberIds)

@label "Inference totality resolve match arms"
@description "Resolve exact SCC call heads in match guards and bodies while retaining the optional guard shape."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTotalityResolveArms : (arms: a) -> (resolutions: b) -> (memberIds: c) -> d
inferenceTotalityResolveArms arms resolutions memberIds =
  case head arms of
    Nothing -> []
    Just arm ->
      let resolvedBody = inferenceTotalityResolveExpr arm.body resolutions memberIds
      let resolvedArm = case lookup arm "guard" of
        Nothing -> { pattern = arm.pattern, body = resolvedBody }
        Just guard -> { pattern = arm.pattern, guard = inferenceTotalityResolveExpr guard resolutions memberIds, body = resolvedBody }
      inferencePrependItem resolvedArm (inferenceTotalityResolveArms (tailOr arms) resolutions memberIds)

@label "Inference totality resolve core calls"
@description "Canonicalize exact call heads and value references into the current SCC before the totality walk (inferenceTotalityCallHead, `$dyn:` stripped as the dependency walk strips it). A member reached as a value (EVar) is canonicalized too, so checkMutualTotality refuses it as an escape instead of ignoring it. Unmatched and ambiguous spellings and constructor heads remain unchanged."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTotalityResolveExpr : (expr: (Expr Any)) -> (resolutions: a) -> (memberIds: b) -> (Expr Any)
inferenceTotalityResolveExpr expr resolutions memberIds =
  case expr of
    ELit {} -> expr
    EVar { name = name } -> EVar { name = inferenceTotalityCallHead name resolutions memberIds }
    ECall { fnId = name, args = args } ->
      let resolved = ECall { fnId = inferenceTotalityCallHead name resolutions memberIds, args = inferenceTotalityResolveList args resolutions memberIds }
      case lookup expr "lit" of
        Nothing -> resolved
        Just mark -> mapSet resolved "lit" mark
    ELambda { params = params, body = body } ->
      ELambda { params = params, body = inferenceTotalityResolveExpr body resolutions memberIds }
    EMatch { scrutinee = scrutinee, arms = arms } ->
      EMatch {
        scrutinee = inferenceTotalityResolveExpr scrutinee resolutions memberIds,
        arms = inferenceTotalityResolveArms arms resolutions memberIds
      }
    EConstruct { ctor = ctor, args = args, fields = fields } ->
      EConstruct { ctor = ctor, args = inferenceTotalityResolveList args resolutions memberIds, fields = fields }
    EConstruct { ctor = ctor, args = args } ->
      EConstruct { ctor = ctor, args = inferenceTotalityResolveList args resolutions memberIds }
    ERecord { fields = fields } ->
      ERecord { fields = inferenceTotalityResolveFields fields resolutions memberIds }

@label "Inference totality group"
@description "Project inference candidates to the existing checkMutualTotality member shape. Each body's source spellings are first rewritten through that candidate's exact registry resolution rows, so the core totality checker sees the same canonical ids as the SCC planner."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTotalityGroup : (group: a) -> (resolutions: b) -> c
inferenceTotalityGroup group resolutions =
  inferenceTotalityGroupGo group resolutions (inferenceTotalityGroupIds group)

@label "Inference totality group fold"
@description "Internal member projection with a shared canonical SCC-id set."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceTotalityGroupGo : (group: a) -> (resolutions: b) -> (memberIds: c) -> d
inferenceTotalityGroupGo group resolutions memberIds =
  case head group of
    Nothing -> []
    Just candidate ->
      let exact = if isNull candidate.resolutions then resolutions else candidate.resolutions
      let coreBody = desugar candidate.body
      let member = { id = candidate.id, params = candidate.paramNames, body = inferenceTotalityResolveExpr coreBody exact memberIds }
      inferencePrependItem member (inferenceTotalityGroupGo (tailOr group) resolutions memberIds)

@label "Inference signature trust is usable"
@description "Only a proved inference derivation or an explicitly trusted primitive may support downstream registered-arrow trust; Advisory never does."
@tags "engine" "internal" "signature" "inference" "trust" "phase-2"
@category "engine-internal"
inferenceSignatureTrustUsable : (trust: SignatureTrust) -> Boolean
inferenceSignatureTrustUsable trust =
  case trust of
    Advisory { evidence = _ } -> false
    InferredDerivation { evidence = _ } -> true
    TrustedPrimitive { evidence = _ } -> true

@label "Inference external trust is usable"
@description "Decode the already-validated host boundary trust tag without inventing a default; unknown tags remain untrusted."
@tags "engine" "internal" "signature" "inference" "trust" "phase-2"
@category "engine-internal"
inferenceExternalTrustUsable : (trust: String) -> Boolean
inferenceExternalTrustUsable trust =
  or (eq trust "InferredDerivation") (eq trust "TrustedPrimitive")

@label "Inference external callable by target"
@description "Find external signature evidence by canonical target id, independent of the source spelling used at this call site."
@tags "engine" "internal" "signature" "inference" "trust" "phase-2"
@category "engine-internal"
inferenceExternalCallableByTarget : (targetId: String) -> (external: a) -> Maybe a
inferenceExternalCallableByTarget targetId external =
  fold
    (\found row ->
      case found of
        Just existing -> Just existing
        Nothing -> if eq row.targetId targetId then Just row else Nothing)
    Nothing
    external

@label "Inference dependency target is trusted"
@description "Require an outside dependency certificate from an atomically published plan or an authored external row. Current-SCC assumptions are checked as one trust unit."
@tags "engine" "internal" "signature" "inference" "trust" "phase-2"
@category "engine-internal"
inferenceDependencyTargetTrusted : (targetId: String) -> (group: a) -> (published: b) -> (external: c) -> Boolean
inferenceDependencyTargetTrusted targetId group published external =
  if inferenceGroupContainsId targetId group then true
  else
    case inferencePublishedLookup targetId published of
      Just plan -> inferenceSignatureTrustUsable plan.trust
      Nothing ->
        case inferenceExternalCallableByTarget targetId external of
          Nothing -> false
          Just row -> inferenceExternalTrustUsable row.trust

@label "Inference dependency targets are trusted"
@description "Conjoin trust evidence for every canonical outside callee."
@tags "engine" "internal" "signature" "inference" "trust" "phase-2"
@category "engine-internal"
inferenceDependencyTargetsTrusted : (targets: a) -> (group: b) -> (published: c) -> (external: d) -> Boolean
inferenceDependencyTargetsTrusted targets group published external =
  case head targets of
    Nothing -> true
    Just target ->
      if inferenceDependencyTargetTrusted target group published external
      then inferenceDependencyTargetsTrusted (tailOr targets) group published external
      else false

@label "Inference candidate dependencies are trusted"
@description "Meet one candidate's exact surface callees against the current trust frontier."
@tags "engine" "internal" "signature" "inference" "trust" "phase-2"
@category "engine-internal"
inferenceCandidateDependenciesTrusted : (candidate: a) -> (group: b) -> (resolutions: c) -> (published: d) -> (external: e) -> Boolean
inferenceCandidateDependenciesTrusted candidate group resolutions published external =
  inferenceDependencyTargetsTrusted candidate.callees group published external

@label "Inference SCC dependencies are trusted"
@description "A solved SCC may be promoted only when every member's exact outside dependencies have usable certificates."
@tags "engine" "internal" "signature" "inference" "trust" "phase-2"
@category "engine-internal"
inferenceGroupDependenciesTrusted : (group: a) -> (wholeGroup: b) -> (resolutions: c) -> (published: d) -> (external: e) -> Boolean
inferenceGroupDependenciesTrusted group wholeGroup resolutions published external =
  case head group of
    Nothing -> true
    Just candidate ->
      if inferenceCandidateDependenciesTrusted candidate wholeGroup resolutions published external
      then inferenceGroupDependenciesTrusted (tailOr group) wholeGroup resolutions published external
      else false

@label "Inference SCC trust"
@description "Plan inference trust independently from useful scheme synthesis; effect-opaque HOF calls, untrusted dependencies, and unproved recursion remain advisory."
@tags "engine" "signature" "inference" "phase-2"
inferenceGroupTrust : (group: a) -> (resolutions: b) -> (published: c) -> (external: d) -> (effectOpaque: Boolean) -> (localRecursiveOpaque: Boolean) -> SignatureTrust
inferenceGroupTrust group resolutions published external effectOpaque localRecursiveOpaque =
  let recursive = inferenceGroupIsRecursive group resolutions
  let trustedDependencies = inferenceGroupDependenciesTrusted group group resolutions published external
  if effectOpaque then
    Advisory { evidence = { reason = "higher-order dynamic call lacks effect-row evidence" } }
  else if localRecursiveOpaque then
    Advisory { evidence = { reason = "local recursive where-group lacks a totality certificate" } }
  else if not trustedDependencies then
    Advisory { evidence = { reason = "an external dependency lacks trusted signature evidence" } }
  else if recursive then
    if inferenceGroupTotal group resolutions
    then InferredDerivation { evidence = { engine = "fenel-rank1", version = "1", recursive = true } }
    else Advisory { evidence = { reason = "recursive SCC lacks a totality certificate" } }
  else InferredDerivation { evidence = { engine = "fenel-rank1", version = "1", recursive = false } }

@label "Inference published slot"
@description "Turn one loader slot fact into its authoritative publication plan. Authored payloads are retained by the host boundary; absent obligations receive Fenel-owned inference provenance."
@tags "engine" "internal" "signature" "inference" "provenance" "phase-2"
@category "engine-internal"
inferencePublishedSlot : (slot: String) -> (derivation: a) -> SlotDeclaration
inferencePublishedSlot slot derivation =
  if eq slot "absent"
  then Inferred { engine = "fenel-rank1", version = "1", derivation = derivation }
  else Authored { source = "boundary-authored-payload" }

@label "Inference publish SCC assumptions"
@description "Generalize and validate every solved member together; any invalid post-flatten arrow aborts the batch before publication. The canonical SCC id and size are threaded unchanged across the batch."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferencePublishGroupAssumptions : (assumptions: a) -> (state: b) -> (trust: c) -> (recursive: Boolean) -> (sccId: String) -> (sccSize: Int) -> d
inferencePublishGroupAssumptions assumptions state trust recursive sccId sccSize =
  case head assumptions of
    Nothing -> Ok []
    Just assumption ->
      let candidate = assumption.candidate
      case inferenceGeneralizeWithChecked assumption.quantified assumption.type [] state (concat "registry/signatures/" candidate.id) of
        Err e -> Err e
        Ok scheme ->
          let derivation = { engine = "fenel-rank1", version = "1", scc = recursive, sccId = sccId, sccSize = sccSize }
          let row = {
            id = candidate.id,
            scheme = scheme,
            paramSlots = map (\slot -> inferencePublishedSlot slot derivation) candidate.paramSlots,
            returnSlot = inferencePublishedSlot candidate.returnSlot derivation,
            derivation = derivation,
            trust = trust,
            recursive = recursive
          }
          case inferencePublishGroupAssumptions (tailOr assumptions) state trust recursive sccId sccSize of
            Err e -> Err e
            Ok rest -> Ok (inferencePrependItem row rest)

@label "Inference solve one SCC"
@description "Preallocate, solve monomorphically, reject undischarged residuals/metas and effect-row-polymorphic dynamic calls, then atomically generalize the group."
@tags "engine" "signature" "inference" "phase-2"
inferenceSolveTopLevelGroup : (group: a) -> (resolutions: b) -> (external: c) -> (published: d) -> (path: String) -> Result e f
inferenceSolveTopLevelGroup group resolutions external published path =
  let firstId = case head group of Nothing -> "empty"; Just candidate -> candidate.id
  let state = inferenceInitialState (concat path (concat "/scc/" firstId))
  case inferencePreallocateGroup group state path of
    Err e -> Err e
    Ok preallocated ->
      case inferenceSolveGroupAssumptions preallocated.assumptions resolutions published external preallocated.state path of
        Err e -> Err e
        Ok solved ->
          case inferenceDischargeResiduals solved.residuals solved of
            Err e -> Err e
            Ok discharged ->
              if discharged.effectOpaque then
                inferenceErr "inference.effect-polymorphism" (concat path (concat "/scc/" firstId)) "a higher-order dynamic call requires an explicit signature until effect-row polymorphism is available"
              else
                let recursive = inferenceGroupIsRecursive group resolutions
                let trust = inferenceGroupTrust group resolutions published external false discharged.localRecursiveOpaque
                inferencePublishGroupAssumptions preallocated.assumptions discharged trust recursive firstId (length group)

@label "Inference solve SCC worklist"
@description "Dependency-order SCC worklist; each successful group becomes visible only as a complete generalized batch."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceSolveTopLevelGroups : (groups: a) -> (candidateIds: b) -> (resolutions: c) -> (external: d) -> (published: e) -> (path: String) -> Result f g
inferenceSolveTopLevelGroups groups candidateIds resolutions external published path =
  let initial = { outcome = Ok true, remaining = groups, published = published, progress = false }
  let work =
        fold
          (\work _tick ->
            case work.outcome of
              Err e -> work
              Ok active ->
                case head work.remaining of
                  Nothing -> work
                  Just pending ->
                    let pass =
                          fold
                            (\acc group ->
                              case acc.outcome of
                                Err e -> acc
                                Ok scanning ->
                                  if inferenceGroupDependenciesReady group candidateIds acc.published resolutions then
                                    case inferenceSolveTopLevelGroup group resolutions external acc.published path of
                                      Err e -> { outcome = Err e, remaining = acc.remaining, published = acc.published, progress = acc.progress }
                                      Ok plans -> { outcome = Ok true, remaining = acc.remaining, published = concat acc.published plans, progress = true }
                                  else { outcome = Ok true, remaining = appendItem group acc.remaining, published = acc.published, progress = acc.progress })
                            { outcome = Ok true, remaining = [], published = work.published, progress = false }
                            work.remaining
                    case pass.outcome of
                      Err e -> pass
                      Ok scanned ->
                        case head pass.remaining of
                          Nothing -> pass
                          Just blocked ->
                            if pass.progress then pass
                            else { outcome = Err (inferenceDiagnostic "inference.scc-order" path "no dependency-ready SCC exists"), remaining = pass.remaining, published = pass.published, progress = false })
          initial
          groups
  case work.outcome of
    Err e -> Err e
    Ok finished ->
      case head work.remaining of
        Nothing -> Ok work.published
        Just pending -> inferenceErr "inference.scc-order" path "SCC worklist fuel exhausted before publication"

@label "Inference validate top-level candidates"
@description "Reject every missing-slot candidate whose active implementation cannot lawfully be inferred, before SCC planning publishes anything."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceValidateTopLevelCandidates : (candidates: a) -> (path: String) -> Result b c
inferenceValidateTopLevelCandidates candidates path =
  fold
    (\validated candidate ->
      case validated of
        Err e -> Err e
        Ok valid ->
          if not (eq candidate.origin "FenelBody") then
            case inferenceFirstAbsentParam candidate.paramSlots candidate.paramNames of
              Just name -> inferenceErr "inference.native-annotation" (concat path (concat "/" candidate.id)) (concat "parameter " (concat name " requires a type annotation"))
              Nothing -> inferenceErr "inference.native-annotation" (concat path (concat "/" candidate.id)) "return requires a type annotation"
          else if not (eq candidate.syntaxStatus "ok") then
            inferenceErr "inference.surface-conversion" (concat path (concat "/" candidate.id)) "the body could not be converted to surface Syntax for inference"
          else Ok true)
    (Ok true)
    candidates

@label "Inference first absent parameter"
@description "Find the first absent native-active parameter slot with its actionable source name."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceFirstAbsentParam : (slots: a) -> (names: b) -> Maybe String
inferenceFirstAbsentParam slots names =
  case head slots of
    Nothing -> Nothing
    Just slot ->
      case head names of
        Nothing -> Nothing
        Just name -> if eq slot "absent" then Just name else inferenceFirstAbsentParam (tailOr slots) (tailOr names)

@label "Infer top-level signature batch"
@description "Public registry entry: derive registered constructor schemes, partition exact surface call edges, solve SCCs dependency-first, and return only atomically published meta-free schemes."
@tags "engine" "signature" "inference" "phase-2"
inferTopLevelSignatures : (candidates: a) -> (resolutions: b) -> (externalRows: c) -> (constructorEntities: d) -> (path: String) -> InferenceOutcome
inferTopLevelSignatures candidates resolutions externalRows constructorEntities path =
  case inferenceValidateTopLevelCandidates candidates path of
    Err e -> inferenceOutcomeFromError e
    Ok valid ->
      case inferenceFencedRowsOutcome (inferenceTopLevelExactRows candidates resolutions) of
        Just outcome -> outcome
        Nothing ->
          case inferencePrepareCallables externalRows of
            Err e -> inferenceOutcomeFromError e
            Ok external ->
              case inferenceRegisteredConstructorCallables constructorEntities of
                Err e -> inferenceOutcomeFromError e
                Ok constructors ->
                  let callables = concat external constructors
                  let graphCandidates = map (\candidate -> mapSet candidate "callees" (inferenceCandidateCallees candidate resolutions)) candidates
                  let groups = inferenceTopLevelSccPartition graphCandidates resolutions
                  let candidateIds = inferenceCandidateIds graphCandidates
                  case inferenceSolveTopLevelGroups groups candidateIds resolutions callables [] path of
                    Err e -> inferenceOutcomeFromError e
                    Ok plans -> Solved { plan = { functions = plans, derivation = "fenel-rank1-top-level-v1" } }

@label "Inference method"
@description "Infer `{method: [cls, method, ...args]}`. With no arguments, a spelling the host marshalled as a modules-as-values Phase 5a member value row (`$member:cls.method`, an uppercase bundle's named instance such as `DrawingDemo.pointLineChartViewable`) is that member's VALUE, as the runtime's methodOp zero-argument branch returns it; anything else, a genuine zero-argument class method such as `Monoid.mempty` included, stays an application of the complete spelling."
@tags "engine" "internal" "signature" "inference" "modules-as-values"
@category "engine-internal"
inferenceMethod : (cls: String) -> (method: String) -> (args: a) -> (environment: b) -> (callables: c) -> (state: d) -> (path: String) -> Result e f
inferenceMethod cls method args environment callables state path =
  let name = concat cls (concat "." method)
  if eq (length args) 0 then
    case inferenceCallableLookup (concat "$member:" name) callables of
      Just row -> inferenceResolveValue name environment callables state path
      Nothing -> inferenceCall name args environment callables state path
  else inferenceCall name args environment callables state path

@label "Inference surface Syntax"
@description "Generate and solve constraints directly over all fourteen surface Syntax cases; SLet/SWhere survive and therefore support real let/generalization semantics. SAnn infers its expression; the written type is never returned unchecked (the call-site rule checks it)."
@tags "engine" "signature" "inference" "phase-2"
inferenceInfer : (node: (Syntax Any)) -> (environment: a) -> (callables: b) -> (state: c) -> (path: String) -> Result d e
inferenceInfer node environment callables state path =
  case node of
    SLit { value = value } ->
      if eq node.pureData true then inferencePureData value environment callables state path
      else inferenceLiteral value state path
    SVar { name = name } ->
      if eq node.identity true then inferenceResolveExactCallable (concat "$identity:" name) callables state path
      else inferenceResolveValue name environment callables state path
    SCall { fnId = name, args = args } ->
      if inferenceSyntheticListCall node name
      then inferenceApplyResolvedCall (inferenceResolveExactCallable "std.appendItem" callables state (concat path "/callee")) args environment callables path false
      else inferenceCall name args environment callables state path
    SLambda { params = params, body = body } -> inferenceLambda params body environment callables state path
    SMatch { scrutinee = scrutinee, arms = arms } -> inferenceMatch scrutinee arms environment callables state path
    SConstruct { ctor = ctor, args = args } -> inferenceCall (concat "$ctor:" ctor) args environment callables state path
    SRecord { fields = fields } ->
      if not (inferenceSyntaxFieldKeysUnique fields []) then
        inferenceErr "inference.duplicate-field-key" path "record contains a duplicate semantic/local field identity"
      else
        case inferenceRecordFields (inferenceCanonicalSyntaxFields fields) environment callables state path 0 of
          Err e -> Err e
          Ok inferred -> Ok { type = { tag = "ItRecord", fields = inferred.fields }, state = inferred.state }
    SIf { cond = cond, then = thenBranch, else = elseBranch } -> inferenceIf cond thenBranch elseBranch environment callables state path
    SLet { bindings = bindings, body = body } ->
      case inferenceLetBindings bindings environment callables state path of
        Err e -> Err e
        Ok scoped -> inferenceInfer body scoped.environment callables scoped.state (concat path "/body")
    SDo { exprs = exprs } -> inferenceDo exprs environment callables state path
    SOp { op = op, operands = operands } -> inferenceCall op operands environment callables state path
    SWhere { body = body, bindings = bindings } -> inferenceWhere body bindings environment callables state path
    SMethod { cls = cls, method = method, args = args } ->
      let name = concat cls (concat "." method)
      if and (eq (length args) 0) (not (eq node.applied true))
      then inferenceResolveValue name environment callables state path
      else inferenceCall name args environment callables state path
    -- SAnn (modules-as-values Phase 2d): infer the annotated expression and
    -- return ITS type — never the written type unchecked (the written type is
    -- judged by the call-site rule, not trusted here).
    SAnn { expr = expr } -> inferenceInfer expr environment callables state path


-- -------------------------------------------------------------------------
-- Public expression/unifier entries and outcome classification
-- -------------------------------------------------------------------------

@label "Inference diagnostic is annotation fence"
@description "Classify unsupported/indeterminate diagnostics separately from exact invalid equations."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceDiagnosticIsFence : (diagnostic: a) -> Boolean
inferenceDiagnosticIsFence diagnostic =
  if eq diagnostic.code "inference.unknown-name" then true
  else if eq diagnostic.code "inference.ambiguous-call" then true
  else if eq diagnostic.code "inference.overapplication" then true
  else if eq diagnostic.code "inference.union-callee" then true
  else if eq diagnostic.code "inference.union-consumer" then true
  else if eq diagnostic.code "inference.higher-rank" then true
  else if eq diagnostic.code "inference.polymorphic-recursion" then true
  else if eq diagnostic.code "inference.map-key-indeterminate" then true
  else if eq diagnostic.code "inference.set-former-indeterminate" then true
  else if eq diagnostic.code "inference.value-dependent-type" then true
  else if eq diagnostic.code "inference.cyclic-type" then true
  else if eq diagnostic.code "inference.literal-object" then true
  else if eq diagnostic.code "inference.reflective-dispatch" then true
  else if eq diagnostic.code "inference.native-annotation" then true
  else if eq diagnostic.code "inference.surface-conversion" then true
  else if eq diagnostic.code "inference.source-scheme" then true
  else if eq diagnostic.code "inference.pattern-shape" then true
  else if eq diagnostic.code "inference.pattern-underdetermined" then true
  else if eq diagnostic.code "inference.refinement-indeterminate" then true
  else if eq diagnostic.code "inference.record-projection" then true
  else if eq diagnostic.code "inference.host-scheme-sidecar" then true
  else if eq diagnostic.code "inference.effect-polymorphism" then true
  else false

@label "Inference outcome from error"
@description "Turn an internal diagnostic into Invalid or AnnotationRequired without guessing a type."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceOutcomeFromError : (diagnostic: a) -> InferenceOutcome
inferenceOutcomeFromError diagnostic =
  if inferenceDiagnosticIsFence diagnostic
  then AnnotationRequired { diagnostics = [diagnostic] }
  else Invalid { diagnostics = [diagnostic] }

@label "Inference authored signature trust"
@description "Classify the transitional P2 trust posture from the active implementation origin. A complete authored signature retains the repository's historical SC-sig admission until P4/P4b replaces that axiom with certificates; the evidence is explicitly only AuthoredSignature, never a validation verdict."
@tags "engine" "signature" "inference" "trust" "phase-2"
inferenceAuthoredSignatureTrust : (origin: String) -> (path: String) -> Result a b
inferenceAuthoredSignatureTrust origin path =
  if eq origin "FenelBody" then
    Ok (TrustedPrimitive { evidence = { authority = "AuthoredSignature", origin = origin, posture = "LegacySC-sigUntilP4" } })
  else if or (eq origin "HostNative") (or (eq origin "NativeWithFallback") (eq origin "ExternalHandler")) then
    Ok (TrustedPrimitive { evidence = { authority = "ActiveImplementationAuthoredSignature", origin = origin } })
  else inferenceErr "inference.implementation-origin" path "authored signature has an unknown active implementation origin"

@label "Inference authored publication fence"
@description "Only a structurally valid, genuinely value-dependent authored type may publish outside bounded rank-1 inference. Other conversion failures remain batch-atomic errors."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferenceAuthoredPublicationFence : (diagnostic: a) -> Boolean
inferenceAuthoredPublicationFence diagnostic =
  eq diagnostic.code "inference.value-dependent-type"

@label "Plan one authored top-level signature"
@description "Validate and prepare one complete authored candidate as a Result so the public batch planner can traverse linearly without immutable-list snoc."
@tags "engine" "internal" "signature" "inference" "trust" "phase-2"
@category "engine-internal"
inferencePlanAuthoredCandidate : (candidate: a) -> (path: String) -> Result b c
inferencePlanAuthoredCandidate candidate path =
  let candidatePath = concat path (concat "/" candidate.id)
  if gt (length candidate.diagnostics) 0 then
    inferenceErr "inference.source-scheme" candidatePath "source scheme diagnostics require an annotation repair"
  else
    case inferenceAuthoredSignatureTrust candidate.origin candidatePath of
      Err e -> Err e
      Ok trust ->
        case inferenceCandidateQuantified candidate candidatePath of
          Err e -> Err e
          Ok quantified ->
            case inferencePrepareScheme { quantified = quantified, bodyTraversal = candidate.signatureTraversal } of
              Ok scheme -> Ok { id = candidate.id, status = "solved", scheme = scheme, trust = trust }
              Err e ->
                if inferenceAuthoredPublicationFence e
                then Ok {
                  id = candidate.id,
                  status = "fenced",
                  diagnostics = [e],
                  trust = Advisory { evidence = { reason = "authored signature is outside bounded rank-1 inference" } },
                  externalCallable = false
                }
                else Err e

@label "Plan authored top-level signatures"
@description "Validate complete authored schemes, fence parser binding diagnostics, and plan their active-implementation trust without a host-side default."
@tags "engine" "signature" "inference" "trust" "provenance" "phase-2"
planAuthoredTopLevelSignatures : (candidates: a) -> (path: String) -> InferenceOutcome
planAuthoredTopLevelSignatures candidates path =
  let prepared = map (\candidate -> inferencePlanAuthoredCandidate candidate path) candidates
  let firstFailure =
        fold
          (\found result ->
            case found of
              Just e -> Just e
              Nothing ->
                case result of
                  Err e -> Just e
                  Ok plan -> Nothing)
          Nothing
          prepared
  case firstFailure of
    Just e -> inferenceOutcomeFromError e
    Nothing ->
      let plans = map (\result -> case result of Ok plan -> plan; Err e -> e) prepared
      Solved { plan = { functions = plans, derivation = "fenel-rank1-authored-plan-v1" } }

@label "Inference pattern scrutinee"
@description "Instantiate an authored scrutinee scheme, or allocate a fresh meta when the editor has not inferred the scrutinee yet."
@tags "engine" "internal" "signature" "inference" "authoring" "phase-2"
@category "engine-internal"
inferencePatternScrutinee : (scrutineeScheme: a) -> (state: b) -> (path: String) -> Result c d
inferencePatternScrutinee scrutineeScheme state path =
  if isNull scrutineeScheme then Ok (inferenceFresh state)
  else
    case inferencePrepareScheme scrutineeScheme of
      Err e -> Err e
      Ok scheme -> Ok (inferenceInstantiate scheme state)

@label "Inference publish pattern bindings"
@description "Publish each solved arm-local binding as a monomorphic scheme. Pattern binders are values, not let-bound definitions; any still-unsolved meta fences instead of becoming an unsound forall."
@tags "engine" "internal" "signature" "inference" "authoring" "phase-2"
@category "engine-internal"
inferencePublishPatternBindings : (names: a) -> (environment: b) -> (state: c) -> (path: String) -> Result d e
inferencePublishPatternBindings names environment state path =
  fold
    (\published name ->
      case published of
        Err e -> Err e
        Ok rows ->
          case inferenceEnvironmentLookup name environment of
            Nothing -> inferenceErr "inference.pattern-binding" path (concat "pattern binding was not present in the solved arm environment: " name)
            Just binding ->
              let solved = inferenceApply binding.body state
              if gt (length (inferenceCollectMetas solved [])) 0 then
                inferenceErr "inference.pattern-underdetermined" path (concat "pattern binding requires a known scrutinee type: " name)
              else Ok (appendItem { name = name, scheme = inferenceMonoScheme solved } rows))
    (Ok [])
    names

@label "Infer match pattern bindings"
@description "Public browser entry: consume the shared JSON-Logic-to-Syntax Result, solve the first canonical Pattern with the rank-1 kernel, and publish only structured meta-free bindings. Plain record patterns are outside the canonical Pattern ADT and fence as AnnotationRequired."
@tags "engine" "signature" "inference" "authoring" "phase-2"
inferMatchPatternBindings : (surfaceResult: a) -> (scrutineeScheme: b) -> (callableRows: c) -> (path: String) -> InferenceOutcome
inferMatchPatternBindings surfaceResult scrutineeScheme callableRows path =
  case inferenceFencedRowsOutcome callableRows of
    Just outcome -> outcome
    Nothing ->
      case surfaceResult of
        Err e -> inferenceAnnotation "inference.pattern-shape" path "pattern is outside the canonical Pattern fragment; plain record patterns require explicit annotation until record-pattern inference exists"
        Ok syntax ->
          case syntax of
            SMatch { arms = arms } ->
              case head arms of
                Nothing -> inferenceInvalid "inference.empty-match" path "a pattern binding request requires one match arm"
                Just arm ->
                  case inferencePrepareCallables callableRows of
                    Err e -> inferenceOutcomeFromError e
                    Ok callables ->
                      let state = inferenceInitialState path
                      case inferencePatternScrutinee scrutineeScheme state (concat path "/scrutinee") of
                        Err e -> inferenceOutcomeFromError e
                        Ok scrutinee ->
                          case inferencePattern arm.pattern scrutinee.type [] callables scrutinee.state (concat path "/pattern") of
                            Err e -> inferenceOutcomeFromError e
                            Ok patterned ->
                              case inferenceDischargeResiduals patterned.state.residuals patterned.state of
                                Err e -> inferenceOutcomeFromError e
                                Ok discharged ->
                                  let names = sortLex (inferencePatternBoundNames arm.pattern [])
                                  case inferencePublishPatternBindings names patterned.environment discharged path of
                                    Err e -> inferenceOutcomeFromError e
                                    Ok bindings -> Solved { plan = {
                                      bindings = bindings,
                                      derivation = "fenel-rank1-pattern-v1"
                                    } }
            other -> inferenceInvalid "inference.pattern-boundary" path "pattern binding input is not a converted match expression"

@label "Infer Syntax type"
@description "Boundary entry for browser/loader parity: prepare exact schemes, infer surface Syntax, generalize deterministically, and return a structured outcome."
@tags "engine" "signature" "inference" "phase-2"
inferSyntaxType : (syntax: (Syntax Any)) -> (bindingRows: a) -> (callableRows: b) -> (path: String) -> InferenceOutcome
inferSyntaxType syntax bindingRows callableRows path =
  case inferenceFencedRowsOutcome callableRows of
    Just outcome -> outcome
    Nothing ->
      case inferencePrepareEnvironment bindingRows of
        Err e -> inferenceOutcomeFromError e
        Ok environment ->
          case inferencePrepareCallables callableRows of
            Err e -> inferenceOutcomeFromError e
            Ok callables ->
              let state = inferenceInitialStateWith path (inferenceDeclarationRows callableRows)
              case inferenceInfer syntax environment callables state path of
                Err e -> inferenceOutcomeFromError e
                Ok solvedSyntax ->
                  case inferenceOpaqueProvenanceSettled solvedSyntax.state path of
                    Err e -> inferenceOutcomeFromError e
                    Ok settled -> inferSyntaxTypeFinish solvedSyntax environment path

@label "Infer Syntax type finish"
@description "Discharge refinement residuals, generalize and publish one inferred surface-Syntax expression (inferSyntaxType)."
@tags "engine" "internal" "signature" "inference" "phase-2"
@category "engine-internal"
inferSyntaxTypeFinish : (inferred: a) -> (environment: b) -> (path: String) -> InferenceOutcome
inferSyntaxTypeFinish inferred environment path =
  case inferenceDischargeResiduals inferred.state.residuals inferred.state of
    Err e -> inferenceOutcomeFromError e
    Ok discharged ->
      if discharged.effectOpaque then
        AnnotationRequired { diagnostics = [inferenceDiagnostic "inference.effect-polymorphism" path "a higher-order dynamic call requires an explicit signature until effect-row polymorphism is available"] }
      else
        case inferenceGeneralizeChecked inferred.type environment discharged path of
          Err e -> inferenceOutcomeFromError e
          Ok scheme ->
            if gt (length (inferenceCollectMetas scheme.body [])) 0 then
              AnnotationRequired { diagnostics = [inferenceDiagnostic "inference.escaped-meta" path "an unsolved metavariable is reachable from the result"] }
            else Solved { plan = {
              scheme = scheme,
              derivation = "fenel-rank1-syntax-v1",
              trust = Advisory { evidence = { reason = "expression inference is useful but not an SC-sig certificate" } }
            } }

@label "Infer traversal equation"
@description "Focused unifier entry used by conformance tests; metas are supplied as InferenceType, ground leaves as TraversalType-converted types."
@tags "engine" "signature" "inference" "phase-2"
inferTraversalEquation : (leftTraversal: a) -> (rightTraversal: b) -> (path: String) -> InferenceOutcome
inferTraversalEquation leftTraversal rightTraversal path =
  case inferenceFromTraversal leftTraversal [] of
    Err e -> inferenceOutcomeFromError e
    Ok left ->
      case inferenceFromTraversal rightTraversal [] of
        Err e -> inferenceOutcomeFromError e
        Ok right ->
          let state = inferenceInitialState path
          case inferenceUnify left right state path of
            Err e -> inferenceOutcomeFromError e
            Ok solved ->
              case inferenceDischargeResiduals solved.residuals solved of
                Err e -> inferenceOutcomeFromError e
                Ok discharged ->
                  case inferenceGeneralizeChecked left [] discharged path of
                    Err e -> inferenceOutcomeFromError e
                    Ok scheme -> Solved { plan = { scheme = scheme, derivation = "fenel-rank1-unify-v1", trust = Advisory { evidence = { reason = "focused unifier result" } } } }


-- -------------------------------------------------------------------------
-- modules-as-values Phase 2d — the call-site type rule
--
-- A class-qualified, fully applied method call `C.m e1 … en`, optionally
-- wrapped in a written result type `(C.m e1 … en : T)`, selects its instance
-- by the complete class application `C t1 … tk`. This section is the rule
-- that finds `t1 … tk`: instantiate the method's registered scheme with the
-- class parameters as unknowns (keeping which unknown belongs to which
-- parameter), fix what the argument evidence supplies, match the method
-- result against the expected type, discharge refinement residuals, and read
-- every class parameter back. Priority never fills a missing parameter: a
-- parameter still unknown is reported by its source name. A parameter solved
-- to anything but a nullary nominal (`List Int`, a record, an arrow) is
-- rejected, never projected to its head.
--
-- The host marshals the scheme exactly as registry capability-method schemes
-- are marshalled, and every evidence/expected type as a GROUND TraversalType
-- whose nominal identities were resolved lexically; it decides nothing here.
-- -------------------------------------------------------------------------

-- The outcome of typing one call site (positional payloads `_0` `_1` `_2`):
--   CallSiteSolved classParameters argumentTypes resultType
--     classParameters: [{ name, type }] in class-header order; every type is
--                      an ItNamed (a nullary nominal).
--     argumentTypes:   per argument, its solved parameter type.
--     resultType:      the solved method result.
--   CallSiteUnfixed parameterNames: the class parameters nothing fixed.
--   CallSiteRejected diagnostics: inference diagnostics; terminal.
CallSiteTyping =
  CallSiteSolved a b c
  | CallSiteUnfixed a
  | CallSiteRejected a

@label "Call-site rejection"
@description "Build a CallSiteRejected outcome carrying one stable inference diagnostic."
@tags "engine" "internal" "signature" "inference" "dispatch" "modules-as-values"
@category "engine-internal"
callSiteRejection : (code: String) -> (path: String) -> (message: String) -> CallSiteTyping
callSiteRejection code path message = CallSiteRejected [inferenceDiagnostic code path message]

@label "Call-site unify argument evidence"
@description "Unify each known argument type (the inferred side) with its declared parameter (the declared side), in calling order. An unknown argument (Nothing) constrains nothing; ground evidence with a free variable fails closed at the traversal boundary."
@tags "engine" "internal" "signature" "inference" "dispatch" "modules-as-values"
@category "engine-internal"
callSiteUnifyArguments : (evidence: a) -> (params: b) -> (state: c) -> (path: String) -> Result d e
callSiteUnifyArguments evidence params state path =
  case head evidence of
    Nothing -> Ok state
    Just item ->
      case head params of
        Nothing -> inferenceErr "call-site.arity" path "the call supplies more arguments than the method declares"
        Just param ->
          case item of
            Nothing -> callSiteUnifyArguments (tailOr evidence) (tailOr params) state path
            Just traversal ->
              case inferenceFromTraversal traversal [] of
                Err e -> Err e
                Ok argumentType ->
                  case inferenceUnify argumentType param.type state (concat path (concat "/arg/" param.keyToken)) of
                    Err e -> Err e
                    Ok next -> callSiteUnifyArguments (tailOr evidence) (tailOr params) next path

@label "Call-site unify expected type"
@description "Unify the method result (the inferred side) with the written expected type (the declared side); no expected type constrains nothing."
@tags "engine" "internal" "signature" "inference" "dispatch" "modules-as-values"
@category "engine-internal"
callSiteUnifyExpected : (expected: a) -> (returns: b) -> (state: c) -> (path: String) -> Result d e
callSiteUnifyExpected expected returns state path =
  case expected of
    Nothing -> Ok state
    Just traversal ->
      case inferenceFromTraversal traversal [] of
        Err e -> Err e
        Ok expectedType -> inferenceUnify returns expectedType state (concat path "/result")

@label "Call-site classify one class parameter"
@description "Read one class parameter back through the solved substitution and add it to the classification: a still-unknown parameter is unfixed, a nullary nominal is solved, anything else (an application, a structural type) is non-nominal."
@tags "engine" "internal" "signature" "inference" "dispatch" "modules-as-values"
@category "engine-internal"
callSiteClassifyParameter : (acc: a) -> (row: b) -> (state: c) -> a
callSiteClassifyParameter acc row state =
  let current = inferenceApply row.type state
  if eq current.tag "ItMeta" then
    { solvedRows = acc.solvedRows, unfixedNames = appendItem row.sourceName acc.unfixedNames, nonNominalNames = acc.nonNominalNames }
  else if eq current.tag "ItNamed" then
    { solvedRows = appendItem { name = row.sourceName, type = current } acc.solvedRows, unfixedNames = acc.unfixedNames, nonNominalNames = acc.nonNominalNames }
  else
    { solvedRows = acc.solvedRows, unfixedNames = acc.unfixedNames, nonNominalNames = appendItem row.sourceName acc.nonNominalNames }

@label "Call-site classify class parameters"
@description "Classify every class parameter in class-header order (see callSiteClassifyParameter)."
@tags "engine" "internal" "signature" "inference" "dispatch" "modules-as-values"
@category "engine-internal"
callSiteClassifyParameters : (mapping: a) -> (state: b) -> c
callSiteClassifyParameters mapping state =
  fold
    (\acc row -> callSiteClassifyParameter acc row state)
    { solvedRows = [], unfixedNames = [], nonNominalNames = [] }
    mapping

@label "Call-site solved outcome"
@description "Discharge refinement residuals, then publish the solved class parameters, the solved argument parameter types and the solved result. An indeterminate residual while a class parameter is still unknown reports the unknown parameters; every other discharge failure rejects."
@tags "engine" "internal" "signature" "inference" "dispatch" "modules-as-values"
@category "engine-internal"
callSiteSolvedOutcome : (classified: a) -> (arrow: b) -> (state: c) -> CallSiteTyping
callSiteSolvedOutcome classified arrow state =
  let unfixedCount = length classified.unfixedNames
  case inferenceDischargeResiduals state.residuals state of
    Err e ->
      if and (gt unfixedCount 0) (eq e.code "inference.refinement-indeterminate")
      then CallSiteUnfixed classified.unfixedNames
      else CallSiteRejected [e]
    Ok discharged ->
      if gt unfixedCount 0 then CallSiteUnfixed classified.unfixedNames
      else
        let argumentTypes = map (\param -> inferenceApply param.type discharged) arrow.params
        let resultType = inferenceApply arrow.returns discharged
        CallSiteSolved classified.solvedRows argumentTypes resultType

@label "Infer call-site instance"
@description "modules-as-values Phase 2d, the call-site type rule. Request {scheme, arguments, expected, path}: scheme is a method's boundary scheme (class parameters quantified in header order, the flattened arrow as bodyTraversal); arguments holds one Maybe TraversalType per argument (Just a ground type, Nothing unknown); expected is a Maybe TraversalType (ground). Exact full application only. Returns CallSiteSolved (each class parameter a nullary nominal, each argument's and the result's solved type), CallSiteUnfixed (the source names of the parameters nothing fixed) or CallSiteRejected (diagnostics)."
@tags "engine" "signature" "inference" "dispatch" "modules-as-values"
inferCallSiteInstance : (request: a) -> CallSiteTyping
inferCallSiteInstance request =
  let sitePath = request.path
  case inferencePrepareScheme request.scheme of
    Err e -> CallSiteRejected [e]
    Ok scheme ->
      let fresh = inferenceFreshQuantified scheme.quantified (inferenceInitialState sitePath)
      let arrow = inferenceFlattenArrow (inferenceReplace scheme.body fresh.mapping)
      if not (eq arrow.tag "ItArrow") then
        callSiteRejection "call-site.not-callable" sitePath "the declared method type is not a function type"
      else if not (eq (length arrow.params) (length request.arguments)) then
        callSiteRejection "call-site.arity" sitePath (concat "a typed method call must be fully applied: the method declares " (concat (toString (length arrow.params)) (concat " parameters, the call supplies " (toString (length request.arguments)))))
      else
        case callSiteUnifyArguments request.arguments arrow.params fresh.state sitePath of
          Err e -> CallSiteRejected [e]
          Ok argued ->
            case callSiteUnifyExpected request.expected arrow.returns argued sitePath of
              Err e -> CallSiteRejected [e]
              Ok unified ->
                let classified = callSiteClassifyParameters fresh.mapping unified
                if gt (length classified.nonNominalNames) 0 then
                  callSiteRejection "call-site.non-nominal-parameter" sitePath (concat "a class parameter must be a named type, but was solved to an application or a structural type: " (join classified.nonNominalNames ", "))
                else callSiteSolvedOutcome classified arrow unified
