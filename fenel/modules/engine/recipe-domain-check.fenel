module engine where

-- Recipe domain admission is a checked finite fragment of containment.
-- Ingress supplies the reader's EXACT declaration trees, per-declaration
-- owner/name bindings, reified bodies and observed primitive routes. Those
-- observations are the side condition; ordinary caller-authored values are
-- never proof. This face independently checks the complete admitted schema.
-- They share one reader revision: primitive admission describes the exact
-- routed definition also observed by reflection, rather than its id alone.
-- It does not evaluate a recipe, a refinement, a helper, or captured data.
--
-- The admitted domain is a finite nullary Food variant, an explicit total
-- injective numeric rank, and DIRECT refinements of the canonical List Food
-- declaration. Rank is bounded to 0..61: the ranked-language codec uses the
-- single ASCII symbol 65+rank, so this check is also its injectivity premise.
-- Pantry is exactly canonical(value); Ingredients adds length(value)>0.
-- Canonical means the checked head/tail/fromMaybe structural recursion below.
-- Both nonempty branches also call the checked exact-carrier Food helper:
-- constructor patterns alone admit additional fields, whereas ordinary
-- admitted structural Eq against the canonical constructor rejects them.
-- Function/constructor spelling never proves identity: source names close
-- through captured bindings, constructor maps and selected primitive routes.
-- Unknown shapes refuse. CheckedRecipeDomain remains data; live consumers
-- must reobserve these inputs before reusing an earlier checked result.

@label "Check recipe domain"
@description "Independently admit the finite Food/rank/canonical-list source fragment against the exact requesting-reader snapshot; unsupported or stale evidence is a typed refusal."
checkRecipeDomain : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> Result RecipeRefusal CheckedRecipeDomain
checkRecipeDomain snapshot =
  case lookup snapshot "domain" of
    Nothing -> Err RecipeInvalidDomain
    Just domain ->
      if not (recipeDomainShape domain ["foodType", "pantryType", "ingredientsType", "foods", "rankVersion", "rankFunction", "canonicalFunction", "canonicalAfterFunction", "scopes"])
      then Err RecipeInvalidDomain
      else if not (recipeDomainShape snapshot ["primitives", "generation", "constructorIdentities", "sources", "representations"])
      then Err RecipeInvalidDomain
      else if not (recipeDomainGeneration snapshot.generation)
      then Err RecipeStaleSnapshot
      else if not (isArray snapshot.primitives)
      then Err RecipeInvalidDomain
      else if not (recipeDomainConstructorIdentities snapshot.constructorIdentities)
      then Err RecipeConstructorUnresolved
      else if not (recipeDomainNatural domain.rankVersion)
      then Err RecipeInvalidDomain
      else if not (recipeDomainScopesValid domain.scopes)
      then Err RecipeInvalidDomain
      else recipeDomainCheckPackages snapshot domain

@category "engine-internal"
recipeDomainShape : (record: Any) -> (names: List String) -> Bool
recipeDomainShape record names =
  let hasDomainField = \name ->
        case lookup record name of
          Nothing -> false
          Just value -> true
  all names hasDomainField

@category "engine-internal"
recipeDomainNatural : (value: Any) -> Bool
recipeDomainNatural value = isNumber value && numberIsFinite value && value >= 0 && recipeSourceDataEqual (floor value) value

@category "engine-internal"
recipeDomainGeneration : (generation: Maybe Number) -> Bool
recipeDomainGeneration generation = case generation of
  Nothing -> true
  Just value -> recipeDomainNatural value
  _ -> false

@category "engine-internal"
recipeDomainUnique : (values: List Any) -> Bool
recipeDomainUnique values =
  -- Two Strings are definitely distinct exactly when they differ (the bounded
  -- judgment answers `Just (a == b)` for Strings), so an all-String list (the
  -- binding names: ~545 per card) is unique exactly when no String repeats.
  -- Same answer as the pairwise walk below, in one pass instead of n^2/2
  -- judgments (recipes lane 2, Nov 8: 33 s of the 68 s analysis check).
  if std.all values (\value -> isString value) then length (std.unique values) == length values
  else case head values of
    Nothing -> true
    Just first ->
      let rest = fromMaybe [] (tail values)
      all rest (recipeDomainDefinitelyDistinct first) && recipeDomainUnique rest

@category "engine-internal"
recipeDomainDefinitelyDistinct : (first: Any) -> (other: Any) -> Bool
recipeDomainDefinitelyDistinct first other =
  let comparison = deepEqValueTriStructural first other 4096 128
  case comparison.verdict of
    Just false -> true
    _ -> false

@category "engine-internal"
recipeDomainScopesValid : (scopes: List RecipeDeclarationScope) -> Bool
recipeDomainScopesValid scopes =
  isArray scopes && recipeSourceDataEqual (length scopes) 3 &&
  all scopes (\scope -> recipeDomainShape scope ["declaration", "owner", "bindings"] && isArray scope.bindings) &&
  recipeDomainUnique (map (\scope -> scope.declaration) scopes) &&
  all scopes (\scope ->
    isString scope.owner && scope.owner != "" &&
    recipeDomainUnique (map (\binding -> binding.name) scope.bindings) &&
    all scope.bindings (\binding -> isString binding.name && isString binding.target && binding.name != "" && binding.target != "")) &&
  all [RecipeFoodDeclaration, RecipePantryDeclaration, RecipeIngredientsDeclaration] (\role -> std.some scopes (\scope -> recipeSourceDataEqual scope.declaration role))

@category "engine-internal"
recipeDomainScope : (domain: RecipeDomainSnapshot) -> (role: RecipeDeclarationRole) -> RecipeDeclarationScope
recipeDomainScope domain role = fromMaybe { owner = "", bindings = [] } (head (filter (\scope -> recipeSourceDataEqual scope.declaration role) domain.scopes))

@category "engine-internal"
recipeDomainBinding : (scope: RecipeDeclarationScope) -> (name: String) -> Maybe String
recipeDomainBinding scope name =
  case head (filter (\binding -> recipeSourceDataEqual binding.name name) scope.bindings) of
    Nothing -> Nothing
    Just binding -> Just binding.target

@category "engine-internal"
recipeDomainBoundTo : (scope: RecipeDeclarationScope) -> (name: String) -> (target: String) -> Bool
recipeDomainBoundTo scope name target = target != "" && recipeSourceDataEqual (recipeDomainBinding scope name) (Just target)

@category "engine-internal"
recipeDomainSource : (package: ReifiedFunction) -> String
recipeDomainSource package = case package.source of
  NamedDefinition { identity = identity } -> if isString identity then identity else ""
  _ -> ""

@category "engine-internal"
recipeDomainConstructorsValid : (refs: List ConstructorRef) -> Bool
recipeDomainConstructorsValid refs =
  let validDomainConstructor = \ref ->
        case ref of
          ConstructorRef { written = written, target = target } -> isString written && written != "" && isString target && target != ""
          _ -> false
  isArray refs && all refs validDomainConstructor &&
  recipeDomainUnique (map (\ref -> ref.written) refs)

-- A runtime constructor coordinate is NOT its ordinary function identity.
-- The reader observes their exact owner-joined catalog relation. Only this
-- explicit bridge (or an already-observed function id) closes a coordinate.
@category "engine-internal"
recipeDomainConstructorIdentities : (identities: List RecipeConstructorIdentity) -> Bool
recipeDomainConstructorIdentities identities =
  isArray identities &&
  recipeDomainUnique (map (\row -> row.target) identities) &&
  all identities (\row -> isString row.target && row.target != "" && isString row.functionId && row.functionId != "") &&
  all identities (\row -> all identities (\other -> row.target != other.functionId || row.target == row.functionId))

@category "engine-internal"
recipeDomainConstructorIdentity : (identities: List RecipeConstructorIdentity) -> (target: String) -> Maybe String
recipeDomainConstructorIdentity identities target =
  case head (filter (\row -> recipeSourceDataEqual row.target target) identities) of
    Just row -> Just row.functionId
    Nothing -> if std.some identities (\row -> recipeSourceDataEqual row.functionId target) then Just target else Nothing

@category "engine-internal"
recipeDomainConstructorsBridged : (identities: List RecipeConstructorIdentity) -> (refs: List ConstructorRef) -> Bool
recipeDomainConstructorsBridged identities refs =
  recipeDomainConstructorsValid refs &&
  all refs (\ref -> not (recipeSourceDataEqual (recipeDomainConstructorIdentity identities ref.target) Nothing))

@category "engine-internal"
recipeDomainConstructor : (identities: List RecipeConstructorIdentity) -> (refs: List ConstructorRef) -> (written: String) -> Maybe String
recipeDomainConstructor identities refs written =
  case head (filter (\ref -> recipeSourceDataEqual ref.written written) refs) of
    Just (ConstructorRef { target = target }) -> recipeDomainConstructorIdentity identities target
    _ -> Nothing

@category "engine-internal"
recipeDomainPackageShape : (package: ReifiedFunction) -> Bool
recipeDomainPackageShape package =
  recipeDomainShape package ["params", "body", "captures", "source", "dependencies", "constructors", "generation"] &&
  isArray package.params && all package.params recipeDomainBinder &&
  recipeDomainUnique package.params && isArray package.captures && recipeSourceDataEqual (length package.captures) 0 &&
  isArray package.dependencies && recipeDomainSource package != ""

@category "engine-internal"
recipeDomainBinder : (name: String) -> Bool
recipeDomainBinder name = isString name && name != "" && not (std.contains name ".")

@category "engine-internal"
recipeDomainPackageGeneration : (package: ReifiedFunction) -> (generation: Maybe Number) -> Bool
recipeDomainPackageGeneration package generation =
  let dependencyDomainGeneration = \dep ->
        case dep.outcome of
          Reified { package = child } ->
            recipeDomainPackageShape child && recipeSourceDataEqual (length child.dependencies) 0 && recipeSourceDataEqual child.generation generation &&
            recipeDomainSource child != ""
          OpaqueBody { identity = identity } -> recipeSourceDataEqual identity dep.identity
          Unavailable -> true
  recipeSourceDataEqual package.generation generation &&
  recipeDomainUnique (map (\dep -> dep.identity) package.dependencies) &&
  all package.dependencies dependencyDomainGeneration

@category "engine-internal"
recipeDomainPackageConstructors : (identities: List RecipeConstructorIdentity) -> (package: ReifiedFunction) -> Bool
recipeDomainPackageConstructors identities package =
  let dependencyDomainConstructors = \dep ->
        case dep.outcome of
          Reified { package = child } -> recipeDomainConstructorsBridged identities child.constructors
          _ -> true
  recipeDomainConstructorsBridged identities package.constructors &&
  all package.dependencies dependencyDomainConstructors

@category "engine-internal"
recipeDomainSamePackage : (left: ReifiedFunction) -> (right: ReifiedFunction) -> Bool
recipeDomainSamePackage left right = recipeSourceDataEqual (mapSet left "dependencies" []) (mapSet right "dependencies" [])

@category "engine-internal"
recipeDomainDependency : (owner: ReifiedFunction) -> (target: ReifiedFunction) -> Bool
recipeDomainDependency owner target =
  let matchesDomainDependency = \dep ->
        case dep.outcome of
          Reified { package = package } -> recipeDomainSource package != "" && recipeDomainSamePackage package target
          _ -> false
  std.some owner.dependencies matchesDomainDependency

@category "engine-internal"
recipeDomainPrimitive : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (role: RecipePrimitiveRole) -> Maybe RecipePrimitiveAdmission
recipeDomainPrimitive snapshot role =
  let selected = filter (\primitive -> recipeSourceDataEqual primitive.role role) snapshot.primitives
  if recipeSourceDataEqual (length selected) 1 then head selected else Nothing

@category "engine-internal"
recipeDomainPrimitiveCall : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (role: RecipePrimitiveRole) -> (name: String) -> Bool
recipeDomainPrimitiveCall snapshot role name =
  case recipeDomainPrimitive snapshot role of
    Nothing -> false
    Just primitive -> primitive.admitted && recipeSourceDataEqual primitive.identity name && recipeDomainConstructorsBridged snapshot.constructorIdentities primitive.constructors

@category "engine-internal"
recipeDomainCheckPackages : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> Result RecipeRefusal CheckedRecipeDomain
recipeDomainCheckPackages snapshot domain =
  let packages = [domain.rankFunction, domain.canonicalFunction, domain.canonicalAfterFunction]
  if not (all packages recipeDomainPackageShape)
  then Err RecipeInvalidDomain
  else if not (all packages (\package -> recipeDomainPackageGeneration package snapshot.generation))
  then Err RecipeStaleSnapshot
  else if not (all packages (\package -> recipeDomainPackageConstructors snapshot.constructorIdentities package))
  then Err RecipeConstructorUnresolved
  else if not (all packages (\package -> recipeDomainPackageSourceAdmissions snapshot package))
  then Err RecipePrimitiveUnadmitted
  else if not (recipeDomainSourcesConsistent domain)
  then Err RecipeStaleSnapshot
  else if not (recipeDomainFoods domain)
  then Err RecipeInvalidDomain
  else if not (recipeDomainRepresentations snapshot domain)
  then Err RecipePrimitiveUnadmitted
  else if not (recipeDomainRank snapshot domain)
  then Err RecipeInvalidDomain
  else if not (recipeDomainCanonical snapshot domain)
  then Err RecipeInvalidDomain
  else if not (recipeDomainDeclarations snapshot domain)
  then Err RecipeInvalidDomain
  else Ok (CheckedRecipeDomain { source = domain, foods = domain.foods, generation = snapshot.generation })

@label "Check recipe representation admission"
@description "Require one explicit admitted stock representation observation for this exact constructor function identity and its observed runtime dispatch owner."
recipeCheckRepresentationAdmission : (snapshot: { representations: List RecipeRepresentationAdmission }) -> (constructor: String) -> Bool
recipeCheckRepresentationAdmission snapshot constructor =
  if not (isString constructor) || constructor == "" then false
  else if not (recipeDomainShape snapshot ["representations"]) || not (isArray snapshot.representations) then false
  else
    let matching = filter (\row -> recipeDomainShape row ["constructor"] && recipeSourceDataEqual row.constructor constructor) snapshot.representations
    if length matching != 1 then false
    else
      let selected = at matching 0
      if not (recipeDomainShape selected ["owner", "admitted"]) || not (isString selected.owner) || selected.owner == "" then false
      else case lookup selected "admitted" of
        Just true -> true
        _ -> false

@category "engine-internal"
recipeDomainRepresentations : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> Bool
recipeDomainRepresentations snapshot domain =
  all domain.foods (\food -> recipeCheckRepresentationAdmission snapshot food.identity) &&
  all ["Nothing", "Just"] (\name -> recipeDomainMaybeRepresentation snapshot name) &&
  all [RecipePantryDeclaration, RecipeIngredientsDeclaration] (\role -> recipeDomainListRepresentations snapshot domain role)

@category "engine-internal"
recipeDomainListRepresentations : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (role: RecipeDeclarationRole) -> Bool
recipeDomainListRepresentations snapshot domain role =
  let scope = recipeDomainScope domain role
  all ["system.List.Nil", "system.List.Cons"] (\name -> recipeCheckRepresentationAdmission snapshot (recipeDomainRequiredBinding scope name))

@category "engine-internal"
recipeDomainMaybeRepresentation : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (name: String) -> Bool
recipeDomainMaybeRepresentation snapshot name = case recipeDomainMaybeTarget snapshot name of
  Just identity -> recipeCheckRepresentationAdmission snapshot identity
  Nothing -> false

@label "Check recipe source admission"
@description "Require one admitted observation of this exact local reified source core in the live reader; only the flat dependency graph slot is excluded from the comparison."
recipeCheckSourceAdmission : (observation: { sources: List RecipeSourceAdmission }) -> (source: ReifiedFunction) -> Bool
recipeCheckSourceAdmission observation source =
  if not (recipeDomainShape observation ["sources"]) || not (isArray observation.sources) then false
  else
    let matching = filter (\row -> recipeDomainShape row ["source"] && recipeDomainSamePackage row.source source) observation.sources
    if length matching != 1 then false
    else
      let selected = at matching 0
      case lookup selected "admitted" of
        Just true -> true
        _ -> false

@category "engine-internal"
recipeDomainPackageSourceAdmissions : (observation: { sources: List RecipeSourceAdmission }) -> (package: ReifiedFunction) -> Bool
recipeDomainPackageSourceAdmissions observation package =
  let dependencyDomainSourceAdmitted = \dependency ->
        case dependency.outcome of
          Reified { package = child } -> recipeCheckSourceAdmission observation child
          _ -> true
  recipeCheckSourceAdmission observation package &&
  all package.dependencies dependencyDomainSourceAdmitted

@category "engine-internal"
recipeDomainOutcomeSourceAdmissions : (observation: { sources: List RecipeSourceAdmission }) -> (outcome: ReifyOutcome) -> Bool
recipeDomainOutcomeSourceAdmissions observation outcome = case outcome of
  Reified { package = package } -> recipeDomainPackageSourceAdmissions observation package
  _ -> true

@label "Check recipe reflection snapshot"
@description "Check shared reader-generation and dependency-content coherence across the recipe, rule, callable observations and domain helpers before symbolic analysis consumes the snapshot."
recipeCheckReflectionSnapshot : (snapshot: RecipeAnalysisSnapshot) -> Bool
recipeCheckReflectionSnapshot snapshot =
  recipeDomainShape snapshot ["domain", "generation", "recipe", "rule", "callables", "constructorIdentities", "sources", "functions", "representations"] &&
  recipeDomainGeneration snapshot.generation &&
  isArray snapshot.representations && recipeDomainRepresentations snapshot snapshot.domain &&
  recipeDomainConstructorIdentities snapshot.constructorIdentities &&
  recipeDomainPackageSourceAdmissions snapshot snapshot.domain.rankFunction &&
  recipeDomainPackageSourceAdmissions snapshot snapshot.domain.canonicalFunction &&
  recipeDomainPackageSourceAdmissions snapshot snapshot.domain.canonicalAfterFunction &&
  recipeDomainObservedPackage snapshot.constructorIdentities snapshot.recipe snapshot.generation &&
  recipeDomainPackageConstructors snapshot.constructorIdentities snapshot.recipe &&
  isArray snapshot.functions &&
  all snapshot.functions (\outcome -> recipeDomainRuleGeneration snapshot.constructorIdentities outcome snapshot.generation) &&
  recipeDomainRuleGeneration snapshot.constructorIdentities snapshot.rule snapshot.generation &&
  recipeDomainCallableObservations snapshot.constructorIdentities snapshot.callables snapshot.generation &&
  recipeDomainSnapshotConsistent snapshot snapshot.domain

@category "engine-internal"
recipeDomainObservedPackage : (identities: List RecipeConstructorIdentity) -> (package: ReifiedFunction) -> (generation: Maybe Number) -> Bool
recipeDomainObservedPackage identities package generation =
  let observedDomainDependency = \dep ->
        case dep.outcome of
          Reified { package = child } ->
            recipeDomainShape child ["source", "dependencies", "constructors", "generation"] &&
            recipeSourceDataEqual (length child.dependencies) 0 && recipeSourceDataEqual child.generation generation &&
            recipeDomainSource child != "" &&
            recipeDomainConstructorsBridged identities child.constructors
          OpaqueBody { identity = identity } -> recipeSourceDataEqual identity dep.identity
          Unavailable -> true
  recipeDomainShape package ["params", "body", "captures", "source", "dependencies", "constructors", "generation"] &&
  recipeSourceDataEqual package.generation generation && isArray package.dependencies &&
  recipeDomainUnique (map (\dep -> dep.identity) package.dependencies) &&
  all package.dependencies observedDomainDependency

@category "engine-internal"
recipeDomainRuleGeneration : (identities: List RecipeConstructorIdentity) -> (rule: ReifyOutcome) -> (generation: Maybe Number) -> Bool
recipeDomainRuleGeneration identities rule generation = case rule of
  Reified { package = package } -> recipeDomainObservedPackage identities package generation && recipeDomainPackageConstructors identities package
  _ -> true

@category "engine-internal"
recipeDomainCallableObservations : (identities: List RecipeConstructorIdentity) -> (observations: List RecipeCallableObservation) -> (generation: Maybe Number) -> Bool
recipeDomainCallableObservations identities observations generation =
  isArray observations &&
  recipeDomainUnique (map (\observation -> [observation.owner, observation.capture, observation.path]) observations) &&
  all observations (\observation ->
    recipeSourceOwnerValid observation.owner && isString observation.capture && observation.capture != "" && isArray observation.path &&
    all observation.path isString && recipeDomainRuleGeneration identities observation.outcome generation)

-- Reification has a flat graph on EACH reflected root. A single reader
-- snapshot cannot give two different bodies/outcomes to the same named id.
-- Strip only the graph slot before comparing the independently supplied
-- package observations; ordered params, captures, constructor maps, source
-- and generation all remain part of the version.
@category "engine-internal"
recipeDomainPackageRows : (package: ReifiedFunction) -> List Any
recipeDomainPackageRows package =
  let identity = recipeDomainSource package
  let own = if identity == "" then [] else [{ identity = identity, core = mapSet package "dependencies" [] }]
  fold (\rows dependency -> concat rows (recipeDomainDependencyRows dependency)) own package.dependencies

@category "engine-internal"
recipeDomainDependencyRows : (dependency: ReifiedDependency) -> List Any
recipeDomainDependencyRows dependency = case dependency.outcome of
  Reified { package = child } ->
    let actual = recipeDomainSource child
    let core = mapSet child "dependencies" []
    if actual == "" then []
    else if actual == dependency.identity then [{ identity = actual, core = core }]
    else [{ identity = dependency.identity, core = core }, { identity = actual, core = core }]
  other -> [{ identity = dependency.identity, core = other }]

@category "engine-internal"
recipeDomainOutcomeRows : (outcome: ReifyOutcome) -> List Any
recipeDomainOutcomeRows outcome = case outcome of
  Reified { package = package } -> recipeDomainPackageRows package
  OpaqueBody { identity = identity } -> if identity == "" then [] else [{ identity = identity, core = outcome }]
  Unavailable -> []

@category "engine-internal"
recipeDomainSnapshotConsistent : (snapshot: RecipeAnalysisSnapshot) -> (domain: RecipeDomainSnapshot) -> Bool
recipeDomainSnapshotConsistent snapshot domain =
  let roots = [domain.rankFunction, domain.canonicalFunction, domain.canonicalAfterFunction, snapshot.recipe]
  let rootsRows = fold (\rows package -> concat rows (recipeDomainPackageRows package)) [] roots
  let ruleRows = concat rootsRows (recipeDomainOutcomeRows snapshot.rule)
  let functionRows = fold (\rows outcome -> concat rows (recipeDomainOutcomeRows outcome)) ruleRows snapshot.functions
  let rows = fold (\rows observation -> concat rows (recipeDomainOutcomeRows observation.outcome)) functionRows snapshot.callables
  recipeDomainRowsConsistent rows

@category "engine-internal"
recipeDomainSourcesConsistent : (domain: RecipeDomainSnapshot) -> Bool
recipeDomainSourcesConsistent domain =
  let roots = [domain.rankFunction, domain.canonicalFunction, domain.canonicalAfterFunction]
  let rows = fold (\rows package -> concat rows (recipeDomainPackageRows package)) [] roots
  recipeDomainRowsConsistent rows

@category "engine-internal"
recipeDomainRowsConsistent : (rows: List Any) -> Bool
recipeDomainRowsConsistent rows = case head rows of
  -- Every ordered pair of same-identity rows (each row with itself too) must
  -- have equal cores. The bounded judgment answers `Just true` symmetrically
  -- (a lockstep walk), so each unordered pair is asked once, and each row
  -- once with itself: the same answer with half the comparisons.
  Nothing -> true
  Just row ->
    let rest = fromMaybe [] (tail rows)
    recipeSourceDataEqual row.core row.core && all rest (\other -> row.identity != other.identity || recipeSourceDataEqual row.core other.core) && recipeDomainRowsConsistent rest

@category "engine-internal"
recipeDomainFoods : (domain: RecipeDomainSnapshot) -> Bool
recipeDomainFoods domain =
  let inspectDomainFoodType = \unit ->
        case domain.foodType of
          TtVariant { cases = cases, discriminator = discriminator } ->
            (recipeSourceDataEqual discriminator Nothing || recipeSourceDataEqual discriminator (Just "$tag")) &&
            recipeSourceDataEqual (length cases) (length domain.foods) &&
            recipeDomainUnique (map (\variantCase -> variantCase.name) cases) &&
            recipeDomainUnique (map recipeDomainCaseTarget cases) &&
            all cases (\variantCase -> recipeDomainFoodCase domain variantCase)
          _ -> false
  isArray domain.foods && length domain.foods > 0 &&
  all domain.foods (\food -> isString food.identity && food.identity != "" &&
    recipeDomainNatural food.rank && food.rank <= 61) &&
  recipeDomainUnique (map (\food -> food.identity) domain.foods) &&
  recipeDomainUnique (map (\food -> food.rank) domain.foods) &&
  recipeDomainIncreasing (map (\food -> food.rank) domain.foods) &&
  inspectDomainFoodType 0

@category "engine-internal"
recipeDomainIncreasing : (ranks: List Nat) -> Bool
recipeDomainIncreasing ranks = case head ranks of
  Nothing -> true
  Just first -> case head (fromMaybe [] (tail ranks)) of
    Nothing -> true
    Just second -> first < second && recipeDomainIncreasing (fromMaybe [] (tail ranks))

@category "engine-internal"
recipeDomainCaseTarget : (variantCase: TtVariantCase) -> Maybe String
recipeDomainCaseTarget variantCase =
  case lookup variantCase "constructorFunction" of
    Just (Just target) -> if isString target && target != "" then Just target else Nothing
    _ -> Nothing

@category "engine-internal"
recipeDomainFoodCase : (domain: RecipeDomainSnapshot) -> (variantCase: TtVariantCase) -> Bool
recipeDomainFoodCase domain variantCase =
  let inspectDomainFoodCase = \unit ->
        case recipeDomainCaseTarget variantCase of
          Nothing -> false
          Just target ->
            let rows = filter (\food -> recipeSourceDataEqual food.identity target) domain.foods
            recipeSourceDataEqual (length rows) 1 && all rows (\food ->
              recipeSourceDataEqual (length (entries food.value)) 1 && recipeSourceDataEqual (lookup food.value "$tag") (Just variantCase.name))
  recipeSourceDataEqual (length variantCase.fields) 0 &&
  inspectDomainFoodCase 0

@category "engine-internal"
recipeDomainVar : (expr: Expr) -> (name: String) -> Bool
recipeDomainVar expr name = case expr of
  EVar { name = actual } -> recipeSourceDataEqual actual name
  _ -> false

@category "engine-internal"
recipeDomainLiteral : (expr: Expr) -> (value: Any) -> Bool
recipeDomainLiteral expr value = case expr of
  ELit { value = actual } -> recipeSourceDataEqual actual value
  _ -> false

@category "engine-internal"
recipeDomainNoGuard : (arm: Any) -> Bool
recipeDomainNoGuard arm = case lookup arm "guard" of
  Nothing -> true
  Just guard -> false

@category "engine-internal"
recipeDomainPatternFields : (pattern: Any) -> (unary: Bool) -> Bool
recipeDomainPatternFields pattern unary =
  let fields = fromMaybe [] (lookup pattern "fields")
  if recipeSourceDataEqual (length fields) 0 then true
  else if not unary || length fields != 1 then false
  else
    let field = at fields 0
    if isString field then recipeSourceDataEqual field "_0"
    else case lookup field "key" of
      Just (PositionalField { index = index }) -> recipeSourceDataEqual index 0 && recipeSourceDataEqual (lookup field "wireName") (Just "_0")
      _ -> false

@category "engine-internal"
recipeDomainRank : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> Bool
recipeDomainRank snapshot domain =
  let package = domain.rankFunction
  let inspectDomainRankBody = \unit ->
        case package.body of
          EMatch { scrutinee = scrutinee, arms = arms } ->
            recipeDomainVar scrutinee (at package.params 0) &&
            recipeSourceDataEqual (length arms) (length domain.foods) &&
            all domain.foods (\food ->
              recipeSourceDataEqual (length (filter (\arm -> recipeDomainRankArm snapshot package food arm) arms)) 1)
          _ -> false
  recipeSourceDataEqual (length package.params) 1 && inspectDomainRankBody 0

@category "engine-internal"
recipeDomainRankArm : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (package: ReifiedFunction) -> (food: RecipeFoodRank) -> (arm: Any) -> Bool
recipeDomainRankArm snapshot package food arm =
  let inspectDomainRankPattern = \unit ->
        case arm.pattern of
          PatConstruct { ctor = ctor, args = args } ->
            recipeSourceDataEqual (length args) 0 && recipeDomainPatternFields arm.pattern false &&
            recipeSourceDataEqual (recipeDomainConstructor snapshot.constructorIdentities package.constructors ctor) (Just food.identity)
          _ -> false
  recipeDomainNoGuard arm && recipeDomainLiteral arm.body food.rank &&
  inspectDomainRankPattern 0

@category "engine-internal"
recipeDomainCall : (expr: Expr) -> (identity: String) -> (arity: Nat) -> Bool
recipeDomainCall expr identity arity = case expr of
  ECall { fnId = fnId, args = args } -> recipeSourceDataEqual fnId identity && recipeSourceDataEqual (length args) arity && (identity != "and" || recipeDomainStructural expr)
  _ -> false

@category "engine-internal"
recipeDomainStructural : (expr: Expr) -> Bool
recipeDomainStructural expr = case lookup expr "structural" of
  Nothing -> true
  Just true -> true
  _ -> false

@category "engine-internal"
recipeDomainRankCall : (domain: RecipeDomainSnapshot) -> (expr: Expr) -> (food: String) -> Bool
recipeDomainRankCall domain expr food =
  recipeDomainCall expr (recipeDomainSource domain.rankFunction) 1 &&
  recipeDomainVar (at expr.args 0) food

@category "engine-internal"
recipeDomainRest : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (expr: Expr) -> (foods: String) -> Bool
recipeDomainRest snapshot expr foods = case expr of
  ECall { fnId = fnId, args = args } ->
    let inspectDomainTail = \unit ->
          case at args 1 of
            ECall { fnId = tailId, args = tailArgs } ->
              recipeDomainPrimitiveCall snapshot RecipeTail tailId && recipeSourceDataEqual (length tailArgs) 1 &&
              recipeDomainVar (at tailArgs 0) foods
            _ -> false
    recipeDomainPrimitiveCall snapshot RecipeFromMaybe fnId && recipeSourceDataEqual (length args) 2 &&
    recipeDomainLiteral (at args 0) [] &&
    inspectDomainTail 0
  _ -> false

@category "engine-internal"
recipeDomainCanonical : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> Bool
recipeDomainCanonical snapshot domain =
  let canonical = domain.canonicalFunction
  let after = domain.canonicalAfterFunction
  recipeDomainMaybePrimitives snapshot &&
  recipeDomainSource canonical != recipeDomainSource after &&
  recipeDomainSource canonical != recipeDomainSource domain.rankFunction &&
  recipeDomainSource after != recipeDomainSource domain.rankFunction &&
  recipeSourceDataEqual (length canonical.params) 1 && recipeSourceDataEqual (length after.params) 2 &&
  recipeDomainDependency canonical domain.rankFunction && recipeDomainDependency canonical after &&
  recipeDomainDependency after domain.rankFunction &&
  recipeDomainCanonicalMatch snapshot domain canonical false &&
  recipeDomainCanonicalMatch snapshot domain after true

@category "engine-internal"
recipeDomainMaybePrimitives : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> Bool
recipeDomainMaybePrimitives snapshot =
  let admittedDomainMaybeRole = \role ->
        case recipeDomainPrimitive snapshot role of
          Nothing -> false
          Just primitive -> primitive.admitted && all ["Nothing", "Just"] (\name -> recipeDomainMaybeSame snapshot primitive name)
  all [RecipeTail, RecipeFromMaybe] admittedDomainMaybeRole

@category "engine-internal"
recipeDomainMaybeSame : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (primitive: RecipePrimitiveAdmission) -> (name: String) -> Bool
recipeDomainMaybeSame snapshot primitive name =
  let expected = recipeDomainMaybeTarget snapshot name
  not (recipeSourceDataEqual expected Nothing) && recipeSourceDataEqual (recipeDomainConstructor snapshot.constructorIdentities primitive.constructors name) expected

@category "engine-internal"
recipeDomainCanonicalMatch : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (package: ReifiedFunction) -> (recursive: Bool) -> Bool
recipeDomainCanonicalMatch snapshot domain package recursive =
  let foods = at package.params (if recursive then 1 else 0)
  case package.body of
    EMatch { scrutinee = scrutinee, arms = arms } ->
      let inspectDomainCanonicalScrutinee = \unit ->
            case scrutinee of
              ECall { fnId = headId, args = headArgs } ->
                recipeDomainPrimitiveCall snapshot RecipeHead headId && recipeSourceDataEqual (length headArgs) 1 &&
                recipeDomainVar (at headArgs 0) foods &&
                recipeDomainCanonicalArm snapshot domain package foods recursive (at arms 0) false &&
                recipeDomainCanonicalArm snapshot domain package foods recursive (at arms 1) true
              _ -> false
      recipeSourceDataEqual (length arms) 2 &&
      inspectDomainCanonicalScrutinee 0
    _ -> false

@category "engine-internal"
recipeDomainMaybeTarget : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (written: String) -> Maybe String
recipeDomainMaybeTarget snapshot written =
  case recipeDomainPrimitive snapshot RecipeHead of
    Just primitive -> recipeDomainConstructor snapshot.constructorIdentities primitive.constructors written
    Nothing -> Nothing

@category "engine-internal"
recipeDomainCanonicalArm : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (package: ReifiedFunction) -> (foods: String) -> (recursive: Bool) -> (arm: Any) -> (just: Bool) -> Bool
recipeDomainCanonicalArm snapshot domain package foods recursive arm just =
  if not (recipeDomainNoGuard arm) then false
  else case arm.pattern of
    PatConstruct { ctor = ctor, args = args } ->
      let wanted = recipeDomainMaybeTarget snapshot (if just then "Just" else "Nothing")
      if recipeSourceDataEqual wanted Nothing || not (recipeSourceDataEqual (recipeDomainConstructor snapshot.constructorIdentities package.constructors ctor) wanted) then false
      else if not just then recipeSourceDataEqual (length args) 0 && recipeDomainPatternFields arm.pattern false && recipeDomainLiteral arm.body true
      else if length args != 1 || not (recipeDomainPatternFields arm.pattern true) then false
      else case at args 0 of
        PatVar { name = food } ->
          if not (recipeDomainBinder food) || food == foods || elem food package.params then false
          else recipeDomainGuardedBody snapshot domain arm.body recursive (if recursive then at package.params 0 else "") foods food
        _ -> false
    _ -> false

@category "engine-internal"
recipeDomainGuardedBody : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (expr: Expr) -> (recursive: Bool) -> (previous: String) -> (foods: String) -> (food: String) -> Bool
recipeDomainGuardedBody snapshot domain expr recursive previous foods food =
  let conjunction =
    if recipeDomainCall expr "and" 2 then true
    else if recipeDomainCall expr "if" 3 then
      recipeSourceDataEqual (lookup expr "structural") (Just true) && recipeDomainLiteral (at expr.args 2) false
    else false
  if not conjunction then false
  else if not (recipeDomainFoodGuardCall snapshot domain (at expr.args 0) food) then false
  else if recursive then recipeDomainAfterBody snapshot domain (at expr.args 1) previous foods food
  else recipeDomainNext snapshot domain (at expr.args 1) foods food

@category "engine-internal"
recipeDomainFoodGuardCall : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (expr: Expr) -> (food: String) -> Bool
recipeDomainFoodGuardCall snapshot domain expr food = case expr of
  ECall { fnId = identity, args = args } ->
    if length args != 1 || not (recipeDomainVar (at args 0) food) then false
    else case head (filter (\dependency -> recipeSourceDataEqual dependency.identity identity) domain.canonicalFunction.dependencies) of
      Just dependency -> case dependency.outcome of
        Reified { package = package } ->
          recipeDomainDependency domain.canonicalAfterFunction package && recipeDomainFoodGuard snapshot domain package
        _ -> false
      Nothing -> false
  _ -> false

@category "engine-internal"
recipeDomainFoodGuard : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (package: ReifiedFunction) -> Bool
recipeDomainFoodGuard snapshot domain package =
  if not (recipeDomainPackageShape package) || length package.params != 1 then false
  else case package.body of
    EMatch { scrutinee = scrutinee, arms = arms } ->
      recipeDomainVar scrutinee (at package.params 0) && length arms == length domain.foods + 1 &&
      recipeDomainFoodGuardFallback (at arms (length domain.foods)) &&
      all domain.foods (\food -> length (filter (\arm -> recipeDomainFoodGuardArm snapshot package food arm) arms) == 1)
    _ -> false

@category "engine-internal"
recipeDomainFoodGuardFallback : (arm: Any) -> Bool
recipeDomainFoodGuardFallback arm =
  if not (recipeDomainNoGuard arm) || not (recipeDomainLiteral arm.body false) then false
  else case arm.pattern of
    PatWildcard -> true
    PatLit { value = value } -> recipeSourceDataEqual value "_"
    _ -> false

@category "engine-internal"
recipeDomainFoodGuardArm : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (package: ReifiedFunction) -> (food: RecipeFoodRank) -> (arm: Any) -> Bool
recipeDomainFoodGuardArm snapshot package food arm =
  if not (recipeDomainNoGuard arm) then false
  else case arm.pattern of
    PatConstruct { ctor = ctor, args = args } ->
      if length args != 0 || not (recipeDomainPatternFields arm.pattern false) then false
      else if not (recipeSourceDataEqual (recipeDomainConstructor snapshot.constructorIdentities package.constructors ctor) (Just food.identity)) then false
      else case arm.body of
        ECall { fnId = eqId, args = eqArgs } ->
          if not (recipeDomainPrimitiveCall snapshot RecipeEq eqId) || length eqArgs != 2 then false
          else if not (recipeDomainVar (at eqArgs 0) (at package.params 0)) then false
          else case at eqArgs 1 of
            EConstruct { ctor = written, args = constructorArgs } ->
              length constructorArgs == 0 && recipeDomainPatternFields (at eqArgs 1) false &&
              recipeSourceDataEqual (recipeDomainConstructor snapshot.constructorIdentities package.constructors written) (Just food.identity)
            _ -> false
        _ -> false
    _ -> false

@category "engine-internal"
recipeDomainNext : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (expr: Expr) -> (foods: String) -> (food: String) -> Bool
recipeDomainNext snapshot domain expr foods food =
  recipeDomainCall expr (recipeDomainSource domain.canonicalAfterFunction) 2 &&
  recipeDomainRankCall domain (at expr.args 0) food &&
  recipeDomainRest snapshot (at expr.args 1) foods

@category "engine-internal"
recipeDomainAfterBody : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (expr: Expr) -> (previous: String) -> (foods: String) -> (food: String) -> Bool
recipeDomainAfterBody snapshot domain expr previous foods food =
  let conjunction =
    if recipeDomainCall expr "and" 2 then true
    else if recipeDomainCall expr "if" 3 then
      recipeSourceDataEqual (lookup expr "structural") (Just true) && recipeDomainLiteral (at expr.args 2) false
    else false
  let inspectDomainAfterComparison = \unit ->
        case at expr.args 0 of
          ECall { fnId = lessId, args = args } ->
            recipeDomainPrimitiveCall snapshot RecipeLess lessId && recipeSourceDataEqual (length args) 2 &&
            recipeDomainVar (at args 0) previous && recipeDomainRankCall domain (at args 1) food &&
            recipeDomainNext snapshot domain (at expr.args 1) foods food
          _ -> false
  if conjunction then inspectDomainAfterComparison 0 else false

-- Reserved system.List bindings are inert identities OBSERVED at the fixed
-- canonical system handles by the reader boundary, never authored bindings.
-- Ordinary source names still close through the declaration's own bindings.
-- The List spine must be exact; the permissive peelList helper alone omits
-- both recursive-tail checks and therefore cannot establish this premise.
@category "engine-internal"
recipeDomainDeclarations : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> Bool
recipeDomainDeclarations snapshot domain =
  recipeDomainDeclaration snapshot domain RecipePantryDeclaration domain.pantryType false &&
  recipeDomainDeclaration snapshot domain RecipeIngredientsDeclaration domain.ingredientsType true

@category "engine-internal"
recipeDomainDeclaration : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (role: RecipeDeclarationRole) -> (type: TraversalType) -> (nonempty: Bool) -> Bool
recipeDomainDeclaration snapshot domain role type nonempty =
  let scope = recipeDomainScope domain role
  case type of
    TtRefined { base = base, setView = setView } ->
      let inspectDomainRefinementSet = \unit ->
            case setView of
              SeWhere { pred = pred } -> recipeDomainPredicate snapshot domain scope pred nonempty
              _ -> false
      recipeDomainList domain scope base &&
      inspectDomainRefinementSet 0
    _ -> false

@category "engine-internal"
recipeDomainRequiredBinding : (scope: RecipeDeclarationScope) -> (name: String) -> String
recipeDomainRequiredBinding scope name = fromMaybe "" (recipeDomainBinding scope name)

@category "engine-internal"
recipeDomainList : (domain: RecipeDomainSnapshot) -> (scope: RecipeDeclarationScope) -> (type: TraversalType) -> Bool
recipeDomainList domain scope type =
  let owner = recipeDomainRequiredBinding scope "system.List"
  case type of
    TtOpaque { name = name, pure = pure } ->
      let inspectDomainListPure = \unit ->
            case pure of
              TtVariant { cases = cases, discriminator = discriminator } ->
                (recipeSourceDataEqual discriminator Nothing || recipeSourceDataEqual discriminator (Just "$tag")) &&
                recipeSourceDataEqual (length cases) 2 &&
                recipeSourceDataEqual (length (filter (\variantCase -> recipeDomainListNil scope variantCase) cases)) 1 &&
                recipeSourceDataEqual (length (filter (\variantCase -> recipeDomainListCons domain scope owner variantCase) cases)) 1
              _ -> false
      recipeDomainBoundTo scope name owner && recipeDomainListOwner type owner &&
      inspectDomainListPure 0
    _ -> false

@category "engine-internal"
recipeDomainListNil : (scope: RecipeDeclarationScope) -> (variantCase: TtVariantCase) -> Bool
recipeDomainListNil scope variantCase =
  recipeSourceDataEqual (length variantCase.fields) 0 &&
  recipeDomainListConstructor scope variantCase "Nil" "system.List.Nil"

@category "engine-internal"
recipeDomainListOwner : (type: TraversalType) -> (owner: String) -> Bool
recipeDomainListOwner type owner =
  case lookup type "readerCanonicalOwner" of
    Just (Just facts) -> owner != "" && recipeSourceDataEqual facts.readerOwnerIdentity owner && recipeSourceDataEqual facts.expectedSystemIdentity owner
    _ -> false

@category "engine-internal"
recipeDomainListConstructor : (scope: RecipeDeclarationScope) -> (variantCase: TtVariantCase) -> (wire: String) -> (binding: String) -> Bool
recipeDomainListConstructor scope variantCase wire binding =
  let expected = recipeDomainBinding scope binding
  let inspectDomainListConstructor = \unit ->
        case lookup variantCase "constructorFunction" of
          Nothing -> true
          Just (Just identity) -> recipeSourceDataEqual (Just identity) expected
          _ -> false
  recipeSourceDataEqual variantCase.name wire && not (recipeSourceDataEqual expected Nothing) &&
  inspectDomainListConstructor 0

@category "engine-internal"
recipeDomainNamedField : (field: TtField) -> (identity: String) -> Bool
recipeDomainNamedField field identity =
  let inspectDomainNamedKey = \unit ->
        case field.semanticKey of
          NamedField { ref = ref } -> recipeSourceDataEqual (lookup ref "$ref") (Just identity)
          _ -> false
  identity != "" && inspectDomainNamedKey 0

@category "engine-internal"
recipeDomainListCons : (domain: RecipeDomainSnapshot) -> (scope: RecipeDeclarationScope) -> (owner: String) -> (variantCase: TtVariantCase) -> Bool
recipeDomainListCons domain scope owner variantCase =
  let heads = filter (\field -> recipeDomainNamedField field (recipeDomainRequiredBinding scope "system.List.head")) variantCase.fields
  let tails = filter (\field -> recipeDomainNamedField field (recipeDomainRequiredBinding scope "system.List.tail")) variantCase.fields
  if length heads != 1 || length tails != 1 then false
  else
    let headField = at heads 0
    let tailField = at tails 0
    let inspectDomainListTail = \unit ->
          case tailField.type of
            TtNamed { name = name, origin = origin } -> recipeSourceDataEqual origin "ref" && recipeDomainBoundTo scope name owner
            _ -> false
    recipeDomainListConstructor scope variantCase "Cons" "system.List.Cons" &&
    recipeSourceDataEqual (length variantCase.fields) 2 &&
    recipeDomainRequiredBinding scope "system.List.head" != recipeDomainRequiredBinding scope "system.List.tail" &&
    recipeDomainFoodReference domain scope headField.type &&
    inspectDomainListTail 0

@category "engine-internal"
recipeDomainFoodReference : (domain: RecipeDomainSnapshot) -> (scope: RecipeDeclarationScope) -> (type: TraversalType) -> Bool
recipeDomainFoodReference domain scope type =
  let foodScope = recipeDomainScope domain RecipeFoodDeclaration
  case type of
    TtNamed { name = name, origin = origin } ->
      recipeSourceDataEqual origin "ref" && recipeDomainBoundTo scope name foodScope.owner
    _ -> false

-- Raw JSON predicate matching is deliberately small and exact. The host
-- supplies it unchanged; Fenel closes call heads using captured source scope.
-- No named-refinement shortcut or host predicate fingerprint is accepted.
@category "engine-internal"
recipeDomainRawCall : (value: Any) -> Maybe (List Any)
recipeDomainRawCall value =
  if not (recipeSourceDataEqual (length (entries value)) 1) then Nothing
  else case lookup value "call" of
    Just args -> if isArray args then Just args else Nothing
    Nothing -> Nothing

@category "engine-internal"
recipeDomainRawValue : (value: Any) -> Bool
recipeDomainRawValue value = recipeSourceDataEqual (length (entries value)) 1 && recipeSourceDataEqual (lookup value "var") (Just "value")

@category "engine-internal"
recipeDomainRawCanonical : (domain: RecipeDomainSnapshot) -> (scope: RecipeDeclarationScope) -> (pred: Any) -> Bool
recipeDomainRawCanonical domain scope pred =
  case recipeDomainRawCall pred of
    Just args -> recipeSourceDataEqual (length args) 2 && recipeDomainBoundTo scope (at args 0) (recipeDomainSource domain.canonicalFunction) && recipeDomainRawValue (at args 1)
    Nothing -> false

@category "engine-internal"
recipeDomainPredicate : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (domain: RecipeDomainSnapshot) -> (scope: RecipeDeclarationScope) -> (pred: Any) -> (nonempty: Bool) -> Bool
recipeDomainPredicate snapshot domain scope pred nonempty =
  if not nonempty then recipeDomainRawCanonical domain scope pred
  else if not (recipeSourceDataEqual (length (entries pred)) 1) then false
  else case lookup pred "and" of
    Just terms ->
      isArray terms && recipeSourceDataEqual (length terms) 2 &&
      recipeDomainRawCanonical domain scope (at terms 0) &&
      recipeDomainRawNonempty snapshot scope (at terms 1)
    Nothing -> case lookup pred "if" of
      Just terms ->
        if not (isArray terms) then false
        else if not (recipeSourceDataEqual (length terms) 3) then false
        else
          recipeDomainRawCanonical domain scope (at terms 0) &&
          recipeDomainRawNonempty snapshot scope (at terms 1) &&
          recipeSourceDataEqual (at terms 2) false
      Nothing -> false

@category "engine-internal"
recipeDomainRawNonempty : (snapshot: { domain: RecipeDomainSnapshot, primitives: List RecipePrimitiveAdmission, generation: Maybe Number, constructorIdentities: List RecipeConstructorIdentity, sources: List RecipeSourceAdmission, representations: List RecipeRepresentationAdmission }) -> (scope: RecipeDeclarationScope) -> (pred: Any) -> Bool
recipeDomainRawNonempty snapshot scope pred =
  case recipeDomainRawCall pred of
    Just args ->
      let inspectDomainGreaterBinding = \unit ->
            case recipeDomainBinding scope (at args 0) of
              Just identity ->
                let inspectDomainLengthCall = \unit ->
                      case recipeDomainRawCall (at args 1) of
                        Just lengthArgs ->
                          let inspectDomainLengthBinding = \unit ->
                                case recipeDomainBinding scope (at lengthArgs 0) of
                                  Just lengthId -> recipeDomainPrimitiveCall snapshot RecipeLength lengthId
                                  Nothing -> false
                          recipeSourceDataEqual (length lengthArgs) 2 && recipeDomainRawValue (at lengthArgs 1) &&
                          inspectDomainLengthBinding 0
                        Nothing -> false
                recipeDomainPrimitiveCall snapshot RecipeGreater identity &&
                inspectDomainLengthCall 0
              Nothing -> false
      recipeSourceDataEqual (length args) 3 && recipeSourceDataEqual (at args 2) 0 &&
      inspectDomainGreaterBinding 0
    Nothing -> false
