module engine where

using prover (structuralPropose, UnprovedReason, VerifyError, EpistemicStatus)
using kernel (kernelVerify)

-- Closed finite subset examples. These are composition of existing proposer
-- and kernel entries, not a decision or evidence rule. Inputs cannot author
-- a named set, predicate, recursive set, inhabited claim or proof term.
@category "engine-internal"
finiteClaimNumberAdmitted : (candidate: Number) -> Bool
finiteClaimNumberAdmitted candidate = isNumber candidate && numberIsFinite candidate && candidate >= -20 && candidate <= 20 && floor candidate == candidate

@category "engine-internal"
finiteClaimCurrencyAdmitted : (candidate: String) -> Bool
finiteClaimCurrencyAdmitted candidate = isString candidate && length candidate == 3

@category "engine-internal"
finiteClaimRefused : (reason: String) -> ({ claim: Any, proposal: Result UnprovedReason Any, verdict: Maybe (Result VerifyError EpistemicStatus) })
finiteClaimRefused reason = { claim = { refusal = reason }, proposal = Err (OutOfScope { note = reason }), verdict = Nothing }

@category "engine-internal"
finiteClaimSubsetPipeline : (members: List Any) -> (allowed: List Any) -> ({ claim: Any, proposal: Result UnprovedReason Any, verdict: Maybe (Result VerifyError EpistemicStatus) })
finiteClaimSubsetPipeline members allowed =
  let left = SeEnum { values = members }
  let right = SeEnum { values = allowed }
  let claim = propSubset left right
  let proposal = structuralPropose claim
  case proposal of
    Ok proof -> { claim = claim, proposal = proposal, verdict = Just (kernelVerify claim proof) }
    Err reason -> { claim = claim, proposal = proposal, verdict = Nothing }

@label "Closed finite number subset certificate"
@description "Bounded composition for public claim examples: only two lists of at most 12 whole numbers from -20 through 20 are admitted. Build an enum-only subset judgment, ask the existing structural proposer and preserve the exact existing kernel verdict. No arbitrary set, expression or proof input is accepted."
@category "engine-internal"
finiteNumberSubsetCertificate : (members: List Number) -> (allowed: List Number) -> ({ claim: Any, proposal: Result UnprovedReason Any, verdict: Maybe (Result VerifyError EpistemicStatus) })
finiteNumberSubsetCertificate members allowed =
  if isArray members && isArray allowed && length members <= 12 && length allowed <= 12 && all members finiteClaimNumberAdmitted && all allowed finiteClaimNumberAdmitted
  then finiteClaimSubsetPipeline members allowed
  else finiteClaimRefused "Use at most 12 whole numbers from -20 through 20 in each set."

@label "Closed finite currency subset certificate"
@description "Bounded composition for public claim examples: only two lists of at most 12 three-character currency-code strings are admitted. Build an enum-only subset judgment, ask the existing structural proposer and preserve the exact existing kernel verdict. No arbitrary set, expression or proof input is accepted."
@category "engine-internal"
finiteCurrencySubsetCertificate : (requested: List String) -> (supported: List String) -> ({ claim: Any, proposal: Result UnprovedReason Any, verdict: Maybe (Result VerifyError EpistemicStatus) })
finiteCurrencySubsetCertificate requested supported =
  if isArray requested && isArray supported && length requested <= 12 && length supported <= 12 && all requested finiteClaimCurrencyAdmitted && all supported finiteClaimCurrencyAdmitted
  then finiteClaimSubsetPipeline requested supported
  else finiteClaimRefused "Use at most 12 three-character currency codes in each set."

-- =========================================================================
-- proposeDecidableSet / proposeSampleTest / proposeMonotonic — the pure
-- proposer arms of `fenel/modules/prover/ffi/prover-ffi.ts`, Fenel-bodied.
-- expr-substrate Phase 6b0 (brief:
-- `workstreams/expr-substrate/briefs/phase-6b0-prover-fenel-port.md`).
--
-- The prover module's REGISTERED surface is untouched: the `prover:*Propose`
-- fnIds, arities, and natives-map keys stay (the 8 Prover dispatch instances
-- name them; the dispatch-oracle corpus pins them). What moved here is the
-- LOGIC inside the natives: the proposition routing, the structured-
-- Proposition guard (`startsWith propTag "Prop"` — the isProposition
-- mirror), the per-shape Ok/Err grading, the witness construction (plain
-- {left, right} records — authorable, only the outer `$tag` layer is the
-- TS map's), and every note/message. The natives shrank to marshal +
-- pre-compute + dispatch + map bridges.
--
-- PRE-COMPUTED FACTS (the `$`-key / host-re-entry boundary):
--   decision   — "true" | "false" | "unknown": the tri-state decide outcome
--                (isSubset / isDisjoint / decideEmpty per the proposition's
--                tag — the set-algebra re-run is the justified bridge; its
--                TS dispatchers already route through the Fenel
--                set-algebra-deciders mirrors where ported)
--   samplesCount — PropForall's inline samples length (0 when absent —
--                the `!samples || samples.length === 0` collapse)
--   isAgg / hasMethods / monoTag / monoShapeOk — the Aggregable registry
--                reads + `$tag`/typeof extractions (host registry bridge)
--
-- OUTCOME MARKERS (plain records; TS maps to Ok ProofTerm / Err
-- UnprovedReason `$tag` shapes):
--   { tag = "Ok", kind, witness = { left, right? } }      — DecidableSetResult
--   { tag = "Ok", ptag = "SampleTestResult", propertyId, samplesChecked, allPassed }
--   { tag = "Err", rtag = "OutOfScope"|"Undecided"|"BudgetExceeded", note }
--   { tag = "Err", rtag = "WitnessError", counterexample = { … } }
--
-- The three NON-ported natives (reductionProver / compilableSemanticCheck /
-- partialEvaluatorSoundnessCheck) are genuine host bridges (evaluator /
-- `new Function` / partialEval re-entry) — see prover-ffi.ts's per-fn
-- category ledger.
-- =========================================================================

@label "Propose decidable set"
@description "The DecidableSetProver's routing + grading, Fenel-bodied (expr-substrate Phase 6b0; PropInhabited arm 6b; PLAN-DRIVEN decide-substrate Phase 2 K3): the claim — a closed-sum Proposition (compat until K4) or a JUDGMENT (JEmpty/JInhabited, the K2+ producer currency) — resolves through the shared shape recognizer (recheckPlan, judgment.fenel) to the re-check plan {kind, s, t}; kinds subset/disjoint/empty grade the pre-computed tri-state decide outcome ('true' ⇒ Ok with the {left, right?} witness from the plan's ORIGINAL (s, t); 'false' ⇒ Err WitnessError with the refutation counterexample; 'unknown' ⇒ Err Undecided). Kind nonempty INVERTS the decideEmpty outcome ('false' = non-empty ⇒ Ok kind=nonempty; 'true' = empty ⇒ Err WitnessError inhabited-refuted). Non-decidable claims ⇒ OutOfScope (Prop-prefixed ⇒ 'doesn't handle'; anything else ⇒ 'expects a structured Proposition'). Returns a plain-record marker; the TS native maps it to the Ok ProofTerm / Err UnprovedReason shapes. The decide itself (isSubset/isDisjoint/decideEmpty) is the justified TS re-entry bridge, keyed on the SAME plan."
@tags "engine" "prover" "propose" "judgment" "expr-substrate" "phase-6b0" "decide-substrate" "phase-2"
proposeDecidableSet : (propTag: String) -> (prop: a) -> (decision: String) -> a
proposeDecidableSet propTag prop decision =
  let plan = recheckPlan propTag prop
  if eq plan.kind "subset"
  then
    if eq decision "true" then proposeSubsetOk plan
    else if eq decision "false" then { tag = "Err", rtag = "WitnessError", counterexample = { kind = "subset-refuted", left = plan.s, right = plan.t } }
    else { tag = "Err", rtag = "Undecided", note = "isSubset returned Nothing for the supplied pair" }
  else if eq plan.kind "disjoint"
  then
    if eq decision "true" then { tag = "Ok", kind = "disjoint", witness = { left = plan.s, right = plan.t } }
    else if eq decision "false" then { tag = "Err", rtag = "WitnessError", counterexample = { kind = "disjoint-refuted", left = plan.s, right = plan.t } }
    else { tag = "Err", rtag = "Undecided", note = "isDisjoint returned Nothing for the supplied pair" }
  else if eq plan.kind "empty"
  then
    if eq decision "true" then { tag = "Ok", kind = "empty", witness = { left = plan.s } }
    else if eq decision "false" then { tag = "Err", rtag = "WitnessError", counterexample = { kind = "empty-refuted", set = plan.s } }
    else { tag = "Err", rtag = "Undecided", note = "decideEmpty returned Nothing for the supplied set" }
  else if eq plan.kind "nonempty"
  then
    if eq decision "false" then { tag = "Ok", kind = "nonempty", witness = { left = plan.s } }
    else if eq decision "true" then { tag = "Err", rtag = "WitnessError", counterexample = { kind = "inhabited-refuted", set = plan.s } }
    else proposeNonemptyViaSearch plan.s
  else
    if startsWith propTag "Prop"
    then { tag = "Err", rtag = "OutOfScope", note = concat "DecidableSetProver doesn't handle " propTag }
    else { tag = "Err", rtag = "OutOfScope", note = "DecidableSetProver expects a structured Proposition" }

-- proposeNonemptyViaSearch — decide-substrate Phase 4 Step E: the nonempty
-- claim's decideEmpty came back Nothing (undecided), so the untrusted search
-- driver tries to EXHIBIT an inhabitant. `SvFound w` ⇒ the kind="witness"
-- DecidableSetResult (the K3 witness-membership arm's FIRST producer — the
-- kernel re-checks {w} ⊆ s, OBJECT-complete since Phase 3 D; a tampered witness
-- is rejected by that re-check). No witness ⇒ Undecided (unchanged). This CLOSES
-- the certificates-by-construction loop: untrusted search → witness → kernel
-- re-check. NOTE — the witness rule fires ONLY for a JInhabited/PropInhabited
-- claim (verifyWitnessMembership gates on propTag "JInhabited"); the nonempty
-- plan.kind is exactly that claim, so the emission is sound-by-construction.
@label "Propose nonempty via search"
@description "decide-substrate Phase 4 Step E — the nonempty (JInhabited) arm's search widening: when decideEmpty is undecided (decision \"unknown\"), run the fuel-bounded witness search over the set; SvFound w ⇒ the kind=\"witness\" DecidableSetResult (the K3 witness-membership rule's first producer — the kernel re-checks {w} ⊆ s, so an untrusted or tampered witness is rejected); no witness ⇒ Undecided. Returns a plain-record marker; the TS native maps kind=\"witness\" to the witness ProofTerm. Internal helper."
@tags "engine" "prover" "propose" "search" "witness" "decide-substrate" "phase-4"
@category "engine-internal"
proposeNonemptyViaSearch : (s: a) -> a
proposeNonemptyViaSearch s =
  case svToMaybe (searchDefault s) of
    Just w -> { tag = "Ok", kind = "witness", witness = { left = w } }
    Nothing -> { tag = "Err", rtag = "Undecided", note = "decideEmpty returned Nothing and search found no witness for the supplied set" }

-- proposeSubsetOk — decide-substrate Phase 8μ.2: the subset arm's Ok branch. The
-- deciders proved `s ⊆ t` (decision "true"); choose the CERTIFICATE. When `s` is
-- a μ (SeMu) the STRONGER Park certificate is emitted — kind "mu-induction" —
-- so the kernel RE-DERIVES the premise `F[X:=T]` itself (verifyMuInduction)
-- rather than trusting the pre-computed decision (the first new trusted-kernel
-- rule since the witness rule; the de-Bruijn posture SHARPENED for μ-subset).
-- A non-μ `s` keeps the ordinary kind "subset" certificate. This is the sibling
-- of proposeNonemptyViaSearch (the witness proposer) — same file, same shape.
-- Sound-by-construction: the kernel re-derives from the CLAIM, so even here the
-- emitted witness {left, right} is a convenience the kernel need not trust.
@label "Propose subset ok"
@description "decide-substrate Phase 8μ.2 — the subset arm's Ok-certificate chooser: when the subset LHS `s` is a μ (SeMu), emit the STRONGER Park certificate kind=\"mu-induction\" (the kernel re-derives the premise F[X:=T] via verifyMuInduction — the first new trusted-kernel rule since the witness rule); else the ordinary kind=\"subset\" certificate. Both carry the {left = s, right = t} witness (a convenience — the kernel re-derives from the claim's recognized (s, t), so a tampered witness cannot fool it). Returns a plain-record marker; the TS native maps kind=\"mu-induction\" to the DecidableSetResult ProofTerm (the ledgered $-key marshal). Internal helper."
@tags "engine" "prover" "propose" "judgment" "mu" "park" "decide-substrate" "phase-8mu"
@category "engine-internal"
proposeSubsetOk : (plan: a) -> a
proposeSubsetOk plan = case plan.s of
  SeMu {} -> { tag = "Ok", kind = "mu-induction", witness = { left = plan.s, right = plan.t } }
  _ -> { tag = "Ok", kind = "subset", witness = { left = plan.s, right = plan.t } }

-- propForallSet — decide-substrate Phase 8μ.3 (Step D): the ∀-presentation
-- builder. The judgment iso's PropForall row (`judgment.fenel` header:
-- `PropForall x∈S.P ⟺ S ⊆ ⟦P⟧`) made CALLABLE, proposer-side: present
-- `∀ varName ∈ domain. property` as the subset judgment
-- `domain ⊆ comprehend varName property`. When the domain is a SeMu the
-- SHIPPED 8μ.2 pipeline carries the claim end-to-end — proposeSubsetOk emits
-- the mu-induction certificate, verifyMuInduction re-derives the premise
-- `F[X:=T]` and re-checks it through decideSubset, whose per-ctor obligations
-- decide via the 8μ.3 ctor⊆comprehension arm (setAlgebraCtorSubsetWhere) —
-- the first genuine structural-induction proofs, graded SolverChecked. The
-- SAMPLE presentation (PropForall → per-sample host evaluation, kernel.fenel)
-- is UNTOUCHED: this builder is the μ-shaped-domain alternative producers opt
-- into (the law corpus has zero μ-∀ claims at HEAD — DischargeStats
-- bit-stable by construction). NO kernel edit: the claim IS an ordinary
-- subset judgment; recheckPlan/verifyMuInduction consume it unchanged.
@label "Prop: forall over a set"
@description "decide-substrate Phase 8μ.3 (Step D) — the ∀-presentation builder: `propForallSet varName domain property` presents `∀ varName ∈ domain. property` as the subset judgment `domain ⊆ ⟦{varName | property}⟧` = `propSubset domain (comprehend varName property)` (the judgment iso's PropForall row made callable — judgment.fenel header). A SeMu domain rides the shipped Park pipeline (proposeSubsetOk mu-induction cert → verifyMuInduction premise re-derivation → the 8μ.3 ctor⊆comprehension arm) to SolverChecked — the first genuine structural-induction proofs. The SAMPLE presentation stays untouched (the μ-shaped-domain alternative, producer-opt-in)."
@tags "engine" "prover" "judgment" "builder" "forall" "mu" "park" "decide-substrate" "phase-8mu"
propForallSet : (varName: String) -> (domain: a) -> (property: Expr) -> b
propForallSet varName domain property =
  propSubset domain (comprehend varName property)

@label "Propose sample test"
@description "The generic SampleTestProver's honest fence: guards the structured-Proposition shape, requires PropForall and a non-empty inline samples list, and preserves the 200-sample budget. An admitted sample count still returns Undecided because this producer receives no property evaluation result; it cannot claim SampleTested evidence. Genuine law-discharge sampling evaluates the declared property through its separate existing path. Returns a plain-record marker; the TS native maps it."
@tags "engine" "prover" "propose" "expr-substrate" "phase-6b0"
proposeSampleTest : (propTag: String) -> (propertyId: String) -> (samplesCount: Number) -> a
proposeSampleTest propTag propertyId samplesCount =
  if not (startsWith propTag "Prop")
  then { tag = "Err", rtag = "OutOfScope", note = "SampleTestProver expects a structured Proposition" }
  else if not (eq propTag "PropForall")
  then { tag = "Err", rtag = "OutOfScope", note = concat "SampleTestProver doesn't handle " propTag }
  else if lte samplesCount 0
  then { tag = "Err", rtag = "Undecided", note = "SampleTestProver needs an inline `samples` array; future versions will pull from Exemplifiable instances" }
  else if gt samplesCount 200
  then { tag = "Err", rtag = "BudgetExceeded", note = concat "SampleTestProver: sample list (" (concat (toString samplesCount) ") exceeds budget (200); pass a smaller list or raise the budget") }
  else { tag = "Err", rtag = "Undecided", note = "SampleTestProver has not evaluated the property on its samples; a sample count is not SampleTested evidence" }

@label "Propose monotonic"
@description "The MonotonicityProver's decision ladder, Fenel-bodied (expr-substrate Phase 6b0): requires the PropMonotonic shape (shapeOk — the `$tag`/typeof extraction is the TS boundary), a registered Aggregable instance (isAgg — registry bridge), resolvable methods (hasMethods), a well-formed monotonicity value (monoShapeOk); a Monotone tag ⇒ the SampleTestResult claim `Monotonic.<agg>` (1 sample); any other tag ⇒ Err WitnessError { kind = monotonicity-refuted, agg, monotonicity }. Returns a plain-record marker; the TS native maps it."
@tags "engine" "prover" "propose" "expr-substrate" "phase-6b0"
proposeMonotonic : (shapeOk: Bool) -> (aggName: String) -> (isAgg: Bool) -> (hasMethods: Bool) -> (monoShapeOk: Bool) -> (monoTag: String) -> a
proposeMonotonic shapeOk aggName isAgg hasMethods monoShapeOk monoTag =
  if not shapeOk
  then { tag = "Err", rtag = "OutOfScope", note = "MonotonicityProver expects PropMonotonic" }
  else if not isAgg
  then { tag = "Err", rtag = "Undecided", note = concat "MonotonicityProver: '" (concat aggName "' is not a registered Aggregable instance") }
  else if not hasMethods
  then { tag = "Err", rtag = "Undecided", note = concat "MonotonicityProver: no Aggregable[" (concat aggName "] in registry") }
  else if not monoShapeOk
  then { tag = "Err", rtag = "Undecided", note = concat "MonotonicityProver: Aggregable[" (concat aggName "].monotonicity is malformed") }
  else if eq monoTag "Monotone"
  then { tag = "Ok", ptag = "SampleTestResult", propertyId = concat "Monotonic." aggName, samplesChecked = 1, allPassed = true }
  else { tag = "Err", rtag = "WitnessError", counterexample = { kind = "monotonicity-refuted", agg = aggName, monotonicity = monoTag } }
