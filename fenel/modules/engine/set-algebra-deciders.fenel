module engine where

-- set-algebra-deciders — pure leaf functions of set-algebra.ts.
--
-- Phase 7b proof-of-pattern. Mirrors the TS oracle at
-- implementations/typescript/engine/src/set-algebra.ts (now a thin shim
-- over the dispatched wrappers for the ported leaves).
--
-- Scope of this proof-of-pattern (carve-outs documented in the
-- accompanying brief / roadmap):
--
--   namedSubset / namedHierarchyChildren — static-graph "Nat ⊆ Int ⊆ ℚ"
--     hierarchy lookup. Pure string ops over a hierarchy table the TS
--     wrapper passes in (the table itself is data, not code).
--   setEnumContains — `value ∈ enum` membership test, pure list lookup.
--   setEnumDecideEmpty — emptiness of an enum set: `length values == 0`.
--
-- The brief's full 7b scope (interval math + per-constructor
-- contains/subset/disjoint/empty deciders + top-level dispatchers) is
-- deferred to a 7b-continuation phase. This proof-of-pattern lands a
-- single thin .fenel file that demonstrates set-algebra leaves migrate
-- cleanly with the existing recipe; the recursive per-constructor
-- deciders (setUnionContains / setIntersectContains / setDiffContains /
-- setComplementContains and their decideSubset/Disjoint/Empty siblings)
-- need full SetExprAdt marshalling-with-recursion which is a non-trivial
-- recipe extension over Phase 7a's flat-ADT pattern. See the roadmap's
-- Phase 7b entry for the continuation plan.
--
-- All internal helpers are prefixed `setAlgebra…` to avoid colliding
-- with like-named helpers already registered by other engine bodies.

-- HierarchyEntry — one row of the NAMED_HIERARCHY table, marshalled by
-- the TS wrapper. `name` is the subset name (e.g. "Nat"); `supers` is
-- the list of named sets that contain it as a subset (e.g. ["Int", "Real"]).
HierarchyEntry = HierarchyEntry name: String supers: List String

-- ============================================================================
-- namedSubset — is named set `a` provably a subset of named set `b`?
--
-- Mirrors the TS oracle's `namedSubset(a, b)`: returns true when a == b
-- OR b ∈ HIERARCHY[a]. The hierarchy table is passed from TS as a list
-- of HierarchyEntry rows (data, not code — the table itself stays in TS).
-- ============================================================================

@label "Named set: a ⊆ b"
@description "Phase 7b proof-of-pattern — is named set `a` provably a subset of named set `b`? Returns true when a == b OR b ∈ HIERARCHY[a]. The hierarchy table is data, passed in from TS as a list of {name, supers} rows; the body is the pure traversal. Mirrors implementations/typescript/engine/src/set-algebra.ts:namedSubset."
@tags "engine" "set-algebra" "named" "subset" "phase-7b"
namedSubset : (a: String) -> (b: String) -> (hierarchy: List HierarchyEntry) -> Boolean
namedSubset a b hierarchy =
  if eq a b
  then true
  else
    let children = setAlgebraHierarchyChildrenOf hierarchy a
    setAlgebraListContains children b

-- setAlgebraHierarchyChildrenOf — find the supers list for the given
-- name in the hierarchy table. Returns an empty list if no entry.
@label "set-algebra: hierarchyChildrenOf"
@description "Phase 7b — find the supers list for the given name in the hierarchy table. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraHierarchyChildrenOf : (hierarchy: List HierarchyEntry) -> (name: String) -> List String
setAlgebraHierarchyChildrenOf hierarchy name =
  case head hierarchy of
    Nothing -> []
    Just entry ->
      if eq entry.name name
      then entry.supers
      else
        case tail hierarchy of
          Nothing -> entry.supers  -- unreached after the head check above
          Just rest -> setAlgebraHierarchyChildrenOf rest name

-- setAlgebraListContains — pure string-list membership.
@label "set-algebra: listContains"
@description "Phase 7b — pure string-list membership. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraListContains : (items: List String) -> (target: String) -> Boolean
setAlgebraListContains items target =
  case head items of
    Nothing -> false
    Just first ->
      if eq first target
      then true
      else
        case tail items of
          Nothing -> false
          Just rest -> setAlgebraListContains rest target

-- ============================================================================
-- setEnumContains — value ∈ {v1, v2, …}? Pure list membership.
--
-- Returns MaybeBool — `Just true` if value is in the enum, `Just false`
-- otherwise. Wrapped at the boundary as the canonical {$tag: "Just",
-- value: Bool} shape so it round-trips with set-algebra's TS-side
-- MaybeBool helpers.
-- ============================================================================

@label "set-algebra: setEnumContains"
@description "Phase 7b proof-of-pattern — value ∈ {v1, v2, …} pure list-membership test. Returns MaybeBool (Just true / Just false). Mirrors implementations/typescript/engine/src/set-algebra.ts:setEnumContains."
@tags "engine" "set-algebra" "enum" "contains" "phase-7b"
setEnumContains : (values: List a) -> (value: a) -> Maybe Boolean
setEnumContains values value = setAlgebraEnumContainsTri values value false

@category "engine-internal"
setAlgebraEnumContainsTri : (values: List a) -> (value: a) -> (sawNothing: Bool) -> Maybe Bool
setAlgebraEnumContainsTri values value sawNothing =
  -- One std fold over the members (constant host stack: the interpreter has no
  -- tail calls, so the former self-recursion took one evaluator nesting per
  -- member and overflowed a browser worker at 258 members). The accumulator is
  -- the verdict so far: once a proven match makes it Just true, the remaining
  -- members are passed over without comparing them, so the same comparisons run
  -- in the same order as the recursion and the verdict is the same.
  fold (\found candidate -> case found of
    Just true -> found
    _ -> case deepEqValueTri candidate value of
      Just true -> Just true
      Just false -> found
      Nothing -> Nothing) (if sawNothing then Nothing else Just false) values

@label "set-algebra: enumContainsLoop"
@description "Phase 7b — inner traversal loop for setEnumContains; the ONE element-equality of the enum trio (contains / allValuesIn ⊆ / anyValueIn ∩) + minus-enum + pairwise-distinct + path-segment membership. decide-substrate Phase 3 Step D (Rom-green-lit): the element eq is DEEP (`deepEqValue`, rel-solve.fenel — structural over records/variants/arrays via std `entries`; bottoms out in std `eq` for scalars, so every scalar decision is byte-identical). This completes the kernel's witness rule for OBJECT witnesses (`decideSubset (SeEnum [w]) s` now decides rel-solve binding-rows + Phase-4 search certificates) and FIXES the shallow-eq unsoundness on object enums (reference-shallow `eq` proved `Just false` contains/subset and `Just true` disjoint for structurally-equal distinct-reference elements). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "phase-7b" "deep-eq" "decide-substrate" "phase-3"
@category "engine-internal"
setAlgebraEnumContainsLoop : (values: List a) -> (value: a) -> Boolean
setAlgebraEnumContainsLoop values value =
  -- std some stops at the first match, in member order (constant host stack).
  std.some values (\candidate -> deepEqValue candidate value)

-- ============================================================================
-- setEnumDecideEmpty — is the enum set empty? Pure length check.
-- ============================================================================

@label "set-algebra: setEnumDecideEmpty"
@description "Phase 7b proof-of-pattern — is the enum set empty? Pure length check returning MaybeBool. Mirrors implementations/typescript/engine/src/set-algebra.ts:setEnumDecideEmpty."
@tags "engine" "set-algebra" "enum" "empty" "phase-7b"
setEnumDecideEmpty : (values: List a) -> Maybe Boolean
setEnumDecideEmpty values =
  if eq (length values) 0
  then Just true
  else Just false

-- ============================================================================
-- Phase 7b-continuation — Interval math (Bound / Interval algebra)
--
-- Second boundary-adapter family of the 7b ambit. Pure number/string
-- operations over Bound and Interval shapes; no SetExpr recursion. The
-- recursive per-constructor compound deciders + top-level dispatchers +
-- constraint builders defer to a separate 7b-recursive sub-phase.
--
-- All inputs come through the TS dispatch wrappers (engine-bodies-
-- dispatch.ts) marshalled into the ADTs declared below; the body never
-- inspects raw JS shapes. Result intervals are returned via the same
-- ADTs (the wrapper unmarshals back to raw {value, inclusive} /
-- {lo?, hi?} shapes).
-- ============================================================================

-- Bound — discriminated by value type. The TS wrapper inspects
-- `typeof b.value` to decide the variant: number → BoundNumber, string
-- → BoundString, object (with $expr key) → BoundExpr. For BoundExpr the
-- wrapper attaches a string `exprKey` (JSON.stringify of the expression)
-- used for structural equality in intervalSubset, plus `origExpr` (the
-- raw expression value) so the unmarshaller can rebuild the original
-- Bound shape when emitting result intervals.
Bound =
  BoundNumber value: Number inclusive: Boolean
  | BoundString value: String inclusive: Boolean
  | BoundExpr exprKey: String inclusive: Boolean origExpr: Any

-- Interval — record with optional bounds. lo and hi are Maybe Bound:
-- Just (BoundX ...) when present, Nothing when unbounded.
Interval = Interval lo: Maybe Bound hi: Maybe Bound

-- A closed ordered view used only while tightening interval bounds.  Keeping
-- number and string payloads in distinct constructors avoids projecting a
-- union-typed anonymous record (an explicit inference fence in Phase 2).
BoundOrdView =
  BovNumber value: Number inclusive: Boolean
  | BovString value: String inclusive: Boolean

-- IntervalValue is the source-owned carrier classification for membership.
-- Exact integer candidates retain their value, including undecided admission;
-- their existing Nat/Int membership and Number comparison supply the verdict.
IntervalValue =
  IvNumber value: Number
  | IvString value: String
  | IvExactInteger value: Any
  | IvOther

-- IntervalDiffResult — intent markers for the structural output of
-- intervalDiff / intervalMinusEnum. The TS unmarshaller maps:
--   IdrNone                 → {$none: true}
--   IdrInterval { interval }→ {$interval: <unmarshalled>}
--   IdrUnion { intervals }  → {$union: intervals.map(iv => {$interval: iv})}
--   IdrDiff { iv1, iv2 }    → {$diff: [{$interval: iv1}, {$interval: iv2}]}
--   IdrDiffEnum { iv, vs }  → {$diff: [{$interval: iv}, {$enum: vs}]}
IntervalDiffResult =
  IdrNone
  | IdrInterval interval: Interval
  | IdrUnion intervals: List Interval
  | IdrDiff iv1: Interval iv2: Interval
  | IdrDiffEnum iv: Interval values: List Any

-- NumericBoundResult — 4-state numeric view of a Maybe<Bound>.
--   NbrPos            — +∞ (unbounded upper)
--   NbrNeg            — -∞ (unbounded lower)
--   NbrNum { value }  — finite numeric value
--   NbrNan            — non-comparable (string or expression bound)
NumericBoundResult =
  NbrPos
  | NbrNeg
  | NbrNum value: Number
  | NbrNan

-- IntersectAcc — internal accumulator for intersectIntervals: threads
-- the running lo / hi bounds (each Maybe<Bound>) through the fold.
IntersectAcc = IntersectAcc lo: Maybe Bound hi: Maybe Bound

-- MergeAcc — accumulator for mergeIntervals: threads the running output
-- list (List<Interval>) through the fold. The TS wrapper pre-sorts the
-- input by lower bound, so the body just folds left-to-right.
MergeAcc = MergeAcc out: List Interval

-- DiffAcc — accumulator for intervalMinusEnum: threads the cursor
-- (Maybe<Bound>, current lo for the next piece) + parts list through
-- the per-hole iteration.
DiffAcc = DiffAcc cursor: Maybe Bound parts: List Interval

-- NormFilterResult — exact cross-function carrier for the enum/value-only
-- normalization folds.  The nominal fields keep source-handle identity stable
-- at the helper boundary while the payload remains internal to normalization.
NormFilterResult = NormFilterResult kept: List Any exact: Boolean

-- ============================================================================
-- Bound primitives
-- ============================================================================

-- resolveBound — for a typed Bound, return the IntervalValue-discriminated
-- view of its value (used by inInterval to detect type mismatches).
-- Expression bounds become IvOther — they fail the typeof check uniformly.
@label "set-algebra: resolveBound"
@description "Phase 7b-continuation — typed view of a Bound's value as an IntervalValue (IvNumber / IvString / IvOther)."
@tags "engine" "set-algebra" "interval" "phase-7b"
resolveBound : (b: Bound) -> IntervalValue
resolveBound b = case b of
  BoundNumber { value = v } -> IvNumber { value = v }
  BoundString { value = v } -> IvString { value = v }
  BoundExpr { exprKey = _ } -> IvOther

-- Native Number/String classification preserves its scalar semantics;
-- existing Nat/Int admission classifies exact values without converting their
-- digits to Number. Undecided exact candidates retain their value so the
-- membership judgment preserves Nothing, including an unbounded interval.
@label "set-algebra: classifyIntervalValue"
@description "Raw value to the interval carrier view: native non-NaN Number and String preserve their established semantics; admitted or undecided exact Nat/Int candidates retain their value. Resource and unreadable-carrier fences are decided as Nothing by inInterval."
@tags "engine" "set-algebra" "interval" "phase-3b-3"
classifyIntervalValue : (v: Any) -> IntervalValue
classifyIntervalValue v =
  if isNumber v
  then (if eq v v then IvNumber { value = toNumber v } else IvOther)
  else if isString v
  then IvString { value = toString v }
  else case natExactMembership v of
    Just true -> IvExactInteger { value = v }
    Nothing -> IvExactInteger { value = v }
    Just false -> case intExactMembership v of
      Just false -> IvOther
      _ -> IvExactInteger { value = v }

-- boundValue — numeric extraction for confirmed-numeric bounds. Callers
-- only invoke after a BoundNumber guard; the other arms are defensive
-- (return 0, an unreachable default in practice).
@label "set-algebra: boundValue"
@description "Phase 7b-continuation — numeric extraction for a confirmed-numeric Bound."
@tags "engine" "set-algebra" "interval" "phase-7b"
boundValue : (b: Bound) -> Number
boundValue b = case b of
  BoundNumber { value = v } -> v
  BoundString {} -> 0
  BoundExpr {} -> 0

-- numericBound — Maybe<Bound> + ±∞ sign → NumericBoundResult 4-state.
-- Models the TS oracle's `±Infinity for undefined, value for literal,
-- NaN for non-numeric` collapse via an explicit ADT.
@label "set-algebra: numericBound"
@description "Phase 7b-continuation — Maybe<Bound> + sign → NumericBoundResult 4-state (NbrPos / NbrNeg / NbrNum / NbrNan)."
@tags "engine" "set-algebra" "interval" "phase-7b"
numericBound : (mBound: Maybe Bound) -> (infSign: Number) -> NumericBoundResult
numericBound mBound infSign = case mBound of
  Nothing ->
    if eq infSign 1 then NbrPos else NbrNeg
  Just b -> case b of
    BoundNumber { value = v } -> NbrNum { value = v }
    BoundString {} -> NbrNan
    BoundExpr {} -> NbrNan

-- ============================================================================
-- inInterval — value ∈ interval?
-- ============================================================================

@label "set-algebra: inInterval"
@description "Tri-valued interval membership over native Number/String and the existing exact Nat/Int carriers. Exact integers compare Number bounds through integerCompareNumber; unsupported endpoints, admission work and unreadable values abstain."
@tags "engine" "set-algebra" "interval" "contains" "phase-7b"
inInterval : (iv: Interval) -> (value: IntervalValue) -> Maybe Boolean
inInterval iv value = case value of
  IvOther -> Just false
  IvNumber { value = v } -> Just (setAlgebraInIntervalNumeric iv v)
  IvString { value = v } -> Just (setAlgebraInIntervalString iv v)
  IvExactInteger { value = v } ->
    case natExactMembership v of
      Nothing -> Nothing
      Just true -> setAlgebraInIntervalExactInteger iv v
      Just false -> case intExactMembership v of
        Just true -> setAlgebraInIntervalExactInteger iv v
        Just false -> Just false
        Nothing -> Nothing

@category "engine-internal"
setAlgebraInIntervalExactInteger : (iv: Interval) -> (v: Any) -> Maybe Boolean
setAlgebraInIntervalExactInteger iv v =
  case setAlgebraExactIntegerBound iv.lo v true of
    Just false -> Just false
    Just true -> setAlgebraExactIntegerBound iv.hi v false
    Nothing -> case setAlgebraExactIntegerBound iv.hi v false of
      Just false -> Just false
      _ -> Nothing

@category "engine-internal"
setAlgebraExactIntegerBound : (bound: Maybe Bound) -> (v: Any) -> (lower: Boolean) -> Maybe Boolean
setAlgebraExactIntegerBound bound v lower = case bound of
  Nothing -> Just true
  Just b -> case b of
    BoundString {} -> Just false
    BoundExpr {} -> Nothing
    BoundNumber { value = endpoint, inclusive = inclusive } ->
      -- This fixed comparison belongs to the judgment, not a caller-selected
      -- arithmetic method. Its existing curated invocation extent also lets
      -- deferred bootstrap readers inspect admitted exact integer carriers.
      case exactEqualitySourceCall std.integerCompareNumber [v, endpoint] of
        Just (Just ordering) ->
          if ordering == 0 then Just inclusive
          else Just (if lower then ordering > 0 else ordering < 0)
        _ -> Nothing

-- Numeric value: both bounds (if present) must be numeric. String /
-- expression bound → type mismatch → false. Else inclusive-aware compare.
@label "set-algebra: inIntervalNumeric"
@description "Phase 7b-continuation — inInterval helper for numeric values."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraInIntervalNumeric : (iv: Interval) -> (v: Number) -> Boolean
setAlgebraInIntervalNumeric iv v =
  if setAlgebraLoOkNumeric iv.lo v
  then setAlgebraHiOkNumeric iv.hi v
  else false

@label "set-algebra: loOkNumeric"
@description "Phase 7b-continuation — numeric lo bound check."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraLoOkNumeric : (mLo: Maybe Bound) -> (v: Number) -> Boolean
setAlgebraLoOkNumeric mLo v = case mLo of
  Nothing -> true
  Just b -> case b of
    BoundNumber { value = lo, inclusive = incl } ->
      if incl
      then if lt v lo then false else true
      else if lte v lo then false else true
    BoundString {} -> false
    BoundExpr {} -> false

@label "set-algebra: hiOkNumeric"
@description "Phase 7b-continuation — numeric hi bound check."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraHiOkNumeric : (mHi: Maybe Bound) -> (v: Number) -> Boolean
setAlgebraHiOkNumeric mHi v = case mHi of
  Nothing -> true
  Just b -> case b of
    BoundNumber { value = hi, inclusive = incl } ->
      if incl
      then if gt v hi then false else true
      else if gte v hi then false else true
    BoundString {} -> false
    BoundExpr {} -> false

-- String value: mirror image of numeric, swapping BoundNumber ↔ BoundString.
@label "set-algebra: inIntervalString"
@description "Phase 7b-continuation — inInterval helper for string values."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraInIntervalString : (iv: Interval) -> (v: String) -> Boolean
setAlgebraInIntervalString iv v =
  if setAlgebraLoOkString iv.lo v
  then setAlgebraHiOkString iv.hi v
  else false

@label "set-algebra: loOkString"
@description "Phase 7b-continuation — string lo bound check."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraLoOkString : (mLo: Maybe Bound) -> (v: String) -> Boolean
setAlgebraLoOkString mLo v = case mLo of
  Nothing -> true
  Just b -> case b of
    BoundString { value = lo, inclusive = incl } ->
      if incl
      then if lt v lo then false else true
      else if lte v lo then false else true
    BoundNumber {} -> false
    BoundExpr {} -> false

@label "set-algebra: hiOkString"
@description "Phase 7b-continuation — string hi bound check."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraHiOkString : (mHi: Maybe Bound) -> (v: String) -> Boolean
setAlgebraHiOkString mHi v = case mHi of
  Nothing -> true
  Just b -> case b of
    BoundString { value = hi, inclusive = incl } ->
      if incl
      then if gt v hi then false else true
      else if gte v hi then false else true
    BoundNumber {} -> false
    BoundExpr {} -> false

-- ============================================================================
-- intervalIsValid / intervalIsNumeric — single-interval predicates.
-- ============================================================================

-- intervalIsValid — does this interval describe a non-empty set?
@label "set-algebra: intervalIsValid"
@description "Phase 7b-continuation — does this interval describe a non-empty set?"
@tags "engine" "set-algebra" "interval" "phase-7b"
intervalIsValid : (iv: Interval) -> Boolean
intervalIsValid iv =
  case iv.lo of
    Nothing -> true
    Just loBound ->
      case iv.hi of
        Nothing -> true
        Just hiBound ->
          setAlgebraIntervalValidBoth loBound hiBound

@label "set-algebra: intervalValidBoth"
@description "Phase 7b-continuation — both-bounds-present validity check."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraIntervalValidBoth : (loBound: Bound) -> (hiBound: Bound) -> Boolean
setAlgebraIntervalValidBoth loBound hiBound =
  case loBound of
    BoundExpr {} -> true  -- expression bounds — assume valid
    BoundString {} -> true  -- string bounds aren't ordered numerically here; assume valid
    BoundNumber { value = lo, inclusive = loIncl } ->
      case hiBound of
        BoundExpr {} -> true
        BoundString {} -> true
        BoundNumber { value = hi, inclusive = hiIncl } ->
          if gt lo hi then false
          else if eq lo hi
          then
            if loIncl
            then if hiIncl then true else false
            else false
          else true

-- intervalIsNumeric — both bounds (if present) are numeric (not string
-- or expression).
@label "set-algebra: intervalIsNumeric"
@description "Phase 7b-continuation — are both bounds (if present) numeric?"
@tags "engine" "set-algebra" "interval" "phase-7b"
intervalIsNumeric : (iv: Interval) -> Boolean
intervalIsNumeric iv =
  if setAlgebraBoundIsNumericOrMissing iv.lo
  then setAlgebraBoundIsNumericOrMissing iv.hi
  else false

@label "set-algebra: boundIsNumericOrMissing"
@description "Phase 7b-continuation — bound predicate helper for intervalIsNumeric."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraBoundIsNumericOrMissing : (mBound: Maybe Bound) -> Boolean
setAlgebraBoundIsNumericOrMissing mBound = case mBound of
  Nothing -> true
  Just b -> case b of
    BoundNumber {} -> true
    BoundString {} -> false
    BoundExpr {} -> false

-- A wholly unbounded interval also contains Strings. Numeric bounds exclude
-- them; the predicate is a carrier fence, not a native Number certificate.
@category "engine-internal"
setAlgebraIntervalExcludesStrings : (iv: Interval) -> Boolean
setAlgebraIntervalExcludesStrings iv =
  if not (intervalIsNumeric iv) then false
  else case iv.lo of
    Just bound -> case bound of
      BoundNumber {} -> true
      _ -> false
    Nothing -> case iv.hi of
      Just bound -> case bound of
        BoundNumber {} -> true
        _ -> false
      Nothing -> false

-- ============================================================================
-- intervalsTouch / unionTouchingIntervals — pairwise interval ops.
-- ============================================================================

-- intervalsTouch — do two intervals overlap or touch at an inclusive edge?
@label "set-algebra: intervalsTouch"
@description "Phase 7b-continuation — do two intervals overlap or touch at an inclusive edge?"
@tags "engine" "set-algebra" "interval" "phase-7b"
intervalsTouch : (a: Interval) -> (b: Interval) -> Boolean
intervalsTouch a b =
  let ahi = numericBound a.hi 1
  let blo = numericBound b.lo 0  -- 0 means "negative infinity"
  case ahi of
    NbrNan -> false
    NbrPos ->
      case blo of
        NbrNan -> false
        _ -> true
    NbrNeg ->
      -- a.hi = -∞ is impossible in practice (invalid interval); return false
      false
    NbrNum { value = ahiV } ->
      case blo of
        NbrNan -> false
        NbrNeg -> true
        NbrPos -> false
        NbrNum { value = bloV } ->
          if gt ahiV bloV then true
          else if eq ahiV bloV
          then setAlgebraEitherInclusiveAt a.hi b.lo
          else false

@label "set-algebra: eitherInclusiveAt"
@description "Phase 7b-continuation — equal-bound inclusive check for intervalsTouch."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraEitherInclusiveAt : (mHi: Maybe Bound) -> (mLo: Maybe Bound) -> Boolean
setAlgebraEitherInclusiveAt mHi mLo =
  if setAlgebraBoundInclusive mHi
  then true
  else setAlgebraBoundInclusive mLo

@label "set-algebra: boundInclusive"
@description "Phase 7b-continuation — Maybe<Bound> inclusive-flag accessor."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraBoundInclusive : (mBound: Maybe Bound) -> Boolean
setAlgebraBoundInclusive mBound = case mBound of
  Nothing -> false
  Just b -> case b of
    BoundNumber { inclusive = incl } -> incl
    BoundString { inclusive = incl } -> incl
    BoundExpr { inclusive = incl } -> incl

-- unionTouchingIntervals — wider lo, wider hi of two touching intervals.
-- Prefers inclusive when bounds are equal.
@label "set-algebra: unionTouchingIntervals"
@description "Phase 7b-continuation — union of two touching intervals: wider lo, wider hi."
@tags "engine" "set-algebra" "interval" "phase-7b"
unionTouchingIntervals : (a: Interval) -> (b: Interval) -> Interval
unionTouchingIntervals a b =
  let outLo = setAlgebraWiderLo a.lo b.lo
  let outHi = setAlgebraWiderHi a.hi b.hi
  Interval { lo = outLo, hi = outHi }

-- Pick the wider (smaller-valued) lower bound. Returns Nothing if either
-- side is unbounded. For equal values, prefer inclusive.
@label "set-algebra: widerLo"
@description "Phase 7b-continuation — pick the wider lo bound; prefer inclusive on tie."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraWiderLo : (aLo: Maybe Bound) -> (bLo: Maybe Bound) -> Maybe Bound
setAlgebraWiderLo aLo bLo = case aLo of
  Nothing -> Nothing  -- a has no lo → result has no lo
  Just ab -> case bLo of
    Nothing -> Nothing  -- b has no lo
    Just bb ->
      -- Both present: compare via numericBound semantics
      let aN = numericBound aLo 0
      let bN = numericBound bLo 0
      case aN of
        NbrNum { value = av } ->
          case bN of
            NbrNum { value = bv } ->
              if lt av bv then aLo
              else if lt bv av then bLo
              else setAlgebraPreferInclusive aLo bLo
            _ -> aLo
        _ ->
          case bN of
            NbrNum { value = _ } -> bLo
            _ -> aLo

-- Pick the wider (larger-valued) upper bound. Returns Nothing if either
-- side is unbounded. For equal values, prefer inclusive.
@label "set-algebra: widerHi"
@description "Phase 7b-continuation — pick the wider hi bound; prefer inclusive on tie."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraWiderHi : (aHi: Maybe Bound) -> (bHi: Maybe Bound) -> Maybe Bound
setAlgebraWiderHi aHi bHi = case aHi of
  Nothing -> Nothing
  Just ab -> case bHi of
    Nothing -> Nothing
    Just bb ->
      let aN = numericBound aHi 1
      let bN = numericBound bHi 1
      case aN of
        NbrNum { value = av } ->
          case bN of
            NbrNum { value = bv } ->
              if gt av bv then aHi
              else if gt bv av then bHi
              else setAlgebraPreferInclusive aHi bHi
            _ -> aHi
        _ ->
          case bN of
            NbrNum { value = _ } -> bHi
            _ -> aHi

-- For two Maybe<Bound> at equal positions: prefer inclusive, else either.
@label "set-algebra: preferInclusive"
@description "Phase 7b-continuation — equal-position bound tiebreaker."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraPreferInclusive : (aB: Maybe Bound) -> (bB: Maybe Bound) -> Maybe Bound
setAlgebraPreferInclusive aB bB =
  if setAlgebraBoundInclusive aB
  then aB
  else
    if setAlgebraBoundInclusive bB
    then bB
    else aB

-- ============================================================================
-- intersectIntervals — n-ary intersection. Maybe<Interval> output:
-- Just (Interval ...) when non-empty, Nothing when disjoint.
-- ============================================================================

@label "set-algebra: intersectIntervals"
@description "Phase 7b-continuation — n-ary intersect with Maybe<Interval> output."
@tags "engine" "set-algebra" "interval" "phase-7b"
intersectIntervals : (intervals: List Interval) -> Maybe Interval
intersectIntervals intervals =
  let seed = IntersectAcc { lo = Nothing, hi = Nothing }
  let finalAcc = setAlgebraIntersectFold intervals seed
  setAlgebraIntersectFinalize finalAcc

@label "set-algebra: intersectFold"
@description "Phase 7b-continuation — accumulator-threaded fold over the interval list."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraIntersectFold : (intervals: List Interval) -> (acc: IntersectAcc) -> IntersectAcc
setAlgebraIntersectFold intervals acc =
  case head intervals of
    Nothing -> acc
    Just iv ->
      let newAcc = setAlgebraIntersectStep acc iv
      case tail intervals of
        Nothing -> newAcc
        Just rest -> setAlgebraIntersectFold rest newAcc

@label "set-algebra: intersectStep"
@description "Phase 7b-continuation — single-interval step within the intersect fold."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraIntersectStep : (acc: IntersectAcc) -> (iv: Interval) -> IntersectAcc
setAlgebraIntersectStep acc iv =
  let newLo = setAlgebraIntersectStepLo acc.lo iv.lo
  let newHi = setAlgebraIntersectStepHi acc.hi iv.hi
  IntersectAcc { lo = newLo, hi = newHi }

-- boundOrd — the ordered view of a Maybe<Bound>: BoundNumber / BoundString
-- expose their { value, inclusive } (both are totally ordered by `lt`/`gt`,
-- which are ordering-correct on numbers AND strings); BoundExpr and the
-- unbounded (Nothing) case are NON-tightenable ⇒ Nothing. THE shared bound
-- comparator behind the ONE interval tighten (decide-substrate Phase 1 Stage
-- C — the P-2 merge).
@label "set-algebra: boundOrd"
@description "Phase 1 Stage C (decide-substrate) — the ordered view of a Maybe<Bound>: BoundNumber / BoundString expose { value, inclusive } (both ordered by lt/gt); BoundExpr / unbounded ⇒ Nothing (non-tightenable). The shared comparator behind the ONE interval tighten. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "decide-substrate" "phase-1"
@category "engine-internal"
setAlgebraBoundOrd : (mb: Maybe Bound) -> Maybe BoundOrdView
setAlgebraBoundOrd mb = case mb of
  Nothing -> Nothing
  Just b -> case b of
    BoundNumber { value = v, inclusive = i } -> Just (BovNumber { value = v, inclusive = i })
    BoundString { value = v, inclusive = i } -> Just (BovString { value = v, inclusive = i })
    BoundExpr {} -> Nothing

@category "engine-internal"
setAlgebraBoundOrdGt : (left: BoundOrdView) -> (right: BoundOrdView) -> Boolean
setAlgebraBoundOrdGt left right = case left of
  BovNumber { value = lv } -> case right of
    BovNumber { value = rv } -> gt lv rv
    BovString {} -> false
  BovString { value = lv } -> case right of
    BovNumber {} -> false
    BovString { value = rv } -> gt lv rv

@category "engine-internal"
setAlgebraBoundOrdLt : (left: BoundOrdView) -> (right: BoundOrdView) -> Boolean
setAlgebraBoundOrdLt left right = case left of
  BovNumber { value = lv } -> case right of
    BovNumber { value = rv } -> lt lv rv
    BovString {} -> false
  BovString { value = lv } -> case right of
    BovNumber {} -> false
    BovString { value = rv } -> lt lv rv

@category "engine-internal"
setAlgebraBoundOrdEq : (left: BoundOrdView) -> (right: BoundOrdView) -> Boolean
setAlgebraBoundOrdEq left right = case left of
  BovNumber { value = lv } -> case right of
    BovNumber { value = rv } -> eq lv rv
    BovString {} -> false
  BovString { value = lv } -> case right of
    BovNumber {} -> false
    BovString { value = rv } -> eq lv rv

@category "engine-internal"
setAlgebraBoundOrdInclusive : (view: BoundOrdView) -> Boolean
setAlgebraBoundOrdInclusive view = case view of
  BovNumber { inclusive = inclusive } -> inclusive
  BovString { inclusive = inclusive } -> inclusive

-- setAlgebraIntersectStepLo — THE shared LO tighten for interval intersection:
-- the more restrictive (larger-valued, exclusive-on-tie) lower bound. Handles
-- BoundNumber AND BoundString (via setAlgebraBoundOrd); an expression /
-- unbounded bound is non-tightenable. Returns the ORIGINAL tagged Maybe<Bound>
-- (downstream reads boundValue / setAlgebraBoundInclusive on the tag).
-- decide-substrate Phase 1 Stage C: generalized to strings (was number-only) so
-- the solver-side fold (inhabit.fenel tighterLo, via classify/declassify) and
-- the deciders' n-ary intersectIntervals share ONE tighten arithmetic. For
-- BoundNumber the result is byte-identical to the pre-merge number-only form
-- (the equal-value tie-break preserves value + inclusive either way).
@label "set-algebra: intersectStepLo"
@description "Phase 1 Stage C (decide-substrate) — THE shared per-step lo tighten (larger-valued, exclusive-on-tie) for interval intersection; handles BoundNumber + BoundString via setAlgebraBoundOrd, expression/unbounded non-tightenable. The solver fold (inhabit.fenel tighterLo) and the deciders' intersectIntervals both route here. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "decide-substrate" "phase-1"
@category "engine-internal"
setAlgebraIntersectStepLo : (curLo: Maybe Bound) -> (ivLo: Maybe Bound) -> Maybe Bound
setAlgebraIntersectStepLo curLo ivLo = case setAlgebraBoundOrd ivLo of
  Nothing -> curLo
  Just nOrd ->
    case setAlgebraBoundOrd curLo of
      Nothing -> ivLo
      Just cOrd ->
        if setAlgebraBoundOrdGt nOrd cOrd then ivLo
        else if setAlgebraBoundOrdEq nOrd cOrd
        then (if setAlgebraBoundOrdInclusive nOrd then curLo else ivLo)
        else curLo

-- setAlgebraIntersectStepHi — the HI mirror of setAlgebraIntersectStepLo:
-- the more restrictive (smaller-valued, exclusive-on-tie) upper bound.
@label "set-algebra: intersectStepHi"
@description "Phase 1 Stage C (decide-substrate) — THE shared per-step hi tighten (smaller-valued, exclusive-on-tie) for interval intersection; handles BoundNumber + BoundString via setAlgebraBoundOrd, expression/unbounded non-tightenable. The hi mirror of setAlgebraIntersectStepLo. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "decide-substrate" "phase-1"
@category "engine-internal"
setAlgebraIntersectStepHi : (curHi: Maybe Bound) -> (ivHi: Maybe Bound) -> Maybe Bound
setAlgebraIntersectStepHi curHi ivHi = case setAlgebraBoundOrd ivHi of
  Nothing -> curHi
  Just nOrd ->
    case setAlgebraBoundOrd curHi of
      Nothing -> ivHi
      Just cOrd ->
        if setAlgebraBoundOrdLt nOrd cOrd then ivHi
        else if setAlgebraBoundOrdEq nOrd cOrd
        then (if setAlgebraBoundOrdInclusive nOrd then curHi else ivHi)
        else curHi

@label "set-algebra: intersectFinalize"
@description "Phase 7b-continuation — finalise accumulator into Maybe<Interval>."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraIntersectFinalize : (acc: IntersectAcc) -> Maybe Interval
setAlgebraIntersectFinalize acc = case acc.lo of
  Nothing ->
    -- No numeric lo accumulated; result is Just (Interval {lo, hi}) with
    -- whatever hi was accumulated.
    Just (Interval { lo = Nothing, hi = acc.hi })
  Just loBound -> case acc.hi of
    Nothing -> Just (Interval { lo = acc.lo, hi = Nothing })
    Just hiBound ->
      -- Both bounds present and numeric (by construction in setAlgebraIntersectStep*);
      -- check non-emptiness via boundValue.
      let lv = boundValue loBound
      let hv = boundValue hiBound
      if gt lv hv then Nothing
      else if eq lv hv
      then
        if setAlgebraBoundInclusive acc.lo
        then if setAlgebraBoundInclusive acc.hi
             then Just (Interval { lo = acc.lo, hi = acc.hi })
             else Nothing
        else Nothing
      else Just (Interval { lo = acc.lo, hi = acc.hi })

-- ============================================================================
-- mergeIntervals — merge overlapping/adjacent intervals (input pre-sorted).
-- The TS wrapper sorts by numeric lo bound before passing in, so the body
-- folds left-to-right comparing each new interval to the running tail.
-- ============================================================================

@label "set-algebra: mergeIntervals"
@description "Phase 7b-continuation — merge overlapping/adjacent intervals. Input pre-sorted by lo bound at the TS boundary."
@tags "engine" "set-algebra" "interval" "phase-7b"
mergeIntervals : (intervals: List Interval) -> (emptyList: List Interval) -> List Interval
mergeIntervals intervals emptyList =
  case head intervals of
    Nothing -> emptyList
    Just first ->
      let seed = appendItem first emptyList
      case tail intervals of
        Nothing -> seed
        Just rest ->
          let acc = MergeAcc { out = seed }
          let finalAcc = setAlgebraMergeFold rest acc emptyList
          finalAcc.out

@label "set-algebra: mergeFold"
@description "Phase 7b-continuation — merge fold loop."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraMergeFold : (intervals: List Interval) -> (acc: MergeAcc) -> (emptyList: List Interval) -> MergeAcc
setAlgebraMergeFold intervals acc emptyList =
  case head intervals of
    Nothing -> acc
    Just next ->
      let newAcc = setAlgebraMergeStep acc next emptyList
      case tail intervals of
        Nothing -> newAcc
        Just rest -> setAlgebraMergeFold rest newAcc emptyList

@label "set-algebra: mergeStep"
@description "Phase 7b-continuation — per-step merge: extend or append."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraMergeStep : (acc: MergeAcc) -> (next: Interval) -> (emptyList: List Interval) -> MergeAcc
setAlgebraMergeStep acc next emptyList =
  let lastMaybe = last acc.out
  case lastMaybe of
    Nothing -> MergeAcc { out = appendItem next acc.out }
    Just lastIv ->
      if intervalsTouch lastIv next
      then
        let merged = unionTouchingIntervals lastIv next
        let init0 = setAlgebraInitOrEmpty acc.out emptyList
        MergeAcc { out = appendItem merged init0 }
      else MergeAcc { out = appendItem next acc.out }

@label "set-algebra: initOrEmpty"
@description "Phase 7b-continuation — init of a list with empty-list fallback."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraInitOrEmpty : (xs: List a) -> (emptyList: List a) -> List a
setAlgebraInitOrEmpty xs emptyList = case init xs of
  Nothing -> emptyList
  Just ys -> ys

-- ============================================================================
-- intervalSubset — a ⊆ b?
-- Expression bounds use string-key structural equality (TS stringifies
-- expressions at the boundary; body compares exprKey strings via eq).
-- ============================================================================

@label "set-algebra: intervalSubset"
@description "Phase 7b-continuation — a subset b for two intervals; expression bounds use string-key structural equality."
@tags "engine" "set-algebra" "interval" "subset" "phase-7b"
intervalSubset : (a: Interval) -> (b: Interval) -> Boolean
intervalSubset a b =
  if setAlgebraSubsetLoOk a.lo b.lo
  then setAlgebraSubsetHiOk a.hi b.hi
  else false

@label "set-algebra: subsetLoOk"
@description "Phase 7b-continuation — lo-bound subset check."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraSubsetLoOk : (aLo: Maybe Bound) -> (bLo: Maybe Bound) -> Boolean
setAlgebraSubsetLoOk aLo bLo = case bLo of
  Nothing -> true  -- b has no lo → -∞; a's lo (anything) ≥ -∞
  Just bBound -> case bBound of
    BoundExpr { exprKey = bKey, inclusive = bIncl } ->
      -- b's lo is expression — only decidable if a's lo is the same expression.
      case aLo of
        Nothing -> false
        Just aBound -> case aBound of
          BoundExpr { exprKey = aKey, inclusive = aIncl } ->
            if eq aKey bKey
            then setAlgebraSubsetInclusiveOk aIncl bIncl
            else false
          _ -> false
    BoundNumber { value = bv, inclusive = bIncl } ->
      case aLo of
        Nothing -> false  -- a has no lo (-∞) but b has finite lo
        Just aBound -> case aBound of
          BoundExpr {} -> false  -- a has expression bound, b has finite; undecidable
          BoundString {} -> false  -- type mismatch
          BoundNumber { value = av, inclusive = aIncl } ->
            if lt av bv then false
            else if eq av bv
            then setAlgebraSubsetInclusiveOk aIncl bIncl
            else true
    BoundString { value = bv, inclusive = bIncl } ->
      case aLo of
        Nothing -> false
        Just aBound -> case aBound of
          BoundExpr {} -> false
          BoundNumber {} -> false
          BoundString { value = av, inclusive = aIncl } ->
            if lt av bv then false
            else if eq av bv
            then setAlgebraSubsetInclusiveOk aIncl bIncl
            else true

@label "set-algebra: subsetHiOk"
@description "Phase 7b-continuation — hi-bound subset check."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraSubsetHiOk : (aHi: Maybe Bound) -> (bHi: Maybe Bound) -> Boolean
setAlgebraSubsetHiOk aHi bHi = case bHi of
  Nothing -> true  -- b has no hi → +∞
  Just bBound -> case bBound of
    BoundExpr { exprKey = bKey, inclusive = bIncl } ->
      case aHi of
        Nothing -> false
        Just aBound -> case aBound of
          BoundExpr { exprKey = aKey, inclusive = aIncl } ->
            if eq aKey bKey
            then setAlgebraSubsetInclusiveOk aIncl bIncl
            else false
          _ -> false
    BoundNumber { value = bv, inclusive = bIncl } ->
      case aHi of
        Nothing -> false
        Just aBound -> case aBound of
          BoundExpr {} -> false
          BoundString {} -> false
          BoundNumber { value = av, inclusive = aIncl } ->
            if gt av bv then false
            else if eq av bv
            then setAlgebraSubsetInclusiveOk aIncl bIncl
            else true
    BoundString { value = bv, inclusive = bIncl } ->
      case aHi of
        Nothing -> false
        Just aBound -> case aBound of
          BoundExpr {} -> false
          BoundNumber {} -> false
          BoundString { value = av, inclusive = aIncl } ->
            if gt av bv then false
            else if eq av bv
            then setAlgebraSubsetInclusiveOk aIncl bIncl
            else true

-- a's inclusive must imply b's inclusive at the boundary (closed ⊆ closed,
-- open ⊆ anything, closed ⊄ open).
@label "set-algebra: subsetInclusiveOk"
@description "Phase 7b-continuation — boundary-inclusive subset implication helper."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraSubsetInclusiveOk : (aIncl: Boolean) -> (bIncl: Boolean) -> Boolean
setAlgebraSubsetInclusiveOk aIncl bIncl =
  if aIncl
  then bIncl
  else true

-- ============================================================================
-- intervalDiff — A \ B for two intervals. `emptyList` is the harness-
-- supplied empty-list seed (Core IR rejects bare-array literals at
-- expression position — `appendItem` builds lists by snoc).
-- ============================================================================

@label "set-algebra: intervalDiff"
@description "Phase 7b-continuation — A minus B for two intervals. Returns IntervalDiffResult marker."
@tags "engine" "set-algebra" "interval" "diff" "phase-7b"
intervalDiff : (a: Interval) -> (b: Interval) -> (emptyList: List Interval) -> IntervalDiffResult
intervalDiff a b emptyList =
  let aLo = numericBound a.lo 0
  let aHi = numericBound a.hi 1
  let bLo = numericBound b.lo 0
  let bHi = numericBound b.hi 1
  if setAlgebraAnyNan aLo aHi bLo bHi
  then IdrDiff { iv1 = a, iv2 = b }
  else
    let bCoversLo = setAlgebraBCoversLo a b
    let bCoversHi = setAlgebraBCoversHi a b
    setAlgebraEmitIntervalDiff a b bCoversLo bCoversHi emptyList

@label "set-algebra: anyNan"
@description "Phase 7b-continuation — any-of-4 NaN check over NumericBoundResult."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraAnyNan : (a: NumericBoundResult) -> (b: NumericBoundResult) -> (c: NumericBoundResult) -> (d: NumericBoundResult) -> Boolean
setAlgebraAnyNan a b c d =
  if setAlgebraIsNan a then true
  else if setAlgebraIsNan b then true
  else if setAlgebraIsNan c then true
  else setAlgebraIsNan d

@label "set-algebra: isNan"
@description "Phase 7b-continuation — NumericBoundResult NaN predicate."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraIsNan : (x: NumericBoundResult) -> Boolean
setAlgebraIsNan x = case x of
  NbrNan -> true
  _ -> false

-- bCoversLo — does b cover a's lower endpoint? (See TS oracle for arms.)
@label "set-algebra: bCoversLo"
@description "Phase 7b-continuation — does b cover a's lower endpoint?"
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraBCoversLo : (a: Interval) -> (b: Interval) -> Boolean
setAlgebraBCoversLo a b = case b.lo of
  Nothing -> true  -- b unbounded below → covers a's lo
  Just bb -> case a.lo of
    Nothing -> false  -- a unbounded below but b is bounded → b doesn't cover -∞
    Just ab ->
      let bv = boundValue bb
      let av = boundValue ab
      if lt bv av then true
      else if gt bv av then false
      else
        -- Equal positions: b covers if b is inclusive OR a is exclusive
        if setAlgebraBoundIncl bb then true
        else if setAlgebraBoundIncl ab then false
        else true

@label "set-algebra: bCoversHi"
@description "Phase 7b-continuation — does b cover a's upper endpoint?"
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraBCoversHi : (a: Interval) -> (b: Interval) -> Boolean
setAlgebraBCoversHi a b = case b.hi of
  Nothing -> true
  Just bb -> case a.hi of
    Nothing -> false
    Just ab ->
      let bv = boundValue bb
      let av = boundValue ab
      if gt bv av then true
      else if lt bv av then false
      else
        if setAlgebraBoundIncl bb then true
        else if setAlgebraBoundIncl ab then false
        else true

@label "set-algebra: boundIncl"
@description "Phase 7b-continuation — Bound inclusive-flag accessor."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraBoundIncl : (b: Bound) -> Boolean
setAlgebraBoundIncl b = case b of
  BoundNumber { inclusive = i } -> i
  BoundString { inclusive = i } -> i
  BoundExpr { inclusive = i } -> i

-- Emit the result given the bCoversLo/bCoversHi flags.
@label "set-algebra: emitIntervalDiff"
@description "Phase 7b-continuation — IntervalDiffResult emission given bCovers flags."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraEmitIntervalDiff : (a: Interval) -> (b: Interval) -> (bCoversLo: Boolean) -> (bCoversHi: Boolean) -> (emptyList: List Interval) -> IntervalDiffResult
setAlgebraEmitIntervalDiff a b bCoversLo bCoversHi emptyList =
  if bCoversLo
  then
    if bCoversHi
    then IdrNone  -- b covers all of a
    else
      -- Right part only: (b.hi-flipped, a.hi]
      let right = setAlgebraBuildRight a b
      case right of
        Nothing -> IdrNone
        Just iv -> IdrInterval { interval = iv }
  else
    if bCoversHi
    then
      -- Left part only: [a.lo, b.lo-flipped)
      let left = setAlgebraBuildLeft a b
      case left of
        Nothing -> IdrNone
        Just iv -> IdrInterval { interval = iv }
    else
      -- Both left and right pieces
      let left = setAlgebraBuildLeft a b
      let right = setAlgebraBuildRight a b
      setAlgebraEmitTwoPieces left right emptyList

@label "set-algebra: buildLeft"
@description "Phase 7b-continuation — build left piece of intervalDiff."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraBuildLeft : (a: Interval) -> (b: Interval) -> Maybe Interval
setAlgebraBuildLeft a b =
  case b.lo of
    Nothing -> Nothing
    Just bLoB ->
      let flipped = setAlgebraFlipInclusive bLoB
      let candidate = Interval { lo = a.lo, hi = Just flipped }
      if intervalIsValid candidate
      then Just candidate
      else Nothing

@label "set-algebra: buildRight"
@description "Phase 7b-continuation — build right piece of intervalDiff."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraBuildRight : (a: Interval) -> (b: Interval) -> Maybe Interval
setAlgebraBuildRight a b =
  case b.hi of
    Nothing -> Nothing
    Just bHiB ->
      let flipped = setAlgebraFlipInclusive bHiB
      let candidate = Interval { lo = Just flipped, hi = a.hi }
      if intervalIsValid candidate
      then Just candidate
      else Nothing

@label "set-algebra: flipInclusive"
@description "Phase 7b-continuation — toggle inclusivity on a Bound."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraFlipInclusive : (b: Bound) -> Bound
setAlgebraFlipInclusive b = case b of
  BoundNumber { value = v, inclusive = i } ->
    if i then BoundNumber { value = v, inclusive = false }
    else BoundNumber { value = v, inclusive = true }
  BoundString { value = v, inclusive = i } ->
    if i then BoundString { value = v, inclusive = false }
    else BoundString { value = v, inclusive = true }
  BoundExpr { exprKey = k, inclusive = i, origExpr = e } ->
    if i then BoundExpr { exprKey = k, inclusive = false, origExpr = e }
    else BoundExpr { exprKey = k, inclusive = true, origExpr = e }

@label "set-algebra: emitTwoPieces"
@description "Phase 7b-continuation — combine left + right Maybe<Interval> into the marker."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraEmitTwoPieces : (leftM: Maybe Interval) -> (rightM: Maybe Interval) -> (emptyList: List Interval) -> IntervalDiffResult
setAlgebraEmitTwoPieces leftM rightM emptyList = case leftM of
  Nothing ->
    case rightM of
      Nothing -> IdrNone
      Just r -> IdrInterval { interval = r }
  Just l ->
    case rightM of
      Nothing -> IdrInterval { interval = l }
      Just r ->
        let twoList = appendItem r (appendItem l emptyList)
        IdrUnion { intervals = twoList }

-- ============================================================================
-- intervalMinusEnum keeps structural enum holes explicit. A native scalar
-- and an exact Nat/Int carrier may have the same ordered magnitude without
-- being enum-equal; numeric splaying would remove both. The historical
-- numericInsiders/allNumeric/emptyList arguments remain transport-compatible.
-- ============================================================================

@label "set-algebra: intervalMinusEnum"
@description "Interval minus structural enum values: no insiders preserves the interval; otherwise retain the existing difference form. Numeric hole splaying is fenced because equal magnitude does not imply enum equality across native Number and exact Nat/Int carriers."
@tags "engine" "set-algebra" "interval" "diff" "phase-7b"
intervalMinusEnum : (a: Interval) -> (valuesInside: List Any) -> (numericInsiders: List Number) -> (allNumeric: Boolean) -> (emptyList: List Interval) -> IntervalDiffResult
intervalMinusEnum a valuesInside numericInsiders allNumeric emptyList =
  if eq (length valuesInside) 0
  then IdrInterval { interval = a }
  else IdrDiffEnum { iv = a, values = valuesInside }

@label "set-algebra: minusEnumFold"
@description "Phase 7b-continuation — sorted-hole splay fold."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraMinusEnumFold : (holes: List Number) -> (acc: DiffAcc) -> DiffAcc
setAlgebraMinusEnumFold holes acc = case head holes of
  Nothing -> acc
  Just hole ->
    let newAcc = setAlgebraMinusEnumStep acc hole
    case tail holes of
      Nothing -> newAcc
      Just rest -> setAlgebraMinusEnumFold rest newAcc

@label "set-algebra: minusEnumStep"
@description "Phase 7b-continuation — per-hole step in the splay."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraMinusEnumStep : (acc: DiffAcc) -> (hole: Number) -> DiffAcc
setAlgebraMinusEnumStep acc hole =
  let part = Interval {
    lo = acc.cursor,
    hi = Just (BoundNumber { value = hole, inclusive = false })
  }
  let nextCursor = Just (BoundNumber { value = hole, inclusive = false })
  if intervalIsValid part
  then DiffAcc { cursor = nextCursor, parts = appendItem part acc.parts }
  else DiffAcc { cursor = nextCursor, parts = acc.parts }

@label "set-algebra: minusEnumAppendTail"
@description "Phase 7b-continuation — append the final tail piece."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraMinusEnumAppendTail : (acc: DiffAcc) -> (a: Interval) -> DiffAcc
setAlgebraMinusEnumAppendTail acc a =
  let tail0 = Interval { lo = acc.cursor, hi = a.hi }
  if intervalIsValid tail0
  then DiffAcc { cursor = acc.cursor, parts = appendItem tail0 acc.parts }
  else acc

@label "set-algebra: emitMinusEnumResult"
@description "Phase 7b-continuation — splay parts to IntervalDiffResult marker."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraEmitMinusEnumResult : (parts: List Interval) -> (emptyList: List Interval) -> IntervalDiffResult
setAlgebraEmitMinusEnumResult parts emptyList =
  let n = length parts
  if eq n 0 then IdrNone
  else if eq n 1
  then case head parts of
    Nothing -> IdrNone
    Just iv -> IdrInterval { interval = iv }
  else IdrUnion { intervals = parts }

-- ============================================================================
-- Phase 3b-3 Step 3 — recursive per-constructor compound deciders + top-level
-- dispatchers, over the CANONICAL registered `$tag` `Se*` SetExpr ADT.
--
-- Stages A–D (contains / decideEmpty / isDisjoint / isSubset) reshaped every
-- decider to recurse over the canonical `SetExpr` entity (set-expr-types.fenel:
-- SeAll | SeNone | SeEnum | SeInterval | SeRef | SePattern | SeWhere | SeUnion |
-- SeIntersect | SeDiff | SeComplement) directly. The TS dispatchers now pass
-- `setExprToTag(set)` and the evaluator-dependent leaves (SeRef / SePattern /
-- SeWhere) ride body-reachable ctx-natives (namedMember / patternMember /
-- whereContainsEval / the sibling-decider re-homes) injected by
-- `dispatchSetAlgebraDecider`. The per-query marshalled mirror ADTs
-- (`SetExprAdt`-with-`SeOpaque` / `Sede*` / `Sid*` / `Side*` / `Sidb*` / `Sis*` /
-- `Sisa*` / `Sisb*`) + their TS producers (`marshalSetExprFor*` etc.) are RETIRED
-- (Stage E swept the now-inert decls). Still LIVE: `SidDisjointAllOther` (`Sao*`,
-- the ⊤-arm classifier) + `JsonLogicAggExpr` (the Aggregable-lift input).
-- ============================================================================
-- setAlgebraContains — recursive contains over the canonical `$tag` `Se*` ADT.
-- Two args: the canonical SetExpr + the raw value (used for SeEnum eq). SeEnum /
-- SeInterval self-decide in Fenel; SeRef / SePattern / SeWhere ride the
-- body-reachable ctx-natives (namedMember / patternMember / whereContainsEval).
-- Returns MaybeBool.
-- ============================================================================

@label "set-algebra: contains (recursive)"
@description "set-algebra-to-fenel Phase 3b-3 Step 3 Stage A — recursive contains over the CANONICAL registered `$tag` `Se*` SetExpr ADT (the per-query marshalled SetExprAdt-with-SeOpaque is RETIRED; `marshalSetExprForContains` deletes). Structural arms recurse; SeEnum / SeInterval keep their pure-Fenel leaf logic (setEnumContains / inInterval ∘ classifyInterval ∘ classifyIntervalValue); the three opaque leaves ride body-reachable seams — SeWhere → whereContainsEval (evaluateWith), SeRef → the namedMember ctx-native, SePattern → the patternMember ctx-native. Mirrors implementations/typescript/engine/src/set-algebra.ts:contains."
@tags "engine" "set-algebra" "contains" "recursive" "phase-3b-3"
-- Signature-substrate Phase 2: the ctx-native leaves above deliberately have
-- no registry-global callable scheme. This complete source boundary keeps the
-- dynamic capability honest instead of asking rank-1 inference to invent an
-- exact external callee.
setAlgebraContains : (setExpr: SetExpr) -> (value: a) -> Maybe Boolean
setAlgebraContains setExpr value = case setExpr of
  SeAll -> Just true
  SeNone -> Just false
  SeEnum { values = vs } -> setEnumContains vs value
  SeInterval { interval = iv } -> inInterval (setAlgebraClassifyInterval iv) (classifyIntervalValue value)
  -- decide-substrate (named-leaf honesty tail) — namedMember is TRI-STATE now:
  -- Just b for a KNOWN name's verdict, Nothing for an UNKNOWN name. The old
  -- `Just (namedMember …)` Bool-wrap turned every unknown-name miss into a hard
  -- refutation — e.g. `{botValue} ⊆ ⟦{$ref:"Bot"}⟧` refuted a TRUE containment
  -- through the enum⊆named per-value loop (the Tt* branch-law violation class).
  SeRef { handle = h } -> namedMember h value
  SePattern { pattern = p } -> patternMember p value
  SeWhere { pred = p } -> whereMember p value
  SeCtor { ctor = c, fields = fs } -> setAlgebraCtorContains c fs value
  SeMu { var = v, body = f } -> setAlgebraMuContains v f value
  SeArrow {} -> setAlgebraArrowContains setExpr value
  -- signature-substrate Phase 4 slice 3a — MEMBERSHIP AT A RIGID IS UNDECIDED.
  -- `{w} ⊆ κ` cannot answer Just false (κ := ⊤ contains w) nor Just true
  -- (κ := ∅ contains nothing). Explicit arm, not the shared `_` default: the
  -- exhaustiveness meta-test reads the arm, and a 16th constructor must not
  -- inherit this abstention by accident.
  SeRigid {} -> Nothing
  SeUnion { branches = bs } -> setAlgebraContainsUnion bs value false
  SeIntersect { branches = bs } -> setAlgebraContainsIntersect bs value false
  SeDiff { left = a, right = b } -> setAlgebraContainsDiff a b value
  SeComplement { inner = i } -> setAlgebraContainsComplement i value
  _ -> Nothing

-- setAlgebraContainsUnion — mSome semantics: any Just-true wins; all
-- Just-false ⇒ Just-false; any Nothing (and no Just-true) ⇒ Nothing.
-- sawNothing threads the "did we observe a Nothing so far?" bit.
@label "set-algebra: containsUnion"
@description "Phase 7b-recursive — mSome semantics for a union of canonical Se* branches. Internal helper; sawNothing threads the tri-state."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraContainsUnion : (branches: List SetExpr) -> (value: Any) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraContainsUnion branches value sawNothing =
  case head branches of
    Nothing ->
      if sawNothing then Nothing else Just false
    Just first ->
      let r = setAlgebraContains first value
      case r of
        Just true -> Just true
        Just false ->
          case tail branches of
            Nothing ->
              if sawNothing then Nothing else Just false
            Just rest ->
              setAlgebraContainsUnion rest value sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest ->
              setAlgebraContainsUnion rest value true

-- setAlgebraContainsIntersect — mEvery semantics: any Just-false refutes;
-- all Just-true proves; any Nothing (and no Just-false) ⇒ Nothing.
@label "set-algebra: containsIntersect"
@description "Phase 7b-recursive — mEvery semantics for an intersect of canonical Se* branches. Internal helper; sawNothing threads the tri-state."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraContainsIntersect : (branches: List SetExpr) -> (value: Any) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraContainsIntersect branches value sawNothing =
  case head branches of
    Nothing ->
      if sawNothing then Nothing else Just true
    Just first ->
      let r = setAlgebraContains first value
      case r of
        Just false -> Just false
        Just true ->
          case tail branches of
            Nothing ->
              if sawNothing then Nothing else Just true
            Just rest ->
              setAlgebraContainsIntersect rest value sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest ->
              setAlgebraContainsIntersect rest value true

-- setAlgebraContainsDiff — A \ B contains x iff A contains x and B doesn't.
-- Mirrors the TS oracle's tri-state propagation:
--   inA = Just false ⇒ Just false  (not in A ⇒ not in A\B)
--   inB = Just true ⇒ Just false   (in B ⇒ not in A\B)
--   inA = Just true, inB = Just false ⇒ Just true
--   else ⇒ Nothing
@label "set-algebra: containsDiff"
@description "Phase 7b-recursive — A minus B contains x iff A contains x and B doesn't. Internal helper."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraContainsDiff : (a: SetExpr) -> (b: SetExpr) -> (value: Any) -> Maybe Boolean
setAlgebraContainsDiff a b value =
  let inA = setAlgebraContains a value
  case inA of
    Just false -> Just false
    _ ->
      let inB = setAlgebraContains b value
      case inB of
        Just true -> Just false
        Just false ->
          case inA of
            Just true -> Just true
            _ -> Nothing
        Nothing -> Nothing

-- setAlgebraContainsComplement — ¬A contains x iff x not in A.
@label "set-algebra: containsComplement"
@description "Phase 7b-recursive — NOT-A contains x iff x not in A. Internal helper."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraContainsComplement : (inner: SetExpr) -> (value: Any) -> Maybe Boolean
setAlgebraContainsComplement inner value =
  let r = setAlgebraContains inner value
  case r of
    Just b -> Just (not b)
    Nothing -> Nothing

-- ============================================================================
-- setAlgebraClassifyInterval — raw interval → the marshalled Interval ADT.
--
-- set-algebra-to-fenel Phase 3b-3 Step 3 Stage A — the pure-Fenel replacement
-- for the TS `marshalInterval` the contains marshaller ran at the boundary. The
-- canonical `SeInterval` payload (from `setExprToTag`) is the raw TS `Interval
-- { lo, hi }` whose bounds are UNTAGGED `{ value, inclusive }` records; `inInterval`
-- consumes the tagged `Interval` ADT (BoundNumber / BoundString / BoundExpr). This
-- classifies each bound by its value type (mirroring `marshalBound`), so the
-- SeInterval contains-arm decides membership entirely in Fenel.
-- ============================================================================

@label "set-algebra: classifyInterval"
@description "Phase 3b-3 Step 3 Stage A — raw interval (untagged {value, inclusive} bounds, the canonical SeInterval payload) → the marshalled Interval ADT (tagged Bounds) inInterval consumes. Pure-Fenel replacement for the TS marshalInterval. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "phase-3b-3"
@category "engine-internal"
setAlgebraClassifyInterval : (iv: { lo: Maybe ({ value: Any, inclusive: Boolean }), hi: Maybe ({ value: Any, inclusive: Boolean }) }) -> Interval
setAlgebraClassifyInterval iv =
  Interval { lo = setAlgebraClassifyMaybeBound iv.lo, hi = setAlgebraClassifyMaybeBound iv.hi }

@label "set-algebra: classifyMaybeBound"
@description "Phase 3b-3 Step 3 Stage A — Maybe raw-bound → Maybe (tagged Bound). Internal helper to setAlgebraClassifyInterval."
@tags "engine" "internal" "set-algebra" "interval" "phase-3b-3"
@category "engine-internal"
setAlgebraClassifyMaybeBound : (mb: Maybe ({ value: Any, inclusive: Boolean })) -> Maybe Bound
setAlgebraClassifyMaybeBound mb = case mb of
  Nothing -> Nothing
  Just b -> Just (setAlgebraClassifyBound b)

@label "set-algebra: classifyBound"
@description "Phase 3b-3 Step 3 Stage A — raw bound {value, inclusive} → the tagged Bound ADT (BoundNumber / BoundString / BoundExpr) by value type. Mirrors marshalBound; the BoundExpr arm's exprKey is unused by inInterval / intervalIsValid / intersectIntervals (which treat an expression bound as a type-mismatch → false). NOTE: `intervalSubset` DOES compare exprKeys (interval⊆interval over expression bounds) — but a Fenel-stringify of the raw `$expr` value would EVALUATE its `var` directive (collapsing to undefined), so the subset interval arm re-homes the TS `marshalInterval` (string exprKeys) via `tagInterval` rather than using this Fenel classify. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "phase-3b-3"
@category "engine-internal"
setAlgebraClassifyBound : (b: { value: Any, inclusive: Boolean }) -> Bound
setAlgebraClassifyBound b =
  if isNumber b.value
  then BoundNumber { value = toNumber b.value, inclusive = b.inclusive }
  else if isString b.value
  then BoundString { value = toString b.value, inclusive = b.inclusive }
  else BoundExpr { exprKey = "", inclusive = b.inclusive, origExpr = b.value }

-- ============================================================================
-- declassifyInterval — marshalled Interval ADT → the raw {lo, hi} interval
-- payload (untagged {value, inclusive} bounds). The faithful inverse of the TS
-- `unmarshalInterval` the OLD `unmarshalNormSetExpr` NseInterval arm ran:
-- normalize operates on the marshalled (tagged-Bound) Interval internally (the
-- interval-op bodies consume it), but rebuilds canonical SeInterval nodes whose
-- payload is the raw interval. BoundExpr DROPS the exprKey (matching
-- unmarshalBound — exprKey is an internal-only comparison key, never an output
-- field). Produces ANONYMOUS records (NOT a tagged Interval/Bound ctor) so the
-- shape byte-matches setExprToTag's raw SeInterval payload.
-- ============================================================================

@label "set-algebra: declassifyInterval"
@description "containment-substrate Phase 1b — marshalled Interval ADT → raw {lo, hi} interval payload (faithful inverse of the TS unmarshalInterval). Used when normalize rebuilds SeInterval nodes from internally-marshalled intervals. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "normalize" "phase-1b"
@category "engine-internal"
declassifyInterval : (m: Interval) -> { lo: Maybe ({ value: Any, inclusive: Boolean }), hi: Maybe ({ value: Any, inclusive: Boolean }) }
declassifyInterval m = { lo = setAlgebraDeclassifyMaybeBound m.lo, hi = setAlgebraDeclassifyMaybeBound m.hi }

@label "set-algebra: declassifyMaybeBound"
@description "containment-substrate Phase 1b — Maybe (tagged Bound) → Maybe raw-bound. Internal helper to declassifyInterval."
@tags "engine" "internal" "set-algebra" "interval" "normalize" "phase-1b"
@category "engine-internal"
setAlgebraDeclassifyMaybeBound : (mb: Maybe Bound) -> Maybe ({ value: Any, inclusive: Boolean })
setAlgebraDeclassifyMaybeBound mb = case mb of
  Nothing -> Nothing
  Just b -> Just (setAlgebraDeclassifyBound b)

@label "set-algebra: declassifyBound"
@description "containment-substrate Phase 1b — tagged Bound (BoundNumber / BoundString / BoundExpr) → raw {value, inclusive} bound; BoundExpr drops the exprKey (mirrors unmarshalBound). Internal helper to declassifyInterval."
@tags "engine" "internal" "set-algebra" "interval" "normalize" "phase-1b"
@category "engine-internal"
setAlgebraDeclassifyBound : (b: Bound) -> { value: Any, inclusive: Boolean }
setAlgebraDeclassifyBound b = case b of
  BoundNumber { value = v, inclusive = i } -> { value = v, inclusive = i }
  BoundString { value = v, inclusive = i } -> { value = v, inclusive = i }
  BoundExpr { inclusive = i, origExpr = e } -> { value = e, inclusive = i }

-- ============================================================================
-- Phase 3b-3 Step 3 Stage B — decideEmpty over the canonical `$tag` `Se*` ADT.
-- (The per-query `SetExprDecideEmptyAdt` mirror — `Sede*` — was swept inert in
-- Stage E; `JsonLogicAggExpr` below stays LIVE as the Aggregable-lift input.)
-- ============================================================================

-- decide-substrate Phase 4T Step D′ — the CONNECTIVE-ALGEBRA CORE, split out
-- so the public `setAlgebraDecideEmpty` can widen WITHOUT a
-- `decideEmpty ↔ search` cycle: search's prune/leaf sites AND the recursive
-- helper arms below all call CORE (byte-identical to the pre-D′ recursive
-- body), so the search fall-through fires exactly ONCE at the public top.
@label "set-algebra: decideEmpty (core)"
@description "set-algebra-to-fenel Phase 3b-3 Step 3 Stage B / decide-substrate Phase 4T Step D′ — the recursive CONNECTIVE-ALGEBRA decideEmpty core over the CANONICAL registered `$tag` `Se*` SetExpr ADT (byte-identical to the pre-D′ `setAlgebraDecideEmpty`; the public entry now widens on top of it via bounded theory arms, and search's own prune/leaf sites call THIS core — the cycle-break). Structural arms recurse; SeEnum / SeInterval keep their pure-Fenel leaf logic (setEnumDecideEmpty / intervalIsValid ∘ classifyInterval); named / pattern are trivially undecided (Nothing). The cross-query pre-computes ride body-reachable seams — SeWhere → the whereEmpty ctx-native (recognizeAggregableComposition lift), SeIntersect → the in-Fenel pairwise-disjoint LOOP over direct setAlgebraIsDisjoint sibling calls (Phase 1c), SeDiff → the direct setAlgebraIsSubset sibling call (Phase 1c)."
@tags "engine" "set-algebra" "decideEmpty" "recursive" "phase-3b-3" "decide-substrate" "phase-4"
setAlgebraDecideEmptyCore : (setExpr: SetExpr) -> Maybe Boolean
setAlgebraDecideEmptyCore setExpr = case setExpr of
  SeAll -> Just false
  SeNone -> Just true
  SeEnum { values = vs } -> setEnumDecideEmpty vs
  SeInterval { interval = iv } -> setAlgebraDecideEmptyInterval (setAlgebraClassifyInterval iv)
  SeRef { handle = h } -> seNamedEmpty h
  SePattern {} -> Nothing
  SeWhere { pred = p } -> whereEmpty p
  SeCtor { ctor = c, fields = fs } -> setAlgebraCtorEmpty c fs
  SeMu { var = v, body = f } -> setAlgebraMuEmpty v f
  SeArrow { params = ps, returns = r } -> setAlgebraArrowEmpty ps r
  -- signature-substrate Phase 4 slice 3a — A RIGID IS NEITHER DECIDABLY EMPTY
  -- NOR DECIDABLY NONEMPTY. This is the load-bearing VACUITY fence: checkLambda
  -- returns Just true immediately when any parameter domain is decidably EMPTY,
  -- so a rigid any face could prove empty would make every `∀a. a -> R` body
  -- validate vacuously. `arrowSomeParamEmpty` is strict on Just true, so
  -- Nothing here suffices.
  SeRigid {} -> Nothing
  SeUnion { branches = bs } -> setAlgebraDecideEmptyUnion bs false
  SeIntersect { branches = bs } -> setAlgebraDecideEmptyIntersect bs
  SeDiff { left = a, right = b } -> setAlgebraDecideEmptyDiff a b
  SeComplement { inner = i } -> setAlgebraDecideEmptyComplement i
  _ -> Nothing

-- The PUBLIC decideEmpty first asks the checked canonical rank-language
-- arm (an explicit positive domain in the actual claim; ordinary string
-- membership rechecks any found witness). An abstention falls through to the
-- unchanged connective-algebra core, then the Phase 4T D′
-- search fall-through: a composite (∪/∩/diff) the connective algebra left
-- UNDECIDED gets ONE fuel-bounded witness search — `SvFound w` ⇒ Just false
-- (witnessed non-empty), `SvEmpty` ⇒ Just true (a decidable refutation: every
-- union branch decidably empty, or a COMPLETE finite generator with every
-- candidate decidably rejected — the honest-SvEmpty bar is exactly a sound
-- emptiness proof), `SvUnknown` ⇒ Nothing (unchanged). FIXED fuel 64 — no
-- caller dial inside a decider (determinism). GUARDED to the PURE-STRUCTURAL
-- fragment (setAlgebraSearchable — no SeWhere/SeRef/SePattern leaf anywhere):
-- those leaves' membership rides ctx-natives (whereMember / namedMember /
-- patternMember) that only decider/inference dispatch ctxs carry, and
-- decideEmpty is called by BARE NAME from arbitrary engine bodies — an
-- unresolvable seam head would THROW where today's answer is Nothing. The
-- guard confines the widening to the fragment search can decide under ANY
-- ctx (enum/interval/all/none composites — exactly the connective-algebra
-- gaps: enum∩enum overlap, enum∩¬enum, diffs, unions of those).
@label "set-algebra: decideEmpty (recursive)"
@description "The PUBLIC decideEmpty — checked canonical ASCII rank-language emptiness first over an exact explicit positive domain in the claimed set; abstention falls through to the unchanged connective-algebra CORE, then the fixed-fuel D′ search arm, the Nelson-Oppen SeWhere arm and floor-kernel Phase 3b's ctx-free arrow-Boolean theory arm. Found rank words are encoded and rechecked by ordinary membership against the original claim. The final arm NNF/DNF-normalizes an arrow-bearing ∩/∖/¬ composite (64-term cap) and applies the single-negative signature-space decomposition; every recursive component verdict is Kleene-combined verbatim, so an undecided premise remains Nothing. CORE stays the cycle-break used by search and by the per-DNF-term pre-check."
@tags "engine" "set-algebra" "decideEmpty" "recursive" "search" "arrow" "floor-kernel" "phase-3b" "decide-substrate" "phase-4"
setAlgebraDecideEmpty : (setExpr: SetExpr) -> Maybe Boolean
setAlgebraDecideEmpty setExpr =
  case recipeRankDecideEmpty setExpr of
    Just b -> Just b
    Nothing ->
      case setAlgebraDecideEmptyCore setExpr of
        Just b -> Just b
        Nothing ->
          case setAlgebraDecideEmptySearchArm setExpr of
            Just b -> Just b
            Nothing ->
              case setAlgebraDecideEmptyEufArm setExpr of
                Just b -> Just b
                Nothing -> setAlgebraDecideEmptyArrowBoolArm setExpr

@label "set-algebra: decideEmptySearchArm"
@description "decide-substrate Phase 4T Step D′ — the decider's search fall-through: composite tag (SeUnion/SeIntersect/SeDiff) + pure-structural (setAlgebraSearchable) ⇒ `searchCore \"\" 64` — SvFound ⇒ Just false, SvEmpty ⇒ Just true, SvUnknown ⇒ Nothing; anything else ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "search" "decide-substrate" "phase-4"
@category "engine-internal"
setAlgebraDecideEmptySearchArm : (setExpr: SetExpr) -> Maybe Boolean
setAlgebraDecideEmptySearchArm setExpr =
  let t = seTag setExpr
  let composite = or (eq t "SeUnion") (or (eq t "SeIntersect") (eq t "SeDiff"))
  if composite
  then
    if setAlgebraSearchable setExpr
    then
      case searchCore "" 64 setExpr of
        SvFound w -> Just false
        SvEmpty n -> Just true
        SvUnknown r -> Nothing
    else Nothing
  else Nothing

-- decide-substrate Phase 5 (WIDENED at Phase 6) — the theory-combination arm
-- (the D′ public-top precedent): a SeWhere leaf the connective algebra + search
-- both left UNDECIDED gets ONE Nelson-Oppen pass over its predicate's `Expr`
-- term-singletons — `noDecideWhere` (theory-combine.fenel) extracts the
-- `and`-spine's MIXED atoms (eq/neq PLUS lte/lt/gte/gt — Phase 6's widening of
-- euf's eq/neq-only eufDecideWhere), fences `$effect:` heads, and returns Just
-- true (EMPTY) only on a combined-UNSAT refutation: an EUF lit-conflict
-- (`f v == 1 ∧ f v == 2`), a strict order cycle, a numeric-lit path conflict
-- (`x ≤ 3 ∧ 5 ≤ x`), OR an order-derived equality that EUF then refutes
-- (`v ≥ 5 ∧ v ≤ 5 ∧ f v ≠ f 5` — the textbook Nelson-Oppen row) — all sound over
-- EVERY domain + ambient env, NEVER Just false (combined-sat does not certify
-- nonempty for a typed domain). CORE stays byte-identical (the arm never calls
-- decideEmpty — no cycle); SeWhere-bearing COMPOSITES stay excluded by
-- setAlgebraSearchable and are NOT folded here (a flagged widening). The pure
-- noDecideWhere adds no ctx-native seam, so the arm is safe under any ctx that
-- already reached it (a bare SeWhere's CORE arm already needs whereEmpty).
@label "set-algebra: decideEmptyEufArm"
@description "decide-substrate Phase 5 / WIDENED Phase 6 — the decider's Nelson-Oppen fall-through: a still-undecided SeWhere leaf ⇒ noDecideWhere over its predicate Expr (EUF congruence + the order theory over the shared universe; unsat ⇒ Just true empty, else Nothing); every other tag ⇒ Nothing. The headline gains: `decideEmpty ⟦{v | f v == 1 ∧ f v == 2}⟧` and `⟦{v | v ≥ 5 ∧ v ≤ 5 ∧ f v ≠ f 5}⟧` both flip Nothing ⇒ Just true. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "euf" "theory-combine" "decide-substrate" "phase-6"
@category "engine-internal"
setAlgebraDecideEmptyEufArm : (setExpr: SetExpr) -> Maybe Boolean
setAlgebraDecideEmptyEufArm setExpr =
  if eq (seTag setExpr) "SeWhere" then noDecideWhere setExpr.pred else Nothing

-- decide-substrate Phase 8μ.1a — SeCtor is fenced here too (returns false): the
-- value-search generator (search.fenel) doesn't construct ctor VALUES, so a
-- union-of-SeCtor must degrade to Nothing at the decider's search fall-through
-- rather than mislead it. (The @description below stays the P4 oracle text —
-- byte-stable metadata; the fence lives in the code + the SeCtor faces section.)
@label "set-algebra: searchable"
@description "decide-substrate Phase 4T Step D′ — true when a SetExpr is PURE-STRUCTURAL (no SeWhere / SeRef / SePattern leaf anywhere): the fragment the decider's search fall-through can decide under ANY dispatch ctx (those three leaves ride ctx-native membership seams that bare-name callers may not carry). SeUnion/SeIntersect branches, SeDiff sides, SeComplement inner recurse; SeEnum/SeInterval/SeAll/SeNone are structural. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "search" "decide-substrate" "phase-4"
@category "engine-internal"
-- signature-substrate Phase 4 slice 3a — the `SeRigid` fence in the chain below
-- is LOAD-BEARING, not decoration. The trailing `else true` is an ALLOW-list
-- default, so a leaf this chain does not name is ADMITTED into `searchCore`,
-- and the caller's `SvEmpty ⇒ Just true` would then manufacture an emptiness
-- verdict over a leaf the value-search generator cannot inhabit — the vacuity
-- trap by another route. A rigid has no ground extension to search.
-- (No interleaved comment inside the chain: the Fenel grammar does not accept
-- a comment between `then <expr>` and `else`.)
setAlgebraSearchable : (setExpr: SetExpr) -> Boolean
setAlgebraSearchable setExpr =
  let t = seTag setExpr
  if eq t "SeWhere" then false
  else if eq t "SeRef" then false
  else if eq t "SePattern" then false
  else if eq t "SeCtor" then false
  else if eq t "SeMu" then false
  else if eq t "SeArrow" then false
  else if eq t "SeRigid" then false
  else if eq t "SeComplement" then setAlgebraSearchable setExpr.inner
  else if eq t "SeDiff" then and (setAlgebraSearchable setExpr.left) (setAlgebraSearchable setExpr.right)
  else if eq t "SeUnion" then setAlgebraSearchableAll setExpr.branches
  else if eq t "SeIntersect" then setAlgebraSearchableAll setExpr.branches
  else true

@label "set-algebra: searchableAll"
@description "decide-substrate Phase 4T Step D′ — setAlgebraSearchable over every branch of a union/intersect. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "search" "decide-substrate" "phase-4"
@category "engine-internal"
setAlgebraSearchableAll : (branches: List SetExpr) -> Boolean
setAlgebraSearchableAll branches =
  case head branches of
    Nothing -> true
    Just b ->
      if setAlgebraSearchable b
      then
        case tail branches of
          Nothing -> true
          Just rest -> setAlgebraSearchableAll rest
      else false

-- floor-kernel Phase 3a — setAlgebraCtxFree: the SHAPE-PERMISSIVE sibling of
-- setAlgebraSearchable. TRUE iff no ctx-native-riding leaf (SeWhere / SeRef /
-- SePattern — whereMember/whereEmpty/whereExtract, namedMember/namedInHierarchy,
-- patternMember seams) occurs ANYWHERE in the expression — walking SeCtor
-- fields, SeMu bodies, SeArrow params+returns, and the Boolean combinators.
-- Unlike setAlgebraSearchable it ADMITS SeCtor/SeMu/SeArrow shells: those
-- exclusions exist because the value SEARCH can't generate their inhabitants
-- (a search capability), not because their structural arms ride ctx-natives.
-- A μ-BOUND SeRef {handle = var} is admitted (the `bound` list threads binder
-- names, inner same-name SeMu shadows harmlessly): the bound occurrence is
-- substituted away (substSet) before any decider touches it as a name, so it
-- never reaches the name-registry seams. An UNBOUND SeRef stays excluded even
-- though bare-leaf emptiness (seNamedEmpty) is pure — nested in a SeIntersect
-- it reaches the namedInHierarchy ctx-native via the pairwise-disjoint scan
-- (an atom-tower precision candidate, not worth the case split). Unknown
-- formers ⇒ false (defensive — divergence from searchable's permissive else).
-- Gates the Phase-3a rewrite arms (subsetDiffArm / diffDisjoint /
-- topArmDisjoint): the D′ ctx discipline — the rewrites create shape pairs the
-- pre-3a face never fed to ctx-native leaves, and the deciders are callable by
-- bare name from bodies whose dispatch ctx may not carry those seams.
@label "set-algebra: ctxFree"
@description "floor-kernel Phase 3a — TRUE iff the SetExpr has NO ctx-native-riding leaf (SeWhere/SeRef/SePattern) anywhere, walking SeCtor fields / SeMu bodies / SeArrow params+returns / Boolean combinators; μ-bound SeRef occurrences are admitted (substituted away before any name lookup). The shape-permissive sibling of setAlgebraSearchable (whose SeCtor/SeMu/SeArrow exclusions are search-capability limits, not ctx concerns). Gates the 3a rewrite arms per the D′ ctx discipline. Internal helper."
@tags "engine" "internal" "set-algebra" "floor-kernel" "phase-3a"
@category "engine-internal"
setAlgebraCtxFree : (s: SetExpr) -> Boolean
setAlgebraCtxFree s = setAlgebraCtxFreeW s []

@label "set-algebra: ctxFreeW"
@description "floor-kernel Phase 3a — the setAlgebraCtxFree walk with the μ-binder list threaded (SeMu conses its var; SeRef checks membership — bound ⇒ admitted, unbound ⇒ excluded). Internal helper."
@tags "engine" "internal" "set-algebra" "floor-kernel" "phase-3a"
@category "engine-internal"
setAlgebraCtxFreeW : (s: SetExpr) -> (bound: List String) -> Boolean
setAlgebraCtxFreeW s bound = case s of
  SeAll -> true
  SeNone -> true
  SeEnum {} -> true
  SeInterval {} -> true
  SeWhere {} -> false
  SePattern {} -> false
  SeRef { handle = h } -> setAlgebraEnumContainsLoop bound h
  SeCtor { fields = fs } -> setAlgebraCtxFreeFields fs bound
  SeMu { var = v, body = b } ->
    let bound2 = appendItem v bound
    setAlgebraCtxFreeW b bound2
  SeArrow { params = ps, returns = r } ->
    if setAlgebraCtxFreeParams ps bound then setAlgebraCtxFreeW r bound else false
  SeUnion { branches = bs } -> setAlgebraCtxFreeAll bs bound
  SeIntersect { branches = bs } -> setAlgebraCtxFreeAll bs bound
  SeDiff { left = l, right = r } ->
    if setAlgebraCtxFreeW l bound then setAlgebraCtxFreeW r bound else false
  SeComplement { inner = i } -> setAlgebraCtxFreeW i bound
  -- signature-substrate Phase 4 slice 3a — a rigid is NOT ctx-free. It carries
  -- no ctx-native seam, but this gate admits a term into the classical
  -- ¬/top-cover rewrites, and those reason by "this leaf is domain-bounded".
  -- Over-fencing (false) costs coverage; admitting would cost soundness.
  SeRigid {} -> false
  _ -> false

@label "set-algebra: ctxFreeAll"
@description "floor-kernel Phase 3a — setAlgebraCtxFreeW over every branch of a union/intersect. Internal helper."
@tags "engine" "internal" "set-algebra" "floor-kernel" "phase-3a"
@category "engine-internal"
setAlgebraCtxFreeAll : (branches: List SetExpr) -> (bound: List String) -> Boolean
setAlgebraCtxFreeAll branches bound =
  case head branches of
    Nothing -> true
    Just b ->
      if setAlgebraCtxFreeW b bound
      then
        case tail branches of
          Nothing -> true
          Just rest -> setAlgebraCtxFreeAll rest bound
      else false

@label "set-algebra: ctxFreeFields"
@description "floor-kernel Phase 3a — setAlgebraCtxFreeW over every SeCtor field set. Internal helper."
@tags "engine" "internal" "set-algebra" "floor-kernel" "phase-3a"
@category "engine-internal"
setAlgebraCtxFreeFields : (fs: List SetCtorField) -> (bound: List String) -> Boolean
setAlgebraCtxFreeFields fs bound =
  case head fs of
    Nothing -> true
    Just f ->
      if setAlgebraCtxFreeW f.set bound
      then setAlgebraCtxFreeFields (eufRest fs) bound
      else false

@label "set-algebra: ctxFreeParams"
@description "floor-kernel Phase 3a — setAlgebraCtxFreeW over every SeArrow param set. Internal helper."
@tags "engine" "internal" "set-algebra" "floor-kernel" "phase-3a"
@category "engine-internal"
setAlgebraCtxFreeParams : (ps: List SetArrowParam) -> (bound: List String) -> Boolean
setAlgebraCtxFreeParams ps bound =
  case head ps of
    Nothing -> true
    Just p ->
      if setAlgebraCtxFreeW p.set bound
      then setAlgebraCtxFreeParams (eufRest ps) bound
      else false

-- ============================================================================
-- floor-kernel Phase 3b — classical-negation NNF + the first top-equivalence
-- arm. NNF is a denotation-preserving composition of the shipped floor laws:
-- De Morgan, involution, diff = intersect-with-complement, and top/bottom
-- complement. `negated` is the parity bit; every recursive connective step
-- either removes a complement or pushes it strictly closer to a leaf.
-- ============================================================================

@label "set-algebra: nnf"
@description "floor-kernel Phase 3b — convert a canonical SetExpr to negation normal form. De Morgan swaps union/intersect under odd parity, double complement flips parity back, diff expands as A∩¬B (and ¬(A∖B) as ¬A∪B), and ¬⊤/¬∅ swap the constants. Complements remain only directly above leaves. Each rewrite is an existing floor-law theorem; the new norm.nnf ledger row classifies their terminating composition."
@tags "engine" "set-algebra" "normalize" "nnf" "complement" "floor-kernel" "phase-3b"
setAlgebraNnf : (s: SetExpr) -> SetExpr
setAlgebraNnf s = setAlgebraNnfPolarity s false

@label "set-algebra: nnfPolarity"
@description "floor-kernel Phase 3b — parity-threaded NNF worker. false preserves a connective; true applies its De Morgan dual. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraNnfPolarity : (s: SetExpr) -> (negated: Boolean) -> SetExpr
setAlgebraNnfPolarity s negated = case s of
  SeAll -> if negated then SeNone else SeAll
  SeNone -> if negated then SeAll else SeNone
  SeUnion { branches = bs } ->
    let ns = setAlgebraNnfList bs negated
    if negated then SeIntersect { branches = ns } else SeUnion { branches = ns }
  SeIntersect { branches = bs } ->
    let ns = setAlgebraNnfList bs negated
    if negated then SeUnion { branches = ns } else SeIntersect { branches = ns }
  SeDiff { left = l, right = r } -> setAlgebraNnfDiff l r negated
  SeComplement { inner = i } -> setAlgebraNnfPolarity i (not negated)
  _ ->
    if negated then SeComplement { inner = s } else s

@label "set-algebra: nnfList"
@description "floor-kernel Phase 3b — map setAlgebraNnfPolarity over a branch list without changing order. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraNnfList : (branches: List SetExpr) -> (negated: Boolean) -> List SetExpr
setAlgebraNnfList branches negated =
  case head branches of
    Nothing -> []
    Just b ->
      let nb = setAlgebraNnfPolarity b negated
      concat [nb] (setAlgebraNnfList (eufRest branches) negated)

@label "set-algebra: nnfDiff"
@description "floor-kernel Phase 3b — the diff arm of NNF: A∖B becomes A∩¬B; under odd parity it becomes ¬A∪B. Named-field branch values are let-bound to avoid the parser's application-valued-field ambiguity. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraNnfDiff : (l: SetExpr) -> (r: SetExpr) -> (negated: Boolean) -> SetExpr
setAlgebraNnfDiff l r negated =
  if negated
  then
    let nl = setAlgebraNnfPolarity l true
    let pr = setAlgebraNnfPolarity r false
    let bs = appendItem pr (appendItem nl [])
    SeUnion { branches = bs }
  else
    let pl = setAlgebraNnfPolarity l false
    let nr = setAlgebraNnfPolarity r true
    let bs = appendItem nr (appendItem pl [])
    SeIntersect { branches = bs }

-- top-cover is the dual consumed by decideEmptyComplement:
--   empty(¬w) iff top <= w.
-- The deliberately-small first arm is exact on: top/bottom; meets of covered
-- forms; bounded enum/interval leaves; and a union containing a complement,
-- using the shipped pairing iso P ∪ ¬N = top iff N <= P. No guessed verdicts.

@label "set-algebra: topCover"
@description "floor-kernel Phase 3b — decide whether an NNF SetExpr covers ⊤. Exact first slice: constants; enum/interval leaves (provably bounded, hence not ⊤); complement leaves via inner emptiness; intersections by Kleene-every; unions by a branch already covering ⊤ or the pairing equivalence P∪¬N=⊤ iff N⊆P. Anything outside that slice is Nothing. Internal helper to decideEmptyComplement."
@tags "engine" "internal" "set-algebra" "subset" "complement" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraTopCover : (s: SetExpr) -> Maybe Boolean
setAlgebraTopCover s = case s of
  SeAll -> Just true
  SeNone -> Just false
  SeEnum { values = _ } -> Just false
  SeInterval { interval = _ } -> Just false
  SeComplement { inner = i } -> setAlgebraDecideEmpty i
  SeIntersect { branches = bs } -> setAlgebraTopCoverEvery bs
  SeUnion { branches = bs } -> setAlgebraTopCoverUnion bs
  -- signature-substrate Phase 4 slice 3a — a rigid is NOT provably bounded (the
  -- SeEnum/SeInterval `Just false` rows above are exactly the "domain-bounded,
  -- hence ≠ ⊤" reasoning that fails at κ := ⊤). Nothing.
  SeRigid {} -> Nothing
  _ -> Nothing

@label "set-algebra: topCoverEvery"
@description "floor-kernel Phase 3b — ⊤ is below an intersection iff it is below every branch (Kleene mAnd; empty intersection is ⊤). Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraTopCoverEvery : (branches: List SetExpr) -> Maybe Boolean
setAlgebraTopCoverEvery branches =
  case head branches of
    Nothing -> Just true
    Just b -> mAnd (setAlgebraTopCover b) (setAlgebraTopCoverEvery (eufRest branches))

@label "set-algebra: topCoverUnion"
@description "floor-kernel Phase 3b — NNF-union top cover: a branch already equal to ⊤ wins; otherwise try the exact complement pairing scan; with no complement pair, an enum/interval-only union is provably bounded and therefore not ⊤. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraTopCoverUnion : (branches: List SetExpr) -> Maybe Boolean
setAlgebraTopCoverUnion branches =
  if setAlgebraTopCoverAnyBranch branches
  then Just true
  else
    case setAlgebraTopCoverUnionPairs branches [] of
      Just b -> Just b
      Nothing ->
        if setAlgebraTopCoverBoundedLeaves branches then Just false else Nothing

@label "set-algebra: topCoverAnyBranch"
@description "floor-kernel Phase 3b — does any union branch independently cover ⊤? Only a Just-true counts; false/unknown cannot refute the whole union. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraTopCoverAnyBranch : (branches: List SetExpr) -> Boolean
setAlgebraTopCoverAnyBranch branches =
  case head branches of
    Nothing -> false
    Just b ->
      case setAlgebraTopCover b of
        Just true -> true
        _ -> setAlgebraTopCoverAnyBranch (eufRest branches)

@label "set-algebra: topCoverUnionPairs"
@description "floor-kernel Phase 3b — scan an NNF union for a complement literal ¬N. For U=P∪¬N, U=⊤ iff N⊆P; build P from the prefix+suffix, normalize it (merging enum/interval covers), and route to the shipped subset face. A decided polarity is exact; an undecided candidate continues the scan. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraTopCoverUnionPairs : (remaining: List SetExpr) -> (prefix: List SetExpr) -> Maybe Boolean
setAlgebraTopCoverUnionPairs remaining prefix =
  case head remaining of
    Nothing -> Nothing
    Just b ->
      let rest = eufRest remaining
      case b of
        SeComplement { inner = i } ->
          let others = concat prefix rest
          let p = setAlgebraTopCoverUnionOf others
          let verdict = setAlgebraTopCoverPair i p others
          case verdict of
            Just r -> Just r
            Nothing -> setAlgebraTopCoverUnionPairs rest (appendItem b prefix)
        _ -> setAlgebraTopCoverUnionPairs rest (appendItem b prefix)

@label "set-algebra: topCoverPair"
@description "floor-kernel Phase 3b — decide N⊆P for one P∪¬N pairing. Empty P uses empty(N) directly (avoids the known enum-empty-vs-SeNone subset precision gap); otherwise normalize P before the subset query. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraTopCoverPair : (inner: SetExpr) -> (positive: SetExpr) -> (others: List SetExpr) -> Maybe Boolean
setAlgebraTopCoverPair inner positive others =
  if eq (length others) 0
  then setAlgebraDecideEmpty inner
  else setAlgebraIsSubset inner (setAlgebraNormalize positive)

@label "set-algebra: topCoverUnionOf"
@description "floor-kernel Phase 3b — collapse a branch list to bottom/singleton/union for the pairing subset query. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraTopCoverUnionOf : (branches: List SetExpr) -> SetExpr
setAlgebraTopCoverUnionOf branches =
  if eq (length branches) 0
  then SeNone
  else if eq (length branches) 1
  then fromMaybe SeNone (head branches)
  else SeUnion { branches = branches }

@label "set-algebra: topCoverBoundedLeaves"
@description "floor-kernel Phase 3b — true iff every branch is an enum/interval/bottom leaf; any such finite union misses other host-domain sorts and cannot be ⊤. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraTopCoverBoundedLeaves : (branches: List SetExpr) -> Boolean
setAlgebraTopCoverBoundedLeaves branches =
  case head branches of
    Nothing -> true
    Just b ->
      let bounded = case b of
        SeNone -> true
        SeEnum { values = _ } -> true
        SeInterval { interval = _ } -> true
        _ -> false
      if bounded then setAlgebraTopCoverBoundedLeaves (eufRest branches) else false

-- ============================================================================
-- floor-kernel Phase 3b — Boolean combinations of arrow atoms.
--
-- Public-top theory arm only: CORE/search/EUF run first. The arm accepts a
-- ctx-free arrow Boolean composite, NNF-normalizes it, distributes to at most
-- 64 DNF terms, and asks each conjunction independently. A term's existing
-- CORE verdict runs first; the new rule handles exactly one negative arrow.
--
-- For positives I and target c->d, the classic single-target condition is:
--   domain(c) <= union_{i in I} domain(i)
--   and for every J subset I,
--     domain(c) <= union_{j in J} domain(j)
--     or intersection_{i in I\J} return(i) <= d.
-- Multi-parameter domains are finite products. Rectangle-union coverage is
-- reduced by complement DNF: assign each positive rectangle to one parameter
-- dimension; every assignment must have some component covered. Both the
-- powerset and rectangle assignment spaces use the same <=64 cap. All leaves
-- recurse only through setAlgebraIsSubset/setAlgebraDecideEmpty; mAnd/mOr keep
-- Kleene Nothing intact. SC-wit is explicit: a negative verdict passes only
-- when the canonical signature (component-domain unions, return intersection)
-- is provably realizable.
-- ============================================================================

@label "set-algebra: decideEmptyArrowBoolArm"
@description "floor-kernel Phase 3b — public-top arrow-Boolean emptiness arm (ledger emp.arrow-bool). For a ctx-free ∩/∖/¬ composite with at least one arrow atom and no non-arrow Boolean leaf, compute NNF then bounded DNF (≤64 terms); CORE gets first refusal on every term; a still-undecided term with exactly one negative arrow uses the classic finite partition condition over flattened equal-arity arrows. Component subset/emptiness verdicts are Kleene-combined without synthesis; multi-negative terms and over-cap products return Nothing."
@tags "engine" "internal" "set-algebra" "decideEmpty" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraDecideEmptyArrowBoolArm : (setExpr: SetExpr) -> Maybe Boolean
setAlgebraDecideEmptyArrowBoolArm setExpr =
  let t = seTag setExpr
  let composite = or (eq t "SeIntersect") (or (eq t "SeDiff") (eq t "SeComplement"))
  if not composite
  then Nothing
  else if not (setAlgebraArrowBoolEligible setExpr)
  then Nothing
  else
    let nnf = setAlgebraNnf setExpr
    case setAlgebraArrowBoolDnf nnf of
      Nothing -> Nothing
      Just terms -> setAlgebraArrowBoolTermsEmpty terms

@label "set-algebra: arrowBoolEligible"
@description "floor-kernel Phase 3b — the shared arrow-Boolean fragment gate: ctx-free, arrow/constant Boolean leaves only, and at least one arrow atom. Used by the public emptiness theory arm and by the kernel witness route's enum⊆compound members loop, so verdict and re-check see the identical fragment. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "witness" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolEligible : (s: SetExpr) -> Boolean
setAlgebraArrowBoolEligible s =
  if not (setAlgebraCtxFree s)
  then false
  else if not (setAlgebraArrowBoolLeavesOk s)
  then false
  else setAlgebraArrowBoolHasArrow s

@label "set-algebra: arrowBoolLeavesOk"
@description "floor-kernel Phase 3b — arrow-Boolean grammar gate: Boolean connectives may contain arrow atoms and ⊤/∅ only; arrow component sets are checked separately by setAlgebraCtxFree. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolLeavesOk : (s: SetExpr) -> Boolean
setAlgebraArrowBoolLeavesOk s = case s of
  SeAll -> true
  SeNone -> true
  SeArrow { params = _ } -> true
  SeUnion { branches = bs } -> setAlgebraArrowBoolLeavesOkAll bs
  SeIntersect { branches = bs } -> setAlgebraArrowBoolLeavesOkAll bs
  SeDiff { left = l, right = r } ->
    if setAlgebraArrowBoolLeavesOk l then setAlgebraArrowBoolLeavesOk r else false
  SeComplement { inner = i } -> setAlgebraArrowBoolLeavesOk i
  _ -> false

@label "set-algebra: arrowBoolLeavesOkAll"
@description "floor-kernel Phase 3b — arrowBoolLeavesOk over every union/intersection branch. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolLeavesOkAll : (branches: List SetExpr) -> Boolean
setAlgebraArrowBoolLeavesOkAll branches =
  case head branches of
    Nothing -> true
    Just b ->
      if setAlgebraArrowBoolLeavesOk b
      then setAlgebraArrowBoolLeavesOkAll (eufRest branches)
      else false

@label "set-algebra: arrowBoolHasArrow"
@description "floor-kernel Phase 3b — true when a Boolean expression contains at least one SeArrow atom. Prevents the theory arm from stealing data-only composites. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolHasArrow : (s: SetExpr) -> Boolean
setAlgebraArrowBoolHasArrow s = case s of
  SeArrow { params = _ } -> true
  SeUnion { branches = bs } -> setAlgebraArrowBoolHasArrowAny bs
  SeIntersect { branches = bs } -> setAlgebraArrowBoolHasArrowAny bs
  SeDiff { left = l, right = r } ->
    if setAlgebraArrowBoolHasArrow l then true else setAlgebraArrowBoolHasArrow r
  SeComplement { inner = i } -> setAlgebraArrowBoolHasArrow i
  _ -> false

@label "set-algebra: arrowBoolHasArrowAny"
@description "floor-kernel Phase 3b — existential arrow-atom scan over Boolean branches. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolHasArrowAny : (branches: List SetExpr) -> Boolean
setAlgebraArrowBoolHasArrowAny branches =
  case head branches of
    Nothing -> false
    Just b ->
      if setAlgebraArrowBoolHasArrow b
      then true
      else setAlgebraArrowBoolHasArrowAny (eufRest branches)

-- DNF is represented without a new entity: Maybe (List (List SetExpr)). An
-- outer empty list is bottom; one empty inner list is top. NNF guarantees diff
-- is gone and complement appears only as a signed leaf.

@label "set-algebra: arrowBoolDnf"
@description "floor-kernel Phase 3b — bounded DNF over an NNF arrow Boolean expression, represented as a list of conjunction-literal lists. Union concatenates terms; intersection takes a Cartesian product; either expansion exceeding 64 terms returns Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "dnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolDnf : (s: SetExpr) -> Maybe (List (List SetExpr))
setAlgebraArrowBoolDnf s = case s of
  SeAll ->
    let term = []
    Just (appendItem term [])
  SeNone -> Just []
  SeUnion { branches = bs } -> setAlgebraArrowBoolDnfUnion bs []
  SeIntersect { branches = bs } ->
    let term = []
    let seed = appendItem term []
    setAlgebraArrowBoolDnfIntersect bs seed
  _ ->
    let term = appendItem s []
    Just (appendItem term [])

@label "set-algebra: arrowBoolDnfUnion"
@description "floor-kernel Phase 3b — concatenate each union branch's DNF, fencing once the cumulative term count exceeds 64. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "dnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolDnfUnion : (branches: List SetExpr) -> (acc: List (List SetExpr)) -> Maybe (List (List SetExpr))
setAlgebraArrowBoolDnfUnion branches acc =
  case head branches of
    Nothing -> Just acc
    Just b ->
      case setAlgebraArrowBoolDnf b of
        Nothing -> Nothing
        Just terms ->
          let acc2 = concat acc terms
          if gt (length acc2) 64
          then Nothing
          else setAlgebraArrowBoolDnfUnion (eufRest branches) acc2

@label "set-algebra: arrowBoolDnfIntersect"
@description "floor-kernel Phase 3b — Cartesian-product each intersection branch's DNF into the running term list; product >64 fences. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "dnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolDnfIntersect : (branches: List SetExpr) -> (acc: List (List SetExpr)) -> Maybe (List (List SetExpr))
setAlgebraArrowBoolDnfIntersect branches acc =
  case head branches of
    Nothing -> Just acc
    Just b ->
      case setAlgebraArrowBoolDnf b of
        Nothing -> Nothing
        Just terms ->
          if gt (mul (length acc) (length terms)) 64
          then Nothing
          else
            let acc2 = setAlgebraArrowBoolDnfCross acc terms
            setAlgebraArrowBoolDnfIntersect (eufRest branches) acc2

@label "set-algebra: arrowBoolDnfCross"
@description "floor-kernel Phase 3b — Cartesian product of two DNF term lists; concatenate the literal lists for each pair. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "dnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolDnfCross : (leftTerms: List (List SetExpr)) -> (rightTerms: List (List SetExpr)) -> List (List SetExpr)
setAlgebraArrowBoolDnfCross leftTerms rightTerms =
  case head leftTerms of
    Nothing -> []
    Just lt ->
      let first = setAlgebraArrowBoolDnfCrossOne lt rightTerms
      concat first (setAlgebraArrowBoolDnfCross (eufRest leftTerms) rightTerms)

@label "set-algebra: arrowBoolDnfCrossOne"
@description "floor-kernel Phase 3b — pair one left conjunction with every right conjunction. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "dnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolDnfCrossOne : (leftTerm: List SetExpr) -> (rightTerms: List (List SetExpr)) -> List (List SetExpr)
setAlgebraArrowBoolDnfCrossOne leftTerm rightTerms =
  case head rightTerms of
    Nothing -> []
    Just rt ->
      let term = concat leftTerm rt
      concat [term] (setAlgebraArrowBoolDnfCrossOne leftTerm (eufRest rightTerms))

@label "set-algebra: arrowBoolTermsEmpty"
@description "floor-kernel Phase 3b — a DNF union is empty iff every conjunction term is empty (Kleene mAnd; zero terms is bottom). Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolTermsEmpty : (terms: List (List SetExpr)) -> Maybe Boolean
setAlgebraArrowBoolTermsEmpty terms =
  case head terms of
    Nothing -> Just true
    Just term -> mAnd (setAlgebraArrowBoolTermEmpty term) (setAlgebraArrowBoolTermsEmpty (eufRest terms))

@label "set-algebra: arrowBoolTermEmpty"
@description "floor-kernel Phase 3b — decide one DNF conjunction. Rebuild it and give CORE first refusal (existing no-negative and obvious pair rules retain ownership); only a CORE-Nothing term is classified for the new single-negative decomposition. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolTermEmpty : (literals: List SetExpr) -> Maybe Boolean
setAlgebraArrowBoolTermEmpty literals =
  let term = setAlgebraArrowBoolTermExpr literals
  case setAlgebraDecideEmptyCore term of
    Just b -> Just b
    Nothing -> setAlgebraArrowBoolClassifyTerm literals [] []

@label "set-algebra: arrowBoolTermExpr"
@description "floor-kernel Phase 3b — collapse a conjunction literal list to ⊤/singleton/SeIntersect for the CORE pre-check. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolTermExpr : (literals: List SetExpr) -> SetExpr
setAlgebraArrowBoolTermExpr literals =
  if eq (length literals) 0
  then SeAll
  else if eq (length literals) 1
  then fromMaybe SeAll (head literals)
  else SeIntersect { branches = literals }

@label "set-algebra: arrowBoolClassifyTerm"
@description "floor-kernel Phase 3b — split a CORE-undecided DNF term into positive SeArrow atoms and negative complement-of-SeArrow atoms; constants are neutral/absorbing; any other literal fences. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolClassifyTerm : (literals: List SetExpr) -> (positives: List SetExpr) -> (negatives: List SetExpr) -> Maybe Boolean
setAlgebraArrowBoolClassifyTerm literals positives negatives =
  case head literals of
    Nothing -> setAlgebraArrowBoolFinishTerm positives negatives
    Just lit -> case lit of
      SeAll -> setAlgebraArrowBoolClassifyTerm (eufRest literals) positives negatives
      SeNone -> Just true
      SeArrow { params = _ } ->
        let ps = appendItem lit positives
        setAlgebraArrowBoolClassifyTerm (eufRest literals) ps negatives
      SeComplement { inner = i } -> case i of
        SeArrow { params = _ } ->
          let ns = appendItem i negatives
          setAlgebraArrowBoolClassifyTerm (eufRest literals) positives ns
        _ -> Nothing
      _ -> Nothing

@label "set-algebra: arrowBoolFinishTerm"
@description "floor-kernel Phase 3b — dispatch a classified conjunction: zero negatives stays owned by CORE; more than one is the Phase-3c multi-negative fence; a negative with no positive arrow is nonempty via a scalar witness; exactly one of each side enters the decomposition. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolFinishTerm : (positives: List SetExpr) -> (negatives: List SetExpr) -> Maybe Boolean
setAlgebraArrowBoolFinishTerm positives negatives =
  if eq (length negatives) 0
  then Nothing
  else if gt (length negatives) 1
  then Nothing
  else if eq (length positives) 0
  then Just false
  else
    case head negatives of
      Nothing -> Nothing
      Just target -> setAlgebraArrowBoolSingleNegative positives target

@label "set-algebra: arrowBoolSingleNegative"
@description "floor-kernel Phase 3b — emptiness of (intersection positives)∩¬target. Flatten arrows, drop vacuous positive constraints, require equal residual arity, enforce the 64-state powerset/rectangle caps, then combine the classic partition subset condition with the SC-wit realizability gate. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolSingleNegative : (positives: List SetExpr) -> (target: SetExpr) -> Maybe Boolean
setAlgebraArrowBoolSingleNegative positives target =
  let flatTarget = arrowFlatten target
  if arrowSomeParamEmpty flatTarget.params
  then Just true
  else
    let active = setAlgebraArrowBoolActivePositives positives
    if eq (length active) 0
    then setAlgebraArrowBoolNoActive flatTarget
    else if not (setAlgebraArrowBoolSameArity active (length flatTarget.params))
    then Nothing
    else
      let n = length active
      let arity = length flatTarget.params
      let partitionCount = setAlgebraArrowBoolPowLimited 2 n
      let rectangleCount = setAlgebraArrowBoolPowLimited arity n
      if or (gt partitionCount 64) (gt rectangleCount 64)
      then Nothing
      else setAlgebraArrowBoolSingleNegativeRun active flatTarget

@label "set-algebra: arrowBoolNoActive"
@description "floor-kernel Phase 3b — all positive arrow atoms were vacuous constraints. Their conjunction is the callable universe: it is below target only when target's domain is provably empty; an inhabited target domain yields a realizable counter-signature; unknown stays Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolNoActive : (target: SetExpr) -> Maybe Boolean
setAlgebraArrowBoolNoActive target =
  case arrowParamsInhab target.params false of
    Just true -> Just false
    Just false -> Just true
    Nothing -> Nothing

@label "set-algebra: arrowBoolActivePositives"
@description "floor-kernel Phase 3b — flatten positive arrows and drop a constraint with a provably-empty parameter domain (vacuous absorption: it denotes all callables and contributes no restriction). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolActivePositives : (positives: List SetExpr) -> List SetExpr
setAlgebraArrowBoolActivePositives positives =
  case head positives of
    Nothing -> []
    Just p ->
      let fp = arrowFlatten p
      if arrowSomeParamEmpty fp.params
      then setAlgebraArrowBoolActivePositives (eufRest positives)
      else concat [fp] (setAlgebraArrowBoolActivePositives (eufRest positives))

@label "set-algebra: arrowBoolSameArity"
@description "floor-kernel Phase 3b — every flattened positive arrow must have the target's arity; residual callable-tail combinations remain honestly fenced. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolSameArity : (positives: List SetExpr) -> (arity: Number) -> Boolean
setAlgebraArrowBoolSameArity positives arity =
  case head positives of
    Nothing -> true
    Just p ->
      if eq (length p.params) arity
      then setAlgebraArrowBoolSameArity (eufRest positives) arity
      else false

@label "set-algebra: arrowBoolPowLimited"
@description "floor-kernel Phase 3b — small natural power with saturation at 65, used for both ≤64 enumeration caps. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolPowLimited : (base: Number) -> (exponent: Number) -> Number
setAlgebraArrowBoolPowLimited base exponent =
  if lte exponent 0
  then 1
  else
    let rest = setAlgebraArrowBoolPowLimited base (sub exponent 1)
    let product = mul base rest
    if gt product 64 then 65 else product

@label "set-algebra: arrowBoolSingleNegativeRun"
@description "floor-kernel Phase 3b — run the single-target theorem and apply SC-wit. A provably unrealizable positive signature space makes the term empty; a proven subset makes it empty even if realizability is unknown; a nonempty verdict requires realizability Just true. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolSingleNegativeRun : (positives: List SetExpr) -> (target: SetExpr) -> Maybe Boolean
setAlgebraArrowBoolSingleNegativeRun positives target =
  let realizable = setAlgebraArrowBoolPositiveRealizable positives (length target.params)
  let coverAll = setAlgebraArrowBoolRectCovered target.params positives
  let partitions = setAlgebraArrowBoolPartitions positives [] [] target
  let theorem = mAnd coverAll partitions
  case realizable of
    Just true -> theorem
    Just false -> Just true
    Nothing -> case theorem of
      Just true -> Just true
      _ -> Nothing

-- SC-wit: the least common signature satisfying every positive constraint has
-- each parameter equal to the componentwise union of positive domains and its
-- return equal to the intersection of positive returns. It is realizable iff
-- some parameter is empty or the return is inhabited (§3.1/§4).

@label "set-algebra: arrowBoolPositiveRealizable"
@description "floor-kernel Phase 3b — SC-wit realizability of the canonical signature satisfying all active positives: return-intersection inhabited OR some component-domain union empty. Kleene exact; zero active positives is handled before this helper. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "witness" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolPositiveRealizable : (positives: List SetExpr) -> (arity: Number) -> Maybe Boolean
setAlgebraArrowBoolPositiveRealizable positives arity =
  let returns = setAlgebraArrowBoolReturnMeet positives
  let returnInhabited = setAlgebraArrowBoolNotEmpty returns
  let vacuous = setAlgebraArrowBoolCandidateParamEmpty positives 0 arity
  mOr returnInhabited vacuous

@label "set-algebra: arrowBoolNotEmpty"
@description "floor-kernel Phase 3b — Kleene negation of decideEmpty for the signature-realizability check. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolNotEmpty : (s: SetExpr) -> Maybe Boolean
setAlgebraArrowBoolNotEmpty s =
  case setAlgebraDecideEmpty s of
    Just true -> Just false
    Just false -> Just true
    Nothing -> Nothing

@label "set-algebra: arrowBoolCandidateParamEmpty"
@description "floor-kernel Phase 3b — is any componentwise union of positive domains empty? This is the vacuous half of exact signature realizability. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "witness" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolCandidateParamEmpty : (positives: List SetExpr) -> (dim: Number) -> (arity: Number) -> Maybe Boolean
setAlgebraArrowBoolCandidateParamEmpty positives dim arity =
  if gte dim arity
  then Just false
  else
    let domains = setAlgebraArrowBoolDomainsAt positives dim
    let domain = setAlgebraArrowBoolUnionOf domains
    mOr (setAlgebraDecideEmpty domain) (setAlgebraArrowBoolCandidateParamEmpty positives (add dim 1) arity)

@label "set-algebra: arrowBoolReturnMeet"
@description "floor-kernel Phase 3b — normalized intersection of a list of positive-arrow returns; empty list is ⊤. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolReturnMeet : (positives: List SetExpr) -> SetExpr
setAlgebraArrowBoolReturnMeet positives =
  let returns = setAlgebraArrowBoolReturns positives
  if eq (length returns) 0
  then SeAll
  else if eq (length returns) 1
  then fromMaybe SeAll (head returns)
  else setAlgebraNormalize (SeIntersect { branches = returns })

@label "set-algebra: arrowBoolReturns"
@description "floor-kernel Phase 3b — project returns from a list of flattened SeArrow values. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolReturns : (positives: List SetExpr) -> List SetExpr
setAlgebraArrowBoolReturns positives =
  case head positives of
    Nothing -> []
    Just p -> concat [p.returns] (setAlgebraArrowBoolReturns (eufRest positives))

-- The theorem's finite powerset. `selected` is J; `rejected` is I\J.

@label "set-algebra: arrowBoolPartitions"
@description "floor-kernel Phase 3b — enumerate every subset J of the positive arrows (the caller enforces 2^|I|≤64), Kleene-ANDing the classic per-partition condition. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolPartitions : (remaining: List SetExpr) -> (selected: List SetExpr) -> (rejected: List SetExpr) -> (target: SetExpr) -> Maybe Boolean
setAlgebraArrowBoolPartitions remaining selected rejected target =
  case head remaining of
    Nothing -> setAlgebraArrowBoolPartitionCondition selected rejected target
    Just p ->
      let rest = eufRest remaining
      let withP = setAlgebraArrowBoolPartitions rest (appendItem p selected) rejected target
      let withoutP = setAlgebraArrowBoolPartitions rest selected (appendItem p rejected) target
      mAnd withP withoutP

@label "set-algebra: arrowBoolPartitionCondition"
@description "floor-kernel Phase 3b — one classic partition condition: target-domain covered by selected positive domains OR the rejected positives' return intersection is below the target return. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolPartitionCondition : (selected: List SetExpr) -> (rejected: List SetExpr) -> (target: SetExpr) -> Maybe Boolean
setAlgebraArrowBoolPartitionCondition selected rejected target =
  let domainCovered = setAlgebraArrowBoolRectCovered target.params selected
  let returns = setAlgebraArrowBoolReturnMeet rejected
  let returnCovered = setAlgebraIsSubset returns target.returns
  mOr domainCovered returnCovered

-- Product-domain rectangle coverage. For selected boxes A_i and target box C,
-- C <= union A_i iff every choice of one failed dimension per A_i has some
-- dimension k where C_k <= union of the A_ik assigned to k.

@label "set-algebra: arrowBoolRectCovered"
@description "floor-kernel Phase 3b — exact finite rectangle-union cover for equal-arity parameter products. Empty target product wins; zero selected rectangles covers only an empty target; nullary domains are unit and one selected rectangle covers; otherwise enumerate dimension assignments (caller-capped ≤64). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolRectCovered : (targetParams: List SetArrowParam) -> (selected: List SetExpr) -> Maybe Boolean
setAlgebraArrowBoolRectCovered targetParams selected =
  let targetEmpty = setAlgebraArrowBoolSomeParamEmpty targetParams
  if eq (length selected) 0
  then targetEmpty
  else
    let arity = length targetParams
    if eq arity 0
    then Just true
    else
      let assignments = setAlgebraArrowBoolRectAssignments selected selected [] targetParams arity
      mOr targetEmpty assignments

@label "set-algebra: arrowBoolSomeParamEmpty"
@description "floor-kernel Phase 3b — product-domain emptiness: some parameter set empty (Kleene mOr; nullary product is inhabited). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolSomeParamEmpty : (params: List SetArrowParam) -> Maybe Boolean
setAlgebraArrowBoolSomeParamEmpty params =
  case head params of
    Nothing -> Just false
    Just p -> mOr (setAlgebraDecideEmpty p.set) (setAlgebraArrowBoolSomeParamEmpty (eufRest params))

@label "set-algebra: arrowBoolRectAssignments"
@description "floor-kernel Phase 3b — recursively assign each selected positive rectangle to one failing parameter dimension; every assignment term must be empty, so branches combine with Kleene mAnd. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolRectAssignments : (remaining: List SetExpr) -> (allPositives: List SetExpr) -> (choices: List Number) -> (targetParams: List SetArrowParam) -> (arity: Number) -> Maybe Boolean
setAlgebraArrowBoolRectAssignments remaining allPositives choices targetParams arity =
  case head remaining of
    Nothing -> setAlgebraArrowBoolAssignmentTerm allPositives choices targetParams arity
    Just p ->
      let rest = eufRest remaining
      setAlgebraArrowBoolRectChoiceLoop 0 arity rest allPositives choices targetParams

@label "set-algebra: arrowBoolRectChoiceLoop"
@description "floor-kernel Phase 3b — enumerate one rectangle's possible failed dimension, Kleene-ANDing the recursively completed assignments. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolRectChoiceLoop : (dim: Number) -> (arity: Number) -> (rest: List SetExpr) -> (allPositives: List SetExpr) -> (choices: List Number) -> (targetParams: List SetArrowParam) -> Maybe Boolean
setAlgebraArrowBoolRectChoiceLoop dim arity rest allPositives choices targetParams =
  if gte dim arity
  then Just true
  else
    let choices2 = appendItem dim choices
    let branch = setAlgebraArrowBoolRectAssignments rest allPositives choices2 targetParams arity
    let later = setAlgebraArrowBoolRectChoiceLoop (add dim 1) arity rest allPositives choices targetParams
    mAnd branch later

@label "set-algebra: arrowBoolAssignmentTerm"
@description "floor-kernel Phase 3b — one complement-DNF rectangle term is empty when some parameter component is covered by the domains assigned to that dimension. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolAssignmentTerm : (positives: List SetExpr) -> (choices: List Number) -> (targetParams: List SetArrowParam) -> (arity: Number) -> Maybe Boolean
setAlgebraArrowBoolAssignmentTerm positives choices targetParams arity =
  setAlgebraArrowBoolAssignmentDims positives choices targetParams 0 arity

@label "set-algebra: arrowBoolAssignmentDims"
@description "floor-kernel Phase 3b — Kleene-OR the component cover query across all parameter dimensions for one rectangle assignment. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolAssignmentDims : (positives: List SetExpr) -> (choices: List Number) -> (targetParams: List SetArrowParam) -> (dim: Number) -> (arity: Number) -> Maybe Boolean
setAlgebraArrowBoolAssignmentDims positives choices targetParams dim arity =
  if gte dim arity
  then Just false
  else
    case setAlgebraArrowBoolParamSetAtRaw targetParams dim of
      Nothing -> Nothing
      Just targetSet ->
        let assigned = setAlgebraArrowBoolAssignedDomains positives choices dim
        let component = setAlgebraArrowBoolComponentCovered targetSet assigned
        mOr component (setAlgebraArrowBoolAssignmentDims positives choices targetParams (add dim 1) arity)

@label "set-algebra: arrowBoolComponentCovered"
@description "floor-kernel Phase 3b — target component subset of the union of assigned domains. No assigned domain means target-component emptiness directly; otherwise normalize the union before the shipped subset query (merges interval covers). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolComponentCovered : (targetSet: SetExpr) -> (assigned: List SetExpr) -> Maybe Boolean
setAlgebraArrowBoolComponentCovered targetSet assigned =
  if eq (length assigned) 0
  then setAlgebraDecideEmpty targetSet
  else setAlgebraIsSubset targetSet (setAlgebraArrowBoolUnionOf assigned)

@label "set-algebra: arrowBoolAssignedDomains"
@description "floor-kernel Phase 3b — zip positive arrows with a dimension-choice list and collect the parameter set for entries assigned to the requested dimension. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolAssignedDomains : (positives: List SetExpr) -> (choices: List Number) -> (dim: Number) -> List SetExpr
setAlgebraArrowBoolAssignedDomains positives choices dim =
  case head positives of
    Nothing -> []
    Just p ->
      case head choices of
        Nothing -> []
        Just chosen ->
          let rest = setAlgebraArrowBoolAssignedDomains (eufRest positives) (eufRest choices) dim
          if eq chosen dim
          then case setAlgebraArrowBoolParamSetAt p dim of
            Just s -> concat [s] rest
            Nothing -> rest
          else rest

@label "set-algebra: arrowBoolDomainsAt"
@description "floor-kernel Phase 3b — collect every positive arrow's parameter set at one dimension. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolDomainsAt : (positives: List SetExpr) -> (dim: Number) -> List SetExpr
setAlgebraArrowBoolDomainsAt positives dim =
  case head positives of
    Nothing -> []
    Just p ->
      let rest = setAlgebraArrowBoolDomainsAt (eufRest positives) dim
      case setAlgebraArrowBoolParamSetAt p dim of
        Just s -> concat [s] rest
        Nothing -> rest

@label "set-algebra: arrowBoolParamSetAt"
@description "floor-kernel Phase 3b — safe 0-based parameter-set projection from a flattened SeArrow. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolParamSetAt : (arrow: SetExpr) -> (dim: Number) -> Maybe SetExpr
setAlgebraArrowBoolParamSetAt arrow dim = case arrow of
  SeArrow { params = ps } -> setAlgebraArrowBoolParamSetAtRaw ps dim
  _ -> Nothing

@label "set-algebra: arrowBoolParamSetAtRaw"
@description "floor-kernel Phase 3b — safe 0-based parameter-set projection from a parameter list. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolParamSetAtRaw : (params: List SetArrowParam) -> (dim: Number) -> Maybe SetExpr
setAlgebraArrowBoolParamSetAtRaw params dim =
  case head (arrowDropList params dim) of
    Nothing -> Nothing
    Just p -> Just p.set

@label "set-algebra: arrowBoolUnionOf"
@description "floor-kernel Phase 3b — collapse and normalize a list of component sets as a union; empty list is ∅. Used by rectangle coverage and the realizability signature. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "boolean" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraArrowBoolUnionOf : (domains: List SetExpr) -> SetExpr
setAlgebraArrowBoolUnionOf domains =
  if eq (length domains) 0
  then SeNone
  else if eq (length domains) 1
  then fromMaybe SeNone (head domains)
  else setAlgebraNormalize (SeUnion { branches = domains })

-- Interval emptiness: an interval is empty iff it is NOT valid (the
-- TS oracle's `mJust(!intervalIsValid(iv))`). intervalIsValid already
-- lives Fenel-side; this arm self-reasons over the raw marshalled
-- Interval instead of consuming a TS-pre-computed MaybeBool.
@label "set-algebra: decideEmptyInterval"
@description "Phase 2a (set-algebra-to-fenel) — interval emptiness = NOT intervalIsValid, returned as MaybeBool. Self-reasoning leaf; mirrors implementations/typescript/engine/src/set-algebra.ts:setIntervalDecideEmpty. Internal helper."
@tags "engine" "internal" "set-algebra" "empty" "phase-2a"
@category "engine-internal"
setAlgebraDecideEmptyInterval : (iv: Interval) -> Maybe Boolean
setAlgebraDecideEmptyInterval iv =
  if intervalIsValid iv then Just false else Just true

-- mEvery semantics for Union: ⋃ empty iff every branch empty.
--   any Just false ⇒ Just false (one non-empty branch refutes)
--   all Just true ⇒ Just true
--   any Nothing (no Just false) ⇒ Nothing
@label "set-algebra: decideEmptyUnion"
@description "Phase 7b-recursive — mEvery semantics for union emptiness (all branches empty). Internal helper."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraDecideEmptyUnion : (branches: List SetExpr) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraDecideEmptyUnion branches sawNothing =
  case head branches of
    Nothing -> if sawNothing then Nothing else Just true
    Just first ->
      let r = setAlgebraDecideEmptyCore first
      case r of
        Just false -> Just false
        Just true ->
          case tail branches of
            Nothing -> if sawNothing then Nothing else Just true
            Just rest -> setAlgebraDecideEmptyUnion rest sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraDecideEmptyUnion rest true

-- Intersect emptiness: any branch empty ⇒ Just true; any pair PROVABLY disjoint
-- ⇒ Just true; single-branch collapse; else Nothing. set-algebra-to-fenel Phase
-- 3b-3 Step 3 Stage B — the pairwise-disjoint LOOP (formerly a TS double-loop in
-- `marshalSetExprForDecideEmpty` that pre-computed `anyPairDisjoint`) now runs IN
-- Fenel via `setAlgebraAnyPairDisjoint`. containment-substrate Phase 1c — the
-- per-pair decision is the DIRECT sibling decider `setAlgebraIsDisjoint` (the
-- `pairDisjoint` ctx-native + its `$tag→$-key→$tag` round-trip through `sa.isDisjoint`
-- are DELETED — pure TS indirection over an already-Fenel decider). Byte-identical:
-- the old body only branched on `Just true`, so a `Bool` "any pair provably disjoint"
-- is exact (the old apd's `Just false`/`Nothing` both fell to the `_` arm).
@label "set-algebra: decideEmptyIntersect"
@description "Phase 3b-3 Step 3 Stage B — intersect emptiness combining any-branch-empty + the in-Fenel pairwise-disjoint loop (direct setAlgebraIsDisjoint sibling calls; Phase 1c) + single-branch collapse. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "phase-3b-3"
@category "engine-internal"
setAlgebraDecideEmptyIntersect : (branches: List SetExpr) -> Maybe Boolean
setAlgebraDecideEmptyIntersect branches =
  if setAlgebraAnyBranchEmpty branches
  then Just true
  else if setAlgebraAnyPairDisjoint branches
  then Just true
  else if eq (length branches) 1
  then case head branches of
    Nothing -> Nothing
    Just b -> setAlgebraDecideEmptyCore b
  else Nothing

-- The pairwise-disjoint scan: is any unordered pair (i < j) PROVABLY disjoint?
-- Each pair is decided by the DIRECT sibling decider `setAlgebraIsDisjoint`
-- (Phase 1c — the `pairDisjoint` ctx-native round-trip is deleted); only `Just
-- true` counts (an undecided / Just-false pair doesn't prove the intersect
-- empty). Mirrors the retired TS double-loop's short-circuit-on-first-true.
@label "set-algebra: anyPairDisjoint"
@description "Phase 3b-3 Step 3 Stage B — does any unordered pair of intersect branches return `Just true` from setAlgebraIsDisjoint (the direct sibling call; Phase 1c)? The in-Fenel replacement for the TS pairwise-disjoint pre-compute. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "phase-3b-3"
@category "engine-internal"
setAlgebraAnyPairDisjoint : (branches: List SetExpr) -> Boolean
setAlgebraAnyPairDisjoint branches = case head branches of
  Nothing -> false
  Just first ->
    case tail branches of
      Nothing -> false
      Just rest ->
        if setAlgebraPairDisjointWithAny first rest
        then true
        else setAlgebraAnyPairDisjoint rest

@label "set-algebra: pairDisjointWithAny"
@description "Phase 3b-3 Step 3 Stage B — is `x` PROVABLY disjoint (setAlgebraIsDisjoint ⇒ Just true; Phase 1c direct sibling call) from ANY element of `ys`? Inner scan of setAlgebraAnyPairDisjoint. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "phase-3b-3"
@category "engine-internal"
setAlgebraPairDisjointWithAny : (x: SetExpr) -> (ys: List SetExpr) -> Boolean
setAlgebraPairDisjointWithAny x ys = case head ys of
  Nothing -> false
  Just y ->
    case setAlgebraIsDisjoint x y of
      Just true -> true
      _ ->
        case tail ys of
          Nothing -> false
          Just rest -> setAlgebraPairDisjointWithAny x rest

@label "set-algebra: anyBranchEmpty"
@description "Phase 7b-recursive — does any branch of the intersect provably reduce to ∅? Internal helper."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraAnyBranchEmpty : (branches: List SetExpr) -> Boolean
setAlgebraAnyBranchEmpty branches =
  case head branches of
    Nothing -> false
    Just first ->
      let r = setAlgebraDecideEmptyCore first
      case r of
        Just true -> true
        _ ->
          case tail branches of
            Nothing -> false
            Just rest -> setAlgebraAnyBranchEmpty rest

-- Diff emptiness: a empty ⇒ Just true; else a ⊆ b. containment-substrate Phase
-- 1c — `a ⊆ b` is the DIRECT sibling decider `setAlgebraIsSubset` (the `subsetCheck`
-- ctx-native + its `$tag→$-key→$tag` round-trip through `sa.isSubset` are DELETED;
-- replaces the TS-pre-computed `aSubsetB`).
@label "set-algebra: decideEmptyDiff"
@description "Phase 3b-3 Step 3 Stage B — A minus B empty iff A empty or A ⊆ B (direct setAlgebraIsSubset sibling call; Phase 1c). Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "phase-3b-3"
@category "engine-internal"
setAlgebraDecideEmptyDiff : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraDecideEmptyDiff a b =
  let ea = setAlgebraDecideEmptyCore a
  case ea of
    Just true -> Just true
    _ -> setAlgebraIsSubset a b

-- Complement emptiness: the base ¬⊤/¬∅ cases first. Phase 3b widens the old
-- else-fence by the shared ctx-free NNF top-cover engine:
-- empty(¬w) iff top is a subset of w. The cover face starts with the shipped
-- pairing rule (P ∪ ¬N = top iff N ⊆ P), plus exact enum/interval leaf facts;
-- every undecided component passes through as Nothing.
@label "set-algebra: decideEmptyComplement"
@description "Phase 3b-3 Step 3 Stage B / floor-kernel Phase 3b — ¬A empty iff A covers ⊤. The direct SeAll/SeNone cases stay first; the ctx-free else arm computes setAlgebraNnf A and asks setAlgebraTopCover, whose minimal complete slice is excluded-middle/pairing plus enum/interval leaf covers. Tri passthrough only. Internal helper."
@tags "engine" "internal" "set-algebra" "decideEmpty" "complement" "nnf" "floor-kernel" "phase-3b"
@category "engine-internal"
setAlgebraDecideEmptyComplement : (inner: SetExpr) -> Maybe Boolean
setAlgebraDecideEmptyComplement inner = case inner of
  SeAll -> Just true
  SeNone -> Just false
  _ ->
    if setAlgebraCtxFree inner
    then setAlgebraTopCover (setAlgebraNnf inner)
    else Nothing

-- ============================================================================
-- Phase 2a (set-algebra-to-fenel) — Aggregable composition-shape recognition
-- + the empty $where decider arm. Ports
-- implementations/typescript/engine/src/set-algebra.ts:recognizeAggregableComposition
-- (+ aggCallFn / isComparable). The TS marshaller surfaces the
-- `call(aggFn, var(value))` operand that JleComp collapses, as a
-- JsonLogicAggExpr; the aggregable-name set is fed in as a `List String`
-- DATA table (the namedSubset-hierarchy-table precedent — there is no
-- Fenel-callable isAggregable bridge, see roadmap D2a-b correction). The
-- body checks membership + lifts to an output-space set, reusing the
-- already-Fenel compToSet + the WhereExtractedSet marker family.
-- ============================================================================

-- JsonLogicAggExpr — pre-marshalled view of a $where predicate's
-- Aggregable-composition shape. JaeComp surfaces `agg(value) <op> K`
-- (varSide "left") or `K <op> agg(value)` (varSide "right"); JaeIn
-- surfaces `agg(value) in [k...]`; JaeOther is everything else.
JsonLogicAggExpr =
  JaeComp aggFn: String op: String value: Any varSide: String isNumeric: Boolean
  | JaeIn aggFn: String values: List Any
  | JaeOther

-- AggComposition — the recognised aggregator name + the lifted output-
-- space set. decide-substrate Phase 3 (the family-completion tail,
-- `design/deciding.md` §4 "Aggregable reconciles BESIDE"): the outputSet is
-- now a CANONICAL `Se*` SetExpr (SeInterval / SeEnum / SeDiff / SeAll),
-- constructed DIRECTLY — the WhereExtractedSet (Wes*) + CompToSetResult (Cts*)
-- intent-marker vocabularies + their TS unmarshallers are RETIRED (the last
-- marker vocabulary in the deciders). Aggregable stays an ADAPTER: it FEEDS the
-- `$where` decider arms a lifted output-space set the Se* deciders reason over
-- (subset / disjoint / empty), not a decide-and-synthesize theory.
AggComposition = AggComp aggFn: String outputSet: SetExpr

@label "set-algebra: recognizeAggregableComposition"
@description "Phase 2a (set-algebra-to-fenel) — recognise `agg(value) <op> K` / `K <op> agg(value)` / `agg(value) in [...]` inside a $where predicate, where `agg` is a registered Aggregable (membership checked against the fed `aggNames: List String` data table). Lifts to a canonical `Se*` output-space set via compToSet (comparisons) or SeEnum (`in`) — decide-substrate Phase 3 (the Wes*/Cts* marker layer RETIRED). Operates on a pre-marshalled JsonLogicAggExpr (the marshaller surfaces the call(aggFn, var(value)) operand). Mirrors implementations/typescript/engine/src/set-algebra.ts:recognizeAggregableComposition."
@tags "engine" "internal" "set-algebra" "aggregable" "where" "phase-2a"
@category "engine-internal"
recognizeAggregableComposition : (expr: JsonLogicAggExpr) -> (aggNames: List String) -> Maybe AggComposition
recognizeAggregableComposition expr aggNames = case expr of
  JaeOther -> Nothing
  JaeComp { aggFn = fn, op = op, value = v, varSide = side, isNumeric = num } ->
    if setAlgebraListContains aggNames fn
    then Just (AggComp { aggFn = fn, outputSet = compToSet op v side num })
    else Nothing
  JaeIn { aggFn = fn, values = vs } ->
    if setAlgebraListContains aggNames fn
    then Just (AggComp { aggFn = fn, outputSet = SeEnum { values = vs } })
    else Nothing

-- Empty $where arm: recognise → lift → leaf-emptiness. Mirrors
-- set-algebra.ts:setWhereDecideEmpty — `Just true` only when the lifted
-- output set is provably empty (an empty `in` enum; comparison lifts are
-- single-bound intervals / singletons / ⊤, never provably empty over
-- reals), else `Nothing`.
@label "set-algebra: decideEmptyWhere"
@description "Phase 2a (set-algebra-to-fenel) — $where emptiness via Aggregable composition: f⁻¹(∅) = ∅. Recognise the predicate, lift to a canonical `Se*` output set, return Just true iff that set is provably empty (empty `in` enum), else Nothing. decide-substrate Phase 3: the lifted output set is a real `Se*` SetExpr, so emptiness is the polymorphic `setAlgebraDecideEmpty` (the Wes*/liftedEmptiness marker layer RETIRED). Mirrors implementations/typescript/engine/src/set-algebra.ts:setWhereDecideEmpty. Internal helper to setAlgebraDecideEmpty's SeWhere arm."
@tags "engine" "internal" "set-algebra" "empty" "aggregable" "phase-2a" "phase-3"
@category "engine-internal"
setAlgebraDecideEmptyWhere : (pred: JsonLogicAggExpr) -> (aggNames: List String) -> Maybe Boolean
setAlgebraDecideEmptyWhere pred aggNames =
  case recognizeAggregableComposition pred aggNames of
    Nothing -> Nothing
    Just (AggComp { outputSet = os }) ->
      case setAlgebraDecideEmptyCore os of
        Just true -> Just true
        _ -> Nothing

-- ============================================================================
-- Phase 3b-3 Step 3 Stage C — isDisjoint over the canonical `$tag` `Se*` ADT
-- (TWO args). The body self-reasons each structural-leaf decision AND owns the
-- symmetric swap (a ∩ b = b ∩ a — when the left shape's rule doesn't positively
-- prove, the right shape's is tried with the args reversed: the ported
-- `perShapeDisjointWithSwap`); a's Union / Intersect compounds fold mEvery /
-- mSome. The per-query `SetExprIsDisjointAdt` mirror (`Sid*`) + the
-- `SidDisjointLeaf` (`Side*`) + `SidDisjointBSide` (`Sidb*`) descriptors were
-- swept inert in Stage E. STILL LIVE below: `SidDisjointAllOther` (`Sao*`, the
-- ⊤-arm classifier `setAlgebraDisjointAllOther` produces + `setAlgebraAllArm-
-- Disjoint` consumes).
-- ============================================================================

-- SidDisjointAllOther — describes the non-⊤ side for the ⊤-arm
-- (setAllDecideDisjoint ⊤ other): ∅ ⇒ disjoint; ⊤ ⇒ not disjoint; enum ⇒
-- disjoint iff empty; else undecided. (b = ∅ is intercepted earlier as
-- SidTrivialTrue, so SaoNone is defensive.)
SidDisjointAllOther =
  SaoNone
  | SaoAll
  | SaoEnum isEmpty: Boolean
  | SaoOther

@label "set-algebra: isDisjoint (recursive)"
@description "set-algebra-to-fenel Phase 3b-3 Step 3 Stage C / floor-kernel Phase 4 — recursive isDisjoint over the CANONICAL registered `$tag` `Se*` SetExpr ADT. a-Union folds mEvery, a-Intersect folds mSome; an a-leaf dispatches the symmetric leaf-pair driver which owns the swap. Enum∩predicate loops setAlgebraContains; interval∩interval/pattern and named∩named self-reason; pattern∩pattern uses the raw-pattern performance seam. For SeWhere∩SeWhere, data-only `whereAggregable` facts enter from the host while Fenel compares aggregator identities, recurses on output sets, and accepts only `Just true`. ¬X∩other calls the direct setAlgebraIsSubset sibling. The retired per-query Sid marshalling authored none of these decisions."
@tags "engine" "set-algebra" "isDisjoint" "recursive" "phase-3b-3"
setAlgebraIsDisjoint : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraIsDisjoint a b = case a of
  SeNone -> Just true
  SeUnion { branches = bs } -> setAlgebraIsDisjointUnion bs b false
  SeIntersect { branches = bs } -> setAlgebraIsDisjointIntersect bs b false
  _ -> setAlgebraIsDisjointLeaf a b

-- a is a true leaf; intercept b=∅ (Just true), then a=⊤ / b=⊤ (the ⊤-arm),
-- else the general leaf-pair. Mirrors marshalSetExprForIsDisjoint's post-compound
-- order ($none-b → $all-a → $all-b → the leaf-pair).
@label "set-algebra: isDisjointLeaf"
@description "Phase 3b-3 Step 3 Stage C — a-leaf top dispatch: b=∅ ⇒ Just true; a=⊤ or b=⊤ ⇒ the ⊤-arm (setAllDecideDisjoint over the non-⊤ side); else the leaf-pair driver. Internal helper to setAlgebraIsDisjoint."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraIsDisjointLeaf : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraIsDisjointLeaf a b = case b of
  SeNone -> Just true
  _ -> case a of
    SeAll -> setAlgebraTopArmDisjoint b
    _ -> case b of
      SeAll -> setAlgebraTopArmDisjoint a
      _ -> setAlgebraDisjointPair a b (setAlgebraSameShape a b)

-- A-Union ⊥ other: every branch of a is ⊥ other. mEvery semantics. `other` is
-- the fixed opposite side (threaded — both the a-Union top arm and the b-$union
-- swap recurse through here; the union/intersect disjoint rules are
-- direction-symmetric).
@label "set-algebra: isDisjointUnion"
@description "Phase 7b-recursive / 3b-3 Step 3 Stage C — mEvery semantics for a-Union ⊥ other (every branch ⊥ other); threads the fixed opposite side. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraIsDisjointUnion : (branches: List SetExpr) -> (other: SetExpr) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraIsDisjointUnion branches other sawNothing =
  case head branches of
    Nothing -> if sawNothing then Nothing else Just true
    Just first ->
      let r = setAlgebraIsDisjoint first other
      case r of
        Just false -> Just false
        Just true ->
          case tail branches of
            Nothing -> if sawNothing then Nothing else Just true
            Just rest -> setAlgebraIsDisjointUnion rest other sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraIsDisjointUnion rest other true

-- A-Intersect ⊥ other: any branch of a is ⊥ other ⇒ Just true (sound shortcut).
-- The TS oracle commits to Just true on the first positive proof and returns
-- Nothing otherwise (doesn't refute structurally — three pairwise-non-disjoint
-- sets can still have empty intersect). The `sawNothing` param is unused but kept
-- for signature symmetry with the other mSome/mEvery helpers.
@label "set-algebra: isDisjointIntersect"
@description "Phase 7b-recursive / 3b-3 Step 3 Stage C — mSome semantics for a-Intersect ⊥ other (sound shortcut; returns Nothing on no positive proof); threads the fixed opposite side. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraIsDisjointIntersect : (branches: List SetExpr) -> (other: SetExpr) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraIsDisjointIntersect branches other sawNothing =
  case head branches of
    Nothing -> Nothing
    Just first ->
      let r = setAlgebraIsDisjoint first other
      case r of
        Just true -> Just true
        _ ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraIsDisjointIntersect rest other sawNothing

-- ----------------------------------------------------------------------------
-- Phase 2a-2 — the leaf decision procedure + the symmetric swap. Mirrors the
-- per-shape TS `setXxxDecideDisjoint` arms + `perShapeDisjointWithSwap`
-- (engine-bodies-dispatch.ts). a is INVARIANT across the b-compound
-- recursion (only the compound's branches change), so the fed leaf
-- descriptors thread unchanged.
-- ----------------------------------------------------------------------------

-- The ⊤-arm: setAllDecideDisjoint ⊤ other (b = ∅ already intercepted as
-- SidTrivialTrue, so SaoNone is defensive).
@label "set-algebra: allArmDisjoint"
@description "Phase 2a-2 — the ⊤-arm of isDisjoint (setAllDecideDisjoint ⊤ other): ∅ ⇒ disjoint; ⊤ ⇒ not disjoint; enum ⇒ disjoint iff empty; else undecided. Mirrors set-algebra.ts:setAllDecideDisjoint. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-2a"
@category "engine-internal"
setAlgebraAllArmDisjoint : (o: SidDisjointAllOther) -> Maybe Boolean
setAlgebraAllArmDisjoint o = case o of
  SaoNone -> Just true
  SaoAll -> Just false
  SaoEnum { isEmpty = e } -> Just e
  SaoOther -> Nothing

-- Classify the non-⊤ side for the ⊤-arm. Canonical replacement for the TS
-- marshalDisjointAllOther: ∅ ⇒ SaoNone; ⊤ ⇒ SaoAll; enum ⇒ SaoEnum (isEmpty);
-- else SaoOther.
@label "set-algebra: disjointAllOther"
@description "Phase 3b-3 Step 3 Stage C — classify the non-⊤ side for the ⊤-arm: SeNone ⇒ SaoNone; SeAll ⇒ SaoAll; SeEnum ⇒ SaoEnum (isEmpty); else SaoOther. Canonical replacement for marshalDisjointAllOther. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraDisjointAllOther : (x: SetExpr) -> SidDisjointAllOther
setAlgebraDisjointAllOther x = case x of
  SeNone -> SaoNone
  SeAll -> SaoAll
  SeEnum { values = vs } -> SaoEnum { isEmpty = eq (length vs) 0 }
  _ -> SaoOther

-- floor-kernel Phase 3a (missing.dis.all-completion) — the ⊤-arm DRIVER:
-- the classified fast arm first (setAlgebraAllArmDisjoint — byte-preserved:
-- ∅/⊤/enum decide as before), then the SaoOther fence (⟺ Nothing here — the
-- other three classifications always return a Just) routes to the identity
-- law `⊤ ⊥ x ⟺ ⊤∩x = x = ∅`, i.e. the sibling decider setAlgebraDecideEmpty
-- (tri passthrough — the emptiness verdict IS the disjointness verdict, both
-- polarities: a decided-NONEMPTY x refutes with the same witness/construction
-- evidence). Closes the interval / invalid-interval / ctor / μ / arrow /
-- compound gaps of the ⊤-arm (probe P5–P8c: all were Nothing at HEAD while
-- the SWAPPED direction `(∪…) ⊥ ⊤` already decided branchwise — the
-- direction asymmetry this completes). Gated setAlgebraCtxFree (the D′ ctx
-- discipline): a SeWhere/SeRef/SePattern-bearing x keeps the honest Nothing —
-- routing it into decideEmpty could reach whereEmpty / namedInHierarchy
-- ctx-natives from a shape pair that never rode them pre-3a. Terminates:
-- decideEmpty recurses into x's components only (any pairwise-disjoint scan
-- inside re-enters this arm on strictly smaller operands).
@label "set-algebra: topArmDisjoint"
@description "floor-kernel Phase 3a — the ⊤-arm disjoint driver (tcb-ledger missing.dis.all-completion → THEOREM dis.all — the identity law ⊤∩x = x): the classified fast arm (∅/⊤/enum) byte-preserved, then SaoOther routes to setAlgebraDecideEmpty x under the setAlgebraCtxFree gate (D′ ctx discipline), tri passthrough both polarities. Closes the interval/ctor/μ/arrow/compound ⊤-gaps. Internal helper to setAlgebraIsDisjointLeaf."
@tags "engine" "internal" "set-algebra" "disjoint" "floor-kernel" "phase-3a"
@category "engine-internal"
setAlgebraTopArmDisjoint : (x: SetExpr) -> Maybe Boolean
setAlgebraTopArmDisjoint x =
  case setAlgebraAllArmDisjoint (setAlgebraDisjointAllOther x) of
    Just r -> Just r
    Nothing ->
      if setAlgebraCtxFree x
      then setAlgebraDecideEmpty x
      else Nothing

-- shapesEqual = setShape(a) === setShape(b): do a and b share their canonical
-- SetExpr constructor? Only consulted in the leaf-b swap (skip the swap when the
-- shapes match — the swapped arm is then identical, so combine(aOut, aOut) ≡ aOut).
@label "set-algebra: sameShape"
@description "Phase 3b-3 Step 3 Stage C — do a and b share their canonical SetExpr constructor (the marshaller's setShape(a)===setShape(b) swap gate)? Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraSameShape : (a: SetExpr) -> (b: SetExpr) -> Boolean
setAlgebraSameShape a b = eq (setAlgebraShapeTag a) (setAlgebraShapeTag b)

@label "set-algebra: shapeTag"
@description "Phase 3b-3 Step 3 Stage C — the canonical SetExpr constructor as a tag string (1:1 with decidable-membership.ts:SHAPE_KEY). Internal helper to setAlgebraSameShape."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraShapeTag : (se: SetExpr) -> String
setAlgebraShapeTag se = case se of
  SeAll -> "all"
  SeNone -> "none"
  SeEnum { values = _ } -> "enum"
  SeInterval { interval = _ } -> "interval"
  SeRef { handle = _ } -> "ref"
  SePattern { pattern = _ } -> "pattern"
  SeWhere { pred = _ } -> "where"
  SeCtor { ctor = _ } -> "ctor"
  SeMu { var = _ } -> "mu"
  SeArrow { params = _ } -> "arrow"
  -- signature-substrate Phase 4 slice 3a — its OWN tag, not the shared "other".
  -- `setAlgebraSameShape` gates the disjointness symmetric swap; leaving every
  -- unnamed constructor aliased to "other" would report two genuinely different
  -- shapes as equal and SKIP the swap.
  SeRigid { scopeToken = _ } -> "rigid"
  SeUnion { branches = _ } -> "union"
  SeIntersect { branches = _ } -> "intersect"
  SeDiff { left = _ } -> "diff"
  SeComplement { inner = _ } -> "complement"
  _ -> "other"

-- The leaf-pair driver over CANONICAL (a, b): aOut = disjointArm a b. `b` is
-- passed VERBATIM — a compound `b` ($union / $intersect) naturally falls to each
-- leaf-arm's `_` case (reproducing the retired SideCompound marker), and `aOut`
-- still carries the complement / $where / value-only-enum decisions that ignore
-- `b`'s leaf shape. Just true short-circuits; else a compound `b` recurses
-- (mEvery / mSome, with `a` as the fixed opposite side — the direction-symmetric
-- union/intersect rules) and a leaf `b` takes the symmetric swap (skipped when
-- shapesEqual). Mirrors perShapeDisjointWithSwap's post-$all dispatch.
@label "set-algebra: disjointPair"
@description "Phase 3b-3 Step 3 Stage C — the leaf-pair isDisjoint driver over canonical (a, b): aOut = disjointArm a b (b verbatim — a compound b falls to each arm's `_` case, the old SideCompound); Just true short-circuits; else b-Union/b-Intersect recurse (mEvery/mSome with `a` fixed) and a leaf b takes the symmetric swap (skipped when shapesEqual). Internal helper to setAlgebraIsDisjoint."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraDisjointPair : (a: SetExpr) -> (b: SetExpr) -> (shapesEqual: Boolean) -> Maybe Boolean
setAlgebraDisjointPair a b shapesEqual =
  let aOut = setAlgebraDisjointArm a b
  case aOut of
    Just true -> Just true
    _ -> case b of
      SeUnion { branches = brs } ->
        setAlgebraDisjointCombine aOut (setAlgebraIsDisjointUnion brs a false)
      SeIntersect { branches = brs } ->
        setAlgebraDisjointCombine aOut (setAlgebraIsDisjointIntersect brs a false)
      _ ->
        if shapesEqual
        then aOut
        else setAlgebraDisjointCombine aOut (setAlgebraDisjointArm b a)

-- combine(aOut, bOut) (called only when aOut ≠ Just true): bOut Just true ⇒
-- Just true; else either side Just false ⇒ Just false; else Nothing.
-- Mirrors perShapeDisjointWithSwap's swap-combine.
@label "set-algebra: disjointCombine"
@description "Phase 2a-2 — the symmetric-swap combine: bOut Just true ⇒ Just true; else aOut or bOut Just false ⇒ Just false; else Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-2a"
@category "engine-internal"
setAlgebraDisjointCombine : (aOut: Maybe Boolean) -> (bOut: Maybe Boolean) -> Maybe Boolean
setAlgebraDisjointCombine aOut bOut = case bOut of
  Just true -> Just true
  _ -> case aOut of
    Just false -> Just false
    _ -> case bOut of
      Just false -> Just false
      _ -> Nothing

-- disjointArm(this, other): the per-shape disjoint rule with canonical `this`
-- as the left arg. Mirrors dispatchOne(thisShape, this, other) over the per-shape
-- setXxxDecideDisjoint impls. `other` is the canonical opposite side (leaf OR
-- compound — a compound falls to the `_` arm of each leaf rule, exactly as the
-- retired SideCompound marker did). The asymmetric / opaque leaves self-reason:
-- enum∩predicate LOOPS setAlgebraContains (the b-side membership kill-2-birds);
-- named∩named drives the Fenel namedDomain over the namedInHierarchy ctx-native;
-- pattern∩pattern the patternDisjoint ctx-native; $where∩$where consumes
-- data-only whereAggregable facts and owns compare/recurse/proof-gating here;
-- ¬X∩other the DIRECT sibling decider
-- setAlgebraIsSubset (Phase 1c — the subsetCheck ctx-native round-trip is deleted).
@label "set-algebra: disjointArm"
@description "Phase 3b-3 Step 3 Stage C / floor-kernel Phase 4 — the per-shape isDisjoint rule with canonical `this` as the left arg (enum overlap and membership loops; interval/pattern/named leaf theory; raw-pattern performance seam; SeWhere pair via data-only whereAggregable facts with Fenel-owned identity comparison, output-set recursion, and Just-true gate; complement via direct setAlgebraIsSubset sibling). A compound other falls through each leaf's default arm. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraDisjointArm : (this: SetExpr) -> (other: SetExpr) -> Maybe Boolean
setAlgebraDisjointArm this other = case this of
  SeEnum { values = vs } ->
    case other of
      SeEnum { values = ovs } -> setAlgebraEnumsDisjointTri vs ovs
      _ ->
        if isValueOnlyPredicate other
        then setAlgebraEnumPredDisjoint other vs false
        else Nothing
  SeInterval { interval = iva } ->
    case other of
      SeInterval { interval = ivb } ->
        Just (setAlgebraIntervalsDisjoint (setAlgebraClassifyInterval iva) (setAlgebraClassifyInterval ivb))
      SePattern {} ->
        if setAlgebraIntervalExcludesStrings (setAlgebraClassifyInterval iva) then Just true else Nothing
      _ -> Nothing
  SeRef { handle = aName } ->
    case other of
      SeRef { handle = bName } ->
        if eq aName bName
        then Just false
        else setAlgebraNamedDisjoint (namedDomain aName (namedInHierarchy aName)) (namedDomain bName (namedInHierarchy bName))
      _ -> Nothing
  SePattern { pattern = ap } ->
    case other of
      SePattern { pattern = bp } -> patternDisjoint ap bp
      SeInterval { interval = ivb } ->
        if setAlgebraIntervalExcludesStrings (setAlgebraClassifyInterval ivb) then Just true else Nothing
      _ -> Nothing
  SeWhere { pred = ap } ->
    case other of
      -- floor-kernel Phase 4 — Fenel owns the same-Aggregable disjoint proof.
      -- `whereAggregable` supplies facts only; this arm compares identities,
      -- recurses on output sets, and accepts only a positive proof.
      SeWhere { pred = bp } -> case whereAggregable ap of
        Just ac -> case whereAggregable bp of
          Just bc ->
            if eq ac.aggFn bc.aggFn
            then case setAlgebraIsDisjoint ac.outputSet bc.outputSet of
              Just true -> Just true
              _ -> Nothing
            else Nothing
          Nothing -> Nothing
        Nothing -> Nothing
      _ -> Nothing
  SeCtor { ctor = ac, fields = afs } ->
    case other of
      SeCtor { ctor = bc, fields = bfs } -> setAlgebraCtorDisjoint ac afs bc bfs
      _ -> Nothing
  -- type-substrate P1(a) — the 8λ.1 value-sort AXIOM ("a callable carries no
  -- `$tag`, so SeArrow ⊥ SeCtor") is RETIRED AS FALSE on the denotation these
  -- very faces implement. It was a PRODUCER claim promoted to a claim about the
  -- host-record universe: `mem.ctor` accepts ANY `$tag`-matching record (open
  -- membership — extra keys unconstrained, setAlgebraCtorContains), and
  -- `mem.arrow` classifies by callable-KEY PRESENCE (setAlgebraArrowContains:
  -- `$ref` / `__fenelPartial` / `__fenelFn`), so `{$tag:"P", $ref: f}` and a
  -- `$tag`-carrying closure inhabit BOTH sorts and the mem faces DECIDE it.
  -- The old Just true let the kernel grade `JEmpty` (dis ⇒ anyPairDisjoint ⇒
  -- emp.intersect) AND `JInhabited` (`{w} ⊆ ∩` ⇒ per-branch membership)
  -- SolverChecked on the SAME intersection — two contradictory certificates.
  -- The reserved-wire fence does NOT rescue it: the counterexample needs NO
  -- fields (`SeCtor "P" []` is the canonical projection of a nullary variant
  -- case — `Nothing`, `Nil`; NOT `True`, which projects as the enum).
  -- What survives is the emptiness fragment only: ∅ ⊥ X. No dis↔emp cycle is
  -- created ON THIS PAIR — ctor emptiness is the product rule and arrow
  -- emptiness the exponential law, and neither rule consults disjointness at
  -- the top level. Stated precisely, because the loose version is wrong: both
  -- fold through the PUBLIC `setAlgebraDecideEmpty`, and public emptiness of a
  -- SeIntersect DOES call `setAlgebraIsDisjoint` (setAlgebraAnyPairDisjoint), so
  -- a field or return of shape `∩[SeArrow, SeCtor]` re-enters this very arm —
  -- but always on STRICTLY SMALLER terms, and SetExpr is inductive (a cyclic
  -- term needs SeMu, whose emptiness substitutes ∅ and shrinks), so the descent
  -- is finite. Do not widen this back without changing `mem.ctor`/`mem.arrow`
  -- (P3 carrier work).
  SeArrow {} ->
    case other of
      SeCtor {} -> setAlgebraArrowCtorDisjoint this other
      _ -> Nothing
  SeComplement { inner = innr } -> setAlgebraIsSubset other innr
  -- signature-substrate Phase 4 slice 3a — DISJOINTNESS AT A RIGID IS ALWAYS
  -- UNDECIDED, INCLUDING κ ⟂ κ. The SeRef arm above answers `Just false` for
  -- the same handle (a named set is nonempty-or-unknown but never ∅ by
  -- construction); that reasoning FAILS for a rigid, because κ := ∅ makes
  -- ∅ ⟂ ∅ TRUE. Two distinct rigids are equally undecided: they may be
  -- instantiated to the same ground type. Never Just false, never Just true.
  SeRigid {} -> Nothing
  -- floor-kernel Phase 3a (missing.dis.diff) — (A∖B) ⊥ C ⟺ A∩C ⊆ B (∖-def +
  -- comm/assoc + the subset iso): route to the sibling subset decider. The
  -- enum-other direction ALREADY decided at HEAD via the symmetric swap's
  -- value-only-predicate loop (probe P3/P4/P22); this arm closes the NON-enum
  -- others (intervals, compounds — probe P19–P21 were Nothing).
  SeDiff { left = dl, right = dr } -> setAlgebraDiffDisjoint dl dr other
  _ -> Nothing

@label "set-algebra: arrowCtorDisjoint"
@description "type-substrate P1(a) — SeArrow ⊥ SeCtor decides ONLY through emptiness (∅ ⊥ X): either operand decidably empty via setAlgebraDecideEmptyCore ⇒ Just true; else Nothing, for the \"\"-ctor and named ctors alike. The 8λ.1 value-sort axiom is retired as false — open ctor membership plus presence-dispatched arrow membership admit values inhabiting both sorts, and the old unconditional Just true made JEmpty and JInhabited simultaneously kernel-certifiable. Soundness is delegated wholly to the emp rows (emp.ctor under the P1(a) judgment fence; emp.arrow the exponential law). Internal helper to setAlgebraDisjointArm."
@tags "engine" "internal" "set-algebra" "arrow" "sector" "disjoint" "type-substrate" "phase-1a"
@category "engine-internal"
setAlgebraArrowCtorDisjoint : (arrowSide: SetExpr) -> (ctorSide: SetExpr) -> Maybe Boolean
setAlgebraArrowCtorDisjoint arrowSide ctorSide =
  case setAlgebraDecideEmptyCore ctorSide of
    Just true -> Just true
    _ ->
      case setAlgebraDecideEmptyCore arrowSide of
        Just true -> Just true
        _ -> Nothing

-- floor-kernel Phase 3a (missing.dis.diff) — the a-SeDiff disjoint rewrite:
-- (A∖B) ⊥ C ⟺ (A∖B)∩C = ∅ ⟺ (A∩C)∖B = ∅ ⟺ A∩C ⊆ B (∖-def + comm/assoc +
-- the subset iso). Tri passthrough BOTH polarities: the subset verdict IS the
-- disjointness verdict — a Just-false is witness-grade (x ∈ A∩C, x ∉ B ⇒
-- x ∈ (A∖B)∩C, a genuine common member). Gated setAlgebraCtxFree on all three
-- operands (the D′ ctx discipline — the constructed A∩C ⊆ B query creates
-- shape pairs the pre-3a face never fed to ctx-native leaves); ungated ⇒
-- Nothing (the symmetric swap then still tries the other side, preserving
-- every pre-3a decision incl. the enum-other value-only loop). Terminates:
-- the subset query's operands are components of the original (a diff-nested
-- left side re-enters this rewrite with a strictly smaller diff).
@label "set-algebra: diffDisjoint"
@description "floor-kernel Phase 3a — the a-SeDiff disjoint arm (tcb-ledger missing.dis.diff → THEOREM dis.diff): (A∖B) ⊥ C decided as A∩C ⊆ B via the sibling setAlgebraIsSubset (∖-def + comm/assoc + the subset iso), tri passthrough both polarities. Gated setAlgebraCtxFree (D′ ctx discipline); closes the non-enum-other gap (the enum direction already rode the symmetric swap's value-only loop). Internal helper to setAlgebraDisjointArm."
@tags "engine" "internal" "set-algebra" "disjoint" "floor-kernel" "phase-3a"
@category "engine-internal"
setAlgebraDiffDisjoint : (dl: SetExpr) -> (dr: SetExpr) -> (other: SetExpr) -> Maybe Boolean
setAlgebraDiffDisjoint dl dr other =
  if and (setAlgebraCtxFree dl) (and (setAlgebraCtxFree dr) (setAlgebraCtxFree other))
  then
    let brs = appendItem other (appendItem dl [])
    setAlgebraIsSubset (SeIntersect { branches = brs }) dr
  else Nothing

-- enum∩enum: disjoint iff no value of a is in b's value list.
@label "set-algebra: enumsDisjoint"
@description "Phase 2a-2 — enum∩enum disjointness: no value of a is in b's value list. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-2a"
@category "engine-internal"
setAlgebraEnumsDisjoint : (vs: List Any) -> (ovs: List Any) -> Boolean
setAlgebraEnumsDisjoint vs ovs =
  if setAlgebraAnyValueIn vs ovs then false else true

-- some value of vs is a member of ovs.
@label "set-algebra: anyValueIn"
@description "Phase 2a-2 — does any value of vs appear in ovs? Internal helper to enum∩enum disjointness."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-2a"
@category "engine-internal"
setAlgebraAnyValueIn : (vs: List Any) -> (ovs: List Any) -> Boolean
setAlgebraAnyValueIn vs ovs = std.some vs (\v -> setAlgebraEnumContainsLoop ovs v)

@category "engine-internal"
setAlgebraEnumsDisjointTri : (vs: List Any) -> (ovs: List Any) -> Maybe Bool
setAlgebraEnumsDisjointTri vs ovs = case setAlgebraAnyValueInTri vs ovs false of
  Just answer -> Just (not answer)
  Nothing -> Nothing

@category "engine-internal"
setAlgebraAnyValueInTri : (vs: List Any) -> (ovs: List Any) -> (sawNothing: Bool) -> Maybe Bool
setAlgebraAnyValueInTri vs ovs sawNothing =
  -- One std fold (constant host stack); a proven member makes the verdict Just
  -- true and stops the membership questions, as the former recursion did.
  fold (\found value -> case found of
    Just true -> found
    _ -> case setAlgebraEnumContainsTri ovs value false of
      Just true -> Just true
      Just false -> found
      Nothing -> Nothing) (if sawNothing then Nothing else Just false) vs

-- interval∩interval: disjoint iff the n-ary intersect is empty (Nothing).
@label "set-algebra: intervalsDisjoint"
@description "Phase 2a-2 — interval∩interval disjointness via intersectIntervals (Nothing ⇒ disjoint). Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-2a"
@category "engine-internal"
setAlgebraIntervalsDisjoint : (iva: Interval) -> (ivb: Interval) -> Boolean
setAlgebraIntervalsDisjoint iva ivb =
  let m = intersectIntervals [iva, ivb]
  case m of
    Nothing -> true
    Just x -> false

-- named∩named: disjoint iff both domains are known and differ.
@label "set-algebra: namedDisjoint"
@description "Phase 2a-2 — named∩named disjointness: both value-domains known and differing ⇒ Just true; else Nothing. Mirrors set-algebra.ts:setNamedDecideDisjoint. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-2a"
@category "engine-internal"
setAlgebraNamedDisjoint : (da: Maybe NamedDomain) -> (db: Maybe NamedDomain) -> Maybe Boolean
setAlgebraNamedDisjoint da db = case da of
  Nothing -> Nothing
  Just dav -> case db of
    Nothing -> Nothing
    Just dbv -> if setAlgebraNamedDomainEq dav dbv then Nothing else Just true

-- value-domain equality over NamedDomain.
@label "set-algebra: namedDomainEq"
@description "Phase 2a-2 — NamedDomain equality (NdNumber / NdString / NdBoolean / NdArray). Internal helper to named∩named disjointness."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-2a"
@category "engine-internal"
setAlgebraNamedDomainEq : (a: NamedDomain) -> (b: NamedDomain) -> Boolean
setAlgebraNamedDomainEq a b = case a of
  NdNumber -> case b of
    NdNumber -> true
    _ -> false
  NdString -> case b of
    NdString -> true
    _ -> false
  NdBoolean -> case b of
    NdBoolean -> true
    _ -> false
  NdArray -> case b of
    NdArray -> true
    _ -> false

-- enum∩predicate: disjoint iff no enum value is in `other`. set-algebra-to-fenel
-- Phase 3b-3 Step 3 Stage C — the per-value membership LOOP (formerly TS-fed
-- `memberships = vals.map(v => contains(other, v))` on the marshaller's SideEnum)
-- now runs IN Fenel, calling the sibling `setAlgebraContains other v` per value
-- under the merged decider ctx (the b-side kill-2-birds). Gated by
-- isValueOnlyPredicate at the call site, so `other` has no $where ⇒ contains
-- never needs the value-binding the decider didn't set up. Fold (≡ the old
-- setAlgebraNoneContained): any value IN other (Just true) ⇒ Just false; all Just
-- false ⇒ Just true; else Nothing. Short-circuits the membership computation on
-- the first hit (the old eager map then short-circuited the fold — same verdict).
@label "set-algebra: enumPredDisjoint"
@description "Phase 3b-3 Step 3 Stage C — enum∩predicate disjointness, LOOPING setAlgebraContains over the enum's values (the b-side membership kill-2-birds): any Just true ⇒ Just false; all Just false ⇒ Just true; else Nothing. Replaces the TS-fed-memberships setAlgebraNoneContained. Internal helper."
@tags "engine" "internal" "set-algebra" "disjoint" "phase-3b-3"
@category "engine-internal"
setAlgebraEnumPredDisjoint : (other: SetExpr) -> (vs: List Any) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraEnumPredDisjoint other vs sawNothing =
  -- One std fold (constant host stack); the first member proven inside `other`
  -- makes the verdict Just false and stops the membership questions.
  fold (\apart v -> case apart of
    Just false -> apart
    _ -> case setAlgebraContains other v of
      Just true -> Just false
      Just false -> apart
      Nothing -> Nothing) (if sawNothing then Nothing else Just true) vs

-- ============================================================================
-- Phase 3b-3 Step 3 Stage D — isSubset over the canonical `$tag` `Se*` ADT (TWO
-- args). a=∅ ⇒ Just true; b=⊤ ⇒ Just true (at every depth); a-Union folds mEvery,
-- a-Intersect folds mSome (sound shortcut) + the `intersectSubsetTail` normalize-
-- retry; an a-leaf self-reasons the leaf math + the b-compound tail + the b-$where
-- extraction + the eq fallback. The per-query `SetExprIsSubsetAdt` (`Sis*`) +
-- `SisSubsetA` (`Sisa*`) + `SisSubsetB` (`Sisb*`) mirror ADTs + their TS producers
-- (`marshalSetExprForIsSubset` / `marshalSubsetA` / `marshalSubsetB`) were swept
-- inert in Stage E.
-- ============================================================================

@label "set-algebra: isSubset (recursive)"
@description "set-algebra-to-fenel Phase 3b-3 Step 3 Stage D / floor-kernel Phase 4 — recursive isSubset over the CANONICAL registered `$tag` `Se*` SetExpr ADT (TWO args; the per-query marshalled `SisMarshalled` is RETIRED; `marshalSetExprForIsSubset` + `marshalSubsetA`/`marshalSubsetB` + the `Sis*`/`Sisa*`/`Sisb*` types delete). a=∅ ⇒ Just true; b=⊤ ⇒ Just true (checked before the a-dispatch, at every depth); a-Union folds mEvery, a-Intersect folds mSome (sound shortcut) falling to the Fenel `intersectSubsetTail` normalize-retry; an a-leaf self-reasons via the leaf math (intervalSubset / setAlgebraAllValuesIn / inInterval ∘ classifyInterval). The per-direction fed data the marshaller pre-computed now self-reasons in-body: enum⊆named/pattern LOOPS `setAlgebraContains b v` (the b-side membership kill-2-birds), named⊆named the `namedSubsetCheck` ctx-native, and a-SeWhere owns its complete branch order here: `whereExtract` is terminal when applicable, same-Aggregable predicates compare their marshalled facts and prove only through output-set subset, then `setAlgebraWhereSubsetTailRules` preserves the conservative fallback. The host `whereAggregable` seam only marshals recognizer facts; it does not select branches, compare aggregators, recurse, or gate a verdict. a-$pattern⊆pattern uses the `patternSubsetArm` ctx-native (raw patterns, the patternDisjoint twin — Phase 1c dropped its setExprToDollarKey round-trip; a-SePattern⊆non-pattern falls to `setAlgebraSubsetTailRules`), b-$where uses the `whereExtract` ctx-native, and the structural-eq tail is the Fenel `deepEqValue` over canonical `$tag` Se*. Mirrors implementations/typescript/engine/src/set-algebra.ts:isSubset."
@tags "engine" "set-algebra" "isSubset" "recursive" "phase-3b-3"
setAlgebraIsSubset : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraIsSubset a b = case a of
  SeNone -> Just true
  _ -> case b of
    SeAll -> Just true
    _ -> case a of
      SeUnion { branches = bs } -> setAlgebraIsSubsetUnion bs b false
      SeIntersect { branches = bs } -> setAlgebraIsSubsetIntersect bs b (setAlgebraIntersectSubsetTail a b) false
      -- floor-kernel Phase 4 — Fenel owns the complete SeWhere subset policy.
      -- An extracted left predicate is TERMINAL even when its recursive answer
      -- is Nothing (the historical outer-Maybe distinction). Only a failed
      -- extraction reaches the Aggregable proof arm; that arm accepts Just true
      -- only, then falls through to the conservative SeWhere tail.
      SeWhere { pred = ap } -> case whereExtract ap of
        Just aSet -> setAlgebraIsSubset aSet b
        Nothing -> case b of
          SeWhere { pred = bp } -> case whereAggregable ap of
            Just ac -> case whereAggregable bp of
              Just bc ->
                if eq ac.aggFn bc.aggFn
                then case setAlgebraIsSubset ac.outputSet bc.outputSet of
                  Just true -> Just true
                  _ -> setAlgebraWhereSubsetTailRules a b
                else setAlgebraWhereSubsetTailRules a b
              Nothing -> setAlgebraWhereSubsetTailRules a b
            Nothing -> setAlgebraWhereSubsetTailRules a b
          _ -> setAlgebraWhereSubsetTailRules a b
      SePattern { pattern = ap } -> case b of
        SePattern { pattern = bp } -> patternSubsetArm ap bp
        _ -> setAlgebraSubsetTailRules a b
      _ -> setAlgebraDecideLeafSubset a b

-- A-Union ⊆ b: every branch of a is ⊆ b. mEvery semantics.
@label "set-algebra: isSubsetUnion"
@description "Phase 3b-3 Step 3 Stage D — mEvery semantics for a-Union ⊆ b (every branch ⊆ b); threads the fixed b. Internal helper."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraIsSubsetUnion : (branches: List SetExpr) -> (b: SetExpr) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraIsSubsetUnion branches b sawNothing =
  case head branches of
    Nothing -> if sawNothing then Nothing else Just true
    Just first ->
      let r = setAlgebraIsSubset first b
      case r of
        Just false -> Just false
        Just true ->
          case tail branches of
            Nothing -> if sawNothing then Nothing else Just true
            Just rest -> setAlgebraIsSubsetUnion rest b sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraIsSubsetUnion rest b true

-- A-Intersect ⊆ b: a sound shortcut — if any branch is ⊆ b, the whole
-- intersect is ⊆ b. If no branch positively proves, the Fenel
-- `setAlgebraIntersectSubsetTail` normalizes and either retries the simpler
-- shape or terminates in the tail rules. The former TS ctx-native and legacy
-- codec round-trip are retired.
@label "set-algebra: isSubsetIntersect"
@description "Phase 3b-3 Step 3 Stage D — mSome shortcut for a-Intersect ⊆ b (threads the fixed b), falling through to the Fenel intersectSubsetTail normalize-retry/tail answer. Internal helper."
@tags "engine" "internal" "set-algebra" "phase-7b"
@category "engine-internal"
setAlgebraIsSubsetIntersect : (branches: List SetExpr) -> (b: SetExpr) -> (fallbackTail: Maybe Boolean) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraIsSubsetIntersect branches b fallbackTail sawNothing =
  case head branches of
    Nothing -> fallbackTail
    Just first ->
      let r = setAlgebraIsSubset first b
      case r of
        Just true -> Just true
        _ ->
          case tail branches of
            Nothing -> fallbackTail
            Just rest ->
              setAlgebraIsSubsetIntersect rest b fallbackTail sawNothing

-- containment-substrate Phase 2 Step 1b — the `intersectSubsetTail` Fenel PORT
-- (P3 = LAND, the kill-2-birds). Replaces the `intersectSubsetTail` ctx-native
-- (TS `setIntersectDecideSubset`) + its `setExprToDollarKey` round-trip — the
-- LAST non-`$where` `setExprToDollarKey` consumer.
--
-- ROOT CAUSE the port fixes (1a probe P3): the TS `setIntersectDecideSubset`
-- gated its normalize-retry on `if (!("$intersect" in norm))` — a stale `$`-key
-- test against the canonical `$tag:"SeIntersect"` form (post-3b-2 flip). For a
-- named-ref intersect that normalize does NOT collapse, the gate NEVER matched ⇒
-- it re-entered `isSubset(norm, b)` forever ⇒ the int_nat_iv overflow. The
-- canonical-`SeIntersect` gate IS the fix: norm still an intersect ⇒ the
-- terminating tail rules; collapsed ⇒ retry on the simpler shape.
--
-- VERIFIED (1a charn net, 28 ERR:stack cases): 26 → Nothing (SOUND — undecidable
-- without a resolver) + 2 → reflexive Just true (a ⊆ a), 0 wrong-Just, 0
-- value→ERR / value→diff regression.
@label "set-algebra: intersectSubsetTail"
@description "containment-substrate Phase 2 Step 1b — the a-Intersect ⊆ b normalize-retry tail (the ported `intersectSubsetTail`, off the TS setIntersectDecideSubset round-trip): normalize a; if it is STILL a canonical SeIntersect ⇒ the terminating setAlgebraSubsetTailRules (no re-entry); else (collapsed) ⇒ retry setAlgebraIsSubset on the simpler shape. The canonical-SeIntersect gate is the fix for the int_nat_iv overflow the TS `$intersect`-key test missed. Removes the last non-\$where setExprToDollarKey consumer. Internal helper to setAlgebraIsSubset's a-Intersect arm."
@tags "engine" "internal" "set-algebra" "subset" "phase-2"
@category "engine-internal"
setAlgebraIntersectSubsetTail : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraIntersectSubsetTail a b =
  let norm = setAlgebraNormalize a
  case norm of
    SeIntersect {} -> setAlgebraSubsetTailRules a b
    _ -> setAlgebraIsSubset norm b

-- ----------------------------------------------------------------------------
-- Phase 3b-3 Step 3 Stage D — the leaf decision procedure: self-reason a
-- structural a-leaf ⊆ canonical b. Mirrors the per-shape TS `setXxxDecideSubset`
-- arms (set-algebra.ts) + the shared `_subsetTailRules` tail. a is INVARIANT
-- across the b-recursion (only b changes), so it threads unchanged through the
-- union / intersect / extracted-where recursion.
-- ----------------------------------------------------------------------------

-- decideLeafSubset — dispatch on (canonical a, canonical b). The leading
-- `SeAll -> Just true` (on b) mirrors the marshaller's `$all in b` shortcut:
-- ANY set ⊆ ⊤ (so it is checked before the a-arm logic, at every recursion
-- depth).
@label "set-algebra: decideLeafSubset"
@description "Phase 3b-3 Step 3 Stage D — structural a-leaf ⊆ b decision over canonical (a, b). Self-reasons via intervalSubset ∘ tagInterval (the TS marshalInterval re-home — string exprKeys) / namedSubsetCheck / enum-membership; falls through to the ported _subsetTailRules. Internal helper to setAlgebraIsSubset's leaf arm."
@tags "engine" "internal" "set-algebra" "subset" "phase-2a"
@category "engine-internal"
setAlgebraDecideLeafSubset : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraDecideLeafSubset a b = case b of
  SeAll -> Just true
  _ -> case a of
    SeAll -> setAlgebraSubsetAllArm b
    SeEnum {} -> setAlgebraSubsetEnumArm a b
    SeInterval { interval = iv } -> case b of
      SeInterval { interval = biv } -> Just (intervalSubset (tagInterval iv) (tagInterval biv))
      _ -> setAlgebraSubsetTailRules a b
    SeRef { handle = nm } -> case b of
      SeRef { handle = bnm } ->
        if namedSubsetCheck nm bnm
        then Just true
        else setAlgebraSubsetTailRules a b
      _ -> setAlgebraSubsetTailRules a b
    SeCtor {} -> setAlgebraSubsetCtorArm a b
    -- 8μ.2 — SeMu ⊆ b: the a-side Park (Knaster-Tarski) rule FIRST (fresh fuel 4),
    -- then the 8μ.1b tail rules as the fallback (deepEq REFLEXIVITY + b-side
    -- compounds). Park ONLY proves ⇒ a Nothing falls through to the tail (which
    -- also ends in deepEq — the fuel entry already tried it, so the fallback is
    -- inert for the reflexive case, load-bearing for nothing extra; kept for
    -- symmetry with the b-arm). `List Int ⊆ List Number` flips Nothing → Just true.
    SeMu {} -> case setAlgebraMuSubset a b 4 of
      Just true -> Just true
      _ -> setAlgebraSubsetTailRules a b
    -- decide-substrate Phase 8λ.1 — SeArrow ⊆ b: variance (contravariant params,
    -- covariant return) when b is a SeArrow (mirror `arrowSub`); else the tail
    -- rules (deepEq reflexivity + b-side compounds). Never refutes off-shape.
    SeArrow {} -> case setAlgebraSubsetArrowArm a b of
      Just r -> Just r
      Nothing -> setAlgebraSubsetTailRules a b
    -- signature-substrate Phase 4 slice 3a — the rigid a-side. A DEDICATED arm,
    -- deliberately NOT `setAlgebraSubsetTailRules`: the shared tail would let a
    -- rigid ride the b-∪/∩/μ compound rules, and those are coverage this slice
    -- has no consumer for. Everything except syntactic self-identity abstains.
    SeRigid {} -> setAlgebraSubsetRigidArm a b
    -- floor-kernel Phase 3a (missing.sub.lhs-diff) — A∖B ⊆ C ⟺ A ⊆ B∪C:
    -- the rewrite-to-subset arm (was tail-rules/deepEq only).
    SeDiff { left = dl, right = dr } -> setAlgebraSubsetDiffArm dl dr a b
    -- floor-kernel Phase 3c (missing.sub.lhs-complement) — classical dual:
    -- ¬A ⊆ B iff A∪B covers top. The named helper owns the ctx-free gate,
    -- NNF/top-cover query, and old-tail fallback.
    SeComplement { inner = ci } -> setAlgebraSubsetComplementArm ci a b
    _ -> Nothing

-- floor-kernel Phase 3a (missing.sub.lhs-diff) — the a-SeDiff subset rewrite:
-- A∖B ⊆ C ⟺ A∩¬B∩¬C = ∅ ⟺ A ⊆ B∪C (∖-def + De Morgan + the subset iso).
-- Build the union and route to the sibling subset entry — the b-∪ tail rules
-- + the enum members loop already decide the fragment (the enum-splitting
-- exactness is P1 fix 2's loop: {1,2}∖{2} ⊆ {1} rides `1 ∈ {2}∪{1}` … per
-- value). Tri passthrough BOTH polarities: a Just-false of the rewrite is
-- witness-grade for the original (x ∈ A, x ∉ B, x ∉ C ⇒ x ∈ (A∖B)∖C — a
-- genuine escapee). Gated setAlgebraCtxFree on both operands (the D′ ctx
-- discipline — the rewrite creates shape pairs, e.g. enum ⊆ ref-in-union,
-- the pre-3a face never fed to ctx-native leaves); gate-failed or undecided
-- falls to the OLD tail rules (deepEq + b-compounds), so every pre-3a verdict
-- is preserved verbatim. Terminates: the rewrite recurses on dl (strictly
-- smaller than a); the b-side folds only ever decompose b.
@label "set-algebra: subsetDiffArm"
@description "floor-kernel Phase 3a — the a-SeDiff subset arm (tcb-ledger missing.sub.lhs-diff → THEOREM sub.diff.arm): A∖B ⊆ C decided as A ⊆ B∪C via the sibling setAlgebraIsSubset (∖-def + De Morgan + the subset iso), tri passthrough both polarities (the rewrite's refutation is witness-grade for the original). Gated setAlgebraCtxFree on both operands (D′ ctx discipline); ungated/undecided falls to setAlgebraSubsetTailRules (pre-3a behavior preserved). Internal helper to setAlgebraDecideLeafSubset."
@tags "engine" "internal" "set-algebra" "subset" "floor-kernel" "phase-3a"
@category "engine-internal"
setAlgebraSubsetDiffArm : (dl: SetExpr) -> (dr: SetExpr) -> (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetDiffArm dl dr a b =
  if and (setAlgebraCtxFree a) (setAlgebraCtxFree b)
  then
    let brs = appendItem b (appendItem dr [])
    case setAlgebraIsSubset dl (SeUnion { branches = brs }) of
      Just r -> Just r
      Nothing -> setAlgebraSubsetTailRules a b
  else setAlgebraSubsetTailRules a b

-- floor-kernel Phase 3c (missing.sub.lhs-complement) — the a-SeComplement
-- subset rewrite: ¬A ⊆ B iff top ⊆ A∪B. Both operands are ctx-free before
-- authoring the compound, then the shared NNF + top-cover engine decides its
-- licensed exact slice. Tri passthrough BOTH polarities; undecided/gate-failed
-- falls back to the pre-3c tail so no old verdict is lost.
--
-- Termination measure: NNF leaves complements only immediately above leaves.
-- Each top-cover pairing removes one such complement branch and asks subset on
-- its complement-free inner against the remaining positive union. Therefore
-- the new top-cover -> subset edge cannot re-enter this LHS-complement arm for
-- that pair; the remaining structural walks recurse on strict children.
@label "set-algebra: subsetComplementArm"
@description "floor-kernel Phase 3c — the a-SeComplement subset arm (tcb-ledger missing.sub.lhs-complement → THEOREM): ¬A⊆B iff A∪B covers top. Ctx-free operands are NNF-normalized and routed to setAlgebraTopCover; decided polarities pass through, while misses preserve the old tail rules. NNF makes every pairing inner complement-free, which is the termination measure for the top-cover↔subset composition. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "complement" "top-cover" "floor-kernel" "phase-3c"
@category "engine-internal"
setAlgebraSubsetComplementArm : (inner: SetExpr) -> (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetComplementArm inner a b =
  if and (setAlgebraCtxFree a) (setAlgebraCtxFree b)
  then
    let brs = appendItem b (appendItem inner [])
    let cover = setAlgebraTopCover (setAlgebraNnf (SeUnion { branches = brs }))
    case cover of
      Just r -> Just r
      Nothing -> setAlgebraSubsetTailRules a b
  else setAlgebraSubsetTailRules a b

-- ⊤ ⊆ b: only b=⊤ proves it (caught above as the leading SeAll); b=$where is
-- undecidable (the predicate could resolve to ⊤). floor-kernel Phase 1
-- SOUNDNESS FIX: the old blanket `Just false` also refuted Boolean COMPOUNDS —
-- but a compound can denote ⊤ (`A ∪ ¬A`, `∩[]` the nullary meet), so
-- `⊤ ⊆ SeUnion [A, SeComplement A] ⇒ Just false` was a FALSE refutation (it
-- poisoned decideEmptyDiff ⇒ the kernel's `nonempty` re-check). Post-fix:
-- b-∩ decides by the exact ∀-rule (⊤ ⊆ ∩bs ⟺ ∀i. ⊤ ⊆ bᵢ — mEvery, vacuous
-- Just true on ∩[]); b-∪/∖/¬ fence (Nothing — ⊤-equivalence undecided pre-
-- Phase-3 classical ¬); the LEAF shapes keep the refutation (an enum is
-- finite, an interval/pattern/ref/ctor/mu/arrow is domain-bounded — none is ⊤).
@label "set-algebra: subsetAllArm"
@description "Phase 3b-3 Step 3 Stage D / floor-kernel Phase 1 soundness fix — ⊤ ⊆ b leaf decision: b=$where ⇒ Nothing; b=∩ ⇒ the exact ∀-rule (mEvery over branches, vacuous Just true on the nullary meet ∩[]); b=∪/∖/¬ ⇒ Nothing (a Boolean compound can denote ⊤ — the old blanket Just false falsely refuted ⊤ ⊆ A∪¬A); leaf shapes ⇒ Just false (domain-bounded, provably ≠ ⊤); b=⊤ handled by the leading SeAll shortcut. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "phase-2a"
@category "engine-internal"
setAlgebraSubsetAllArm : (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetAllArm b = case b of
  SeWhere { pred = _ } -> Nothing
  SeUnion { branches = _ } -> setAlgebraSubsetAllCompound b
  SeDiff { left = _ } -> setAlgebraSubsetAllCompound b
  SeComplement { inner = _ } -> setAlgebraSubsetAllCompound b
  SeIntersect { branches = bs } -> setAlgebraSubsetEvery (SeAll) bs false
  -- signature-substrate Phase 4 slice 3a — THE EQUIVARIANCE CORRECTION.
  -- The trailing `Just false` is the "every LEAF is domain-bounded, so no leaf
  -- is ⊤" refutation. That premise is exactly what a rigid violates: κ := ⊤ is
  -- a well-kinded realizable ground instantiation, under which ⊤ ⊆ κ HOLDS.
  -- Inheriting the leaf default would make `⊤ ⊆ κ` a FALSE refutation — the
  -- single dangerous default the slice-3a census found. Nothing.
  SeRigid {} -> Nothing
  _ -> Just false

-- signature-substrate Phase 4 slice 3a — κ ⊆ b, the COMPLETE rigid subset rule.
-- The soundness statement is EQUIVARIANCE, not non-unification: every Just true
-- derived at a fresh rigid κ must stay valid when κ is replaced by EVERY
-- well-kinded realizable ground type T. Exactly one rule survives that test at
-- this position: syntactic self-identity (κ ⊆ κ ⟼ T ⊆ T, reflexivity, valid at
-- every T). The other two Just-true rows of the matrix are decided ABOVE this
-- arm and are κ-independent by construction — `∅ ⊆ κ` at setAlgebraIsSubset's
-- leading `SeNone -> Just true`, and `κ ⊆ ⊤` at the `SeAll` shortcut both
-- setAlgebraIsSubset and setAlgebraDecideLeafSubset check before any a-dispatch.
-- Everything else abstains: κ ⊆ <concrete> fails at κ := ⊤, <concrete> ⊆ κ
-- fails at κ := ∅.
--
-- Identity is scopeToken + ordinal + kind (via setSemanticEq's SeRigid arm), so
-- two live check scopes stay non-unifiable even when their source binders share
-- a spelling, and a same-token/different-ordinal pair (two binders of ONE
-- scheme) is correctly NOT the same atom.
@label "set-algebra: subsetRigidArm"
@description "signature-substrate Phase 4 slice 3a — κ ⊆ b for a validation rigid a: syntactic self-identity (same scopeToken + ordinal + kind) ⇒ Just true; every other b ⇒ Nothing. `∅ ⊆ κ` and `κ ⊆ ⊤` are decided by the ⊥/⊤ shortcuts above this arm; `⊤ ⊆ κ` is fenced in setAlgebraSubsetAllArm. Never refutes — a Just false at a rigid fails under some ground instantiation. Internal helper to setAlgebraDecideLeafSubset."
@tags "engine" "internal" "set-algebra" "subset" "rigid" "signature-substrate" "phase-4"
@category "engine-internal"
setAlgebraSubsetRigidArm : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetRigidArm a b = case b of
  SeRigid {} -> if setSemanticEq a b then Just true else Nothing
  _ -> Nothing

@label "set-algebra: subsetAllCompound"
@description "floor-kernel Phase 3c — close missing.sub.top-compound: for a ctx-free union/diff/complement RHS, decide top⊆b by NNF + the shared exact top-cover engine. Both decided polarities pass through; an ungated or out-of-slice compound remains Nothing. Internal helper to setAlgebraSubsetAllArm."
@tags "engine" "internal" "set-algebra" "subset" "top-cover" "floor-kernel" "phase-3c"
@category "engine-internal"
setAlgebraSubsetAllCompound : (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetAllCompound b =
  if setAlgebraCtxFree b
  then setAlgebraTopCover (setAlgebraNnf b)
  else Nothing

-- {x, y} ⊆ b. Order-independent over distinct b-shapes (mirrors the TS
-- enum arm + tail). enum⊆named / enum⊆pattern LOOP `setAlgebraContains b v`
-- per value, folded mEvery (the b-side kill-2-birds); enum⊆interval checks
-- each value's IntervalValue via inInterval; enum⊆$where extracts + recurses.
@label "set-algebra: subsetEnumArm"
@description "Phase 3b-3 Step 3 Stage D — {x,y} ⊆ b leaf decision. enum⊆enum (membership), enum⊆interval (inInterval ∘ classifyIntervalValue per value), enum⊆named/pattern (setAlgebraContains LOOP, mEvery), enum⊆$where (whereExtract+recurse), else tail rules. Mirrors set-algebra.ts:setEnumDecideSubset. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "phase-2a"
@category "engine-internal"
setAlgebraSubsetEnumArm : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetEnumArm a b = case a of
  SeEnum { values = vs } -> case b of
    SeEnum { values = bvs } -> setAlgebraAllValuesInTri vs bvs false
    SeInterval { interval = biv } -> setAlgebraAllInInterval (setAlgebraClassifyInterval biv) vs
    SeRef {} -> setAlgebraEnumSubsetMembers b vs false
    SePattern {} -> setAlgebraEnumSubsetMembers b vs false
    -- decide-substrate Phase 8λ.2 / 8λ.2-r — {w} ⊆ SeArrow / {w} ⊆ SeCtor is
    -- per-value membership (setAlgebraContains → the intensional arrow arm /
    -- the 8μ.1a ctor arm), NOT deepEq: this is the route the KERNEL witness
    -- rule takes to re-certify a proposed witness (`verifyWitnessMembership →
    -- decideSubset (SeEnum [w]) s`). Without these arms the singleton-enum fell
    -- to the deepEq tail ⇒ Nothing ⇒ a VALID witness was rejected — for lambdas
    -- (8λ.2) AND for ctor-set witnesses (8λ.2-r — seWitnessCtor's own output
    -- didn't re-certify; the contains-vs-subset cross-face probe caught both).
    SeArrow {} -> setAlgebraEnumSubsetMembers b vs false
    SeCtor {} -> setAlgebraEnumSubsetMembers b vs false
    SeWhere { pred = bp } -> case whereExtract bp of
      Just bSet -> setAlgebraDecideLeafSubset a bSet
      Nothing -> Nothing
    SeUnion {} -> setAlgebraSubsetEnumCompound a b vs
    SeIntersect {} -> setAlgebraSubsetEnumCompound a b vs
    SeDiff {} -> setAlgebraSubsetEnumCompound a b vs
    SeComplement {} -> setAlgebraSubsetEnumCompound a b vs
    _ -> setAlgebraSubsetTailRules a b
  _ -> Nothing

-- enum ⊆ Boolean-compound b — floor-kernel Phase 1 SOUNDNESS FIX. A finite
-- enum's subset question is EXACTLY the per-value membership conjunction
-- ({v…} ⊆ B ⟺ ∀v. v ∈ B), and `setAlgebraContains` is exact over the
-- pure-structural compound fragment — so route it to the members loop (the
-- same rule the SeRef/SePattern/SeArrow/SeCtor arms already ride). The old
-- fall-through to the tail rules' b-∪ mSome fold FALSELY refuted an enum that
-- SPLITS across union branches (`{v,w} ⊆ {v} ∪ {w} ⇒ Just false`). Gated on
-- setAlgebraSearchable (no SeWhere/SeRef/SePattern leaf) — the D′ ctx
-- discipline: those leaves' membership rides ctx-natives bare-name callers may
-- not carry; a non-searchable b keeps the old tail-rules path.
@label "set-algebra: subsetEnumCompound"
@description "floor-kernel Phase 1 soundness fix / Phase 3b kernel face — enum ⊆ ∪/∩/∖/¬ via the exact per-value membership loop. The original setAlgebraSearchable gate remains; Phase 3b admits the same ctx-free arrow-Boolean fragment as decideEmpty so a realized closure witness can re-certify through {w}⊆s. Other non-searchable compounds keep the old tail rules. Internal helper to setAlgebraSubsetEnumArm."
@tags "engine" "internal" "set-algebra" "subset" "witness" "floor-kernel" "phase-1" "phase-3b"
@category "engine-internal"
setAlgebraSubsetEnumCompound : (a: SetExpr) -> (b: SetExpr) -> (vs: List Any) -> Maybe Boolean
setAlgebraSubsetEnumCompound a b vs =
  if or (setAlgebraSearchable b) (setAlgebraArrowBoolEligible b)
  then setAlgebraEnumSubsetMembers b vs false
  else setAlgebraSubsetTailRules a b

-- Field-identity Phase 3 semantic equality. Runtime `deepEqValue` remains the
-- value-equality primitive, but it is not SetExpr equality because wireName is
-- a mutable boundary projection. Constructor fields align by FieldKey; arrow
-- params remain list-positional and their identity metadata is not a variance
-- axis. Boolean branch order and μ binder spelling retain the existing exact
-- structural posture.

@category "engine-internal"
setSemanticEqList : (left: List SetExpr) -> (right: List SetExpr) -> Boolean
setSemanticEqList left right =
  case head left of
    Nothing -> eq (length right) 0
    Just l ->
      case head right of
        Nothing -> false
        Just r ->
          if setSemanticEq l r
          then setSemanticEqList (eufRest left) (eufRest right)
          else false

-- 8λ.5 REPAIR of a fi-P3 defect: the length gate must run ONCE at the top.
-- The recursion consumes `left` while `right` stays the FULL list (the key
-- lookup needs it), so re-checking `length left == length right` per step made
-- the fold return false for EVERY ctor with ≥1 field — semantic equality (and
-- with it μ/subset REFLEXIVITY over field-carrying ctors: setAlgebraMuSubset's
-- deepEq-first short-circuit, the subsetTailRules fallback) was broken and
-- MASKED by the keyless-degrade RED class (typeToSetExpr(List…) ⇒ SeAll never
-- reaches ctor-fields eq). Alignment soundness unchanged: equal lengths +
-- every left key found in right + caller-validated slots (no duplicate keys)
-- ⇒ the pairing is a bijection.
@category "engine-internal"
setSemanticCtorFieldsEq : (left: List SetCtorField) -> (right: List SetCtorField) -> Boolean
setSemanticCtorFieldsEq left right =
  if not (eq (length left) (length right))
  then false
  else setSemanticCtorFieldsEqGo left right

@category "engine-internal"
setSemanticCtorFieldsEqGo : (left: List SetCtorField) -> (right: List SetCtorField) -> Boolean
setSemanticCtorFieldsEqGo left right =
  case head left of
    Nothing -> true
    Just lf ->
      case seCtorFindField right lf.key of
        Nothing -> false
        Just rf ->
          if not (eq (seCtorFieldReadWire lf) (seCtorFieldReadWire rf))
          then false
          else if setSemanticEq lf.set rf.set
          then setSemanticCtorFieldsEqGo (eufRest left) right
          else false

@category "engine-internal"
setSemanticArrowParamsEq : (left: List SetArrowParam) -> (right: List SetArrowParam) -> Boolean
setSemanticArrowParamsEq left right =
  case head left of
    Nothing -> eq (length right) 0
    Just lp ->
      case head right of
        Nothing -> false
        Just rp ->
          if setSemanticEq lp.set rp.set
          then setSemanticArrowParamsEq (eufRest left) (eufRest right)
          else false

@label "SetExpr semantic equality"
@description "Identity-aware semantic equality for canonical SetExpr values. SeCtor fields align by FieldKey and must ALSO agree on their RESOLVED wire projection (type-substrate P1(a): the fields walk ignored wireName entirely, so two ctors reading DIFFERENT host properties compared equal and the μ entry's reflexivity shortcut — which sits ABOVE the fieldwise loops — proved ⊆ between them; setAlgebraNormDiffMain collapsed their difference to SeNone by the same predicate). SeArrow params align by list position and ignore key/wire metadata — deliberately: an arrow param's wire/key is retained reflection metadata, never host-read. This predicate is only ever a proof SHORTCUT or a collapse trigger, never a refuter, so a stricter answer can only degrade to the fallback; reflexivity on identical operands is preserved (identical fields resolve identically). Runtime value equality remains unchanged."
@tags "engine" "set-algebra" "field-identity" "equality" "phase-3"
setSemanticEq : (a: SetExpr) -> (b: SetExpr) -> Boolean
setSemanticEq a b = case a of
  SeAll -> case b of
    SeAll -> true
    _ -> false
  SeNone -> case b of
    SeNone -> true
    _ -> false
  SeEnum { values = av } -> case b of
    SeEnum { values = bv } -> deepEqValue av bv
    _ -> false
  SeInterval { interval = ai } -> case b of
    SeInterval { interval = bi } -> deepEqValue ai bi
    _ -> false
  SeRef { handle = ah } -> case b of
    SeRef { handle = bh } -> eq ah bh
    _ -> false
  SePattern { pattern = ap } -> case b of
    SePattern { pattern = bp } -> deepEqValue ap bp
    _ -> false
  SeWhere { pred = ap } -> case b of
    SeWhere { pred = bp } -> deepEqValue ap bp
    _ -> false
  SeCtor { ctor = ac, fields = afs } -> case b of
    SeCtor { ctor = bc, fields = bfs } ->
      if not (eq ac bc)
      then false
      else if not (fieldSemanticSlotsValid afs)
      then false
      else if not (fieldSemanticSlotsValid bfs)
      then false
      else setSemanticCtorFieldsEq afs bfs
    _ -> false
  SeMu { var = av, body = ab } -> case b of
    SeMu { var = bv, body = bb } -> if eq av bv then setSemanticEq ab bb else false
    _ -> false
  SeArrow { params = aps, returns = ar } -> case b of
    SeArrow { params = bps, returns = br } ->
      if not (fieldSemanticSlotsValid aps)
      then false
      else if not (fieldSemanticSlotsValid bps)
      then false
      else if setSemanticArrowParamsEq aps bps then setSemanticEq ar br else false
    _ -> false
  SeUnion { branches = ab } -> case b of
    SeUnion { branches = bb } -> setSemanticEqList ab bb
    _ -> false
  SeIntersect { branches = ab } -> case b of
    SeIntersect { branches = bb } -> setSemanticEqList ab bb
    _ -> false
  SeDiff { left = al, right = ar } -> case b of
    SeDiff { left = bl, right = br } -> if setSemanticEq al bl then setSemanticEq ar br else false
    _ -> false
  SeComplement { inner = ai } -> case b of
    SeComplement { inner = bi } -> setSemanticEq ai bi
    _ -> false
  -- signature-substrate Phase 4 slice 3a — rigid identity. Two rigids are the
  -- SAME atom iff they agree on scopeToken (the scope-unique mint nonce),
  -- ordinal (the binder's position in the effective scheme's quantifier order),
  -- AND kind. Including the kind is deliberate over-fencing: a same-token,
  -- same-ordinal, different-kind pair is malformed, and answering `false`
  -- degrades it to a Nothing verdict instead of proving a subset over an
  -- inconsistent atom.
  SeRigid { scopeToken = at, ordinal = ao, kind = ak } -> case b of
    SeRigid { scopeToken = bt, ordinal = bo, kind = bk } ->
      if not (eq at bt)
      then false
      else if not (eq ao bo)
      then false
      else deepEqValue ak bk
    _ -> false
  -- signature-substrate Phase 4 slice 3a — the terminal default. Before this
  -- slice the outer `case a of` had NO catch-all at all: a value outside the
  -- enumerated constructors fell off the end of an inexhaustive match. Every
  -- reflexivity shortcut in the subset and μ deciders (setAlgebraSubsetTailRules,
  -- setAlgebraWhereSubsetTailRules, setAlgebraMuSubset) reads this relation, so
  -- the honest terminal is `false` — "not provably the same set", which degrades
  -- those shortcuts to Nothing rather than to a proof over an unknown shape.
  _ -> false

-- _subsetTailRules (ported): right-side compounds + structural-eq fallback.
-- b=$union ⇒ mSome (A ⊆ B∪C if A ⊆ some branch); b=$intersect ⇒ mEvery
-- (A ⊆ B∩C iff A ⊆ every branch); b=$where ⇒ recurse on the extracted set;
-- else structural equality (A ⊆ A is Just true; inequality ⇒ Nothing, not
-- a refutation).
@label "set-algebra: subsetTailRules"
@description "Phase 3b-3 Step 3 Stage D — ported _subsetTailRules: A ⊆ b's $union (mSome) / $intersect (mEvery) / extracted-$where (whereExtract+recurse) / structural-eq fallback (the Fenel `deepEqValue` structural deep-eq over canonical `$tag` Se*; Phase 1c — the subsetStructEq ctx-native + its `$`-key JSON.stringify round-trip are deleted; deepEqValue mirrors the evaluator's deepEqual, byte-identical over the canonical form — shallow `eq` is reference-shallow on records, so it is NOT a valid fold). Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "phase-2a"
@category "engine-internal"
setAlgebraSubsetTailRules : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetTailRules a b = case b of
  SeUnion { branches = brs } -> setAlgebraSubsetSome a brs false
  SeIntersect { branches = brs } -> setAlgebraSubsetEvery a brs false
  SeWhere { pred = bp } -> case whereExtract bp of
    Just bSet -> setAlgebraDecideLeafSubset a bSet
    Nothing -> Nothing
  -- 8μ.2 — a ⊆ μw.G: the b-side bounded unroll (fresh fuel 4), then deepEq. The
  -- hook BEFORE the generic leaf falls to deepEq-only — an a-leaf / SeCtor ⊆ a
  -- right-μ (`Nil ⊆ ⟦List Int⟧`, `Cons{ℤ,T} ⊆ T`) unrolls the μ once and the
  -- SeCtor / union arms decide. Only proves (Nothing ⇒ deepEq fallback).
  SeMu {} -> case setAlgebraMuSubset a b 4 of
    Just true -> Just true
    _ -> if setSemanticEq a b then Just true else Nothing
  _ -> if setSemanticEq a b then Just true else Nothing

-- floor-kernel Phase 4 — the SeWhere-specific tail formerly survived in TS as
-- `_subsetTailRules`. It must recurse through the TOP-LEVEL subset judgment so
-- each right-side union/intersect child gets another chance to extract the
-- left SeWhere. The generic leaf tail above deliberately calls
-- `setAlgebraDecideLeafSubset` and therefore cannot preserve this behavior.
@label "set-algebra: where subset tail rules"
@description "The SeWhere-specific subset tail: right union uses a sound proof-only mSome fold through top-level setAlgebraIsSubset, right intersect uses mEvery through that same judgment, right SeWhere extracts and retries, and the terminal is structural equality. Ported from the last live TS _subsetTailRules call in floor-kernel Phase 4."
@tags "engine" "internal" "set-algebra" "subset" "where" "floor-kernel" "phase-4"
@category "engine-internal"
setAlgebraWhereSubsetTailRules : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraWhereSubsetTailRules a b = case b of
  SeUnion { branches = brs } -> setAlgebraWhereSubsetSome a brs false
  SeIntersect { branches = brs } -> setAlgebraWhereSubsetEvery a brs false
  SeWhere { pred = bp } -> case whereExtract bp of
    Just bSet -> setAlgebraIsSubset a bSet
    Nothing -> if setSemanticEq a b then Just true else Nothing
  _ -> if setSemanticEq a b then Just true else Nothing

@label "set-algebra: where subset some"
@description "Sound mSome fold for a SeWhere left operand over right-union branches, recursively invoking the top-level subset judgment. Any Just true proves; no positive branch yields Nothing because a set may split across union branches."
@tags "engine" "internal" "set-algebra" "subset" "where" "floor-kernel" "phase-4"
@category "engine-internal"
setAlgebraWhereSubsetSome : (a: SetExpr) -> (branches: List SetExpr) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraWhereSubsetSome a branches sawNothing =
  case head branches of
    Nothing -> Nothing
    Just first ->
      case setAlgebraIsSubset a first of
        Just true -> Just true
        Just false ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraWhereSubsetSome a rest sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraWhereSubsetSome a rest true

@label "set-algebra: where subset every"
@description "mEvery fold for a SeWhere left operand over right-intersection branches, recursively invoking the top-level subset judgment. Any Just false refutes; all Just true proves; otherwise Nothing."
@tags "engine" "internal" "set-algebra" "subset" "where" "floor-kernel" "phase-4"
@category "engine-internal"
setAlgebraWhereSubsetEvery : (a: SetExpr) -> (branches: List SetExpr) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraWhereSubsetEvery a branches sawNothing =
  case head branches of
    Nothing -> if sawNothing then Nothing else Just true
    Just first ->
      case setAlgebraIsSubset a first of
        Just false -> Just false
        Just true ->
          case tail branches of
            Nothing -> if sawNothing then Nothing else Just true
            Just rest -> setAlgebraWhereSubsetEvery a rest sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraWhereSubsetEvery a rest true

-- mSome over b's $union branches (A ⊆ branch for some branch). Tri-state:
-- any Just true ⇒ Just true; else Nothing. floor-kernel Phase 1 SOUNDNESS
-- FIX: the fold's old "all branches Just false ⇒ Just false" collapse was a
-- FALSE refutation whenever A SPLITS across the branches (per-branch
-- `A ⊄ bᵢ` never produces a value of A outside ∪bs — [0,10] ⊆ [0,5]∪[5,10]
-- refuted every branch yet the cover holds; same for ctor/ref splits). The
-- ∃-incomplete rule can PROVE, never refute ⇒ the no-proof terminal is
-- Nothing. Exact enum refutations are preserved upstream (the enum arm's
-- per-value members loop refutes with a genuine escapee value). `sawNothing`
-- is now unused but kept for signature symmetry (the isDisjointIntersect
-- precedent).
@label "set-algebra: subsetSome"
@description "Phase 2a-1 / floor-kernel Phase 1 soundness fix — mSome semantics over b's $union branches for the A ⊆ B∪C tail rule: any Just true ⇒ Just true, else Nothing (the old all-Just-false ⇒ Just false collapse falsely refuted an A splitting across branches — the ∃-rule can prove, never refute). Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "phase-2a"
@category "engine-internal"
setAlgebraSubsetSome : (a: SetExpr) -> (branches: List SetExpr) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraSubsetSome a branches sawNothing =
  case head branches of
    Nothing -> Nothing
    Just first ->
      let r = setAlgebraDecideLeafSubset a first
      case r of
        Just true -> Just true
        Just false ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraSubsetSome a rest sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraSubsetSome a rest true

-- mEvery over b's $intersect branches (A ⊆ every branch). Tri-state: any
-- Just false ⇒ Just false; else any Nothing ⇒ Nothing; else Just true.
@label "set-algebra: subsetEvery"
@description "Phase 2a-1 — mEvery semantics over b's $intersect branches for the A ⊆ B∩C tail rule. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "phase-2a"
@category "engine-internal"
setAlgebraSubsetEvery : (a: SetExpr) -> (branches: List SetExpr) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraSubsetEvery a branches sawNothing =
  case head branches of
    Nothing -> if sawNothing then Nothing else Just true
    Just first ->
      let r = setAlgebraDecideLeafSubset a first
      case r of
        Just false -> Just false
        Just true ->
          case tail branches of
            Nothing -> if sawNothing then Nothing else Just true
            Just rest -> setAlgebraSubsetEvery a rest sawNothing
        Nothing ->
          case tail branches of
            Nothing -> Nothing
            Just rest -> setAlgebraSubsetEvery a rest true

-- every a-enum value is a member of b's enum value list (enum⊆enum).
@label "set-algebra: allValuesIn"
@description "Phase 2a-1 — every value of the a-enum is a member of the b-enum value list. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "phase-2a"
@category "engine-internal"
setAlgebraAllValuesIn : (vs: List Any) -> (bvs: List Any) -> Boolean
setAlgebraAllValuesIn vs bvs = std.all vs (\v -> setAlgebraEnumContainsLoop bvs v)

@category "engine-internal"
setAlgebraAllValuesInTri : (vs: List Any) -> (bvs: List Any) -> (sawNothing: Bool) -> Maybe Bool
setAlgebraAllValuesInTri vs bvs sawNothing =
  -- One std fold (constant host stack); a proven non-member makes the verdict
  -- Just false and stops the membership questions, as the former recursion did.
  fold (\within value -> case within of
    Just false -> within
    _ -> case setAlgebraEnumContainsTri bvs value false of
      Just false -> Just false
      Just true -> within
      Nothing -> Nothing) (if sawNothing then Nothing else Just true) vs

-- every a-enum value (classified to an IntervalValue) is inside b's interval
-- (enum⊆interval). `iv` is the already-classified b-interval; each raw value
-- is classified via classifyIntervalValue at the leaf.
@label "set-algebra: allInInterval"
@description "Phase 3b-3 Step 3 Stage D — every a-enum value (classifyIntervalValue per raw value) is inside the already-classified b-interval. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "phase-2a"
@category "engine-internal"
setAlgebraAllInInterval : (iv: Interval) -> (vs: List Any) -> Maybe Boolean
setAlgebraAllInInterval iv vs =
  setAlgebraEnumSubsetMembers (SeInterval { interval = declassifyInterval iv }) vs false

-- enum ⊆ b (b = named / pattern): the per-value membership LOOP. set-algebra-to-
-- fenel Phase 3b-3 Step 3 Stage D — the per-value memberships the marshaller fed
-- (`setNamedContains(b, v)` on SisbNamed / `contains(b, v)` on SisbPattern) now
-- compute IN Fenel, calling the sibling `setAlgebraContains b v` per value under
-- the merged decider ctx (the b-side kill-2-birds). `b` is the canonical value-
-- only leaf (SeRef / SePattern), so contains never needs the value-binding the
-- set-vs-set decider didn't set up. Fold = mEvery (≡ the old setAlgebraMEveryMb
-- over the fed list): any Just false ⇒ Just false; all Just true ⇒ Just true;
-- else Nothing. Short-circuits the membership computation on the first refutation.
@label "set-algebra: enumSubsetMembers"
@description "Phase 3b-3 Step 3 Stage D — enum ⊆ b (named/pattern), LOOPING setAlgebraContains over the enum's values (the b-side membership kill-2-birds): any Just false ⇒ Just false; all Just true ⇒ Just true; else Nothing. Replaces the TS-fed-memberships setAlgebraMEveryMb. Internal helper."
@tags "engine" "internal" "set-algebra" "subset" "phase-3b-3"
@category "engine-internal"
setAlgebraEnumSubsetMembers : (b: SetExpr) -> (vs: List Any) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraEnumSubsetMembers b vs sawNothing =
  -- One std fold (constant host stack); the first member proven outside `b`
  -- makes the verdict Just false and stops the membership questions.
  fold (\within v -> case within of
    Just false -> within
    _ -> case setAlgebraContains b v of
      Just false -> Just false
      Just true -> within
      Nothing -> Nothing) (if sawNothing then Nothing else Just true) vs

-- ============================================================================
-- Phase 7c proof-of-pattern — peel helpers ported via the TraversalType
-- recipe (extended in 7c with `raw: Any` on every variant + TtField so the
-- bodies can return raw FenelType subtrees without lossy round-trip).
--
-- Mirrors the TS oracle at implementations/typescript/engine/src/set-algebra.ts:
--   peelToVariant    — recognise `$variant` / `$refined` / `$opaque.pure`-
--                       wrapped variants; returns the inner $variant content.
--   peelMaybe        — recognise `Nothing | Just T` shape; returns T.
--   peelList         — recognise `$opaque(array)` / `$mu` / `$variant`
--                       List-encoded shape with `Nil | Cons { head: T, tail }`
--                       cases; returns T.
--   peelListVariant  — internal helper for peelList's Cons/Nil pattern recogn.
--   peelResult       — recognise `Err E | Ok A` shape;
--                       returns { err = E, ok = A }.
-- ============================================================================

-- peelToVariant — walks through TtRefined.base and TtOpaque.pure wrappers
-- to find an inner TtVariant. Returns Maybe<FenelType-of-$variant-content>
-- — the body extracts the marshalled TtVariant's `raw` (set by the TS
-- wrapper to the whole `t` FenelType); the wrapper itself extracts the
-- inner `.$variant` value before returning to the TS caller.
@label "set-algebra: peelToVariant"
@description "Phase 7c — walk through outer $refined / $opaque.pure wrappers to find an inner $variant; returns the matched type's raw (TtVariant.raw). Boundary adapter; dispatched via `dispatchedPeelToVariant` in engine-bodies-dispatch.ts which extracts `.$variant` from the result. Mirrors implementations/typescript/engine/src/set-algebra.ts:peelToVariant (now a thin shim)."
@tags "engine" "set-algebra" "peel" "boundary" "phase-7c"
peelToVariant : (node: TraversalType) -> Maybe Any
peelToVariant node = case node of
  TtVariant { raw = r } -> Just r
  TtRefined { base = b } -> peelToVariant b
  TtOpaque { pure = p } -> peelToVariant p
  _ -> Nothing

-- peelMaybe — recognise the canonical `Nothing | Just T`
-- variant shape (peeling through outer TtRefined). Returns Just <raw
-- FenelType of T> when matched; Nothing otherwise.
@label "set-algebra: peelMaybe"
@description "Phase 7c — recognise the canonical `Nothing | Just { _0: T }` variant shape (through outer $refined). Returns Just T-raw when matched; Nothing otherwise. Boundary adapter; dispatched via `dispatchedPeelMaybe`. Mirrors implementations/typescript/engine/src/set-algebra.ts:peelMaybe."
@tags "engine" "set-algebra" "peel" "boundary" "phase-7c"
peelMaybe : (node: TraversalType) -> Maybe Any
peelMaybe node = case node of
  TtRefined { base = b } -> peelMaybe b
  TtVariant { cases = cs } -> setAlgebraPeelMaybeFromCases cs
  _ -> Nothing

@label "set-algebra: peelMaybeFromCases"
@description "Phase 7c / field-identity Phase 3 — given a TtVariantCase list, validate Nothing/Just shape (Nothing nullary, Just with exactly one positional field at ordinal 0); return the field.raw wrapped in Just when matched. Current wire spelling is never identity. Internal helper to peelMaybe."
@tags "engine" "internal" "set-algebra" "peel" "phase-7c"
@category "engine-internal"
setAlgebraPeelMaybeFromCases : (cs: List TtVariantCase) -> Maybe Any
setAlgebraPeelMaybeFromCases cs =
  if not (eq (length cs) 2)
  then Nothing
  else
    let nothingMaybe = setAlgebraFindCaseByName cs "Nothing"
    case nothingMaybe of
      Nothing -> Nothing
      Just nothingCase ->
        let justMaybe = setAlgebraFindCaseByName cs "Just"
        case justMaybe of
          Nothing -> Nothing
          Just justCase ->
            if gt (length nothingCase.fields) 0
            then Nothing
            else
              if not (eq (length justCase.fields) 1)
              then Nothing
              else case head justCase.fields of
                Nothing -> Nothing
                Just field ->
                  if fieldKeyEq field.semanticKey (PositionalField { index = 0 })
                  then Just field.raw
                  else Nothing

-- peelList — recognise the canonical List encoding. Three shapes:
--   1. TtOpaque.pure = TtVariant with Nil/Cons cases (Phase 2.5 self-ref shape)
--   2. TtOpaque.pure = TtMu.body = TtVariant with Nil/Cons (legacy $mu form)
--   3. TtMu.body = TtVariant with Nil/Cons (bare $mu, no opaque wrap)
-- Returns Just (<raw FenelType of head field's type>) when
-- matched; Nothing otherwise.
--
-- representation-substrate Phase 5a — the `repr === "array"` gate RETIRED.
-- Recognition is now purely STRUCTURAL: `setAlgebraPeelListFromOpaquePure`
-- matches only a direct Nil/Cons TtVariant (Phase 2.5) or a TtMu wrapping one,
-- so an opaque whose pure is NOT a bare cons-spine falls through to Nothing.
-- This disambiguates String from List byte-identically WITHOUT the repr label:
-- String's `pure` is the EXPANDED nested List opaque (a TtOpaque), not a bare
-- TtVariant, so it hits the helper's `_ -> Nothing` arm. (Step-0 probe verified:
-- peelList(String)=Nothing, peelList(List)=Just{elem}.) The native rep now lives
-- in the per-type `Reprable JsRuntime` instance, not this decorative string.
@label "set-algebra: peelList"
@description "Phase 7c / repr-retire 5a — recognise the canonical List encoding STRUCTURALLY ($opaque with Phase-2.5 self-reference or legacy $mu pure, or bare $mu with Cons/Nil variant). Returns Just { value = head-raw } when matched; Nothing otherwise. Boundary adapter; dispatched via `dispatchedPeelList`. Mirrors implementations/typescript/engine/src/set-algebra.ts:peelList."
@tags "engine" "set-algebra" "peel" "boundary" "phase-7c"
peelList : (node: TraversalType) -> (headKey: FieldKey) -> Maybe Any
peelList node headKey = case node of
  TtRefined { base = b } -> peelList b headKey
  TtOpaque { pure = p } -> setAlgebraPeelListFromOpaquePure p headKey
  TtMu { body = b } -> setAlgebraPeelListFromMuBody b headKey
  _ -> Nothing

@label "set-algebra: peelListFromOpaquePure"
@description "Phase 7c — inside a TtOpaque.pure, recognise either a direct TtVariant (Phase 2.5) or a TtMu wrapping a TtVariant (legacy μ); else Nothing (e.g. String's nested List-opaque pure). Internal helper to peelList."
@tags "engine" "internal" "set-algebra" "peel" "phase-7c"
@category "engine-internal"
setAlgebraPeelListFromOpaquePure : (p: TraversalType) -> (headKey: FieldKey) -> Maybe Any
setAlgebraPeelListFromOpaquePure p headKey = case p of
  TtVariant { cases = cs } -> peelListVariant cs headKey
  TtMu { body = b } -> setAlgebraPeelListFromMuBody b headKey
  _ -> Nothing

@label "set-algebra: peelListFromMuBody"
@description "Phase 7c — inside a TtMu.body, recognise a TtVariant with Cons/Nil cases. Internal helper to peelList."
@tags "engine" "internal" "set-algebra" "peel" "phase-7c"
@category "engine-internal"
setAlgebraPeelListFromMuBody : (b: TraversalType) -> (headKey: FieldKey) -> Maybe Any
setAlgebraPeelListFromMuBody b headKey = case b of
  TtVariant { cases = cs } -> peelListVariant cs headKey
  _ -> Nothing

-- peelListVariant — internal Cons/Nil recogniser. Takes a TtVariantCase
-- list; matches when there are exactly two cases named "Nil" (nullary)
-- and "Cons" (two fields, one of which is "head"). Returns Just <raw
-- FenelType of head's type> when matched.
@label "set-algebra: peelListVariant"
@description "Phase 7c / field-identity Phase 3 — given a TtVariantCase list, validate Nil/Cons shape (Nil nullary, Cons with exactly two fields including the canonical List-head FieldKey); return Just { value = head.raw }. Current wire spelling is never identity. Internal helper to peelList."
@tags "engine" "internal" "set-algebra" "peel" "phase-7c"
@category "engine-internal"
peelListVariant : (cs: List TtVariantCase) -> (headKey: FieldKey) -> Maybe Any
peelListVariant cs headKey =
  if not (eq (length cs) 2)
  then Nothing
  else
    let nilMaybe = setAlgebraFindCaseByName cs "Nil"
    case nilMaybe of
      Nothing -> Nothing
      Just nilCase ->
        let consMaybe = setAlgebraFindCaseByName cs "Cons"
        case consMaybe of
          Nothing -> Nothing
          Just consCase ->
            if gt (length nilCase.fields) 0
            then Nothing
            else
              if not (eq (length consCase.fields) 2)
              then Nothing
              else
                let headMaybe = setAlgebraFindFieldByKey consCase.fields headKey
                case headMaybe of
                  Nothing -> Nothing
                  Just headField ->
                    Just headField.raw

-- Source declarations can retain unkeyed nested records. This projection is
-- the existing authoring lens, not the strict semantic List recognizer above.
@label "List element for authoring"
@description "Project the declared List element without inventing field identities. A canonical List spine retains its element even when that nested authoring type needs repair; incomplete declarations admit only an originally unkeyed head field. Membership and containment continue to use strict peelList."
@tags "engine" "authoring" "type" "list"
peelListForAuthoring : (node: TraversalType) -> (headKey: FieldKey) -> (unkeyedTokens: List String) -> Maybe Any
peelListForAuthoring node headKey unkeyedTokens =
  case node of
    TtRefined { base = base } -> peelListForAuthoring base headKey unkeyedTokens
    _ ->
      let spine = case node of
            TtOpaque { pure = pure } -> Just pure
            TtMu { body = body } -> Just body
            _ -> Nothing
      let canonical = case spine of
            Nothing -> Nothing
            Just pure ->
              let body = case pure of
                    TtMu { body = body } -> body
                    _ -> pure
              case body of
                TtVariant { cases = cases } ->
                  if not (eq (length cases) 2) then Nothing
                  else case setAlgebraFindCaseByName cases "Nil" of
                    Nothing -> Nothing
                    Just nilCase ->
                      if not (eq (length nilCase.fields) 0) then Nothing
                      else case setAlgebraFindCaseByName cases "Cons" of
                        Nothing -> Nothing
                        Just consCase ->
                          if not (eq (length consCase.fields) 2) then Nothing
                          else case fieldSemanticSlotsError (typeTraversalSemanticFieldProjections consCase.fields) of
                            Just message -> Nothing
                            Nothing ->
                              let heads = filter (\field -> fieldKeyEq field.semanticKey headKey) consCase.fields
                              if not (eq (length heads) 1) then Nothing
                              else case head heads of
                                Just field -> Just field.raw
                                Nothing -> Nothing
                _ -> Nothing
      case canonical of
        Just element -> Just element
        Nothing -> setAlgebraDeclaredListElement node unkeyedTokens

@category "engine-internal"
setAlgebraDeclaredListElement : (node: TraversalType) -> (unkeyedTokens: List String) -> Maybe Any
setAlgebraDeclaredListElement node unkeyedTokens = case node of
  TtRefined { base = base } -> setAlgebraDeclaredListElement base unkeyedTokens
  TtOpaque { pure = pure } -> setAlgebraDeclaredListBody pure unkeyedTokens
  TtMu { body = body } -> setAlgebraDeclaredListBody body unkeyedTokens
  _ -> Nothing

@category "engine-internal"
setAlgebraDeclaredListBody : (node: TraversalType) -> (unkeyedTokens: List String) -> Maybe Any
setAlgebraDeclaredListBody node unkeyedTokens = case node of
  TtMu { body = body } -> setAlgebraDeclaredListCases body unkeyedTokens
  _ -> setAlgebraDeclaredListCases node unkeyedTokens

@category "engine-internal"
setAlgebraDeclaredListCases : (node: TraversalType) -> (unkeyedTokens: List String) -> Maybe Any
setAlgebraDeclaredListCases node unkeyedTokens = case node of
  TtVariant { cases = cases } ->
    if not (eq (length cases) 2)
    then Nothing
    else case setAlgebraFindCaseByName cases "Nil" of
      Nothing -> Nothing
      Just nilCase ->
        if not (eq (length nilCase.fields) 0)
        then Nothing
        else case setAlgebraFindCaseByName cases "Cons" of
          Nothing -> Nothing
          Just consCase ->
            if not (eq (length consCase.fields) 2)
            then Nothing
            else
              let unkeyedHeads = filter (\field -> and (eq field.wireName "head") (elem field.token unkeyedTokens)) consCase.fields
              if eq (length unkeyedHeads) 1 then
                case head unkeyedHeads of
                  Just field -> Just field.raw
                  Nothing -> Nothing
              else if gt (length unkeyedHeads) 1 then Nothing
              else Nothing
  _ -> Nothing

-- peelResult — recognise `Err E | Ok A` shape;
-- returns { err = E, ok = A }.
@label "set-algebra: peelResult"
@description "Phase 7c — recognise the canonical `Err { _0: E } | Ok { _0: A }` shape (through outer $refined). Returns Just { err = E-raw, ok = A-raw } when matched. Boundary adapter; dispatched via `dispatchedPeelResult`. Mirrors implementations/typescript/engine/src/set-algebra.ts:peelResult."
@tags "engine" "set-algebra" "peel" "boundary" "phase-7c"
peelResult : (node: TraversalType) -> Maybe ({ err: Any, ok: Any })
peelResult node = case node of
  TtRefined { base = b } -> peelResult b
  TtVariant { cases = cs } -> setAlgebraPeelResultFromCases cs
  _ -> Nothing

@label "set-algebra: peelResultFromCases"
@description "Phase 7c — given a TtVariantCase list of length 2, find Err and Ok cases and delegate to setAlgebraExtractResultFields. Internal helper to peelResult."
@tags "engine" "internal" "set-algebra" "peel" "phase-7c"
@category "engine-internal"
setAlgebraPeelResultFromCases : (cs: List TtVariantCase) -> Maybe ({ err: Any, ok: Any })
setAlgebraPeelResultFromCases cs =
  if not (eq (length cs) 2)
  then Nothing
  else
    let errMaybe = setAlgebraFindCaseByName cs "Err"
    case errMaybe of
      Nothing -> Nothing
      Just errCase ->
        let okMaybe = setAlgebraFindCaseByName cs "Ok"
        case okMaybe of
          Nothing -> Nothing
          Just okCase ->
            setAlgebraExtractResultFields errCase okCase

@label "set-algebra: extractResultFields"
@description "Phase 7c / field-identity Phase 3 — validate Err / Ok each have exactly one positional field at ordinal 0; current wire spelling is ignored. Emit { err = err-raw, ok = ok-raw }. Internal helper to peelResult."
@tags "engine" "internal" "set-algebra" "peel" "phase-7c"
@category "engine-internal"
setAlgebraExtractResultFields : (errCase: TtVariantCase) -> (okCase: TtVariantCase) -> Maybe ({ err: Any, ok: Any })
setAlgebraExtractResultFields errCase okCase =
  if not (eq (length errCase.fields) 1)
  then Nothing
  else case head errCase.fields of
    Nothing -> Nothing
    Just errField ->
      if not (fieldKeyEq errField.semanticKey (PositionalField { index = 0 }))
      then Nothing
      else
        if not (eq (length okCase.fields) 1)
        then Nothing
        else case head okCase.fields of
          Nothing -> Nothing
          Just okField ->
            if not (fieldKeyEq okField.semanticKey (PositionalField { index = 0 }))
            then Nothing
            else Just { err = errField.raw, ok = okField.raw }

-- setAlgebraFindCaseByName — return the first TtVariantCase in cs
-- whose name == targetName, wrapped in Just; Nothing otherwise.
@label "set-algebra: findCaseByName"
@description "Phase 7c — linear scan over a TtVariantCase list to find the first case with the given name. Returns Just { value = case } when found; Nothing otherwise. Internal helper."
@tags "engine" "internal" "set-algebra" "peel" "phase-7c"
@category "engine-internal"
setAlgebraFindCaseByName : (cs: List TtVariantCase) -> (targetName: String) -> Maybe TtVariantCase
setAlgebraFindCaseByName cs targetName = case head cs of
  Nothing -> Nothing
  Just first ->
    if eq first.name targetName
    then Just first
    else case tail cs of
      Nothing -> Nothing
      Just rest -> setAlgebraFindCaseByName rest targetName

-- setAlgebraFindFieldByKey — return the first TtField in fs whose
-- semantic FieldKey equals targetKey, wrapped in Just; Nothing otherwise.
@label "set-algebra: findFieldByKey"
@description "Field-identity Phase 3 — linear scan over a validated TtField list by semantic FieldKey. Current wire spelling is never consulted. Internal helper."
@tags "engine" "internal" "set-algebra" "peel" "phase-7c"
@category "engine-internal"
setAlgebraFindFieldByKey : (fs: List TtField) -> (targetKey: FieldKey) -> Maybe TtField
setAlgebraFindFieldByKey fs targetKey = case head fs of
  Nothing -> Nothing
  Just first ->
    if fieldKeyEq first.semanticKey targetKey
    then Just first
    else case tail fs of
      Nothing -> Nothing
      Just rest -> setAlgebraFindFieldByKey rest targetKey

-- ============================================================================
-- Phase 7c-continuation sub-step 1 — whereToSetExpr leaf helpers.
--
-- Pure operations over primitive inputs (strings / values / pre-classified
-- bools) used by the $where → SetExpr extractor in set-algebra.ts. The
-- predicate-lowering family's recursive top-level (whereToSetExpr) lands in
-- sub-step 2; sub-step 1 ports the structural leaves that produce / consume
-- primitive answers.
--
-- Ported in sub-step 1:
--   flipComp           — comparison-operator string flip (≥ ↔ ≤, > ↔ <)
--   compToSet          — op + value + varSide → CompToSetResult intent marker
--   namedDomain        — $named name → Maybe<NamedDomain> domain category
--   isValueOnlyPredicate — recursive SetExpr walk; pre-classified leaves
--
-- TS-internal helpers (NOT ported — body would do degenerate intent-marker
-- shuffling per the 7c sub-step 2 / 7b sub-step 3 cost-benefit precedent):
--   isComparable, isValueVar, valueAggVar, aggCallFn — JS-shape predicates
--   over raw JSON Logic AST nodes. They stay in the TS marshaller (will
--   move into sub-step 2's whereToSetExpr marshaller).
-- ============================================================================

-- (CompToSetResult / Cts* — RETIRED, decide-substrate Phase 3. `compToSet` now
-- constructs the canonical `Se*` SetExpr DIRECTLY — a `.fenel` body CAN author
-- the registered `$tag` SetExpr constructors (SeAll / SeEnum / SeDiff /
-- SeInterval), so the intent-marker indirection + its TS `unmarshalCompToSetResult`
-- are unnecessary. The Cts*→Se* correspondence the markers encoded:
--   CtsAll              → SeAll
--   CtsEnum value       → SeEnum { values = [value] }
--   CtsDiffEnum value   → SeDiff { left = SeAll, right = SeEnum { values = [value] } }
--   CtsIntervalLo {value, incl} → SeInterval { interval = { lo = Just {value, inclusive}, hi = Nothing } }
--   CtsIntervalHi {value, incl} → SeInterval { interval = { lo = Nothing, hi = Just {value, inclusive} } }
-- is now inlined in setAlgebraCompToSetNonNumeric / -Numeric below.)

-- NamedDomain — value-domain category for built-in $named sets. The TS
-- unmarshaller maps:
--   NdNumber  → "number"
--   NdString  → "string"
--   NdBoolean → "boolean"
--   NdArray   → "array"
NamedDomain = NdNumber | NdString | NdBoolean | NdArray

-- ============================================================================
-- flipComp — comparison-op flip when the var is on the right.
-- ============================================================================
@label "set-algebra: flipComp"
@description "Phase 7c-continuation sub-step 1 — comparison-op string flip used by whereToSetExpr when the value-variable is on the right side of a comparison. `>=` ↔ `<=`, `>` ↔ `<`; other ops pass through unchanged. Mirrors implementations/typescript/engine/src/set-algebra.ts:flipComp."
@tags "engine" "set-algebra" "where-to-set-expr" "phase-7c"
flipComp : (op: String) -> String
flipComp op =
  if eq op ">=" then "<="
  else if eq op ">" then "<"
  else if eq op "<=" then ">="
  else if eq op "<" then ">"
  else op

-- ============================================================================
-- compToSet — emit a SetExpr-intent-marker from (op, value, varSide,
-- isNumeric). The TS marshaller pre-classifies `typeof value === "number"`
-- into `isNumeric: Bool`; the body uses `flipComp` for the varSide swap.
-- ============================================================================
@label "set-algebra: compToSet"
@description "Build the Aggregable output comparison set in the requested orientation. Equality/inequality keep their existing enum forms; native ordered or unsupported comparisons retain an exact residual SeWhere predicate. The numeric flag remains a boundary input, and Fenel owns the op flip and resulting set."
@tags "engine" "internal" "set-algebra" "aggregable" "phase-7c" "phase-3"
@category "engine-internal"
compToSet : (op: String) -> (value: Any) -> (varSide: String) -> (isNumeric: Boolean) -> SetExpr
compToSet op value varSide isNumeric =
  let eOp = if eq varSide "right" then flipComp op else op
  if not isNumeric
  then setAlgebraCompToSetNonNumeric eOp value
  else
    if startsWith eOp "="
    then setAlgebraCompToSetNonNumeric eOp value
    else
      if startsWith eOp "!"
      then setAlgebraCompToSetNonNumeric eOp value
      else setAlgebraCompToSetNumeric eOp value

@label "set-algebra: compToSetNonNumeric"
@description "Emit the existing equality/inequality output sets; unsupported comparison output shapes retain their actual predicate through the shared scalar-comparison fence instead of approximating them to SeAll."
@tags "engine" "internal" "set-algebra" "aggregable" "phase-3"
@category "engine-internal"
setAlgebraCompToSetNonNumeric : (eOp: String) -> (value: Any) -> SetExpr
setAlgebraCompToSetNonNumeric eOp value =
  if eq eOp "=="
  then SeEnum { values = [value] }
  else if eq eOp "==="
  then SeEnum { values = [value] }
  else if eq eOp "!="
  then SeDiff { left = SeAll, right = SeEnum { values = [value] } }
  else if eq eOp "!=="
  then SeDiff { left = SeAll, right = SeEnum { values = [value] } }
  else setAlgebraCompToSetNumeric eOp value

@label "set-algebra: compToSetNumeric"
@description "The scalar-comparison extraction fence for Aggregable output sets. A numeric interval also admits exact integer records, while the native comparison refuses those carriers; retain the actual comparison predicate as SeWhere instead of claiming an exact interval extraction."
@tags "engine" "internal" "set-algebra" "aggregable" "phase-3"
@category "engine-internal"
setAlgebraCompToSetNumeric : (eOp: String) -> (value: Any) -> SetExpr
setAlgebraCompToSetNumeric eOp value =
  let functionName = case opNotationToCodeName eOp of
    Just name -> name
    Nothing -> eOp
  SeWhere { pred = ECall { fnId = functionName, args = [EVar { name = "value" }, ELit { value = value }] } }

-- ============================================================================
-- namedDomain — value-domain category for built-in $named sets.
--
-- The TS marshaller pre-flags `inHierarchy: Bool` (whether the name is a
-- key in NAMED_HIERARCHY). The body uses startsWith / eq for the string
-- predicates that resolve domains for known atoms + prefix families
-- (format:* / list:* / multiple:* / char:* / str:*).
-- ============================================================================
@label "set-algebra: namedDomain"
@description "Phase 7c-continuation / floor-kernel Phase 3c soundness repair — value-domain category for built-in named sets. Prefix/whole-name facts run before the hierarchy fallback, so str:* remains string after its Subsumable migration; char:* remains Nothing because it accepts both numeric codepoints and one-character strings. Numeric/Bool/String hierarchy-only aliases then use the legacy hierarchy classifier. Boundary adapter."
@tags "engine" "set-algebra" "where-to-set-expr" "boundary" "phase-7c"
namedDomain : (name: String) -> (inHierarchy: Boolean) -> Maybe NamedDomain
namedDomain name inHierarchy =
  if elem name ["Rational", "ℚ", "Nat", "ℕ", "Int", "ℤ"]
  then Nothing
  else if startsWith name "char:"
  then Nothing
  else case setAlgebraNamedDomainFromName name of
    Just domain -> Just domain
    Nothing ->
      if inHierarchy
      then setAlgebraNamedDomainFromHierarchy name
      else Nothing

@label "set-algebra: namedDomainFromHierarchy"
@description "Phase 7c-continuation sub-step 1 — resolve domain for names in NAMED_HIERARCHY: Bool/Boolean → boolean; String/NonEmpty → string; otherwise number (number-tower aliases). Internal helper to namedDomain."
@tags "engine" "internal" "set-algebra" "where-to-set-expr" "phase-7c"
@category "engine-internal"
setAlgebraNamedDomainFromHierarchy : (name: String) -> Maybe NamedDomain
setAlgebraNamedDomainFromHierarchy name =
  if elem name ["Rational", "ℚ", "Nat", "ℕ", "Int", "ℤ"]
  then Nothing
  else if eq name "Bool"
  then Just (NdBoolean)
  else if eq name "Boolean"
  then Just (NdBoolean)
  else if eq name "String"
  then Just (NdString)
  else if eq name "NonEmpty"
  then Just (NdString)
  else Just (NdNumber)

@label "set-algebra: namedDomainFromName"
@description "Phase 7c-continuation sub-step 1 — resolve domain for names outside NAMED_HIERARCHY via prefix/whole-name predicates: Boolean/Number/Real/ℝ; format:* → string; list:* → array; multiple:* → number; char:* → Nothing (straddles domains); str:* → string; else Nothing. Internal helper to namedDomain."
@tags "engine" "internal" "set-algebra" "where-to-set-expr" "phase-7c"
@category "engine-internal"
setAlgebraNamedDomainFromName : (name: String) -> Maybe NamedDomain
setAlgebraNamedDomainFromName name =
  if eq name "Boolean"
  then Just (NdBoolean)
  else if eq name "Number"
  then Just (NdNumber)
  else if eq name "Real"
  then Just (NdNumber)
  else if eq name "ℝ"
  then Just (NdNumber)
  else if startsWith name "format:"
  then Just (NdString)
  else if startsWith name "list:"
  then Just (NdArray)
  else if startsWith name "multiple:"
  then Just (NdNumber)
  else if startsWith name "char:"
  then Nothing
  else if startsWith name "str:"
  then Just (NdString)
  else Nothing

-- ============================================================================
-- isValueOnlyPredicate — does this SetExpr's membership only depend on the
-- value itself (vs. an outer context)? Used by setEnumDecideDisjoint to
-- gate the "test each enum value against the predicate" path — predicates
-- referencing the outer context can't be soundly tested with the value
-- alone, so we'd falsely declare disjoint when we just lack information.
--
-- set-algebra-to-fenel Phase 3b-3 Step 1 (Deliverable 2, proof-of-pattern slice)
-- — RE-WIRED onto the registered `$tag` `SetExpr` entity ADT directly (the
-- `SetExprIsValueOnlyAdt` marshalled mirror is RETIRED; the TS marshaller
-- `marshalSetExprForIsValueOnly` deletes). The body reads the `Se*` cases: every
-- leaf except `SeWhere` is value-only; the structural compound arms recurse
-- (mEvery semantics — every branch must be value-only); a non-SetExpr point value
-- (the old SivoUnknown fall-through) is `false`. The `dispatchedIsValueOnly-
-- Predicate` wrapper feeds `setExprToTag(set)` so mixed-form input (a sibling
-- still-marshalled decider's `$`-key, or `unmarshalNormSetExpr`'s output)
-- normalizes to `$tag` first.
-- ============================================================================

@label "set-algebra: isValueOnlyPredicate"
@description "set-algebra-to-fenel 3b-3 Step 1 — does this SetExpr's membership only depend on the value itself (vs. an outer context)? Reads the registered `$tag` SetExpr ADT directly: every leaf except `SeWhere` is value-only; structural compound arms recurse via mEvery semantics; a non-SetExpr point value is false. Used by setEnumDecideDisjoint to gate the per-value test path. Mirrors implementations/typescript/engine/src/set-algebra.ts:isValueOnlyPredicate."
@tags "engine" "set-algebra" "where-to-set-expr" "phase-3b-3"
isValueOnlyPredicate : (set: SetExpr) -> Boolean
isValueOnlyPredicate set = case set of
  SeAll -> true
  SeNone -> true
  SeEnum {} -> true
  SeInterval {} -> true
  SeRef {} -> true
  SePattern {} -> true
  SeWhere {} -> false
  SeUnion { branches = bs } -> setAlgebraIsValueOnlyAll bs
  SeIntersect { branches = bs } -> setAlgebraIsValueOnlyAll bs
  SeDiff { left = a, right = b } ->
    if isValueOnlyPredicate a
    then isValueOnlyPredicate b
    else false
  SeComplement { inner = i } -> isValueOnlyPredicate i
  -- signature-substrate Phase 4 slice 3a — a rigid is NOT a value-only
  -- predicate. This gate lets the disjointness enum arm probe `other` per
  -- value through setAlgebraContains; membership at a rigid is undecided, so
  -- the probe must never start.
  SeRigid {} -> false
  _ -> false

-- mEvery semantics: every branch must be value-only.
@label "set-algebra: isValueOnlyAll"
@description "Phase 7c-continuation sub-step 1 — mEvery semantics for a list of SetExprIsValueOnlyAdt branches: every branch must be value-only. Internal helper to isValueOnlyPredicate ($union / $intersect arms)."
@tags "engine" "internal" "set-algebra" "where-to-set-expr" "phase-7c"
@category "engine-internal"
setAlgebraIsValueOnlyAll : (bs: List SetExpr) -> Boolean
setAlgebraIsValueOnlyAll bs = case head bs of
  Nothing -> true
  Just first ->
    if isValueOnlyPredicate first
    then case tail bs of
      Nothing -> true
      Just rest -> setAlgebraIsValueOnlyAll rest
    else false

-- ============================================================================
-- decide-substrate Phase 8μ.1a — the SeCtor faces (the 6D dt* term-theory's
-- SET-side mirror). `SeCtor c fs` = the values built by ctor `c` with field-i ∈
-- ⟦set-i⟧ (a variant projects to a SeUnion of its SeCtors; a record to a single
-- SeCtor with the synthetic ctor ""). The four faces each RE-READ a
-- theory-combine.fenel dt* rule set-side:
--   • EMPTY    — a product with an empty FACTOR is empty (nullary ⇒ a point).
--   • CONTAINS — v.$tag == c ∧ every field vᵢ ∈ ⟦set-i⟧ (§0.4 structural descent).
--   • DISJOINT — BOTH ctors NAMED and distinct ⇒ disjoint (dtConflict, :527 —
--                distinct $tags never structurally equal); otherwise — equal
--                ctors, OR either ctor the anonymous-record former "" —
--                fieldwise, some pair disjoint (type-substrate P1(a): `""` is
--                NOT a tag, membership is `""`-agnostic, and the old blanket
--                distinct-ctor rule was FALSE on the everyday `$record`-meets-
--                variant-case pair).
--   • SUBSET   — same ctor ∧ want-side fieldwise ⊆ (dtDerive injectivity, :572 —
--                the covariant rule that drives List Int ⊆ List Number); a
--                distinct NAMED want-ctor ⇒ NOT subset unless the sub is empty;
--                a `""` WANT-ctor skips the tag leg entirely and goes fieldwise.
-- Field pairs are matched by FieldKey (order-independent). `wireName` is NOT the
-- identity — but it is NOT excluded from relations either (type-substrate P1(a)):
-- the faces read the RESOLVED wire (`seCtorFieldReadWire` — the registry's CURRENT
-- projection, embedded hint only as the fallback), an aligned pair whose resolved
-- wires DISAGREE abstains, and two fields resolving to ONE host property put the
-- operand outside the fence. Reading different host properties is a semantic
-- difference, so pretending the wire is inert was itself a source of false Justs.
-- COERCING-CTOR EXCLUSION (dtCoercingCtor, theory-combine.fenel:466): `construct`
-- coerces ONLY True/False to a native rep (the permanent ledger-B5 arm), so a
-- coercing SeCtor cannot ride the $tag-keyed rules — every face guards it and
-- degrades to Nothing (Bool stays the {true,false} enum — type-to-set.fenel; the
-- projection never emits a `SeCtor "True"`, the guard is the belt-and-braces).
-- ============================================================================

@label "set-algebra: ctorCoercing"
@description "decide-substrate Phase 8μ.1a — true for a constructor name whose `construct` COERCES to a native rep (exactly True/False — the permanent ledger-B5 Bool arm). Mirrors theory-combine.fenel:dtCoercingCtor. A coercing SeCtor cannot ride the $tag-keyed SeCtor rules ⇒ every face degrades it to Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "decide-substrate" "phase-8mu"
@category "engine-internal"
seCtorCoercing : (c: String) -> Boolean
seCtorCoercing c = or (eq c "True") (eq c "False")

@label "set-algebra: ctorNotRecord"
@description "decide-substrate Phase 8μ.1a — true when a value is an array / null / number / string / boolean (a scalar, never a constructed record) ⇒ it inhabits no SeCtor. Guards the dynamic record reads in the membership face. Mirrors dtLitTag's scalar pre-guards. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "decide-substrate" "phase-8mu"
@category "engine-internal"
seCtorNotRecord : (v: Any) -> Boolean
seCtorNotRecord v = or (isArray v) (or (isNull v) (or (isNumber v) (or (isString v) (isBoolean v))))

@label "set-algebra: ctorValueTag"
@description "decide-substrate Phase 8μ.1a — a record value's `$tag` string (read through the dynamic-key `mapGet` boundary), or \"\" when absent / non-string. The membership face's tag-discriminator read. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "decide-substrate" "phase-8mu"
@category "engine-internal"
seCtorValueTag : (v: {}) -> String
seCtorValueTag v =
  case mapGet v "$tag" of
    Just tag -> if isString tag then toString tag else ""
    Nothing -> ""

@label "set-algebra: ctorFieldValue"
@description "decide-substrate Phase 8μ.1a / field-identity Phase 3 — read one host-object property by the slot's current wireName (Just value / Nothing when absent). The projection is never used as semantic identity. Internal helper to the membership face."
@tags "engine" "internal" "set-algebra" "sector" "decide-substrate" "phase-8mu"
@category "engine-internal"
seCtorFieldValue : (v: {}) -> (wireName: String) -> Maybe Any
seCtorFieldValue v wireName = mapGet v wireName

@label "set-algebra: ctorFindField"
@description "decide-substrate Phase 8μ.1a / field-identity Phase 3 — find a SetCtorField by semantic FieldKey (Just / Nothing), independent of field order and wire spelling. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "decide-substrate" "phase-8mu"
@category "engine-internal"
seCtorFindField : (fs: List SetCtorField) -> (key: FieldKey) -> Maybe SetCtorField
seCtorFindField fs key = case head fs of
  Nothing -> Nothing
  Just f -> if fieldKeyEq f.key key then Just f else seCtorFindField (eufRest fs) key

@label "set-algebra: wireReserved"
@description "type-substrate P1(a) — the JUDGMENT-side reserved wire set. A field whose RESOLVED wire projection collides with a host axis the faces already read out-of-band ($tag, the membership discriminator) or with the callable-union sentinels the SeArrow face classifies on ($ref / __fenelPartial / __fenelFn, json-logic.ts isCallableValue) is REFUSED by the SeCtor faces: such a field would make the ctor's field product and the tag/sort axis the same coordinate, and every product rule here assumes they are independent. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "field-identity" "type-substrate" "phase-1a"
@category "engine-internal"
seWireReserved : (wire: String) -> Boolean
seWireReserved wire =
  or (eq wire "$tag") (or (eq wire "$ref") (or (eq wire "__fenelPartial") (eq wire "__fenelFn")))

@label "set-algebra: ctorWiresOk"
@description "type-substrate P1(a) — the resolved-wire walk behind seCtorFieldsFenceOk: no field's RESOLVED wire is reserved, and no two fields in the SAME operand resolve to the SAME host property. The shared slot validator dedups the EMBEDDED wireName only, while membership reads the resolved wire (the D4 discipline), so two distinct semantic keys can alias onto one host coordinate and break the independence the product rules assume. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "field-identity" "type-substrate" "phase-1a"
@category "engine-internal"
seCtorWiresOk : (fs: List SetCtorField) -> (seen: List String) -> Boolean
seCtorWiresOk fs seen = case head fs of
  Nothing -> true
  Just f ->
    let wire = seCtorFieldReadWire f
    if seWireReserved wire then false
    else if elem wire seen then false
    else seCtorWiresOk (eufRest fs) (appendItem wire seen)

@label "set-algebra: ctorFieldsFenceOk"
@description "type-substrate P1(a) — the SeCtor faces' JUDGMENT FENCE: the shared identity-total slot validation (fieldSemanticSlotsValid) AND no reserved resolved wire AND resolved-wire injectivity within the operand. Decider-local ON PURPOSE: fieldSemanticSlotsError also serves validate.fenel / type-traversal / type-algebra / normalise-to-core, and this is a judgment fence, not an authoring ban. SCOPE, stated precisely because every looser version is false: it is the precondition of every DIRECT SeCtor tag/product face WHEN THAT FACE IS REACHED — setAlgebraCtorContains / CtorEmpty / CtorDisjoint / SubsetCtorArm / MuSubCtorCtor — which therefore cannot disagree with one another. It is NOT a precondition of every verdict whose operand happens to BE a SeCtor, and not even of every verdict that inspects ctor fields: the connective identities and the outer equality shortcuts decide ABOVE it (b=SeAll ⇒ Just true; b=SeNone ⇒ disjoint Just true; a=SeNone ⇒ Just true; and reflexivity via setSemanticEq, so a fenced R still gives subset(¬R,¬R) = Just true, subset(μX.R,μX.R) = Just true and normalize(R∖R) = SeNone). Every one of those is correct for EVERY set including the empty one, so none of them is a face disagreement. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "field-identity" "type-substrate" "phase-1a"
@category "engine-internal"
seCtorFieldsFenceOk : (fs: List SetCtorField) -> Boolean
seCtorFieldsFenceOk fs =
  if not (fieldSemanticSlotsValid fs) then false else seCtorWiresOk fs []

@label "set-algebra: ctorFieldReadWire"
@description "field-identity Phase 4 (D4) — the host-read projection of one SetCtorField: when the semantic key resolves in the process registry (the fieldKeyCurrentWire ctx-native), the CURRENT wire projection wins over the persisted-frozen `wireName`; an unknown key (draft / cross-registry payload / positional axis) falls back to the embedded wireName as a codec hint. Persisted-SetExpr wire staleness therefore cannot flip membership for registry-known fields — rename-robust without data rewrites (the persisted-row rewrite decision stays with versioning / Phase 5). Internal helper to the membership face."
@tags "engine" "internal" "set-algebra" "sector" "decide-substrate" "field-identity" "phase-4"
@category "engine-internal"
seCtorFieldReadWire : (f: SetCtorField) -> String
seCtorFieldReadWire f =
  case fieldKeyCurrentWire f.key of
    Just wire -> wire
    Nothing -> f.wireName

-- ── MEMBERSHIP ─────────────────────────────────────────────────────────────
@label "set-algebra: ctorContains"
@description "decide-substrate Phase 8μ.1a — the SeCtor membership face: a host array against a constructor set an array could represent (the names Nil and Cons, and the anonymous record former \"\") ⇒ Nothing (the List host carrier is outside the canonical domain this face is sound over: runtime pattern matching never reads an array as Nil or Cons, so a verdict here could contradict execution — tcb-ledger row mem.ctor); against any other constructor name ⇒ Just false; any other scalar value ⇒ Just false; a coercing ctor ⇒ Nothing; a synthetic record ctor (\"\") skips the tag check; else the value's `$tag` must equal `c` (mismatch / absent ⇒ Just false); then every field value must be ∈ its field set (mEvery via setAlgebraContains; a missing field ⇒ Just false). The §0.4 structural-descent leaf, set-side. Internal helper to setAlgebraContains."
@tags "engine" "internal" "set-algebra" "sector" "contains" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorContains : (c: String) -> (fs: List SetCtorField) -> (value: Any) -> Maybe Boolean
setAlgebraCtorContains c fs value =
  if not (seCtorFieldsFenceOk fs) then Nothing
  else if seCtorCoercing c then Nothing
  else if isArray value then (if or (eq c "") (or (eq c "Nil") (eq c "Cons")) then Nothing else Just false)
  else if seCtorNotRecord value then Just false
  else if eq c "" then setAlgebraCtorFields fs value false
  else if not (eq (seCtorValueTag value) c) then Just false
  else setAlgebraCtorFields fs value false

@label "set-algebra: ctorFields"
@description "decide-substrate Phase 8μ.1a / field-identity Phase 4 (D4) — mEvery over a SeCtor's fields for membership: for each SetCtorField read the value's field through seCtorFieldReadWire (key→CURRENT wire when the registry knows the key; embedded wireName fallback; missing ⇒ Just false — shape mismatch) then setAlgebraContains its set; any Just false ⇒ Just false; all Just true ⇒ Just true; any Nothing (no Just false) ⇒ Nothing. Internal helper to setAlgebraCtorContains."
@tags "engine" "internal" "set-algebra" "sector" "contains" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorFields : (fs: List SetCtorField) -> (value: {}) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraCtorFields fs value sawNothing = case head fs of
  Nothing -> if sawNothing then Nothing else Just true
  Just f ->
    case seCtorFieldValue value (seCtorFieldReadWire f) of
      Nothing -> Just false
      Just fv ->
        case setAlgebraContains f.set fv of
          Just false -> Just false
          Just true -> setAlgebraCtorFields (eufRest fs) value sawNothing
          Nothing -> setAlgebraCtorFields (eufRest fs) value true

-- ── EMPTINESS ──────────────────────────────────────────────────────────────
@label "set-algebra: ctorEmpty"
@description "decide-substrate Phase 8μ.1a — the SeCtor emptiness face: a coercing ctor ⇒ Nothing; else empty iff SOME field set is empty (a product with an empty factor is empty). Nullary (fs==[]) ⇒ Just false (a point). Fold via setAlgebraCtorEmptyLoop. Internal helper to setAlgebraDecideEmptyCore."
@tags "engine" "internal" "set-algebra" "sector" "empty" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorEmpty : (c: String) -> (fs: List SetCtorField) -> Maybe Boolean
setAlgebraCtorEmpty c fs =
  if not (seCtorFieldsFenceOk fs) then Nothing
  else if seCtorCoercing c then Nothing
  else setAlgebraCtorEmptyLoop fs false

@label "set-algebra: ctorEmptyLoop"
@description "decide-substrate Phase 8μ.1a — the emptiness fold over a SeCtor's field sets (setAlgebraDecideEmpty per field): any Just true ⇒ Just true (empty factor ⇒ empty product); all Just false ⇒ Just false (all factors nonempty ⇒ nonempty, incl. the nullary point); any Nothing (no Just true) ⇒ Nothing. Internal helper to setAlgebraCtorEmpty."
@tags "engine" "internal" "set-algebra" "sector" "empty" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorEmptyLoop : (fs: List SetCtorField) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraCtorEmptyLoop fs sawNothing = case head fs of
  Nothing -> if sawNothing then Nothing else Just false
  Just f ->
    case setAlgebraDecideEmpty f.set of
      Just true -> Just true
      Just false -> setAlgebraCtorEmptyLoop (eufRest fs) sawNothing
      Nothing -> setAlgebraCtorEmptyLoop (eufRest fs) true

-- ── DISJOINTNESS ───────────────────────────────────────────────────────────
@label "set-algebra: ctorDisjoint"
@description "decide-substrate Phase 8μ.1a / field-identity Phase 3 / type-substrate P1(a) — the SeCtor∩SeCtor disjointness face (dtConflict distinctness set-side): either side outside the judgment fence (seCtorFieldsFenceOk) or a coercing ctor ⇒ Nothing; BOTH ctors NAMED and distinct ⇒ Just true (distinct $tags never structurally equal); otherwise — equal ctors, OR either ctor the anonymous-record former \"\" — fieldwise. The \"\"-vs-named leg was Just true and was FALSE: membership is \"\"-agnostic, so a named-tag value satisfying the fields inhabits both. The datatype theory already had this right (dtConflict/dtTaggedEntries drop empty tags before the distinctness scan, theory-combine.fenel:520); this face was the sloppy copy. The fieldwise call SEEDS sawNothing with the width-asymmetry bit — an asymmetric pair can never claim overlap. Internal helper to setAlgebraDisjointArm."
@tags "engine" "internal" "set-algebra" "sector" "disjoint" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorDisjoint : (ac: String) -> (afs: List SetCtorField) -> (bc: String) -> (bfs: List SetCtorField) -> Maybe Boolean
setAlgebraCtorDisjoint ac afs bc bfs =
  if or (not (seCtorFieldsFenceOk afs)) (not (seCtorFieldsFenceOk bfs)) then Nothing
  else if or (seCtorCoercing ac) (seCtorCoercing bc) then Nothing
  else if and (not (eq ac bc)) (and (not (eq ac "")) (not (eq bc ""))) then Just true
  else setAlgebraCtorFieldwiseDisjoint afs bfs (not (eq (length afs) (length bfs)))

@label "set-algebra: ctorFieldwiseDisjoint"
@description "decide-substrate Phase 8μ.1a / field-identity Phase 3 / type-substrate P1(a) — fieldwise disjointness: disjoint iff SOME FieldKey-aligned pair is disjoint. Any Just true ⇒ Just true; all-overlap ⇒ Just false ONLY when nothing was tracked AND the widths agreed (the caller seeds sawNothing with the width-asymmetry bit) — the old unconditional terminal never saw b-only keys, so a b-only ∅ field (which makes b EMPTY, hence genuinely disjoint) was answered Just false; a semantic key absent on b, or an aligned pair whose RESOLVED wires disagree, ⇒ track (the ∃ leg must not fire on a divergent pair either: two fields that read DIFFERENT host properties are not competing for one coordinate, so `SeCtor(\"P\",[K@x:{1}])` vs `SeCtor(\"P\",[KU@y:{2}])` is NOT disjoint — `{$tag:\"P\", x:1, y:2}` inhabits both). PRICED PRECISION LOSS, named rather than hidden: the guard is SYMMETRIC, so a divergent pair also blocks the all-overlap `Just false`, which was CORRECT on that pair for exactly the same reason (independent coordinates are jointly satisfiable). Recovering it would need a per-divergent-pair emptiness check — an empty set on either side makes its operand empty and the ctors genuinely disjoint — which is not worth the rule. Abstaining is the conservative side of the Tri. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "disjoint" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorFieldwiseDisjoint : (afs: List SetCtorField) -> (bfs: List SetCtorField) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraCtorFieldwiseDisjoint afs bfs sawNothing = case head afs of
  Nothing -> if sawNothing then Nothing else Just false
  Just af ->
    case seCtorFindField bfs af.key of
      Nothing -> setAlgebraCtorFieldwiseDisjoint (eufRest afs) bfs true
      Just bf ->
        if not (eq (seCtorFieldReadWire af) (seCtorFieldReadWire bf))
        then setAlgebraCtorFieldwiseDisjoint (eufRest afs) bfs true
        else case setAlgebraIsDisjoint af.set bf.set of
          Just true -> Just true
          Just false -> setAlgebraCtorFieldwiseDisjoint (eufRest afs) bfs sawNothing
          Nothing -> setAlgebraCtorFieldwiseDisjoint (eufRest afs) bfs true

-- ── CONTAINMENT ────────────────────────────────────────────────────────────
@label "set-algebra: subsetCtorArm"
@description "decide-substrate Phase 8μ.1a / 8μ.3 — the SeCtor ⊆ b face (dtDerive injectivity set-side). b a SeCtor ⇒ setAlgebraCtorSubsetCtor; b a SeWhere ⇒ the 8μ.3 ∀-INTRO arm (setAlgebraCtorSubsetWhere — symbolic validity over the ctor's field domains; Nothing falls through to the tail rules so the whereExtract path is preserved); b anything else (SeUnion of SeCtors / eq fallback) ⇒ setAlgebraSubsetTailRules (a ⊆ some branch). Internal helper to setAlgebraDecideLeafSubset."
@tags "engine" "internal" "set-algebra" "sector" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraSubsetCtorArm : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetCtorArm a b = case a of
  SeCtor { ctor = ac, fields = afs } ->
    if not (seCtorFieldsFenceOk afs) then Nothing
    else case b of
      SeCtor { ctor = bc, fields = bfs } ->
        if not (seCtorFieldsFenceOk bfs)
        then Nothing
        else if or (seCtorCoercing ac) (seCtorCoercing bc)
        then Nothing
        else setAlgebraCtorSubsetCtor a ac afs bc bfs
      SeWhere { pred = _ } ->
        case setAlgebraCtorSubsetWhere a b of
          Just r -> Just r
          Nothing -> setAlgebraSubsetTailRules a b
      _ -> setAlgebraSubsetTailRules a b
  _ -> Nothing

@label "set-algebra: ctorSubsetCtor"
@description "decide-substrate Phase 8μ.1a / type-substrate P1(a) — SeCtor a ⊆ SeCtor b: a decidably empty ⇒ Just true (∅ ⊆ b); a NAMED want-ctor distinct from ac ⇒ Just false when a is decidably NONEMPTY (a's field product is tag-independent under the judgment fence, so an inhabited a admits a member with any tag ∉ {bc}), else Nothing; a want-ctor of \"\" — the anonymous-record former — SKIPS the tag leg entirely and goes fieldwise (a \"\" want constrains fields only; the old distinct-tag refutation was FALSE here, and \"\" is the CANONICAL $record projection, not a fringe operand); same ctor ⇒ fieldwise. Just false ⇒ Just false only when a is decidably nonempty (else Nothing — a maybe-empty a is still ⊆). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorSubsetCtor : (a: SetExpr) -> (ac: String) -> (afs: List SetCtorField) -> (bc: String) -> (bfs: List SetCtorField) -> Maybe Boolean
setAlgebraCtorSubsetCtor a ac afs bc bfs =
  let emptyA = setAlgebraDecideEmpty a
  case emptyA of
    Just true -> Just true
    _ ->
      if and (not (eq ac bc)) (not (eq bc ""))
      then case emptyA of
        Just false -> Just false
        _ -> Nothing
      else
        let fw = setAlgebraCtorFieldwiseSubset afs bfs false
        case fw of
          Just true -> Just true
          Just false -> case emptyA of
            Just false -> Just false
            _ -> Nothing
          Nothing -> Nothing

@label "set-algebra: ctorFieldwiseSubset"
@description "decide-substrate Phase 8μ.1a / field-identity Phase 3 / type-substrate P1(a) — fieldwise ⊆, iterated over the WANT side: for every b-field find the a-field carrying the same semantic key and decide af.set ⊆ bf.set. The loop ran over the HAVE side before, so want-only fields were never examined and a tag-only have vacuously proved (`Pt{} ⊆ Pt{x:{1}}` ⇒ Just true, FALSE). Now: a want key ABSENT on the have side ⇒ track (never decide — the Se face has no \"members lack this key\" fact, so Nothing is the only honest absence verdict, which subsumes the Tt missing-key ambiguity discipline a fortiori); an aligned pair whose RESOLVED wires disagree ⇒ track; Just false ⇒ Just false (the caller's a-nonempty gate realizes the refutation); all Just true ⇒ Just true. Have-only keys are never inspected — under open membership an extra have constraint only shrinks a (resolved-wire injectivity, enforced by the fence, is what makes the coordinates independent). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorFieldwiseSubset : (afs: List SetCtorField) -> (bfs: List SetCtorField) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraCtorFieldwiseSubset afs bfs sawNothing = case head bfs of
  Nothing -> if sawNothing then Nothing else Just true
  Just bf ->
    case seCtorFindField afs bf.key of
      Nothing -> setAlgebraCtorFieldwiseSubset afs (eufRest bfs) true
      Just af ->
        if not (eq (seCtorFieldReadWire af) (seCtorFieldReadWire bf))
        then setAlgebraCtorFieldwiseSubset afs (eufRest bfs) true
        else case setAlgebraIsSubset af.set bf.set of
          Just false -> Just false
          Just true -> setAlgebraCtorFieldwiseSubset afs (eufRest bfs) sawNothing
          Nothing -> setAlgebraCtorFieldwiseSubset afs (eufRest bfs) true

-- ============================================================================
-- decide-substrate Phase 8λ.1 — the SeArrow (exponential / function-signature)
-- faces: EMPTINESS (the exponential law), CONTAINMENT (variance), MEMBERSHIP
-- (INTENSIONAL — signature subsumption over named/`{$ref}`/partial fn values;
-- closures & effectful fns ⇒ Nothing — the honest fence). design/arrow-synthesis.md.
--
-- The two shipped `Tt*` faces (containment.fenel `arrowSub` :1112 + `emptyArrow`
-- :1469) stay the tri-precision FAST BRANCH over the marshalled type tree; these
-- SetExpr-judgment arms are the GENERAL path that ADDS membership + inhabitation
-- and must AGREE with them where both decide (the F differential — the 8μ.2
-- `Tt*` reconciliation posture).
-- ============================================================================

-- ── EMPTINESS (the exponential law) ─────────────────────────────────────────
-- (Tri combinators: the SeArrow faces reuse containment.fenel's `mAnd` /
-- `emptyList` by bare name — same `module engine where` union, the
-- inhabit→substSet / deciders→whereExtract cross-file precedent. The 8λ.1-r
-- review folded the initially-minted local twins seArrowMAnd/arrowListEmpty.)
@label "set-algebra: arrowEmpty"
@description "decide-substrate Phase 8λ.1 — the SeArrow emptiness face (the exponential law, mirror containment.fenel:emptyArrow): `empty(P1→…→Pn→R) ⟺ empty(R) ∧ every param inhabited` — a param decidably EMPTY ⇒ the vacuous fn inhabits ⇒ NOT empty; R inhabited ⇒ constant fns inhabit ⇒ NOT empty. mAnd (decideEmpty R) (all-params-inhabited). Sound both directions. Internal helper to setAlgebraDecideEmptyCore."
@tags "engine" "internal" "set-algebra" "arrow" "empty" "decide-substrate" "phase-8lambda"
@category "engine-internal"
setAlgebraArrowEmpty : (ps: List SetArrowParam) -> (r: SetExpr) -> Maybe Boolean
setAlgebraArrowEmpty ps r =
  if not (fieldSemanticSlotsValid ps)
  then Nothing
  else
    let emptyR = setAlgebraDecideEmpty r
    let allInhab = arrowParamsInhab ps false
    mAnd emptyR allInhab

@label "set-algebra: arrowParamsInhab"
@description "decide-substrate Phase 8λ.1 — the all-params-inhabited Kleene-AND fold for setAlgebraArrowEmpty: a param decidably EMPTY ⇒ Just false (not-all-inhabited — the vacuous-fn escape); all params decidably nonempty ⇒ Just true (an empty param list ⇒ Just true — a thunk ()→R is empty iff R is); any undecided ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "empty" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowParamsInhab : (ps: List SetArrowParam) -> (sawNothing: Boolean) -> Maybe Boolean
arrowParamsInhab ps sawNothing = case head ps of
  Nothing -> if sawNothing then Nothing else Just true
  Just p ->
    case setAlgebraDecideEmpty p.set of
      Just true -> Just false
      Just false -> arrowParamsInhab (eufRest ps) sawNothing
      Nothing -> arrowParamsInhab (eufRest ps) true

-- ── CONTAINMENT (variance) ──────────────────────────────────────────────────
@label "set-algebra: subsetArrowArm"
@description "decide-substrate Phase 8λ.1 / 8λ.1-r / 8λ.2-r — the SeArrow ⊆ b face, EMPTINESS-GATED on BOTH SIDES: (1) 8λ.2-r — a b-arrow with SOME param domain decidably EMPTY ⇒ Just true UNCONDITIONALLY (the WANT-side vacuous dual of the 8λ.1-r have-side gate: ∀x∈∅ holds for every callable, so an empty-domain arrow set contains ALL callables ⊇ any arrow set's members — mirrored on the Tt* arrowSub); (2) a decidably-EMPTY have-arrow ⇒ Just true (∅ ⊆ b — the exponential law; refuting on arity was the 8λ.1-r find); else the variance verdict, with a Just-false REFUTATION gated on the have-arrow being decidably NONEMPTY (a maybe-empty have is still ⊆ — honest Nothing). b a non-SeArrow ⇒ Nothing (the leaf-subset dispatch falls to the tail rules). Internal helper to setAlgebraDecideLeafSubset."
@tags "engine" "internal" "set-algebra" "arrow" "subset" "decide-substrate" "phase-8lambda"
@category "engine-internal"
setAlgebraSubsetArrowArm : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraSubsetArrowArm a b =
  if not (eq (seTag b) "SeArrow") then Nothing
  else if not (fieldSemanticSlotsValid a.params) then Nothing
  else if not (fieldSemanticSlotsValid b.params) then Nothing
  else if arrowSomeParamEmpty b.params then Just true
  else
    let emptyA = setAlgebraDecideEmpty a
    case emptyA of
      Just true -> Just true
      _ ->
        let af = arrowFlatten a
        let bf = arrowFlatten b
        case setAlgebraArrowSubAligned af bf of
          Just true -> Just true
          Just false -> case emptyA of
            Just false -> Just false
            _ -> Nothing
          Nothing -> Nothing

@label "set-algebra: arrowFlatten"
@description "decide-substrate Phase 8λ.2-r — CURRY-NORMALIZE a SeArrow: while the codomain is itself a SeArrow, pull its params up (`SeArrow ps (SeArrow qs r)` ⇒ `SeArrow (ps++qs) r`). Sound at the VALUE-SET level because Fenel's calling convention curries both ways (under-application yields a partial, over-application spills onto a callable result — probe-verified json-logic.ts:1871/:1887), so the flat and curried spellings denote the SAME set of function values. Non-SeArrow ⇒ unchanged. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowFlatten : (s: SetExpr) -> SetExpr
arrowFlatten s = case s of
  SeArrow { params = ps, returns = r } ->
    case r of
      SeArrow { params = qs, returns = rr } ->
        let ps2 = concat ps qs
        let s2 = SeArrow { params = ps2, returns = rr }
        arrowFlatten s2
      _ -> s
  _ -> s

@label "set-algebra: arrowSubAligned"
@description "decide-substrate Phase 8λ.2-r — the subset verdict over two FLATTENED arrows: EQUAL arities ⇒ the variance core (contravariant params / covariant return — a flat-vs-curried pair that aligns after flattening now decides variance instead of falsely refuting on written arity: ⟦(A,B)→C⟧ = ⟦(A)→((B)→C)⟧ under the currying calling convention); arities STILL mismatched after flattening ⇒ the callable-tail refutation: a longer-have (na>nb) member applied to nb args is a PARTIAL — a callable — so a provably CALLABLE-FREE b-codomain refutes; a shorter-have (na<nb) member's value after na args lies in the have-codomain — provably CALLABLE-FREE ⇒ it cannot absorb b's remaining args (over-application onto a non-callable is declared-semantics UB; the runtime's silent arg-drop is a fenced quirk, not semantics) ⇒ refutes; both gated on b's params decidably NONEMPTY (else the ∀ may be vacuous — the gate the b-vacuous Just-true above makes near-complete) — else Nothing. NOTE the raw refutation here still rides the caller's have-NONEMPTY gate (setAlgebraSubsetArrowArm). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "subset" "decide-substrate" "phase-8lambda"
@category "engine-internal"
setAlgebraArrowSubAligned : (af: SetExpr) -> (bf: SetExpr) -> Maybe Boolean
setAlgebraArrowSubAligned af bf =
  let na = length af.params
  let nb = length bf.params
  if eq na nb then setAlgebraArrowSub af.params af.returns bf.params bf.returns
  else if not (checkAllParamsNonempty bf.params) then Nothing
  else if gt na nb then
    if checkCallableFree bf.returns then Just false else Nothing
  else
    if checkCallableFree af.returns then Just false else Nothing

@label "set-algebra: arrowSub"
@description "decide-substrate Phase 8λ.1 — the UNGATED variance core: (aps→ar) ⊆ (bps→br) iff params CONTRAVARIANT (want-params bps ⊆ have-params aps, pairwise) AND return COVARIANT (have-return ar ⊆ want-return br). Arity mismatch ⇒ Just false (mirror containment.fenel:arrowSub/paramsSub — the agreement gate). NOTE the Just-false here is the raw variance verdict — the SUBSET consumer (setAlgebraSubsetArrowArm) must emptiness-gate it (∅ ⊆ b regardless of variance); the MEMBERSHIP consumer (arrowSigMembership) needs NO gate (for a specific value's signature the conjunction is the literal membership condition). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "subset" "decide-substrate" "phase-8lambda"
@category "engine-internal"
setAlgebraArrowSub : (aps: List SetArrowParam) -> (ar: SetExpr) -> (bps: List SetArrowParam) -> (br: SetExpr) -> Maybe Boolean
setAlgebraArrowSub aps ar bps br =
  let pOk = setAlgebraArrowParamsSub bps aps
  let rOk = setAlgebraIsSubset ar br
  mAnd pOk rOk

@label "set-algebra: arrowParamsSub"
@description "decide-substrate Phase 8λ.1 — the contravariant pairwise param fold for setAlgebraArrowSub: zip the two param lists, subset (want-param-set) ⊆ (have-param-set) at each position (callers pass want-params first ⇒ contravariant); arity mismatch ⇒ Just false; both exhausted ⇒ Just true (emptyList — containment.fenel's arity-exhaustion check, bare-name same-module reuse). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "subset" "decide-substrate" "phase-8lambda"
@category "engine-internal"
setAlgebraArrowParamsSub : (wps: List SetArrowParam) -> (hps: List SetArrowParam) -> Maybe Boolean
setAlgebraArrowParamsSub wps hps = case head wps of
  Nothing -> emptyList hps
  Just wp ->
    case head hps of
      Nothing -> Just false
      Just hp -> mAnd (setAlgebraIsSubset wp.set hp.set) (setAlgebraArrowParamsSub (eufRest wps) (eufRest hps))

-- ── MEMBERSHIP (intensional — by signature/type) ────────────────────────────
-- The value shapes are the Ref substrate's callable union (json-logic.ts:
-- isCallableValue): a `{$ref}` reference / a `{__fenelPartial}` partial / a
-- `{__fenelFn}` closure. A bare string is NOT a callable value (typed-fn-refs
-- Phase 5). None carry `$tag`. Membership for named/ref/partial reduces to the
-- signature subset (via the `fnTypeMarker` ctx-native — resolve the fnId → its
-- registered arrow signature → the shared TraversalType); a closure ⇒ Nothing (the 8λ.2
-- CHECK face); an effectful referent ⇒ Nothing (fnTypeMarker's `pure=false`);
-- a bare string / non-record ⇒ Nothing. The classification is PURE (`mapGet`
-- own-property reads — the closure/plain-record arm returns Nothing WITHOUT calling
-- the ctx-native, so the kernel re-check of a const-witness closure is ctx-safe).
@label "set-algebra: arrowContains"
@description "decide-substrate Phase 8λ.1 / 8λ.1-r — the SeArrow membership face: dispatch on the value shape (dynamic-key `mapGet` own-property reads — pure; the callable union is DEFINITIONALLY json-logic.ts:isCallableValue — closure/partial/{$ref}). A bare STRING ⇒ Nothing (not a callable value post typed-fn-refs P5, but legacy persisted data may still carry name-strings in fn slots — the honest compat fence); any OTHER scalar / array / null ⇒ Just false (a number is never callable — the SeCtor scalar-refutation precedent, 8λ.1-r precision); a `{$ref}` ⇒ arrowRefContains (signature subsumption via fnTypeMarker); a `{__fenelPartial}` ⇒ arrowPartialContains (residual signature = drop the collected leading params); a `{__fenelFn}` closure / any other record ⇒ Nothing (the 8λ.2 CHECK face; a future callable rep / opaque Id-handle stays un-refuted). Internal helper to setAlgebraContains."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
setAlgebraArrowContains : (goalArrow: SetExpr) -> (value: a) -> Maybe Boolean
setAlgebraArrowContains goalArrow value =
  if not (fieldSemanticSlotsValid goalArrow.params) then Nothing
  else if isString value then Nothing
  else if seCtorNotRecord value then Just false
  else
    case mapGet value "$ref" of
      Just refId -> arrowRefContains refId goalArrow
      Nothing ->
        case mapGet value "__fenelPartial" of
          Just _ -> arrowPartialContains value goalArrow
          Nothing ->
            case mapGet value "__fenelFn" of
              Just _ -> arrowClosureContains value goalArrow
              Nothing -> Nothing

@label "set-algebra: arrowClosureContains"
@description "decide-substrate Phase 8λ.2 / 8λ.2-r / 8λ.5 — a `{__fenelFn}` lambda CLOSURE's SeArrow membership (the 8λ.1 GAP flip): the closure type-CHECKS through the trusted CHECK judgment. Read `params` (a list of param-name strings) + `body` (raw JSON-Logic) through dynamic-key `mapGet` own-property reads; lift the body to a core Expr (bodyToExpr — the D1 marshal seam); REBUILD the term as an `ELambda` and hand the WHOLE membership question to `checkExpr` against the goal arrow (8λ.2-r SUBSUMPTION: the previous duplicated arity-check + param-bind here missed the vacuous-domain gate and falsely refuted on curried arities — checkLambda now owns arity/vacuous/curry/shadowing in ONE place; check.fenel, bare-name same-module reuse). 8λ.5: an OPTIONAL `fix` envelope slot (a non-empty string — the recursion self-name; the fix-marked closure the recursion synthesizer emits and the invoke self-bind executes) routes to `checkExprFix` — the chk.fix rule (premise + structural-descent side condition); ABSENT or non-string ⇒ the plain `checkExpr` route, byte-preserved. A body whose lift fences / a non-SeArrow goal ⇒ Nothing. Closure CAPTURES are not bound (a free body var ⇒ honest Nothing — the documented v1 fence). THIS is what makes type-checking a lambda kernel-reachable: the kernel witness rule re-checks `{closure} ⊆ SeArrow` through this arm. Internal helper to setAlgebraArrowContains."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "check" "fix" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowClosureContains : (value: {}) -> (goalArrow: SetExpr) -> Maybe Boolean
arrowClosureContains value goalArrow =
  if not (eq (seTag goalArrow) "SeArrow") then Nothing
  else
    case mapGet value "params" of
      Nothing -> Nothing
      Just ps ->
        case mapGet value "body" of
          Nothing -> Nothing
          Just body ->
            case bodyToExpr body of
              Just e ->
                let lam = ELambda { params = ps, body = e }
                case mapGet value "fix" of
                  Just fixName ->
                    if isString fixName then checkExprFix (toString fixName) lam [] goalArrow
                    else checkExpr lam [] goalArrow
                  Nothing -> checkExpr lam [] goalArrow
              Nothing -> Nothing

@label "set-algebra: arrowRefContains"
@description "decide-substrate Phase 8λ.1 — a `{$ref: id}` value's SeArrow membership: id must be a String ⇒ arrowIdMembership id 0 (no dropped params — a bare reference is the full signature); else Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowRefContains : (refId: Any) -> (goalArrow: SetExpr) -> Maybe Boolean
arrowRefContains refId goalArrow =
  if isString refId then arrowIdMembership refId 0 goalArrow else Nothing

@label "set-algebra: arrowIdMembership"
@description "decide-substrate Phase 8λ.1 / 8λ.1-r / signature-substrate Phase 2 — the registered-fn signature membership: resolve fnId → its arrow signature marker via the `fnTypeMarker` ctx-native (Nothing ⇒ unresolved ⇒ Nothing; not pure ⇒ effectful referent ⇒ Nothing; not trusted ⇒ advisory/unadmitted signature ⇒ Nothing); use typeToSetProjection and widen degradation to SeAll BEFORE dropping the first `dropN` params (the partial-application residual), then decide via arrowSigMembership (the vacuous-goal gate precedes its exactness-fenced DIRECT variance core). Internal helper. Rides the decider ctx (fnTypeMarker is a ctx-native — the SeWhere/SeRef membership class)."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowIdMembership : (fnId: String) -> (dropN: Number) -> (goalArrow: SetExpr) -> Maybe Boolean
arrowIdMembership fnId dropN goalArrow =
  case fnTypeMarker fnId of
    Just r ->
      if r.pure
      then
        if r.trusted
        then
          let projection = typeToSetProjection r.marker
          let sigArrow = if projection.degraded then SeAll else projection.set
          let residual = arrowDropParams sigArrow dropN
          arrowSigMembership residual goalArrow
        else Nothing
      else Nothing
    Nothing -> Nothing

@label "set-algebra: arrowSigMembership"
@description "decide-substrate Phase 8λ.1-r / 8λ.2-r — the membership verdict for a RESOLVED signature against a goal SeArrow: (0) 8λ.2-r — the VACUOUS gate FIRST: any goal param domain decidably EMPTY ⇒ Just true (∀x∈∅ holds for any callable, and the callers only reach here for resolved registered fns — callable by construction; runs BEFORE the exactness fence because vacuous membership never reads the signature; also corrects the 8λ.1-r claim that the variance conjunction 'IS the literal membership condition' — it is only when every goal domain is nonempty); (1) the EXACTNESS fence — any SeAll anywhere in the projected signature (seHasAll) ⇒ Nothing: SeAll is the MARSHAL'S I-don't-know (free type var / $el / $type / opaque-no-pure / open map ⇒ TmAll ⇒ SeAll), NOT a declared ⊤ (false accept + false refutation both probe-confirmed at 8λ.1-r); (2) the UNGATED variance core (setAlgebraArrowSub) — sound both directions for a specific value's signature over NONEMPTY goal domains (the declared signature is ground truth, the same axiom every dispatch rests on). Internal helper to arrowIdMembership."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowSigMembership : (sig: SetExpr) -> (goal: SetExpr) -> Maybe Boolean
arrowSigMembership sig goal =
  if not (eq (seTag goal) "SeArrow") then Nothing
  else
    let gf = arrowFlatten goal
    if arrowSomeParamEmpty gf.params then Just true
    else if seHasAll sig then Nothing
    else if not (eq (seTag sig) "SeArrow") then Nothing
    else arrowSigAligned sig gf

@label "set-algebra: arrowSigAligned"
@description "decide-substrate Phase 8λ.2-r — the signature-membership verdict against the FLATTENED goal (registered signatures are already flat — signatureFromSig; the goal may be hand-built curried, so a 2-ary registered fn IS a member of `(A)→((B)→C)` by partial application — the currying bridge): EQUAL arities ⇒ the variance core; sig arity < goal arity ⇒ the value applied to the goal's arity over-applies past its own (declared-semantics UB; the runtime arg-drop is a fenced quirk) ⇒ Just false, gated on the sig codomain provably CALLABLE-FREE (a callable codomain would absorb the extras — legit curried spill) + goal params decidably NONEMPTY; sig arity > goal arity ⇒ the goal-applied value is a PARTIAL (a callable) ⇒ Just false when the goal codomain is provably callable-free (+ the nonempty gate); else Nothing. Internal helper to arrowSigMembership."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowSigAligned : (sig: SetExpr) -> (gf: SetExpr) -> Maybe Boolean
arrowSigAligned sig gf =
  let ns = length sig.params
  let ng = length gf.params
  if eq ns ng then setAlgebraArrowSub sig.params sig.returns gf.params gf.returns
  else if not (checkAllParamsNonempty gf.params) then Nothing
  else if lt ns ng then
    if checkCallableFree sig.returns then Just false else Nothing
  else
    if checkCallableFree gf.returns then Just false else Nothing

@label "set-algebra: seHasAll"
@description "decide-substrate Phase 8λ.1-r — does a SetExpr contain an SeAll node ANYWHERE (params / returns / ctor fields / μ body / boolean combinators)? The membership EXACTNESS predicate: a projected signature carrying SeAll is marshal-approximated (free var / $el / $type / open map), not declared-⊤ — arrowSigMembership fences it to Nothing. Leaves (SeEnum/SeInterval/SeRef/SePattern/SeWhere/SeNone) are exact declared sets ⇒ false. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seHasAll : (s: SetExpr) -> Boolean
seHasAll s = case s of
  SeAll -> true
  SeCtor { fields = fs } -> seHasAllFields fs
  SeMu { body = b } -> seHasAll b
  SeArrow { params = ps, returns = r } -> if seHasAllParams ps then true else seHasAll r
  SeUnion { branches = bs } -> seHasAllList bs
  SeIntersect { branches = bs } -> seHasAllList bs
  SeDiff { left = l, right = r } -> if seHasAll l then true else seHasAll r
  SeComplement { inner = i } -> seHasAll i
  _ -> false

@label "set-algebra: seHasAllList"
@description "decide-substrate Phase 8λ.1-r — seHasAll over a branch list (any). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seHasAllList : (bs: List SetExpr) -> Boolean
seHasAllList bs = case head bs of
  Nothing -> false
  Just b -> if seHasAll b then true else seHasAllList (eufRest bs)

@label "set-algebra: seHasAllFields"
@description "decide-substrate Phase 8λ.1-r — seHasAll over a SeCtor field list (any field set). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seHasAllFields : (fs: List SetCtorField) -> Boolean
seHasAllFields fs = case head fs of
  Nothing -> false
  Just f -> if seHasAll f.set then true else seHasAllFields (eufRest fs)

@label "set-algebra: seHasAllParams"
@description "decide-substrate Phase 8λ.1-r — seHasAll over a SeArrow param list (any param set). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seHasAllParams : (ps: List SetArrowParam) -> Boolean
seHasAllParams ps = case head ps of
  Nothing -> false
  Just p -> if seHasAll p.set then true else seHasAllParams (eufRest ps)

@label "set-algebra: seNamedEmpty"
@description "decide-substrate 8λ.1-r — the SeRef (named-set) emptiness arm of the decideEmpty core, mirroring containment.fenel's emptyNamed (the Tt* twin): the KNOWN atom tower (ℝ/ℤ/ℕ/String/Char + the raw pre-projection spellings Number/Int/Nat/Boolean/Bool) is inhabited BY CONSTRUCTION ⇒ Just false (decidably NONempty); any other handle (a registered entity name, a format handle, a μ-bound var like \"X\") ⇒ Nothing (the closed-world abstention — was the unconditional verdict pre-8λ.1-r). The widening that lets setAlgebraArrowEmpty certify param-inhabitance / return-nonemptiness for named-atom arrows, so the subsetArrowArm emptiness gate can certify a nonempty have and the arity refutation keeps firing. Strictly-better: Nothing→Just false only, on definitionally-inhabited names. Internal helper."
@tags "engine" "internal" "set-algebra" "empty" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seNamedEmpty : (h: String) -> Maybe Boolean
seNamedEmpty h =
  if eq h "ℝ" then Just false
  else if eq h "ℤ" then Just false
  else if eq h "ℕ" then Just false
  else if eq h "Number" then Just false
  else if eq h "Int" then Just false
  else if eq h "Nat" then Just false
  else if eq h "String" then Just false
  else if eq h "Char" then Just false
  else if eq h "Boolean" then Just false
  else if eq h "Bool" then Just false
  else Nothing

-- ----------------------------------------------------------------------------
-- signature-substrate slice 3jw §2 — THE MISSING DUAL of `seNamedEmpty`.
--
-- Cornerstone 2: inhabitation is the CONSTRUCTIVE DUAL of emptiness. The
-- emptiness face above answers `Just false` ("decidably NONempty") for exactly
-- ten names, and `design/tcb-ledger.md` row `emp.ref` justified that with a
-- "witness table: 0/\"\"/'a' by construction" — a table that existed in the
-- ledger's PROSE and nowhere in code. These three declarations are that table.
--
-- The name list is EXACTLY `seNamedEmpty`'s ten — not "the atom tower", which
-- is a different set: `Real`, `Rational`, `ℚ` and `NonEmpty` have LIVE
-- membership but are ABSENT from the ten (measured). Widening the two tables
-- TOGETHER is queued, not done here; a name outside the ten answers `Nothing`,
-- the same honest fence as the emptiness face's own `else Nothing`.
--
-- These picks are PROPOSALS, not verdicts. Nothing trusts them: `seWitnessRef`
-- (inhabit.fenel) re-checks every proposal through the `namedMember` membership
-- face and returns `Nothing` unless it answers `Just true`. A bad pick can
-- therefore only lose a witness, never manufacture a false one.
-- ----------------------------------------------------------------------------

-- WitnessVerdict — the INTERNAL three-case result of witness adjudication
-- (slice 3jw §2). A pure `Maybe` face cannot carry this: abstention ("I have no
-- witness for this name") and refusal ("my two oracles CONTRADICT each other")
-- are different facts, and collapsing them at the point of decision means the
-- contradiction can never be observed. The public faces still project to
-- `Maybe` (`wvToMaybe`) — both refusal cases become `Nothing`, which loses
-- nothing an existing witness consumer needs; the distinction belongs to the
-- internal/audit face and to this ADT.
WitnessVerdict = WAccept w: Any | WAbstain | WContradiction diag: String

@label "set-algebra: seNamedWitnessNum"
@description "signature-substrate slice 3jw §2 — the numeric half of the canonical-witness table dual to seNamedEmpty: 0 inhabits the WHOLE tower (ℝ/ℤ/ℕ and the raw pre-projection spellings Number/Int/Nat), so no per-rung pick is needed. A PROPOSAL only — seWitnessRef re-checks it through namedMember. Any other handle ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "inhabit" "witness" "signature-substrate" "slice-3jw"
@category "engine-internal"
seNamedWitnessNum : (h: String) -> Maybe Any
seNamedWitnessNum h =
  if eq h "ℝ" then Just 0
  else if eq h "ℤ" then Just 0
  else if eq h "ℕ" then Just 0
  else if eq h "Number" then Just 0
  else if eq h "Int" then Just 0
  else if eq h "Nat" then Just 0
  else Nothing

@label "set-algebra: seNamedWitnessAtom"
@description "signature-substrate slice 3jw §2 — the non-numeric half of the canonical-witness table dual to seNamedEmpty: \"\" for String, \"a\" for Char (live only once Char membership is registered — §2a), False for Boolean/Bool. A PROPOSAL only — seWitnessRef re-checks it through namedMember. Any other handle ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "inhabit" "witness" "signature-substrate" "slice-3jw"
@category "engine-internal"
seNamedWitnessAtom : (h: String) -> Maybe Any
seNamedWitnessAtom h =
  if eq h "String" then Just ""
  else if eq h "Char" then Just "a"
  else if eq h "Boolean" then Just False
  else if eq h "Bool" then Just False
  else Nothing

@label "set-algebra: seNamedWitnessPick"
@description "signature-substrate slice 3jw §2 — the canonical-witness PROPOSAL for a named set: the numeric table first, else the atom table. Split in two because the mirrored single ten-arm cascade measures 136 tokens, over the parser's 120-token PVF_DECL_CAP, which would fence the file. Internal helper."
@tags "engine" "internal" "set-algebra" "inhabit" "witness" "signature-substrate" "slice-3jw"
@category "engine-internal"
seNamedWitnessPick : (h: String) -> Maybe Any
seNamedWitnessPick h =
  case seNamedWitnessNum h of
    Just v -> Just v
    Nothing -> seNamedWitnessAtom h

@label "set-algebra: arrowDropParams"
@description "decide-substrate Phase 8λ.1 — drop the first `n` params of a SeArrow (the partial-application residual signature); a non-SeArrow set ⇒ unchanged. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowDropParams : (s: SetExpr) -> (n: Number) -> SetExpr
arrowDropParams s n = case s of
  SeArrow { params = ps, returns = r } ->
    let dps = arrowDropList ps n
    SeArrow { params = dps, returns = r }
  _ -> s

@label "set-algebra: arrowDropList"
@description "decide-substrate Phase 8λ.1 — drop the first `n` elements of a list (n≤0 ⇒ unchanged; exhausted ⇒ []). Internal helper to arrowDropParams."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowDropList : (xs: List SetArrowParam) -> (n: Number) -> List SetArrowParam
arrowDropList xs n =
  if lte n 0 then xs
  else case head xs of
    Nothing -> xs
    Just h -> arrowDropList (eufRest xs) (sub n 1)

@label "set-algebra: arrowPartialContains"
@description "decide-substrate Phase 8λ.1 — a `{__fenelPartial}` value's SeArrow membership: the residual signature = the underlying callable's signature minus the `collected` leading args. Read `collected` (its length = the drop count) + `fn` (the base callable id); a string / `{$ref}` base ⇒ arrowIdMembership baseId collectedN; a closure / absent base ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowPartialContains : (value: {}) -> (goalArrow: SetExpr) -> Maybe Boolean
arrowPartialContains value goalArrow =
  case mapGet value "collected" of
    Nothing -> Nothing
    Just collected ->
      let n = length collected
      case arrowPartialBaseId value of
        Just baseId -> arrowIdMembership baseId n goalArrow
        Nothing -> Nothing

@label "set-algebra: arrowPartialBaseId"
@description "decide-substrate Phase 8λ.1 — the underlying-callable id of a `{__fenelPartial}` read through dynamic-key `mapGet` own-property reads: `fn` a String ⇒ Just it; `fn` a `{$ref: id}` ⇒ Just the id; a closure / anything else ⇒ Nothing (residual-of-a-closure is the 8λ.2 CHECK face). Internal helper."
@tags "engine" "internal" "set-algebra" "arrow" "contains" "decide-substrate" "phase-8lambda"
@category "engine-internal"
arrowPartialBaseId : (value: {}) -> Maybe String
arrowPartialBaseId value =
  case mapGet value "fn" of
    Nothing -> Nothing
    Just f ->
      if isString f then Just (toString f)
      else if seCtorNotRecord f then Nothing
      else
        case mapGet f "$ref" of
          Just refId -> if isString refId then Just (toString refId) else Nothing
          Nothing -> Nothing

-- ============================================================================
-- decide-substrate Phase 8μ.3 (Steps A+B) — the ∀-INTRO arm:
-- `SeCtor c fs ⊆ SeWhere{pred}` — "EVERY value built by `c` with fields drawn
-- from `fs` satisfies pred" (the Park premise's per-ctor obligation once the
-- union splits). Brief: `briefs/phase-8mu-3-abd-forall-intro.md`.
--
-- ALL-PURE by design (the ctx-reach resolution): the arm runs inside
-- `setAlgebraIsSubset`, which the KERNEL's `verifyMuInduction` premise re-check
-- calls by bare name — so it uses only pure same-module machinery (deepEqValue /
-- forkSubst / domBoundsAtoms / domNumeric / satCombined / the DIRECT per-shape
-- witness faces seWitnessEnum/seWitnessInterval — NEVER inhabit's search-widened
-- composites, never whereMember/namedMember, never normalizeForDecide, whose
-- fn-spec resolution is a marshal ctx concern). Safe under ANY dispatch ctx.
--
-- THE PRED LANGUAGE GUARD: comprehend-fence SeWheres carry pred AS `Expr`
-- (comprehend.fenel §FENCE); legacy `$where` SeWheres carry JsonLogic. The arm
-- pattern-matches the `Expr` ctors (`EMatch`), so a JsonLogic pred falls to
-- Nothing ⇒ the hook's fall-through preserves the whereExtract tail byte-for-
-- byte. v1 pred fragment: `EMatch { scrutinee = EVar x }` ONLY (comprehend
-- absorbs plain comparisons into SeInterval/SeEnum — they never fence).
--
-- THE PIPELINE (cswDecide):
--   1. fences — coercing ctor (True/False) / synthetic record ctor "" ⇒
--      Nothing; ∅ ⊆ b short-circuit (Just true).
--   2. STATIC ARM-SELECTION (own, pure — the scrutinee is a literal ctor shape
--      BY CONSTRUCTION, so no fork/PE indirection): skip arms that provably
--      can't match a c-value (distinct-ctor patterns — Step-1 $tag
--      distinctness; lit patterns — a non-coercing ctor value is a $tag record,
--      never structurally equal to a lit); select the first ctor-c /
--      catch-all arm; a guard on the selected arm, a lit/nested ctor arg, an
--      unknown pattern shape, or an arity mismatch ⇒ Nothing. Pattern vars
--      substitute to per-field vars `?ihf:<fieldName>` (positional index ↦
--      declaration order — the projection preserves it); the scrutinee var
--      substitutes to `EConstruct c [field vars]`.
--   3. DOMAIN SEEDING (the Phase-7 currency reused): per field,
--      domBoundsAtoms over SeInterval/SeEnum, recursing through SeIntersect
--      branches (membership in an intersection implies membership in EACH
--      branch ⇒ atoms from every branch are sound — this is what makes
--      $refined-projected fields work: ⟦ℕ⟧ = SeIntersect [base, [0,∞)]).
--      Numeric certs = field vars whose set is domNumeric (same recursion).
--   4. PROVE — flatten the `and`-spine; per conjunct: true-lit ⇒ ok; false-lit
--      ⇒ DEFINITE-INVALID (⇒ Just false gated on the ctor set decidably
--      NONEMPTY — the selected arm fires for every field assignment, since
--      skipped arms provably can't match); a single comparison ⇒ negate it
--      (eq↔neq exact — the Step-1 total complement; order flips ONLY when both
--      operands are certified numeric) and satCombined(domAtoms ∪ {¬conjunct})
--      = Just false ⇒ valid (¬conjunct unsatisfiable under the field domains ⇒
--      the conjunct holds for every assignment); anything else ⇒ Nothing.
--   5. REFUTE (on a Nothing prove) — witness every field via the DIRECT
--      per-shape faces (SeEnum head / SeInterval inclusive bound), ground-
--      substitute, ground-eval the conjuncts (deepEqValue + the same-type std
--      comparisons — the Step-1 runtime semantics); a definitively-false
--      conjunct ⇒ a concrete counterexample ∈ SeCtor c fs failing pred ⇒
--      Just false (witness existence proves nonemptiness). Short-circuit
--      soundness: even if an earlier conjunct would throw at the witness,
--      membership requires pred to evaluate TRUE — a throw is not-true ⇒ the
--      value is still outside ⟦pred⟧.
--   6. NO fuel dial — the arm never recurses into the subset trio; the 8μ.2
--      muSub* fuel above it bounds the premise recursion.
--
-- STEP B — THE IH (LANDED at 8μ.4 via the v2 NAMED-PREDICATE SEAM). The rule:
-- a conjunct `recName v` (the comprehension's own predicate, by NAME, applied
-- to a field var v whose domain IS the comprehension of recName) discharges to
-- TRUE — sound because the Park premise grants exactly `t ∈ T ⇒ P(t)`, and the
-- kernel's `verifyMuInduction` RE-DERIVES that premise (it never trusts the
-- proposer), so the IH is the premise's own hypothesis, not an assumption.
--
-- Why v1 could not land it (the honest 8μ.3 finding — a theorem, not a gap):
-- for an INLINE-match pred the syntactic instance `pred[x:=fv]` strictly
-- contains any conjunct of its own arm bodies (|pred| > |conjunct| — a finite
-- tree cannot contain itself), so the deepEq trigger is EMPTY; and a named-call
-- pred (`ECall f [x]`) yields obligations `ECall f [EConstruct …]` that cannot
-- be arm-selected without resolving f's BODY.
--
-- The v2 seam resolves f's body (design/mu-induction.md §4a): `cswNamedUnfold`
-- lifts the named-call pred one level via the `fnBody` seam native (a registry
-- fn-body read + jsonLogicToExpr lift — the ONLY new TS, ledgered beside
-- namedMember/whereMember; the registry fn-body read is ground truth, the SAME
-- axiom every dispatch rests on — it grows NO evidence kind the kernel can't
-- re-check), carrying recName = f so `cswIsIH` can recognise the recursive
-- conjunct against the tail field's comprehension domain. An INLINE pred keeps
-- recName "" ⇒ the IH never fires (unreachable, per above — pinned in
-- mu-forall.test.ts). An unknown / unliftable fn ⇒ Nothing (honest). The seam
-- is ctx-guarded, not proposer-supplied: it rides the merged
-- setAlgebraDeciderNativesCtx that verifyMuInduction's `decideSubset` premise
-- re-check dispatches under, so the kernel re-derives everything else.
-- ============================================================================

CswUnfoldedPred = CswUnfoldedPred pred: (Expr Any) recName: String

CswSelectedArm = CswSelectedArm body: (Expr Any) binds: List ({ name: String, expr: (Expr Any) })

CswDomAtoms = CswDomAtoms eqs: List ({ lhs: (Expr Any), rhs: (Expr Any) }) neqs: List ({ lhs: (Expr Any), rhs: (Expr Any) }) ltes: List ({ lhs: (Expr Any), rhs: (Expr Any) }) lts: List ({ lhs: (Expr Any), rhs: (Expr Any) })

CswOrderAtoms = CswOrderAtoms ltes: List ({ lhs: (Expr Any), rhs: (Expr Any) }) lts: List ({ lhs: (Expr Any), rhs: (Expr Any) })

@label "set-algebra: ctorSubsetWhere"
@description "decide-substrate Phase 8μ.3 — the ∀-INTRO arm: SeCtor c fs ⊆ SeWhere{pred} by symbolic validity over the ctor's field domains (all-pure — kernel-premise-safe under any dispatch ctx). Fences: coercing ctor / synthetic record ctor / non-Expr (JsonLogic) pred / non-EMatch pred ⇒ Nothing (falls through to the whereExtract tail). ∅ ⊆ b ⇒ Just true. Decides via static arm-selection + per-conjunct validity (negation + satCombined over the field-domain bounds atoms) with a per-field ground witness refutation. Internal helper to setAlgebraSubsetCtorArm."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraCtorSubsetWhere : (a: SetExpr) -> (b: SetExpr) -> Maybe Boolean
setAlgebraCtorSubsetWhere a b = case a of
  SeCtor { ctor = c, fields = fs } ->
    if seCtorCoercing c then Nothing
    else if eq c "" then Nothing
    else
      let emptyA = setAlgebraDecideEmpty a
      case emptyA of
        Just true -> Just true
        _ ->
          case b of
            SeWhere { pred = p } -> cswDecide c fs p emptyA
            _ -> Nothing
  _ -> Nothing

@label "set-algebra: cswDecide"
@description "decide-substrate Phase 8μ.3 / 8μ.4 — the arm's core: FIRST the v2 named-predicate unfold (cswNamedUnfold — an inline EMatch passes through with recName \"\"; a named-call pred `ECall f [EVar x]` resolves f's body via the fnBody seam native to the v1 EMatch fragment, carrying recName = f so the IH conjunct discharge can fire; anything else / unknown fn ⇒ Nothing). Then recover the bound var (the EMatch scrutinee's EVar name), statically select the matching arm, substitute pattern vars to field vars, PROVE the and-spine (per-conjunct validity over the field-domain atoms, WITH the IH discharge for a `recName t` conjunct whose field domain is the comprehension of recName) or REFUTE (ground witness). emptyA threads the ctor set's emptiness for the definite-invalid gate. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswDecide : (c: String) -> (fs: List SetCtorField) -> (p: Any) -> (emptyA: Maybe Boolean) -> Maybe Boolean
cswDecide c fs p emptyA =
  case cswNamedUnfold p of
    Nothing -> Nothing
    Just u ->
      case cswBoundVar u.pred of
        Nothing -> Nothing
        Just x ->
          case u.pred of
            EMatch { arms = arms } ->
              case cswSelectArm c fs arms x of
                Nothing -> Nothing
                Just sel ->
                  let body = forkSubst sel.body sel.binds
                  let conjs = cswConjuncts body []
                  let domAtoms = cswDomAtoms fs
                  let certs = cswCerts fs []
                  let verdict = cswProve conjs domAtoms certs u.recName fs false
                  if eq verdict "true" then Just true
                  else if eq verdict "false" then cswNonempty emptyA
                  else cswTryRefute conjs fs
            _ -> Nothing

@label "set-algebra: cswNamedUnfold"
@description "decide-substrate Phase 8μ.4 — the v2 NAMED-PREDICATE one-level unfold. An inline EMatch pred passes through unchanged with recName \"\" (the 8μ.3 inline path — no fn resolution, no IH). A named-call pred `ECall f [EVar x]` (single bare-var arg — anything else stays Nothing) resolves f's body via the `fnBody` seam native (a registry fn-body read + jsonLogicToExpr lift; the ctx-guarded seam of design/mu-induction.md §4a): Nothing (unknown fn / lift fence) ⇒ Nothing (honest); a v1 EMatch-fragment body ⇒ Just { pred = body, recName = f } (the body's own scrutinee var becomes the bound var; recName carries f so cswProveOne can discharge the IH). A non-fragment body ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswNamedUnfold : (p: Any) -> Maybe CswUnfoldedPred
cswNamedUnfold p = case p of
  EMatch {} -> Just (CswUnfoldedPred { pred = p, recName = "" })
  ECall { fnId = f, args = args } ->
    case cswSingleVarArg args of
      Nothing -> Nothing
      Just x ->
        case fnBody f of
          Nothing -> Nothing
          Just body ->
            if cswIsV1Fragment body then Just (CswUnfoldedPred { pred = body, recName = f })
            else Nothing
  _ -> Nothing

@label "set-algebra: cswSingleVarArg"
@description "decide-substrate Phase 8μ.4 — a call's SINGLE bare-var argument: exactly one arg that is an EVar ⇒ Just its name; any other arity or a non-EVar arg ⇒ Nothing (the v2 fragment guard — a nested recursive arg like `f (tail t)` or arity ≠ 1 fences here). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswSingleVarArg : (args: List (Expr Any)) -> Maybe String
cswSingleVarArg args =
  if not (eq (length args) 1) then Nothing
  else case head args of
    Nothing -> Nothing
    Just a -> case a of
      EVar { name = n } -> Just n
      _ -> Nothing

@label "set-algebra: cswIsV1Fragment"
@description "decide-substrate Phase 8μ.4 — the v1 pred fragment guard for an unfolded fn body: an EMatch whose scrutinee is an EVar (the fn's formal param). Anything else (guards live at arm level, a non-EMatch body, a non-var scrutinee) ⇒ false ⇒ the unfold fences. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswIsV1Fragment : (body: (Expr Any)) -> Boolean
cswIsV1Fragment body = case body of
  EMatch { scrutinee = sc } ->
    case sc of
      EVar {} -> true
      _ -> false
  _ -> false

@label "set-algebra: cswNonempty"
@description "decide-substrate Phase 8μ.3 — the definite-invalid gate: the pred is false over the WHOLE ctor set, which refutes the subset ONLY when the ctor set is decidably nonempty (∅ ⊆ anything). Just false on decidably-nonempty, else Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswNonempty : (emptyA: Maybe Boolean) -> Maybe Boolean
cswNonempty emptyA = case emptyA of
  Just false -> Just false
  _ -> Nothing

@label "set-algebra: cswBoundVar"
@description "decide-substrate Phase 8μ.3 — recover the comprehension's bound var from the v1 pred fragment: an EMatch whose scrutinee is an EVar ⇒ Just its name; anything else (incl. a JsonLogic pred, which matches no Expr ctor) ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswBoundVar : (p: (Expr Any)) -> Maybe String
cswBoundVar p = case p of
  EMatch { scrutinee = sc } ->
    case sc of
      EVar { name = n } -> Just n
      _ -> Nothing
  _ -> Nothing

@label "set-algebra: cswSelectArm"
@description "decide-substrate Phase 8μ.3 — static arm-selection for a ctor-shaped scrutinee: skip arms whose pattern provably can't match a c-value (distinct-ctor patterns — $tag distinctness; lit patterns — a non-coercing ctor value never structurally equals a lit); SELECT the first ctor-c or catch-all (var/wildcard) arm; a guard on the selected arm / a non-simple ctor arg / an unknown pattern shape / no matching arm ⇒ Nothing. Returns Just { body, binds }. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswSelectArm : (c: String) -> (fs: List SetCtorField) -> (arms: List Any) -> (x: String) -> Maybe CswSelectedArm
cswSelectArm c fs arms x = case head arms of
  Nothing -> Nothing
  Just arm ->
    let m = cswPatMatchClass c arm.pattern
    if eq m "skip" then cswSelectArm c fs (eufRest arms) x
    else if eq m "abort" then Nothing
    else
      case lookup arm "guard" of
        Just g -> Nothing
        Nothing ->
          case cswBinds c fs arm.pattern x of
            Nothing -> Nothing
            Just binds -> Just (CswSelectedArm { body = arm.body, binds = binds })

@label "set-algebra: cswPatMatchClass"
@description "decide-substrate Phase 8μ.3 — classify an arm pattern against ctor-c values: wildcard/var ⇒ select (catch-all); lit ⇒ skip (a non-coercing ctor value is a $tag record, never eq a lit — Step-1); ctor c' ⇒ select iff c'==c else skip ($tag distinctness); anything else ⇒ abort (conservative). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswPatMatchClass : (c: String) -> (pat: (Pattern Any)) -> String
cswPatMatchClass c pat = case pat of
  PatWildcard -> "select"
  PatVar { name = n } -> "select"
  PatLit { value = v } -> "skip"
  PatConstruct { ctor = pc } -> if eq pc c then "select" else "skip"
  other -> "abort"

@label "set-algebra: cswBinds"
@description "decide-substrate Phase 8μ.3 — the selected arm's substitution env: a ctor pattern binds each PatVar arg to its field var by POSITION (declaration order — arity must match; a lit/nested arg ⇒ Nothing); a var pattern binds the name to the whole ctor expr; the scrutinee var x always binds to the ctor expr (the body may reference it). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswBinds : (c: String) -> (fs: List SetCtorField) -> (pat: (Pattern Any)) -> (x: String) -> Maybe (List ({ name: String, expr: (Expr Any) }))
cswBinds c fs pat x =
  let ce = cswCtorExpr c fs
  let xBind = { name = x, expr = ce }
  case pat of
    PatWildcard -> Just (appendItem xBind [])
    PatVar { name = n } -> Just (appendItem xBind (appendItem { name = n, expr = ce } []))
    PatConstruct { args = as } ->
      case cswArgBinds as fs 0 [] of
        Nothing -> Nothing
        Just abinds -> Just (appendItem xBind abinds)
    _ -> Nothing

@label "set-algebra: cswArgBinds"
@description "decide-substrate Phase 8μ.3 — positional ctor-pattern arg binds: PatVar ⇒ bind to the i-th field var; PatWildcard ⇒ no bind; a lit / nested ctor / unknown arg ⇒ Nothing (the arm would constrain or split the field space — v2). Arity must equal the field count. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswArgBinds : (as: List (Pattern Any)) -> (fs: List SetCtorField) -> (i: Number) -> (acc: List ({ name: String, expr: (Expr Any) })) -> Maybe (List ({ name: String, expr: (Expr Any) }))
cswArgBinds as fs i acc = case head as of
  Nothing -> if eq i (length fs) then Just acc else Nothing
  Just a ->
    if not (lt i (length fs)) then Nothing
    else
      case a of
        PatVar { name = n } ->
          let fdef = at fs i
          let fvn = cswFieldVarName fdef.key
          cswArgBinds (eufRest as) fs (add i 1) (appendItem { name = n, expr = EVar { name = fvn } } acc)
        PatWildcard -> cswArgBinds (eufRest as) fs (add i 1) acc
        _ -> Nothing

@label "set-algebra: cswFieldVarName"
@description "decide-substrate Phase 8μ.3 / field-identity Phase 3 — the per-field symbolic variable `?ihf:<tagged FieldKey token>`. It is independent of wire spelling and collision-free for same-spelled fields with different UUIDs. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswFieldVarName : (key: FieldKey) -> String
cswFieldVarName key = join ["?ihf:", fieldKeyToken key] ""

@label "set-algebra: cswCtorExpr"
@description "decide-substrate Phase 8μ.3 — the symbolic ctor value as an Expr: EConstruct c over the per-field vars (positional, declaration order). What the scrutinee var substitutes to. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswCtorExpr : (c: String) -> (fs: List SetCtorField) -> (Expr Any)
cswCtorExpr c fs =
  let as = cswCtorArgs fs []
  EConstruct { ctor = c, args = as }

@label "set-algebra: cswCtorArgs"
@description "decide-substrate Phase 8μ.3 — the field-var EVar list for cswCtorExpr, declaration order. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswCtorArgs : (fs: List SetCtorField) -> (acc: List (Expr Any)) -> List (Expr Any)
cswCtorArgs fs acc = case head fs of
  Nothing -> acc
  Just f ->
    let fvn = cswFieldVarName f.key
    cswCtorArgs (eufRest fs) (appendItem (EVar { name = fvn }) acc)

@label "set-algebra: cswConjuncts"
@description "decide-substrate Phase 8μ.3 — flatten an `and`-spine into a conjunct list (the trivial DNF-free decomposition the v1 honesty fence allows). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswConjuncts : (e: (Expr Any)) -> (acc: List (Expr Any)) -> List (Expr Any)
cswConjuncts e acc = case e of
  ECall { fnId = f, args = args } ->
    if eq f "and" then cswConjunctsList args acc
    else appendItem e acc
  _ -> appendItem e acc

@label "set-algebra: cswConjunctsList"
@description "decide-substrate Phase 8μ.3 — cswConjuncts folded over an `and`'s operand list. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswConjunctsList : (args: List (Expr Any)) -> (acc: List (Expr Any)) -> List (Expr Any)
cswConjunctsList args acc = case head args of
  Nothing -> acc
  Just h ->
    let acc2 = cswConjuncts h acc
    case tail args of
      Nothing -> acc2
      Just rest -> cswConjunctsList rest acc2

@label "set-algebra: cswDomAtoms"
@description "decide-substrate Phase 8μ.3 — the field-domain BOUNDS ATOMS: per field, the numeric order atoms its set implies for the field var (cswFieldAtoms), merged into the satCombined `{ eqs, neqs, ltes, lts }` shape (eqs/neqs empty — domains only bound). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswDomAtoms : (fs: List SetCtorField) -> CswDomAtoms
cswDomAtoms fs = cswDomAtomsLoop fs (CswDomAtoms { eqs = [], neqs = [], ltes = [], lts = [] })

@label "set-algebra: cswDomAtomsLoop"
@description "decide-substrate Phase 8μ.3 — the cswDomAtoms fold. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswDomAtomsLoop : (fs: List SetCtorField) -> (acc: CswDomAtoms) -> CswDomAtoms
cswDomAtomsLoop fs acc = case head fs of
  Nothing -> acc
  Just f ->
    let fvn = cswFieldVarName f.key
    let delta = cswFieldAtoms f.set (EVar { name = fvn })
    cswDomAtomsLoop (eufRest fs) (CswDomAtoms { eqs = acc.eqs, neqs = acc.neqs, ltes = concat acc.ltes delta.ltes, lts = concat acc.lts delta.lts })

@label "set-algebra: cswFieldAtoms"
@description "decide-substrate Phase 8μ.3 — one field set's order-atom delta for a term: SeInterval/SeEnum via the Phase-7 domBoundsAtoms (numeric bounds only — honest); SeIntersect recurses EVERY branch (membership in an intersection implies membership in each branch ⇒ all branch atoms are sound — the $refined projection shape); everything else ⇒ empty. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswFieldAtoms : (set: SetExpr) -> (term: (Expr Any)) -> CswOrderAtoms
cswFieldAtoms set term = case set of
  SeIntersect { branches = bs } -> cswFieldAtomsList bs term (CswOrderAtoms { ltes = [], lts = [] })
  _ ->
    let t = seTag set
    if or (eq t "SeInterval") (eq t "SeEnum") then
      let raw = domBoundsAtoms set term
      CswOrderAtoms { ltes = raw.ltes, lts = raw.lts }
    else CswOrderAtoms { ltes = [], lts = [] }

@label "set-algebra: cswFieldAtomsList"
@description "decide-substrate Phase 8μ.3 — cswFieldAtoms folded over SeIntersect branches. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswFieldAtomsList : (bs: List SetExpr) -> (term: (Expr Any)) -> (acc: CswOrderAtoms) -> CswOrderAtoms
cswFieldAtomsList bs term acc = case head bs of
  Nothing -> acc
  Just s ->
    let d = cswFieldAtoms s term
    cswFieldAtomsList (eufRest bs) term (CswOrderAtoms { ltes = concat acc.ltes d.ltes, lts = concat acc.lts d.lts })

@label "set-algebra: cswNumericSet"
@description "decide-substrate Phase 8μ.3 — true when a field set certifies its members NUMERIC: domNumeric (numeric-bounded SeInterval / all-numeric SeEnum), or an SeIntersect with ANY numeric branch (every member is in each branch). The negated-order certificate source. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswNumericSet : (set: SetExpr) -> Boolean
cswNumericSet set = case set of
  SeIntersect { branches = bs } -> cswNumericAny bs
  _ -> domNumeric (Just set)

@label "set-algebra: cswNumericAny"
@description "decide-substrate Phase 8μ.3 — cswNumericSet over SeIntersect branches (any). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswNumericAny : (bs: List SetExpr) -> Boolean
cswNumericAny bs = case head bs of
  Nothing -> false
  Just s -> if cswNumericSet s then true else cswNumericAny (eufRest bs)

@label "set-algebra: cswCerts"
@description "decide-substrate Phase 8μ.3 — the certified-numeric field-var names (cswNumericSet fields) — the same-type guarantee the order-negation flip requires. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswCerts : (fs: List SetCtorField) -> (acc: List String) -> List String
cswCerts fs acc = case head fs of
  Nothing -> acc
  Just f ->
    let fvn = cswFieldVarName f.key
    if cswNumericSet f.set then cswCerts (eufRest fs) (appendItem fvn acc)
    else cswCerts (eufRest fs) acc

@label "set-algebra: cswProve"
@description "decide-substrate Phase 8μ.3 — the PROVE fold over the conjuncts: any definite-invalid ⇒ \"false\" (dominates); all valid ⇒ \"true\"; else \"nothing\". Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswProve : (conjs: List (Expr Any)) -> (domAtoms: CswDomAtoms) -> (certs: List String) -> (recName: String) -> (fs: List SetCtorField) -> (sawNothing: Boolean) -> String
cswProve conjs domAtoms certs recName fs sawNothing = case head conjs of
  Nothing -> if sawNothing then "nothing" else "true"
  Just cj ->
    let v = cswProveOne cj domAtoms certs recName fs
    if eq v "false" then "false"
    else if eq v "true" then cswProve (eufRest conjs) domAtoms certs recName fs sawNothing
    else cswProve (eufRest conjs) domAtoms certs recName fs true

@label "set-algebra: cswProveOne"
@description "decide-substrate Phase 8μ.3 / 8μ.4 — one conjunct's validity class: a true lit ⇒ valid; a false lit ⇒ definite-invalid; the INDUCTION HYPOTHESIS (cswIsIH — a `recName v` conjunct on a field var v whose domain is the comprehension of recName) ⇒ valid (the Park premise grants exactly `t ∈ T ⇒ P(t)`; see the STEP B section header); a single comparison ⇒ negation + satCombined over the field-domain atoms (cswCompValid); anything else ⇒ \"nothing\" (the honesty fence — no DNF, no nested branching). recName is \"\" for an inline pred (the IH never fires — sound). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswProveOne : (cj: (Expr Any)) -> (domAtoms: CswDomAtoms) -> (certs: List String) -> (recName: String) -> (fs: List SetCtorField) -> String
cswProveOne cj domAtoms certs recName fs =
  if cswIsTrueLit cj then "true"
  else if cswIsFalseLit cj then "false"
  else if cswIsIH cj recName fs then "true"
  else cswCompValid cj domAtoms certs

@label "set-algebra: cswIsIH"
@description "decide-substrate Phase 8μ.4 — the INDUCTION-HYPOTHESIS discharge: a conjunct `ECall recName [EVar v]` — the SAME recName the pred unfolded from — where the field var v's domain is the comprehension of recName (a SeWhere whose pred is `ECall recName [EVar _]`, binder-name-insensitive; or an SeIntersect containing one — the $refined-projection shape). ⇒ true (the Park premise `t ∈ T ⇒ P(t)` discharges the IH; verifyMuInduction re-derives the premise, so this is not a proposer trust). recName \"\" (inline pred) ⇒ false — the IH is unreachable for inline preds (the finite-tree self-containment theorem, STEP B). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswIsIH : (cj: (Expr Any)) -> (recName: String) -> (fs: List SetCtorField) -> Boolean
cswIsIH cj recName fs =
  if eq recName "" then false
  else case cj of
    ECall { fnId = g, args = args } ->
      if not (eq g recName) then false
      else case cswSingleVarArg args of
        Nothing -> false
        Just v -> cswFieldDomIsRec v fs recName
    _ -> false

@label "set-algebra: cswFieldDomIsRec"
@description "decide-substrate Phase 8μ.4 — find the ctor field whose per-field var name (cswFieldVarName) is v, and test whether its domain set is the comprehension of recName (cswSetIsRecComp). A field-var not among the ctor fields ⇒ false (the conjunct calls recName on something that isn't a field the IH covers). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswFieldDomIsRec : (v: String) -> (fs: List SetCtorField) -> (recName: String) -> Boolean
cswFieldDomIsRec v fs recName = case head fs of
  Nothing -> false
  Just f ->
    if eq (cswFieldVarName f.key) v then cswSetIsRecComp f.set recName
    else cswFieldDomIsRec v (eufRest fs) recName

@label "set-algebra: cswSetIsRecComp"
@description "decide-substrate Phase 8μ.4 — true when a field set IS the comprehension of recName: a SeWhere whose pred is `ECall recName [EVar _]` (the Park-substituted tail domain, VERBATIM — probe 4), or an SeIntersect with ANY such branch (the $refined-projection wrap — membership in the intersection implies membership in the comprehension branch). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswSetIsRecComp : (set: SetExpr) -> (recName: String) -> Boolean
cswSetIsRecComp set recName = case set of
  SeWhere { pred = p } -> cswPredIsRecCall p recName
  SeIntersect { branches = bs } -> cswAnyRecComp bs recName
  _ -> false

@label "set-algebra: cswAnyRecComp"
@description "decide-substrate Phase 8μ.4 — cswSetIsRecComp over SeIntersect branches (any). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswAnyRecComp : (bs: List SetExpr) -> (recName: String) -> Boolean
cswAnyRecComp bs recName = case head bs of
  Nothing -> false
  Just s -> if cswSetIsRecComp s recName then true else cswAnyRecComp (eufRest bs) recName

@label "set-algebra: cswPredIsRecCall"
@description "decide-substrate Phase 8μ.4 — a comprehension pred IS a recName self-call: `ECall recName [EVar _]` (single bare-var arg — binder-name-insensitive). Anything else ⇒ false. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswPredIsRecCall : (p: Any) -> (recName: String) -> Boolean
cswPredIsRecCall p recName = case p of
  ECall { fnId = f, args = args } ->
    if not (eq f recName) then false
    else case cswSingleVarArg args of
      Nothing -> false
      Just n -> true
  _ -> false

@label "set-algebra: cswIsTrueLit"
@description "decide-substrate Phase 8μ.3 — the constant-true conjunct (ELit true / EConstruct True — the two Bool spellings, the forkResidualFalse mirror). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswIsTrueLit : (e: (Expr Any)) -> Boolean
cswIsTrueLit e = case e of
  ELit { value = v } -> eq v true
  EConstruct { ctor = ec } -> eq ec "True"
  _ -> false

@label "set-algebra: cswIsFalseLit"
@description "decide-substrate Phase 8μ.3 — the constant-false conjunct (ELit false / EConstruct False). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswIsFalseLit : (e: (Expr Any)) -> Boolean
cswIsFalseLit e = case e of
  ELit { value = v } -> eq v false
  EConstruct { ctor = ec } -> eq ec "False"
  _ -> false

@label "set-algebra: cswCompValid"
@description "decide-substrate Phase 8μ.3 — a single-comparison conjunct's validity: negate it and ask satCombined whether domAtoms ∪ {¬conjunct} is UNSAT (Just false ⇒ no field assignment falsifies the conjunct ⇒ valid). Non-comparison heads / non-2-arg ⇒ \"nothing\". Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswCompValid : (cj: (Expr Any)) -> (domAtoms: CswDomAtoms) -> (certs: List String) -> String
cswCompValid cj domAtoms certs = case cj of
  ECall { fnId = f, args = args } ->
    if cswIsCmp f then cswCompArgs f args domAtoms certs
    else "nothing"
  _ -> "nothing"

@label "set-algebra: cswIsCmp"
@description "decide-substrate Phase 8μ.3 — the comparison head set (eq/neq/lt/lte/gt/gte). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswIsCmp : (f: String) -> Boolean
cswIsCmp f = or (eq f "eq") (or (eq f "neq") (or (eq f "lt") (or (eq f "lte") (or (eq f "gt") (eq f "gte")))))

@label "set-algebra: cswCompArgs"
@description "decide-substrate Phase 8μ.3 — extract the comparison's two operands (eufTwoArgs) and dispatch the negation. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswCompArgs : (f: String) -> (args: List (Expr Any)) -> (domAtoms: CswDomAtoms) -> (certs: List String) -> String
cswCompArgs f args domAtoms certs = case eufTwoArgs args of
  Just pr -> cswNegSat f pr.lhs pr.rhs domAtoms certs
  Nothing -> "nothing"

@label "set-algebra: cswNegSat"
@description "decide-substrate Phase 8μ.3 — the negation table (the fork-driver §1 discipline): ¬eq ⇒ neq and ¬neq ⇒ eq are EXACT (the Step-1 structural eq is a total complement — any operand terms); an ORDER negation flips ONLY when BOTH operands are certified numeric (an ELit number / a field var with a numeric domain) — cross-type order atoms are false BOTH ways, so an uncertified flip would strengthen unsoundly ⇒ \"nothing\". Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswNegSat : (f: String) -> (a: (Expr Any)) -> (b: (Expr Any)) -> (domAtoms: CswDomAtoms) -> (certs: List String) -> String
cswNegSat f a b domAtoms certs =
  if eq f "eq" then cswSatVerdict domAtoms.eqs (cswSnoc domAtoms.neqs a b) domAtoms.ltes domAtoms.lts
  else if eq f "neq" then cswSatVerdict (cswSnoc domAtoms.eqs a b) domAtoms.neqs domAtoms.ltes domAtoms.lts
  else if and (cswCertOp a certs) (cswCertOp b certs) then cswNegSatOrder f a b domAtoms
  else "nothing"

@label "set-algebra: cswNegSatOrder"
@description "decide-substrate Phase 8μ.3 — the certified order negations: ¬(a<b) ⇒ b≤a; ¬(a≤b) ⇒ b<a; ¬(a>b) ⇒ a≤b; ¬(a≥b) ⇒ a<b. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswNegSatOrder : (f: String) -> (a: (Expr Any)) -> (b: (Expr Any)) -> (domAtoms: CswDomAtoms) -> String
cswNegSatOrder f a b domAtoms =
  if eq f "lt" then cswSatVerdict domAtoms.eqs domAtoms.neqs (cswSnoc domAtoms.ltes b a) domAtoms.lts
  else if eq f "lte" then cswSatVerdict domAtoms.eqs domAtoms.neqs domAtoms.ltes (cswSnoc domAtoms.lts b a)
  else if eq f "gt" then cswSatVerdict domAtoms.eqs domAtoms.neqs (cswSnoc domAtoms.ltes a b) domAtoms.lts
  else if eq f "gte" then cswSatVerdict domAtoms.eqs domAtoms.neqs domAtoms.ltes (cswSnoc domAtoms.lts a b)
  else "nothing"

@label "set-algebra: cswSnoc"
@description "decide-substrate Phase 8μ.3 — append one { lhs, rhs } atom to an atom list. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswSnoc : (xs: List ({ lhs: (Expr Any), rhs: (Expr Any) })) -> (a: (Expr Any)) -> (b: (Expr Any)) -> List ({ lhs: (Expr Any), rhs: (Expr Any) })
cswSnoc xs a b = concat xs (appendItem { lhs = a, rhs = b } [])

@label "set-algebra: cswSatVerdict"
@description "decide-substrate Phase 8μ.3 — the satCombined read: Just false (UNSAT — the negated conjunct is impossible under the field domains) ⇒ \"true\" (the conjunct is valid); anything else ⇒ \"nothing\" (satCombined never returns Just true). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswSatVerdict : (eqs: List ({ lhs: (Expr Any), rhs: (Expr Any) })) -> (neqs: List ({ lhs: (Expr Any), rhs: (Expr Any) })) -> (ltes: List ({ lhs: (Expr Any), rhs: (Expr Any) })) -> (lts: List ({ lhs: (Expr Any), rhs: (Expr Any) })) -> String
cswSatVerdict eqs neqs ltes lts = case satCombined eqs neqs ltes lts of
  Just v -> if toBoolean v then "nothing" else "true"
  Nothing -> "nothing"

@label "set-algebra: cswCertOp"
@description "decide-substrate Phase 8μ.3 — an operand's numeric certification: a numeric ELit, or a field var whose domain certifies numeric (the certs list). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswCertOp : (op: (Expr Any)) -> (certs: List String) -> Boolean
cswCertOp op certs = case op of
  ELit { value = v } -> isNumber v
  EVar { name = n } -> setAlgebraListContains certs n
  _ -> false

@label "set-algebra: cswTryRefute"
@description "decide-substrate Phase 8μ.3 — the REFUTE face: witness every field via the DIRECT per-shape faces (never the search-widened composites — ctx purity), ground-substitute the witnesses into the conjuncts, and ground-eval; a definitively-false conjunct exhibits a concrete member of the ctor set failing the pred ⇒ Just false (the witness's existence proves nonemptiness). No witness / no ground-false ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswTryRefute : (conjs: List (Expr Any)) -> (fs: List SetCtorField) -> Maybe Boolean
cswTryRefute conjs fs = case cswWitnessBinds fs [] of
  Nothing -> Nothing
  Just wbinds ->
    if cswRefuteConjs conjs wbinds then Just false else Nothing

@label "set-algebra: cswWitnessBinds"
@description "decide-substrate Phase 8μ.3 — the ground substitution env: each field var binds to an ELit of its set's witness (SeEnum head / SeInterval inclusive bound — the DIRECT per-shape faces only); any unwitnessable field ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswWitnessBinds : (fs: List SetCtorField) -> (acc: List ({ name: String, expr: (Expr Any) })) -> Maybe (List ({ name: String, expr: (Expr Any) }))
cswWitnessBinds fs acc = case head fs of
  Nothing -> Just acc
  Just f ->
    case cswFieldWitness f.set of
      Nothing -> Nothing
      Just w ->
        let fvn = cswFieldVarName f.key
        cswWitnessBinds (eufRest fs) (appendItem { name = fvn, expr = ELit { value = w } } acc)

@label "set-algebra: cswFieldWitness"
@description "decide-substrate Phase 8μ.3 — one field set's witness via the DIRECT per-shape faces: SeEnum ⇒ seWitnessEnum; SeInterval ⇒ seWitnessInterval; anything else ⇒ Nothing (inhabit's composite faces can reach the membership ctx seams — excluded for kernel-premise ctx purity). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswFieldWitness : (set: SetExpr) -> Maybe Any
cswFieldWitness set =
  let t = seTag set
  if eq t "SeEnum" then seWitnessEnum set
  else if eq t "SeInterval" then seWitnessInterval set
  else Nothing

@label "set-algebra: cswRefuteConjs"
@description "decide-substrate Phase 8μ.3 — true when SOME conjunct ground-evaluates to a definite false at the witness assignment (short-circuit-sound: membership requires the pred to evaluate TRUE, so any false conjunct — or an earlier throw — keeps the witness outside ⟦pred⟧). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswRefuteConjs : (conjs: List (Expr Any)) -> (wbinds: List ({ name: String, expr: (Expr Any) })) -> Boolean
cswRefuteConjs conjs wbinds = case head conjs of
  Nothing -> false
  Just cj ->
    let g = cswGroundEval (forkSubst cj wbinds)
    if eq g "false" then true
    else cswRefuteConjs (eufRest conjs) wbinds

@label "set-algebra: cswGroundEval"
@description "decide-substrate Phase 8μ.3 — the pure ground evaluator over the witness-substituted conjunct fragment: bool lits, `and` spines (false dominates), and comparisons over two ELits (deepEqValue for eq/neq — the Step-1 structural semantics; the same-type std comparisons for order). Anything non-ground ⇒ \"unknown\" (no refutation). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswGroundEval : (e: (Expr Any)) -> String
cswGroundEval e = case e of
  ELit { value = v } ->
    if eq v true then "true"
    else if eq v false then "false"
    else "unknown"
  EConstruct { ctor = ec } ->
    if eq ec "True" then "true"
    else if eq ec "False" then "false"
    else "unknown"
  ECall { fnId = f, args = args } ->
    if eq f "and" then cswGroundAnd args false
    else if cswIsCmp f then cswGroundCmp f args
    else "unknown"
  _ -> "unknown"

@label "set-algebra: cswGroundAnd"
@description "decide-substrate Phase 8μ.3 — ground `and`: any false ⇒ false (dominates — short-circuit-sound); all true ⇒ true; else unknown. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswGroundAnd : (args: List (Expr Any)) -> (sawUnknown: Boolean) -> String
cswGroundAnd args sawUnknown = case head args of
  Nothing -> if sawUnknown then "unknown" else "true"
  Just h ->
    let g = cswGroundEval h
    if eq g "false" then "false"
    else if eq g "true" then cswGroundAnd (eufRest args) sawUnknown
    else cswGroundAnd (eufRest args) true

@label "set-algebra: cswGroundCmp"
@description "decide-substrate Phase 8μ.3 — a ground comparison: both operands must be ELits. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswGroundCmp : (f: String) -> (args: List (Expr Any)) -> String
cswGroundCmp f args = case eufTwoArgs args of
  Nothing -> "unknown"
  Just pr -> cswGroundCmpL f pr.lhs pr.rhs

@label "set-algebra: cswGroundCmpL"
@description "decide-substrate Phase 8μ.3 — cswGroundCmp's left-operand unwrap. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswGroundCmpL : (f: String) -> (a: (Expr Any)) -> (b: (Expr Any)) -> String
cswGroundCmpL f a b = case a of
  ELit { value = va } -> cswGroundCmpR f va b
  _ -> "unknown"

@label "set-algebra: cswGroundCmpR"
@description "decide-substrate Phase 8μ.3 — cswGroundCmp's right-operand unwrap. Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswGroundCmpR : (f: String) -> (va: Any) -> (b: (Expr Any)) -> String
cswGroundCmpR f va b = case b of
  ELit { value = vb } -> cswCmpVals f va vb
  _ -> "unknown"

@label "set-algebra: cswCmpVals"
@description "decide-substrate Phase 8μ.3 — compare two ground values with the Step-1 runtime semantics: eq/neq via deepEqValue (structural); order via the same-type std comparisons (cross-type ⇒ false, matching the live eq/lt family). Internal helper."
@tags "engine" "internal" "set-algebra" "sector" "subset" "forall" "decide-substrate" "phase-8mu"
@category "engine-internal"
cswCmpVals : (f: String) -> (va: Any) -> (vb: Any) -> String
cswCmpVals f va vb =
  if eq f "eq" then (if deepEqValue va vb then "true" else "false")
  else if eq f "neq" then (if deepEqValue va vb then "false" else "true")
  else if eq f "lt" then (if lt va vb then "true" else "false")
  else if eq f "lte" then (if lte va vb then "true" else "false")
  else if eq f "gt" then (if gt va vb then "true" else "false")
  else (if gte va vb then "true" else "false")

-- ============================================================================
-- decide-substrate Phase 8μ.1b — the SeMu (fixpoint) algebra + the non-kernel
-- μ faces. `SeMu v F` = μv.F — the least fixpoint; the bound occurrence rides
-- `SeRef {handle=v}` (D-A). The ops:
--   • substSet    — capture-avoiding leaf-replace (shadowing stops at an inner
--                   same-var SeMu; a colliding inner binder is FRESHENED before
--                   descent — α-rename via a fresh-prime name).
--   • sePositive  — the Park soundness side-condition (design/mu-induction.md
--                   §1): the μ-var occurs only at EVEN negation-parity (the only
--                   negative formers are SeComplement.inner and SeDiff.right).
--                   Shipped NOW to gate the faces; the 8μ.2 Park rule re-uses it.
--   • seMuSupported — no occurrence of the var inside a SePattern subtree
--                   (SpMatch.pred / SpGroup.type — the positions substSet does NOT
--                   rewrite); unsupported ⇒ every face degrades to Nothing.
--   • seMuGuarded — the PRODUCTIVITY condition for value-membership: every free
--                   occurrence sits under some SetCtorField.set, so each unroll
--                   consumes one constructor layer of the (finite) value ⇒ the
--                   descent terminates WITHOUT fuel. `μX.(X ∪ {1})` is unguarded
--                   ⇒ membership Nothing (no loop), never a wrong answer.
-- The faces (all gated on positive ∧ supported):
--   • emptiness   — `empty(μv.F) ⟺ empty(F[v:=∅])` (§0.2): one substitution,
--                   then the ordinary judgment; μ-nesting depth strictly
--                   decreases ⇒ terminates. NO kernel change.
--   • membership  — `{w} ⊆ μv.F` by unroll-once + structural descent on the
--                   finite w (§0.4); additionally gated on GUARDED.
--   • inhabitation — fuel-bounded Kleene iteration (inhabit.fenel:seWitnessMu).
-- Subset stays 8μ.2 (Park) EXCEPT deepEq reflexivity via the tail rules.
-- ============================================================================

@label "set-algebra: seRefHandles"
@description "decide-substrate Phase 8μ.1b — collect ALL SeRef handles occurring in a SetExpr (prepended onto acc; includes μ-bound handles — a deliberate over-approximation of the free set, harmless for capture-avoidance where it only forces extra freshening). Internal helper to substSet."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seRefHandles : (s: SetExpr) -> (acc: List String) -> List String
seRefHandles s acc = case s of
  SeRef { handle = h } -> appendItem h acc
  SeCtor { fields = fs } -> seRefHandlesFields fs acc
  SeMu { body = b } -> seRefHandles b acc
  SeArrow { params = ps, returns = r } -> seRefHandles r (seRefHandlesArrowParams ps acc)
  SeUnion { branches = bs } -> seRefHandlesList bs acc
  SeIntersect { branches = bs } -> seRefHandlesList bs acc
  SeDiff { left = l, right = r } -> seRefHandles r (seRefHandles l acc)
  SeComplement { inner = i } -> seRefHandles i acc
  -- signature-substrate Phase 4 slice 3a — a rigid contributes NO handle. It is
  -- a LEAF with no SetExpr child (`kind` is a signature-layer kind, never a
  -- set), so freshness/capture computation over it is exact, not conservative.
  -- The same leafness argument licenses the substSet / sePositiveP /
  -- seVarOccurs / seVarUnderPattern / seMuGuarded / seSize arms below.
  SeRigid {} -> acc
  _ -> acc

@label "set-algebra: seRefHandlesList"
@description "decide-substrate Phase 8μ.1b — seRefHandles folded over a branch list. Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seRefHandlesList : (bs: List SetExpr) -> (acc: List String) -> List String
seRefHandlesList bs acc = case head bs of
  Nothing -> acc
  Just b -> seRefHandlesList (eufRest bs) (seRefHandles b acc)

@label "set-algebra: seRefHandlesFields"
@description "decide-substrate Phase 8μ.1b — seRefHandles folded over a SeCtor field list (each field's set). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seRefHandlesFields : (fs: List SetCtorField) -> (acc: List String) -> List String
seRefHandlesFields fs acc = case head fs of
  Nothing -> acc
  Just f -> seRefHandlesFields (eufRest fs) (seRefHandles f.set acc)

@label "set-algebra: seRefHandlesArrowParams"
@description "decide-substrate Phase 8λ.1 — seRefHandles folded over a SeArrow param list (each param's set). Internal helper to seRefHandles' SeArrow arm."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seRefHandlesArrowParams : (ps: List SetArrowParam) -> (acc: List String) -> List String
seRefHandlesArrowParams ps acc = case head ps of
  Nothing -> acc
  Just p -> seRefHandlesArrowParams (eufRest ps) (seRefHandles p.set acc)

@label "set-algebra: seFreshVar"
@description "decide-substrate Phase 8μ.1b — the capture-avoidance freshener: append a prime (') until the name is not in the avoid list. Terminates (avoid is finite; each prime strictly lengthens). Internal helper to substSet's colliding-binder arm."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seFreshVar : (w: String) -> (avoid: List String) -> String
seFreshVar w avoid = if elem w avoid then seFreshVar (join [w, "'"] "") avoid else w

@label "set-algebra: substSet"
@description "decide-substrate Phase 8μ.1b — the ONE new μ algebra op (design/mu-induction.md §3.1): replace every FREE `SeRef {handle=v}` in `body` with `t`. Capture-avoiding: an inner same-var SeMu SHADOWS (descent stops); an inner binder colliding with a handle of `t` is FRESHENED (α-rename to a primed name) before descent. Leaves (SeAll/SeNone/SeEnum/SeInterval/SePattern/SeWhere/non-matching SeRef) unchanged — SePattern is NOT rewritten (seMuSupported fences bodies whose var hides in a pattern). Structural recursion elsewhere (SeCtor fields / SeUnion / SeIntersect / SeDiff / SeComplement / SeMu)."
@tags "engine" "set-algebra" "mu" "substSet" "decide-substrate" "phase-8mu"
substSet : (v: String) -> (t: SetExpr) -> (body: SetExpr) -> SetExpr
substSet v t body = case body of
  SeRef { handle = h } -> if eq h v then t else body
  SeCtor { ctor = c, fields = fs } ->
    let nfs = map (\f -> substSetField v t f) fs
    SeCtor { ctor = c, fields = nfs }
  SeMu { var = w, body = b } -> substMuArm v t w b
  SeArrow { params = ps, returns = r } ->
    let nps = map (\p -> substArrowParam v t p) ps
    let nr = substSet v t r
    SeArrow { params = nps, returns = nr }
  SeUnion { branches = bs } ->
    let nbs = map (\s -> substSet v t s) bs
    SeUnion { branches = nbs }
  SeIntersect { branches = bs } ->
    let nbs = map (\s -> substSet v t s) bs
    SeIntersect { branches = nbs }
  SeDiff { left = l, right = r } ->
    let nl = substSet v t l
    let nr = substSet v t r
    SeDiff { left = nl, right = nr }
  SeComplement { inner = i } ->
    let ni = substSet v t i
    SeComplement { inner = ni }
  -- signature-substrate Phase 4 slice 3a — a rigid is INERT under μ-var
  -- substitution: it is a leaf with no SetExpr child and no SeRef occurrence,
  -- so returning it unchanged is exact. (A rigid is never a μ binder — see the
  -- μ-collapse note on the constructor.)
  SeRigid {} -> body
  _ -> body

@label "set-algebra: substSetField"
@description "decide-substrate Phase 8μ.1b — substSet through one SetCtorField (rebuild with the substituted set). Internal helper to substSet's SeCtor arm."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
substSetField : (v: String) -> (t: SetExpr) -> (f: SetCtorField) -> SetCtorField
substSetField v t f =
  let s2 = substSet v t f.set
  SetCtorField { key = f.key, wireName = f.wireName, set = s2 }

@label "set-algebra: substArrowParam"
@description "decide-substrate Phase 8λ.1 — substSet through one SetArrowParam (rebuild with the substituted set). Internal helper to substSet's SeArrow arm."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8lambda"
@category "engine-internal"
substArrowParam : (v: String) -> (t: SetExpr) -> (p: SetArrowParam) -> SetArrowParam
substArrowParam v t p =
  let s2 = substSet v t p.set
  SetArrowParam { key = p.key, wireName = p.wireName, set = s2 }

@label "set-algebra: substMuArm"
@description "decide-substrate Phase 8μ.1b — substSet's SeMu arm: same-var ⇒ SHADOWED (return unchanged — the inner binder rebinds v); colliding binder (w occurs among t's handles) ⇒ freshen w to a primed w', α-rename the inner body (substSet w (SeRef w') b — capture-free since w' is fresh against t, b and v), then continue substituting v; else plain descent. Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
substMuArm : (v: String) -> (t: SetExpr) -> (w: String) -> (b: SetExpr) -> SetExpr
substMuArm v t w b =
  if eq w v
  then SeMu { var = w, body = b }
  else
    let tHandles = seRefHandles t []
    if elem w tHandles
    then
      let avoid = concat tHandles (concat (seRefHandles b []) (appendItem v []))
      let w2 = seFreshVar (join [w, "'"] "") avoid
      let renamed = SeRef { handle = w2 }
      let rb = substSet w renamed b
      let nb = substSet v t rb
      SeMu { var = w2, body = nb }
    else
      let nb = substSet v t b
      SeMu { var = w, body = nb }

@label "set-algebra: sePositive"
@description "decide-substrate Phase 8μ.1b — the POSITIVITY check (design/mu-induction.md §1, the load-bearing Park soundness side-condition): the μ-var `v` occurs in `s` only at EVEN negation-parity. The only negative formers are SeComplement.inner and SeDiff.right (parity flips under each); union/intersect branches and SeCtor field sets preserve parity; an inner same-var SeMu shadows. A SeMu failing this is non-monotone ⇒ every μ face degrades to Nothing (and the 8μ.2 Park rule will REJECT it)."
@tags "engine" "set-algebra" "mu" "positivity" "decide-substrate" "phase-8mu"
sePositive : (v: String) -> (s: SetExpr) -> Boolean
sePositive v s = sePositiveP v s true

@label "set-algebra: sePositiveP"
@description "decide-substrate Phase 8μ.1b — the parity walk of sePositive (parity true = positive position). SeRef{v} at negative parity ⇒ false. Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "positivity" "decide-substrate" "phase-8mu"
@category "engine-internal"
sePositiveP : (v: String) -> (s: SetExpr) -> (parity: Boolean) -> Boolean
sePositiveP v s parity = case s of
  SeRef { handle = h } -> if eq h v then parity else true
  SeComplement { inner = i } -> sePositiveP v i (not parity)
  SeDiff { left = l, right = r } ->
    if sePositiveP v l parity then sePositiveP v r (not parity) else false
  SeUnion { branches = bs } -> sePositiveAll v bs parity
  SeIntersect { branches = bs } -> sePositiveAll v bs parity
  SeCtor { fields = fs } -> sePositiveFields v fs parity
  SeMu { var = w, body = b } -> if eq w v then true else sePositiveP v b parity
  -- decide-substrate Phase 8λ.1 (surprise 4 — the load-bearing μ×λ soundness arm):
  -- SeArrow PARAM positions are CONTRAVARIANT ⇒ FLIPPED parity (the negative
  -- occurrence — a `μX. X→A` nests its var at NEGATIVE parity ⇒ non-monotone ⇒
  -- Park UNSOUND, so this arm makes sePositive REJECT it); RETURN is covariant ⇒
  -- SAME parity. Without this arm the former would fall to `_ -> true` and WRONGLY
  -- accept a non-monotone body.
  SeArrow { params = ps, returns = r } ->
    if sePositiveArrowParams v ps (not parity) then sePositiveP v r parity else false
  -- signature-substrate Phase 4 slice 3a — the μ var cannot occur inside a
  -- rigid (leaf, no SetExpr child), so every occurrence count is zero and the
  -- body is vacuously monotone in v at this position. Exact, not permissive.
  SeRigid {} -> true
  _ -> true

@label "set-algebra: sePositiveAll"
@description "decide-substrate Phase 8μ.1b — sePositiveP over every branch of a union/intersect (same parity). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "positivity" "decide-substrate" "phase-8mu"
@category "engine-internal"
sePositiveAll : (v: String) -> (bs: List SetExpr) -> (parity: Boolean) -> Boolean
sePositiveAll v bs parity = case head bs of
  Nothing -> true
  Just b -> if sePositiveP v b parity then sePositiveAll v (eufRest bs) parity else false

@label "set-algebra: sePositiveFields"
@description "decide-substrate Phase 8μ.1b — sePositiveP over every SeCtor field set (same parity — ADT fields are covariant positions). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "positivity" "decide-substrate" "phase-8mu"
@category "engine-internal"
sePositiveFields : (v: String) -> (fs: List SetCtorField) -> (parity: Boolean) -> Boolean
sePositiveFields v fs parity = case head fs of
  Nothing -> true
  Just f -> if sePositiveP v f.set parity then sePositiveFields v (eufRest fs) parity else false

@label "set-algebra: sePositiveArrowParams"
@description "decide-substrate Phase 8λ.1 — sePositiveP over every SeArrow param set (the caller passes the ALREADY-FLIPPED parity — param positions are contravariant). Every param must be positive at the flipped parity. Internal helper to sePositiveP's SeArrow arm."
@tags "engine" "internal" "set-algebra" "mu" "positivity" "decide-substrate" "phase-8lambda"
@category "engine-internal"
sePositiveArrowParams : (v: String) -> (ps: List SetArrowParam) -> (parity: Boolean) -> Boolean
sePositiveArrowParams v ps parity = case head ps of
  Nothing -> true
  Just p -> if sePositiveP v p.set parity then sePositiveArrowParams v (eufRest ps) parity else false

@label "set-algebra: seVarOccurs"
@description "decide-substrate Phase 8μ.1b — does the μ-var `v` occur FREE anywhere in `s`, INCLUDING inside SePattern subtrees (SpMatch.pred / SpGroup.type — the deep walk substSet does not rewrite)? Inner same-var SeMu shadows. Internal helper to seMuSupported / seVarInPat."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seVarOccurs : (v: String) -> (s: SetExpr) -> Boolean
seVarOccurs v s = case s of
  SeRef { handle = h } -> eq h v
  SePattern { pattern = p } -> seVarInPat v p
  SeCtor { fields = fs } -> seVoFields v fs
  SeMu { var = w, body = b } -> if eq w v then false else seVarOccurs v b
  SeArrow { params = ps, returns = r } -> if seVoArrowParams v ps then true else seVarOccurs v r
  SeUnion { branches = bs } -> seVoList v bs
  SeIntersect { branches = bs } -> seVoList v bs
  SeDiff { left = l, right = r } -> if seVarOccurs v l then true else seVarOccurs v r
  SeComplement { inner = i } -> seVarOccurs v i
  -- signature-substrate Phase 4 slice 3a — leaf, no SetExpr child ⇒ the μ var
  -- never occurs inside a rigid. Exact.
  SeRigid {} -> false
  _ -> false

@label "set-algebra: seVoList"
@description "decide-substrate Phase 8μ.1b — seVarOccurs over a branch list (any). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seVoList : (v: String) -> (bs: List SetExpr) -> Boolean
seVoList v bs = case head bs of
  Nothing -> false
  Just b -> if seVarOccurs v b then true else seVoList v (eufRest bs)

@label "set-algebra: seVoFields"
@description "decide-substrate Phase 8μ.1b — seVarOccurs over a SeCtor field list (any field set). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seVoFields : (v: String) -> (fs: List SetCtorField) -> Boolean
seVoFields v fs = case head fs of
  Nothing -> false
  Just f -> if seVarOccurs v f.set then true else seVoFields v (eufRest fs)

@label "set-algebra: seVoArrowParams"
@description "decide-substrate Phase 8λ.1 — seVarOccurs over a SeArrow param list (any param's set). Internal helper to seVarOccurs' SeArrow arm."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seVoArrowParams : (v: String) -> (ps: List SetArrowParam) -> Boolean
seVoArrowParams v ps = case head ps of
  Nothing -> false
  Just p -> if seVarOccurs v p.set then true else seVoArrowParams v (eufRest ps)

@label "set-algebra: seVarInPat"
@description "decide-substrate Phase 8μ.1b — does the μ-var occur inside a SetPattern (SpMatch.pred and SpGroup.type carry SetExprs; SpSeq/SpAlt/SpRep recurse)? Internal helper to seVarOccurs / seVarUnderPattern."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seVarInPat : (v: String) -> (p: SetPattern) -> Boolean
seVarInPat v p = case p of
  SpMatch { pred = s } -> seVarOccurs v s
  SpSeq { a = x, b = y } -> if seVarInPat v x then true else seVarInPat v y
  SpAlt { a = x, b = y } -> if seVarInPat v x then true else seVarInPat v y
  SpRep { child = c } -> seVarInPat v c
  SpGroup { child = c, type = mt } ->
    if seVarInPat v c
    then true
    else case mt of
      Just s -> seVarOccurs v s
      Nothing -> false
  _ -> false

@label "set-algebra: seVarUnderPattern"
@description "decide-substrate Phase 8μ.1b — does the μ-var occur inside some SePattern SUBTREE of `s` (the positions substSet cannot rewrite)? Structural walk; at a SePattern node the pattern-embedded SetExprs are searched via seVarInPat. Internal helper to seMuSupported."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seVarUnderPattern : (v: String) -> (s: SetExpr) -> Boolean
seVarUnderPattern v s = case s of
  SePattern { pattern = p } -> seVarInPat v p
  SeCtor { fields = fs } -> seVupFields v fs
  SeMu { var = w, body = b } -> if eq w v then false else seVarUnderPattern v b
  SeArrow { params = ps, returns = r } -> if seVupArrowParams v ps then true else seVarUnderPattern v r
  SeUnion { branches = bs } -> seVupList v bs
  SeIntersect { branches = bs } -> seVupList v bs
  SeDiff { left = l, right = r } -> if seVarUnderPattern v l then true else seVarUnderPattern v r
  SeComplement { inner = i } -> seVarUnderPattern v i
  -- signature-substrate Phase 4 slice 3a — leaf, no SetPattern child. Exact.
  SeRigid {} -> false
  _ -> false

@label "set-algebra: seVupList"
@description "decide-substrate Phase 8μ.1b — seVarUnderPattern over a branch list (any). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seVupList : (v: String) -> (bs: List SetExpr) -> Boolean
seVupList v bs = case head bs of
  Nothing -> false
  Just b -> if seVarUnderPattern v b then true else seVupList v (eufRest bs)

@label "set-algebra: seVupFields"
@description "decide-substrate Phase 8μ.1b — seVarUnderPattern over a SeCtor field list (any field set). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seVupFields : (v: String) -> (fs: List SetCtorField) -> Boolean
seVupFields v fs = case head fs of
  Nothing -> false
  Just f -> if seVarUnderPattern v f.set then true else seVupFields v (eufRest fs)

@label "set-algebra: seVupArrowParams"
@description "decide-substrate Phase 8λ.1 — seVarUnderPattern over a SeArrow param list (any param's set — a SePattern nested under an arrow param whose predicate hides the μ-var is a substSet-unreachable position, so seMuSupported must see it). Internal helper to seVarUnderPattern's SeArrow arm."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seVupArrowParams : (v: String) -> (ps: List SetArrowParam) -> Boolean
seVupArrowParams v ps = case head ps of
  Nothing -> false
  Just p -> if seVarUnderPattern v p.set then true else seVupArrowParams v (eufRest ps)

@label "set-algebra: seMuSupported"
@description "decide-substrate Phase 8μ.1b — the substitution-supported check: the μ-var does NOT occur inside any SePattern subtree of the body (substSet cannot rewrite those positions, so a substitution would silently miss occurrences — the leftover SeRef would then leak to the closed-world namedMember and could return a WRONG definite answer). Unsupported ⇒ every μ face returns Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seMuSupported : (v: String) -> (body: SetExpr) -> Boolean
seMuSupported v body = not (seVarUnderPattern v body)

@label "set-algebra: seMuFaceOk"
@description "decide-substrate Phase 8μ.1b — the shared μ-face gate: positive (Park soundness / well-defined least fixpoint) ∧ supported (substitution reaches every occurrence). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seMuFaceOk : (v: String) -> (body: SetExpr) -> Boolean
seMuFaceOk v body = and (sePositive v body) (seMuSupported v body)

@label "set-algebra: seMuGuarded"
@description "decide-substrate Phase 8μ.1b — the PRODUCTIVITY (guardedness) condition for μ value-membership: every free occurrence of the μ-var sits inside some SetCtorField.set (a SeCtor node guards everything below it — reaching an occurrence costs one constructor layer of the value ⇒ the unroll-once descent terminates on finite values WITHOUT fuel). A naked occurrence (μX.(X ∪ {1})) is unguarded ⇒ membership degrades to Nothing (termination guard, never a loop). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seMuGuarded : (v: String) -> (s: SetExpr) -> Boolean
seMuGuarded v s = case s of
  SeRef { handle = h } -> not (eq h v)
  SeCtor { ctor = _ } -> true
  SeMu { var = w, body = b } -> if eq w v then true else seMuGuarded v b
  -- 8λ.1 — a SeArrow is NOT a value-descent constructor layer (an arrow value is
  -- not structurally descended by contains), so a μ-var occurring NAKEDLY under an
  -- arrow param/return is UNGUARDED (μ value-membership degrades to Nothing — the
  -- honest termination fence). Recurse params + returns like a union branch.
  SeArrow { params = ps, returns = r } -> if seMgArrowParams v ps then seMuGuarded v r else false
  SeUnion { branches = bs } -> seMgList v bs
  SeIntersect { branches = bs } -> seMgList v bs
  SeDiff { left = l, right = r } -> if seMuGuarded v l then seMuGuarded v r else false
  SeComplement { inner = i } -> seMuGuarded v i
  -- signature-substrate Phase 4 slice 3a — a rigid is a leaf, never a NAKED
  -- occurrence of the μ var, so it does not unguard the fixpoint. Exact (this
  -- is the same reasoning as the `SeCtor -> true` arm, not the permissive
  -- default).
  SeRigid {} -> true
  _ -> true

@label "set-algebra: seMgList"
@description "decide-substrate Phase 8μ.1b — seMuGuarded over every branch of a union/intersect. Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seMgList : (v: String) -> (bs: List SetExpr) -> Boolean
seMgList v bs = case head bs of
  Nothing -> true
  Just b -> if seMuGuarded v b then seMgList v (eufRest bs) else false

@label "set-algebra: seMgArrowParams"
@description "decide-substrate Phase 8λ.1 — seMuGuarded over a SeArrow param list (every param set must be guarded). Internal helper to seMuGuarded's SeArrow arm."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seMgArrowParams : (v: String) -> (ps: List SetArrowParam) -> Boolean
seMgArrowParams v ps = case head ps of
  Nothing -> true
  Just p -> if seMuGuarded v p.set then seMgArrowParams v (eufRest ps) else false

@label "set-algebra: seSize"
@description "decide-substrate Phase 8μ.1b — structural node count of a SetExpr (the Kleene-iterate SIZE guard — the rung's depth/fuel discipline bounds BOTH the iterate count AND the iterate size, since each substitution can duplicate the body per occurrence). Internal helper to seWitnessMu."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seSize : (s: SetExpr) -> Number
seSize s = case s of
  SeCtor { fields = fs } -> add 1 (seSizeFields fs)
  SeMu { body = b } -> add 1 (seSize b)
  SeArrow { params = ps, returns = r } -> add 1 (add (seSizeArrowParams ps) (seSize r))
  SeUnion { branches = bs } -> add 1 (seSizeList bs)
  SeIntersect { branches = bs } -> add 1 (seSizeList bs)
  SeDiff { left = l, right = r } -> add 1 (add (seSize l) (seSize r))
  SeComplement { inner = i } -> add 1 (seSize i)
  -- signature-substrate Phase 4 slice 3a — a rigid is one leaf node. Exact.
  SeRigid {} -> 1
  _ -> 1

@label "set-algebra: seSizeList"
@description "decide-substrate Phase 8μ.1b — seSize summed over a branch list. Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seSizeList : (bs: List SetExpr) -> Number
seSizeList bs = case head bs of
  Nothing -> 0
  Just b -> add (seSize b) (seSizeList (eufRest bs))

@label "set-algebra: seSizeFields"
@description "decide-substrate Phase 8μ.1b — seSize summed over a SeCtor field list (each field's set). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8mu"
@category "engine-internal"
seSizeFields : (fs: List SetCtorField) -> Number
seSizeFields fs = case head fs of
  Nothing -> 0
  Just f -> add (seSize f.set) (seSizeFields (eufRest fs))

@label "set-algebra: seSizeArrowParams"
@description "decide-substrate Phase 8λ.1 — seSize summed over a SeArrow param list (each param's set). Internal helper to seSize's SeArrow arm."
@tags "engine" "internal" "set-algebra" "mu" "decide-substrate" "phase-8lambda"
@category "engine-internal"
seSizeArrowParams : (ps: List SetArrowParam) -> Number
seSizeArrowParams ps = case head ps of
  Nothing -> 0
  Just p -> add (seSize p.set) (seSizeArrowParams (eufRest ps))

-- ── the μ EMPTINESS face ─────────────────────────────────────────────────────
@label "set-algebra: muEmpty"
@description "decide-substrate Phase 8μ.1b — the μ emptiness face: `empty(μv.F) ⟺ empty(F[v:=∅])` (design/mu-induction.md §0.2 — one substitution, then the ordinary judgment; NO kernel change). Soundness needs F monotone ⇒ gated on positive ∧ supported (else Nothing). Terminates: μ-nesting depth strictly decreases per unwrap (substituting ∅ introduces no SeMu). `empty(μX.X) = Just true`; `empty(⟦List a⟧) = Just false` (the nullary Nil — the 8μ.1a SeCtor arm composes); `empty(μX.Cons{tail:X}) = Just true` (no base case). Internal helper to setAlgebraDecideEmptyCore."
@tags "engine" "internal" "set-algebra" "mu" "empty" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuEmpty : (v: String) -> (f: SetExpr) -> Maybe Boolean
setAlgebraMuEmpty v f =
  if seMuFaceOk v f
  then
    let bot = SeNone
    setAlgebraDecideEmpty (substSet v bot f)
  else Nothing

-- ── the μ MEMBERSHIP face ────────────────────────────────────────────────────
@label "set-algebra: muContains"
@description "decide-substrate Phase 8μ.1b — the μ value-membership face: `{w} ⊆ μv.F` by UNROLL-ONCE + structural descent (design/mu-induction.md §0.4) — contains(F[v := μv.F], w); the recursion re-enters this arm only through a SeCtor field (GUARDEDNESS) with a strictly smaller sub-value ⇒ terminates on finite values without fuel. Gated on positive ∧ supported ∧ guarded (an unguarded body like μX.(X ∪ {1}) ⇒ Nothing — the termination guard). Internal helper to setAlgebraContains."
@tags "engine" "internal" "set-algebra" "mu" "contains" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuContains : (v: String) -> (f: SetExpr) -> (value: Any) -> Maybe Boolean
setAlgebraMuContains v f value =
  if and (seMuFaceOk v f) (seMuGuarded v f)
  then
    let whole = SeMu { var = v, body = f }
    setAlgebraContains (substSet v whole f) value
  else Nothing

-- ============================================================================
-- decide-substrate Phase 8μ.2 — the Park (Knaster-Tarski) SUBSET arms + the
-- b-side bounded unroll. `F[X:=T] ⊆ T ⟹ μX.F ⊆ T` for monotone F. FUEL-CARRYING
-- (a fresh budget of 4 seeded per public isSubset entry — the D′ fixed-fuel
-- posture, NO caller dial); the public setAlgebraIsSubset signature is UNCHANGED
-- (the SeMu route in setAlgebraDecideLeafSubset + the b=SeMu arm in
-- setAlgebraSubsetTailRules seed the fuel). Guardrails held EXACTLY:
--   • ONLY PROVES — a failed premise / unroll is Nothing, NEVER Just false. Park
--     is a PROOF rule; a failed premise does not refute (T may still contain
--     μX.F non-inductively — same posture as the named-subtype decider). The two
--     μ arms (muParkLeft / muUnrollRight) collapse every non-`Just true` to
--     Nothing.
--   • SOUNDNESS via POSITIVITY — every μ arm gates seMuFaceOk (positive ∧
--     supported ⇒ F monotone ⇒ the least fixpoint is well-defined ⇒ Park sound;
--     a non-positive μ ⇒ Nothing, never a false accept).
--   • TERMINATION via FUEL — the fuel strictly decrements at every Park premise
--     re-check AND every right-μ unroll; exhaustion (fuel ≤ 0) ⇒ Nothing. deepEq
--     reflexivity is tried FIRST at every level (it bottoms the recursive tails
--     `T ⊆ T` cheaply, so real ADT covariance converges in ~2 fuel; the fuel is
--     the safety bound for pathological non-reflexive nests).
--   • The kernel RE-DERIVES the premise via substSet — it never trusts a
--     supplied one (design/mu-induction.md §0.1). Both arms substitute here too.
-- design/mu-induction.md §0.1/§0.5/§3.2/§3.3.
-- ============================================================================

@label "set-algebra: muSubset"
@description "decide-substrate Phase 8μ.2 — the fuel-carrying Park/unroll subset entry: ⟦a⟧ ⊆ ⟦b⟧ with a fuel budget for μ-unrolling. deepEq reflexivity first (bottoms recursive `T ⊆ T` tails), then ∅ ⊆ b / a ⊆ ⊤ shortcuts, then dispatch on a (muSubsetA). ONLY proves — every non-Just-true collapses to Nothing at the Park/unroll boundaries (a failed premise never refutes). Internal helper (seeded fuel 4 from the public subset arms; the a-SeMu route in setAlgebraDecideLeafSubset + the b-SeMu arm in setAlgebraSubsetTailRules)."
@tags "engine" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
setAlgebraMuSubset : (a: SetExpr) -> (b: SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubset a b fuel =
  if setSemanticEq a b
  then Just true
  else case a of
    SeNone -> Just true
    _ -> case b of
      SeAll -> Just true
      _ -> setAlgebraMuSubsetA a b fuel

@label "set-algebra: muSubsetA"
@description "decide-substrate Phase 8μ.2 — the a-dispatch of the Park subset entry (after reflexivity / ∅ / ⊤ shortcuts): SeMu ⇒ the a-side Park rule (muParkLeft); SeUnion ⇒ every branch ⊆ b (muSubEvery); SeIntersect ⇒ some branch ⊆ b (sound shortcut, muSubIntersect); SeCtor ⇒ fieldwise/unroll/split (muSubCtorA); SeEnum ⇒ per-value membership loop (setAlgebraEnumSubsetMembers — μ value-membership terminates on finite values, no fuel); a plain leaf ⇒ dispatch on b (muSubRight). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubsetA : (a: SetExpr) -> (b: SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubsetA a b fuel = case a of
  SeMu { var = v, body = f } -> setAlgebraMuParkLeft v f b fuel
  SeUnion { branches = bs } -> setAlgebraMuSubEvery bs b fuel false
  SeIntersect { branches = bs } -> setAlgebraMuSubIntersect bs b fuel
  SeCtor { ctor = _ } -> setAlgebraMuSubCtorA a b fuel
  SeEnum { values = vs } -> setAlgebraEnumSubsetMembers b vs false
  _ -> setAlgebraMuSubRight a b fuel

@label "set-algebra: muSubRight"
@description "decide-substrate Phase 8μ.2 — the b-dispatch for a PLAIN-leaf a (interval / ref / pattern / where): SeMu ⇒ the b-side bounded unroll (muUnrollRight); SeUnion ⇒ a ⊆ some branch (muSubSome); SeIntersect ⇒ a ⊆ every branch (muSubAll); else the ordinary μ-free leaf decision (setAlgebraIsSubset — a, b both non-μ leaves, terminates). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubRight : (a: SetExpr) -> (b: SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubRight a b fuel = case b of
  SeMu { var = w, body = g } -> setAlgebraMuUnrollRight a w g b fuel
  SeUnion { branches = bs } -> setAlgebraMuSubSome a bs fuel
  SeIntersect { branches = bs } -> setAlgebraMuSubAll a bs fuel
  _ -> setAlgebraIsSubset a b

@label "set-algebra: muParkLeft"
@description "decide-substrate Phase 8μ.2 — THE a-side Park rule: subset(μv.F, T). Gate seMuFaceOk (positivity ⇒ monotone ⇒ Park sound) and fuel > 0; RE-DERIVE the premise F[v:=T] via substSet (never trusts a supplied premise); re-check isSubset (F[v:=T]) T with fuel-1 through the fuel entry. Just true ⇒ Just true; anything else ⇒ Nothing (ONLY proves — a failed premise does not refute). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuParkLeft : (v: String) -> (f: SetExpr) -> (b: SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuParkLeft v f b fuel =
  if not (seMuFaceOk v f)
  then Nothing
  else if lte fuel 0
  then Nothing
  else case setAlgebraMuSubset (substSet v b f) b (sub fuel 1) of
    Just true -> Just true
    _ -> Nothing

@label "set-algebra: muUnrollRight"
@description "decide-substrate Phase 8μ.2 — the b-side bounded unroll: subset(S, μw.G). The equi-recursive identity μw.G = G[w := μw.G] exposed ONLY here (arms-only, NOT a normalize rewrite — design §3.3). Gate seMuFaceOk (w positive in G) and fuel > 0; re-check isSubset S (G[w := μw.G]) with fuel-1. Just true ⇒ Just true; else Nothing (same only-prove posture). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuUnrollRight : (a: SetExpr) -> (w: String) -> (g: SetExpr) -> (b: SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuUnrollRight a w g b fuel =
  if not (seMuFaceOk w g)
  then Nothing
  else if lte fuel 0
  then Nothing
  else case setAlgebraMuSubset a (substSet w b g) (sub fuel 1) of
    Just true -> Just true
    _ -> Nothing

@label "set-algebra: muSubEvery"
@description "decide-substrate Phase 8μ.2 — a-Union ⊆ b: every branch ⊆ b (fuel threaded, same fuel per branch — union is finite/structural, the μ step inside decrements). Just false ⇒ Just false (a branch decidably out); all Just true ⇒ Just true; any Nothing (no Just false) ⇒ Nothing. Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubEvery : (branches: List SetExpr) -> (b: SetExpr) -> (fuel: Number) -> (sawNothing: Boolean) -> Maybe Boolean
setAlgebraMuSubEvery branches b fuel sawNothing = case head branches of
  Nothing -> if sawNothing then Nothing else Just true
  Just first ->
    case setAlgebraMuSubset first b fuel of
      Just false -> Just false
      Just true ->
        case tail branches of
          Nothing -> if sawNothing then Nothing else Just true
          Just rest -> setAlgebraMuSubEvery rest b fuel sawNothing
      Nothing ->
        case tail branches of
          Nothing -> Nothing
          Just rest -> setAlgebraMuSubEvery rest b fuel true

@label "set-algebra: muSubIntersect"
@description "decide-substrate Phase 8μ.2 — a-Intersect ⊆ b: a SOUND shortcut — if SOME branch is ⊆ b, the whole intersection is ⊆ b. Any Just true ⇒ Just true; else Nothing (only proves). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubIntersect : (branches: List SetExpr) -> (b: SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubIntersect branches b fuel = case head branches of
  Nothing -> Nothing
  Just first ->
    case setAlgebraMuSubset first b fuel of
      Just true -> Just true
      _ -> setAlgebraMuSubIntersect (eufRest branches) b fuel

@label "set-algebra: muSubSome"
@description "decide-substrate Phase 8μ.2 — a ⊆ (b1 ∪ b2 …): a ⊆ SOME branch (fuel threaded). Any Just true ⇒ Just true; else Nothing (only proves — never refutes on all-fail). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubSome : (a: SetExpr) -> (branches: List SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubSome a branches fuel = case head branches of
  Nothing -> Nothing
  Just first ->
    case setAlgebraMuSubset a first fuel of
      Just true -> Just true
      _ -> setAlgebraMuSubSome a (eufRest branches) fuel

@label "set-algebra: muSubAll"
@description "decide-substrate Phase 8μ.2 — a ⊆ (b1 ∩ b2 …): a ⊆ EVERY branch (fuel threaded). All Just true ⇒ Just true; any non-true ⇒ Nothing (only proves). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubAll : (a: SetExpr) -> (branches: List SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubAll a branches fuel = case head branches of
  Nothing -> Just true
  Just first ->
    case setAlgebraMuSubset a first fuel of
      Just true -> setAlgebraMuSubAll a (eufRest branches) fuel
      _ -> Nothing

@label "set-algebra: muSubCtorA"
@description "decide-substrate Phase 8μ.2 — a-SeCtor ⊆ b: b a SeCtor ⇒ fuel-threaded fieldwise (muSubCtorCtor, so a μ TAIL field threads fuel); b a SeMu ⇒ the b-side unroll (the Nil/Cons ⊆ μ premise decomposition — muUnrollRight); b a SeUnion ⇒ a ⊆ some branch (the unrolled `Nil | Cons` split); b a SeIntersect ⇒ a ⊆ every branch; else the ordinary μ-free leaf decision. Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubCtorA : (a: SetExpr) -> (b: SetExpr) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubCtorA a b fuel = case a of
  SeCtor { ctor = ac, fields = afs } ->
    case b of
      SeCtor { ctor = bc, fields = bfs } -> setAlgebraMuSubCtorCtor ac afs bc bfs fuel
      SeMu { var = w, body = g } -> setAlgebraMuUnrollRight a w g b fuel
      SeUnion { branches = bs } -> setAlgebraMuSubSome a bs fuel
      SeIntersect { branches = bs } -> setAlgebraMuSubAll a bs fuel
      _ -> setAlgebraIsSubset a b
  _ -> Nothing

@label "set-algebra: muSubCtorCtor"
@description "decide-substrate Phase 8μ.2 / type-substrate P1(a) — SeCtor a ⊆ SeCtor b under Park: either side outside the judgment fence (seCtorFieldsFenceOk — added for FACE AGREEMENT, so a reserved/aliased-wire operand cannot get a definite ⊆ from the μ face while mem/emp/dis/sub all answer Nothing) ⇒ Nothing; a coercing ctor (True/False) ⇒ Nothing (Bool stays the enum); DISTINCT ctors ⇒ Nothing (ONLY proves — a Park-context ctor mismatch abstains, it never refutes, so the union `some` moves on to the matching ctor); SAME ctor ⇒ fuel-threaded fieldwise ⊆ (the covariant injectivity rule, muSubCtorFields). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubCtorCtor : (ac: String) -> (afs: List SetCtorField) -> (bc: String) -> (bfs: List SetCtorField) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubCtorCtor ac afs bc bfs fuel =
  if or (not (seCtorFieldsFenceOk afs)) (not (seCtorFieldsFenceOk bfs))
  then Nothing
  else if or (seCtorCoercing ac) (seCtorCoercing bc)
  then Nothing
  else if not (eq ac bc)
  then Nothing
  else setAlgebraMuSubCtorFields afs bfs fuel

@label "set-algebra: muSubCtorFields"
@description "decide-substrate Phase 8μ.2 / field-identity Phase 3 / type-substrate P1(a) — fieldwise ⊆ under Park, iterated over the WANT side (the μ twin of the ordinary loop's width repair; fuel threaded so a μ tail field re-enters the fuel entry): for every b-field find the a-field carrying the same semantic key and decide via setAlgebraMuSubset (SAME fuel — the μ step inside decrements). All Just true ⇒ Just true; a want key absent on the have side, an aligned pair whose RESOLVED wires disagree, or any non-true ⇒ Nothing (only-proves posture preserved). Internal helper."
@tags "engine" "internal" "set-algebra" "mu" "park" "subset" "decide-substrate" "phase-8mu"
@category "engine-internal"
setAlgebraMuSubCtorFields : (afs: List SetCtorField) -> (bfs: List SetCtorField) -> (fuel: Number) -> Maybe Boolean
setAlgebraMuSubCtorFields afs bfs fuel = case head bfs of
  Nothing -> Just true
  Just bf ->
    case seCtorFindField afs bf.key of
      Nothing -> Nothing
      Just af ->
        if not (eq (seCtorFieldReadWire af) (seCtorFieldReadWire bf))
        then Nothing
        else case setAlgebraMuSubset af.set bf.set fuel of
          Just true -> setAlgebraMuSubCtorFields afs (eufRest bfs) fuel
          _ -> Nothing

-- ============================================================================
-- Phase 7c-continuation sub-step 2 — whereToSetExpr top-level dispatcher.
--
-- The body operates on a JsonLogicExpr ADT pre-marshalled at the TS
-- boundary. The marshaller pre-inlines function calls TS-side (depth ≤ 4
-- per WHERE_INLINE_MAX_DEPTH), then pre-classifies the AST shape into one
-- of seven typed variants:
--
--   JleAnd children      — {and: [...]}; body folds Maybe<WhereExtractedSet>
--                          with short-circuit
--   JleOr  children      — {or: [...]};   same, emits WesUnion at top
--   JleNot inner         — {!: [child]};  emits WesComplement
--   JleModEq name        — {==: [{%: [{var: "value"}, N]}, 0]} —
--                          pre-formatted as "multiple:N"
--   JleComp { op, value, varSide, isNumeric }
--                        — comparison with var on one side + literal on the
--                          other; body delegates to compToSet
--   JleIn values         — {in: [{var: "value"}, [vals...]]}; emits WesEnum
--   JleOther             — non-extractable; body returns Nothing
--
-- Output: Maybe<WhereExtractedSet>. WhereExtractedSet is an intent-marker
-- tree that the TS wrapper unmarshals to a raw SetExpr (calling TS-side
-- `normalize` for the WesIntersect arm — same separation as the recursive
-- SetExprAdt deciders).
--
-- The JS-shape inspectors that the original TS impl used inline
-- (isValueVar / valueAggVar / aggCallFn / isComparable / substituteVars)
-- stay in the TS marshaller — per the 7b sub-step 3 / 7c sub-step 2
-- cost-benefit precedent, the body has no genuine Fenel reasoning to add
-- on top of pre-classified AST shapes.
-- ============================================================================

-- JsonLogicExpr — pre-classified JSON Logic AST view for the `$where`
-- extraction (comprehendWhere, comprehend.fenel — the whereToSetExpr
-- successor, decide-substrate Phase 1 Stage A). `JleExpr` is the NEUTRAL
-- fall-through the marshal emits when no JSON-Logic-specific arm fires: the
-- subtree lifted to the core `Expr` via the live jsonLogicToExpr, routed
-- through `comprehend` (the arm through which the `$where` path inherits
-- the P12 affine inversion). `JleComp` is legacy — the marshal no longer
-- emits it (comparisons ride JleExpr) — kept on the ADT for the law-freeze
-- + handled faithfully by comprehendWhere's reconstruction arm.
JsonLogicExpr =
  JleAnd children: a
  | JleOr children: a
  | JleNot inner: a
  | JleModEq name: a
  | JleComp op: a value: a varSide: a isNumeric: a
  | JleIn values: a
  | JleExpr expr: a
  | JleOther

-- (WhereExtractedSet / Wes* — RETIRED, decide-substrate Phase 3. The last
-- marker vocabulary in the deciders. Its only surviving producer was the
-- Aggregable-composition lift (recognizeAggregableComposition), which now emits
-- the canonical `Se*` SetExpr directly (outputSet is a real SetExpr the Se*
-- deciders reason over); the TS `unmarshalWhereExtractedSet` +
-- `WhereExtractedSetMarshalled` are deleted with it. The measured law-count
-- delta is documented in the roadmap Phase-3 completion note.)

-- ============================================================================
-- (whereToSetExpr + the wts* fold family — RETIRED, decide-substrate Phase 1
-- Stage A. The `$where` extraction is now `engine:comprehendWhere`
-- (comprehend.fenel), which routes every non-JSON-Logic-specific leaf through
-- the ONE recognizer `comprehend` and emits the canonical `Se*` directly —
-- gaining the P12 affine inversion the old walker fenced. The 0/1/n and/or
-- shortcuts live on in cphwAnd/cphwOr, byte-faithful. `compToSet` + Cts*
-- below STAY — the Aggregable lift's leaf-builder (reconciles in Phase 3).)
-- ============================================================================

-- ============================================================================
-- containment-substrate Phase 1b — normalize (the structural SetExpr
-- simplifier) walks the CANONICAL $tag Se* ADT (set-expr-types.fenel). Ports
-- implementations/typescript/engine/src/set-algebra.ts:normalize (the 6
-- top-level cases: $enum-empty / $where / $union / $intersect / $complement /
-- $diff). The bespoke marshalled NormSetExpr ADT (Nse*) + its TS marshaller /
-- unmarshaller + the 5 `set:norm*` re-entry natives + the
-- `currentNormalizeEvalCtx` stash are GONE: the body recurses over Se* and
-- calls the sibling deciders DIRECTLY — setAlgebraContains / setAlgebraIsSubset
-- / setAlgebraIsDisjoint / isValueOnlyPredicate — plus the EXISTING decider
-- ctx-natives whereExtract ($where pre-extraction, the sanctioned `$`-key
-- boundary dispatchedWhereToSetExpr) and subsetStructEq (the `a \ a = ∅`
-- structural identity, byte-faithful JSON.stringify). dispatchedNormalize
-- routes the body through dispatchSetAlgebraDecider (the Step-3 decider-cut
-- template), so the merged ctx — incl. the eval evalCtx on `_setAlgebraEvalCtx`
-- — reaches every sibling sub-decision (e.g. a value-only `value ∈ Nat` enum
-- filter via the namedMember ctx-native) exactly as the deciders' own recursion
-- does. No SeRef/SeRef split: the `multiple:N` mint is a SeRef minted
-- upstream in whereExtract (unmarshalWhereExtractedSet → buildSetExpr.ref).
--
-- INTERVALS: the canonical SeInterval payload is the RAW interval ({lo, hi} with
-- untagged {value, inclusive} bounds, as setExprToTag yields); the interval-op
-- bodies (mergeIntervals / intersectIntervals / intervalDiff / intervalMinusEnum
-- / inInterval) consume the MARSHALLED Interval ADT (tagged Bounds). So the body
-- classifies (setAlgebraClassifyInterval) raw→marshalled where it reads
-- SeInterval payloads for those ops, and declassifies (declassifyInterval, the
-- faithful inverse of the TS unmarshalInterval) marshalled→raw where it rebuilds
-- SeInterval nodes. exprKey is unused by these ops (only intervalSubset compares
-- it, and the superset-min isSubset reaches it via the tagInterval ctx-native's
-- TS marshalInterval — not the Fenel classify).
--
-- TERMINATION: normalize fully normalizes children first, then re-enters
-- isSubset / isDisjoint / contains only on already-normal subterms. The Fenel
-- intersect subset tail normalizes once and retries only when the shape
-- simplifies; an unchanged SeIntersect terminates in tail rules. The DNF
-- distribution strictly lowers the union count it distributes.
-- ============================================================================

@label "set-algebra: normalize"
@description "containment-substrate Phase 1b — the structural SetExpr simplifier over the canonical $tag Se* ADT (flatten nested unions/intersects, eliminate ∅/⊤, DNF-distribute, dedup, minimize, splay diffs). Mirrors implementations/typescript/engine/src/set-algebra.ts:normalize; calls the sibling deciders / interval bodies directly under the merged ctx."
@tags "engine" "set-algebra" "normalize" "phase-1b"
setAlgebraNormalize : (setExpr: SetExpr) -> SetExpr
setAlgebraNormalize setExpr = case setExpr of
  SeAll -> setExpr
  SeNone -> setExpr
  SeEnum { values = vs } -> if eq (length vs) 0 then SeNone else setExpr
  SeInterval {} -> setExpr
  SeRef {} -> setExpr
  SePattern {} -> setExpr
  SeWhere { pred = p } -> case whereExtract p of
    Just ext -> setAlgebraNormalize ext
    Nothing -> setExpr
  SeUnion { branches = bs } -> setAlgebraNormUnion bs
  SeIntersect { branches = bs } -> setAlgebraNormIntersect bs
  SeComplement { inner = i } -> setAlgebraNormComplement i
  SeDiff { left = a, right = b } -> setAlgebraNormDiff a b
  -- signature-substrate Phase 4 slice 3a — IDENTITY, and deliberately so. A
  -- rigid must survive normalization intact: any collapse (to ∅, to ⊤, to a
  -- named handle) would be a κ-dependent claim, and dropping it would silently
  -- erase the quantified position from the term being checked.
  SeRigid {} -> setExpr
  _ -> setExpr

-- ----------------------------------------------------------------------------
-- $union arm (set-algebra.ts:1707) — normalize children, drop ∅, short-circuit
-- ⊤, flatten, categorize, merge intervals (normMergeIntervals), dedup enums +
-- drop those covered by a merged interval (normInInterval), rebuild.
-- ----------------------------------------------------------------------------

@label "set-algebra: normUnion"
@description "Phase 2c — $union normalization. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormUnion : (bs: List SetExpr) -> SetExpr
setAlgebraNormUnion bs =
  let children = setAlgebraNormMapDropNone bs
  if setAlgebraNormAnyAll children
  then SeAll
  else
    let flat = setAlgebraNormFlattenUnion children
    if eq (length flat) 0
    then SeNone
    else if eq (length flat) 1
    then setAlgebraNormHeadOr flat (SeNone)
    else
      let intervals = setAlgebraNormCollectIntervals flat
      let allEnumVals = setAlgebraNormCollectEnumValuesFlat flat
      let others = setAlgebraNormCollectUnionOthers flat
      let mergedIvs = mergeIntervals (sortIntervals intervals) []
      let mergedEnum = setAlgebraNormUnionDedupEnum allEnumVals mergedIvs
      let ivNodes = setAlgebraNormIntervalNodes mergedIvs
      let withEnum = case mergedEnum of
        Just de -> appendItem (SeEnum { values = de }) ivNodes
        Nothing -> ivNodes
      let result = concat withEnum others
      setAlgebraNormCollapseUnion result

@label "set-algebra: normCollapseUnion"
@description "Phase 2c — collapse a built union result list (0 ⇒ ∅, 1 ⇒ self, else $union). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCollapseUnion : (result: List SetExpr) -> SetExpr
setAlgebraNormCollapseUnion result =
  if eq (length result) 0
  then SeNone
  else if eq (length result) 1
  then setAlgebraNormHeadOr result (SeNone)
  else SeUnion { branches = result }

@label "set-algebra: normUnionDedupEnum"
@description "Phase 2c — dedup union enum values (seen-list fold) + drop values covered by a merged interval; Maybe (List value). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormUnionDedupEnum : (allEnumVals: List Any) -> (mergedIvs: List Interval) -> Maybe (List Any)
setAlgebraNormUnionDedupEnum allEnumVals mergedIvs =
  let de = setAlgebraNormUnionDedupFold allEnumVals [] [] mergedIvs
  if eq (length de) 0 then Nothing else Just de

@label "set-algebra: normUnionDedupFold"
@description "Phase 2c — the dedup-drop-covered fold (threads seen + acc). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormUnionDedupFold : (values: List Any) -> (seen: List Any) -> (acc: List Any) -> (mergedIvs: List Interval) -> List Any
setAlgebraNormUnionDedupFold values seen acc mergedIvs =
  case head values of
    Nothing -> acc
    Just v ->
      let rest = tailOr values
      if elem v seen
      then setAlgebraNormUnionDedupFold rest seen acc mergedIvs
      else
        let seen2 = appendItem v seen
        if setAlgebraNormAnyIvContains mergedIvs v
        then setAlgebraNormUnionDedupFold rest seen2 acc mergedIvs
        else setAlgebraNormUnionDedupFold rest seen2 (appendItem v acc) mergedIvs

@label "set-algebra: normAnyIvContains"
@description "Phase 2c — does any merged interval contain v (via normInInterval)? Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormAnyIvContains : (ivs: List Interval) -> (v: Any) -> Boolean
setAlgebraNormAnyIvContains ivs v =
  case head ivs of
    Nothing -> false
    Just iv ->
      case inInterval iv (classifyIntervalValue v) of
        Just true -> true
        _ -> setAlgebraNormAnyIvContains (tailOr ivs) v

-- ----------------------------------------------------------------------------
-- $intersect arm (set-algebra.ts:1759) — normalize children, drop ⊤,
-- short-circuit ∅, flatten, DNF-distribute the first $union (≤64 products),
-- categorize, intersect intervals/enums → ∅, value-only contains-filter,
-- $named/$ref dedup, pairwise isDisjoint collapse, superset minimization.
-- ----------------------------------------------------------------------------

@label "set-algebra: normIntersect"
@description "Phase 2c — $intersect normalization. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIntersect : (bs: List SetExpr) -> SetExpr
setAlgebraNormIntersect bs =
  let children = setAlgebraNormMapDropAll bs
  if setAlgebraNormAnyNone children
  then SeNone
  else
    let flat = setAlgebraNormFlattenIntersect children
    if eq (length flat) 0
    then SeAll
    else if eq (length flat) 1
    then setAlgebraNormHeadOr flat (SeAll)
    else setAlgebraNormIntersectAfterFlat flat

@label "set-algebra: normIntersectAfterFlat"
@description "Phase 2c — DNF-distribute or categorize the flattened intersect. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIntersectAfterFlat : (flat: List SetExpr) -> SetExpr
setAlgebraNormIntersectAfterFlat flat =
  if setAlgebraNormHasUnion flat
  then
    if lte (setAlgebraNormCountProducts flat) 64
    then setAlgebraNormIntersectDistribute flat
    else setAlgebraNormIntersectCategorize flat
  else setAlgebraNormIntersectCategorize flat

@label "set-algebra: normCountProducts"
@description "Phase 2c — product of the $union-children branch counts (DNF cap). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCountProducts : (flat: List SetExpr) -> Number
setAlgebraNormCountProducts flat =
  case head flat of
    Nothing -> 1
    Just c ->
      let restProd = setAlgebraNormCountProducts (tailOr flat)
      case c of
        SeUnion { branches = ub } -> mul (length ub) restProd
        _ -> restProd

@label "set-algebra: normHasUnion"
@description "Phase 2c — does the flat intersect contain a $union child? Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormHasUnion : (flat: List SetExpr) -> Boolean
setAlgebraNormHasUnion flat =
  case head flat of
    Nothing -> false
    Just c -> case c of
      SeUnion { branches = _ } -> true
      _ -> setAlgebraNormHasUnion (tailOr flat)

@label "set-algebra: normIntersectDistribute"
@description "Phase 2c — DNF-distribute the first $union over the other intersect members, then re-normalize the resulting union. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIntersectDistribute : (flat: List SetExpr) -> SetExpr
setAlgebraNormIntersectDistribute flat =
  let ub = setAlgebraNormFirstUnionBranches flat
  let others = setAlgebraNormDropFirstUnion flat
  let distributed = setAlgebraNormDistributeBranches ub others
  setAlgebraNormalize (SeUnion { branches = distributed })

@label "set-algebra: normFirstUnionBranches"
@description "Phase 2c — the branches of the first $union child. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormFirstUnionBranches : (flat: List SetExpr) -> List SetExpr
setAlgebraNormFirstUnionBranches flat =
  case head flat of
    Nothing -> []
    Just c -> case c of
      SeUnion { branches = ub } -> ub
      _ -> setAlgebraNormFirstUnionBranches (tailOr flat)

@label "set-algebra: normDropFirstUnion"
@description "Phase 2c — the flat list with the FIRST $union child removed. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDropFirstUnion : (flat: List SetExpr) -> List SetExpr
setAlgebraNormDropFirstUnion flat =
  case head flat of
    Nothing -> []
    Just c ->
      let rest = tailOr flat
      case c of
        SeUnion { branches = _ } -> rest
        _ -> concat [c] (setAlgebraNormDropFirstUnion rest)

@label "set-algebra: normDistributeBranches"
@description "Phase 2c — for each union branch, normalize (branch ∩ others). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDistributeBranches : (ub: List SetExpr) -> (others: List SetExpr) -> List SetExpr
setAlgebraNormDistributeBranches ub others =
  case head ub of
    Nothing -> []
    Just branch ->
      let term = setAlgebraNormalize (SeIntersect { branches = concat [branch] others })
      concat [term] (setAlgebraNormDistributeBranches (tailOr ub) others)

@label "set-algebra: normIntersectCategorize"
@description "Phase 2c — categorize the flat intersect (intervals / enums / value-only / opaque) and merge intervals → ∅. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIntersectCategorize : (flat: List SetExpr) -> SetExpr
setAlgebraNormIntersectCategorize flat =
  let intervals = setAlgebraNormCollectIntervals flat
  if eq (length intervals) 0
  then setAlgebraNormIntersectEnums flat (Nothing)
  else case intersectIntervals intervals of
    Nothing -> SeNone
    Just iv -> setAlgebraNormIntersectEnums flat (Just iv)

@label "set-algebra: normIntersectEnums"
@description "Phase 2c — intersect enum lists pairwise → ∅; if an enum survives, filter by the merged interval + value-only predicates. mergedIv : Maybe Interval. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIntersectEnums : (flat: List SetExpr) -> (mergedIv: Maybe Interval) -> SetExpr
setAlgebraNormIntersectEnums flat mergedIv =
  let enums = setAlgebraNormCollectEnumLists flat
  if eq (length enums) 0
  then setAlgebraNormIntersectBuild flat mergedIv (Nothing) false
  else case enumIntersect (map (\values -> SeEnum { values = values }) enums) of
    Nothing -> SeIntersect { branches = flat }
    Just combined ->
      if eq (length combined) 0
      then SeNone
      else setAlgebraNormIntersectFilterEnum flat mergedIv combined

@label "set-algebra: normIntersectFilterEnum"
@description "Filter a surviving enum through the merged interval and value-only predicates. Only Just false drops a value; Nothing retains it and marks the filter inexact. An inexact result retains the interval and value-only constraints beside the enum, preserving denotation. All values provably out implies SeNone."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c" "decide-substrate"
@category "engine-internal"
setAlgebraNormIntersectFilterEnum : (flat: List SetExpr) -> (mergedIv: Maybe Interval) -> (combined: List Any) -> SetExpr
setAlgebraNormIntersectFilterEnum flat mergedIv combined =
  let afterIv = case mergedIv of
    Just iv -> setAlgebraNormFilterEnumByInterval combined iv
    Nothing -> NormFilterResult { kept = combined, exact = true }
  if eq (length afterIv.kept) 0
  then SeNone
  else
    let valueOnly = setAlgebraNormCollectValueOnly flat
    let vo = setAlgebraNormFilterEnumByValueOnly afterIv.kept valueOnly
    if eq (length vo.kept) 0
    then SeNone
    else setAlgebraNormIntersectBuild flat mergedIv (Just vo.kept) (not (vo.exact && afterIv.exact))

@label "set-algebra: normIntersectBuild"
@description "Assemble the intersection result. A surviving enum replaces its interval and value-only filters only when both filters are exact; keepVo retains those constraints for undecided memberships. Opaque constraints remain, followed by named deduplication and disjoint/minimize."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c" "decide-substrate"
@category "engine-internal"
setAlgebraNormIntersectBuild : (flat: List SetExpr) -> (mergedIv: Maybe Interval) -> (combinedEnum: Maybe (List Any)) -> (keepVo: Boolean) -> SetExpr
setAlgebraNormIntersectBuild flat mergedIv combinedEnum keepVo =
  let opaque = setAlgebraNormCollectOpaque flat
  let resultPre = case combinedEnum of
    Just de ->
      if keepVo
      then
        let ivNodes = case mergedIv of
          Just iv -> [SeInterval { interval = declassifyInterval iv }]
          Nothing -> []
        concat (concat (concat [SeEnum { values = de }] ivNodes) (setAlgebraNormCollectValueOnly flat)) opaque
      else concat [SeEnum { values = de }] opaque
    Nothing ->
      let valueOnly = setAlgebraNormCollectValueOnly flat
      let ivNodes = case mergedIv of
        Just iv -> [SeInterval { interval = declassifyInterval iv }]
        Nothing -> []
      concat (concat ivNodes valueOnly) opaque
  let deduped = setAlgebraNormDedupNamed resultPre
  if eq (length deduped) 0
  then SeAll
  else if eq (length deduped) 1
  then setAlgebraNormHeadOr deduped (SeAll)
  else setAlgebraNormIntersectFinal deduped

@label "set-algebra: normIntersectFinal"
@description "Phase 2c — pairwise isDisjoint collapse → ∅, then superset minimization; rebuild. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIntersectFinal : (deduped: List SetExpr) -> SetExpr
setAlgebraNormIntersectFinal deduped =
  if setAlgebraNormAnyPairDisjoint deduped
  then SeNone
  else
    let minimal = setAlgebraNormMinimize deduped
    if eq (length minimal) 0
    then SeAll
    else if eq (length minimal) 1
    then setAlgebraNormHeadOr minimal (SeAll)
    else SeIntersect { branches = minimal }

@label "set-algebra: normCombineEnums"
@description "Phase 2c — intersection of all enum value-lists. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCombineEnums : (enums: List (List Any)) -> List Any
setAlgebraNormCombineEnums enums =
  case head enums of
    Nothing -> []
    Just first -> setAlgebraNormCombineEnumsFold first (tailOr enums)

@label "set-algebra: normCombineEnumsFold"
@description "Phase 2c — fold the per-enum intersection. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCombineEnumsFold : (acc: List Any) -> (rest: List (List Any)) -> List Any
setAlgebraNormCombineEnumsFold acc rest =
  case head rest of
    Nothing -> acc
    Just nextEnum ->
      let acc2 = setAlgebraNormEnumIntersect acc nextEnum
      setAlgebraNormCombineEnumsFold acc2 (tailOr rest)

@label "set-algebra: normEnumIntersect"
@description "Phase 2c — keep acc values that are in `other` (order-preserving). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormEnumIntersect : (acc: List Any) -> (other: List Any) -> List Any
setAlgebraNormEnumIntersect acc other =
  case head acc of
    Nothing -> []
    Just v ->
      let rest = tailOr acc
      if elem v other
      then concat [v] (setAlgebraNormEnumIntersect rest other)
      else setAlgebraNormEnumIntersect rest other

@label "set-algebra: normFilterEnumByInterval"
@description "Filter enum values through the shared Tri interval membership. Only Just false drops; Nothing retains the value and marks the result inexact, so the rebuilt intersection retains its interval constraint."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormFilterEnumByInterval : (combined: List Any) -> (iv: Interval) -> NormFilterResult
setAlgebraNormFilterEnumByInterval combined iv =
  setAlgebraNormFilterIntervalFold combined iv (NormFilterResult { kept = [], exact = true })

@category "engine-internal"
setAlgebraNormFilterIntervalFold : (combined: List Any) -> (iv: Interval) -> (acc: NormFilterResult) -> NormFilterResult
setAlgebraNormFilterIntervalFold combined iv acc = case head combined of
    Nothing -> acc
    Just v ->
      let rest = tailOr combined
      case inInterval iv (classifyIntervalValue v) of
        Just false -> setAlgebraNormFilterIntervalFold rest iv acc
        Just true -> setAlgebraNormFilterIntervalFold rest iv (NormFilterResult { kept = appendItem v acc.kept, exact = acc.exact })
        Nothing -> setAlgebraNormFilterIntervalFold rest iv (NormFilterResult { kept = appendItem v acc.kept, exact = false })

@label "set-algebra: normFilterEnumByValueOnly"
@description "decide-substrate (normalize enum-filter honesty; supersedes the Phase-2c isJustTrue filter) — TRI-partition enum values against the value-only predicates: \"out\" (some Just false) drops (sound — provably excluded); \"in\" (all Just true) keeps; \"unknown\" (no Just false, ≥1 Nothing) keeps AND marks the result INEXACT. Returns { kept, exact } — the caller retains the value-only members when inexact (the old drop-on-Nothing was an unsound set-shrink). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c" "decide-substrate"
@category "engine-internal"
setAlgebraNormFilterEnumByValueOnly : (afterIv: List Any) -> (valueOnly: List SetExpr) -> NormFilterResult
setAlgebraNormFilterEnumByValueOnly afterIv valueOnly =
  setAlgebraNormFilterVoFold afterIv valueOnly (NormFilterResult { kept = [], exact = true })

@label "set-algebra: normFilterVoFold"
@description "decide-substrate (normalize enum-filter honesty) — the { kept, exact } fold over enum values (setAlgebraNormValueOnlyClass per value). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "decide-substrate"
@category "engine-internal"
setAlgebraNormFilterVoFold : (afterIv: List Any) -> (valueOnly: List SetExpr) -> (acc: NormFilterResult) -> NormFilterResult
setAlgebraNormFilterVoFold afterIv valueOnly acc =
  case head afterIv of
    Nothing -> acc
    Just v ->
      let rest = tailOr afterIv
      let cls = setAlgebraNormValueOnlyClass valueOnly v
      if eq cls "out" then setAlgebraNormFilterVoFold rest valueOnly acc
      else if eq cls "in" then setAlgebraNormFilterVoFold rest valueOnly (NormFilterResult { kept = appendItem v acc.kept, exact = acc.exact })
      else setAlgebraNormFilterVoFold rest valueOnly (NormFilterResult { kept = appendItem v acc.kept, exact = false })

@label "set-algebra: normValueOnlyClass"
@description "decide-substrate (normalize enum-filter honesty) — one value's membership class over ALL value-only predicates: any Just false ⇒ \"out\" (short-circuit); all Just true ⇒ \"in\"; else (≥1 Nothing, no Just false) ⇒ \"unknown\". Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "decide-substrate"
@category "engine-internal"
setAlgebraNormValueOnlyClass : (valueOnly: List SetExpr) -> (v: Any) -> String
setAlgebraNormValueOnlyClass valueOnly v = setAlgebraNormVoClassFold valueOnly v true

@label "set-algebra: normVoClassFold"
@description "decide-substrate (normalize enum-filter honesty) — the tri-class fold (allTrue threads whether every decided predicate so far was Just true). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "decide-substrate"
@category "engine-internal"
setAlgebraNormVoClassFold : (valueOnly: List SetExpr) -> (v: Any) -> (allTrue: Boolean) -> String
setAlgebraNormVoClassFold valueOnly v allTrue =
  case head valueOnly of
    Nothing -> if allTrue then "in" else "unknown"
    Just c ->
      case setAlgebraContains c v of
        Just b ->
          if b then setAlgebraNormVoClassFold (tailOr valueOnly) v allTrue
          else "out"
        Nothing -> setAlgebraNormVoClassFold (tailOr valueOnly) v false

@label "set-algebra: normDedupNamed"
@description "Phase 2c — dedup $named/$ref nodes on the name-handle (seen-list fold). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDedupNamed : (nodes: List SetExpr) -> List SetExpr
setAlgebraNormDedupNamed nodes = setAlgebraNormDedupNamedFold nodes [] []

@label "set-algebra: normDedupNamedFold"
@description "Phase 2c — the $named/$ref dedup fold (threads seen handles + acc). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDedupNamedFold : (nodes: List SetExpr) -> (seen: List String) -> (acc: List SetExpr) -> List SetExpr
setAlgebraNormDedupNamedFold nodes seen acc =
  case head nodes of
    Nothing -> acc
    Just c ->
      let rest = tailOr nodes
      case setAlgebraNormNodeHandle c of
        Nothing -> setAlgebraNormDedupNamedFold rest seen (appendItem c acc)
        Just h ->
          if elem h seen
          then setAlgebraNormDedupNamedFold rest seen acc
          else setAlgebraNormDedupNamedFold rest (appendItem h seen) (appendItem c acc)

@label "set-algebra: normNodeHandle"
@description "Phase 1b — the name-handle of an SeRef node (Maybe String). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-1b"
@category "engine-internal"
setAlgebraNormNodeHandle : (c: SetExpr) -> Maybe String
setAlgebraNormNodeHandle c = case c of
  SeRef { handle = h } -> Just h
  _ -> Nothing

@label "set-algebra: normAnyPairDisjoint"
@description "Phase 2c — does any node pair prove disjoint (isJustTrue isDisjoint)? Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormAnyPairDisjoint : (nodes: List SetExpr) -> Boolean
setAlgebraNormAnyPairDisjoint nodes =
  case head nodes of
    Nothing -> false
    Just first ->
      let rest = tailOr nodes
      if setAlgebraNormDisjointWithAny first rest
      then true
      else setAlgebraNormAnyPairDisjoint rest

@label "set-algebra: normDisjointWithAny"
@description "Phase 2c — is x provably disjoint from any node in `others`? Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDisjointWithAny : (x: SetExpr) -> (others: List SetExpr) -> Boolean
setAlgebraNormDisjointWithAny x others =
  case head others of
    Nothing -> false
    Just o ->
      if setAlgebraNormIsJustTrue (setAlgebraIsDisjoint x o)
      then true
      else setAlgebraNormDisjointWithAny x (tailOr others)

@label "set-algebra: normMinimize"
@description "Phase 2c — drop strict supersets (entry dropped when some other ⊊ entry). Positional i≠j via left/right split. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormMinimize : (nodes: List SetExpr) -> List SetExpr
setAlgebraNormMinimize nodes = setAlgebraNormMinimizeFold [] nodes []

@label "set-algebra: normMinimizeFold"
@description "Phase 2c — the minimization fold (left = processed, right = remaining, kept = result). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormMinimizeFold : (left: List SetExpr) -> (right: List SetExpr) -> (kept: List SetExpr) -> List SetExpr
setAlgebraNormMinimizeFold left right kept =
  case head right of
    Nothing -> kept
    Just entry ->
      let rest = tailOr right
      let others = concat left rest
      let kept2 =
        if setAlgebraNormIsStrictSuperOfAny entry others
        then kept
        else appendItem entry kept
      setAlgebraNormMinimizeFold (appendItem entry left) rest kept2

@label "set-algebra: normIsStrictSuperOfAny"
@description "Phase 2c — is entry a strict superset of any `other` (other ⊆ entry ∧ ¬ entry ⊆ other)? Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIsStrictSuperOfAny : (entry: SetExpr) -> (others: List SetExpr) -> Boolean
setAlgebraNormIsStrictSuperOfAny entry others =
  case head others of
    Nothing -> false
    Just o ->
      if setAlgebraNormIsJustTrue (setAlgebraIsSubset o entry)
      then
        if not (setAlgebraNormIsJustTrue (setAlgebraIsSubset entry o))
        then true
        else setAlgebraNormIsStrictSuperOfAny entry (tailOr others)
      else setAlgebraNormIsStrictSuperOfAny entry (tailOr others)

-- ----------------------------------------------------------------------------
-- $complement arm (set-algebra.ts:1907) — ¬⊤=∅, ¬∅=⊤, ¬¬x=x, else ¬x.
-- ----------------------------------------------------------------------------

@label "set-algebra: normComplement"
@description "Phase 2c — $complement normalization. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormComplement : (i: SetExpr) -> SetExpr
setAlgebraNormComplement i =
  let inner = setAlgebraNormalize i
  case inner of
    SeAll -> SeNone
    SeNone -> SeAll
    SeComplement { inner = x } -> x
    _ -> SeComplement { inner = inner }

-- ----------------------------------------------------------------------------
-- $diff arm (set-algebra.ts:1918) — ∅\_=∅, a\∅=a, a\⊤=∅, a\a=∅ (subsetStructEq),
-- a\b=a when isDisjoint, a\¬c=a∩c, left-union/intersect distribute, a\(b1∪b2)
-- iterate, a\(b1∩b2) De Morgan, enum\enum / enum\value-only filter,
-- interval\interval (normIntervalDiff), interval\enum (normIntervalMinusEnum).
-- ----------------------------------------------------------------------------

@label "set-algebra: normDiff"
@description "Phase 2c — $diff normalization. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDiff : (la: SetExpr) -> (lb: SetExpr) -> SetExpr
setAlgebraNormDiff la lb =
  let a = setAlgebraNormalize la
  let b = setAlgebraNormalize lb
  case a of
    SeNone -> SeNone
    _ -> case b of
      SeNone -> a
      SeAll -> SeNone
      _ -> setAlgebraNormDiffMain a b

@label "set-algebra: normDiffMain"
@description "Phase 1b — a\\a=∅ (the Fenel `deepEqValue` structural deep-eq over canonical `$tag` Se*; Phase 1c — the subsetStructEq ctx-native is deleted) then a\\b=a on disjoint, then the structural rules. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDiffMain : (a: SetExpr) -> (b: SetExpr) -> SetExpr
setAlgebraNormDiffMain a b =
  if setSemanticEq a b
  then SeNone
  else if setAlgebraNormIsJustTrue (setAlgebraIsDisjoint a b)
  then a
  else setAlgebraNormDiffRules a b

@label "set-algebra: normDiffRules"
@description "Phase 2c — a\\¬c=a∩c, then left-union/intersect distribution, then right-compound. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDiffRules : (a: SetExpr) -> (b: SetExpr) -> SetExpr
setAlgebraNormDiffRules a b =
  case b of
    SeComplement { inner = c } ->
      setAlgebraNormalize (SeIntersect { branches = concat [a] [c] })
    _ -> case a of
      SeUnion { branches = ab } ->
        setAlgebraNormalize (SeUnion { branches = setAlgebraNormDiffEachLeft ab b })
      SeIntersect { branches = ab } ->
        setAlgebraNormalize (SeIntersect { branches = setAlgebraNormDiffEachLeft ab b })
      _ -> setAlgebraNormDiffRightCompound a b

@label "set-algebra: normDiffRightCompound"
@description "Phase 2c — a\\(b1∪b2) iterate-with-short-circuit, a\\(b1∩b2) De Morgan, else leaf rules. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDiffRightCompound : (a: SetExpr) -> (b: SetExpr) -> SetExpr
setAlgebraNormDiffRightCompound a b =
  case b of
    SeUnion { branches = bb } -> setAlgebraNormDiffMinusUnion a bb
    SeIntersect { branches = bb } ->
      setAlgebraNormalize (SeUnion { branches = setAlgebraNormDiffEachRight a bb })
    _ -> setAlgebraNormDiffLeaf a b

@label "set-algebra: normDiffEachLeft"
@description "Phase 2c — distribute a left compound: each ai → normalize(ai \\ b). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDiffEachLeft : (ab: List SetExpr) -> (b: SetExpr) -> List SetExpr
setAlgebraNormDiffEachLeft ab b =
  case head ab of
    Nothing -> []
    Just ai ->
      let part = setAlgebraNormalize (SeDiff { left = ai, right = b })
      concat [part] (setAlgebraNormDiffEachLeft (tailOr ab) b)

@label "set-algebra: normDiffEachRight"
@description "Phase 2c — De Morgan a\\(b1∩b2): each bi → normalize(a \\ bi). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDiffEachRight : (a: SetExpr) -> (bb: List SetExpr) -> List SetExpr
setAlgebraNormDiffEachRight a bb =
  case head bb of
    Nothing -> []
    Just bi ->
      let part = setAlgebraNormalize (SeDiff { left = a, right = bi })
      concat [part] (setAlgebraNormDiffEachRight a (tailOr bb))

@label "set-algebra: normDiffMinusUnion"
@description "Phase 2c — a\\(b1∪b2…): fold each subtraction, short-circuit on ∅. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDiffMinusUnion : (a: SetExpr) -> (bb: List SetExpr) -> SetExpr
setAlgebraNormDiffMinusUnion a bb =
  case head bb of
    Nothing -> a
    Just part ->
      let r = setAlgebraNormalize (SeDiff { left = a, right = part })
      case r of
        SeNone -> SeNone
        _ -> setAlgebraNormDiffMinusUnion r (tailOr bb)

@label "set-algebra: normDiffLeaf"
@description "Phase 2c — the leaf diff rules (enum\\enum, enum\\value-only, interval\\interval, interval\\enum, else $diff). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormDiffLeaf : (a: SetExpr) -> (b: SetExpr) -> SetExpr
setAlgebraNormDiffLeaf a b = case a of
  SeEnum { values = av } -> case b of
    SeEnum { values = bv } ->
      let result = setAlgebraNormEnumMinusValueOnly av b
      if eq (length result.kept) 0 then SeNone
      else if result.exact then SeEnum { values = result.kept }
      else SeDiff { left = SeEnum { values = result.kept }, right = b }
    _ ->
      if isValueOnlyPredicate b
      then
        let mv = setAlgebraNormEnumMinusValueOnly av b
        if eq (length mv.kept) 0
        then SeNone
        else if mv.exact
        then
          if eq (length mv.kept) (length av)
          then a
          else SeEnum { values = mv.kept }
        else SeDiff { left = SeEnum { values = mv.kept }, right = b }
      else SeDiff { left = a, right = b }
  SeInterval { interval = aiv } -> case b of
    SeInterval { interval = biv } -> idrToNorm (intervalDiff (setAlgebraClassifyInterval aiv) (setAlgebraClassifyInterval biv) [])
    SeEnum { values = bv } -> setAlgebraNormIntervalMinusEnum aiv bv
    _ -> SeDiff { left = a, right = b }
  _ -> SeDiff { left = a, right = b }

@label "set-algebra: normEnumMinus"
@description "Phase 2c — av values not in bv (order-preserving). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormEnumMinus : (av: List Any) -> (bv: List Any) -> List Any
setAlgebraNormEnumMinus av bv =
  case head av of
    Nothing -> []
    Just v ->
      let rest = tailOr av
      if elem v bv
      then setAlgebraNormEnumMinus rest bv
      else concat [v] (setAlgebraNormEnumMinus rest bv)

@label "set-algebra: normEnumMinusValueOnly"
@description "decide-substrate (normalize enum-filter honesty; supersedes the Phase-2c isJustTrue minus) — TRI-partition av against the value-only predicate b for the DIFF `av \\ b`: Just true (∈ b) drops (sound — provably not in the diff); Just false (∉ b) keeps; Nothing keeps AND marks INEXACT (the old keep-as-plain-enum on Nothing was an unsound set-GROW — emitting SeEnum claimed v ∉ b for an undecided membership). Returns { kept, exact }; the caller keeps the SeDiff structure when inexact. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c" "decide-substrate"
@category "engine-internal"
setAlgebraNormEnumMinusValueOnly : (av: List Any) -> (b: SetExpr) -> NormFilterResult
setAlgebraNormEnumMinusValueOnly av b = setAlgebraNormMinusVoFold av b (NormFilterResult { kept = [], exact = true })

@label "set-algebra: normMinusVoFold"
@description "decide-substrate (normalize enum-filter honesty) — the { kept, exact } fold for normEnumMinusValueOnly (tri on setAlgebraContains b v). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "decide-substrate"
@category "engine-internal"
setAlgebraNormMinusVoFold : (av: List Any) -> (b: SetExpr) -> (acc: NormFilterResult) -> NormFilterResult
setAlgebraNormMinusVoFold av b acc =
  case head av of
    Nothing -> acc
    Just v ->
      let rest = tailOr av
      case setAlgebraContains b v of
        Just inB ->
          if inB then setAlgebraNormMinusVoFold rest b acc
          else setAlgebraNormMinusVoFold rest b (NormFilterResult { kept = appendItem v acc.kept, exact = acc.exact })
        Nothing -> setAlgebraNormMinusVoFold rest b (NormFilterResult { kept = appendItem v acc.kept, exact = false })

-- ----------------------------------------------------------------------------
-- Shared normalize helpers over Se* (map / flatten / collect / collapse / tri-state).
-- ----------------------------------------------------------------------------

@label "set-algebra: normMapDropNone"
@description "Phase 2c — map normalize over branches, drop ∅ (union). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormMapDropNone : (bs: List SetExpr) -> List SetExpr
setAlgebraNormMapDropNone bs =
  case head bs of
    Nothing -> []
    Just first ->
      let n = setAlgebraNormalize first
      let rest = setAlgebraNormMapDropNone (tailOr bs)
      case n of
        SeNone -> rest
        _ -> concat [n] rest

@label "set-algebra: normMapDropAll"
@description "Phase 2c — map normalize over branches, drop ⊤ (intersect). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormMapDropAll : (bs: List SetExpr) -> List SetExpr
setAlgebraNormMapDropAll bs =
  case head bs of
    Nothing -> []
    Just first ->
      let n = setAlgebraNormalize first
      let rest = setAlgebraNormMapDropAll (tailOr bs)
      case n of
        SeAll -> rest
        _ -> concat [n] rest

@label "set-algebra: normFlattenUnion"
@description "Phase 2c — splice nested $union one level. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormFlattenUnion : (children: List SetExpr) -> List SetExpr
setAlgebraNormFlattenUnion children =
  case head children of
    Nothing -> []
    Just first ->
      let rest = setAlgebraNormFlattenUnion (tailOr children)
      case first of
        SeUnion { branches = ub } -> concat ub rest
        _ -> concat [first] rest

@label "set-algebra: normFlattenIntersect"
@description "Phase 2c — splice nested $intersect one level. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormFlattenIntersect : (children: List SetExpr) -> List SetExpr
setAlgebraNormFlattenIntersect children =
  case head children of
    Nothing -> []
    Just first ->
      let rest = setAlgebraNormFlattenIntersect (tailOr children)
      case first of
        SeIntersect { branches = ib } -> concat ib rest
        _ -> concat [first] rest

@label "set-algebra: normAnyAll"
@description "Phase 2c — any branch is ⊤? Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormAnyAll : (children: List SetExpr) -> Boolean
setAlgebraNormAnyAll children =
  case head children of
    Nothing -> false
    Just c -> case c of
      SeAll -> true
      _ -> setAlgebraNormAnyAll (tailOr children)

@label "set-algebra: normAnyNone"
@description "Phase 2c — any branch is ∅? Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormAnyNone : (children: List SetExpr) -> Boolean
setAlgebraNormAnyNone children =
  case head children of
    Nothing -> false
    Just c -> case c of
      SeNone -> true
      _ -> setAlgebraNormAnyNone (tailOr children)

@label "set-algebra: normHeadOr"
@description "Phase 2c — head of a list or a fallback. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormHeadOr : (xs: List a) -> (fb: a) -> a
setAlgebraNormHeadOr xs fb = case head xs of
  Nothing -> fb
  Just x -> x

@label "set-algebra: normIsJustTrue"
@description "Phase 2c — is a MaybeBool a definite Just true? Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIsJustTrue : (mb: Maybe Boolean) -> Boolean
setAlgebraNormIsJustTrue mb = case mb of
  Just true -> true
  _ -> false

@label "set-algebra: normCollectIntervals"
@description "Phase 2c — collect marshalled Intervals from SeInterval nodes. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCollectIntervals : (flat: List SetExpr) -> List Interval
setAlgebraNormCollectIntervals flat =
  case head flat of
    Nothing -> []
    Just c -> case c of
      SeInterval { interval = iv } ->
        concat [setAlgebraClassifyInterval iv] (setAlgebraNormCollectIntervals (tailOr flat))
      _ -> setAlgebraNormCollectIntervals (tailOr flat)

@label "set-algebra: normCollectEnumValuesFlat"
@description "Phase 2c — concat all SeEnum value lists (union). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCollectEnumValuesFlat : (flat: List SetExpr) -> List Any
setAlgebraNormCollectEnumValuesFlat flat =
  case head flat of
    Nothing -> []
    Just c -> case c of
      SeEnum { values = vs } ->
        concat vs (setAlgebraNormCollectEnumValuesFlat (tailOr flat))
      _ -> setAlgebraNormCollectEnumValuesFlat (tailOr flat)

@label "set-algebra: normCollectEnumLists"
@description "Phase 2c — collect per-SeEnum value lists (intersect). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCollectEnumLists : (flat: List SetExpr) -> List (List Any)
setAlgebraNormCollectEnumLists flat =
  case head flat of
    Nothing -> []
    Just c -> case c of
      SeEnum { values = vs } ->
        concat [vs] (setAlgebraNormCollectEnumLists (tailOr flat))
      _ -> setAlgebraNormCollectEnumLists (tailOr flat)

@label "set-algebra: normCollectUnionOthers"
@description "Phase 2c — nodes that are neither interval nor enum (union). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCollectUnionOthers : (flat: List SetExpr) -> List SetExpr
setAlgebraNormCollectUnionOthers flat =
  case head flat of
    Nothing -> []
    Just c -> case c of
      SeInterval { interval = _ } -> setAlgebraNormCollectUnionOthers (tailOr flat)
      SeEnum { values = _ } -> setAlgebraNormCollectUnionOthers (tailOr flat)
      _ -> concat [c] (setAlgebraNormCollectUnionOthers (tailOr flat))

@label "set-algebra: normCollectValueOnly"
@description "Phase 2c — non-interval/non-enum nodes that are value-only predicates (intersect). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCollectValueOnly : (flat: List SetExpr) -> List SetExpr
setAlgebraNormCollectValueOnly flat =
  case head flat of
    Nothing -> []
    Just c -> case c of
      SeInterval { interval = _ } -> setAlgebraNormCollectValueOnly (tailOr flat)
      SeEnum { values = _ } -> setAlgebraNormCollectValueOnly (tailOr flat)
      _ ->
        if isValueOnlyPredicate c
        then concat [c] (setAlgebraNormCollectValueOnly (tailOr flat))
        else setAlgebraNormCollectValueOnly (tailOr flat)

@label "set-algebra: normCollectOpaque"
@description "Phase 2c — non-interval/non-enum nodes that are NOT value-only (intersect). Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormCollectOpaque : (flat: List SetExpr) -> List SetExpr
setAlgebraNormCollectOpaque flat =
  case head flat of
    Nothing -> []
    Just c -> case c of
      SeInterval { interval = _ } -> setAlgebraNormCollectOpaque (tailOr flat)
      SeEnum { values = _ } -> setAlgebraNormCollectOpaque (tailOr flat)
      _ ->
        if isValueOnlyPredicate c
        then setAlgebraNormCollectOpaque (tailOr flat)
        else concat [c] (setAlgebraNormCollectOpaque (tailOr flat))

@label "set-algebra: normIntervalNodes"
@description "Phase 2c — wrap merged intervals back into SeInterval nodes. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-2c"
@category "engine-internal"
setAlgebraNormIntervalNodes : (ivs: List Interval) -> List SetExpr
setAlgebraNormIntervalNodes ivs =
  case head ivs of
    Nothing -> []
    Just iv ->
      concat [SeInterval { interval = declassifyInterval iv }] (setAlgebraNormIntervalNodes (tailOr ivs))

-- ============================================================================
-- Phase 3b-3 interval-native shrink — the pure-Fenel replacements for the 5
-- interval-leaf set:norm* natives (normMergeIntervals / normIntersectIntervals
-- / normInInterval / normIntervalDiff / normIntervalMinusEnum). The intervals
-- normalize holds in SeInterval payloads are already the IntervalMarshalled
-- $tag-ADT the interval bodies consume, so these call the bodies directly;
-- the only TS-owned pre-processing was the merge pre-sort + the minusEnum
-- insider-filter, both reproduced here. No native, no $-key codec.
-- ============================================================================

-- sortIntervals — stable sort of intervals by numeric lo bound, mirroring the
-- TS dispatchedMergeIntervals pre-sort `.sort((a,b)=>isNaN(numericLo)?0:al-bl)`:
-- Nothing-lo = -∞ sorts first, numeric-lo ascending, string/expr-lo bounds are
-- "incomparable" (the TS comparator returns 0 ⇒ no reorder). A stable insertion
-- sort whose strict-less predicate fires only when both los are numeric/-∞
-- reproduces V8's binary-insertion order for these (rare) mixed lists.
@label "set-algebra: sortIntervals"
@description "Phase 3b-3 — stable insertion sort of intervals by numeric lo bound (mirrors dispatchedMergeIntervals' pre-sort: -∞ first, numeric ascending, non-numeric los keep input order)."
@tags "engine" "set-algebra" "interval" "normalize" "phase-3b-3"
@category "engine-internal"
sortIntervals : (ivs: List Interval) -> List Interval
sortIntervals ivs = setAlgebraSortIntervalsFold ivs []

@label "set-algebra: sortIntervalsFold"
@description "Phase 3b-3 — insert each interval into the sorted accumulator. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "normalize" "phase-3b-3"
@category "engine-internal"
setAlgebraSortIntervalsFold : (ivs: List Interval) -> (acc: List Interval) -> List Interval
setAlgebraSortIntervalsFold ivs acc =
  case head ivs of
    Nothing -> acc
    Just iv -> setAlgebraSortIntervalsFold (tailOr ivs) (setAlgebraInsertInterval iv acc)

@label "set-algebra: insertInterval"
@description "Phase 3b-3 — insert iv before the first sorted element it is strictly lo-before; stable. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "normalize" "phase-3b-3"
@category "engine-internal"
setAlgebraInsertInterval : (iv: Interval) -> (xs: List Interval) -> List Interval
setAlgebraInsertInterval iv xs =
  case head xs of
    Nothing -> [iv]
    Just x ->
      if setAlgebraIntervalLoBefore iv x
      then concat [iv] xs
      else concat [x] (setAlgebraInsertInterval iv (tailOr xs))

@label "set-algebra: intervalLoBefore"
@description "Phase 3b-3 — iv's lo strictly precedes x's lo under the TS numericLo comparator: both numeric ⇒ lt; -∞ before finite; either non-numeric ⇒ no reorder. Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "normalize" "phase-3b-3"
@category "engine-internal"
setAlgebraIntervalLoBefore : (iv: Interval) -> (x: Interval) -> Boolean
setAlgebraIntervalLoBefore iv x =
  let ik = numericBound iv.lo 0
  let xk = numericBound x.lo 0
  case ik of
    NbrNum { value = iv0 } -> case xk of
      NbrNum { value = xv0 } -> lt iv0 xv0
      _ -> false
    NbrNeg -> case xk of
      NbrNum {} -> true
      _ -> false
    _ -> false

-- idrToNorm — IntervalDiffResult → canonical Se* SetExpr. The IDR carries
-- MARSHALLED intervals (intervalDiff / intervalMinusEnum produce tagged
-- Bounds), so every SeInterval node it builds DECLASSIFIES back to the raw
-- {lo, hi} payload (declassifyInterval — the faithful inverse of the TS
-- unmarshalInterval, which the OLD `unmarshalNormSetExpr` NseInterval arm ran).
-- The IDR→Se mapping is otherwise structural ($none→SeNone, $interval→
-- SeInterval, $union→SeUnion of intervals via setAlgebraNormIntervalNodes which
-- declassifies too, $diff→SeDiff, $enum→SeEnum).
@label "set-algebra: idrToNorm"
@description "Phase 1b — IntervalDiffResult → canonical Se* SetExpr; declassifies the marshalled IDR intervals back to the raw SeInterval payload (the faithful inverse of unmarshalInterval)."
@tags "engine" "set-algebra" "interval" "normalize" "phase-1b"
@category "engine-internal"
idrToNorm : (idr: IntervalDiffResult) -> SetExpr
idrToNorm idr = case idr of
  IdrNone -> SeNone
  IdrInterval { interval = iv } -> SeInterval { interval = declassifyInterval iv }
  IdrUnion { intervals = ivs } -> SeUnion { branches = setAlgebraNormIntervalNodes ivs }
  IdrDiff { iv1 = a1, iv2 = a2 } ->
    SeDiff { left = SeInterval { interval = declassifyInterval a1 }, right = SeInterval { interval = declassifyInterval a2 } }
  IdrDiffEnum { iv = a1, values = vs } ->
    SeDiff { left = SeInterval { interval = declassifyInterval a1 }, right = SeEnum { values = vs } }

-- setAlgebraNormIntervalMinusEnum — A \ {enum values}, the pure-Fenel
-- replacement for the normIntervalMinusEnum native. Mirrors the TS
-- dispatchedIntervalMinusEnum arg-prep: filter the enum values to interval
-- insiders, split out the numeric insiders (sorted ascending), set the
-- allNumeric flag; then intervalMinusEnum + idrToNorm.
@label "set-algebra: normIntervalMinusEnum"
@description "Phase 3b-3 — interval \\ enum-values → canonical Se* (classifies the raw aiv); mirrors dispatchedIntervalMinusEnum's insider-filter + numeric-sort + allNumeric arg-prep, then intervalMinusEnum + idrToNorm."
@tags "engine" "set-algebra" "interval" "normalize" "phase-3b-3"
@category "engine-internal"
setAlgebraNormIntervalMinusEnum : (aiv: { lo: Maybe ({ value: Any, inclusive: Boolean }), hi: Maybe ({ value: Any, inclusive: Boolean }) }) -> (bv: List Any) -> SetExpr
setAlgebraNormIntervalMinusEnum aiv bv =
  let aivM = setAlgebraClassifyInterval aiv
  let insiders = setAlgebraNormIvInsiders aivM bv
  let numericInsiders = sortNumbersAsc (setAlgebraNormNumericInsiders insiders)
  let allNumeric = eq (length numericInsiders) (length insiders)
  idrToNorm (intervalMinusEnum aivM insiders numericInsiders allNumeric [])

@label "set-algebra: normIvInsiders"
@description "Phase 3b-3 — enum values inside the interval (inInterval over the classified value). Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "normalize" "phase-3b-3"
@category "engine-internal"
setAlgebraNormIvInsiders : (aiv: Interval) -> (values: List Any) -> List Any
setAlgebraNormIvInsiders aiv values =
  case head values of
    Nothing -> []
    Just v ->
      let rest = tailOr values
      case inInterval aiv (classifyIntervalValue v) of
        Just false -> setAlgebraNormIvInsiders aiv rest
        _ -> concat [v] (setAlgebraNormIvInsiders aiv rest)

@label "set-algebra: normNumericInsiders"
@description "Phase 3b-3 — keep only the numeric insiders (isNumber). Internal helper."
@tags "engine" "internal" "set-algebra" "interval" "normalize" "phase-3b-3"
@category "engine-internal"
setAlgebraNormNumericInsiders : (insiders: List Any) -> List Number
setAlgebraNormNumericInsiders insiders =
  case head insiders of
    Nothing -> []
    Just v ->
      let rest = tailOr insiders
      if isNumber v
      then concat [toNumber v] (setAlgebraNormNumericInsiders rest)
      else setAlgebraNormNumericInsiders rest

-- sortNumbersAsc — ascending stable insertion sort over numbers (mirrors the
-- TS numericInsiders.sort((x,y)=>x-y)).
@label "set-algebra: sortNumbersAsc"
@description "Phase 3b-3 — ascending stable insertion sort over numbers (mirrors numericInsiders.sort)."
@tags "engine" "set-algebra" "normalize" "phase-3b-3"
@category "engine-internal"
sortNumbersAsc : (xs: List Number) -> List Number
sortNumbersAsc xs = setAlgebraSortNumbersFold xs []

@label "set-algebra: sortNumbersFold"
@description "Phase 3b-3 — insert each number into the sorted accumulator. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-3b-3"
@category "engine-internal"
setAlgebraSortNumbersFold : (xs: List Number) -> (acc: List Number) -> List Number
setAlgebraSortNumbersFold xs acc =
  case head xs of
    Nothing -> acc
    Just x -> setAlgebraSortNumbersFold (tailOr xs) (setAlgebraInsertNumber x acc)

@label "set-algebra: insertNumber"
@description "Phase 3b-3 — insert x before the first sorted number greater than it; stable. Internal helper."
@tags "engine" "internal" "set-algebra" "normalize" "phase-3b-3"
@category "engine-internal"
setAlgebraInsertNumber : (x: Number) -> (ys: List Number) -> List Number
setAlgebraInsertNumber x ys =
  case head ys of
    Nothing -> [x]
    Just y ->
      if lt x y
      then concat [x] ys
      else concat [y] (setAlgebraInsertNumber x (tailOr ys))

-- ============================================================================
-- (whereContainsEval is RETIRED — decide-substrate Phase 4T Step W.) The
-- `contains`-over-`$where` membership decision now rides the VALUE-TAKING
-- `whereMember pred value` ctx-native (engine-bodies-dispatch.ts, the
-- namedMember/patternMember seam family): the old body evaluated the predicate
-- via `evaluateWith "EagerStrategy"` against the AMBIENT `_localData`, which
-- only the TOP-LEVEL decider dispatch binds — so any NESTED
-- `setAlgebraContains(SeWhere, w)` (search filters, recursion under ∪/∩/¬)
-- judged the predicate over an absent binding and LIED (`Just false` for every
-- value — the defect Phase 4's search poison guard fenced). `whereMember`
-- threads the candidate AS AN ARGUMENT — the correct leaf shape — rebuilding
-- the proven localData per call.
--
-- Phase 4T Step W2 — the VERDICT rule (the retired text here promised that
-- "the `Err -> Just false` conservative posture carries unchanged"; it does
-- NOT, because `Just false` is not conservative for membership — only
-- `Nothing` is). `whereMember pred v` now answers `Just b` ONLY when the
-- predicate terminated normally with a value that IS a host Boolean. A throw,
-- an error value, an abstention, or an unsaturated application all answer
-- `Nothing`. The old rule ran the result through `truthy`, a TOTAL coercion,
-- which minted `Just false` from a crash AND `Just true` from an `Err e` / a
-- `Nothing` / a `Just false` / a partial application.
--
-- HONEST FENCE: the gate reads the TOP-LEVEL result, so a failure an enclosing
-- operator already laundered into a Boolean still decides
-- (`{">":[{call:["nope"]},0]}` is host `false`). Ledgered MISSING as
-- `mem.where.prov` in design/tcb-ledger.md; closing it needs failure
-- provenance through composed evaluation.
-- ============================================================================

-- ============================================================================
-- named-membership-to-fenel Phase 1 — the `Membership` registry seam.
--
-- `value ∈ {$named: name}` becomes a Fenel-decided `dispatch:*` registry
-- membership (design notes: workstreams/named-membership-to-fenel/notes/
-- phase-0-feasibility-and-design.md). A named set is `(name → membership
-- decider)` keyed by its string name — i.e. dispatch on the NAME. `Membership`
-- is a thin one-method spec-record label (`member`) over that registry; the
-- resolution is `dispatch:*` (subsumption — a string-keyed unary predicate is
-- the registry's native shape, NOT a full new typeclass).
--
-- THE SEAM. `setNamedContains` → the TS `dispatchedNamedContains` marshal
-- wrapper (engine-bodies-dispatch.ts — the `$where`/`dispatchedWhereContains`
-- precedent, a ledgered marshal-boundary arm) → THIS `namedContains` body:
--   • the wrapper handles `+`-composition + account precedence (D-A: they
--     entangle un-ported host names, so they stay TS this phase; port at the
--     capstone);
--   • `namedContains` resolves the `Membership` instance for the (atomic) name
--     and APPLIES its `member` predicate, or falls to the prefix-parameterized
--     families, or returns `Nothing` (the dual-registry sentinel — fall through
--     to the un-ported TS `NAMED_SETS` registry; the capstone deletes it).
--
-- DUAL-REGISTRY (approach A). Ported names resolve to a Fenel `Membership`
-- instance whose `member` is the fnId of one of the predicate bodies below;
-- un-ported names (regex `format:*`, host `format:url`/`date`, string/char
-- classes, markup, account) stay in TS `NAMED_SETS` and are reached via the
-- wrapper's `Nothing`→`containsNamedGlobal` fall-through. The DISPATCH-FIRST
-- ordering is load-bearing: the Fenel instance is tried before the legacy
-- closure, so porting a name DELETES its static `NAMED_SETS` entry in the same
-- step (no silent TS shadow).
--
-- BYTE-IDENTITY. Every ported name's verdict stays exactly what HEAD returned
-- (the named-membership-oracle.test.ts contract). Two recorded divergences,
-- both un-exercised by any oracle case + by any realistic input:
--   • `list:distinct` dedups via `eq` (structural) where TS used a
--     `JSON.stringify`-keyed Set — differs only for OBJECT elements with
--     differing key ORDER (numbers/strings/bools: identical). Named-set values
--     are validated scalars in practice.
--   • `format:path:max-length:N` / `NonEmpty` count CODE POINTS (`length`)
--     where TS counted UTF-16 units (`.length`) — differs only for non-BMP
--     (astral / emoji) strings; identical for the BMP.
-- ============================================================================

-- Membership — the spec-record label over the named-set dispatch registry. One
-- instance per built-in (or account) named set, keyed (ByType, string target)
-- on the name; `member` is a Fenel predicate reference whose result is either
-- a total Bool or a partial Tri. The `namedContains` adapter preserves both.
-- Thin label, no laws/supers (Phase 1). NB the
-- dispatch KEY is `ByType { target = name }` (the field-providers precedent —
-- the only key `dispatchLookupOne`/`resolveEffect` match today; `ByValue`
-- lookup is RESERVED at HEAD), NOT the Phase-0 note's nominal "ByValue".
MembershipVerdict = Any | membershipVerdictValid value
Membership = Membership member: (Any -> MembershipVerdict)

@category "engine-internal"
membershipVerdictValid : (value: a) -> Boolean
membershipVerdictValid value =
  case membershipBooleanVerdict value of
    Just _ -> true
    Nothing -> case value of
      Just verdict -> case membershipBooleanVerdict verdict of
        Just _ -> true
        Nothing -> false
      Nothing -> true
      _ -> false

@category "engine-internal"
membershipBooleanVerdict : (value: a) -> Maybe Boolean
membershipBooleanVerdict value =
  if isBoolean value then Just value
  else case value of
    True -> Just true
    False -> Just false
    _ -> Nothing

-- setAlgebraApplyMember — apply a resolved `member` predicate (an fnId handle
-- carried by the looked-up instance) to a value. The bare-application head
-- (`memberFn value`) is the `($) f x = f x` precedent: the loader rewrites the
-- local head to a `{var}`, and `callOp` resolves the fnId/ref through
-- `invokeFunction`. This is the pure-Fenel method-application shape (Step 0
-- shape ii — confirmed: no marshal-boundary broker needed).
@label "set-algebra: applyMember"
@description "named-membership Phase 1 — apply a resolved Membership `member` predicate (an fnId handle on the looked-up instance) to a value via bare application. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "membership"
@category "engine-internal"
setAlgebraApplyMember : (memberFn: (Any -> MembershipVerdict)) -> (value: Any) -> MembershipVerdict
setAlgebraApplyMember memberFn value = memberFn value

-- Membership procedures may abstain. Older total predicates return Bool;
-- partial procedures already return Tri. Preserve their result instead of
-- nesting it inside Just, so a resource fence never becomes a refutation.
@category "engine-internal"
setAlgebraMemberVerdict : (verdict: a) -> Maybe Boolean
setAlgebraMemberVerdict verdict =
  case membershipBooleanVerdict verdict of
    Just answer -> Just answer
    Nothing -> case verdict of
      Just value -> membershipBooleanVerdict value
      Nothing -> Nothing
      _ -> Nothing

-- ----------------------------------------------------------------------------
-- namedContains — the Membership-dispatch decider (the seam's Fenel core).
-- Resolve the instance for `name`; apply its `member` (Just verdict). On no
-- instance, try the prefix-parameterized families; on no prefix match, return
-- `Nothing` (the wrapper falls through to the un-ported TS NAMED_SETS). The
-- conservative-`false` posture on a truly-unknown name is preserved by the TS
-- fall-through (NAMED_SETS miss → false), byte-identical.
-- ----------------------------------------------------------------------------
@label "set-algebra: namedContains (Membership dispatch)"
@description "named-membership Phase 1 — decide `value ∈ {$named: name}` via the Membership registry: dispatchLookupOne resolves the per-name instance and applies its `member` predicate (Just verdict); on a miss, the prefix-parameterized families (multiple/list:maxdiff/list:span/format:path:max-*/ext); on no match, Nothing (the TS wrapper falls through to the un-ported NAMED_SETS — the dual-registry transition). `+`-composition + account precedence stay in the wrapper this phase. Mirrors implementations/typescript/engine/src/set-algebra.ts:containsNamed (the ported slice)."
@tags "engine" "set-algebra" "named" "membership" "contains" "phase-1"
namedContains : (name: String) -> (value: a) -> Maybe Boolean
namedContains name value = case dispatchLookupOne "Membership" name of
  Just inst -> setAlgebraMemberVerdict (setAlgebraApplyMember inst.member value)
  Nothing -> prefixParamContains name value

-- ----------------------------------------------------------------------------
-- prefixParamContains — the prefix-parameterized families (the names that do
-- NOT fit ByValue exact-match; a plain Fenel prefix-dispatch is the working
-- shape — ByPattern is reserved). Returns `Just verdict` when a family matches,
-- `Nothing` otherwise (no prefix → fall through). Preserves the exact vacuous-
-- true / type-mismatch semantics the oracle pins.
-- ----------------------------------------------------------------------------
@label "set-algebra: prefixParamContains"
@description "named-membership Phase 1 — the prefix-parameterized named-set families: multiple:N (mod), list:maxdiff:N, list:span:N, format:path:max-depth:N, format:path:max-length:N, format:path:ext:NAME. Returns Just verdict on a prefix match, Nothing otherwise. Parses the param via Fenel string ops. Mirrors the `name.startsWith(...)` branches of implementations/typescript/engine/src/set-algebra.ts:containsNamed."
@tags "engine" "set-algebra" "named" "membership" "prefix" "phase-1"
prefixParamContains : (name: String) -> (value: a) -> Maybe Boolean
prefixParamContains name value =
  if startsWith name "multiple:"
  then Just (setAlgebraMultipleN (setAlgebraParamAfter name "multiple:") value)
  else if startsWith name "list:maxdiff:"
  then Just (setAlgebraListMaxDiff (setAlgebraParamAfter name "list:maxdiff:") value)
  else if startsWith name "list:span:"
  then Just (setAlgebraListSpan (setAlgebraParamAfter name "list:span:") value)
  else if startsWith name "format:path:max-depth:"
  then Just (setAlgebraPathMaxDepth (setAlgebraParamAfter name "format:path:max-depth:") value)
  else if startsWith name "format:path:max-length:"
  then Just (setAlgebraPathMaxLength (setAlgebraParamAfter name "format:path:max-length:") value)
  else if startsWith name "format:path:ext:"
  then Just (setAlgebraPathExt (setAlgebraParamAfter name "format:path:ext:") value)
  else Nothing

-- setAlgebraParamAfter — the substring after a known prefix (the `:N` / `:NAME`).
@label "set-algebra: paramAfter"
@description "named-membership Phase 1 — slice the param substring after a known prefix. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "phase-1"
@category "engine-internal"
setAlgebraParamAfter : (name: String) -> (prefix: String) -> String
setAlgebraParamAfter name prefix = slice name (length prefix) (length name)

-- ============================================================================
-- The portable predicate bodies (the ported NAMED_SETS closures). Each is
-- registered as a Membership instance's `member`. Compose from the reflection
-- natives (isNumber / isString / isArray / isBoolean / numberIsFinite) + std
-- arithmetic / string / list ops.
-- ============================================================================

-- ℝ / Real / Number — finite native Number membership.
@label "set-algebra: membership ℝ/Number"
@description "Finite native-number membership (ℝ / Real / Number). Exact Rational membership has its own source Ratio rule."
@tags "engine" "set-algebra" "named" "membership" "numeric" "phase-1"
membershipReal : (value: a) -> Boolean
membershipReal value =
  if isNumber value
  then numberIsFinite value
  else false

-- setAlgebraIsInteger — finite + no fractional part (= Number.isInteger).
@label "set-algebra: isInteger"
@description "named-membership Phase 1 — Number.isInteger: finite and equal to its round. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "numeric" "phase-1"
@category "engine-internal"
setAlgebraIsInteger : (x: Number) -> Boolean
setAlgebraIsInteger x =
  if numberIsFinite x
  then eq (round x) x
  else false

-- String — any string. TS: typeof string.
@label "set-algebra: membership String"
@description "named-membership Phase 1 — string membership (String). Mirrors the NAMED_SETS `String` closure."
@tags "engine" "set-algebra" "named" "membership" "string" "phase-1"
membershipString : (value: a) -> Boolean
membershipString value = isString value

@label "set-algebra: membership Bytes"
@description "Strict membership in the Uint8Array host carrier of Bytes, whose pure view is List Byte. The isBytes native supplies only the host representation fact; ordinary named Membership dispatch selects this Fenel predicate."
@tags "engine" "set-algebra" "named" "membership" "bytes"
membershipBytes : (value: a) -> Boolean
membershipBytes value = isBytes value

-- NonEmpty — non-empty string. TS: typeof string && v.length > 0.
@label "set-algebra: membership NonEmpty"
@description "named-membership Phase 1 — non-empty-string membership (NonEmpty). Mirrors the NAMED_SETS `NonEmpty` closure (code-point count vs UTF-16: a non-empty string has length > 0 in both)."
@tags "engine" "set-algebra" "named" "membership" "string" "phase-1"
membershipNonEmpty : (value: a) -> Boolean
membershipNonEmpty value =
  if isString value
  then gt (length value) 0
  else false

-- Boolean / Bool — a boolean. TS: typeof boolean.
@label "set-algebra: membership Boolean/Bool"
@description "named-membership Phase 1 — boolean membership (Boolean / Bool). Mirrors the NAMED_SETS `Boolean`/`Bool` closures."
@tags "engine" "set-algebra" "named" "membership" "boolean" "phase-1"
membershipBoolean : (value: a) -> Boolean
membershipBoolean value = isBoolean value

-- ----------------------------------------------------------------------------
-- Char — signature-substrate slice 3jw §2a. THE PREREQUISITE: before this,
-- `Char` had NO Membership instance at all, so `namedMember Char "a"` answered
-- `Nothing` and every witness proposal for a Char re-checked to Nothing.
--
-- DENOTATION (the conceptual definition — Rom 2026-08-06: "Char = a | b | c |
-- … with every Unicode item, each one a constructor"). `Char` is the set of
-- UNICODE SCALAR VALUES, i.e. extensionally `⋃ {s}` over all scalars. On the
-- axiomatic floor that enumeration has the closed form
--
--     ⟦Char⟧  ≅  SeDiff (SeInterval 0 0x10FFFF) (SeInterval 0xD800 0xDFFF)
--
-- transported along the `Reprable JsRuntime Char` embed/retract pair
-- (charFromCode / charCode). Surrogate code points D800–DFFF are NOT scalars,
-- so they are NOT constructors, so they are NOT in ⟦Char⟧ — that is why the
-- lone-surrogate rows below refuse. `String = List Char` (Rom, same exchange)
-- is the pure view of the sibling; note the OPAQUE-REP GAP that follows from
-- it: the runtime carrier (a JS string) admits lone surrogates that the pure
-- `List Char` view has no denotation for. This predicate is exactly the
-- decision procedure that closes that gap at the boundary.
--
-- CARRIER: the native ONE-CODE-POINT STRING (the $opaque runtime rep), NOT the
-- pure refined-Nat view. A reader who assumes the pure view writes the wrong
-- predicate. `std:charCode` is total on all `String` and deliberately attests
-- over that wider declared domain (it answers 55296 for a lone high surrogate,
-- audited at slice 3j1); `Char` is the scalar SUBSET of `String`, and the
-- scalar restriction lives HERE. The two do not contradict — do not "fix" one
-- against the other.
--
-- Premise: NOT premise-free. `length` bottoms out in the host string iterator
-- and `charCode` in the global `String` + `String.prototype.codePointAt`, so
-- the row is THEORY-PLUGIN dependent on `env.primordials` (design/tcb-ledger.md
-- rows `mem.char` / `env.primordials`). `isString` (typeof) and the numeric
-- comparisons are premise-free; the enumerated closure is in the row.
--
-- Measured host facts this rests on (3jw probe, all re-measured live):
--   length ""=0 · "a"=1 · lone surrogate=1 · astral pair=1 · "\uDC00\uD800"=2
--   · "\uD800A"=2 · 97=0 · 7=0 · [97]=1   (so `length` ALONE cannot reject the
--   array carrier — `isString` is load-bearing, not decorative)
--   charCode ""=0 · 97→57 · 7→55 · [97]→57 (host `String(x)` coercion)
-- ----------------------------------------------------------------------------

@label "set-algebra: membership Char"
@description "signature-substrate slice 3jw §2a — Char membership with UNICODE-SCALAR semantics over the native one-code-point-string carrier: a String of exactly one code point whose code point is a scalar (i.e. outside the surrogate block D800–DFFF). Denotes ⟦Char⟧ = SeDiff (SeInterval 0 0x10FFFF) (SeInterval 0xD800 0xDFFF) transported along Reprable JsRuntime Char. `isString` is load-bearing: `length [97]` is 1, so a length-only test admits the array carrier. Does NOT contradict `std:charCode`, which is total on the wider declared domain `String`. TCB row `mem.char` (THEORY-PLUGIN on `env.primordials`)."
@tags "engine" "set-algebra" "named" "membership" "char" "unicode" "signature-substrate" "slice-3jw"
membershipChar : (value: a) -> Boolean
membershipChar value =
  if isString value
  then
    if eq (length value) 1
    then charCodeIsScalar (charCode value)
    else false
  else false

@label "set-algebra: charCodeIsScalar"
@description "signature-substrate slice 3jw §2a — is a Number a Unicode SCALAR VALUE? True exactly on [0, 0x10FFFF] MINUS the surrogate block D800–DFFF (55296–57343), which UTF-16 reserves for pair encoding and which therefore denotes no Char constructor. This is the closed form ⟦Char⟧ ≅ SeDiff (SeInterval 0 0x10FFFF) (SeInterval 0xD800 0xDFFF) read as a predicate. Total on all Numbers and CORRECT over the whole declared domain: the range bounds are not redundant with the caller's guard — a review round observed that a surrogate-exclusion-only version answered true for -1, 0x110000 and Infinity, none of which is a scalar. Premise-free (numeric comparison only). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "membership" "char" "unicode" "signature-substrate" "slice-3jw"
@category "engine-internal"
charCodeIsScalar : (c: Number) -> Boolean
charCodeIsScalar c =
  if lt c 0 then false
  else if gt c 1114111 then false
  else if lt c 55296 then true
  else if gt c 57343 then true else false

-- ----------------------------------------------------------------------------
-- list:* exact constraints.
-- ----------------------------------------------------------------------------

-- list:distinct — all elements distinct. TS: !isArray → false; else unique.
-- (Dedups via `eq`; see the byte-identity note above re: object elements.)
@label "set-algebra: membership list:distinct"
@description "named-membership Phase 1 — list:distinct (all elements distinct). Non-array → false. Dedup via structural `eq` (object-key-order divergence noted in the file header). Mirrors the NAMED_SETS `list:distinct` closure."
@tags "engine" "set-algebra" "named" "membership" "list" "phase-1"
membershipListDistinct : (value: a) -> Boolean
membershipListDistinct value =
  if isArray value
  then setAlgebraAllDistinct value
  else false

@label "set-algebra: allDistinct"
@description "named-membership Phase 1 — pairwise-distinct list check (O(n²) via setAlgebraEnumContainsLoop). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "list" "phase-1"
@category "engine-internal"
setAlgebraAllDistinct : (xs: List a) -> Boolean
setAlgebraAllDistinct xs = case head xs of
  Nothing -> true
  Just first ->
    case tail xs of
      Nothing -> true
      Just rest ->
        if setAlgebraEnumContainsLoop rest first
        then false
        else setAlgebraAllDistinct rest

-- list:ascending / descending / nondecreasing / nonincreasing — pairwise order.
-- TS: !isArray || len < 2 → true (vacuous); else require the adjacent relation.
@label "set-algebra: membership list:ascending"
@description "named-membership Phase 1 — list:ascending (strictly increasing). Non-array or < 2 elements → vacuously true. Mirrors the NAMED_SETS `list:ascending` closure."
@tags "engine" "set-algebra" "named" "membership" "list" "phase-1"
membershipListAscending : (value: a) -> Boolean
membershipListAscending value = setAlgebraListOrdered "ascending" value

@label "set-algebra: membership list:descending"
@description "named-membership Phase 1 — list:descending (strictly decreasing). Non-array or < 2 elements → vacuously true. Mirrors the NAMED_SETS `list:descending` closure."
@tags "engine" "set-algebra" "named" "membership" "list" "phase-1"
membershipListDescending : (value: a) -> Boolean
membershipListDescending value = setAlgebraListOrdered "descending" value

@label "set-algebra: membership list:nondecreasing"
@description "named-membership Phase 1 — list:nondecreasing (each ≥ previous). Non-array or < 2 elements → vacuously true. Mirrors the NAMED_SETS `list:nondecreasing` closure."
@tags "engine" "set-algebra" "named" "membership" "list" "phase-1"
membershipListNondecreasing : (value: a) -> Boolean
membershipListNondecreasing value = setAlgebraListOrdered "nondecreasing" value

@label "set-algebra: membership list:nonincreasing"
@description "named-membership Phase 1 — list:nonincreasing (each ≤ previous). Non-array or < 2 elements → vacuously true. Mirrors the NAMED_SETS `list:nonincreasing` closure."
@tags "engine" "set-algebra" "named" "membership" "list" "phase-1"
membershipListNonincreasing : (value: a) -> Boolean
membershipListNonincreasing value = setAlgebraListOrdered "nonincreasing" value

@label "set-algebra: listOrdered"
@description "named-membership Phase 1 — shared list-ordering check parameterized by mode; non-array or < 2 elements → vacuously true. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "list" "phase-1"
@category "engine-internal"
setAlgebraListOrdered : (mode: String) -> (value: a) -> Boolean
setAlgebraListOrdered mode value =
  if isArray value
  then if lt (length value) 2 then true else setAlgebraOrderedChain mode value
  else true

@label "set-algebra: orderedChain"
@description "named-membership Phase 1 — pairwise-adjacent ordering walk for the list:* order constraints. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "list" "phase-1"
@category "engine-internal"
setAlgebraOrderedChain : (mode: String) -> (xs: List a) -> Boolean
setAlgebraOrderedChain mode xs = case head xs of
  Nothing -> true
  Just first ->
    case tail xs of
      Nothing -> true
      Just rest ->
        case head rest of
          Nothing -> true
          Just second ->
            if setAlgebraOrderPairOk mode first second
            then setAlgebraOrderedChain mode rest
            else false

@label "set-algebra: orderPairOk"
@description "named-membership Phase 1 — the adjacent-pair relation for each list-order mode (ascending → b > a; descending → b < a; nondecreasing → b ≥ a; nonincreasing → b ≤ a). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "list" "phase-1"
@category "engine-internal"
setAlgebraOrderPairOk : (mode: String) -> (a: a) -> (b: a) -> Boolean
setAlgebraOrderPairOk mode a b =
  if eq mode "ascending" then gt b a
  else if eq mode "descending" then lt b a
  else if eq mode "nondecreasing" then gte b a
  else lte b a

-- ----------------------------------------------------------------------------
-- format:path:* exact string-op predicates (the clean, non-regex ones).
-- DEFERRED to Phase 2 (Pattern / char-class) — kept in TS NAMED_SETS:
--   format:path:windows  (UNC + drive regex), format:path:portable
--   (charset regex), format:path:no-reserved (CON/PRN/… reserved-name regex).
-- ----------------------------------------------------------------------------

-- setAlgebraPathSegments — split on BOTH separators (= TS `v.split(/[\\/]/)`):
-- normalise `\` to `/`, then split on `/`.
@label "set-algebra: pathSegments"
@description "named-membership Phase 1 — split a path on both separators (backslash normalised to slash, then split on slash) = TS `v.split(/[\\/]/)`. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraPathSegments : (s: String) -> List String
setAlgebraPathSegments s = split (replaceAll s "\\" "/") "/"

-- setAlgebraIsAsciiLetter — single-char [A-Za-z] (the `/^[A-Za-z]/` driver).
@label "set-algebra: isAsciiLetter"
@description "named-membership Phase 1 — is a single-char string an ASCII letter [A-Za-z] (lexicographic char compare). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraIsAsciiLetter : (c: String) -> Boolean
setAlgebraIsAsciiLetter c =
  or (and (gte c "A") (lte c "Z")) (and (gte c "a") (lte c "z"))

-- setAlgebraHasDrivePrefix — `/^[A-Za-z]:/` (letter then colon).
@label "set-algebra: hasDrivePrefix"
@description "named-membership Phase 1 — does the path start with a `[A-Za-z]:` drive prefix? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraHasDrivePrefix : (s: String) -> Boolean
setAlgebraHasDrivePrefix s =
  if setAlgebraIsAsciiLetter (slice s 0 1)
  then eq (slice s 1 2) ":"
  else false

-- setAlgebraHasDriveSlash — `/^[A-Za-z]:[\\/]/` (drive prefix then a separator).
@label "set-algebra: hasDriveSlash"
@description "named-membership Phase 1 — does the path start with a `[A-Za-z]:[\\/]` drive-and-separator prefix? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraHasDriveSlash : (s: String) -> Boolean
setAlgebraHasDriveSlash s =
  if setAlgebraHasDrivePrefix s
  then or (eq (slice s 2 3) "/") (eq (slice s 2 3) "\\")
  else false

-- setAlgebraIsNonEmpty — typeof string && length > 0 (the absolute/relative base).
@label "set-algebra: isNonEmptyString"
@description "named-membership Phase 1 — string and non-empty (the format:path:absolute / :relative base guard). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraIsNonEmpty : (value: a) -> Boolean
setAlgebraIsNonEmpty value =
  if isString value
  then gt (length value) 0
  else false

-- setAlgebraIsNonEmptyNoNull — string && length > 0 && no NUL (the posix base).
@label "set-algebra: isNonEmptyNoNull"
@description "named-membership Phase 1 — string, non-empty, and no NUL byte (the format:path / :posix base guard). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraIsNonEmptyNoNull : (value: a) -> Boolean
setAlgebraIsNonEmptyNoNull value =
  if setAlgebraIsNonEmpty value
  then not (contains value (charFromCode 0))
  else false

-- format:path — non-empty, no NUL byte.
@label "set-algebra: membership format:path"
@description "named-membership Phase 1 — format:path (non-empty path-shaped string, no NUL byte). Mirrors the NAMED_SETS `format:path` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPath : (value: a) -> Boolean
membershipFormatPath value = setAlgebraIsNonEmptyNoNull value

-- format:path:posix — base ok, no backslash, no drive prefix.
@label "set-algebra: membership format:path:posix"
@description "named-membership Phase 1 — format:path:posix ('/'-separated, no backslash, no drive prefix). Mirrors the NAMED_SETS `format:path:posix` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathPosix : (value: a) -> Boolean
membershipFormatPathPosix value =
  if setAlgebraIsNonEmptyNoNull value
  then if contains value "\\" then false else not (setAlgebraHasDrivePrefix value)
  else false

-- format:path:absolute — leading '/', or drive+sep, or UNC '\\'.
@label "set-algebra: membership format:path:absolute"
@description "named-membership Phase 1 — format:path:absolute (leading '/', drive+separator, or UNC '\\\\'). Mirrors the NAMED_SETS `format:path:absolute` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathAbsolute : (value: a) -> Boolean
membershipFormatPathAbsolute value =
  if setAlgebraIsNonEmpty value
  then
    if startsWith value "/"
    then true
    else if setAlgebraHasDriveSlash value
    then true
    else startsWith value "\\\\"
  else false

-- format:path:relative — non-empty and NOT absolute (no '/', drive, or UNC).
@label "set-algebra: membership format:path:relative"
@description "named-membership Phase 1 — format:path:relative (non-empty, not '/'-rooted, not drive-prefixed, not UNC). Mirrors the NAMED_SETS `format:path:relative` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathRelative : (value: a) -> Boolean
membershipFormatPathRelative value =
  if setAlgebraIsNonEmpty value
  then
    if startsWith value "/"
    then false
    else if setAlgebraHasDrivePrefix value
    then false
    else not (startsWith value "\\\\")
  else false

-- format:path:no-traversal — no `..` segment.
@label "set-algebra: membership format:path:no-traversal"
@description "named-membership Phase 1 — format:path:no-traversal (no '..' segment). Mirrors the NAMED_SETS `format:path:no-traversal` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathNoTraversal : (value: a) -> Boolean
membershipFormatPathNoTraversal value =
  if isString value
  then not (setAlgebraEnumContainsLoop (setAlgebraPathSegments value) "..")
  else false

-- format:path:no-current — no `.` segment.
@label "set-algebra: membership format:path:no-current"
@description "named-membership Phase 1 — format:path:no-current (no '.' segment). Mirrors the NAMED_SETS `format:path:no-current` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathNoCurrent : (value: a) -> Boolean
membershipFormatPathNoCurrent value =
  if isString value
  then not (setAlgebraEnumContainsLoop (setAlgebraPathSegments value) ".")
  else false

-- format:path:no-hidden — no dotfile segment (startsWith '.', != '.' and '..').
@label "set-algebra: membership format:path:no-hidden"
@description "named-membership Phase 1 — format:path:no-hidden (no dotfile segment). Mirrors the NAMED_SETS `format:path:no-hidden` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathNoHidden : (value: a) -> Boolean
membershipFormatPathNoHidden value =
  if isString value
  then not (setAlgebraAnyHidden (setAlgebraPathSegments value))
  else false

@label "set-algebra: anyHidden"
@description "named-membership Phase 1 — does any path segment look hidden? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraAnyHidden : (segs: List a) -> Boolean
setAlgebraAnyHidden segs = case head segs of
  Nothing -> false
  Just seg ->
    if setAlgebraIsHiddenSeg seg
    then true
    else case tail segs of
      Nothing -> false
      Just rest -> setAlgebraAnyHidden rest

@label "set-algebra: isHiddenSeg"
@description "named-membership Phase 1 — a hidden segment: non-empty, starts with '.', and is neither '.' nor '..'. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraIsHiddenSeg : (seg: String) -> Boolean
setAlgebraIsHiddenSeg seg =
  if gt (length seg) 0
  then
    if startsWith seg "."
    then if eq seg "." then false else if eq seg ".." then false else true
    else false
  else false

-- format:path:no-empty-segment — no INTERIOR empty segment (indices 1..len-2).
@label "set-algebra: membership format:path:no-empty-segment"
@description "named-membership Phase 1 — format:path:no-empty-segment (no interior empty segment; a leading/trailing separator is allowed). Mirrors the NAMED_SETS `format:path:no-empty-segment` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathNoEmptySegment : (value: a) -> Boolean
membershipFormatPathNoEmptySegment value =
  if isString value
  then
    case tail (setAlgebraPathSegments value) of
      Nothing -> true
      Just afterFirst -> setAlgebraAllButLastNonEmpty afterFirst
  else false

@label "set-algebra: allButLastNonEmpty"
@description "named-membership Phase 1 — every element except the last is non-empty (the interior-segment check after dropping the first). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraAllButLastNonEmpty : (xs: List String) -> Boolean
setAlgebraAllButLastNonEmpty xs = case head xs of
  Nothing -> true
  Just first ->
    case tail xs of
      Nothing -> true
      Just rest ->
        if eq first ""
        then false
        else setAlgebraAllButLastNonEmpty rest

-- format:path:no-trailing-sep — length > 1 and no trailing '/' or '\'.
@label "set-algebra: membership format:path:no-trailing-sep"
@description "named-membership Phase 1 — format:path:no-trailing-sep (length > 1, no trailing separator). Mirrors the NAMED_SETS `format:path:no-trailing-sep` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathNoTrailingSep : (value: a) -> Boolean
membershipFormatPathNoTrailingSep value =
  if isString value
  then
    if gt (length value) 1
    then if endsWith value "/" then false else not (endsWith value "\\")
    else false
  else false

-- format:path:no-null-byte — no NUL byte.
@label "set-algebra: membership format:path:no-null-byte"
@description "named-membership Phase 1 — format:path:no-null-byte (no NUL byte). Mirrors the NAMED_SETS `format:path:no-null-byte` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathNoNullByte : (value: a) -> Boolean
membershipFormatPathNoNullByte value =
  if isString value
  then not (contains value (charFromCode 0))
  else false

-- format:path:no-alt-stream — no ':' after the optional drive prefix (NTFS ADS).
@label "set-algebra: membership format:path:no-alt-stream"
@description "named-membership Phase 1 — format:path:no-alt-stream (no ':' after the optional drive prefix — NTFS alternate streams). Mirrors the NAMED_SETS `format:path:no-alt-stream` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathNoAltStream : (value: a) -> Boolean
membershipFormatPathNoAltStream value =
  if isString value
  then not (contains (setAlgebraAltStreamTail value) ":")
  else false

@label "set-algebra: altStreamTail"
@description "named-membership Phase 1 — the path tail after a drive prefix (`v.slice(2)` when `/^[A-Za-z]:[\\/]/`, else the whole string). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraAltStreamTail : (value: String) -> String
setAlgebraAltStreamTail value =
  if setAlgebraHasDriveSlash value
  then slice value 2 (length value)
  else value

-- format:path:no-trailing-space-or-dot — no segment ends in a space or a dot.
@label "set-algebra: membership format:path:no-trailing-space-or-dot"
@description "named-membership Phase 1 — format:path:no-trailing-space-or-dot (no segment ends in a space or a dot). Mirrors the NAMED_SETS `format:path:no-trailing-space-or-dot` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "phase-1"
membershipFormatPathNoTrailingSpaceOrDot : (value: a) -> Boolean
membershipFormatPathNoTrailingSpaceOrDot value =
  if isString value
  then not (setAlgebraAnyTrailingSpaceDot (setAlgebraPathSegments value))
  else false

@label "set-algebra: anyTrailingSpaceDot"
@description "named-membership Phase 1 — does any non-empty segment end in a space or a dot? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraAnyTrailingSpaceDot : (segs: List a) -> Boolean
setAlgebraAnyTrailingSpaceDot segs = case head segs of
  Nothing -> false
  Just seg ->
    if setAlgebraSegTrailingSpaceDot seg
    then true
    else case tail segs of
      Nothing -> false
      Just rest -> setAlgebraAnyTrailingSpaceDot rest

@label "set-algebra: segTrailingSpaceDot"
@description "named-membership Phase 1 — a non-empty segment ending in a space or a dot. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "phase-1"
@category "engine-internal"
setAlgebraSegTrailingSpaceDot : (seg: String) -> Boolean
setAlgebraSegTrailingSpaceDot seg =
  if gt (length seg) 0
  then or (endsWith seg " ") (endsWith seg ".")
  else false

-- ----------------------------------------------------------------------------
-- The prefix-parameterized family bodies (Step 3).
-- ----------------------------------------------------------------------------

-- multiple:N — value is a number divisible by N (N ≠ 0, both finite).
@label "set-algebra: multipleN"
@description "named-membership Phase 1 — multiple:N: a finite number divisible by N (N ≠ 0). Non-number / non-finite N / N = 0 → false. Mirrors the `multiple:` branch of containsNamed. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "phase-1"
@category "engine-internal"
setAlgebraMultipleN : (suffix: String) -> (value: a) -> Boolean
setAlgebraMultipleN suffix value =
  let n = toNumber suffix
  if isNumber value
  then
    if numberIsFinite n
    then if eq n 0 then false else eq (mod value n) 0
    else false
  else false

-- list:maxdiff:N — adjacent differences all ≤ N. Vacuous-true on non-array,
-- < 2 elements, or NaN N (`eq n n` is the exact `!isNaN` test).
@label "set-algebra: listMaxDiff"
@description "named-membership Phase 1 — list:maxdiff:N: |v[i] - v[i-1]| ≤ N for all adjacent pairs. Non-array / < 2 elements / NaN N → vacuously true. Mirrors the `list:maxdiff:` branch. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "list" "phase-1"
@category "engine-internal"
setAlgebraListMaxDiff : (suffix: String) -> (value: a) -> Boolean
setAlgebraListMaxDiff suffix value =
  let maxDiff = toNumber suffix
  if isArray value
  then
    if lt (length value) 2
    then true
    else if eq maxDiff maxDiff
    then setAlgebraMaxDiffChain value maxDiff
    else true
  else true

@label "set-algebra: maxDiffChain"
@description "named-membership Phase 1 — adjacent-difference walk for list:maxdiff:N. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "list" "phase-1"
@category "engine-internal"
setAlgebraMaxDiffChain : (xs: List Number) -> (maxDiff: Number) -> Boolean
setAlgebraMaxDiffChain xs maxDiff = case head xs of
  Nothing -> true
  Just first ->
    case tail xs of
      Nothing -> true
      Just rest ->
        case head rest of
          Nothing -> true
          Just second ->
            if gt (abs (sub second first)) maxDiff
            then false
            else setAlgebraMaxDiffChain rest maxDiff

-- list:span:N — max - min ≤ N. Same vacuous-true guard as maxdiff.
@label "set-algebra: listSpan"
@description "named-membership Phase 1 — list:span:N: max - min ≤ N. Non-array / < 2 elements / NaN N → vacuously true. Mirrors the `list:span:` branch. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "list" "phase-1"
@category "engine-internal"
setAlgebraListSpan : (suffix: String) -> (value: a) -> Boolean
setAlgebraListSpan suffix value =
  let maxSpan = toNumber suffix
  if isArray value
  then
    if lt (length value) 2
    then true
    else if eq maxSpan maxSpan
    then lte (sub (setAlgebraListMax value) (setAlgebraListMin value)) maxSpan
    else true
  else true

@label "set-algebra: listMax"
@description "named-membership Phase 1 — maximum of a non-empty number list (recursive). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "list" "phase-1"
@category "engine-internal"
setAlgebraListMax : (xs: List Number) -> Number
setAlgebraListMax xs = case head xs of
  Nothing -> 0
  Just first ->
    case tail xs of
      Nothing -> first
      Just rest -> max first (setAlgebraListMax rest)

@label "set-algebra: listMin"
@description "named-membership Phase 1 — minimum of a non-empty number list (recursive). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "list" "phase-1"
@category "engine-internal"
setAlgebraListMin : (xs: List Number) -> Number
setAlgebraListMin xs = case head xs of
  Nothing -> 0
  Just first ->
    case tail xs of
      Nothing -> first
      Just rest -> min first (setAlgebraListMin rest)

-- format:path:max-depth:N — at most N non-empty segments. Non-string /
-- non-finite N → false.
@label "set-algebra: pathMaxDepth"
@description "named-membership Phase 1 — format:path:max-depth:N: at most N non-empty path segments. Non-string / non-finite N → false. Mirrors the `format:path:max-depth:` branch. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "path" "phase-1"
@category "engine-internal"
setAlgebraPathMaxDepth : (suffix: String) -> (value: a) -> Boolean
setAlgebraPathMaxDepth suffix value =
  let n = toNumber suffix
  if isString value
  then if numberIsFinite n then lte (setAlgebraCountNonEmpty (setAlgebraPathSegments value)) n else false
  else false

@label "set-algebra: countNonEmpty"
@description "named-membership Phase 1 — count of non-empty segments (the depth measure). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "path" "phase-1"
@category "engine-internal"
setAlgebraCountNonEmpty : (segs: List String) -> Number
setAlgebraCountNonEmpty segs = case head segs of
  Nothing -> 0
  Just seg ->
    let restCount = case tail segs of
      Nothing -> 0
      Just rest -> setAlgebraCountNonEmpty rest
    if gt (length seg) 0 then add 1 restCount else restCount

-- format:path:max-length:N — string length ≤ N. Non-string / non-finite N →
-- false. (Counts code points; see the byte-identity note re: non-BMP.)
@label "set-algebra: pathMaxLength"
@description "named-membership Phase 1 — format:path:max-length:N: string length ≤ N. Non-string / non-finite N → false (code-point count; non-BMP divergence noted in the file header). Mirrors the `format:path:max-length:` branch. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "path" "phase-1"
@category "engine-internal"
setAlgebraPathMaxLength : (suffix: String) -> (value: a) -> Boolean
setAlgebraPathMaxLength suffix value =
  let n = toNumber suffix
  if isString value
  then if numberIsFinite n then lte (length value) n else false
  else false

-- format:path:ext:NAME — last segment ends in `.<ext>` (case-insensitive); the
-- param may list alternatives via `|` (ext:png|jpg|webp).
@label "set-algebra: pathExt"
@description "named-membership Phase 1 — format:path:ext:NAME: the last path segment ends in `.<ext>` (case-insensitive); the param lists alternatives via `|`. Non-string → false. Mirrors the `format:path:ext:` branch. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "path" "phase-1"
@category "engine-internal"
setAlgebraPathExt : (suffix: String) -> (value: a) -> Boolean
setAlgebraPathExt suffix value =
  if isString value
  then setAlgebraAnyExtMatch (split suffix "|") (lower (setAlgebraLastSegment value))
  else false

@label "set-algebra: lastSegment"
@description "named-membership Phase 1 — the last path segment (empty string when none). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "path" "phase-1"
@category "engine-internal"
setAlgebraLastSegment : (value: String) -> String
setAlgebraLastSegment value = case last (setAlgebraPathSegments value) of
  Nothing -> ""
  Just seg -> seg

@label "set-algebra: anyExtMatch"
@description "named-membership Phase 1 — does the lowercased last segment end in `.<ext>` for any of the (lowercased) candidate extensions? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "prefix" "path" "phase-1"
@category "engine-internal"
setAlgebraAnyExtMatch : (exts: List String) -> (lowerLast: String) -> Boolean
setAlgebraAnyExtMatch exts lowerLast = case head exts of
  Nothing -> false
  Just e ->
    if endsWith lowerLast (concat "." (lower e))
    then true
    else case tail exts of
      Nothing -> false
      Just rest -> setAlgebraAnyExtMatch rest lowerLast

-- ============================================================================
-- named-membership-to-fenel Phase 3 — `format:url*` + `format:date`/`datetime`.
--
-- THE CORRECTION THAT DEFINES THIS PHASE. An earlier draft framed `new URL()`
-- / `new Date()` as "irreducible host leaves". That was the exact
-- "string-format parsing must be done in TS" rationalization AGENTS.md forbids
-- (retracted 2026-06-22). URL + date validation are PURE pattern-matching over
-- strings: split on `://` / `:` / `/` / `?` / `#`, extract scheme/host/port,
-- check ranges + suffixes. They PORT to Fenel with ZERO new TS — these bodies
-- are `Membership` instances of the Phase-1 value-predicate shape (string-ops
-- only; the Phase-2 codepoint-marshal blocker does NOT apply, since these take
-- the raw value directly rather than walking a Pattern's code points).
--
-- BYTE-IDENTITY (the contract). Every existing named-membership-oracle.test.ts
-- URL case stays exactly true/false; the oracle is EXTENDED with the URL
-- acceptance-set cases that lock `parseUrlParts`' boundary. The URL parser
-- reproduces `new URL()`'s acceptance on the ASCII corpus (IDN / punycode is
-- NOT exercised — every host is ASCII). A handful of un-exercised V8 quirks
-- (e.g. a bare `http://` with empty host) diverge on the deliberately-defined
-- boundary; documented inline, none in the corpus.
--
-- DATE SEMANTICS (Decisions #1 = (A), the recommended clean set). `new Date()`
-- non-ISO leniency is implementation-defined (V8-specific, unspec'd). Rather
-- than enshrine V8, `format:date`/`datetime` are DEFINED as a clean,
-- cross-engine-stable acceptance set: ISO 8601 date (`YYYY-MM-DD`), ISO
-- datetime (`YYYY-MM-DD`(`T`|space)`HH:MM`(`:SS`)?(`.fff`)?(`Z`|±`HH:MM`)?), and
-- the month-name form (`Mon[th] D[D] YYYY`, e.g. "Jan 1 2020"). All six
-- existing oracle date cases ("2020-01-01"✓, "Jan 1 2020"✓, "not a date"✗,
-- ""✗, "2020-01-01T00:00:00Z"✓, "garbage"✗) stay byte-identical, so NO oracle
-- re-pin is needed — the defined set already covers the common forms the oracle
-- exercises; only V8's weird long-tail (which the corpus never hits) is dropped.
-- `format:date` and `format:datetime` were identical at HEAD (both `new Date()`)
-- and STAY identical here (both delegate to `membershipFormatDate`).
--
-- DELIBERATE V8 long-tail dropped (the defined boundary; none in the oracle):
--   • slash dates ("2020/01/01", "01/31/2020") — the `format:date:us`/`:eu`
--     presets carry slash forms; the base name is ISO-dashed + month-name only;
--   • D-Mon-Y order ("31 Dec 2020"), weekday prefix ("Mon Jan 01 2020"), bare
--     year ("2020"), 2-digit year ("Jan 1 20") — V8 accepts; the clean set does
--     not (cross-engine-unstable / ambiguous);
--   • shape-only (no range check): "2020-13-01" / "...T25:99" are ACCEPTED (V8
--     rejects) — matching the existing `format:time` shape-only convention (the
--     oracle pins `format:time "25:99" → true`).
--
-- URL boundary (the defined acceptance; verified byte-identical to `new URL()`
-- across an extended 32×12 sample — ASCII hosts, no punycode): one documented
-- divergence — the protocol-relative "//x.com" (no scheme, leading "//"):
-- `new URL("http:////x.com")` collapses the slashes to host "x.com" (⇒ true),
-- whereas `parseUrlParts` reads an empty authority before the first "/" (⇒
-- false). An obscure form, not in any realistic corpus; flagged not chased.
--
-- D-url-route (Decisions #3) = a DIRECT Fenel string-op `parseUrlParts` (not
-- the `format:url:structured` Pattern + `extractCaptures`): it reproduces
-- `new URL()`'s normalize-and-split on the corpus most cleanly (the presets
-- already normalize schemeless inputs as `v.includes("://") ? v : "http://"+v`,
-- which `parseUrlParts` mirrors EXACTLY), and keeps each predicate a flat
-- string-op body with no Pattern marshalling.
-- ============================================================================

-- UrlParts — the parsed view of a URL string: scheme (lowercased), host
-- (lowercased, brackets-kept for IPv6), port (string, "" when absent). A
-- `Nothing` from parseUrlParts models `new URL()` THROWING (empty host or a
-- space in the host — the only failure modes the corpus exercises).
UrlParts = UrlParts scheme: String host: String port: String

-- HostPort — the host/port split of a URL authority.
HostPort = HostPort host: String port: String

-- ----------------------------------------------------------------------------
-- Char-class membership via charset-string lookup. NB the runtime's `gt`/`lt`/
-- `gte`/`lte` coerce BOTH sides through `num()` (`Number(x) || 0`), so a
-- char-ORDER comparison (`gte c "0"`) maps every non-numeric char to 0 and
-- mis-classifies letters as digits. The reliable test is membership in an
-- explicit charset string (`contains "0123456789" c`), which is what these use.
-- ----------------------------------------------------------------------------
@label "set-algebra: charInClass"
@description "named-membership Phase 3 — single-char class membership via charset-string lookup (digit / alpha / alnum / alnum-hyphen / scheme). Reliable regardless of the num()-coercing comparison ops. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraCharInClass : (cls: String) -> (c: String) -> Boolean
setAlgebraCharInClass cls c =
  if eq (length c) 1
  then
    if eq cls "digit" then contains "0123456789" c
    else if eq cls "alpha" then contains "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" c
    else if eq cls "alnum" then contains "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" c
    else if eq cls "alnum-hyphen" then contains "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-" c
    else if eq cls "scheme" then contains "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+.-" c
    else if eq cls "hex" then contains "0123456789abcdef" c
    else if eq cls "path-portable" then contains "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-/ " c
    else false
  else false

@label "set-algebra: allChars"
@description "named-membership Phase 3 — do all chars of `s` belong to char-class `cls`? Empty string ⇒ true (callers guard length where non-empty is required). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraAllChars : (cls: String) -> (s: String) -> Boolean
setAlgebraAllChars cls s = setAlgebraAllCharsLoop cls s 0

@label "set-algebra: allCharsLoop"
@description "named-membership Phase 3 — index walk for setAlgebraAllChars. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraAllCharsLoop : (cls: String) -> (s: String) -> (i: Number) -> Boolean
setAlgebraAllCharsLoop cls s i =
  if gte i (length s)
  then true
  else
    if setAlgebraCharInClass cls (slice s i (add i 1))
    then setAlgebraAllCharsLoop cls s (add i 1)
    else false

-- setAlgebraDigitsBetween — chars [from, to) are all digits (and to ≤ length).
@label "set-algebra: digitsBetween"
@description "named-membership Phase 3 — are chars [from, to) of `s` all digits (and to ≤ length)? The positional digit-run check for the ISO date/time grammar. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraDigitsBetween : (s: String) -> (from: Number) -> (to: Number) -> Boolean
setAlgebraDigitsBetween s from to =
  if gt to (length s)
  then false
  else setAlgebraAllChars "digit" (slice s from to)

-- ----------------------------------------------------------------------------
-- URL scheme — the part before the first ":" when it is a valid scheme token
-- (`[a-zA-Z][a-zA-Z0-9+.-]*`), lowercased; "" otherwise. Mirrors
-- `/^[a-zA-Z][a-zA-Z0-9+.-]*:/i` (anchored at start; head-of-split-on-":" IS
-- the anchored prefix).
-- ----------------------------------------------------------------------------
@label "set-algebra: urlScheme"
@description "named-membership Phase 3 — the lowercased URL scheme (part before the first ':' when a valid scheme token), or '' when there is none. Mirrors `/^[a-zA-Z][a-zA-Z0-9+.-]*:/i`. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraUrlScheme : (s: String) -> String
setAlgebraUrlScheme s =
  if contains s ":"
  then
    case head (split s ":") of
      Nothing -> ""
      Just cand -> if setAlgebraIsSchemeToken cand then lower cand else ""
  else ""

@label "set-algebra: isSchemeToken"
@description "named-membership Phase 3 — is `cand` a valid URL scheme token (non-empty, first char alpha, all chars in [a-zA-Z0-9+.-])? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraIsSchemeToken : (cand: String) -> Boolean
setAlgebraIsSchemeToken cand =
  if eq (length cand) 0
  then false
  else and (setAlgebraCharInClass "alpha" (slice cand 0 1)) (setAlgebraAllChars "scheme" cand)

-- ----------------------------------------------------------------------------
-- parseUrlParts — the Fenel URL parser. Normalizes a schemeless input the SAME
-- way the host-parse presets do (`v.includes("://") ? v : "http://"+v`), splits
-- off the authority, strips userinfo, splits host/port (IPv6-bracket aware),
-- lowercases the host. Returns Nothing (≡ `new URL()` throwing) when the host
-- is empty or contains a space — the failure modes the corpus exercises.
-- ----------------------------------------------------------------------------
@label "set-algebra: parseUrlParts"
@description "named-membership Phase 3 — parse a URL string into Maybe (UrlParts scheme host port) via pure string-ops, mirroring `new URL(v.includes('://') ? v : 'http://'+v)`'s acceptance on the ASCII corpus (IDN/punycode not exercised). Nothing ≡ new URL() throwing (empty host / space in host)."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
parseUrlParts : (value: String) -> Maybe UrlParts
parseUrlParts value =
  let normalized = if contains value "://" then value else concat "http://" value
  let afterScheme = setAlgebraAfterScheme normalized
  let authority = setAlgebraTakeUntil afterScheme
  let hostport = setAlgebraAfterLastAt authority
  let scheme = lower (setAlgebraSchemeOfNormalized normalized)
  setAlgebraBuildUrlParts scheme hostport

@label "set-algebra: afterScheme"
@description "named-membership Phase 3 — everything after the first '://' (joined back when the URL contains more than one). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraAfterScheme : (normalized: String) -> String
setAlgebraAfterScheme normalized =
  case tail (split normalized "://") of
    Nothing -> normalized
    Just rest -> join rest "://"

@label "set-algebra: schemeOfNormalized"
@description "named-membership Phase 3 — the raw scheme token (before the first '://') of the normalized URL. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraSchemeOfNormalized : (normalized: String) -> String
setAlgebraSchemeOfNormalized normalized =
  case head (split normalized "://") of
    Nothing -> ""
    Just h -> h

@label "set-algebra: takeUntil"
@description "named-membership Phase 3 — the authority prefix: chars before the first '/', '?', or '#'. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraTakeUntil : (s: String) -> String
setAlgebraTakeUntil s = setAlgebraTakeUntilLoop s 0

@label "set-algebra: takeUntilLoop"
@description "named-membership Phase 3 — index walk for setAlgebraTakeUntil. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraTakeUntilLoop : (s: String) -> (i: Number) -> String
setAlgebraTakeUntilLoop s i =
  if gte i (length s)
  then s
  else
    let c = slice s i (add i 1)
    if or (eq c "/") (or (eq c "?") (eq c "#"))
    then slice s 0 i
    else setAlgebraTakeUntilLoop s (add i 1)

@label "set-algebra: afterLastAt"
@description "named-membership Phase 3 — the authority after stripping userinfo (the part after the last '@'). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraAfterLastAt : (a: String) -> String
setAlgebraAfterLastAt a =
  if contains a "@"
  then case last (split a "@") of
    Nothing -> a
    Just x -> x
  else a

@label "set-algebra: buildUrlParts"
@description "named-membership Phase 3 — assemble the UrlParts from scheme + host:port, returning Nothing when the host is empty or contains a space (≡ new URL() throwing). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraBuildUrlParts : (scheme: String) -> (hostport: String) -> Maybe UrlParts
setAlgebraBuildUrlParts scheme hostport =
  case setAlgebraHostPort hostport of
    HostPort { host = h, port = p } ->
      if eq h ""
      then Nothing
      else if contains h " "
      then Nothing
      else if setAlgebraInvalidPort p
      then Nothing
      else Just (UrlParts { scheme = scheme, host = lower h, port = setAlgebraNormalizePort scheme p })

-- setAlgebraInvalidPort — a non-empty non-numeric port (≡ `new URL()` throwing;
-- e.g. "http://javascript:alert(1)" has port "alert(1)").
@label "set-algebra: invalidPort"
@description "named-membership Phase 3 — is the port present but non-numeric (≡ new URL() throwing on an invalid port)? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraInvalidPort : (p: String) -> Boolean
setAlgebraInvalidPort p =
  if eq p "" then false else not (setAlgebraAllChars "digit" p)

-- setAlgebraNormalizePort — drop the port when it equals the scheme's default
-- (`new URL("https://x:443").port === ""`). Defaults: http/ws 80, https/wss 443,
-- ftp 21.
@label "set-algebra: normalizePort"
@description "named-membership Phase 3 — drop a port equal to the scheme's default (http/ws 80, https/wss 443, ftp 21), mirroring new URL()'s default-port elision. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraNormalizePort : (scheme: String) -> (p: String) -> String
setAlgebraNormalizePort scheme p =
  if eq p "" then ""
  else if setAlgebraIsDefaultPort scheme p then "" else p

@label "set-algebra: isDefaultPort"
@description "named-membership Phase 3 — is the port the scheme's default? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraIsDefaultPort : (scheme: String) -> (p: String) -> Boolean
setAlgebraIsDefaultPort scheme p =
  if and (eq scheme "https") (eq p "443") then true
  else if and (eq scheme "http") (eq p "80") then true
  else if and (eq scheme "wss") (eq p "443") then true
  else if and (eq scheme "ws") (eq p "80") then true
  else if and (eq scheme "ftp") (eq p "21") then true
  else false

@label "set-algebra: hostPort"
@description "named-membership Phase 3 — split an authority into host + port (IPv6-bracket aware). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraHostPort : (hostport: String) -> HostPort
setAlgebraHostPort hostport =
  if startsWith hostport "["
  then setAlgebraIpv6HostPort hostport
  else setAlgebraPlainHostPort hostport

@label "set-algebra: ipv6HostPort"
@description "named-membership Phase 3 — host/port split for a bracketed IPv6 authority ('[...]'(':'port)?). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraIpv6HostPort : (hp: String) -> HostPort
setAlgebraIpv6HostPort hp =
  case head (split hp "]") of
    Nothing -> HostPort { host = hp, port = "" }
    Just inside ->
      let host = concat inside "]"
      let rest = slice hp (length host) (length hp)
      let port = if startsWith rest ":" then slice rest 1 (length rest) else ""
      HostPort { host = host, port = port }

@label "set-algebra: plainHostPort"
@description "named-membership Phase 3 — host/port split for a non-bracketed authority (host(':'port)?). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraPlainHostPort : (hp: String) -> HostPort
setAlgebraPlainHostPort hp =
  if contains hp ":"
  then case head (split hp ":") of
    Nothing -> HostPort { host = hp, port = "" }
    Just h -> HostPort { host = h, port = slice hp (add (length h) 1) (length hp) }
  else HostPort { host = hp, port = "" }

-- ----------------------------------------------------------------------------
-- format:url — the two-try acceptance: a valid absolute-URL scheme (reject
-- javascript:/vbscript:), or the schemeless retry requiring the host to end in
-- a TLD dot (`/\.[a-zA-Z]{2,}$/`). Mirrors set-algebra.ts:NAMED_SETS["format:url"].
-- ----------------------------------------------------------------------------
@label "set-algebra: membership format:url"
@description "named-membership Phase 3 — format:url. Accepts a valid absolute-URL scheme (rejecting javascript:/vbscript:), or a schemeless input whose http://-prefixed host ends in a TLD dot. Mirrors the NAMED_SETS `format:url` two-try closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrl : (value: a) -> Boolean
membershipFormatUrl value =
  if isString value
  then
    if eq value ""
    then false
    else
      let scheme = setAlgebraUrlScheme value
      if not (eq scheme "")
      then not (or (eq scheme "javascript") (eq scheme "vbscript"))
      else
        case parseUrlParts value of
          Nothing -> false
          Just p -> setAlgebraHostHasTld p.host
  else false

@label "set-algebra: hostHasTld"
@description "named-membership Phase 3 — does the host end in a TLD dot (a final '.' followed by ≥2 alpha chars)? Mirrors `/\\.[a-zA-Z]{2,}$/` on the hostname. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraHostHasTld : (host: String) -> Boolean
setAlgebraHostHasTld host =
  if contains host "."
  then case last (split host ".") of
    Nothing -> false
    Just tld -> and (gte (length tld) 2) (setAlgebraAllChars "alpha" tld)
  else false

-- ----------------------------------------------------------------------------
-- URL presets — pure scheme/string-op flavours (no host parse).
-- ----------------------------------------------------------------------------

-- format:url:web — http(s) (or schemeless) URL, rejecting localhost / 127. /
-- [::1]. Mirrors NAMED_SETS["format:url:web"].
@label "set-algebra: membership format:url:web"
@description "named-membership Phase 3 — format:url:web (http(s) or schemeless, rejecting localhost / 127. / [::1] when http(s)://-rooted). Mirrors the NAMED_SETS `format:url:web` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlWeb : (value: a) -> Boolean
membershipFormatUrlWeb value =
  if isString value
  then
    let lo = lower value
    case setAlgebraHttpRest lo of
      Just rest ->
        if setAlgebraLocalhostHead rest then false
        else if startsWith rest "127." then false
        else if startsWith rest "[::1]" then false
        else true
      Nothing -> eq (setAlgebraUrlScheme value) ""
  else false

@label "set-algebra: httpRest"
@description "named-membership Phase 3 — the part after an 'http://' or 'https://' prefix (on the already-lowercased input), or Nothing. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraHttpRest : (lo: String) -> Maybe String
setAlgebraHttpRest lo =
  if startsWith lo "https://" then Just (slice lo 8 (length lo))
  else if startsWith lo "http://" then Just (slice lo 7 (length lo))
  else Nothing

@label "set-algebra: localhostHead"
@description "named-membership Phase 3 — does `rest` start with 'localhost' followed by one of [:/?#] or end? Mirrors `/^localhost([:\\/?#]|$)/`. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraLocalhostHead : (rest: String) -> Boolean
setAlgebraLocalhostHead rest =
  if startsWith rest "localhost"
  then
    if eq (length rest) 9
    then true
    else setAlgebraIsUrlDelim (slice rest 9 10)
  else false

@label "set-algebra: isUrlDelim"
@description "named-membership Phase 3 — is the char one of ':' '/' '?' '#'? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraIsUrlDelim : (c: String) -> Boolean
setAlgebraIsUrlDelim c = or (eq c ":") (or (eq c "/") (or (eq c "?") (eq c "#")))

-- format:url:nolocalhost — reject any '://localhost' / '://127.' / '://[::1]'
-- or a leading 'localhost'. Mirrors NAMED_SETS["format:url:nolocalhost"].
@label "set-algebra: membership format:url:nolocalhost"
@description "named-membership Phase 3 — format:url:nolocalhost (reject '://localhost' / '://127.' / '://[::1]' or a leading localhost). Mirrors the NAMED_SETS `format:url:nolocalhost` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlNolocalhost : (value: a) -> Boolean
membershipFormatUrlNolocalhost value =
  if isString value
  then
    let lo = lower value
    if contains lo "://localhost" then false
    else if contains lo "://127." then false
    else if contains lo "://[::1]" then false
    else if setAlgebraLocalhostHead lo then false
    else true
  else false

-- format:url:secure — scheme ∈ {https, wss, ftps}. Mirrors `/^(https|wss|ftps):\/\//i`.
@label "set-algebra: membership format:url:secure"
@description "named-membership Phase 3 — format:url:secure (scheme https / wss / ftps). Mirrors the NAMED_SETS `format:url:secure` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlSecure : (value: a) -> Boolean
membershipFormatUrlSecure value =
  if isString value
  then
    let lo = lower value
    or (startsWith lo "https://") (or (startsWith lo "wss://") (startsWith lo "ftps://"))
  else false

-- format:url:strict — has a valid scheme. Mirrors `/^[a-zA-Z][a-zA-Z0-9+.-]*:/i`.
@label "set-algebra: membership format:url:strict"
@description "named-membership Phase 3 — format:url:strict (has a valid URL scheme). Mirrors the NAMED_SETS `format:url:strict` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlStrict : (value: a) -> Boolean
membershipFormatUrlStrict value =
  if isString value
  then not (eq (setAlgebraUrlScheme value) "")
  else false

-- format:url:ws — scheme ∈ {ws, wss}. Mirrors `/^wss?:\/\//i`.
@label "set-algebra: membership format:url:ws"
@description "named-membership Phase 3 — format:url:ws (scheme ws / wss). Mirrors the NAMED_SETS `format:url:ws` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlWs : (value: a) -> Boolean
membershipFormatUrlWs value =
  if isString value
  then
    let lo = lower value
    or (startsWith lo "ws://") (startsWith lo "wss://")
  else false

-- format:url:ftp — scheme ∈ {ftp, ftps}. Mirrors `/^ftps?:\/\//i`.
@label "set-algebra: membership format:url:ftp"
@description "named-membership Phase 3 — format:url:ftp (scheme ftp / ftps). Mirrors the NAMED_SETS `format:url:ftp` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlFtp : (value: a) -> Boolean
membershipFormatUrlFtp value =
  if isString value
  then
    let lo = lower value
    or (startsWith lo "ftp://") (startsWith lo "ftps://")
  else false

-- format:url:noquery — no '?'. Mirrors `!v.includes("?")`.
@label "set-algebra: membership format:url:noquery"
@description "named-membership Phase 3 — format:url:noquery (no '?'). Mirrors the NAMED_SETS `format:url:noquery` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlNoquery : (value: a) -> Boolean
membershipFormatUrlNoquery value =
  if isString value then not (contains value "?") else false

-- format:url:nofragment — no '#'. Mirrors `!v.includes("#")`.
@label "set-algebra: membership format:url:nofragment"
@description "named-membership Phase 3 — format:url:nofragment (no '#'). Mirrors the NAMED_SETS `format:url:nofragment` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlNofragment : (value: a) -> Boolean
membershipFormatUrlNofragment value =
  if isString value then not (contains value "#") else false

-- ----------------------------------------------------------------------------
-- URL presets — host-parse flavours (via parseUrlParts).
-- ----------------------------------------------------------------------------

-- format:url:noprivate — reject loopback / link-local / RFC1918 / IMDS / IPv6
-- ULA + the .localhost/.internal/.local suffixes. Parse-throw ⇒ false. Mirrors
-- NAMED_SETS["format:url:noprivate"] (the SSRF cascade).
@label "set-algebra: membership format:url:noprivate"
@description "named-membership Phase 3 — format:url:noprivate (reject loopback / link-local / RFC1918 private ranges / cloud-metadata IMDS / IPv6 ULA + .localhost/.internal/.local). Parse failure ⇒ false. Mirrors the NAMED_SETS `format:url:noprivate` SSRF cascade."
@tags "engine" "set-algebra" "named" "membership" "url" "ssrf" "phase-3"
membershipFormatUrlNoprivate : (value: a) -> Boolean
membershipFormatUrlNoprivate value =
  if isString value
  then case parseUrlParts value of
    Nothing -> false
    Just p -> setAlgebraHostNotPrivate p.host
  else false

@label "set-algebra: hostNotPrivate"
@description "named-membership Phase 3 — the SSRF host cascade: false for localhost / *.localhost / *.internal / *.local / [::1] / ::1 / IPv6 ULA ([fc/[fd) / link-local ([fe80) / the private IPv4 ranges; true otherwise. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "ssrf" "phase-3"
@category "engine-internal"
setAlgebraHostNotPrivate : (host: String) -> Boolean
setAlgebraHostNotPrivate host =
  if eq host "localhost" then false
  else if endsWith host ".localhost" then false
  else if endsWith host ".internal" then false
  else if endsWith host ".local" then false
  else if eq host "[::1]" then false
  else if eq host "::1" then false
  else if startsWith host "[fc" then false
  else if startsWith host "[fd" then false
  else if startsWith host "[fe80" then false
  else setAlgebraIpv4NotPrivate host

@label "set-algebra: ipv4NotPrivate"
@description "named-membership Phase 3 — for a dotted-quad host, reject the private/reserved IPv4 ranges (10./127./0./169.254./172.16-31./192.168./224+); non-dotted-quad ⇒ true (the `if (m)` guard). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "ssrf" "phase-3"
@category "engine-internal"
setAlgebraIpv4NotPrivate : (host: String) -> Boolean
setAlgebraIpv4NotPrivate host =
  let parts = split host "."
  if setAlgebraIsDottedQuad parts
  then
    case head parts of
      Nothing -> true
      Just p0 ->
        case tail parts of
          Nothing -> true
          Just r1 ->
            case head r1 of
              Nothing -> true
              Just p1 -> setAlgebraOctetCheck (toNumber p0) (toNumber p1)
  else true

@label "set-algebra: octetCheck"
@description "named-membership Phase 3 — the first-two-octet private/reserved IPv4 test (true = NOT private). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "ssrf" "phase-3"
@category "engine-internal"
setAlgebraOctetCheck : (a: Number) -> (b: Number) -> Boolean
setAlgebraOctetCheck a b =
  if eq a 10 then false
  else if eq a 127 then false
  else if eq a 0 then false
  else if and (eq a 169) (eq b 254) then false
  else if and (eq a 172) (and (gte b 16) (lte b 31)) then false
  else if and (eq a 192) (eq b 168) then false
  else if gte a 224 then false
  else true

@label "set-algebra: isDottedQuad"
@description "named-membership Phase 3 — exactly four 1-3-digit parts (`\\d{1,3}` ×4). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraIsDottedQuad : (parts: List String) -> Boolean
setAlgebraIsDottedQuad parts =
  if eq (length parts) 4
  then setAlgebraAllOctetParts parts
  else false

@label "set-algebra: allOctetParts"
@description "named-membership Phase 3 — are all parts 1-3-digit octet strings? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraAllOctetParts : (parts: List String) -> Boolean
setAlgebraAllOctetParts parts = case head parts of
  Nothing -> true
  Just p ->
    if setAlgebraIsOctetStr p
    then case tail parts of
      Nothing -> true
      Just rest -> setAlgebraAllOctetParts rest
    else false

@label "set-algebra: isOctetStr"
@description "named-membership Phase 3 — a 1-3-digit string. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraIsOctetStr : (p: String) -> Boolean
setAlgebraIsOctetStr p =
  let n = length p
  if and (gte n 1) (lte n 3) then setAlgebraAllChars "digit" p else false

-- format:url:nosubdomain — the hostname is an apex domain (single label + TLD).
-- Parse-throw ⇒ true. Mirrors NAMED_SETS["format:url:nosubdomain"].
@label "set-algebra: membership format:url:nosubdomain"
@description "named-membership Phase 3 — format:url:nosubdomain (the hostname is a bare apex domain: one label + a 2+-alpha TLD). Parse failure ⇒ true. Mirrors the NAMED_SETS `format:url:nosubdomain` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlNosubdomain : (value: a) -> Boolean
membershipFormatUrlNosubdomain value =
  if isString value
  then case parseUrlParts value of
    Nothing -> true
    Just p -> setAlgebraIsApexDomain p.host
  else false

@label "set-algebra: isApexDomain"
@description "named-membership Phase 3 — `/^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\\.[a-zA-Z]{2,}$/`: a single domain label + a 2+-alpha TLD. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraIsApexDomain : (host: String) -> Boolean
setAlgebraIsApexDomain host =
  let parts = split host "."
  if eq (length parts) 2
  then
    case head parts of
      Nothing -> false
      Just label ->
        case last parts of
          Nothing -> false
          Just tld -> and (setAlgebraIsDomainLabel label) (and (gte (length tld) 2) (setAlgebraAllChars "alpha" tld))
  else false

@label "set-algebra: isDomainLabel"
@description "named-membership Phase 3 — `[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?`: alnum, hyphens allowed interior but not at the ends. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "url" "phase-3"
@category "engine-internal"
setAlgebraIsDomainLabel : (s: String) -> Boolean
setAlgebraIsDomainLabel s =
  if eq (length s) 0 then false
  else if eq (length s) 1 then setAlgebraCharInClass "alnum" (slice s 0 1)
  else if not (setAlgebraCharInClass "alnum" (slice s 0 1)) then false
  else if not (setAlgebraCharInClass "alnum" (slice s (sub (length s) 1) (length s))) then false
  else setAlgebraAllChars "alnum-hyphen" s

-- format:url:noport — the URL has no explicit port. Parse-throw ⇒ true.
-- Mirrors NAMED_SETS["format:url:noport"].
@label "set-algebra: membership format:url:noport"
@description "named-membership Phase 3 — format:url:noport (no explicit port). Parse failure ⇒ true. Mirrors the NAMED_SETS `format:url:noport` closure."
@tags "engine" "set-algebra" "named" "membership" "url" "phase-3"
membershipFormatUrlNoport : (value: a) -> Boolean
membershipFormatUrlNoport value =
  if isString value
  then case parseUrlParts value of
    Nothing -> true
    Just p -> eq p.port ""
  else false

-- ============================================================================
-- format:date / format:datetime — the DEFINED clean acceptance set (Decisions
-- #1 = (A)): ISO 8601 date, ISO datetime, or the month-name form. Both names
-- delegate to the SAME `dateAcceptable` (they were identical `new Date()` at
-- HEAD). See the section header for the byte-identity argument over the oracle.
-- ============================================================================

@label "set-algebra: membership format:date"
@description "named-membership Phase 3 — format:date / format:datetime: the defined clean acceptance set — ISO 8601 date (YYYY-MM-DD), ISO datetime (date (T|space) HH:MM(:SS)?(.fff)?(Z|±HH:MM)?), or the month-name form (Mon[th] D[D] YYYY). Replaces the host `new Date()` leniency (Decisions #1 = A; cross-engine-stable, zero new TS)."
@tags "engine" "set-algebra" "named" "membership" "date" "phase-3"
membershipFormatDate : (value: a) -> Boolean
membershipFormatDate value =
  if isString value
  then if setAlgebraIsIsoDate value then true else setAlgebraIsMonthNameDate value
  else false

-- setAlgebraIsIsoDate — ISO date (length 10) or ISO datetime (date + time suffix).
@label "set-algebra: isIsoDate"
@description "named-membership Phase 3 — ISO 8601 date (YYYY-MM-DD) or ISO datetime (date + (T|space) + time). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsIsoDate : (s: String) -> Boolean
setAlgebraIsIsoDate s =
  if setAlgebraIsIsoDatePrefix s
  then
    if eq (length s) 10 then true else setAlgebraIsIsoTimeSuffix s
  else false

@label "set-algebra: isIsoDatePrefix"
@description "named-membership Phase 3 — the YYYY-MM-DD prefix (digits / '-' at fixed positions). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsIsoDatePrefix : (s: String) -> Boolean
setAlgebraIsIsoDatePrefix s =
  if lt (length s) 10 then false
  else if not (setAlgebraDigitsBetween s 0 4) then false
  else if not (eq (slice s 4 5) "-") then false
  else if not (setAlgebraDigitsBetween s 5 7) then false
  else if not (eq (slice s 7 8) "-") then false
  else setAlgebraDigitsBetween s 8 10

@label "set-algebra: isIsoTimeSuffix"
@description "named-membership Phase 3 — the datetime time suffix after the date: position 10 is 'T' or space, then a clock time. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsIsoTimeSuffix : (s: String) -> Boolean
setAlgebraIsIsoTimeSuffix s =
  let sep = slice s 10 11
  if or (eq sep "T") (eq sep " ")
  then setAlgebraIsTimePart (slice s 11 (length s))
  else false

@label "set-algebra: isTimePart"
@description "named-membership Phase 3 — a clock time, after stripping an optional zone (Z / ±HH:MM) then optional fractional seconds: HH:MM or HH:MM:SS. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsTimePart : (t: String) -> Boolean
setAlgebraIsTimePart t =
  let t1 = setAlgebraStripZone t
  let t2 = setAlgebraStripFraction t1
  setAlgebraIsClockTime t2

@label "set-algebra: stripZone"
@description "named-membership Phase 3 — drop a trailing 'Z' or a ±HH:MM offset. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraStripZone : (t: String) -> String
setAlgebraStripZone t =
  if endsWith t "Z" then slice t 0 (sub (length t) 1)
  else if setAlgebraHasOffsetSuffix t then slice t 0 (sub (length t) 6)
  else t

@label "set-algebra: hasOffsetSuffix"
@description "named-membership Phase 3 — does `t` end in a ±HH:MM timezone offset? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraHasOffsetSuffix : (t: String) -> Boolean
setAlgebraHasOffsetSuffix t =
  let n = length t
  if lt n 6 then false
  else
    let sign = slice t (sub n 6) (sub n 5)
    if not (or (eq sign "+") (eq sign "-")) then false
    else if not (setAlgebraDigitsBetween t (sub n 5) (sub n 3)) then false
    else if not (eq (slice t (sub n 3) (sub n 2)) ":") then false
    else setAlgebraDigitsBetween t (sub n 2) n

@label "set-algebra: stripFraction"
@description "named-membership Phase 3 — drop trailing fractional seconds ('.fff'): the part before the first '.'. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraStripFraction : (t: String) -> String
setAlgebraStripFraction t = case head (split t ".") of
  Nothing -> t
  Just p -> p

@label "set-algebra: isClockTime"
@description "named-membership Phase 3 — HH:MM or HH:MM:SS. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsClockTime : (t: String) -> Boolean
setAlgebraIsClockTime t = or (setAlgebraIsHHMM t) (setAlgebraIsHHMMSS t)

@label "set-algebra: isHHMM"
@description "named-membership Phase 3 — HH:MM (5 chars). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsHHMM : (t: String) -> Boolean
setAlgebraIsHHMM t =
  if not (eq (length t) 5) then false
  else if not (setAlgebraDigitsBetween t 0 2) then false
  else if not (eq (slice t 2 3) ":") then false
  else setAlgebraDigitsBetween t 3 5

@label "set-algebra: isHHMMSS"
@description "named-membership Phase 3 — HH:MM:SS (8 chars). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsHHMMSS : (t: String) -> Boolean
setAlgebraIsHHMMSS t =
  if not (eq (length t) 8) then false
  else if not (setAlgebraDigitsBetween t 0 2) then false
  else if not (eq (slice t 2 3) ":") then false
  else if not (setAlgebraDigitsBetween t 3 5) then false
  else if not (eq (slice t 5 6) ":") then false
  else setAlgebraDigitsBetween t 6 8

-- setAlgebraIsMonthNameDate — "Mon[th] D[D] YYYY" (e.g. "Jan 1 2020"); a 3-part
-- space split with a month name, a 1-2-digit day (optional trailing comma), and
-- a 4-digit year.
@label "set-algebra: isMonthNameDate"
@description "named-membership Phase 3 — the month-name date form: 'Mon[th] D[D] YYYY' (e.g. 'Jan 1 2020'). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsMonthNameDate : (s: String) -> Boolean
setAlgebraIsMonthNameDate s =
  let parts = split s " "
  if eq (length parts) 3
  then setAlgebraMonthDayYear parts
  else false

@label "set-algebra: monthDayYear"
@description "named-membership Phase 3 — validate the [month, day, year] 3-part split. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraMonthDayYear : (parts: List String) -> Boolean
setAlgebraMonthDayYear parts =
  case head parts of
    Nothing -> false
    Just mon ->
      case tail parts of
        Nothing -> false
        Just rest ->
          case head rest of
            Nothing -> false
            Just day ->
              case tail rest of
                Nothing -> false
                Just rest2 ->
                  case head rest2 of
                    Nothing -> false
                    Just yr ->
                      if not (setAlgebraIsMonthName mon) then false
                      else if not (setAlgebraIsDayNum (setAlgebraStripComma day)) then false
                      else setAlgebraIsYear yr

@label "set-algebra: isMonthName"
@description "named-membership Phase 3 — is the (lowercased) token an English month name (3-letter or full)? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsMonthName : (mon: String) -> Boolean
setAlgebraIsMonthName mon =
  setAlgebraListContains (split "jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec|january|february|march|april|june|july|august|september|october|november|december" "|") (lower mon)

@label "set-algebra: stripComma"
@description "named-membership Phase 3 — drop a single trailing comma. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraStripComma : (day: String) -> String
setAlgebraStripComma day =
  if endsWith day "," then slice day 0 (sub (length day) 1) else day

@label "set-algebra: isDayNum"
@description "named-membership Phase 3 — a 1-2-digit day number. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsDayNum : (day: String) -> Boolean
setAlgebraIsDayNum day =
  let n = length day
  if or (eq n 1) (eq n 2) then setAlgebraAllChars "digit" day else false

@label "set-algebra: isYear"
@description "named-membership Phase 3 — a 4-digit year. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "date" "phase-3"
@category "engine-internal"
setAlgebraIsYear : (yr: String) -> Boolean
setAlgebraIsYear yr = and (eq (length yr) 4) (setAlgebraAllChars "digit" yr)

-- ============================================================================
-- named-membership Phase 3c — the 6 regex-resistant format predicates.
--
-- These were KEPT in TS NAMED_SETS by Phases 1/2 (flagged "not Pattern-
-- expressible" / "regex-structural, deferred"). They are pure string-op
-- predicates over the raw value, so — like the Phase-3 url/date bodies — the
-- codepoint-marshal blocker does NOT apply; they port cleanly with the Phase-1/3
-- helper toolkit. Each mirrors the exact (often LOOSE) acceptance of the kept
-- regex, verified byte-identical against the original TS over an adversarial
-- differential sample (scripts/phase3c-probe.ts, Step-0).
--
-- DIVERGENCE LEDGER (deliberate, documented — the Phase-1/3 discipline):
--   • (D-phone-ws / D-postal-ws) JS `\s` whitespace CLASS stripping is
--     reproduced for the REALISTIC members only — ASCII space + tab(9) + LF(10)
--     + CR(13) + FF(12) + VT(11). The exotic `\s` members (nbsp U+00A0, the
--     U+2000-200A range, U+2028/2029, U+202F/205F/3000, ZWNBSP U+FEFF) are NOT
--     stripped here. No realistic phone/postal corpus exercises them; flagged,
--     not chased. Recommended in the brief (D-phone-ws = strip realistic).
--   • (D-ipv6) The kept IPv6 `::` regex is genuinely LOOSE/buggy: its
--     `([0-9a-f]{1,4}:)*::` prefix consumes one of the two `::` colons inside a
--     trailing group token, so it ACCEPTS only forms whose `::` is preceded by
--     nothing (string starts with `::`, e.g. `::1`, `::a`, `::1:2`) or by a bare
--     `:` (pathological triple-colon, e.g. `a:::b`) — and REJECTS the canonical
--     abbreviations `fe80::1`, `2001:db8::1`, `FE80::1`, `a:b::c`, `::`, `a::`,
--     `::ffff:1.2.3.4`. The Fenel body reproduces this EXACT acceptance (no
--     tightening) via an existence search over split points `A "::" B` with
--     `A` matching `(hex:)*` and `B` matching `(hex:)*hex`. Verified identical
--     to the regex on the full Step-0 adversarial sample.
-- ============================================================================

-- ----------------------------------------------------------------------------
-- format:phone — strip `[\s\-().]`, then `^\+?[0-9]\d{6,14}$` (optional `+`,
-- then 7-15 digits). Mirrors NAMED_SETS["format:phone"].
-- ----------------------------------------------------------------------------
@label "set-algebra: membership format:phone"
@description "named-membership Phase 3c — format:phone: strip `[\\s\\-().]` (realistic `\\s` members), then `^\\+?[0-9]\\d{6,14}$` (optional leading '+', then 7-15 digits). Mirrors the NAMED_SETS `format:phone` closure. Exotic-`\\s` divergence documented."
@tags "engine" "set-algebra" "named" "membership" "phone" "phase-3c"
membershipFormatPhone : (value: a) -> Boolean
membershipFormatPhone value =
  if isString value
  then setAlgebraPhoneShape (setAlgebraStripPhone value)
  else false

-- Strip the `[\s\-().]` class: ASCII space + tab/LF/CR/FF/VT + `- . ( )`.
@label "set-algebra: stripPhone"
@description "named-membership Phase 3c — strip the `[\\s\\-().]` chars (realistic `\\s` members: space, tab, LF, CR, FF, VT) plus `- . ( )`. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "phone" "phase-3c"
@category "engine-internal"
setAlgebraStripPhone : (s: String) -> String
setAlgebraStripPhone s =
  let s1 = replaceAll s " " ""
  let s2 = replaceAll s1 (charFromCode 9) ""
  let s3 = replaceAll s2 (charFromCode 10) ""
  let s4 = replaceAll s3 (charFromCode 13) ""
  let s5 = replaceAll s4 (charFromCode 12) ""
  let s6 = replaceAll s5 (charFromCode 11) ""
  let s7 = replaceAll s6 "-" ""
  let s8 = replaceAll s7 "." ""
  let s9 = replaceAll s8 "(" ""
  replaceAll s9 ")" ""

-- `^\+?[0-9]\d{6,14}$`: optional leading '+', then a digit, then 6-14 more
-- digits ⇒ 7-15 digits total, all digits.
@label "set-algebra: phoneShape"
@description "named-membership Phase 3c — `^\\+?[0-9]\\d{6,14}$` shape over the stripped string (optional '+', then 7-15 digits). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "phone" "phase-3c"
@category "engine-internal"
setAlgebraPhoneShape : (s: String) -> Boolean
setAlgebraPhoneShape s =
  let core = if startsWith s "+" then slice s 1 (length s) else s
  let n = length core
  if and (gte n 7) (lte n 15) then setAlgebraAllChars "digit" core else false

-- ----------------------------------------------------------------------------
-- format:ip — IPv4 dotted-quad (every octet 0..255), else IPv6 full (8 hex
-- groups) or the LOOSE `::` shorthand (see D-ipv6 above). Mirrors
-- NAMED_SETS["format:ip"].
-- ----------------------------------------------------------------------------
@label "set-algebra: membership format:ip"
@description "named-membership Phase 3c — format:ip: IPv4 dotted-quad with each octet 0..255, else IPv6 full (8 hex groups) or the loose `::` shorthand. Mirrors the NAMED_SETS `format:ip` closure (the buggy `::` regex reproduced exactly — D-ipv6)."
@tags "engine" "set-algebra" "named" "membership" "ip" "phase-3c"
membershipFormatIp : (value: a) -> Boolean
membershipFormatIp value =
  if isString value
  then
    let parts = split value "."
    if setAlgebraIsDottedQuad parts
    then setAlgebraOctetsAllLe255 parts
    else setAlgebraIsIpv6 (lower value)
  else false

-- Every dotted-quad octet is 0..255 (parts are already 1-3 digits by
-- isDottedQuad; `>= 0` is vacuous, only `<= 255` can fail — e.g. "256").
@label "set-algebra: octetsAllLe255"
@description "named-membership Phase 3c — are all dotted-quad parts numerically <= 255? Mirrors `v.split('.').every(n => parseInt(n) <= 255)`. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraOctetsAllLe255 : (parts: List String) -> Boolean
setAlgebraOctetsAllLe255 parts = case head parts of
  Nothing -> true
  Just p ->
    if lte (toNumber p) 255
    then case tail parts of
      Nothing -> true
      Just rest -> setAlgebraOctetsAllLe255 rest
    else false

-- IPv6: full 8-group form, else the loose `::` shorthand.
@label "set-algebra: isIpv6"
@description "named-membership Phase 3c — the lowercased-host IPv6 test: full 8-group form OR the loose `::` shorthand. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraIsIpv6 : (s: String) -> Boolean
setAlgebraIsIpv6 s =
  if setAlgebraIsIpv6Full s then true else setAlgebraIsIpv6Short s

-- `^([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$`: exactly 8 colon-separated groups, each
-- 1-4 hex. Any `::` yields an empty group ⇒ fails the hex-group check.
@label "set-algebra: isIpv6Full"
@description "named-membership Phase 3c — `^([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$`: exactly 8 colon-separated 1-4-hex groups. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraIsIpv6Full : (s: String) -> Boolean
setAlgebraIsIpv6Full s =
  let groups = split s ":"
  if eq (length groups) 8 then setAlgebraAllHexGroups groups else false

-- The loose `::` shorthand. Exists a split `s = A "::" B` with A matching
-- `(hex:)*` and B matching `(hex:)*hex` (see D-ipv6). Search every `::`.
@label "set-algebra: isIpv6Short"
@description "named-membership Phase 3c — the loose IPv6 `::` shorthand: does some split `A '::' B` exist with A matching `(hex:)*` and B matching `(hex:)*hex`? Reproduces the buggy regex exactly. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraIsIpv6Short : (s: String) -> Boolean
setAlgebraIsIpv6Short s = setAlgebraIpv6SearchDC s 0

@label "set-algebra: ipv6SearchDC"
@description "named-membership Phase 3c — scan for a valid `::` split point in the IPv6 shorthand. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraIpv6SearchDC : (s: String) -> (i: Number) -> Boolean
setAlgebraIpv6SearchDC s i =
  if gt (add i 2) (length s) then false
  else if not (eq (slice s i (add i 2)) "::") then setAlgebraIpv6SearchDC s (add i 1)
  else if not (setAlgebraIpv6PrefixOk (slice s 0 i)) then setAlgebraIpv6SearchDC s (add i 1)
  else if not (setAlgebraIpv6SuffixOk (slice s (add i 2) (length s))) then setAlgebraIpv6SearchDC s (add i 1)
  else true

-- A matches `(hex:)*`: empty, or ends with ':' and every token (all but the
-- trailing "" from the final colon) is a 1-4 hex group.
@label "set-algebra: ipv6PrefixOk"
@description "named-membership Phase 3c — does the part before `::` match `([0-9a-f]{1,4}:)*`? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraIpv6PrefixOk : (a: String) -> Boolean
setAlgebraIpv6PrefixOk a =
  if eq a "" then true
  else if not (endsWith a ":") then false
  else setAlgebraAllButLastHex (split a ":")

-- B matches `(hex:)*[0-9a-f]{1,4}`: non-empty, every colon-separated group is a
-- 1-4 hex group (an empty group from a trailing/double colon fails).
@label "set-algebra: ipv6SuffixOk"
@description "named-membership Phase 3c — does the part after `::` match `([0-9a-f]{1,4}:)*[0-9a-f]{1,4}`? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraIpv6SuffixOk : (b: String) -> Boolean
setAlgebraIpv6SuffixOk b =
  if eq b "" then false
  else setAlgebraAllHexGroups (split b ":")

@label "set-algebra: allHexGroups"
@description "named-membership Phase 3c — is every list element a 1-4 hex group? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraAllHexGroups : (xs: List String) -> Boolean
setAlgebraAllHexGroups xs = case head xs of
  Nothing -> true
  Just first ->
    if setAlgebraIsHexGroup first
    then case tail xs of
      Nothing -> true
      Just rest -> setAlgebraAllHexGroups rest
    else false

@label "set-algebra: allButLastHex"
@description "named-membership Phase 3c — is every element except the last a 1-4 hex group? (The `(hex:)*` token check, skipping the trailing '' from the final colon.) Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraAllButLastHex : (xs: List String) -> Boolean
setAlgebraAllButLastHex xs = case head xs of
  Nothing -> true
  Just first ->
    case tail xs of
      Nothing -> true
      Just rest ->
        if setAlgebraIsHexGroup first
        then setAlgebraAllButLastHex rest
        else false

@label "set-algebra: isHexGroup"
@description "named-membership Phase 3c — a 1-4-char all-hex group. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "ip" "phase-3c"
@category "engine-internal"
setAlgebraIsHexGroup : (g: String) -> Boolean
setAlgebraIsHexGroup g =
  let n = length g
  if and (gte n 1) (lte n 4) then setAlgebraAllChars "hex" g else false

-- ----------------------------------------------------------------------------
-- format:postal-code — `/^[A-Z0-9]{2,5}[\s-]?[A-Z0-9]{2,5}$/i`: 2-5 alnum, an
-- optional single `[\s-]` separator, 2-5 alnum. Mirrors
-- NAMED_SETS["format:postal-code"].
-- ----------------------------------------------------------------------------
@label "set-algebra: membership format:postal-code"
@description "named-membership Phase 3c — format:postal-code: `^[A-Z0-9]{2,5}[\\s-]?[A-Z0-9]{2,5}$` case-insensitively (2-5 alnum, optional single `[\\s-]` separator, 2-5 alnum). Mirrors the NAMED_SETS `format:postal-code` closure. Exotic-`\\s` divergence documented."
@tags "engine" "set-algebra" "named" "membership" "postal" "phase-3c"
membershipFormatPostalCode : (value: a) -> Boolean
membershipFormatPostalCode value =
  if isString value then setAlgebraPostalShape value else false

-- No separator ⇒ the whole string is `[A-Za-z0-9]{4,10}`. Else exactly one
-- `[\s-]` separator splits into a 2-5 alnum left and a 2-5 alnum right.
@label "set-algebra: postalShape"
@description "named-membership Phase 3c — the postal-code shape over the original ASCII upper/lower input, without Unicode case folding. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "postal" "phase-3c"
@category "engine-internal"
setAlgebraPostalShape : (s: String) -> Boolean
setAlgebraPostalShape s =
  if setAlgebraAllChars "alnum" s
  then and (gte (length s) 4) (lte (length s) 10)
  else setAlgebraPostalWithSep s

@label "set-algebra: postalWithSep"
@description "named-membership Phase 3c — postal-code with a single `[\\s-]` separator: 2-5 alnum left, separator, 2-5 alnum right (no further non-alnum). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "postal" "phase-3c"
@category "engine-internal"
setAlgebraPostalWithSep : (s: String) -> Boolean
setAlgebraPostalWithSep s =
  let i = setAlgebraFirstNonAlnum s 0
  let c = slice s i (add i 1)
  if not (setAlgebraIsPostalSep c) then false
  else
    let left = slice s 0 i
    let right = slice s (add i 1) (length s)
    if not (setAlgebraAllChars "alnum" right) then false
    else if not (and (gte (length left) 2) (lte (length left) 5)) then false
    else and (gte (length right) 2) (lte (length right) 5)

@label "set-algebra: firstNonAlnum"
@description "named-membership Phase 3c — index of the first non-`[A-Za-z0-9]` char (or length if none). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "postal" "phase-3c"
@category "engine-internal"
setAlgebraFirstNonAlnum : (s: String) -> (i: Number) -> Number
setAlgebraFirstNonAlnum s i =
  if gte i (length s) then i
  else if setAlgebraCharInClass "alnum" (slice s i (add i 1)) then setAlgebraFirstNonAlnum s (add i 1)
  else i

-- `[\s-]`: a single ASCII space / tab / LF / CR / FF / VT (realistic `\s`) or
-- a hyphen. (See the D-postal-ws divergence note.)
@label "set-algebra: isPostalSep"
@description "named-membership Phase 3c — a `[\\s-]` separator char (realistic `\\s` members + hyphen). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "postal" "phase-3c"
@category "engine-internal"
setAlgebraIsPostalSep : (c: String) -> Boolean
setAlgebraIsPostalSep c =
  if eq c " " then true
  else if eq c "-" then true
  else if eq c (charFromCode 9) then true
  else if eq c (charFromCode 10) then true
  else if eq c (charFromCode 13) then true
  else if eq c (charFromCode 12) then true
  else eq c (charFromCode 11)

-- ----------------------------------------------------------------------------
-- format:path:windows — drive / UNC / forbidden-char structure. Mirrors
-- NAMED_SETS["format:path:windows"].
-- ----------------------------------------------------------------------------
@label "set-algebra: membership format:path:windows"
@description "named-membership Phase 3c — format:path:windows: bare drive 'C:' ⇒ true; 'C:\\'/'C:/' ⇒ body is the tail; 'C:foo' (CWD-relative) ⇒ false; '\\\\server\\share[\\rest]' UNC ⇒ body is rest; else body is the whole value; body must contain none of `<>:\"|?*`. Mirrors the NAMED_SETS `format:path:windows` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "windows" "phase-3c"
membershipFormatPathWindows : (value: a) -> Boolean
membershipFormatPathWindows value =
  if not (setAlgebraIsNonEmptyNoNull value) then false
  else if and (setAlgebraHasDrivePrefix value) (eq (length value) 2) then true
  else if setAlgebraHasDriveSlash value then setAlgebraWinBodyOk (slice value 3 (length value))
  else if setAlgebraHasDrivePrefix value then false
  else if startsWith value "\\\\" then setAlgebraWinUnc value
  else setAlgebraWinBodyOk value

-- The body must contain none of the Windows-forbidden chars `<>:"|?*`.
@label "set-algebra: winBodyOk"
@description "named-membership Phase 3c — the path body contains none of `<>:\"|?*`. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "windows" "phase-3c"
@category "engine-internal"
setAlgebraWinBodyOk : (body: String) -> Boolean
setAlgebraWinBodyOk body = not (setAlgebraHasWinForbidden body 0)

@label "set-algebra: hasWinForbidden"
@description "named-membership Phase 3c — does the string contain any `<>:\"|?*` char? Index walk. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "windows" "phase-3c"
@category "engine-internal"
setAlgebraHasWinForbidden : (s: String) -> (i: Number) -> Boolean
setAlgebraHasWinForbidden s i =
  if gte i (length s) then false
  else if setAlgebraIsWinForbidden (slice s i (add i 1)) then true
  else setAlgebraHasWinForbidden s (add i 1)

@label "set-algebra: isWinForbidden"
@description "named-membership Phase 3c — is the char one of `<>:\"|?*`? (`\"` is charFromCode 34.) Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "windows" "phase-3c"
@category "engine-internal"
setAlgebraIsWinForbidden : (c: String) -> Boolean
setAlgebraIsWinForbidden c =
  if eq c "<" then true
  else if eq c ">" then true
  else if eq c ":" then true
  else if eq c "|" then true
  else if eq c "?" then true
  else if eq c "*" then true
  else eq c (charFromCode 34)

-- The UNC arm: after '\\', parse `server\share`, then an optional `[\/]rest`.
-- server/share are 1+ chars none of `\/?*:|"<>`; the server→share delimiter is
-- a backslash specifically (the regex's `\\`, NOT `[\\/]`). body = rest (or "").
@label "set-algebra: winUnc"
@description "named-membership Phase 3c — the UNC `\\\\server\\share[\\rest]` parse: 1+-char server (none of `\\/?*:|\"<>`), a backslash delimiter, 1+-char share, then optional `[\\/]` + rest. Returns the final body forbidden-char check. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "windows" "phase-3c"
@category "engine-internal"
setAlgebraWinUnc : (value: String) -> Boolean
setAlgebraWinUnc value =
  let rem = slice value 2 (length value)
  let sEnd = setAlgebraFirstUncForbidden rem 0
  if eq sEnd 0 then false
  else if not (eq (slice rem sEnd (add sEnd 1)) "\\") then false
  else
    let shareStart = add sEnd 1
    let shEnd = setAlgebraFirstUncForbidden rem shareStart
    if eq shEnd shareStart then false
    else if eq shEnd (length rem) then setAlgebraWinBodyOk ""
    else
      let sepc = slice rem shEnd (add shEnd 1)
      if setAlgebraIsUncSep sepc
      then setAlgebraWinBodyOk (slice rem (add shEnd 1) (length rem))
      else false

@label "set-algebra: firstUncForbidden"
@description "named-membership Phase 3c — index of the first char in `\\/?*:|\"<>` (or length if none). Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "windows" "phase-3c"
@category "engine-internal"
setAlgebraFirstUncForbidden : (s: String) -> (i: Number) -> Number
setAlgebraFirstUncForbidden s i =
  if gte i (length s) then length s
  else if setAlgebraIsUncForbidden (slice s i (add i 1)) then i
  else setAlgebraFirstUncForbidden s (add i 1)

-- The UNC server/share charclass excludes `\/?*:|"<>` = the 7 Windows-forbidden
-- chars PLUS the two separators `\` and `/`.
@label "set-algebra: isUncForbidden"
@description "named-membership Phase 3c — is the char one of `\\/?*:|\"<>` (the 7 Windows-forbidden chars + the two separators)? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "windows" "phase-3c"
@category "engine-internal"
setAlgebraIsUncForbidden : (c: String) -> Boolean
setAlgebraIsUncForbidden c =
  if setAlgebraIsWinForbidden c then true else setAlgebraIsUncSep c

@label "set-algebra: isUncSep"
@description "named-membership Phase 3c — is the char a path separator `\\` or `/` (the regex `[\\/]`)? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "windows" "phase-3c"
@category "engine-internal"
setAlgebraIsUncSep : (c: String) -> Boolean
setAlgebraIsUncSep c = or (eq c "\\") (eq c "/")

-- ----------------------------------------------------------------------------
-- format:path:portable — non-empty, no NUL, no `\`, no `<>:"|?*`, no trailing
-- space/dot, every char in `[A-Za-z0-9._\-/ ]`. Mirrors
-- NAMED_SETS["format:path:portable"].
-- ----------------------------------------------------------------------------
@label "set-algebra: membership format:path:portable"
@description "named-membership Phase 3c — format:path:portable: non-empty, no NUL byte, no backslash, none of `<>:\"|?*`, no trailing space or dot, every char in `[A-Za-z0-9._-/ ]`. Mirrors the NAMED_SETS `format:path:portable` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "portable" "phase-3c"
membershipFormatPathPortable : (value: a) -> Boolean
membershipFormatPathPortable value =
  if not (setAlgebraIsNonEmptyNoNull value) then false
  else if contains value "\\" then false
  else if setAlgebraHasWinForbidden value 0 then false
  else if endsWith value " " then false
  else if endsWith value "." then false
  else setAlgebraAllChars "path-portable" value

-- ----------------------------------------------------------------------------
-- format:path:no-reserved — no path segment is a Windows reserved device name
-- (CON/PRN/AUX/NUL/COM[1-9]/LPT[1-9], optionally with a `.ext`). Mirrors
-- NAMED_SETS["format:path:no-reserved"].
-- ----------------------------------------------------------------------------
@label "set-algebra: membership format:path:no-reserved"
@description "named-membership Phase 3c — format:path:no-reserved: no segment (split on both separators) is a Windows reserved device name CON/PRN/AUX/NUL/COM[1-9]/LPT[1-9], optionally followed by `.ext`, case-insensitively. Mirrors the NAMED_SETS `format:path:no-reserved` closure."
@tags "engine" "set-algebra" "named" "membership" "path" "no-reserved" "phase-3c"
membershipFormatPathNoReserved : (value: a) -> Boolean
membershipFormatPathNoReserved value =
  if isString value
  then not (setAlgebraAnyReservedSeg (setAlgebraPathSegments value))
  else false

@label "set-algebra: anyReservedSeg"
@description "named-membership Phase 3c — is any path segment a Windows reserved device name? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "no-reserved" "phase-3c"
@category "engine-internal"
setAlgebraAnyReservedSeg : (segs: List String) -> Boolean
setAlgebraAnyReservedSeg segs = case head segs of
  Nothing -> false
  Just seg ->
    if setAlgebraIsReservedSeg seg then true
    else case tail segs of
      Nothing -> false
      Just rest -> setAlgebraAnyReservedSeg rest

-- A segment is reserved iff its part before the first '.' (lowercased) is a
-- reserved base name. The regex's `(\.[^\\/]*)?` extension accepts anything
-- (a segment has no separators), so the base name alone decides.
@label "set-algebra: isReservedSeg"
@description "named-membership Phase 3c — is a single segment a reserved device name (optionally with `.ext`)? Decided by the part before the first '.'. Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "no-reserved" "phase-3c"
@category "engine-internal"
setAlgebraIsReservedSeg : (seg: String) -> Boolean
setAlgebraIsReservedSeg seg =
  let b = case head (split (lower seg) ".") of
    Nothing -> ""
    Just h -> h
  setAlgebraIsReservedBase b

@label "set-algebra: isReservedBase"
@description "named-membership Phase 3c — is the (lowercased) base name one of con/prn/aux/nul/com[1-9]/lpt[1-9]? Helper; tagged engine-internal."
@tags "engine" "internal" "set-algebra" "named" "path" "no-reserved" "phase-3c"
@category "engine-internal"
setAlgebraIsReservedBase : (b: String) -> Boolean
setAlgebraIsReservedBase b =
  if setAlgebraListContains (split "con|prn|aux|nul" "|") b then true
  else if and (eq (length b) 4) (or (startsWith b "com") (startsWith b "lpt"))
  then contains "123456789" (slice b 3 4)
  else false
