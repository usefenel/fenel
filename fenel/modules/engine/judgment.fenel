module engine where

-- =========================================================================
-- The one lattice judgment — the kernel's re-check currency.
-- decide-substrate Phase 2 (brief:
-- `workstreams/decide-substrate/briefs/phase-2-one-judgment-kernel.md`, K1).
--
-- THE CUT. The closed 6-case `Proposition` sum is not primitive: every
-- decidable-set case is a PRESENTATION of ONE judgment — emptiness/⊆ over a
-- SetExpr, in two polarities. This file carries that judgment as a
-- first-class value + the total decomposition iso + the single core rule
-- (`verifyJudgment`) the kernel now re-checks. `kernel.fenel`'s
-- `verifyProof` becomes the presentation dispatcher over these.
--
-- THE DECOMPOSITION ISO (Step-0 §2, total over all 6 closed cases):
--   PropSubset s t   ⟺ empty(s ∩ ¬t)  →  JEmpty (s ∩ ¬t)
--   PropDisjoint s t ⟺ empty(s ∩ t)   →  JEmpty (s ∩ t)
--   PropEmpty s      ⟺ empty(s)        →  JEmpty s
--   PropInhabited s  ⟺ ¬empty(s)       →  JInhabited s          (the inverted arm)
--   PropEq x y       ⟺ {x}⊆{y} ∧ {y}⊆{x}  → the Refl presentation (constraint
--                       §1.1: shallow enum-eq blocks the trio fold ⇒ Refl stays
--                       a singleton-equality presentation rule in kernel.fenel)
--   PropForall x∈S.P ⟺ S ⊆ ⟦P⟧          → the SampleTestResult presentation
--                       (constraint §1.4: ⟦P⟧ is never materialised on the law
--                       path — the property is evaluated per sample host-side;
--                       stays a shape+totality presentation rule in kernel.fenel)
--
-- TRI-PRECISION DISPATCH (design/deciding.md §3; brief §0). Although the iso
-- reads PropSubset as `empty(s ∩ ¬t)`, the kernel does NOT re-decide the
-- composed set via the naive `decideEmpty ∘ ∩ ∘ ¬` — that loses precision (the
-- specialised trio decides MORE cases). The re-decide is PRE-COMPUTED by the TS
-- delegate keyed on the CLAIM's shape (`isSubset` / `isDisjoint` / `decideEmpty`)
-- and threaded in as the `decision` tri-state string; `verifyJudgment` consumes
-- it, gated by the judgment's POLARITY (JEmpty accepts "true"; JInhabited accepts
-- "false"). So the judgment's carried set is the SEMANTIC MEANING (presentation +
-- the witness anti-repurpose framing); the decision keeps the specialised
-- precision. The composed set is built but never itself decided on the ReDecide
-- path (only the singleton face's `verifyWitnessMembership` decides in-Fenel).
--
-- OUTCOME MARKERS: the same plain-record markers kernel.fenel emits (the P5/6a
-- `$`-key barrier — a `.fenel` body cannot author `{$tag: …}` shapes; the TS
-- delegate maps marker → VerifyResult + grades EpistemicStatus). Byte-identical
-- shapes to the retired `vpDecideTwo`/`vpDecideOne`/`vpDecideInhabited` cluster.
-- =========================================================================

-- Judgment — the one lattice claim, 2-polarity over a SetExpr. JEmpty is the
-- "this set is empty" claim (subset / disjoint / empty all present as it);
-- JInhabited is its dual (the inverted arm — PropInhabited, and the target of
-- the new witness-membership rule). The sum does NOT re-grow: polarity is the
-- ONLY axis (∀ rides the SampleTestResult presentation, NOT a third case;
-- PropEq rides the Refl presentation).
Judgment = JEmpty s: Any | JInhabited s: Any

-- judgmentOfProposition — the Proposition → Judgment half of the iso. Reads the
-- claim shape's `$tag` (threaded as `propTag`) + the SetExpr payloads and emits
-- the polarised lattice claim. Only the four decidable-set shapes decompose here
-- (subset / disjoint / empty / inhabited); PropEq / PropForall never reach this
-- arm (they route to their presentation rules in kernel.fenel) — the final else
-- is a total-function backstop (JEmpty over the proposition's `s`), never hit on
-- the live path.
@label "Judgment of proposition"
@description "The Proposition → Judgment half of the decomposition iso (decide-substrate Phase 2). PropSubset s t → JEmpty (s ∩ ¬t); PropDisjoint s t → JEmpty (s ∩ t); PropEmpty s → JEmpty s; PropInhabited s → JInhabited s. The composed set is the SEMANTIC meaning of the claim — the actual re-decide is pre-computed by the delegate keyed on the claim shape (tri-precision dispatch), so this set is presentation, not the thing decided on the ReDecide path. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
judgmentOfProposition : (propTag: String) -> (prop: a) -> Judgment
judgmentOfProposition propTag prop =
  if eq propTag "PropSubset" then jopSubset prop
  else if eq propTag "PropDisjoint" then jopDisjoint prop
  else if eq propTag "PropEmpty" then JEmpty prop.s
  else if eq propTag "PropInhabited" then JInhabited prop.s
  else JEmpty prop.s

-- jopSubset — PropSubset s t → JEmpty (s ∩ ¬t). Split out (a single-expression
-- `then` in the else-if chain) so the chain stays off the broken-else-if fence
-- (a `then`-block mixed with single-expr branches diverges the Fenel parser).
@label "judgment of proposition: subset"
@description "decide-substrate Phase 2 — the PropSubset arm of the iso: JEmpty (s ∩ ¬t), the composed set built via SeComplement + SeIntersect. Presentation only (the re-decide is pre-computed by isSubset). Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
jopSubset : (prop: a) -> Judgment
jopSubset prop =
  let notT = SeComplement { inner = prop.t }
  let subsetBranches = appendItem prop.s (appendItem notT [])
  let subsetSet = SeIntersect { branches = subsetBranches }
  JEmpty subsetSet

-- jopDisjoint — PropDisjoint s t → JEmpty (s ∩ t). Split out for the same
-- fence-avoidance reason as jopSubset.
@label "judgment of proposition: disjoint"
@description "decide-substrate Phase 2 — the PropDisjoint arm of the iso: JEmpty (s ∩ t), the composed set built via SeIntersect. Presentation only (the re-decide is pre-computed by isDisjoint). Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
jopDisjoint : (prop: a) -> Judgment
jopDisjoint prop =
  let disjointBranches = appendItem prop.s (appendItem prop.t [])
  let disjointSet = SeIntersect { branches = disjointBranches }
  JEmpty disjointSet

-- =========================================================================
-- The builder faces (decide-substrate Phase 2 K4 — "constructors are calls").
-- The closed `Proposition` sum is RETIRED (prover/types.fenel); its 4
-- decidable-shape constructors survive as positional BUILDER FNS emitting the
-- one lattice judgment. `propEq` / `propForall` (the Refl / Sample
-- presentations) stay TS marker builders (`prover.ts` — a `.fenel` body cannot
-- author the `$tag` shapes those presentation rules read).
-- =========================================================================

@label "Prop: subset"
@description "The subset claim builder (decide-substrate Phase 2 K4 — the retired PropSubset constructor's vocabulary as a call): `propSubset s t` ⇒ the subset judgment `JEmpty (SeIntersect [SeComplement t, s])` via jopSubset — s ⊆ t ≡ s ∩ ¬t empty. The proposer + kernel shape-recognize it (recheckPlan) back to isSubset(s, t)."
@tags "engine" "prover" "judgment" "builder" "decide-substrate" "phase-2"
propSubset : (s: a) -> (t: a) -> Judgment
propSubset s t =
  jopSubset { s = s, t = t }

@label "Prop: disjoint"
@description "The disjointness claim builder (decide-substrate Phase 2 K4 — the retired PropDisjoint constructor's vocabulary as a call): `propDisjoint s t` ⇒ the disjoint judgment `JEmpty (SeIntersect [t, s])` via jopDisjoint — s ∩ t empty. The proposer + kernel shape-recognize it (recheckPlan) back to isDisjoint(s, t)."
@tags "engine" "prover" "judgment" "builder" "decide-substrate" "phase-2"
propDisjoint : (s: a) -> (t: a) -> Judgment
propDisjoint s t =
  jopDisjoint { s = s, t = t }

@label "Prop: empty"
@description "The emptiness claim builder (decide-substrate Phase 2 K4 — the retired PropEmpty constructor's vocabulary as a call): `propEmpty s` ⇒ the bare emptiness judgment `JEmpty s`. The proposer + kernel re-decide it via decideEmpty(s)."
@tags "engine" "prover" "judgment" "builder" "decide-substrate" "phase-2"
propEmpty : (s: a) -> Judgment
propEmpty s =
  JEmpty s

@label "Prop: inhabited"
@description "The inhabitation claim builder (decide-substrate Phase 2 K4 — the retired PropInhabited constructor's vocabulary as a call): `propInhabited s` ⇒ the inhabited judgment `JInhabited s`. The proposer + kernel re-decide it via the INVERTED decideEmpty(s) (accept on Just false), or a witness proof re-checks {w} ⊆ s (verifyWitnessMembership)."
@tags "engine" "prover" "judgment" "builder" "decide-substrate" "phase-2"
propInhabited : (s: a) -> Judgment
propInhabited s =
  JInhabited s

-- =========================================================================
-- recheckPlan — the tri-precision dispatch's SHAPE half (decide-substrate
-- Phase 2, K3). ONE recognizer, shared by the proposer (prover-logic.fenel)
-- and the kernel (kernel.fenel + the TS delegates' decide calls): given a
-- claim — a closed-sum Proposition (compat until K4) OR a Judgment — return
-- the re-check PLAN `{ kind, s, t? }`:
--   kind "subset"   ⇒ decide isSubset(s, t)     (two-sided witness)
--   kind "disjoint" ⇒ decide isDisjoint(s, t)   (two-sided witness)
--   kind "empty"    ⇒ decide decideEmpty(s)     (one-sided)
--   kind "nonempty" ⇒ decide decideEmpty(s) INVERTED (one-sided)
--   kind "other"    ⇒ not a decidable-set claim (PropEq / PropForall / garbage)
--
-- For Prop* claims the plan is read straight off the tag + fields (byte-
-- identical to the retired TS tag-ladders in kernel.ts/prover-ffi.ts). For
-- JUDGMENT claims the plan comes from SHAPE RECOGNITION over the composed set
-- (the brief §2 seam mechanics — tri-precision survives via shape, not tags):
--   JEmpty (SeIntersect [¬t, s]) ⇒ subset(s, t)   — exactly-one-complement
--   JEmpty (SeIntersect [t, s])  ⇒ disjoint(s, t) — two branches, no complement
--   JEmpty s                     ⇒ empty(s)       — any other set shape
--   JInhabited s                 ⇒ nonempty(s)
-- NEVER decideEmpty on the composed intersection (precision loss). The
-- canonical builders (jopSubset/jopDisjoint — used by the producers since K2)
-- put the original `s` LAST (appendItem snoc), so the recognizer returns
-- s = the non-complement/last branch, t = the complement's inner / the first
-- branch — the ORIGINAL (s, t), byte-equal for the witness anti-repurpose.
-- Both branch orders are recognized (robustness); two complements resolve
-- first-complement-wins (subset), deterministic.
-- =========================================================================

@label "Recheck plan"
@description "The tri-precision dispatch's SHAPE half (decide-substrate Phase 2 K3): claim (a closed-sum Proposition, compat until K4, or a Judgment) → the re-check plan { kind = subset|disjoint|empty|nonempty|other, s, t? }. Prop* claims read tag+fields (byte-identical to the retired TS tag-ladders); Judgment claims SHAPE-RECOGNIZE the composed set — JEmpty (SeIntersect [¬t, s]) ⇒ subset(s,t), JEmpty (SeIntersect [t, s]) ⇒ disjoint(s,t), bare JEmpty s ⇒ empty(s), JInhabited s ⇒ nonempty(s) — never a naive decideEmpty over the composed intersection (tri-precision, design/deciding.md §3). Returns the ORIGINAL (s, t) out of the composed set for the witness anti-repurpose deepEqual. Shared by the proposer + the kernel + the TS decide seams. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
recheckPlan : (claimTag: String) -> (claim: a) -> a
recheckPlan claimTag claim =
  if eq claimTag "PropSubset" then { kind = "subset", s = claim.s, t = claim.t }
  else if eq claimTag "PropDisjoint" then { kind = "disjoint", s = claim.s, t = claim.t }
  else if eq claimTag "PropEmpty" then { kind = "empty", s = claim.s }
  else if eq claimTag "PropInhabited" then { kind = "nonempty", s = claim.s }
  else if eq claimTag "JEmpty" then rpEmpty claim
  else if eq claimTag "JInhabited" then rpInhabited claim
  else { kind = "other" }

-- rpInhabited — JInhabited s ⇒ the one-sided inverted plan.
@label "recheck plan: inhabited"
@description "decide-substrate Phase 2 K3 — the JInhabited arm: extract the judgment's set (positional _0) ⇒ { kind = nonempty, s }. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
rpInhabited : (claim: a) -> a
rpInhabited claim =
  case claim of
    JInhabited s -> { kind = "nonempty", s = s }

-- rpEmpty — JEmpty s ⇒ shape-recognize the composed set.
@label "recheck plan: empty"
@description "decide-substrate Phase 2 K3 — the JEmpty arm: extract the judgment's set (positional _0) and shape-recognize it (rpEmptySet). Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
rpEmpty : (claim: a) -> a
rpEmpty claim =
  case claim of
    JEmpty s -> rpEmptySet s

-- rpEmptySet — the composed-set shape recognition: a 2-branch SeIntersect is a
-- subset (one complement) or disjoint (no complement) presentation; anything
-- else is a bare emptiness claim.
@label "recheck plan: empty set shape"
@description "decide-substrate Phase 2 K3 — shape-recognize a JEmpty claim's set: SeIntersect ⇒ rpIntersect (subset/disjoint recognition over exactly-2 branches); any other set shape ⇒ { kind = empty, s = the whole set }. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
rpEmptySet : (s: a) -> a
rpEmptySet s =
  case s of
    SeIntersect { branches } -> rpIntersect branches s
    otherSet -> { kind = "empty", s = s }

-- rpIntersect — exactly-2-branch gate: fewer/more branches ⇒ a bare emptiness
-- claim over the whole intersection (no pair to recognize).
@label "recheck plan: intersect arity"
@description "decide-substrate Phase 2 K3 — the exactly-2-branch gate over a JEmpty claim's SeIntersect: 2 branches ⇒ rpPair (subset/disjoint recognition); 0/1/3+ branches ⇒ { kind = empty, s = the whole intersection } (decideEmpty handles n-ary intersections internally). Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
rpIntersect : (branches: a) -> (whole: a) -> a
rpIntersect branches whole =
  case head branches of
    Nothing -> { kind = "empty", s = whole }
    Just b0 ->
      case tail branches of
        Nothing -> { kind = "empty", s = whole }
        Just rest ->
          case head rest of
            Nothing -> { kind = "empty", s = whole }
            Just b1 ->
              case tail rest of
                Nothing -> rpPair b0 b1 whole
                Just rest2 ->
                  case head rest2 of
                    Nothing -> rpPair b0 b1 whole
                    Just extra -> { kind = "empty", s = whole }

-- rpPair — the 2-branch recognition. The canonical builders put s LAST:
-- jopSubset ⇒ [¬t, s], jopDisjoint ⇒ [t, s]. Both orders recognized; the
-- complement branch is t (its inner), the other branch is s; no complement ⇒
-- disjoint with s = the LAST branch, t = the first (the canonical order).
@label "recheck plan: pair"
@description "decide-substrate Phase 2 K3 — recognize a 2-branch JEmpty intersection: exactly-one-SeComplement ⇒ { kind = subset, s = the other branch, t = the complement's inner }; no complement ⇒ { kind = disjoint, s = branch1, t = branch0 } (the canonical jopDisjoint [t, s] order — s is LAST); two complements ⇒ first-complement-wins (subset), deterministic. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
rpPair : (b0: a) -> (b1: a) -> (whole: a) -> a
rpPair b0 b1 whole =
  case b0 of
    SeComplement { inner } -> { kind = "subset", s = b1, t = inner }
    otherB0 ->
      case b1 of
        SeComplement { inner } -> { kind = "subset", s = b0, t = inner }
        otherB1 -> { kind = "disjoint", s = b1, t = b0 }

-- evidenceOfProofTerm — the ProofTerm → Evidence-kind half of the iso, as a
-- classifier over the proof term's `$tag`. The proof side stays the closed
-- `ProofTerm` sum (the wire is UNCHANGED at K1); this projects it to the
-- kernel's evidence-kind the presentation dispatcher branches on: "Refl" (the
-- singleton-equality presentation) / "ReDecide" (the trio re-run) / "Sample"
-- (the empirical, totality-gated presentation) / "Unknown" (the UnknownRule TCB
-- guard). The Evidence-as-registered-ADT lands when the closed ProofTerm sum
-- RETIRES into it (K4) — introducing a parallel Evidence entity now would
-- duplicate ProofTerm, the subsumption anti-pattern; the classifier iso is the
-- K1 form.
@label "Evidence of proof term"
@description "The ProofTerm → evidence-kind half of the decomposition iso (decide-substrate Phase 2), as a classifier over the proof term's tag: Refl → \"Refl\"; DecidableSetResult → \"ReDecide\"; SampleTestResult → \"Sample\"; anything else → \"Unknown\" (the UnknownRule TCB guard). The presentation dispatcher (verifyProof) branches on the result. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
evidenceOfProofTerm : (proofTag: String) -> String
evidenceOfProofTerm proofTag =
  if eq proofTag "Refl" then "Refl"
  else if eq proofTag "DecidableSetResult" then "ReDecide"
  else if eq proofTag "SampleTestResult" then "Sample"
  else "Unknown"

-- verifyJudgment — THE one-judgment core (the cut). Re-checks a lattice claim
-- from ReDecide evidence: the witness anti-repurpose deepEqual (one/two sided —
-- `twoSided`, the subset/disjoint binary shapes carry two witness sides, the
-- empty/inhabited unary shapes one), then the polarity-gated consumption of the
-- pre-computed tri-precision `decision`. Subsumes the retired
-- `vpDecideTwo`/`vpDecideOne`/`vpDecideInhabited` — one function, parameterised
-- by (arity, polarity, messages); byte-identical markers per case.
@label "Verify judgment"
@description "The one-judgment kernel core (decide-substrate Phase 2). Re-checks a JEmpty/JInhabited lattice claim against ReDecide evidence: the pre-computed witness anti-repurpose facts (witnessLeft always; witnessRight when twoSided — subset/disjoint) must hold, then the pre-computed tri-precision `decision` string is consumed by POLARITY — JEmpty accepts \"true\" (the set is empty ⇒ ⊆/disjoint/empty holds), JInhabited accepts \"false\" (the set is non-empty ⇒ inhabited). Ok ⇒ SolverChecked. Subsumes the retired vpDecideTwo/vpDecideOne/vpDecideInhabited cluster onto the single lattice judgment. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
verifyJudgment : (judgment: Judgment) -> (eqs: a) -> (decision: String) -> (twoSided: Boolean) -> (witnessMsg: String) -> (recheckMsg: String) -> a
verifyJudgment judgment eqs decision twoSided witnessMsg recheckMsg =
  if not eqs.witnessLeft
  then { tag = "Err", etag = "WitnessRejected", reason = witnessMsg }
  else if twoSided
  then vjRight judgment eqs decision witnessMsg recheckMsg
  else vjPolarity judgment decision recheckMsg

-- vjRight — the second (right) witness-side check for the binary (subset /
-- disjoint) shapes, then the polarity decision. Split out so the unary shapes
-- skip it (byte-faithful to the retired vpDecideOne's single-witness path).
@label "verify judgment: right witness"
@description "decide-substrate Phase 2 — the binary-shape (subset/disjoint) second witness-side check: witnessRight must match the proposition's t, then the polarity decision. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
vjRight : (judgment: Judgment) -> (eqs: a) -> (decision: String) -> (witnessMsg: String) -> (recheckMsg: String) -> a
vjRight judgment eqs decision witnessMsg recheckMsg =
  if not eqs.witnessRight
  then { tag = "Err", etag = "WitnessRejected", reason = witnessMsg }
  else vjPolarity judgment decision recheckMsg

-- vjPolarity — consume the pre-computed tri-precision `decision` gated by the
-- judgment's polarity. JEmpty accepts "true"; JInhabited accepts "false" (the
-- inversion that was vpDecideInhabited's INVERTED arm). Ok ⇒ SolverChecked.
@label "verify judgment: polarity decide"
@description "decide-substrate Phase 2 — consume the pre-computed tri-precision decision by the judgment's polarity: JEmpty ⇒ Ok SolverChecked on \"true\" else the recheck WitnessRejected; JInhabited ⇒ Ok SolverChecked on \"false\" (the inverted arm) else the recheck WitnessRejected. Internal helper."
@tags "engine" "internal" "kernel" "prover" "judgment" "decide-substrate" "phase-2"
@category "engine-internal"
vjPolarity : (judgment: Judgment) -> (decision: String) -> (recheckMsg: String) -> a
vjPolarity judgment decision recheckMsg =
  case judgment of
    JEmpty s ->
      if eq decision "true"
      then { tag = "Ok", status = "SolverChecked" }
      else { tag = "Err", etag = "WitnessRejected", reason = recheckMsg }
    JInhabited s ->
      if eq decision "false"
      then { tag = "Ok", status = "SolverChecked" }
      else { tag = "Err", etag = "WitnessRejected", reason = recheckMsg }

-- verifyWitnessMembership — THE kernel-primary singleton face (the phase's
-- title capability). Proves `JInhabited s` from a witness value `w` by
-- re-checking `{w} ⊆ s` via `decideSubset (SeEnum [w]) s` — the same face
-- `set:witnessSound` already ships at the decider level, promoted here to a
-- kernel PROOF rule. It is the SAME judgment specialised to a singleton; no new
-- evidence KIND. Grade SolverChecked on `Just true`.
--
-- SOUNDNESS + the shallow-enum-eq limit (brief constraint §2): the enum trio's
-- element equality is `std eq` (JS `==`, shallow on objects). So an OBJECT
-- witness (e.g. a rel-solve binding record) may re-check `Just false` / `Nothing`
-- and the rule undecides/rejects — SOUND (never a false accept), INCOMPLETE for
-- object witnesses. Upgrading enum-eq to deep equality is a separate corpus-wide
-- decider change, out of this phase.
--
-- K1 STATUS: present in the TCB, NOT yet wired into `verifyProof` — the wire
-- (Proposition/ProofTerm) is unchanged at K1, so no producer emits a witness
-- proof term yet. The producers speak it at K2/K3 (a ProofTerm witness carrier +
-- the verifyProof arm); landing the rule now makes the kernel-primary judgment
-- real, byte-neutral (unreachable ⇒ contributes 0 to the parity corpus).
@label "Verify witness membership"
@description "The kernel-primary singleton face (decide-substrate Phase 2): proves JInhabited s from a witness w by re-checking {w} ⊆ s via decideSubset (SeEnum [w]) s — membership-as-singleton-subset promoted to a kernel proof rule. Ok ⇒ SolverChecked on Just true; an undecided (Nothing) or refuting (Just false) re-check ⇒ WitnessRejected. SOUND but incomplete for object witnesses (the enum trio's element equality is shallow std eq). Present in the TCB from K1; wired to producers at K2/K3."
@tags "engine" "internal" "kernel" "prover" "judgment" "witness" "decide-substrate" "phase-2"
@category "engine-internal"
verifyWitnessMembership : (w: a) -> (s: a) -> a
verifyWitnessMembership w s =
  let ws = appendItem w []
  let singleton = SeEnum { values = ws }
  case decideSubset singleton s of
    Nothing -> { tag = "Err", etag = "WitnessRejected", reason = "witness-membership {w} ⊆ s re-check was undecided (Nothing) — the singleton subset could not be decided (a shallow-enum-eq limit for object witnesses)" }
    Just b ->
      if b
      then { tag = "Ok", status = "SolverChecked" }
      else { tag = "Err", etag = "WitnessRejected", reason = "witness-membership {w} ⊆ s re-check returned Just false — the witness is not a member of the claimed set" }

-- verifyMuInduction — THE Park (Knaster-Tarski) KERNEL rule (decide-substrate
-- Phase 8μ.2). The de-Bruijn moment of the μ arc: the FIRST new trusted-kernel
-- rule since verifyWitnessMembership. Proves a SUBSET judgment `μv.F ⊆ T` by
-- Park induction: `F[v:=T] ⊆ T ⟹ μv.F ⊆ T` for monotone F. NOTHING is trusted
-- from the proposer:
--   1. the rule RE-DERIVES the premise `F[v:=T]` via `substSet` from the μ it is
--      handed (v, F) and the claimed T — it never trusts a proposer-supplied
--      substituted body (design/mu-induction.md §0.1 point 2);
--   2. it gates POSITIVITY (`seMuFaceOk` = positive ∧ supported ⇒ F monotone ⇒
--      μv.F is the WELL-DEFINED least prefixed point ⇒ Knaster-Tarski applies;
--      a non-positive/unsupported μ ⇒ WitnessRejected, never a false accept);
--   3. it re-checks the premise through the ORDINARY judgment (`decideSubset` —
--      the same trio verifyWitnessMembership uses, now Park-capable via the 8μ.2
--      decider arms, ITSELF fuel-bounded ⇒ terminates; exhaustion ⇒ Nothing ⇒
--      the kernel abstains, never a false accept).
-- Accept ⇒ SolverChecked — the SAME grade the witness rule emits; NO new
-- evidence KIND (the one-judgment-many-grades posture, deciding.md §10). Because
-- the rule reads (v, F, T) from the CLAIM's recognized (s, t) and re-derives the
-- premise itself, a proposer that hands a bogus premise (or a tampered witness)
-- is rejected by construction — the witness in the proof term is never consulted.
@label "Verify μ-induction"
@description "The Park (Knaster-Tarski) kernel rule (decide-substrate Phase 8μ.2 — the first new trusted-kernel rule since verifyWitnessMembership): proves a subset claim `μv.F ⊆ T` by Park induction `F[v:=T] ⊆ T ⟹ μv.F ⊆ T`. Requires s to be a SeMu; gates POSITIVITY (seMuFaceOk — monotone ⇒ the least fixpoint is well-defined ⇒ Park sound); RE-DERIVES the premise F[v:=T] via substSet (never trusts a supplied premise); re-checks it through the ordinary judgment (decideSubset, fuel-bounded). Ok ⇒ SolverChecked on a Just true premise; a Just false (refuted) / Nothing (undecided) premise, or a non-positive / non-SeMu s ⇒ WitnessRejected. SOUND by construction — reads (v, F, T) from the claim, so a bogus proposer premise/witness cannot fool it. Internal helper (the K-native currency; wired at kernel.fenel vpJudgment)."
@tags "engine" "internal" "kernel" "prover" "judgment" "mu" "park" "decide-substrate" "phase-8mu"
@category "engine-internal"
verifyMuInduction : (s: a) -> (t: a) -> a
verifyMuInduction s t =
  case s of
    SeMu { var = v, body = f } ->
      if not (seMuFaceOk v f)
      then { tag = "Err", etag = "WitnessRejected", reason = "μ-induction: the μ body is not positive/supported (non-monotone ⇒ the least fixpoint is ill-defined ⇒ Park unsound) — rejected" }
      else case decideSubset (substSet v t f) t of
        Nothing -> { tag = "Err", etag = "WitnessRejected", reason = "μ-induction: the re-derived Park premise F[X:=T] ⊆ T was undecided (Nothing) — the kernel abstains (fuel exhaustion / an undecidable premise)" }
        Just b ->
          if b
          then { tag = "Ok", status = "SolverChecked" }
          else { tag = "Err", etag = "WitnessRejected", reason = "μ-induction: the re-derived Park premise F[X:=T] ⊆ T was refuted (Just false) — μX.F is not inductively contained in T" }
    _ -> { tag = "Err", etag = "WitnessRejected", reason = "μ-induction requires the subset claim's LHS to be a μ (SeMu) set" }
