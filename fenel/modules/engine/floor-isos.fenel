module engine where

-- floor-isos.fenel — the §10 floor-decomposition WITNESSES (containment-substrate
-- Phase 2 Step 2). ISO-2 (`$variant ≅ tagged-disjoint ∪`) and ISO-4 (`$record ≅ ∩
-- of field-presence`) are fwd/bwd witness pairs with a round-trip law (proof =
-- inhabitant). The former ISO-5 positional singleton decomposition is retained
-- only as a conservative no-op: field-identity Phase 3 proved it invalid because
-- a positional axis is its containing-list ordinal, which a singleton projection
-- cannot preserve. Plus the
-- D3-unity elim face (`caseTagsCover`): exhaustiveness as set-containment over the
-- case tags (the §1 thesis "exhaustiveness IS set disjointness", elim side).
--
-- WITNESS, do not rewrite (design-lock §1, the `$opaque{repr,pure}` precedent).
-- `$variant`/`$record`/`$tuple` STAY the efficient primitives; these fns reason
-- ABOUT the reps at the TYPE level — identity on VALUES (a `{$tag:"Just",_0:3}`
-- value is already an inhabitant of both readings). The iso content is the
-- denotational equality the trio (`subset`/`disjoint`/`empty`) checks (the VP);
-- these witnesses are the explicit fwd/bwd transposition that names it.
--
-- The $-KEY BARRIER (design-lock + the Step-1b lesson): a `.fenel` body cannot
-- AUTHOR `$`-keyed objects (`{$union}`/`{$intersect}`/`{$refined}`). So these
-- witnesses work at the MARSHALLED level — over the `TraversalType` ADT
-- (`Tt*` constructors, authorable here), the same boundary-adapter view the trio
-- decides over. The fwd witnesses re-read a `TtVariant`/`TtRecord` as the floor
-- `TtUnion`/`TtIntersect` reading; the bwd witness is the partial inverse
-- (`Nothing` where the floor term has no ADT preimage — an untagged union, a
-- cross-base intersect). The floor RHS as a real `$`-keyed `FenelType` is built by
-- the TS smart-ctors (`unionTypes`/`intersectTypes`, type-foundation.ts) in the
-- verification harness, NOT here.
--
-- The DECIDABLE-FRAGMENT rider (design-lock §1.7): classic ADTs stay decidable
-- because their predicates live in the decidable fragment (singleton tag-equality
-- + finite field-presence). `caseTagsCover` is exactly such a decidable predicate;
-- its proof is its evaluation to `True`. General `$el` → the `Tri`-`Nothing`
-- boundary — NOT claimed here.
--
-- Parser-fence discipline (Step-1b surprises): every body is single-line-else-if,
-- comment-free in-chain, head/tail-fold, under the per-decl token cap. Helpers
-- split liberally.

-- ===========================================================================
-- ISO-2 — `$variant` ≅ tagged-disjoint `∪`   (design-lock §1.1)
--
--   ⟦$variant { cases = [C₁ F₁, …, Cₙ Fₙ] }⟧ = ⋃ᵢ ( {tag = "Cᵢ"} ∩ ⟦recordOf Fᵢ⟧ )
--
-- The tagged-∪ reading: each case `Cᵢ` becomes a SINGLE-CASE variant branch (it
-- carries exactly Cᵢ's tag-singleton + field-record — the floor `(tag ∩ record)`
-- product); the union over the per-case branches is the floor term. Distinct
-- constructor tags force the union DISJOINT (the disjointness side-condition,
-- checked by the trio's `disjoint` over the branch tags), which is what turns `∪`
-- into the coproduct `+`. `$variant` STAYS primitive (posture-lock, P7-1).
-- ===========================================================================

@label "Variant to tagged union"
@description "ISO-2 fwd witness (containment-substrate Phase 2 Step 2): re-read a `$variant` (marshalled `TtVariant`) as the tagged-disjoint `∪` over its cases — each case becomes a single-case-variant branch (its tag-singleton ∩ field-record), the union over them is the floor reading. Identity on VALUES; the iso is at the TYPE level. Works at the marshalled `TraversalType` level (the $-key barrier — the body cannot author `{$union}`). WITNESS, not rewrite: `$variant` stays the efficient primitive. Non-variant input passes through unchanged."
@tags "engine" "type" "containment" "iso" "floor" "phase-2-step2"
variantToUnion : (t: TraversalType) -> TraversalType
variantToUnion t =
  case t of
    TtVariant { cases = cs, raw = r } -> TtUnion { branches = floorCaseBranches cs r, raw = r }
    other -> other

@label "iso: floorCaseBranches"
@description "ISO-2 helper: map each variant case to its single-case-variant floor branch (the tagged disjoint reading — branch Cᵢ carries ONLY case Cᵢ, whose tag-singleton forces the union disjoint). Threads the original raw FenelType. Internal helper."
@tags "engine" "internal" "type" "iso" "phase-2-step2"
@category "engine-internal"
floorCaseBranches : (cases: List a) -> (raw: b) -> List c
floorCaseBranches cases raw =
  floorCaseBranchesAcc cases raw []

@label "iso: floorCaseBranchesAcc"
@description "ISO-2 helper: accumulator-threaded build of the single-case-variant branches (order-preserving — appendItem appends to the END, so the acc grows head→tail in case order). Internal helper."
@tags "engine" "internal" "type" "iso" "phase-2-step2"
@category "engine-internal"
floorCaseBranchesAcc : (cases: List a) -> (raw: b) -> (acc: List c) -> List c
floorCaseBranchesAcc cases raw acc =
  case head cases of
    Nothing -> acc
    Just c ->
      let acc2 = appendItem (TtVariant { cases = [c], raw = raw }) acc
      case tail cases of
        Nothing -> acc2
        Just rest -> floorCaseBranchesAcc rest raw acc2

@label "Tagged union to variant"
@description "ISO-2 bwd witness (LEFT-inverse only, design-lock §1.1): the partial inverse of `variantToUnion`. Defined on a `TtUnion` whose branches are each single-case variants (the tagged-disjoint reading) — merges their cases back into one `$variant`. `Nothing` on an UNTAGGED union (`Int ∪ String`) — that union has no variant preimage (it lost the injection tags). This is the precise content of 'variant : union :: labelled coproduct : lattice join'."
@tags "engine" "type" "containment" "iso" "floor" "phase-2-step2"
unionToVariant : (t: TraversalType) -> Maybe TraversalType
unionToVariant t =
  case t of
    TtUnion { branches = bs, raw = r } -> unionToVariantFold bs r []
    other -> Nothing

@label "iso: unionToVariantFold"
@description "ISO-2 helper: fold a TtUnion's branches, accumulating each single-case-variant branch's case into one variant's case list; `Nothing` the moment a branch is not a single-case variant (the untagged-union refusal). Internal helper."
@tags "engine" "internal" "type" "iso" "phase-2-step2"
@category "engine-internal"
unionToVariantFold : (branches: List a) -> (raw: b) -> (acc: List c) -> Maybe TraversalType
unionToVariantFold branches raw acc =
  case head branches of
    Nothing -> Just (TtVariant { cases = acc, raw = raw })
    Just b ->
      case branchSingleCase b of
        Nothing -> Nothing
        Just c ->
          let acc2 = appendItem c acc
          case tail branches of
            Nothing -> Just (TtVariant { cases = acc2, raw = raw })
            Just rest -> unionToVariantFold rest raw acc2

@label "iso: branchSingleCase"
@description "ISO-2 helper: extract the SOLE case of a single-case-variant branch (`Just c`), or `Nothing` for any other branch shape (a non-variant ⇒ the union is untagged). Internal helper."
@tags "engine" "internal" "type" "iso" "phase-2-step2"
@category "engine-internal"
branchSingleCase : (b: TraversalType) -> Maybe c
branchSingleCase b =
  case b of
    TtVariant { cases = cs } -> head cs
    other -> Nothing

-- ===========================================================================
-- ISO-4 — `$record` ≅ `∩` of field-presence   (design-lock §1.2)
--
--   ⟦$record { fields = [x:A, y:B] }⟧ (OPEN reading) = {x:A} ∩ {y:B}
--
-- The intersection over single-field-presence records. Fenel's containment
-- relation already width-subtypes records (a wider record ⊆ a narrower one), i.e.
-- treats records as OPEN — so `record = ∩-of-fields` holds ON THE NOSE for the
-- open reading. A CLOSED (exact-fields) record is the open `∩` + a completeness
-- `$el` predicate `keys(v) = {x,y}` (NOT a new former; the trio checks it via the
-- completeness predicate's `empty`/`subset`). Field-name disjointness is the
-- side-condition making the `∩` a PRODUCT.
-- ===========================================================================

@label "Record to intersect"
@description "ISO-4 fwd witness (containment-substrate Phase 2 Step 2): re-read a `$record` (marshalled `TtRecord`) as the `∩` of single-field-presence records (`{x:A,y:B}` ⇒ `{x:A} ∩ {y:B}`) — the OPEN reading, which holds on the nose because Fenel width-subtypes records. The closed reading adds a completeness `$el` predicate. Works at the marshalled `TraversalType` level (the $-key barrier). WITNESS, not rewrite. Non-record input passes through unchanged."
@tags "engine" "type" "containment" "iso" "floor" "phase-2-step2"
recordToIntersect : (t: TraversalType) -> TraversalType
recordToIntersect t =
  case t of
    TtRecord { fields = fs, raw = r } -> TtIntersect { branches = fieldPresenceBranches fs r, raw = r }
    other -> other

@label "iso: fieldPresenceBranches"
@description "ISO-4 helper: map each record field to its single-field-presence record branch (`{x:A}` from field x:A). Threads the original raw FenelType. Internal helper."
@tags "engine" "internal" "type" "iso" "phase-2-step2"
@category "engine-internal"
fieldPresenceBranches : (fields: List a) -> (raw: b) -> List c
fieldPresenceBranches fields raw =
  fieldPresenceBranchesAcc fields raw []

@label "iso: fieldPresenceBranchesAcc"
@description "ISO-4 helper: accumulator-threaded build of the single-field-presence record branches (order-preserving). Internal helper."
@tags "engine" "internal" "type" "iso" "phase-2-step2"
@category "engine-internal"
fieldPresenceBranchesAcc : (fields: List a) -> (raw: b) -> (acc: List c) -> List c
fieldPresenceBranchesAcc fields raw acc =
  case head fields of
    Nothing -> acc
    Just f ->
      let acc2 = appendItem (TtRecord { fields = [f], raw = raw }) acc
      case tail fields of
        Nothing -> acc2
        Just rest -> fieldPresenceBranchesAcc rest raw acc2

@label "Intersect to record"
@description "ISO-4 bwd witness (partial inverse, design-lock §1.2): defined on a `TtIntersect` whose branches are each single-field-presence records over distinct semantic field keys — merges them into one `$record`. `Nothing` on a cross-base `∩` (`Int & String` — no field structure, no record preimage). Field-key disjointness is the side-condition that makes the `∩` a product; wire names are presentation only."
@tags "engine" "type" "containment" "iso" "floor" "phase-2-step2"
intersectToRecord : (t: TraversalType) -> Maybe TraversalType
intersectToRecord t =
  case t of
    TtIntersect { branches = bs, raw = r } -> intersectToRecordFold bs r []
    other -> Nothing

@label "iso: intersectToRecordFold"
@description "ISO-4 helper: fold a TtIntersect's branches, accumulating each single-field-presence record's field into one record's field list; `Nothing` the moment a branch is not a single-field record (a cross-base intersect ⇒ no record preimage). Internal helper."
@tags "engine" "internal" "type" "iso" "phase-2-step2"
@category "engine-internal"
intersectToRecordFold : (branches: List a) -> (raw: b) -> (acc: List c) -> Maybe TraversalType
intersectToRecordFold branches raw acc =
  case head branches of
    Nothing -> Just (TtRecord { fields = acc, raw = raw })
    Just b ->
      case branchSingleField b of
        Nothing -> Nothing
        Just f ->
          let acc2 = appendItem f acc
          case tail branches of
            Nothing -> Just (TtRecord { fields = acc2, raw = raw })
            Just rest -> intersectToRecordFold rest raw acc2

@label "iso: branchSingleField"
@description "ISO-4 helper: extract the SOLE field of a single-field-presence record branch (`Just f`), or `Nothing` for any other branch shape (a non-record ⇒ cross-base intersect). Internal helper."
@tags "engine" "internal" "type" "iso" "phase-2-step2"
@category "engine-internal"
branchSingleField : (b: TraversalType) -> Maybe c
branchSingleField b =
  case b of
    TtRecord { fields = fs } -> head fs
    other -> Nothing

-- ===========================================================================
-- RETIRED ISO-5 — `$tuple` ≅ `∩` of positional field-presence
--
--   ⟦$tuple [A, B]⟧ = {_0:A} ∩ {_1:B}
--
-- This was sound only while field spellings acted as semantic axes. Under the
-- field-identity Phase-3 invariant, PositionalField(i) is the ordinal in its
-- containing list. Projecting the second field to the singleton `{_1:B}` either
-- leaves PositionalField(1) at invalid local ordinal 0 or renumbers it to a
-- different semantic axis. No identity-preserving witness exists in this shape.
-- Keep the registered entry point as a conservative no-op so it cannot fabricate
-- an invalid semantic tree; the focused VP asserts that the old decomposition is
-- rejected at the total-key boundary.
-- ===========================================================================

@label "Tuple intersect witness (retired)"
@description "Retired ISO-5 entry point. Field-identity Phase 3 makes the old positional-singleton decomposition invalid: list ordinal is semantic identity and cannot survive projection to a singleton field list. Returns the input unchanged rather than fabricating a key-invalid TraversalType; positionalNames is retained only in the pre-release function signature."
@tags "engine" "type" "containment" "iso" "floor" "phase-2-step2"
tupleAsIntersect : (t: TraversalType) -> (positionalNames: List String) -> TraversalType
tupleAsIntersect t positionalNames = t

-- ===========================================================================
-- The D3-unity ELIM face — exhaustiveness as set-containment   (design-lock §1.7)
--
--   matchExhaustive(cases, scrutinee) ⟺ empty( intersect( complement(∪caseTags),
--                                                          scrutinee ) ) = Just true
--                                     ⟺ subset( scrutineeTags, ∪caseTags )
--
-- The §1 thesis ("exhaustiveness IS set disjointness") made executable. The SAME
-- `$el` tag-predicate is three faces: intro (a constructor `Just x` ESTABLISHES
-- the tag), elim (a pattern match DECIDES it on a value — `caseTagsCover` here),
-- static (the trio DECIDES it over the whole type — `subset`/`empty` in the VP).
-- `caseTagsCover` is the ELIM side: a match's case-tags cover the scrutinee's
-- constructor tags iff every scrutinee tag is matched. The STATIC side (the trio's
-- `subset`/`empty` over the case-tag union) is demonstrated in the VP harness to
-- AGREE with this — the mechanization. A decidable-fragment predicate; its proof
-- is its evaluation to `True`.
-- ===========================================================================

@label "Case tags cover"
@description "The D3-unity ELIM face (containment-substrate Phase 2 Step 2): does a match's `caseTags` cover the scrutinee's constructor `scrutineeTags`? `True` iff every scrutinee tag is in caseTags (exhaustive). This is exhaustiveness as set-containment, the ELIM side of the §1 thesis 'exhaustiveness IS set disjointness' — the VP harness demonstrates the trio's STATIC `subset`/`empty` verdict over the case-tag union AGREES with this. A decidable-fragment predicate (finite singleton tag-equality); proof = evaluation to True."
@tags "engine" "type" "containment" "exhaustiveness" "d3-unity" "phase-2-step2"
caseTagsCover : (scrutineeTags: List String) -> (caseTags: List String) -> Bool
caseTagsCover scrutineeTags caseTags =
  case head scrutineeTags of
    Nothing -> True
    Just s ->
      if not (elem s caseTags)
      then False
      else case tail scrutineeTags of
        Nothing -> True
        Just rest -> caseTagsCover rest caseTags

@label "Variant case tags"
@description "Project a `$variant`'s constructor-tag set (the marshalled `TtVariant`'s case names) — the scrutinee's tag set for `caseTagsCover`. The tag layer is a singleton dependent predicate per case (design-lock §1.3); this reads it off the cases. Non-variant ⇒ []."
@tags "engine" "type" "containment" "exhaustiveness" "d3-unity" "phase-2-step2"
variantCaseTags : (t: TraversalType) -> List String
variantCaseTags t =
  case t of
    TtVariant { cases = cs } -> caseNames cs
    other -> []

@label "iso: caseNames"
@description "Helper: collect the `name` of every variant case in a list. Internal helper."
@tags "engine" "internal" "type" "exhaustiveness" "phase-2-step2"
@category "engine-internal"
caseNames : (cases: List a) -> List String
caseNames cases =
  caseNamesAcc cases []

@label "iso: caseNamesAcc"
@description "Helper: accumulator-threaded collect of every variant case `name` (order-preserving). Internal helper."
@tags "engine" "internal" "type" "exhaustiveness" "phase-2-step2"
@category "engine-internal"
caseNamesAcc : (cases: List a) -> (acc: List String) -> List String
caseNamesAcc cases acc =
  case head cases of
    Nothing -> acc
    Just c ->
      let acc2 = appendItem c.name acc
      case tail cases of
        Nothing -> acc2
        Just rest -> caseNamesAcc rest acc2
