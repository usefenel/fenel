module engine where

-- signature.fenel — the signature-substrate's canonical function-arrow
-- projection (Phase 1; normative: design/signatures-and-contracts.md §6).
--
-- A registered function's DECLARED ARROW is `FenelFunction.params/returns`
-- — the authority row of the §6 representation matrix. Every consumer that
-- wants "the function's type as a value" must read it through ONE producer
-- instead of re-assembling `$arrow` envelopes ad hoc (the ≥4-reps drift the
-- signature-substrate exists to close). This module owns that producer on
-- the Tt face:
--
--   • The host seam (`dispatchedFunctionArrowType`, engine-bodies-
--     dispatch.ts) performs the one descriptor-safe `$`-key boundary
--     marshal of `{$arrow: {params: fn.params, returns: fn.returns}}`.
--     `requires` is NEVER part of the envelope — capability constraints
--     are contract judgment 2 (a property of `(function, scope)`), not
--     value type; the `$arrow.requires` slot itself is RETIRED in this
--     same phase (types.ts).
--   • This body owns the semantics: FLATTEN-NORMALIZATION via the shipped
--     `ttArrowFlatten` (containment.fenel; floor-kernel Phase 2) — a
--     signature's identity is its flattened arrow, written arity is
--     presentation (`⟦(A,B)→C⟧ = ⟦(A)→((B)→C)⟧` under the currying
--     calling convention; the doc §1 "currying is load-bearing" clause).
--   • Field-identity semantic keys (`TtArrowParam.key`/`semanticKey`)
--     ride the marshaled params untouched — the projection preserves
--     them, never reorders by them (arrow variance stays positional).
--
-- Consumers wanting the SetExpr face compose with `typeToSetExpr`
-- (type-to-set.fenel) — the same route the editor typed-hole ships.
-- P1 ships the producer + the §11.1 round-trip gate; sweeping every
-- existing `$arrow`-assembly site onto it is incremental follow-up.

@label "Function arrow type"
@description "signature-substrate Phase 1 — THE canonical arrow projection of a function spec (design/signatures-and-contracts.md §6): the marshaled `$arrow {params: fn.params, returns: fn.returns}` on the Tt face, flatten-normalized via ttArrowFlatten (a signature's identity is its flattened arrow; written arity is presentation). `requires` is never in it — capability constraints are contract judgment 2, not value type. Host seam: `dispatchedFunctionArrowType` (engine-bodies-dispatch.ts) owns the one `$`-key boundary marshal; non-arrow input rides through unchanged (ttArrowFlatten is identity off arrows)."
@tags "engine" "signature" "signature-substrate" "phase-1"
functionArrowType : (signature: TraversalType) -> TraversalType
functionArrowType signature = ttArrowFlatten signature

-- ── Function graphs (LAUNCH-PLAN row 9) ─────────────────────────────────────
-- A function card draws a sampled plot when the function's declared arrow has
-- exactly one parameter and both that parameter and the return are contained
-- in the numeric universe the reader passes (Number). Containment is the
-- SOUND member `subset` (an abstention is no graph). The sampled domain must
-- lie inside the parameter: a parameter containing the whole universe samples
-- -5..5; an interval refinement over a base containing the whole universe
-- samples its bounds (an open end is inset, a missing end spans 10); anything
-- else (Nat, a refinement of Nat, a non-interval predicate) is not sampled.
-- Purity (no `requires`) is checked by the caller: it is not part of the arrow.

@label "Function graph domain"
@description "LAUNCH-PLAN row 9 — the sampled x range for a function card's plot, or Nothing when the declared arrow is not a one-parameter numeric function. Both the parameter and the return must be provably contained in `numeric` (sound `subset`); the range is -5..5 when the parameter contains all of `numeric`, an interval refinement's bounds when its base does, else Nothing."
@tags "engine" "signature" "function-graph"
functionGraphDomain : (signature: TraversalType) -> (numeric: TraversalType) -> Maybe ({ lo: Number, hi: Number })
functionGraphDomain signature numeric = case functionArrowType signature of
  TtArrow { params = ps, returns = r } ->
    if and (eq (length ps) 1) (subsetB r numeric)
    then case head ps of
      Just p -> if subsetB p.type numeric then functionGraphParamDomain p.type numeric else Nothing
      Nothing -> Nothing
    else Nothing
  _ -> Nothing

@category "engine-internal"
functionGraphParamDomain : (param: TraversalType) -> (numeric: TraversalType) -> Maybe ({ lo: Number, hi: Number })
functionGraphParamDomain param numeric =
  if subsetB numeric param then Just { lo = -5, hi = 5 }
  else case peelToRefined param of
    Just refined -> if subsetB numeric (tsBase refined) then functionGraphIntervalDomain refined else Nothing
    Nothing -> Nothing

@category "engine-internal"
functionGraphIntervalDomain : (refined: TraversalType) -> Maybe ({ lo: Number, hi: Number })
functionGraphIntervalDomain refined = case refined of
  TtRefined { setView = s } -> case s of
    SeInterval { interval = iv } -> functionGraphBounds iv.lo iv.hi
    _ -> Nothing
  _ -> Nothing

@category "engine-internal"
functionGraphBounds : (lo: Maybe ({ value: Any, inclusive: Boolean })) -> (hi: Maybe ({ value: Any, inclusive: Boolean })) -> Maybe ({ lo: Number, hi: Number })
functionGraphBounds lo hi = case lo of
  Just l -> case hi of
    Just h -> functionGraphRange l h
    Nothing -> functionGraphRange l { value = l.value + 10, inclusive = true }
  Nothing -> case hi of
    Just h -> functionGraphRange { value = h.value - 10, inclusive = true } h
    Nothing -> Nothing

@category "engine-internal"
functionGraphRange : (l: { value: Any, inclusive: Boolean }) -> (h: { value: Any, inclusive: Boolean }) -> Maybe ({ lo: Number, hi: Number })
functionGraphRange l h =
  if and (and (numberIsFinite l.value) (numberIsFinite h.value)) (l.value < h.value)
  then
    let inset = (h.value - l.value) / 100
    Just { lo = if l.inclusive then l.value else l.value + inset, hi = if h.inclusive then h.value else h.value - inset }
  else Nothing
