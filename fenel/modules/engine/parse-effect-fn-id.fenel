module engine where

-- parseEffectFnId — parse a $effect:<Class>:<method> sentinel fnId.
--
-- Returns Maybe { typeName: String, methodName: String } with Just on
-- well-formed sentinels (non-empty class + non-empty method, separated
-- by at least one colon — additional colons stay in methodName) and
-- Nothing otherwise. Mirrors the TS oracle at
-- implementations/typescript/engine/src/ir/effects-explicit.ts.
--
-- Phase 21.0 canary — the first piece of the engine's compilation
-- pipeline expressed in Fenel. The TS impl stays as the test oracle;
-- this body runs through the engine evaluator and the per-target
-- self-host harnesses (compile-{js,wasm,llvm}-self-host) and asserts
-- byte-equality on a curated input matrix.

@label "Parse effect fnId"
@description "Parse a $effect:<Class>:<method> sentinel fnId into its (typeName, methodName) pair. Returns Nothing for malformed sentinels (missing prefix, missing separator, empty class, empty method). Mirrors the TS oracle at implementations/typescript/engine/src/ir/effects-explicit.ts — the canonical Phase 21.0 canary that proves a real engine pass executes through both the engine evaluator AND each per-target self-host (JS / Wasm / LLVM)."
@tags "engine" "effect" "ir" "self-host" "phase-21"
parseEffectFnId : (fnId: String) -> Maybe ({ typeName: String, methodName: String })
parseEffectFnId fnId =
  if startsWith fnId "$effect:" then
    let rest = slice fnId 8 (length fnId)
    let parts = split rest ":"
    case head parts of
      Nothing -> Nothing
      Just typeName ->
        case tail parts of
          Nothing -> Nothing
          Just restParts ->
            let methodName = join restParts ":"
            if length typeName == 0 then Nothing
            else if length methodName == 0 then Nothing
            else Just { typeName = typeName, methodName = methodName }
  else Nothing
