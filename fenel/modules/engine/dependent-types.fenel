module engine where

-- dependent-types — pure FenelType-key membership check for `isFenelType`.
--
-- Phase 7a port — fifth (and final) port in the type-algebra arc.
-- Mirrors `isFenelType` in implementations/typescript/engine/src/
-- dependent-types.ts (now a thin shim).
--
-- Scope reduction per brief risk #1: `resolveEl` / `peelEl` /
-- `containsType` stay TS as evaluator-adjacent primitives (they
-- invoke the engine evaluator to resolve `$el { … }`-wrapped
-- Expressions). By extension the factory functions (`Vec` /
-- `LengthBoundedString` / `Sigma` / `SigmaGuards` /
-- `lengthEqualsLiteral` / `lengthEqualsExpr` / `guardsToIfChain`)
-- also stay TS — they're predominantly TS data construction over the
-- evaluator-adjacent helpers, producing FenelType-shaped JSON
-- structures that downstream consumers structurally pattern-match.
--
-- Only `isFenelType` ports cleanly here — a pure list-membership
-- predicate that benefits from migration without dragging the
-- evaluator surface into the body. The TS wrapper extracts the
-- input value's object keys (returning false TS-side for null /
-- non-object / array / empty-object inputs) and dispatches the
-- membership check to this body.
--
-- Helpers prefixed `depTypes…` to avoid registry collisions.

-- =========================================================================
-- resolveElPayload — the `$el` RESOLUTION re-entry (unified-static-analysis
-- Phase 3b-5). Retires the 7a scope-out: `resolveEl` / `peelEl` /
-- `containsType` in dependent-types.ts left the evaluator re-entry as the ONE
-- evaluator-adjacent hole — there was no Fenel-callable evaluator entry. Phase
-- 8 shipped `evaluateWith` (the explicit-strategy `evalApply` re-entry), so the
-- `$el` payload now resolves through the SHIPPED Fenel evaluator entry, NOT the
-- direct TS `resolveEvaluator`.
--
-- `elExpr` is the `$el` payload Expression (live JSON-Logic — `{call:…}` /
-- `{var:…}` / `{if:…}`), passed OPAQUE (D-3b-5-4): the keys ARE evaluator ops,
-- a `$`-adjacent shape a `.fenel` body cannot walk or author, so the body does
-- NOT introspect it — it hands it to `evaluateWith`, which evaluates it. The
-- sibling-value context the payload reads (e.g. `{var:"n"}`) is threaded by the
-- TS seam through the EvaluateContext's `_localData` (the eager-strategy
-- native's data slot), NOT a `$`-key the body authors.
--
-- Eager is correct — the TS used the default eager evaluator
-- (`resolveEvaluator(evalCtx)`). The `Result EvalError Value` collapses to
-- `Maybe Value` here (the TS `undefined`-on-failure posture, D-3b-5-5): an
-- evaluator `Err` ⇒ `Nothing` ⇒ the seam's `undefined` (unresolved/open type).
-- The `isFenelType` GATE on the resolved value stays at the seam (the value is a
-- `$`-keyed FenelType the body cannot key-introspect — the `$`-barrier; the
-- gate routes through the already-Fenel `engine:isFenelType`).
@category "engine-internal"
resolveElEvaluatorRequest : ({ className: String, methodName: String, arguments: List String })
resolveElEvaluatorRequest = { className = "Evaluator", methodName = "eval", arguments = ["EagerStrategy"] }

@label "Resolve $el payload (eager)"
@description "Resolve a dependent type's opaque Expression through a scoped selected Evaluator descriptor and the existing evalApply entry. Sibling values stay in the reader's local data; missing or conflicted selection and evaluator errors refuse with Nothing. The host checks the resulting Type at the dollar-key marshalling boundary."
@tags "engine" "type" "dependent" "resolve" "evaluate"
resolveElPayload : (elExpr: Expression) -> (selection: Maybe ResolveOutcome) -> Maybe Value
resolveElPayload elExpr selection = case selection of
  Just (Resolved method) -> case evalApply method elExpr of
    Ok v -> Just v
    Err e -> Nothing
  _ -> Nothing

-- isFenelTypeKeysMatch — entry point. Returns true when any of the
-- input keys is in the known-Fenel-type-key list.
@label "Is FenelType (keys match)"
@description "Phase 7a — pure list-membership predicate: does at least one of the input keys appear in the known-Fenel-type-keys list? Boundary adapter for `isFenelType`; dispatched via `dispatchedIsFenelType` in engine-bodies-dispatch.ts which handles the null / non-object / array / empty-object short-circuits TS-side. Mirrors implementations/typescript/engine/src/dependent-types.ts:isFenelType. Fifth (and final) port of the type-algebra arc."
@tags "engine" "type" "dependent" "boundary" "phase-7a"
isFenelTypeKeysMatch : (inputKeys: List String) -> (knownKeys: List String) -> Bool
isFenelTypeKeysMatch inputKeys knownKeys =
  depTypesAnyMember inputKeys knownKeys

-- depTypesAnyMember — does the input keys list contain at least one
-- key that's also in the known keys list?
@label "dependent-types: anyMember"
@description "Phase 7a — does the input keys list contain at least one key from the known keys list? Helper; tagged engine-internal."
@tags "engine" "internal" "type" "phase-7a"
@category "engine-internal"
depTypesAnyMember : (inputKeys: List String) -> (knownKeys: List String) -> Bool
depTypesAnyMember inputKeys knownKeys =
  case head inputKeys of
    Nothing -> false
    Just k ->
      if elem k knownKeys
      then true
      else case tail inputKeys of
        Nothing -> false
        Just rest -> depTypesAnyMember rest knownKeys
