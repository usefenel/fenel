-- =========================================================================
-- Track — sequenced sounds over time. A `Track` is a list of
-- `TrackEntry`s, each pairing a start time with a Sound. The
-- closure-construction helpers (`sampleTrackAt`, `mixDown`, `track`,
-- `trackEntry`) all live on the TS-native side; the `.fenel` file just
-- declares the two entity shapes.
--
-- Phase 4g of ts-elimination: this body was previously the inline
-- `const TRACK_SRC = \`…\`` template literal at engine/src/modules/track.ts;
-- extracted verbatim. No lambda escapes in this body (the inline source
-- has no function definitions). References to `Sound` resolve through
-- the catalog walk against the sound module which loads first.
--
-- module-substrate Phase 3g (2026-05-30) — track is a CTX-ONLY composer:
-- the 2 TS natives (sampleTrackAt / mixDown) are CTX natives (they re-enter the
-- evaluator to sample each entry's Sound), now @native FOREIGN DECLARATIONS
-- here with impls in ffi/track-ffi.ts (which imports sound-ffi's
-- sampleSoundNative leaf-to-leaf); the plain `nativeImpls` map is EMPTY. The 2
-- pure record constructors `track` / `trackEntry` (Fenel-bodied since 5b11)
-- CONSOLIDATE here from the retired `track.fenel` / `track-entry.fenel`
-- sidecars (recipe N6). All 4 functions ride the `audio` category (@category
-- "audio"). track has NO own Sampleable/Renderable/other dispatch instances.
-- =========================================================================

module track where

TrackEntry = TrackEntry start: Number sound: Sound

Track = Track entries: [TrackEntry]

-- ----- Foreign declarations (native-backed; impl in ffi/track-ffi.ts) -------
-- `sampleTrackAt` / `mixDown` re-enter the evaluator (CTX natives →
-- nativeImplsCtx — track has NO plain native). No Fenel body: the registry
-- resolves each call to the ffi leaf keyed by codeName.

@native
@label "Sample track at time"
@description "Sum the amplitudes of every Track entry at the given time (each shifted by its start time). Clamped to [-1, 1]."
@category "audio"
@tags "audio" "track" "primitive"
sampleTrackAt : (track: Track, t: Time) -> Amplitude

@native
@label "Mix down"
@description "Collapse a Track into a single Sound by summing every entry's per-time amplitude."
@category "audio"
@tags "audio" "track"
mixDown : (track: Track) -> Sound

-- track / trackEntry — pure Fenel-bodied record constructors (consolidated from
-- the retired track.fenel / track-entry.fenel sidecars). Drop the pre-5b11 TS
-- natives' Array.isArray / Number-coercion guards (the typed spec covers the
-- contract); return the canonical typed `{$tag}` shapes via the constructors.
@label "Track"
@description "Build a Track from a list of TrackEntry values. Returns the canonical typed `{$tag: \"Track\", entries: [...]}` shape via the Track constructor."
@category "audio"
@tags "audio" "track" "constructor"
track : (entries: List TrackEntry) -> Track
track entries = Track { entries = entries }

@label "Track entry"
@description "Build a TrackEntry from a start time (seconds) and a Sound. Returns the canonical typed `{$tag: \"TrackEntry\", start, sound}` shape via the TrackEntry constructor."
@category "audio"
@tags "audio" "track" "constructor"
trackEntry : (start: Number, sound: Sound) -> TrackEntry
trackEntry start sound = TrackEntry { start = start, sound = sound }
