-- =========================================================================
-- module license where — algebraic license composition + revenue share.
--
-- typed-function-references FenelModule-retirement Phase FM-retire-1b
-- (2026-06-06). The 2 `defineFunction` specs + ~80 LOC of exported TS algebra
-- (`composeLicenses` / `computeEffectiveLicense` + the LicenseValue /
-- CompositionResult types + the PERMISSIVENESS / COPYLEFT / WEAK_COPYLEFT /
-- COPYLEFT_INCOMPATIBLE tables) in `engine/src/modules/license.ts` are RETIRED.
-- The decision gate resolved to PORT (the Fenel-first HARD RULE: the algebra is
-- pure 8-case ADT composition — it MUST be Fenel; it is roadmapped, not dead;
-- and the port makes `check_license_compat` LIVE for the first time, fixing the
-- dead bodyless stub).
--
-- Source-of-truth split:
--   - THIS file        — `module license where` header + the algebra
--                        (`composeLicenses` / `check_license_compat` /
--                        `compute_rev_share` + pure helpers) + identity facets;
--   - `types.fenel`    — the `License` 8-case ADT + the `Rate` named atom,
--                        loaded structurally (its entities ride
--                        `licenseModule.entities`; the catalog needs them).
-- This file CONSOLIDATES the former `compute-rev-share.fenel` standalone (now
-- DELETED — least churn: one `module license where` source over two).
--
-- TWO no-corner-cut redesigns over the retired TS:
--   1. `check_license_compat` was a faux-`Result` (`{ ok: Boolean, license:
--      String, error: String }` — a Boolean-tagged success + a parallel error
--      string + a License↔String faux-encoding). It is authored canonically as
--      `[License] -> Result String License` (`Err message` / `Ok effectiveLicense`).
--      Licenses are first-class ADT values, not strings. No live consumer existed
--      (it was a dead stub), so the ADT-I/O form is clean.
--   2. `compute_rev_share`'s `.fenel` return was the empty-record placeholder
--      `-> {}`; the LIVE TS spec declared the real 3-field record. The real
--      record is authored here directly (no empty-record regression).
--
-- Result construction is POSITIONAL (`Ok eff` / `Err msg`) — the construct op
-- (`json-logic.ts`) always emits positional payload under `_0`, and `std:bindResult`
-- pattern-matches `Ok`/`Err` on `_0`; this is the proven codec.fenel /
-- emit-js.fenel pattern. (Named-record `Ok { value = … }` would land under
-- `value`, which `bindResult`'s `_0` match would NOT bind.)
--
-- Identity parity: the `license` category derives at read time from the `license:`
-- id-prefix (Phase 3j) — NO `@category` directive (FIX B drops the former
-- `@category "license"`). `@label` / `@description` / `@tags` reproduce the rest.
-- The empty `default: Nothing` boilerplate VANISHES (no live param-defaults; NO
-- `@default`). The header keeps the LEGACY lowercase `license:` id-prefix.
-- =========================================================================

module license where

-- ----- Pure helpers (the retired TS tables, as Fenel) -----------------------

-- licenseTag — the nominal discriminator as a String (drives the predicate
-- comparisons + the same-license identity check). Nominal dispatch: match on
-- the License constructors directly.
licenseTag : License -> String
licenseTag lic = case lic of
  MIT -> "MIT"
  Apache -> "Apache"
  GPL -> "GPL"
  LGPL -> "LGPL"
  BSD -> "BSD"
  Proprietary -> "Proprietary"
  RevShare { rate = _, recipients = _ } -> "RevShare"
  Custom { terms = _ } -> "Custom"

-- permissiveness — the former `PERMISSIVENESS` table (higher = more permissive),
-- used for the least-permissive-wins fallback. RevShare / Custom are handled
-- before the permissiveness branch in `composeLicenses`, so their values here
-- are unreachable (the TS table used -1; 0 is honest and avoids a negative
-- literal — never compared).
permissiveness : License -> Number
permissiveness lic = case lic of
  MIT -> 5
  BSD -> 5
  Apache -> 4
  LGPL -> 3
  GPL -> 1
  Proprietary -> 0
  RevShare { rate = _, recipients = _ } -> 0
  Custom { terms = _ } -> 0

-- incompatMessage — the GPL+Proprietary conflict string (byte-faithful to the
-- retired TS error message).
incompatMessage : License -> License -> String
incompatMessage a b =
  concat "Incompatible licenses: " (concat (licenseTag a) (concat " and " (concat (licenseTag b) " cannot be composed. Copyleft requires all derived work to be open source.")))

-- composeRevShare — the RevShare branch. Two RevShare → sum `rate`, set-union
-- `recipients` (std:concat then std:unique). RevShare + other → the RevShare
-- (the revenue layer stacks on top). Called only when at least one side is a
-- RevShare, so the trailing wildcards (`a` not RevShare ⇒ `b` is) are exact.
composeRevShare : License -> License -> Result String License
composeRevShare a b = case a of
  RevShare { rate = ra, recipients = rcpa } ->
    case b of
      RevShare { rate = rb, recipients = rcpb } ->
        Ok (RevShare { rate = add ra rb, recipients = unique (concat rcpa rcpb) })
      _ -> Ok a
  _ -> Ok b

-- ----- The composition algebra ----------------------------------------------

-- composeLicenses — the faithful port of the retired TS `composeLicenses`,
-- translated to Fenel idioms (cascading `if … then … else if …` over the
-- nominal tag, not a Fenel-wrapped copy of the TS control flow). The retired
-- TS `composeLicenses` was a plain (unlabeled) export, not a `defineFunction`;
-- it stays facet-less here (auto-Codeable only, like the pure helpers) — so the
-- only identity-bearing fns are the 2 original `defineFunction` specs. This also
-- holds the spec-law baseline (a `@label` would add one `labelNonEmpty` proof
-- obligation). A label can be added when a FenelCheck consumer surfaces it.
composeLicenses : License -> License -> Result String License
composeLicenses a b =
  if (eq (licenseTag a) "RevShare") or (eq (licenseTag b) "RevShare")
    then composeRevShare a b
  else if (eq (licenseTag a) "Custom") or (eq (licenseTag b) "Custom")
    then Ok (if eq (licenseTag a) "Custom" then a else b)
  else if eq (licenseTag a) (licenseTag b)
    then Ok a
  else if ((eq (licenseTag a) "GPL") and (eq (licenseTag b) "Proprietary")) or ((eq (licenseTag b) "GPL") and (eq (licenseTag a) "Proprietary"))
    then Err (incompatMessage a b)
  else if ((eq (licenseTag a) "LGPL") and (eq (licenseTag b) "Proprietary")) or ((eq (licenseTag b) "LGPL") and (eq (licenseTag a) "Proprietary"))
    then Ok (Proprietary)
  else if eq (licenseTag a) "GPL"
    then Ok a
  else if eq (licenseTag b) "GPL"
    then Ok b
  else
    if lte (permissiveness a) (permissiveness b)
      then Ok a
      else Ok b

-- check_license_compat — fold `composeLicenses` over the list with the canonical
-- empty → `Ok MIT` base, short-circuiting on the first `Err` via std:bindResult
-- (the former `computeEffectiveLicense`, now LIVE + canonically Result-typed).
-- The codec.fenel:sequenceDecodes fold-over-Ok-seed pattern.
check_license_compat : [License] -> Result String License
@label "Check License Compatibility"
@description "Check if a list of licenses can be composed. Returns the effective license (Ok) or an incompatibility message (Err)."
@tags "license" "pure" "validation"
check_license_compat licenses =
  let folder = \acc lic -> bindResult acc (\eff -> composeLicenses eff lic)
  let seed = Ok (MIT)
  fold folder seed licenses

-- ----- Revenue share --------------------------------------------------------

-- compute_rev_share — pure arithmetic (mul / div / sub) + `length` + a record
-- literal. Faithful to the TS oracle:
--   total_shared = amount_cents * (rate / 100)
--   count        = length recipients
--   { per_recipient_cents = total_shared / count,
--     total_shared_cents  = total_shared,
--     remainder_cents     = amount_cents - total_shared }
-- Div-by-zero edge: empty recipients → count = 0 → `div total_shared 0`. Fenel's
-- std:div returns 0 on div-by-zero (the Number model has no Infinity). The
-- pre-port inline JSON-Logic body was a two-key `{let, in}` object — treated as
-- a record literal, never evaluated as a let-binding (effectively dead) — so
-- there is no prior runtime behaviour to preserve; 0 is the honest result.
-- compute-rev-share.test.ts pins it.
compute_rev_share : (amount_cents: Number) -> (rate: Number) -> (recipients: [String]) -> { per_recipient_cents: Number, total_shared_cents: Number, remainder_cents: Number }
@label "Compute Revenue Share"
@description "Given an amount and RevShare license, compute per-recipient payouts."
@tags "license" "pure" "revenue"
compute_rev_share amount_cents rate recipients =
  let total_shared = mul amount_cents (div rate 100)
  let count = length recipients
  {
    per_recipient_cents = div total_shared count,
    total_shared_cents = total_shared,
    remainder_cents = sub amount_cents total_shared
  }
