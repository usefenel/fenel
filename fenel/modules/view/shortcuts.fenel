module view where

import std (reverse, chars, join, upper, split, eq)
import system (Expr)

-- A shortcut is ordinary saved data. Callables are Fenel references, closures
-- or partials; holding one grants no authority. Discovery and planning do not
-- invoke it. The current reader checks the input, arguments and callable before
-- explicit execution, and checks the returned data before applying a draft.
--
-- Type-valued sibling fields use a real dependent application. An unresolved
-- application is not admission: the host must resolve these types explicitly
-- before using the existing value/signature checker (the generic validator's
-- historical unresolved-$el fallback is insufficient at this boundary).

lensShortcutDataType : (dataType: Type) -> Type
lensShortcutDataType dataType = dataType

-- The existing signature catalogue supplies admitted Type values and their
-- identities. This module never synthesizes the host's dollar-key type codec.
-- callableType is checked against the input/arguments/result association by
-- the existing callable checker before invocation; it is not a new decider.
LensRecipeTypes = LensRecipeTypes inputType: Type argumentsType: Type resultType: Type callableType: Type

@label "Shortcut recipe"
@description "An ordinary Fenel callable with its precise input, arguments and result types. Arguments are typed data edited through the shared data editor; callable composition stays in Fenel. Resolve dependent fields and validate them under the current reader before execution."
LensFunctionRecipe = LensFunctionRecipe inputType: Type argumentsType: Type resultType: Type callableType: Type callable: lensShortcutDataType callableType arguments: lensShortcutDataType argumentsType

LensShortcutSubject = CurrentDataSubject | ProducerExpressionSubject

LensShortcutDisposition = PresentExistingData | ApplyToDraft | CreateDerivedData

LensShortcutOperation = PresentLensSubject subject: LensShortcutSubject | InvokeLensRecipe recipe: LensFunctionRecipe

@label "Lens shortcut"
@description "A saved operation, explicit destination and optional presentation. Data, Expression and Code are default recipes over the selected subject; authored functions use the same shortcut data."
LensShortcut = LensShortcut id: String label: String icon: String operation: LensShortcutOperation disposition: LensShortcutDisposition presentation: Maybe WorkspacePresentation

@label "Typed lens subject"
@description "Ordinary typed data presented by a lens, with its original source and focus retained. The data is checked again under the current reader; the source and focus describe provenance and grant no access."
LensTypedSubject = LensTypedSubject dataType: Type data: lensShortcutDataType dataType originSource: WorkspaceSource originFocus: WorkspaceFocus producer: Maybe Expr producerInput: Maybe String producerBinding: Maybe Expr

-- The core producer names an input whose live binding is the original focus;
-- it is not a frozen literal copy of that source's currently observed data.
lensShortcutProducerInput : String
lensShortcutProducerInput = "lensShortcutSource"

-- These are plans, not commands carrying host power. The browser interprets
-- the selected plan through its existing reader, draft and lens boundaries.
LensShortcutPlan = SelectLensSubject subject: LensShortcutSubject presentation: Maybe WorkspacePresentation | PrepareLensRecipe recipe: LensFunctionRecipe disposition: LensShortcutDisposition presentation: Maybe WorkspacePresentation

@label "Default lens shortcuts"
@description "Data selects the current subject, Expression its retained producer, and Code that producer's textual presentation. Code remains available as a normal presentation of any selected data."
defaultLensShortcuts : List LensShortcut
defaultLensShortcuts = [
  LensShortcut { id = "data", label = "Data", icon = "package", operation = PresentLensSubject { subject = CurrentDataSubject }, disposition = PresentExistingData, presentation = Nothing },
  LensShortcut { id = "expression", label = "Expression", icon = "route", operation = PresentLensSubject { subject = ProducerExpressionSubject }, disposition = PresentExistingData, presentation = Nothing },
  LensShortcut { id = "code", label = "Code", icon = "code", operation = PresentLensSubject { subject = ProducerExpressionSubject }, disposition = PresentExistingData, presentation = Just CodePresentation }
]

@label "Plan lens shortcut"
@description "Plan an explicitly selected saved shortcut using the existing current-reader input and draft admission verdicts. An undecided judgment stays refused. Planning never executes a callable or reads data."
lensShortcutPlan : LensShortcut -> Maybe Bool -> Maybe Bool -> Result String LensShortcutPlan
lensShortcutPlan shortcut inputAdmission draftAdmission =
  case shortcut.operation of
    PresentLensSubject { subject = subject } -> case shortcut.disposition of
      PresentExistingData -> Ok (SelectLensSubject { subject = subject, presentation = shortcut.presentation })
      _ -> Err "A presentation shortcut keeps the existing data. Choose an operation to create or edit data."
    InvokeLensRecipe { recipe = recipe } -> case inputAdmission of
      Just true -> lensShortcutAdmittedPlan shortcut recipe draftAdmission
      Just false -> Err "This shortcut does not accept the selected data."
      _ -> Err "The shortcut's input type could not be checked."

lensShortcutAdmittedPlan : LensShortcut -> LensFunctionRecipe -> Maybe Bool -> Result String LensShortcutPlan
lensShortcutAdmittedPlan shortcut recipe draftAdmission =
  case shortcut.disposition of
    PresentExistingData -> Err "An operation creates or edits data. Choose its destination."
    ApplyToDraft -> case draftAdmission of
      Just true -> Ok (PrepareLensRecipe { recipe = recipe, disposition = ApplyToDraft, presentation = shortcut.presentation })
      Just false -> Err "This shortcut's result cannot replace the current draft. Create derived data instead."
      _ -> Err "The shortcut's result type could not be checked against this draft."
    CreateDerivedData -> Ok (PrepareLensRecipe { recipe = recipe, disposition = CreateDerivedData, presentation = shortcut.presentation })

@label "Check typed lens subject"
@description "Retain a typed subject only after the existing current-reader checker admits its resolved data type. Unreadable or undecided data stays unavailable."
lensTypedSubjectAdmission : LensTypedSubject -> Maybe Bool -> Result String LensTypedSubject
lensTypedSubjectAdmission subject admission =
  case admission of
    Just true -> Ok subject
    Just false -> Err "The lens data does not fit its declared type."
    _ -> Err "The lens data could not be checked for this reader."

@label "Check lens subject origin"
@description "Match a held subject's source and original focus with the lens's current coordinates. This keeps retained typed data attached to the data it came from; equality grants no authority and the current reader still revalidates the datum."
lensTypedSubjectOriginAdmission : LensTypedSubject -> WorkspaceSource -> WorkspaceFocus -> Bool
lensTypedSubjectOriginAdmission subject source focus =
  workspaceSourceEqual subject.originSource source && workspaceFocusEqual subject.originFocus focus

lensShortcutInputType : LensFunctionRecipe -> Type
lensShortcutInputType recipe = recipe.inputType

lensShortcutResultType : LensFunctionRecipe -> Type
lensShortcutResultType recipe = recipe.resultType

@label "Run lens recipe"
@description "Apply the admitted ordinary callable to the selected data and authored arguments. Explicit execution uses the current reader frame; argument editing and shortcut discovery never call this function."
lensShortcutRun : (recipe: LensFunctionRecipe) -> (data: lensShortcutInputType recipe) -> lensShortcutResultType recipe
lensShortcutRun recipe data = recipe.callable data recipe.arguments

lensShortcutWithDisposition : LensShortcut -> LensShortcutDisposition -> LensShortcut
lensShortcutWithDisposition shortcut disposition =
  LensShortcut { id = shortcut.id, label = shortcut.label, icon = shortcut.icon, operation = shortcut.operation, disposition = disposition, presentation = shortcut.presentation }

-- Only callable shortcuts have arguments. The recipe itself owns their type;
-- presentation-only shortcuts have no fabricated Unit argument package.
lensShortcutWithRecipeArguments : (recipe: LensFunctionRecipe) -> (arguments: lensShortcutRecipeArgumentsType recipe) -> LensFunctionRecipe
lensShortcutWithRecipeArguments recipe arguments =
  LensFunctionRecipe { inputType = recipe.inputType, argumentsType = recipe.argumentsType, resultType = recipe.resultType, callableType = recipe.callableType, callable = recipe.callable, arguments = arguments }

lensShortcutRecipeArgumentsType : LensFunctionRecipe -> Type
lensShortcutRecipeArgumentsType recipe = recipe.argumentsType

@label "Check shortcut argument roundtrip"
@description "Refuse a callable argument package when the existing expression codec loses ordinary data while lifting and lowering it. This compares data; it does not run the callable."
lensShortcutArgumentsPreserved : (recipe: LensFunctionRecipe) -> (decoded: lensShortcutRecipeArgumentsType recipe) -> Bool
lensShortcutArgumentsPreserved recipe decoded = eq recipe.arguments decoded

lensShortcutWithRecipe : LensShortcut -> LensFunctionRecipe -> LensShortcut
lensShortcutWithRecipe shortcut recipe =
  case shortcut.operation of
    PresentLensSubject { subject = subject } -> shortcut
    InvokeLensRecipe -> LensShortcut { id = shortcut.id, label = shortcut.label, icon = shortcut.icon, operation = InvokeLensRecipe { recipe = recipe }, disposition = shortcut.disposition, presentation = shortcut.presentation }

@label "Reverse"
@description "Reverse the character list through the standard list operation, then return its String representation. The extra nullary argument gives unary functions the same typed recipe shape as functions with editable arguments."
@icon "repeat"
lensTextReverse : String -> LensNoArguments -> String
lensTextReverse data arguments = join (reverse (chars data)) ""

@label "Uppercase"
@description "Use the standard Unicode uppercase operation."
@icon "type"
lensTextUppercase : String -> LensNoArguments -> String
lensTextUppercase data arguments = upper data

@label "Uppercase then reverse"
@description "An authored Fenel composition of uppercase, list reversal and joining individual Unicode code points. Inspect or replace its callable through the universal data editor."
@icon "function"
lensTextUppercaseThenReverse : String -> LensNoArguments -> String
lensTextUppercaseThenReverse data arguments = join (reverse (chars (upper data))) ""

@label "Split"
@description "Split at an authored literal delimiter; the result is List String and remains separate derived data. Edit the delimiter with the shared typed argument editor."
@icon "list"
lensTextSplit : String -> LensTextSplitArguments -> List String
lensTextSplit data arguments = split data arguments.delimiter

LensTextSplitArguments = LensTextSplitArguments delimiter: String

LensNoArguments = LensNoArguments

lensShortcutTextRecipe : LensRecipeTypes -> (callable: String -> LensNoArguments -> String) -> LensFunctionRecipe
lensShortcutTextRecipe types callable =
  LensFunctionRecipe { inputType = types.inputType, argumentsType = types.argumentsType, resultType = types.resultType, callableType = types.callableType, callable = callable, arguments = LensNoArguments }

lensShortcutTextSplitRecipe : LensRecipeTypes -> LensFunctionRecipe
lensShortcutTextSplitRecipe types =
  let arguments = LensTextSplitArguments { delimiter = "," }
  LensFunctionRecipe { inputType = types.inputType, argumentsType = types.argumentsType, resultType = types.resultType, callableType = types.callableType, callable = lensTextSplit, arguments = arguments }

@label "Text utility shortcuts"
@description "Saved ordinary shortcuts for one String utility: Reverse, Uppercase, an authored composition and type-changing Split with an editable delimiter. All start as separate derived data; the user may select a checked draft replacement."
textLensShortcuts : (reverseTypes: LensRecipeTypes) -> (uppercaseTypes: LensRecipeTypes) -> (composedTypes: LensRecipeTypes) -> (splitTypes: LensRecipeTypes) -> List LensShortcut
textLensShortcuts reverseTypes uppercaseTypes composedTypes splitTypes = [
  LensShortcut { id = "reverse", label = "Reverse", icon = "repeat", operation = InvokeLensRecipe { recipe = lensShortcutTextRecipe reverseTypes lensTextReverse }, disposition = CreateDerivedData, presentation = Nothing },
  LensShortcut { id = "uppercase", label = "Uppercase", icon = "type", operation = InvokeLensRecipe { recipe = lensShortcutTextRecipe uppercaseTypes lensTextUppercase }, disposition = CreateDerivedData, presentation = Nothing },
  LensShortcut { id = "uppercase-reverse", label = "Uppercase then reverse", icon = "function", operation = InvokeLensRecipe { recipe = lensShortcutTextRecipe composedTypes lensTextUppercaseThenReverse }, disposition = CreateDerivedData, presentation = Nothing },
  LensShortcut { id = "split", label = "Split", icon = "list", operation = InvokeLensRecipe { recipe = lensShortcutTextSplitRecipe splitTypes }, disposition = CreateDerivedData, presentation = Just ListPresentation }
]
