module view where

using std (OrdinaryMap, head, tail, fromMaybe, concat, count, all, isNumber, isString, toString, entries, filter, map, join, startsWith, not, fold, appendItem)
using time (CalendarDate, encodeCalendarDate)

-- Calendar placement of date groups (typed grouping, 2026-11-06).
-- A derived Calendar shows each group of a decided OrdinaryMap keyed by
-- CalendarDate on its own day. The day text is the CalendarDate codec's
-- YYYY-MM-DD (no time, no timezone); year/month let the renderer open on the
-- month of the earliest group. The data owns every date: the projection never
-- stores, drags or overrides a placement. Any other value (an undecided
-- grouping, a non-date key) is an explicit Err, so the Calendar is not offered.
-- calendarDayPlacementsFrom and groupingBarsFrom are host-iterated (std fold):
-- the interpreter has no tail calls, and their former self-calls nested once
-- per entry, past a browser worker's stack near 170 days or bars (Nov 11).

CalendarDayPlacement = CalendarDayPlacement day: String year: Int month: Int entry: Number

@label "Calendar days of date groups"
@description "Place each date group on its calendar day: the day is the group's Calendar Date key written as YYYY-MM-DD by the Calendar Date codec, with no time or timezone, plus its year and month. Err when the grouping was not decided or a key is not a valid Calendar Date."
calendarDayPlacements : (groups: Maybe (OrdinaryMap CalendarDate v)) -> Result String (List CalendarDayPlacement)
calendarDayPlacements groups =
  case groups of
    Nothing -> Err "The grouping could not be decided."
    Just found -> calendarDayPlacementsFrom found.entries 0
    _ -> Err "Only a grouping by Calendar Date has calendar days."

@label "Calendar days of date group entries"
@description "Place each { key, value } entry on the day of its Calendar Date key, numbering entries from the given index. Err at the first key that is not a valid Calendar Date. Internal helper."
calendarDayPlacementsFrom : (entries: List ({ key: CalendarDate, value: v })) -> (index: Number) -> Result String (List CalendarDayPlacement)
calendarDayPlacementsFrom entries index = fold (calendarDayPlacementStep index) (Ok []) entries

@label "Calendar day of one date group entry"
@description "Place one { key, value } entry after the placements so far, numbered from the given index; keep the first Err, and turn a key that is not a valid Calendar Date into an Err. Internal helper."
calendarDayPlacementStep : (index: Number) -> (placed: Result String (List CalendarDayPlacement)) -> (entry: { key: CalendarDate, value: v }) -> Result String (List CalendarDayPlacement)
calendarDayPlacementStep index placed entry =
  case placed of
    Ok done ->
      case encodeCalendarDate entry.key of
        Err message -> Err message
        Ok day ->
          let position = index + count done
          Ok (appendItem (CalendarDayPlacement { day = day, year = entry.key.year, month = entry.key.month, entry = position }) done)
        _ -> Err "Only a grouping by Calendar Date has calendar days."
    _ -> placed

-- Recommended presentation of a grouped value (typed grouping M9, 2026-11-06).
-- The value itself carries the recommendation: a decided grouping keyed by
-- Calendar Dates is shown on a Calendar, a grouping whose values are all
-- numbers (a count or a sum per key) as a bar chart labelled by its keys, and
-- any other decided grouping as a table of its entries. Anything else is not a
-- grouping, and the ordinary lenses apply.

GroupingBar = GroupingBar label: String value: Number entry: Number

GroupingPresentation = GroupingCalendar days: List CalendarDayPlacement | GroupingBars bars: List GroupingBar | GroupingTable size: Number | NotAGrouping

@label "Presentation of a grouping"
@description "Recommend how to show a grouped value: Calendar for Calendar Date keys, a bar chart when every value is a number, otherwise a table of its entries. NotAGrouping for any value that is not a decided grouping."
groupingPresentation : (value: a) -> GroupingPresentation
groupingPresentation value =
  case value of
    Just found -> case found of
      OrdinaryMap { entries = groups } -> groupingPresentationOf value groups
      _ -> NotAGrouping
    _ -> NotAGrouping

@label "Presentation of grouping entries"
@description "The recommendation for a decided grouping's entries. Internal helper."
groupingPresentationOf : (value: a) -> (groups: List ({ key: k, value: v })) -> GroupingPresentation
groupingPresentationOf value groups =
  case calendarDayPlacements value of
    Ok days -> if count days > 0 then GroupingCalendar { days = days } else groupingPresentationPlain groups
    _ -> groupingPresentationPlain groups

@label "Plain grouping presentation"
@description "Bars when there is at least one entry and every value is a number, otherwise a table. Internal helper."
groupingPresentationPlain : (groups: List ({ key: k, value: v })) -> GroupingPresentation
groupingPresentationPlain groups =
  if count groups > 0 && all groups (\entry -> isNumber entry.value)
  then GroupingBars { bars = groupingBarsFrom groups 0 }
  else GroupingTable { size = count groups }

@label "Bars of a numeric grouping"
@description "One bar per entry, labelled by its key, numbering entries from the given index. Internal helper."
groupingBarsFrom : (groups: List ({ key: k, value: v })) -> (index: Number) -> List GroupingBar
groupingBarsFrom groups index = fold (\bars entry -> appendItem (GroupingBar { label = groupingKeyCaption entry.key, value = entry.value, entry = index + count bars }) bars) [] groups

-- Q10 (Rom, Nov 8): a record key reads by a STRUCTURAL default, its first
-- text field (a Person by its name), never a hard-coded type. A Show-like class
-- with per-type short labels is the deferred value-parametric representations arc.
@label "Caption of a grouping key"
@description "A short caption for a key: text as itself, a number as its decimal text, a Calendar Date as YYYY-MM-DD, and a record as its first text field in field order (identity fields such as $tag are skipped); a record without a text field has an empty caption."
groupingKeyCaption : (key: a) -> String
groupingKeyCaption key =
  if isString key then key
  else if isNumber key then toString key
  else case encodeCalendarDate key of
    Ok day -> day
    _ -> case head (filter (\field -> isString field.value && not (startsWith field.key "$")) (entries key)) of
      Just field -> field.value
      _ -> ""

-- A decided grouping reads as its recommended presentation in any card or
-- preview (polish lane B 7a): the registered "grouping" read component asks
-- groupingPresentation for a miniature calendar, bars or key rows.
_ : Viewable OrdinaryMap
_ = Viewable { defaultView = "grouping", defaultInlineView = "grouping" }
