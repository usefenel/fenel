module view where

import std (add, and, at, elem, eq, floor, fold, gte, isNumber, join, length, lt, not, numberIsFinite, or, toString)

-- The caller supplies only members already admitted by the current reader.
-- Names and aliases are presentation facts, not new identities or authority.
-- position is the zero-based position in the original container; a decimal
-- address spells it one-based. The returned index belongs to this member list.

addressPositionValid : Number -> Boolean
addressPositionValid position =
  isNumber position && numberIsFinite position && position >= 0 && position < 9007199254740991 && eq position (floor position)

addressMemberMatches : ({ id: String, name: String, aliases: List String, position: Number }) -> String -> Boolean -> Boolean
addressMemberMatches member segment allowPosition =
  if eq segment "" then false
  else
    let named = not (eq member.name "") && eq member.name segment
    let identified = not (eq member.id "") && eq segment (join ["_", member.id] "")
    let positioned = allowPosition && addressPositionValid member.position && eq segment (toString (member.position + 1))
    named || elem segment member.aliases || identified || positioned

addressMemberIndexStep : String -> Boolean -> ({ index: Number, count: Number, selected: Number }) -> ({ id: String, name: String, aliases: List String, position: Number }) -> ({ index: Number, count: Number, selected: Number })
addressMemberIndexStep segment allowPosition state member =
  if addressMemberMatches member segment allowPosition then
    { index = state.index + 1, count = state.count + 1, selected = state.index }
  else
    { index = state.index + 1, count = state.count, selected = state.selected }

@label "Find addressed data"
@description "Select one reader-visible member by its exact name, alias or underscored identity. A list may additionally admit a canonical one-based decimal position. Return its zero-based index in the supplied member list; missing and ambiguous segments are refused. No data or callable is evaluated."
@tags "view" "address"
addressMemberIndex : List ({ id: String, name: String, aliases: List String, position: Number }) -> String -> Boolean -> Result String Number
addressMemberIndex members segment allowPosition =
  let found = fold (addressMemberIndexStep segment allowPosition) { index = 0, count = 0, selected = 0 } members
  if eq found.count 1 then Ok found.selected
  else if eq found.count 0 then Err "There is no readable data at this address."
  else Err "This address names more than one item."

addressSegmentSelects : List ({ id: String, name: String, aliases: List String, position: Number }) -> Number -> String -> Boolean -> Boolean
addressSegmentSelects members index segment allowPosition =
  case addressMemberIndex members segment allowPosition of
    Ok selected -> eq selected index
    Err message -> false

addressMemberFallbackSegment : List ({ id: String, name: String, aliases: List String, position: Number }) -> Number -> Boolean -> ({ id: String, name: String, aliases: List String, position: Number }) -> Result String String
addressMemberFallbackSegment members index allowPosition member =
  if not (eq member.id "") then
    let segment = join ["_", member.id] ""
    if addressSegmentSelects members index segment allowPosition then Ok segment
    else Err "This data identity does not have an unambiguous address."
  else if eq member.name "" && allowPosition && addressPositionValid member.position then
    let segment = toString (member.position + 1)
    if addressSegmentSelects members index segment allowPosition then Ok segment
    else Err "This list position does not have an unambiguous address."
  else Err "This data has no unambiguous name or identity."

@label "Address of data"
@description "Prefer a member's unique current name, otherwise its unique underscored identity. A nameless and unidentified list member may use its one-based position. Every emitted segment resolves back to the same supplied member; ambiguous or invalid coordinates are refused. Percent encoding belongs to the transport boundary."
@tags "view" "address"
addressMemberSegment : List ({ id: String, name: String, aliases: List String, position: Number }) -> Number -> Boolean -> Result String String
addressMemberSegment members index allowPosition =
  if not (addressPositionValid index) || index >= length members then Err "This data position is unavailable."
  else
    let member = at members index
    if not (eq member.name "") && not (eq member.name ".") && not (eq member.name "..") && addressSegmentSelects members index member.name allowPosition then Ok member.name
    else addressMemberFallbackSegment members index allowPosition member
