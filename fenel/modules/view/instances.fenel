-- Ordinary related data selects its presentation through scoped Viewable.
using system (Expr)
dependencyGraphViewable : Viewable DependencyGraph
dependencyGraphViewable = Viewable { defaultView = "dependency-graph", defaultInlineView = "dependency-graph" }

suggestionPresentationViewable : Viewable SuggestionPresentation
suggestionPresentationViewable = Viewable { defaultView = "suggestion-card", defaultInlineView = "suggestion-card" }

_ : Viewable WorkspacePresentationTarget
_ = Viewable { defaultView = "data-thumbnail", defaultInlineView = "data-thumbnail" }

_ : Viewable ClipboardEntry
_ = Viewable { defaultView = "clipboard-entry", defaultInlineView = "clipboard-entry" }

-- Returned expression data selects an inert inspection body. The Expression
-- shortcut continues to select the producer of the surrounding data.
_ : Viewable Expr
_ = Viewable { defaultView = "returned-expression", defaultInlineView = "returned-expression" }
