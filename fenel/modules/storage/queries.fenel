module storage where

-- The Memory query uses the same JSON containment relation as Db's @>.
-- Arrays are unordered for containment; duplicate query members need not
-- consume distinct stored members. The top-level scalar-in-array exception
-- must not skip nesting levels inside object values or array elements.
@label "JSON containment"
@description "Containment over canonical JsonValue data, matching the JSONB object and array query relation."
@tags "storage" "query" "pure"
jsonContains : JsonValue -> JsonValue -> Boolean
jsonContains actual expected =
  case expected of
    JsonObject { pairs = wanted } ->
      case actual of
        JsonObject { pairs = present } -> all wanted (\entry -> jsonContainsEntry present entry)
        _ -> False
    JsonArray { items = wanted } ->
      case actual of
        JsonArray { items = present } -> all wanted (\item -> some present (\candidate -> jsonNestedContains candidate item))
        _ -> False
    _ -> jsonRootScalarContains actual expected

jsonRootScalarContains : JsonValue -> JsonValue -> Boolean
jsonRootScalarContains actual expected =
  case actual of
    JsonArray { items = present } -> some present (\candidate -> jsonScalarEqual candidate expected)
    _ -> jsonScalarEqual actual expected

jsonContainsEntry : [JsonObjectEntry] -> JsonObjectEntry -> Boolean
jsonContainsEntry present wanted =
  case findPair present wanted.key of
    Nothing -> False
    Just actual -> jsonNestedContains actual wanted.value

jsonNestedContains : JsonValue -> JsonValue -> Boolean
jsonNestedContains actual expected =
  case expected of
    JsonObject { pairs = _ } -> jsonContains actual expected
    JsonArray { items = _ } -> jsonContains actual expected
    _ -> jsonScalarEqual actual expected

jsonScalarEqual : JsonValue -> JsonValue -> Boolean
jsonScalarEqual actual expected =
  case actual of
    JsonArray { items = _ } -> False
    JsonObject { pairs = _ } -> False
    _ -> actual == expected
