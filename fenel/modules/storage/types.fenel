-- =========================================================================
-- Storage — descriptor declarations for the three StorageHandler backends.
--
-- Landing 1 A2 moves the backend method names out of TypeScript dictionaries.
-- These 24 bodyless foreign declarations are the descriptor authority; their
-- irreducible host-IO implementations live in ffi/storage-ffi.ts.  They carry
-- HasStateIO requirements so runtime registration puts the implementations in
-- the single perform table rather than exposing callables as Fenel values.
--
-- rights R2b (declaration rider, PARAMETER HALF ONLY).  `data` and `filter`
-- were the empty record `{ }`, which DECLARES "a record with no fields" while
-- the runtime passes an arbitrary `Record<string, unknown>`.  That is the
-- placeholder-return lie the IO-handler conventions forbid, in parameter
-- position.  `Map String Any` is what the host carrier already is, so the
-- change is declaration-only: zero marshalling moves.
--
-- The RETURN placeholders (`Maybe ({ })` x12, `[{ }]` x3) are DEFERRED with the
-- reason stated rather than left silent: the honest return is a declared
-- `StoredRow` whose `createdAt` / `updatedAt` are host `Date`s at the FFI
-- boundary, and declaring one risks a `WitnessedEscape` in
-- `signature-honesty-claims.json` that must then be repaired atomically --
-- signature AND value.  That is a storage-owned slice, not a rider on an
-- authority phase.
-- =========================================================================

module storage where

-- ----- PostgreSQL ---------------------------------------------------------

@native
@label "DB store"
@description "Store an entity-instance row in PostgreSQL using an already-minted id."
@tags "storage" "io" "db"
@requires "HasStateIO"
dbStore : (accountId: String) -> (entityType: String) -> (data: Map String Any) -> (id: String) -> { id: String }

@native
@label "DB load"
@description "Load an entity-instance row by account and instance id from PostgreSQL."
@tags "storage" "io" "db"
@requires "HasStateIO"
dbLoad : (accountId: String) -> (instanceId: String) -> Maybe ({  })

@native
@label "DB update"
@description "Replace an entity-instance row's data in PostgreSQL, returning Nothing on a miss."
@tags "storage" "io" "db"
@requires "HasStateIO"
dbUpdate : (accountId: String) -> (instanceId: String) -> (data: Map String Any) -> Maybe ({  })

@native
@label "DB delete"
@description "Delete an entity-instance row by account and instance id from PostgreSQL."
@tags "storage" "io" "db"
@requires "HasStateIO"
dbDelete : (accountId: String) -> (instanceId: String) -> Unit

@native
@label "DB list"
@description "List PostgreSQL entity-instance rows for an account and entity type."
@tags "storage" "io" "db"
@requires "HasStateIO"
dbList : (accountId: String) -> (entityType: String) -> (limit: Maybe (Number)) -> (filter: Maybe (Map String Any)) -> [{  }]

@native
@label "DB append event"
@description "Append a typed event to the PostgreSQL event log."
@tags "storage" "io" "db"
@requires "HasStateIO"
dbAppendEvent : (event: { accountId: String, type: String, payload: Maybe ({  }), aggregateType: Maybe (String), aggregateId: Maybe (String), profileId: Maybe (String) }) -> Unit

@native
@label "DB load type"
@description "Load a registered type definition by account and id from PostgreSQL."
@tags "storage" "io" "db"
@requires "HasStateIO"
dbLoadType : (accountId: String) -> (typeId: String) -> Maybe ({  })

@native
@label "DB load type by name"
@description "Load a registered type definition by account and name from PostgreSQL."
@tags "storage" "io" "db"
@requires "HasStateIO"
dbLoadTypeByName : (accountId: String) -> (name: String) -> Maybe ({  })

-- ----- In-process memory --------------------------------------------------

@native
@label "Memory store"
@description "Store an entity-instance row in the active in-process memory store."
@tags "storage" "io" "memory"
@requires "HasStateIO"
memoryStore : (accountId: String) -> (entityType: String) -> (data: Map String Any) -> (id: String) -> { id: String }

@native
@label "Memory load"
@description "Load an in-process entity-instance row by account and instance id."
@tags "storage" "io" "memory"
@requires "HasStateIO"
memoryLoad : (accountId: String) -> (instanceId: String) -> Maybe ({  })

@native
@label "Memory update"
@description "Replace an in-process entity-instance row's data, returning Nothing on a miss."
@tags "storage" "io" "memory"
@requires "HasStateIO"
memoryUpdate : (accountId: String) -> (instanceId: String) -> (data: Map String Any) -> Maybe ({  })

@native
@label "Memory delete"
@description "Delete an in-process entity-instance row by account and instance id."
@tags "storage" "io" "memory"
@requires "HasStateIO"
memoryDelete : (accountId: String) -> (instanceId: String) -> Unit

@native
@label "Memory list"
@description "List in-process entity-instance rows for an account and entity type."
@tags "storage" "io" "memory"
@requires "HasStateIO"
memoryList : (accountId: String) -> (entityType: String) -> (limit: Maybe (Number)) -> (filter: Maybe (Map String Any)) -> [{  }]

@native
@label "Memory append event"
@description "Append a typed event to the in-process event log."
@tags "storage" "io" "memory"
@requires "HasStateIO"
memoryAppendEvent : (event: { accountId: String, type: String, payload: Maybe ({  }), aggregateType: Maybe (String), aggregateId: Maybe (String), profileId: Maybe (String) }) -> Unit

@native
@label "Memory load type"
@description "Load an in-process system or module type definition by id."
@tags "storage" "io" "memory"
@requires "HasStateIO"
memoryLoadType : (accountId: String) -> (typeId: String) -> Maybe ({  })

@native
@label "Memory load type by name"
@description "Load an in-process system or module type definition by name."
@tags "storage" "io" "memory"
@requires "HasStateIO"
memoryLoadTypeByName : (accountId: String) -> (name: String) -> Maybe ({  })

-- ----- Bundled reference register ----------------------------------------

@native
@label "Bundle store"
@description "Reject writes to the read-only bundled reference register."
@tags "storage" "io" "bundle"
@requires "HasStateIO"
bundleStore : (accountId: String) -> (entityType: String) -> (data: Map String Any) -> (id: String) -> { id: String }

@native
@label "Bundle load"
@description "Load a bundled reference row by account and reference id."
@tags "storage" "io" "bundle"
@requires "HasStateIO"
bundleLoad : (accountId: String) -> (instanceId: String) -> Maybe ({  })

@native
@label "Bundle update"
@description "Reject updates to the read-only bundled reference register."
@tags "storage" "io" "bundle"
@requires "HasStateIO"
bundleUpdate : (accountId: String) -> (instanceId: String) -> (data: Map String Any) -> Maybe ({  })

@native
@label "Bundle delete"
@description "Reject deletes from the read-only bundled reference register."
@tags "storage" "io" "bundle"
@requires "HasStateIO"
bundleDelete : (accountId: String) -> (instanceId: String) -> Unit

@native
@label "Bundle list"
@description "List bundled reference rows for an entity type."
@tags "storage" "io" "bundle"
@requires "HasStateIO"
bundleList : (accountId: String) -> (entityType: String) -> (limit: Maybe (Number)) -> (filter: Maybe (Map String Any)) -> [{  }]

@native
@label "Bundle append event"
@description "Reject event appends to the read-only bundled reference register."
@tags "storage" "io" "bundle"
@requires "HasStateIO"
bundleAppendEvent : (event: { accountId: String, type: String, payload: Maybe ({  }), aggregateType: Maybe (String), aggregateId: Maybe (String), profileId: Maybe (String) }) -> Unit

@native
@label "Bundle load type"
@description "Load a bundled system or module type definition by id."
@tags "storage" "io" "bundle"
@requires "HasStateIO"
bundleLoadType : (accountId: String) -> (typeId: String) -> Maybe ({  })

@native
@label "Bundle load type by name"
@description "Load a bundled system or module type definition by name."
@tags "storage" "io" "bundle"
@requires "HasStateIO"
bundleLoadTypeByName : (accountId: String) -> (name: String) -> Maybe ({  })
