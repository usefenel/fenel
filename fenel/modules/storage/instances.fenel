-- =========================================================================
-- StorageHandler backend instances — pure descriptor data.
--
-- Each method is a reference to one @native declaration in types.fenel
-- (`storage.dbStore`, modules-as-values Phase 2c).  Its two readers, the
-- authority storage index and the storage seam, map a reference only through
-- this module's own declarations, never through a registry.  `scope` is
-- instance-sidecar metadata lifted by loadFenelModule and never appears in the
-- resolved method dictionary.
-- =========================================================================

storageDb : StorageHandler "Db"
storageDb = StorageHandler { store = storage.dbStore, load = storage.dbLoad, update = storage.dbUpdate, delete = storage.dbDelete, list = storage.dbList, appendEvent = storage.dbAppendEvent, loadType = storage.dbLoadType, loadTypeByName = storage.dbLoadTypeByName, scope = "global" }

storageMemory : StorageHandler "Memory"
storageMemory = StorageHandler { store = storage.memoryStore, load = storage.memoryLoad, update = storage.memoryUpdate, delete = storage.memoryDelete, list = storage.memoryList, appendEvent = storage.memoryAppendEvent, loadType = storage.memoryLoadType, loadTypeByName = storage.memoryLoadTypeByName, scope = "global" }

storageBundle : StorageHandler "Bundle"
storageBundle = StorageHandler { store = storage.bundleStore, load = storage.bundleLoad, update = storage.bundleUpdate, delete = storage.bundleDelete, list = storage.bundleList, appendEvent = storage.bundleAppendEvent, loadType = storage.bundleLoadType, loadTypeByName = storage.bundleLoadTypeByName, scope = "global" }
