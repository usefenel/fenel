-- =========================================================================
-- module social where — social platform functions (crosspost + engagement).
--
-- typed-function-references · FenelModule-retirement Phase FM-retire-3. The 2
-- `defineFunction` specs in `engine/src/modules/social.ts` are RETIRED in favour
-- of these decls + a thin seam. This file CONSOLIDATES the former standalone
-- `engagement-score.fenel` (now DELETED — least churn: one `module social where`
-- source, like `license` consolidating `compute-rev-share.fenel`).
--
-- NO-CORNER-CUT FIX (Decision 2): `crosspost`'s return was the empty-record
-- placeholder `{ results: [ {} ] }` (a `List` of `{$record:{fields:[]}}` — the
-- "shape resolved at runtime" anti-pattern, 1 of the standing 94). It is now the
-- real `{ results: [CrosspostResult] }` over a declared `CrosspostResult` record
-- — chipping it off the placeholder baseline (94 → 93). `crosspost` is bodyless
-- in the retired spec (signature-only `defineFunction`, no body / no ioAction) →
-- `@native` emits the same bodyless function; the per-target IO wiring is
-- Decision-0-D build-out, deferred.
--
-- `SocialTarget` is `crosspost`'s `targets`-element refinement extracted to a
-- top-level named atom — the canonical path-(b) workaround (the parser rejects
-- inline `String | value ∈ {…}` at PARAM position; it is a type-decl-level form
-- only — the SAME extraction `RenderFormat` / `HeadingLevel` use in `templates`).
-- The resulting `{$refined:{base:String, set:$enum […]}}` is byte-identical to
-- the retired spec's inline `targets` element type.
--
-- Identity parity: each fn carried label + description + category="social" +
-- tags. NO `@category` (derives from the `social:` id prefix, Phase 3j);
-- `@label`/`@description`/`@tags` reproduce the rest. Param labels DROP (no
-- directive — the universal delta). The empty `default: Nothing` boilerplate
-- VANISHES (no live param-defaults; NO `@default`).
-- =========================================================================

module social where

-- SocialTarget — the crosspost target-platform selector. Extracted named atom
-- (path-(b)); inline `|`-refinement does not parse at param position.
SocialTarget = String | value ∈ {"twitter", "telegram", "instagram"}

-- CrosspostResult — one per-target outcome of a crosspost. (`PostId` is a
-- held-gap referent — see typeclasses.fenel.)
CrosspostResult = CrosspostResult platform: String post_id: PostId ok: Boolean

-- crosspost — post content to multiple platforms. FenelCheck narrows body
-- constraints per target (a 500-char body to Twitter is a type error). Bodyless
-- `@native` dispatch stub (signature-only in the retired spec).
@native
@label "Crosspost"
@description "Post content to multiple platforms. FenelCheck narrows body constraints per target — 500-char body to Twitter is a type error."
@tags "social" "crosspost"
crosspost : (body: String) -> (images: Maybe [String]) -> (targets: [SocialTarget]) -> { results: [CrosspostResult] }

-- engagement-score — ts-elimination-completion Phase 6 port (body unchanged).
--
-- The lone genuine-portable body on the `social` module: pure arithmetic
-- + a single `if`, no type-reflection, no recursion. Previously inline
-- JSON-Logic in modules/social.ts (`body: { if: [ … ] }`); moved here so
-- the `.fenel` text is the source of truth.
--
-- Faithful port of the TS oracle:
--   views > 0  ?  (likes + comments*3) / views  :  likes + comments*3
-- `views` is Maybe<Number> in the spec; the oracle reads `views > 0`
-- directly (JS coercion), so Nothing / absent / 0 all fall to the
-- else-branch. `gt views 0` reproduces that comparison verbatim — the
-- round-trip test (engagement-score.test.ts) pins parity across
-- views>0 / views=0 / views absent / zero-comments inputs.
@label "Engagement Score"
@description "Compute engagement score from metrics. Works on any platform — uses row polymorphism (only needs likes + comments/replies)."
@tags "social" "pure" "analytics"
engagement_score : (likes: Number) -> (comments: Number) -> (views: Maybe Number) -> Number
engagement_score likes comments views =
  if gt views 0
  then div (add likes (mul comments 3)) views
  else add likes (mul comments 3)
