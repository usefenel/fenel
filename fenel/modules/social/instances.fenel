-- =========================================================================
-- module social where — the 4 Social/Conversational dispatch instances.
--
-- typed-function-references · FenelModule-retirement Phase FM-retire-3. The 4
-- hand-written `ClassInstance` consts in `engine/src/modules/social.ts`
-- (`twitterInstance` / `twitterConversational` / `telegramInstance` /
-- `instagramInstance`) are RETIRED in favour of these `.fenel` value-decls,
-- loaded with `dispatchInstanceFile: true` (the templates `instances.fenel`
-- shape). Each `name : <Class> <platform>` + `name = <Class> { method = handle }`
-- projects to the `ClassInstance { typeName, args, methods }` cache shape.
--
-- The method values are DANGLING handles — point-free identifiers naming
-- twitter / telegram / instagram functions that this module does NOT import
-- (they live in `twitter` / `telegram`, separate modules). They lower to the
-- `{$ref:"<codeName>"}` form but resolve to NOTHING module-locally: this is the
-- vision wiring `design/vision/social-communication.md` intends, kept INERT
-- (Decision 4 under Decision-0-A). Wiring them to real IO is Decision-0-D
-- build-out, deferred to a product milestone — NOT this retirement phase. (Making
-- function-reference VALUES fully typed end-to-end is the broader Ref substrate;
-- the `{$ref}` codeName handle is its current projection.) The dispatch oracle
-- (`satisfies("twitter","Social")` / `resolve`) keys on the instance args, not
-- the handle targets, so the instances still project + resolve.
--
-- DROPPED (Decision 3): the retired consts also carried two NON-METHOD metadata
-- keys on the instance bag — `_constraints` (per-platform char-limit refinements
-- written in RETIRED operator-form JSON-Logic `{$where:{"<=":[…]}}` + the
-- `$ref:"List<Image>"` string-encoded-generic shorthand, both retired per
-- AGENTS.md migration 0040) and `_engagement` (a bare `[String]` engagement-field
-- list). Neither is a `Social`/`Conversational` class method, and a grep proved
-- NOTHING reads either key. Carrying retired JSON-Logic forms + dead demo
-- metadata into fresh `.fenel` is the anti-pattern, so both are DROPPED rather
-- than ported. (This is the brief's sanctioned "DROP if provably inert" fork; it
-- supersedes Decision-0-A's "keep _engagement" suggestion on the inert-evidence.)
-- =========================================================================

module social where

-- twitter — base Social capability + Conversational (threaded replies).
twitterSocial : Social "twitter"
twitterSocial = Social { read_post = twitter_get_metrics, create_post = twitter_post_reply, get_metrics = twitter_get_metrics, list_recent = twitter_get_recent }

twitterConversational : Conversational "twitter"
twitterConversational = Conversational { post_reply = twitter_post_reply, get_thread = twitter_get_recent }

-- telegram — base Social capability.
telegramSocial : Social "telegram"
telegramSocial = Social { read_post = telegram_get_message, create_post = telegram_send_message, get_metrics = telegram_get_message_stats, list_recent = telegram_get_recent }

-- instagram — base Social capability.
instagramSocial : Social "instagram"
instagramSocial = Social { read_post = instagram_get_post, create_post = instagram_create_post, get_metrics = instagram_get_metrics, list_recent = instagram_get_recent }
