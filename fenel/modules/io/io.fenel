-- =========================================================================
-- module io where — irreducible runtime IO primitives.
--
-- typed-function-references · FenelModule-retirement Phase FM-retire-1 (the
-- warm-up port). The ~164-LOC TS `defineFunction` spec wrapper
-- (`engine/src/modules/io.ts`) is RETIRED in favour of this `module io where`
-- source + a thin `loadFenelModule` seam — the `control` precedent (a plain
-- bodyless-`@native` module, NO ffi/ leaf, NO nativeImpls map).
--
-- All 8 functions are runtime PRIMITIVES authored as bodyless `@native` FOREIGN
-- DECLARATIONS:
--   - SIX (`read` / `sleep` / `end_function` / `emit` / `call_function` /
--     `http_request`) are evaluator-backed — the durable-function machinery in
--     `runtime/src/evaluator.ts` suspends / handles them; they carry NO
--     `@ioAction` (nothing routes them through an IO-handler key).
--   - TWO (`random_hex` / `env_get`) carry `@ioAction` so the registry's
--     IOInvokable link routes the call to the registered handler
--     (`io.random_hex` / `io.env_get` in `runtime/src/evaluator.ts`). Their
--     codeNames diverge from the snake_case id-suffix (`randomHex` / `envGet`),
--     preserved byte-identically via `@codeName`.
--
-- Identity parity: each fn carried rich `defineFunction` identity (label +
-- description + category="io" + tags). NO `@category` is authored — the `io`
-- category derives at read time from the `io:` id prefix (Phase 3j); `@label` /
-- `@description` / `@tags` reproduce the rest. Per-PARAM labels DROP (no
-- directive expresses them — the `control` Surprise #30 accepted drop). The
-- empty `default: Nothing` boilerplate VANISHES (no `.fenel` syntax emits it);
-- no live param-defaults exist here.
--
-- DYNAMIC-SHAPE PLACEHOLDERS — held honestly, NOT faked (FM-retire-1 no-corner-
-- cut discipline). `read`'s `schema` param + return, `call_function`'s `args` +
-- return, `http_request`'s `headers`/`body` + return, and `emit`'s `payload`
-- are authored `{}` (empty-record), BYTE-IDENTICAL to the retired TS spec. These
-- are genuinely dynamic / dependent shapes (`read`'s return is data DERIVED from
-- the `schema` TYPE param — the dependent-`$el` pattern; `http_request`'s return
-- is dynamic JSON, morally `Map<String, Json>`). Inventing a real type for them
-- under a warm-up would cut a corner; they are a pre-existing standing-baseline
-- concern (the 97 empty-record-placeholder count), tracked in TODO.md for a
-- dedicated type-modeling pass — NOT introduced or worsened by this port.
-- =========================================================================

module io where

-- read — universal input: suspend, await typed data from a source. `schema` is
-- a TYPE param; the return is dynamic data derived from it (dependent-`$el`;
-- held `{}` — see header).
@native
@label "Read"
@description "Universal input. Suspends until typed data arrives from source. Widget derived from schema, channel from source."
@tags "primitive" "input" "suspend"
read : (schema: {}, source: Maybe String, prompt: Maybe String, timeout: Maybe String) -> {}

-- sleep — pure timer delay. Suspends for `duration`, produces no value.
@native
@label "Sleep"
@description "Pure timer delay. Suspends for duration, produces no value."
@tags "primitive" "time" "suspend"
sleep : (duration: String) -> Boolean

-- end_function — terminate the current function instance immediately.
@native
@label "End Function"
@description "Terminate the current function instance immediately."
@tags "primitive" "control"
end_function : Boolean

-- emit — fire a typed event into the event log. `payload` is dynamic (held `{}`).
@native
@label "Emit Event"
@description "Fire a typed event into the event log. Triggers other functions."
@tags "primitive" "event"
emit : (type: String, payload: Maybe ({})) -> Boolean

-- call_function — start a child function instance and wait. `args` + return are
-- dynamic (held `{}`). Prefer calling functions directly by name.
@native
@label "Call Sub-function"
@description "Start a child function instance and wait for it to complete. Prefer calling functions directly by name."
@tags "primitive" "composition" "deprecated"
call_function : (function: String, args: Maybe ({})) -> {}

-- http_request — the irreducible IO primitive for external APIs. `headers` /
-- `body` + return are dynamic JSON (held `{}` — morally `Map<String, Json>`).
@native
@label "HTTP Request"
@description "Make an HTTP request. The irreducible IO primitive for external APIs."
@tags "primitive" "http"
http_request : (url: String, method: Maybe String, headers: Maybe ({}), body: Maybe ({}), timeout: Maybe Number) -> {}

-- random_hex — hex-encoded random bytes (webhook secrets etc). @ioAction routes
-- to the `io.random_hex` handler; codeName `randomHex` diverges from the id.
@native
@codeName "randomHex"
@ioAction "io.random_hex"
@requires "HasRandom"
@label "Random hex bytes"
@description "Generate a hex-encoded random string of `length` bytes (output is `2*length` hex chars). Used for webhook secrets and similar one-shot tokens."
@tags "primitive" "crypto" "random"
random_hex : (length: Int) -> String

-- env_get — read an environment variable. Just<value> when set, Nothing when
-- unset. @ioAction routes to the `io.env_get` handler; codeName `envGet`.
@native
@codeName "envGet"
@ioAction "io.env_get"
@requires "HasIO"
@label "Read env var"
@description "Read an environment variable. Returns Just<value> when set, Nothing when unset. Used by orchestration to pick up runtime config like WEBHOOK_BASE_URL."
@tags "primitive" "env"
env_get : (key: String) -> Maybe String
