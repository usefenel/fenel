-- Animation dispatch instances (typed-function-references Phase 10c).
--
-- Sampleable<Animation> / Renderable<Animation> — entries in the polymorphic
-- sample/render dispatch tables. Authored here as `.fenel` value-decls (NOT TS
-- seam consts) — the Phase-10 loader flip lowers the point-free method ref
-- `sample = sampleAnim` to the dispatch-ready `{$ref:"sampleAnim"}` (codeName
-- handle; the registry's sample/render table resolves it id-or-codeName to the
-- canonical fnId at build time). Loaded with `dispatchInstanceFile: true` so the
-- value-decl projects to a pure dispatch instance, not a by-name function.
sampleableAnimation : Sampleable Animation
sampleableAnimation = Sampleable { sample = sampleAnim }

renderableAnimation : Renderable Animation
renderableAnimation = Renderable { render = renderAnim }

-- Finite frame data uses the existing shared player through the universal
-- typed read surface. Animate remains inspectable without live sampling.
animationViewable : Viewable Animation
animationViewable = Viewable { defaultView = "animation-frames", defaultInlineView = "animation-frames" }

frameSequenceViewable : Viewable FrameSequence
frameSequenceViewable = Viewable { defaultView = "animation-frames", defaultInlineView = "animation-frames" }
