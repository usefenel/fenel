-- =========================================================================
-- Animation — pictures over time. Tagged union with two cases (Frames /
-- Animate) plus a small `FrameSequence` record + four inline closure-
-- construction helpers (`freeze`, `overAnim`, `delayAnim`, `speedAnim`).
--
-- Phase 4g of ts-elimination: this body was previously the inline
-- `const ANIMATION_SRC = \`…\`` template literal at
-- engine/src/modules/animation.ts; extracted verbatim, with the JS
-- template-literal `\\t` lambda escapes collapsed to single-backslash
-- `\t` (the Fenel parser expects the single-backslash form — JS
-- template evaluation was previously doing the unescape at module-
-- load time).
--
-- Records (single constructor, all named fields) may be compact or use
-- indented field continuations. Variants use leading `|` for multiline peers.
-- References to `Time` resolve lazily through the
-- catalog walk; `Time` is declared in the sound module which loads
-- before animation in the SYSTEM_MODULES order in `system-entities.ts`.
--
-- module-substrate Phase 3g (2026-05-30) — animation is a CTX-ONLY composer:
-- the 2 TS natives (sampleAnim / renderAnim) are CTX natives (they re-enter the
-- evaluator to run Animate closures + picture render), now @native FOREIGN
-- DECLARATIONS here with impls in ffi/animation-ffi.ts; the plain `nativeImpls`
-- map is EMPTY (the simpler sub-case picture's both-maps proof already covers).
-- The ffi/ leaf imports picture-ffi's renderNative leaf-to-leaf. `frameSequence`
-- — a PURE Fenel-bodied record-constructor (already `.fenel` since 5b11) —
-- CONSOLIDATES here from the retired `frame-sequence.fenel` sidecar (recipe N6,
-- single-file consolidation, NOT the cross-file UNION frontier). The natives +
-- frameSequence keep their `video` category; the 4 closure helpers keep the
-- module-name `animation` default.
-- =========================================================================

module animation where

Animation = Frames FrameSequence | Animate (Time -> Picture)

FrameSequence = FrameSequence fps: Number frames: [Image]

-- ----- Foreign declarations (native-backed; impl in ffi/animation-ffi.ts) ---
-- `sampleAnim` / `renderAnim` re-enter the evaluator (CTX natives →
-- nativeImplsCtx — animation has NO plain native). No Fenel body: the registry
-- resolves each call to the ffi leaf keyed by codeName.

@native
@label "Sample animation"
@description "Sample an Animation at a Time, returning the Picture at that instant. Bridge primitive — every higher-level Animation operation reduces to this."
@category "video"
@tags "video" "animation" "primitive"
sampleAnim : (animation: Animation, t: Time) -> Picture

@native
@label "Render animation"
@description "Rasterise an Animation into a FrameSequence at the given fps and resolution over `duration` seconds."
@category "video"
@tags "video" "animation" "primitive"
renderAnim : (animation: Animation, duration: Number, fps: Number, width: Number, height: Number) -> FrameSequence

-- frameSequence — pure Fenel-bodied record constructor (consolidated from the
-- retired frame-sequence.fenel). Drops the pre-5b11 TS native's Math.max(1,…)
-- minimum-clamp + Array.isArray fallback (the typed spec covers the contract).
@label "Frame sequence"
@description "Build a FrameSequence from fps and a list of pre-rendered Image frames. Returns the canonical typed `{$tag: \"FrameSequence\", fps, frames}` shape via the FrameSequence constructor."
@category "video"
@tags "video" "animation" "constructor"
frameSequence : (fps: Number, frames: List Image) -> FrameSequence
frameSequence fps frames = FrameSequence { fps = fps, frames = frames }

-- Lift a static Picture to a constant Animation.
freeze : Picture -> Animation
freeze pic = Animate (\t -> pic)

-- Per-frame composition: at each instant, overlay the top animation onto
-- the bottom by composing their Pictures via Picture's over.
overAnim : Animation -> Animation -> Animation
overAnim top bot = Animate (\t -> over (sampleAnim top t) (sampleAnim bot t))

-- Time-shift an animation: play it d seconds later than the source clock.
delayAnim : Number -> Animation -> Animation
delayAnim d a = Animate (\t -> sampleAnim a (time (t.seconds - d)))

-- Time-scale an animation: faster (f>1) or slower (f<1).
speedAnim : Number -> Animation -> Animation
speedAnim f a = Animate (\t -> sampleAnim a (time (f * t.seconds)))
