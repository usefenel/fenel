module units where

using std (map, flatMap, filter, find, join, chars, some, contains, toString, typeOf, numberIsFinite, ratAdd, ratSub, ratMul, ratDiv, ratEq, ratLt, rationalZero, rationalIsValid, rationalNormalize, rationalCheckedResult, rationalToExactText, divideRationals, powerExactRational, approximateRational)
using time (Duration, duration)

-- Units are self-contained ordinary values. Dimensional arithmetic composes
-- Rational data; it neither adds a type judgment nor consults a family name.
-- Coordinate versus difference meaning comes solely from generic calibration.
-- Exact arithmetic never projects to Number; approximation is an explicit API.

zeroDimension : DimensionVector
zeroDimension =
  let zero = rationalZero ()
  DimensionVector { length = zero, mass = zero, time = zero, current = zero, temperature = zero, information = zero, angle = zero }

dimensionAdd : DimensionVector -> DimensionVector -> DimensionVector
dimensionAdd a b = DimensionVector { length = ratAdd a.length b.length, mass = ratAdd a.mass b.mass, time = ratAdd a.time b.time, current = ratAdd a.current b.current, temperature = ratAdd a.temperature b.temperature, information = ratAdd a.information b.information, angle = ratAdd a.angle b.angle }

dimensionSubtract : DimensionVector -> DimensionVector -> DimensionVector
dimensionSubtract a b = DimensionVector { length = ratSub a.length b.length, mass = ratSub a.mass b.mass, time = ratSub a.time b.time, current = ratSub a.current b.current, temperature = ratSub a.temperature b.temperature, information = ratSub a.information b.information, angle = ratSub a.angle b.angle }

dimensionScale : DimensionVector -> Rational -> DimensionVector
dimensionScale a n = DimensionVector { length = ratMul a.length n, mass = ratMul a.mass n, time = ratMul a.time n, current = ratMul a.current n, temperature = ratMul a.temperature n, information = ratMul a.information n, angle = ratMul a.angle n }

dimensionEqual : DimensionVector -> DimensionVector -> Bool
dimensionEqual a b = ratEq a.length b.length && ratEq a.mass b.mass && ratEq a.time b.time && ratEq a.current b.current && ratEq a.temperature b.temperature && ratEq a.information b.information && ratEq a.angle b.angle

dimensionIsValid : (dimension: a) -> Bool
dimensionIsValid dimension = case dimension of
  DimensionVector { length = l, mass = m, time = t, current = c, temperature = h, information = i, angle = a } -> rationalIsValid l && rationalIsValid m && rationalIsValid t && rationalIsValid c && rationalIsValid h && rationalIsValid i && rationalIsValid a
  _ -> false

unitCalibrationIsValid : (calibration: a) -> Bool
unitCalibrationIsValid calibration = case calibration of
  Linear { scale = scale } -> rationalIsValid scale && ratLt (rationalZero ()) scale
  Affine { scale = scale, origin = origin, offset = offset } -> rationalIsValid scale && rationalIsValid origin && rationalIsValid offset && ratLt (rationalZero ()) scale
  ApproximateLinear { scale = scale } -> numberIsFinite scale && scale > 0
  _ -> false

unitIsValid : (unit: a) -> Bool
unitIsValid unit = case unit of
  UnitDefinition { dimension = dimension, calibration = calibration } -> dimensionIsValid dimension && unitCalibrationIsValid calibration
  _ -> false

unitIsAffine : UnitDefinition -> Bool
unitIsAffine unit = case unit.calibration of
  Affine { scale = scale, origin = origin, offset = offset } -> true
  _ -> false

unitCalibrationEqual : UnitCalibration -> UnitCalibration -> Bool
unitCalibrationEqual a b = case a of
  Linear { scale = aScale } -> case b of
    Linear { scale = bScale } -> ratEq aScale bScale
    _ -> false
  Affine { scale = aScale, origin = aOrigin, offset = aOffset } -> case b of
    Affine { scale = bScale, origin = bOrigin, offset = bOffset } -> ratEq aScale bScale && ratEq aOrigin bOrigin && ratEq aOffset bOffset
    _ -> false
  ApproximateLinear { scale = aScale } -> case b of
    ApproximateLinear { scale = bScale } -> aScale == bScale
    _ -> false

unitDefinitionEqual : UnitDefinition -> UnitDefinition -> Bool
unitDefinitionEqual a b = unitIsValid a && unitIsValid b && dimensionEqual a.dimension b.dimension && unitCalibrationEqual a.calibration b.calibration

unitDefinitionsCompatible : UnitDefinition -> UnitDefinition -> Bool
unitDefinitionsCompatible a b = unitIsValid a && unitIsValid b && dimensionEqual a.dimension b.dimension && unitIsAffine a == unitIsAffine b

unitFamilies : List UnitFamily
unitFamilies =
  let catalogue = unitCatalogue ()
  catalogue.families

unitChoices : List UnitChoice
unitChoices = flatMap (\family -> family.choices) (unitFamilies ())

unitDefinitions : List UnitDefinition
unitDefinitions = map (\choice -> choice.unit) (unitChoices ())

-- Family names and display codes are presentation metadata only.
familyByName : String -> Maybe UnitFamily
familyByName name = find (\family -> family.name == name) (unitFamilies ())

unitChoicesForFamily : String -> List UnitChoice
unitChoicesForFamily name = case familyByName name of
  Nothing -> []
  Just family -> family.choices

unitChoiceFor : UnitDefinition -> Maybe UnitChoice
unitChoiceFor unit = find (\choice -> unitDefinitionEqual choice.unit unit) (unitChoices ())

@label "Compatible units"
@description "Find catalogue unit values with matching dimensions and coordinate/difference meaning. A custom unit does not need catalogue registration. Names and groups are presentation only."
compatibleUnits : (unit: UnitDefinition) -> List UnitDefinition
compatibleUnits unit = filter (\candidate -> unitDefinitionsCompatible unit candidate) (unitDefinitions ())

compatibleUnitChoices : UnitDefinition -> List UnitChoice
compatibleUnitChoices unit = filter (\choice -> unitDefinitionsCompatible unit choice.unit) (unitChoices ())

-- B3: source selects ordinary values; the host only marshals dollar-key types.
@native
unitTypeFromSet : (base: Type) -> (constraint: SetExpr) -> Type

@label "Catalogue unit type"
catalogueUnitType : (family: String) -> Type
catalogueUnitType family =
  let admitted = if family == "" then unitDefinitions () else map (\choice -> choice.unit) (unitChoicesForFamily family)
  unitTypeFromSet (typeOf units.celsius) (SeEnum { values = admitted })

@label "Compatible unit type"
compatibleUnitType : (unit: UnitDefinition) -> Type
compatibleUnitType unit = unitTypeFromSet (typeOf units.celsius) (SeEnum { values = compatibleUnits unit })

@label "Quantity type"
measureType : (base: Type) -> (unit: MeasureExpr) -> Type
measureType base unit = std.taggedSingletonType base units.MeasureExpr unit

unitExactCalibration : UnitCalibration -> Result String ({ scale: Rational, origin: Rational, offset: Rational })
unitExactCalibration calibration = case calibration of
  Linear { scale = scale } -> Ok { scale = scale, origin = rationalZero (), offset = rationalZero () }
  Affine { scale = scale, origin = origin, offset = offset } -> Ok { scale = scale, origin = origin, offset = offset }
  ApproximateLinear { scale = scale } -> Err "This unit has an approximate scale; choose explicit approximate conversion."

@label "Convert unit values exactly"
@description "Convert an exact Rational between self-contained typed units. Affine coordinates use their calibration; linear differences remain distinct. Incompatible dimensions, malformed units and approximate scales refuse."
convertUnit : (value: Rational) -> (from: UnitDefinition) -> (to: UnitDefinition) -> Result String Rational
convertUnit value from to =
  if not (rationalIsValid value) then Err "Use an admitted exact Rational quantity."
  else if not (unitIsValid from && unitIsValid to) then Err "Use unit values with admitted dimensions and positive scales."
  else if not (dimensionEqual from.dimension to.dimension) then Err "The source and target units have different dimensions."
  else if unitIsAffine from != unitIsAffine to then Err "Affine coordinates and linear differences are distinct; choose compatible units."
  else if unitDefinitionEqual from to then rationalCheckedResult (rationalNormalize value)
  else case unitExactCalibration from.calibration of
    Err problem -> Err problem
    Ok a -> case unitExactCalibration to.calibration of
      Err problem -> Err problem
      Ok b ->
        let base = ratAdd (ratMul (ratSub value a.origin) a.scale) a.offset
        case divideRationals (ratSub base b.offset) b.scale of
          Err problem -> Err problem
          Ok coordinate -> rationalCheckedResult (ratAdd coordinate b.origin)

-- Taking a difference drops a coordinate origin, independently of its dimension.
@label "Difference unit"
unitDifference : (unit: UnitDefinition) -> UnitDefinition
unitDifference unit = case unit.calibration of
  Affine { scale = scale, origin = origin, offset = offset } -> UnitDefinition { dimension = unit.dimension, calibration = Linear { scale = scale } }
  _ -> unit

@label "Convert unit differences exactly"
convertUnitDifference : (value: Rational) -> (from: UnitDefinition) -> (to: UnitDefinition) -> Result String Rational
convertUnitDifference value from to = convertUnit value (unitDifference from) (unitDifference to)

unitApproximateCalibration : UnitCalibration -> Result String ({ scale: Number, origin: Number, offset: Number })
unitApproximateCalibration calibration = case calibration of
  ApproximateLinear { scale = scale } -> Ok { scale = scale, origin = 0, offset = 0 }
  _ -> case unitExactCalibration calibration of
    Err problem -> Err problem
    Ok exact -> case approximateRational exact.scale of
      Err problem -> Err problem
      Ok scale -> case approximateRational exact.origin of
        Err problem -> Err problem
        Ok origin -> case approximateRational exact.offset of
          Err problem -> Err problem
          Ok offset -> Ok { scale = scale, origin = origin, offset = offset }

@label "Approximate unit conversion"
@description "Explicit floating conversion for typed units, including irrational radian/degree scales. Exact Rational inputs and exact calibrations are projected only in this function. Finite-range failures refuse."
approximateUnitConversion : (value: Rational) -> (from: UnitDefinition) -> (to: UnitDefinition) -> Result String Number
approximateUnitConversion value from to =
  if not (unitDefinitionsCompatible from to) then Err "Use compatible admitted typed units."
  else case approximateRational value of
    Err problem -> Err problem
    Ok number -> case unitApproximateCalibration from.calibration of
      Err problem -> Err problem
      Ok a -> case unitApproximateCalibration to.calibration of
        Err problem -> Err problem
        Ok b ->
          let result = (((number - a.origin) * a.scale + a.offset) - b.offset) / b.scale + b.origin
          if numberIsFinite result then Ok result else Err "The approximation exceeds the finite Number range."

measureExprEqual : MeasureExpr -> MeasureExpr -> Bool
measureExprEqual a b = case a of
  MeasureOne -> case b of
    MeasureOne -> true
    _ -> false
  MeasureAtom { unit = au } -> case b of
    MeasureAtom { unit = bu } -> unitDefinitionEqual au bu
    _ -> false
  MeasureProduct { left = al, right = ar } -> case b of
    MeasureProduct { left = bl, right = br } -> measureExprEqual al bl && measureExprEqual ar br
    _ -> false
  MeasureQuotient { left = al, right = ar } -> case b of
    MeasureQuotient { left = bl, right = br } -> measureExprEqual al bl && measureExprEqual ar br
    _ -> false
  MeasurePower { base = ab, exponent = ae } -> case b of
    MeasurePower { base = bb, exponent = be } -> ratEq ae be && measureExprEqual ab bb
    _ -> false

resolveMeasure : (unit: MeasureExpr) -> Result String ResolvedMeasure
resolveMeasure unit = resolveMeasureBounded unit 32

resolveMeasureBounded : MeasureExpr -> Number -> Result String ResolvedMeasure
resolveMeasureBounded unit depth =
  if depth <= 0 then Err "Use a unit expression nested at most 32 levels deep."
  else case unit of
    MeasureOne -> Ok (ResolvedMeasure { factor = Just (Rational { num = 1, den = 1 }), dimension = zeroDimension () })
    MeasureAtom { unit = definition } ->
      if not (unitIsValid definition) then Err "Use a unit value with admitted dimensions and a positive scale."
      else case definition.calibration of
        Linear { scale = scale } -> Ok (ResolvedMeasure { factor = Just (rationalNormalize scale), dimension = definition.dimension })
        Affine { scale = scale, origin = origin, offset = offset } -> Err "Affine coordinates cannot participate in quantity algebra; use their difference unit."
        ApproximateLinear { scale = scale } -> Ok (ResolvedMeasure { factor = Nothing, dimension = definition.dimension })
    MeasureProduct { left = left, right = right } -> resolveMeasurePair left right (depth - 1) false
    MeasureQuotient { left = left, right = right } -> resolveMeasurePair left right (depth - 1) true
    MeasurePower { base = base, exponent = exponent } ->
      if not (rationalIsValid exponent) then Err "Use an admitted exact Rational unit exponent."
      else if ratLt (Rational { num = 64, den = 1 }) exponent || ratLt exponent (Rational { num = Int { magnitude = 64, negative = True }, den = 1 }) then Err "Use a unit exponent from -64 through 64."
      else case resolveMeasureBounded base (depth - 1) of
        Err problem -> Err problem
        Ok resolved -> case resolved.factor of
          Nothing -> resolvedMeasureChecked Nothing (dimensionScale resolved.dimension exponent)
          Just exact -> case powerExactRational exact exponent of
            Err problem -> resolvedMeasureChecked Nothing (dimensionScale resolved.dimension exponent)
            Ok factor -> resolvedMeasureChecked (Just factor) (dimensionScale resolved.dimension exponent)
    _ -> Err "Use a typed unit expression."

-- A symbolic unit remains meaningful when an exact normalization factor is
-- irrational or exceeds the bounded numeric admission work. Dimensions must
-- remain admitted; no successful result carries an unreadable exact exponent.
resolvedMeasureChecked : Maybe Rational -> DimensionVector -> Result String ResolvedMeasure
resolvedMeasureChecked factor dimension =
  if not (dimensionIsValid dimension) then Err "The calculation exceeds bounded exact dimension arithmetic."
  else case factor of
    Nothing -> Ok (ResolvedMeasure { factor = Nothing, dimension = dimension })
    Just exact ->
      if not (rationalIsValid exact) then Ok (ResolvedMeasure { factor = Nothing, dimension = dimension })
      else if ratLt (rationalZero ()) exact then Ok (ResolvedMeasure { factor = Just exact, dimension = dimension })
      else Err "A resolved unit scale must be positive."

resolveMeasurePair : MeasureExpr -> MeasureExpr -> Number -> Bool -> Result String ResolvedMeasure
resolveMeasurePair left right depth divide = case resolveMeasureBounded left depth of
  Err problem -> Err problem
  Ok a -> case resolveMeasureBounded right depth of
    Err problem -> Err problem
    Ok b ->
      let dimension = if divide then dimensionSubtract a.dimension b.dimension else dimensionAdd a.dimension b.dimension
      case a.factor of
        Nothing -> resolvedMeasureChecked Nothing dimension
        Just aFactor -> case b.factor of
          Nothing -> resolvedMeasureChecked Nothing dimension
          Just bFactor ->
            if divide then case divideRationals aFactor bFactor of
              Err problem -> resolvedMeasureChecked Nothing dimension
              Ok factor -> resolvedMeasureChecked (Just factor) dimension
            else resolvedMeasureChecked (Just (ratMul aFactor bFactor)) dimension

measureAdditiveFactor : MeasureExpr -> MeasureExpr -> Maybe Rational
measureAdditiveFactor destination source = case resolveMeasure destination of
  Err problem -> Nothing
  Ok a -> case resolveMeasure source of
    Err problem -> Nothing
    Ok b ->
      if not (dimensionEqual a.dimension b.dimension) then Nothing
      else if measureExprEqual destination source then Just (Rational { num = 1, den = 1 })
      else case a.factor of
        Nothing -> Nothing
        Just aFactor -> case b.factor of
          Nothing -> Nothing
          Just bFactor -> Just (ratDiv bFactor aFactor)

@label "Convert a quantity exactly"
convertMeasure : (value: Rational) -> (from: MeasureExpr) -> (to: MeasureExpr) -> Result String Rational
convertMeasure value from to =
  if not (rationalIsValid value) then Err "Use an admitted exact Rational quantity."
  else case from of
    MeasureAtom { unit = source } -> case to of
      MeasureAtom { unit = target } -> convertUnit value source target
      _ -> convertLinearMeasure value from to
    _ -> convertLinearMeasure value from to

convertLinearMeasure : Rational -> MeasureExpr -> MeasureExpr -> Result String Rational
convertLinearMeasure value from to =
  if not (rationalIsValid value) then Err "Use an admitted exact Rational quantity."
  else convertAdmittedLinearMeasure value from to

convertAdmittedLinearMeasure : Rational -> MeasureExpr -> MeasureExpr -> Result String Rational
convertAdmittedLinearMeasure value from to = case resolveMeasure from of
  Err problem -> Err problem
  Ok a -> case resolveMeasure to of
    Err problem -> Err problem
    Ok b ->
      if not (dimensionEqual a.dimension b.dimension) then Err "The source and target units have different dimensions."
      else if measureExprEqual from to then rationalCheckedResult (rationalNormalize value)
      else case a.factor of
        Nothing -> Err "This conversion needs an approximate scale; choose explicit approximate conversion."
        Just aFactor -> case b.factor of
          Nothing -> Err "This conversion needs an approximate scale; choose explicit approximate conversion."
          Just bFactor -> divideRationals (ratMul value aFactor) bFactor

quantityChecked : Rational -> MeasureExpr -> Result String MeasureQuantity
quantityChecked value unit =
  if not (rationalIsValid value) then Err "Use an admitted exact Rational quantity."
  else case resolveMeasure unit of
    Err problem -> Err problem
    Ok resolved -> case rationalCheckedResult (rationalNormalize value) of
      Err problem -> Err problem
      Ok normalized -> Ok (MeasureQuantity { value = normalized, unit = unit })

quantityLinear : MeasureQuantity -> Result String ResolvedMeasure
quantityLinear quantity = case quantity of
  MeasureQuantity { value = value, unit = unit } -> if rationalIsValid value then resolveMeasure unit else Err "Use an admitted exact Rational quantity."
  _ -> Err "Use a typed quantity."

@label "Add quantities"
addQuantities : (left: MeasureQuantity) -> (right: MeasureQuantity) -> Result String MeasureQuantity
addQuantities left right = addSubtractQuantities left right false

@label "Subtract quantities"
subtractQuantities : (left: MeasureQuantity) -> (right: MeasureQuantity) -> Result String MeasureQuantity
subtractQuantities left right = addSubtractQuantities left right true

addSubtractQuantities : MeasureQuantity -> MeasureQuantity -> Bool -> Result String MeasureQuantity
addSubtractQuantities left right subtract = case quantityLinear left of
  Err problem -> Err problem
  Ok a -> case quantityLinear right of
    Err problem -> Err problem
    Ok b -> case convertLinearMeasure right.value right.unit left.unit of
      Err problem -> Err problem
      Ok converted -> quantityChecked (if subtract then ratSub left.value converted else ratAdd left.value converted) left.unit

@label "Multiply quantities"
multiplyQuantities : (left: MeasureQuantity) -> (right: MeasureQuantity) -> Result String MeasureQuantity
multiplyQuantities left right = multiplyDivideQuantities left right false

@label "Divide quantities"
divideQuantities : (left: MeasureQuantity) -> (right: MeasureQuantity) -> Result String MeasureQuantity
divideQuantities left right = multiplyDivideQuantities left right true

multiplyDivideQuantities : MeasureQuantity -> MeasureQuantity -> Bool -> Result String MeasureQuantity
multiplyDivideQuantities left right divide = case quantityLinear left of
  Err problem -> Err problem
  Ok a -> case quantityLinear right of
    Err problem -> Err problem
    Ok b ->
      if divide then case divideRationals left.value right.value of
        Err problem -> Err problem
        Ok value -> quantityChecked value (MeasureQuotient { left = left.unit, right = right.unit })
      else quantityChecked (ratMul left.value right.value) (MeasureProduct { left = left.unit, right = right.unit })

@label "Raise a quantity to an exact power"
powerQuantity : (quantity: MeasureQuantity) -> (exponent: Rational) -> Result String MeasureQuantity
powerQuantity quantity exponent = case quantityLinear quantity of
  Err problem -> Err problem
  Ok resolved ->
    let unit = MeasurePower { base = quantity.unit, exponent = exponent }
    case resolveMeasure unit of
      Err problem -> Err problem
      Ok powered -> case powerExactRational quantity.value exponent of
        Err problem -> Err problem
        Ok value -> quantityChecked value (measurePower quantity.unit exponent)

@label "Scale a quantity"
scaleQuantity : (quantity: MeasureQuantity) -> (multiplier: Rational) -> Result String MeasureQuantity
scaleQuantity quantity multiplier = case quantityLinear quantity of
  Err problem -> Err problem
  Ok resolved -> if rationalIsValid multiplier then quantityChecked (ratMul quantity.value multiplier) quantity.unit else Err "Use an admitted exact Rational multiplier."

measureProduct : MeasureExpr -> MeasureExpr -> MeasureExpr
measureProduct a b = MeasureProduct { left = a, right = b }

measureQuotient : MeasureExpr -> MeasureExpr -> MeasureExpr
measureQuotient a b = MeasureQuotient { left = a, right = b }

measurePower : MeasureExpr -> Rational -> MeasureExpr
measurePower base exponent = if ratEq exponent (Rational { num = 1, den = 1 }) then base else if ratEq exponent (rationalZero ()) then MeasureOne else MeasurePower { base = base, exponent = exponent }

formatMeasure : MeasureExpr -> String
formatMeasure unit = formatMeasureBounded unit 32

formatMeasureBounded : MeasureExpr -> Number -> String
formatMeasureBounded unit depth =
  if depth <= 0 then "?"
  else case unit of
    MeasureOne -> "1"
    MeasureAtom { unit = definition } -> case unitChoiceFor definition of
      Just choice -> choice.symbol
      Nothing -> formatUnitDefinition definition
    MeasureProduct { left = left, right = right } -> join [formatMeasureFactor left (depth - 1), "·", formatMeasureFactor right (depth - 1)] ""
    MeasureQuotient { left = left, right = right } -> join [formatMeasureFactor left (depth - 1), "/", formatMeasureDenominator right (depth - 1)] ""
    MeasurePower { base = base, exponent = exponent } -> join [formatMeasurePowerBase base (depth - 1), formatMeasureExponent exponent] ""

formatMeasureFactor : MeasureExpr -> Number -> String
formatMeasureFactor unit depth = case unit of
  MeasureAtom { unit = definition } -> formatMeasureAtomicText (formatMeasureBounded unit depth) false
  MeasureQuotient { left = left, right = right } -> join ["(", formatMeasureBounded unit depth, ")"] ""
  _ -> formatMeasureBounded unit depth

formatMeasureDenominator : MeasureExpr -> Number -> String
formatMeasureDenominator unit depth = case unit of
  MeasureAtom { unit = definition } -> formatMeasureAtomicText (formatMeasureBounded unit depth) false
  MeasureProduct { left = left, right = right } -> join ["(", formatMeasureBounded unit depth, ")"] ""
  MeasureQuotient { left = left, right = right } -> join ["(", formatMeasureBounded unit depth, ")"] ""
  _ -> formatMeasureBounded unit depth

formatMeasurePowerBase : MeasureExpr -> Number -> String
formatMeasurePowerBase unit depth = case unit of
  MeasureAtom { unit = definition } -> formatMeasureAtomicText (formatMeasureBounded unit depth) true
  MeasureOne -> "1"
  _ -> join ["(", formatMeasureBounded unit depth, ")"] ""

-- A catalogue atom may spell a whole expression, such as m/s or m². Keep
-- that operand intact; this grouping reads presentation text, never dimensions.
formatMeasureAtomicText : String -> Bool -> String
formatMeasureAtomicText text power =
  let compound = some (chars text) (\character -> contains " /·^(),;\t\r\n" character || power && contains "⁰¹²³⁴⁵⁶⁷⁸⁹⁺⁻" character)
  if compound then join ["(", text, ")"] "" else text

formatMeasureExponent : Rational -> String
formatMeasureExponent exponent =
  let text = rationalToExactText exponent
  if text == "2" then "²" else if text == "3" then "³" else if text == "4" then "⁴" else if text == "-1" then "⁻¹" else if text == "-2" then "⁻²" else if text == "-3" then "⁻³" else if contains text "/" then join ["^(", text, ")"] "" else join ["^", text] ""

formatUnitDefinition : UnitDefinition -> String
formatUnitDefinition definition =
  if not (unitIsValid definition) then "Invalid unit" else formatAdmittedUnitDefinition definition

formatAdmittedUnitDefinition : UnitDefinition -> String
formatAdmittedUnitDefinition definition =
  let d = definition.dimension
  let exponents = join (map rationalToExactText [d.length, d.mass, d.time, d.current, d.temperature, d.information, d.angle]) ", "
  let calibration = case definition.calibration of
    Linear { scale = scale } -> join ["Linear ", rationalToExactText scale] ""
    Affine { scale = scale, origin = origin, offset = offset } -> join ["Affine ", rationalToExactText scale, " ", rationalToExactText origin, " ", rationalToExactText offset] ""
    ApproximateLinear { scale = scale } -> join ["ApproximateLinear ", toString scale] ""
  join ["UnitDefinition (", exponents, "; ", calibration, ")"] ""

@label "Unit as text"
@description "Present an admitted unit through the ordinary catalogue label and symbol, or describe a custom unit's exact dimensions and calibration. This text is presentation; conversion always uses the unit value."
encodeUnitDefinitionText : (unit: UnitDefinition) -> Result String String
encodeUnitDefinitionText unit =
  if not (unitIsValid unit) then Err "Use an admitted unit value."
  else case unitChoiceFor unit of
    Just choice -> Ok (join [choice.label, " (", choice.symbol, ")"] "")
    Nothing -> Ok (formatUnitDefinition unit)

formatQuantityValue : MeasureQuantity -> String
formatQuantityValue quantity = join [rationalToExactText quantity.value, " ", formatMeasure quantity.unit] ""

@label "Quantity as a duration"
@description "Convert exact time units to the existing millisecond Duration. The final Number projection is explicit at this current Duration representation boundary. Fixed 30/365-day spans are distinct from calendar arithmetic."
quantityDuration : (quantity: MeasureQuantity) -> Result String Duration
quantityDuration quantity = case convertMeasure quantity.value quantity.unit (MeasureAtom { unit = units.millisecond }) of
  Err problem -> Err problem
  Ok milliseconds -> case approximateRational milliseconds of
    Err problem -> Err problem
    Ok number -> Ok (duration number)
