module units where

-- A unit is ordinary self-contained data. A catalogue choice supplies optional
-- spelling and presentation; neither a name nor catalogue membership is needed
-- to convert a caller-owned unit. Exact exponents allow fractional dimensions.
DimensionVector = DimensionVector length: Rational mass: Rational time: Rational current: Rational temperature: Rational information: Rational angle: Rational

-- Affine coordinates remain distinct even when their origin and offset are zero.
-- ApproximateLinear explicitly describes a rounded physical/irrational scale;
-- exact conversion refuses it and the approximation function admits it.
UnitCalibration = Linear scale: Rational | Affine scale: Rational origin: Rational offset: Rational | ApproximateLinear scale: Number

UnitDefinition = UnitDefinition dimension: DimensionVector calibration: UnitCalibration

UnitChoice = UnitChoice code: String label: String symbol: String unit: UnitDefinition
UnitFamily = UnitFamily name: String label: String description: String choices: List UnitChoice
UnitCatalogue = UnitCatalogue families: List UnitFamily

MeasureExpr = MeasureAtom unit: UnitDefinition | MeasureProduct left: MeasureExpr right: MeasureExpr | MeasureQuotient left: MeasureExpr right: MeasureExpr | MeasurePower base: MeasureExpr exponent: Rational | MeasureOne
MeasureQuantity = MeasureQuantity value: Rational unit: MeasureExpr
ResolvedMeasure = ResolvedMeasure factor: Maybe Rational dimension: DimensionVector
