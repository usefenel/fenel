  ]
  UnitCatalogue { families = families }

-- Presentation uses the existing text encoder class. The method remains a
-- source callable reference; no catalogue label participates in conversion.
encodableUnitDefinitionText : Encodable String UnitDefinition
encodableUnitDefinitionText = Encodable { encode = units.encodeUnitDefinitionText }
