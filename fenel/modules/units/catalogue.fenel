      UnitChoice { code = "MHz", label = "Megahertz", symbol = "MHz", unit = units.megahertz },
      UnitChoice { code = "GHz", label = "Gigahertz", symbol = "GHz", unit = units.gigahertz },
      UnitChoice { code = "rpm", label = "Revolutions/min", symbol = "rpm", unit = units.revolutionsPerMinute }
    ] },
    UnitFamily { name = "data_size", label = "Data Size", description = "Digital information measurements", choices = [
      UnitChoice { code = "bit", label = "Bits", symbol = "bit", unit = units.bit },
      UnitChoice { code = "B", label = "Bytes", symbol = "B", unit = units.byte },
      UnitChoice { code = "KB", label = "Kilobytes", symbol = "KB", unit = units.kilobyte },
      UnitChoice { code = "MB", label = "Megabytes", symbol = "MB", unit = units.megabyte },
      UnitChoice { code = "GB", label = "Gigabytes", symbol = "GB", unit = units.gigabyte },
      UnitChoice { code = "TB", label = "Terabytes", symbol = "TB", unit = units.terabyte },
      UnitChoice { code = "KiB", label = "Kibibytes", symbol = "KiB", unit = units.kibibyte },
      UnitChoice { code = "MiB", label = "Mebibytes", symbol = "MiB", unit = units.mebibyte },
      UnitChoice { code = "GiB", label = "Gibibytes", symbol = "GiB", unit = units.gibibyte },
