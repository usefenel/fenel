module units where

using std (rationalFromRepresentationParts, RationalRepresentation, Encodable)

-- Ordinary unit values carry their complete dimensions and calibration.
-- Catalogue codes, symbols, labels and family names are presentation facts.
-- Exact factors use the international foot, US liquid volumes, thermochemical
-- calories, International Table BTU, mechanical horsepower and conventional mmHg.
-- Sources: NIST SP811 appendix B and footnotes; NIST revised foot factors;
-- BIPM SI brochure table 8; PTB/NPL/CMI D-SI table B.8 (2019-11-04).
-- https://www.nist.gov/pml/us-surveyfoot/revised-unit-conversion-factors
-- https://www.nist.gov/document/appc-11-hb44-finalpdf
-- https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b9
-- https://www.nist.gov/pml/special-publication-811/nist-guide-si-footnotes
-- https://www.bipm.org/documents/20126/41483022/SI-Brochure-9.pdf
-- https://www.ptb.de/empir2018/fileadmin/documents/empir/SmartCom/documents_for_download/Digital_System_of_Units_D-SI_2019-11-04_UK_NPL_SmartCom.pdf
-- Radian is the angle basis. Degree/arcminute/arcsecond involve pi and explicitly
-- use ApproximateLinear; exact conversion refuses crossings through that scale.
-- Fixed months/years mean exactly 30/365 days, never calendar operations.

milligram : UnitDefinition
milligram = UnitDefinition { dimension = DimensionVector { length = Rational { num = 0, den = 1 }, mass = Rational { num = 1, den = 1 }, time = Rational { num = 0, den = 1 }, current = Rational { num = 0, den = 1 }, temperature = Rational { num = 0, den = 1 }, information = Rational { num = 0, den = 1 }, angle = Rational { num = 0, den = 1 } }, calibration = Linear { scale = Rational { num = 1, den = 1000000 } } }

