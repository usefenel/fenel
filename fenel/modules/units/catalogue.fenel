@label "Unit catalogue"
@description "Fourteen presentation groups of self-contained typed unit values. Exact rational calibrations replace rounded definitions; degree scales explicitly require approximation. A custom unit works without joining this catalogue. Fixed months and years retain their 30/365-day definitions."
unitCatalogue : UnitCatalogue
unitCatalogue =
  let families = [
    UnitFamily { name = "mass", label = "Mass", description = "Weight and mass measurements", choices = [
      UnitChoice { code = "mg", label = "Milligrams", symbol = "mg", unit = units.milligram },
      UnitChoice { code = "g", label = "Grams", symbol = "g", unit = units.gram },
      UnitChoice { code = "kg", label = "Kilograms", symbol = "kg", unit = units.kilogram },
      UnitChoice { code = "t", label = "Metric Tons", symbol = "t", unit = units.tonne },
      UnitChoice { code = "oz", label = "Mass ounces", symbol = "oz", unit = units.ounce },
      UnitChoice { code = "lb", label = "Pounds", symbol = "lb", unit = units.pound }
    ] },
    UnitFamily { name = "distance", label = "Distance", description = "Length and distance measurements", choices = [
      UnitChoice { code = "mm", label = "Millimeters", symbol = "mm", unit = units.millimetre },
      UnitChoice { code = "cm", label = "Centimeters", symbol = "cm", unit = units.centimetre },
      UnitChoice { code = "m", label = "Meters", symbol = "m", unit = units.metre },
      UnitChoice { code = "km", label = "Kilometers", symbol = "km", unit = units.kilometre },
      UnitChoice { code = "in", label = "Inches", symbol = "in", unit = units.inch },
      UnitChoice { code = "ft", label = "International feet", symbol = "ft", unit = units.foot },
      UnitChoice { code = "yd", label = "Yards", symbol = "yd", unit = units.yard },
      UnitChoice { code = "mi", label = "Miles", symbol = "mi", unit = units.mile }
    ] },
    UnitFamily { name = "volume", label = "Volume", description = "Liquid and dry volume measurements — L³", choices = [
      UnitChoice { code = "mL", label = "Milliliters", symbol = "mL", unit = units.millilitre },
      UnitChoice { code = "L", label = "Liters", symbol = "L", unit = units.litre },
      UnitChoice { code = "m3", label = "Cubic Meters", symbol = "m³", unit = units.cubicMetre },
      UnitChoice { code = "fl_oz", label = "US Fluid Ounces", symbol = "fl oz", unit = units.fluidOunce },
      UnitChoice { code = "cup", label = "US Cups", symbol = "cup", unit = units.cup },
      UnitChoice { code = "pt", label = "US Pints", symbol = "pt", unit = units.pint },
      UnitChoice { code = "qt", label = "US Quarts", symbol = "qt", unit = units.quart },
      UnitChoice { code = "gal", label = "US Gallons", symbol = "gal", unit = units.gallon },
      UnitChoice { code = "tbsp_us", label = "US tablespoons", symbol = "US tbsp", unit = units.tablespoon }
    ] },
    UnitFamily { name = "time", label = "Time", description = "Duration and time measurements", choices = [
      UnitChoice { code = "ms", label = "Milliseconds", symbol = "ms", unit = units.millisecond },
      UnitChoice { code = "s", label = "Seconds", symbol = "s", unit = units.second },
      UnitChoice { code = "min", label = "Minutes", symbol = "min", unit = units.minute },
      UnitChoice { code = "hr", label = "Hours", symbol = "hr", unit = units.hour },
      UnitChoice { code = "d", label = "Days", symbol = "d", unit = units.day },
      UnitChoice { code = "wk", label = "Weeks", symbol = "wk", unit = units.week },
      UnitChoice { code = "mo", label = "Fixed 30-day months", symbol = "mo", unit = units.fixedMonth },
      UnitChoice { code = "yr", label = "Fixed 365-day years", symbol = "yr", unit = units.fixedYear }
    ] },
    UnitFamily { name = "area", label = "Area", description = "Surface area measurements — L²", choices = [
      UnitChoice { code = "cm2", label = "Square Centimeters", symbol = "cm²", unit = units.squareCentimetre },
      UnitChoice { code = "m2", label = "Square Meters", symbol = "m²", unit = units.squareMetre },
      UnitChoice { code = "km2", label = "Square Kilometers", symbol = "km²", unit = units.squareKilometre },
      UnitChoice { code = "ha", label = "Hectares", symbol = "ha", unit = units.hectare },
      UnitChoice { code = "ft2", label = "Square Feet", symbol = "ft²", unit = units.squareFoot },
      UnitChoice { code = "ac", label = "International-foot acres", symbol = "ac", unit = units.acre },
      UnitChoice { code = "mi2", label = "Square Miles", symbol = "mi²", unit = units.squareMile }
    ] },
    UnitFamily { name = "temperature", label = "Temperature", description = "Affine coordinates and their linear differences", choices = [
      UnitChoice { code = "K", label = "Kelvin", symbol = "K", unit = units.kelvin },
      UnitChoice { code = "C", label = "Celsius", symbol = "°C", unit = units.celsius },
      UnitChoice { code = "F", label = "Fahrenheit", symbol = "°F", unit = units.fahrenheit },
      UnitChoice { code = "delta_K", label = "Kelvin differences", symbol = "ΔK", unit = units.kelvinDifference },
      UnitChoice { code = "delta_C", label = "Celsius differences", symbol = "Δ°C", unit = units.celsiusDifference },
      UnitChoice { code = "delta_F", label = "Fahrenheit differences", symbol = "Δ°F", unit = units.fahrenheitDifference }
    ] },
    UnitFamily { name = "angle", label = "Angle", description = "Angular measurements; degrees use an explicitly approximate pi calibration", choices = [
      UnitChoice { code = "deg", label = "Degrees", symbol = "°", unit = units.degree },
      UnitChoice { code = "rad", label = "Radians", symbol = "rad", unit = units.radian },
      UnitChoice { code = "arcmin", label = "Arcminutes", symbol = "′", unit = units.arcminute },
      UnitChoice { code = "arcsec", label = "Arcseconds", symbol = "″", unit = units.arcsecond }
    ] },
    UnitFamily { name = "energy", label = "Energy", description = "Energy and work — M·L²·T⁻²", choices = [
      UnitChoice { code = "J", label = "Joules", symbol = "J", unit = units.joule },
      UnitChoice { code = "kJ", label = "Kilojoules", symbol = "kJ", unit = units.kilojoule },
      UnitChoice { code = "cal", label = "Thermochemical calories", symbol = "cal", unit = units.thermochemicalCalorie },
      UnitChoice { code = "kcal", label = "Thermochemical kilocalories", symbol = "kcal", unit = units.thermochemicalKilocalorie },
      UnitChoice { code = "Wh", label = "Watt-hours", symbol = "Wh", unit = units.wattHour },
      UnitChoice { code = "kWh", label = "Kilowatt-hours", symbol = "kWh", unit = units.kilowattHour },
      UnitChoice { code = "eV", label = "Electronvolts", symbol = "eV", unit = electronvolt () },
      UnitChoice { code = "BTU", label = "International Table British thermal units", symbol = "BTU", unit = units.internationalTableBtu }
    ] },
    UnitFamily { name = "power", label = "Power", description = "Power measurements — M·L²·T⁻³", choices = [
      UnitChoice { code = "mW", label = "Milliwatts", symbol = "mW", unit = units.milliwatt },
      UnitChoice { code = "W", label = "Watts", symbol = "W", unit = units.watt },
      UnitChoice { code = "kW", label = "Kilowatts", symbol = "kW", unit = units.kilowatt },
      UnitChoice { code = "MW", label = "Megawatts", symbol = "MW", unit = units.megawatt },
      UnitChoice { code = "hp", label = "Mechanical horsepower", symbol = "hp", unit = mechanicalHorsepower () }
    ] },
    UnitFamily { name = "force", label = "Force", description = "Force measurements — M·L·T⁻²", choices = [
      UnitChoice { code = "N", label = "Newtons", symbol = "N", unit = units.newton },
      UnitChoice { code = "kN", label = "Kilonewtons", symbol = "kN", unit = units.kilonewton },
      UnitChoice { code = "lbf", label = "Pound-force", symbol = "lbf", unit = units.poundForce },
      UnitChoice { code = "dyn", label = "Dynes", symbol = "dyn", unit = units.dyne }
    ] },
    UnitFamily { name = "pressure", label = "Pressure", description = "Pressure measurements — M·L⁻¹·T⁻²", choices = [
      UnitChoice { code = "Pa", label = "Pascals", symbol = "Pa", unit = units.pascal },
      UnitChoice { code = "kPa", label = "Kilopascals", symbol = "kPa", unit = units.kilopascal },
      UnitChoice { code = "MPa", label = "Megapascals", symbol = "MPa", unit = units.megapascal },
      UnitChoice { code = "bar", label = "Bars", symbol = "bar", unit = units.bar },
      UnitChoice { code = "atm", label = "Atmospheres", symbol = "atm", unit = units.standardAtmosphere },
      UnitChoice { code = "psi", label = "Pounds per sq inch", symbol = "psi", unit = units.poundsPerSquareInch },
      UnitChoice { code = "mmHg", label = "Conventional millimetres of mercury", symbol = "mmHg", unit = units.conventionalMillimetreMercury }
    ] },
    UnitFamily { name = "frequency", label = "Frequency", description = "Frequency measurements — T⁻¹", choices = [
      UnitChoice { code = "Hz", label = "Hertz", symbol = "Hz", unit = units.hertz },
