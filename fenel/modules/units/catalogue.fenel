  let scale = (rationalFromRepresentationParts (RationalRepresentation { num = "801088317", den = "5000000000000000000000000000" }))
  UnitDefinition { dimension = DimensionVector { length = Rational { num = 2, den = 1 }, mass = Rational { num = 1, den = 1 }, time = Rational { num = Int { magnitude = 2, negative = True }, den = 1 }, current = Rational { num = 0, den = 1 }, temperature = Rational { num = 0, den = 1 }, information = Rational { num = 0, den = 1 }, angle = Rational { num = 0, den = 1 } }, calibration = Linear { scale = scale } }

