-- =========================================================================
-- module ai where — send a prompt to a swappable LLM provider and get a
-- typed Result back.
--
-- module-substrate Phase 3l (2026-05-31) — `ai` is the capability+creds
-- CARBON-COPY that confirms the email (Phase 3k) playbook generalizes. It
-- CONSOLIDATES the pre-migration `types.fenel` (the 2 paired ADTs) + the
-- retired TS `engine/src/modules/ai.ts` (1 `defineFunction` spec + a TS
-- `ClassSeed` capability const + 2 TS provider-instance consts + inline
-- creds) into one `module ai where` file + sidecars, mirroring `email`.
-- Source-of-truth split:
--   - THIS file        — the header + 2 `data` decls + the lone `callLLM`
--                        @native FOREIGN DECLARATION (sig + @label /
--                        @description / @tags facets);
--   - `capability.fenel` — the `AI` capability as a record-of-methods type
--                        → seedFromType → the dispatch seed.
--   - `instances.fenel`  — the 2 provider instances (anthropic / openai) as
--                        Fenel typed values (codec string-method model).
--   - `credentials.fenel` — the 2 provider credential requirements as typed
--                        ProviderCredentials values (loaded as a sidecar).
--
-- SIMPLER than email on every axis: NO `ffi/` leaf, NO `nativeImpls` map, NO
-- dotted-name rename (the `complete` method is a plain ident), 1 fn vs 5.
-- `callLLM` is a BODYLESS substrate primitive backed by a runtime IO handler
-- (the `payments:createStripeCheckoutSession` precedent — a `@native` foreign
-- decl, NO `nativeImpls` on the module, NO `ffi/` leaf; the runtime handler
-- stays as-is, a different surface). The capability `AI.complete` is the
-- dispatch surface; `callLLM` is a separate function surface.
--
-- Identity parity: the retired `callLLM` defineFunction carried codeName +
-- label + description + category="ai" + tags. The `module ai where` header
-- supplies the `ai` category as the read-time Categorizable default (Phase
-- 3j — derives from the `ai:` id prefix), so NO `@category` directive is
-- authored; `@label` / `@description` / `@tags` reproduce the rest.
--
-- The `{}` empty-record placeholders (`Parsed.value: {}`, `callLLM`'s
-- `outputSchema` / `reasoning`) ride along VERBATIM — they are the documented
-- anti-pattern preserved for PARITY (the parsed structured output's real shape
-- is `$el (call: ["schemaOf", {var: "outputSchema"}])`, a dependent type), NOT
-- "fixed" here. The header keeps the LEGACY lowercase `ai:` id-prefix.
-- =========================================================================

module ai where

-- ----- Data types (2, consolidated from types.fenel) -----------------------

-- AIResponse covers the success branch — Parsed structured output (value is
-- the `{}` placeholder; the real per-call shape is the caller's outputSchema)
-- or Raw free text.
AIResponse = Parsed value: {} | Raw text: String

-- AIError covers the failure modes the LLM transport surfaces. RateLimit's
-- retryAfter is `Maybe Number` — Nothing when the provider gives no hint.
AIError = NetworkError message: String | RateLimit retryAfter: Maybe Number | AuthError message: String | TokenLimit used: Number max: Number

-- ----- Functions -----------------------------------------------------------

-- callLLM — FOREIGN DECLARATION (@native): send a prompt to an LLM provider
-- and get a `Result AIError AIResponse` back. Bodyless substrate primitive
-- backed by a runtime IO handler (NOT a `nativeImpls` ffi/ leaf — the same
-- surface as `payments:createStripeCheckoutSession`). If outputSchema is
-- provided, the provider attempts structured parsing.
@native
@label "Call LLM"
@description "Send a prompt to an LLM provider and get a response. If outputSchema is provided, attempts structured parsing."
@tags "ai" "llm" "typeclass"
callLLM : (prompt: String, outputSchema: {}, system: String, temperature: Number, maxTokens: Number, reasoning: {}) -> Result AIError AIResponse
