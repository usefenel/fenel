-- =========================================================================
-- AI — provider credential requirements (module-substrate Phase 3l;
-- carbon-copy of email's `credentials.fenel`).
--
-- The cash-out of "creds are data": the per-provider environment-variable
-- requirements that were a TS `ProviderCredentials[]` const in the retired
-- `engine/src/modules/ai.ts` are now Fenel-authored typed values. Each is a
-- `ProviderCredentials { capability, provider, envVars }` value-decl; the seam
-- loads this file as a SIDECAR ({dispatchInstanceFile:true}), reads each
-- projected `{typeName:"ProviderCredentials", methods:{capability, provider,
-- envVars}}` back, and reassembles the byte-identical `ProviderCredentials[]`
-- for the Module `credentialRequirements` field. These value-decls are NOT
-- merged into `aiModule.instances` — they never reach the spec registry, so
-- they carry no dispatch / law footprint; they are pure data read at the seam.
--
-- Order (anthropic / openai) + envVars are preserved verbatim so the
-- round-trip is byte-identical to the retired const.
--
-- capability + provider ride as STRING FIELDS (not type-application args) so
-- the body-only construct projection (`deriveTypedValueDecl`) round-trips them
-- without needing a lowercase type-app arg or a registered `Credentialed`
-- class — the cleaner, parser-risk-free shape (email's precedent).
-- =========================================================================

anthropicCredentials : ProviderCredentials
anthropicCredentials = ProviderCredentials { capability = "AI", provider = "anthropic", envVars = ["ANTHROPIC_API_KEY"] }

openaiCredentials : ProviderCredentials
openaiCredentials = ProviderCredentials { capability = "AI", provider = "openai", envVars = ["OPENAI_API_KEY"] }
