-- inputs.fenel — typed input events from peripheral devices
--
-- Surface-level sketch. NOT wired to any IO handler yet — this is a
-- design anchor for upcoming consumers (browser-runtime games,
-- native desktop input). See design/inputs.md for the full design.
--
-- Four layers stacked:
--   1. Per-device event ADTs        (KeyEvent, MouseEvent, …)
--   2. Capability typeclasses       (HasButtons, HasAxes, …)
--   3. EventSource — dependent tie  (Event { source, at, payload })
--   4. State as fold                (applyKeyEvent → KeyboardState)

-- ─── 1) Per-device event ADTs ─────────────────────────────────────

KeyEvent
  = KeyDown { key: Key, mods: KeyMods }
  | KeyUp   { key: Key, mods: KeyMods }

KeyMods = KeyMods { shift: Bool, ctrl: Bool, alt: Bool, meta: Bool }

-- Open key namespace: stdlib keys + vendor-defined + user macros.
-- Lets third-party devices (Stream Deck, custom macropads) plug in
-- without parser changes.
Key
  = StandardKey { std: StdKey }
  | VendorKey   { id: String }
  | MacroKey    { id: Id<MacroDefinition> }

-- Standard key set — illustrative subset. Full set lands when a
-- consumer commits to it; abbreviated here to keep the sketch tight.
StdKey
  = KeyA | KeyB | KeyC | KeyD | KeyE | KeyF | KeyG | KeyH | KeyI
  | KeyJ | KeyK | KeyL | KeyM | KeyN | KeyO | KeyP | KeyQ | KeyR
  | KeyS | KeyT | KeyU | KeyV | KeyW | KeyX | KeyY | KeyZ
  | Key0 | Key1 | Key2 | Key3 | Key4 | Key5 | Key6 | Key7 | Key8 | Key9
  | KeyEnter | KeySpace | KeyEscape | KeyTab | KeyBackspace
  | KeyArrowUp | KeyArrowDown | KeyArrowLeft | KeyArrowRight
  | KeyShiftLeft | KeyShiftRight
  | KeyCtrlLeft  | KeyCtrlRight
  | KeyAltLeft   | KeyAltRight
  | KeyMetaLeft  | KeyMetaRight

MouseEvent
  = MouseMove   { x: Number, y: Number }
  | MouseButton { button: MouseButton, state: ButtonState }
  | MouseScroll { dx: Number, dy: Number }

MouseButton
  = MousePrimary | MouseSecondary | MouseMiddle
  | MouseAux    { index: Number }

ButtonState = Pressed | Released

TouchEvent
  = TouchStart  { id: TouchId, x: Number, y: Number }
  | TouchMove   { id: TouchId, x: Number, y: Number }
  | TouchEnd    { id: TouchId }
  | TouchCancel { id: TouchId }

TouchId = TouchId { value: Number }

GamepadEvent
  = GamepadButton { button: Number, value: Number }
  | GamepadAxis   { axis: Number, value: Number }

-- ─── 2) Capability typeclasses ────────────────────────────────────
-- Orthogonal to "which device" — what channels does it expose?
-- Instance declarations land alongside concrete-device entities.
--
-- fenel-surface-extensions Phase 2 (D-F): "typeclasses are types" — a class IS
-- a (single-constructor) record type, a method IS a field. The rejected
-- `class HasButtons s where buttons :: Id<s> -> List Button` keyword form
-- (D-B) is now the keyword-free SINGLE-CONSTRUCTOR SUGAR: the ctor name
-- defaults to the type name, so `HasButtons s = buttons: …` reads as a class
-- declaration WITHOUT a keyword. (`::` is dropped — signatures use `:`, D-C.)

HasButtons s  = buttons:  Id<s> -> List Button

HasAxes s     = axes:     Id<s> -> List Axis

HasGestures s = gestures: Id<s> -> List Gesture

Haptic s      = rumble:   Id<s> -> Strength -> IO Unit

HasCursor s   = cursor:   Id<s> -> Point

-- Marker types referenced by the capabilities above. Real definitions
-- belong to a foundations module; placeholders here for the sketch.
Button   = Button   { label: String }
Axis     = Axis     { label: String, min: Number, max: Number }
Gesture  = Gesture  { label: String }
Strength = Strength { value: Number }      -- 0.0 - 1.0
Point    = Point    { x: Number, y: Number }

-- ─── 3) EventSource — the dependent tie ───────────────────────────
-- Each device gets an EventSource instance whose `eventType` returns
-- the event ADT it emits. The Event wrapper's payload type follows.

-- Same single-constructor sugar (Phase 2): the `EventSource` class is the
-- record type `EventSource s = eventType: Id<s> -> Type`.
EventSource s = eventType: Id<s> -> Type

Event a = Event {
  source:  Id<a>,
  at:      Timestamp,
  payload: $el (eventType source)         -- dependent on the source
}

-- ─── Concrete device entities ─────────────────────────────────────
-- Each gets an EventSource instance pinning its event type plus
-- whichever capability instances it satisfies. Wiring lands with
-- the runtime IO handlers (browser DOM bridge, native event loop).

Keyboard    = Keyboard    { layout: String }
Mouse       = Mouse       { dpi: Maybe Number }
TouchScreen = TouchScreen { width: Number, height: Number }
Gamepad     = Gamepad     { vendor: String, product: String }

-- Capability profiles (informal — instance forms TBD; see
-- design/unified-dispatch.md for instance declaration syntax):
--   Keyboard    : EventSource + HasButtons
--   Mouse       : EventSource + HasButtons + HasAxes + HasCursor
--   TouchScreen : EventSource + HasAxes + HasGestures
--   Gamepad     : EventSource + HasButtons + HasAxes + HasGestures + Haptic

-- ─── 4) State as fold — pull side of pull/push duality ────────────
-- The event stream is push; folding it yields current state, which a
-- game loop polls each frame ("is W held right now?").

KeyboardState = KeyboardState { held: Map<Key, Timestamp> }

emptyKeyboardState = KeyboardState { held = mapEmpty }

applyKeyEvent state ev =
  case ev of
    KeyDown { key } ->
      KeyboardState { held = mapInsert key (now ()) state.held }
    KeyUp { key } ->
      KeyboardState { held = mapDelete key state.held }

isHeld key state = mapHas key state.held

-- Illustrative usage (not wired to a runtime):
--   currentState = foldl applyKeyEvent emptyKeyboardState eventStream
--   if isHeld (StandardKey { std = KeyW }) currentState then …
