-- =========================================================================
-- compile-wasm target AST surface — canonical declaration site for every
-- entity in the Wasm-target compilation pipeline's typed IR.
--
-- Phase 4j of ts-elimination: consolidates the per-target deep AST ADTs
-- that Phase 4h's program-envelope tier had to leave as lazy `a` field
-- refs. Pre-4j these ~19 entities were declared inside
-- `fenel/modules/engine/lower-to-wasm-ast.fenel` (the Wasm lowering pass
-- body); only `WasmModule` was dual-declared between the body file and
-- this types file (Phase 4h's program-envelope tier authored the
-- WasmModule shape here while lower-to-wasm-ast.fenel kept its own copy —
-- shapes matched, dedup silently inert). Post-4j this file is the single
-- canonical declaration site for the full Wasm-target AST surface;
-- lower-to-wasm-ast.fenel keeps its function bodies only.
--
-- Provenance: derived from
-- `implementations/typescript/engine/src/ir/wasm-ast.ts`, then specialised to
-- the operational shape produced and consumed by the Fenel lowering/encoder.
-- The public TS IR is deliberately wider in a few future-only places:
--
--   * optional TS properties on the GC/memory/EH/component catalog surface
--     are recorded here in their required, present-property form;
--   * `I64Const.value` stays `Any` until the host `bigint` atom (`JsBigInt`)
--     is registry-resolvable; the current lowerer/encoder never emits it;
--   * TS literal-string unions are represented by their `String` carrier for
--     `RefNull.heapType` and `WasmExport.kind`;
--   * `WasmModule.types` / `.imports` name the function-only collections the
--     current producer and encoder support, rather than the wider future TS
--     `WasmTypeDecl` / `WasmImport` unions.
--
-- `Boolean` is the canonical Fenel foundation atom name (the TS helper export
-- for that atom happens to be named `Bool`).
-- =========================================================================

-- ---------------------------------------------------------------------------
-- WasmValType — Wasm 3.0 numeric + reference types.
-- ---------------------------------------------------------------------------
-- 6 atomic variants + 2 typed-ref variants (RefStruct/RefArray carry a
-- type-section index). This part of the operational IR has the same variant
-- and payload layout as ir/wasm-ast.ts:WasmValType.
WasmValType =
  I32
  | I64
  | F32
  | F64
  | Externref
  | Funcref
  | RefStruct typeIdx: Number
  | RefArray typeIdx: Number

-- ---------------------------------------------------------------------------
-- WasmDomain — source-level domain of a Wasm value. The TS oracle's
-- `inferDomains` populates a Map<String, WasmDomain> by walking the body;
-- we marshal that map across the call boundary as a list of DomainEntry.
-- ---------------------------------------------------------------------------
WasmDomain =
  DomNum
  | DomBool
  | DomRef
  | DomUnknown

-- DomainEntry — one entry in the marshalled domain env. Built by the
-- dispatch wrapper from the TS-side `inferEnv` map (name → domain) so
-- the Fenel body has named lookup access without re-running inference.
DomainEntry = DomainEntry name: String domain: WasmDomain

-- ---------------------------------------------------------------------------
-- WasmFuncType — (params) -> (results). Wasm allows multi-result; the
-- bootstrap emits single-result but the type supports the general shape.
-- ---------------------------------------------------------------------------
WasmFuncType = WasmFuncType params: List WasmValType results: List WasmValType

-- ---------------------------------------------------------------------------
-- WasmGC struct + array — catalog declarations for follow-on phases. Phase
-- 21.7's lowering doesn't construct these. Their TS `name?` fields are
-- optional on the public boundary; these declarations describe the required
-- present-name form until a future boundary adapter normalises absence.
-- ---------------------------------------------------------------------------
WasmStructField = WasmStructField name: String valType: WasmValType mutable: Boolean

WasmStructType = WasmStructType name: String fields: List WasmStructField

WasmArrayType = WasmArrayType name: String element: WasmStructField

-- ---------------------------------------------------------------------------
-- Imports — function / memory / global. Phase 21.7 emits and encodes function
-- imports only. Memory/global are catalog declarations for future work;
-- `limits.max` is the required present-max form of TS's optional property.
-- ---------------------------------------------------------------------------
WasmFuncImport = WasmFuncImport module: String name: String funcType: WasmFuncType

WasmMemImport = WasmMemImport module: String name: String limits: { min: Number, max: Number }

WasmGlobalImport = WasmGlobalImport module: String name: String valType: WasmValType mutable: Boolean

-- ---------------------------------------------------------------------------
-- WasmBlockType — block result-type tag for structured control flow.
-- Three variants: empty (no result), single value-type, or arbitrary
-- multi-result type-section reference.
-- ---------------------------------------------------------------------------
WasmBlockType =
  BlockTypeEmpty
  | BlockTypeValue valType: WasmValType
  | BlockTypeFunc typeIdx: Number

-- ---------------------------------------------------------------------------
-- WasmInstr — typed ADT of the Wasm opcodes Phase 21.7's lowering emits plus
-- catalog variants for follow-on phases. `I64Const.value` is an explicit
-- host-bigint boundary (`Any`), `RefNull.heapType` uses the String carrier of
-- the TS literal union, and future-only `Try.catchAll` records the required
-- present-property form of TS's optional field.
-- ---------------------------------------------------------------------------
WasmInstr =
  -- Constants
  I32Const value: Number
  | I64Const value: Any
  | F32Const value: Number
  | F64Const value: Number
  -- Locals
  | LocalGet index: Number
  | LocalSet index: Number
  | LocalTee index: Number
  -- i32 arith / logic
  | I32Add
  | I32Sub
  | I32Mul
  | I32DivS
  | I32RemS
  | I32And
  | I32Or
  | I32Xor
  | I32Eqz
  | I32Eq
  | I32Ne
  | I32LtS
  | I32LeS
  | I32GtS
  | I32GeS
  -- f64 arith
  | F64Add
  | F64Sub
  | F64Mul
  | F64Div
  | F64Neg
  | F64Abs
  -- f64 comparison (-> i32 0/1)
  | F64Eq
  | F64Ne
  | F64Lt
  | F64Le
  | F64Gt
  | F64Ge
  -- Conversions
  | I32WrapI64
  | I64ExtendI32S
  | F64ConvertI32S
  | I32TruncF64S
  -- Control flow
  | If blockType: WasmBlockType then: List WasmInstr else: List WasmInstr
  | Block blockType: WasmBlockType body: List WasmInstr
  | Loop blockType: WasmBlockType body: List WasmInstr
  | Br depth: Number
  | BrIf depth: Number
  | Return
  | Unreachable
  | Nop
  | Drop
  | Select
  -- Calls
  | Call funcIdx: Number
  | CallIndirect typeIdx: Number tableIdx: Number
  -- Reference ops
  | RefNull heapType: String
  | RefIsNull
  -- WasmGC (declared for follow-on)
  | StructNew typeIdx: Number
  | StructGet typeIdx: Number fieldIdx: Number
  | StructSet typeIdx: Number fieldIdx: Number
  | ArrayNew typeIdx: Number
  | ArrayGet typeIdx: Number
  | ArraySet typeIdx: Number
  | ArrayLen
  -- Exception handling (declared for follow-on)
  | Try blockType: WasmBlockType body: List WasmInstr catches: List ({ tagIdx: Number, body: List WasmInstr }) catchAll: List WasmInstr
  | Throw tagIdx: Number

-- ---------------------------------------------------------------------------
-- WasmLocalDecl — RLE-encoded local declaration: `count` consecutive
-- locals of `valType`. Wasm's locals section uses this shape; the AST
-- mirrors it. `rleLocals` collapses a flat list into this form.
-- ---------------------------------------------------------------------------
WasmLocalDecl = WasmLocalDecl count: Number valType: WasmValType

-- ---------------------------------------------------------------------------
-- WasmFunc — typed signature + locals + body. Locally-defined functions
-- follow imports in the function index space.
-- ---------------------------------------------------------------------------
WasmFunc = WasmFunc name: String funcType: WasmFuncType locals: List WasmLocalDecl body: List WasmInstr

-- ---------------------------------------------------------------------------
-- WasmExport — exported entity at an index in its respective space. The TS
-- `"func" | "table" | "memory" | "global"` kind union uses its String
-- carrier here. Phase 21.7 emits one func export for the entry plus
-- per-closure-body exports.
-- ---------------------------------------------------------------------------
WasmExport = WasmExport name: String kind: String index: Number

-- ---------------------------------------------------------------------------
-- WasmComponentExport — catalog-only Component Model metadata. Its optional
-- TS `returnType?: unknown` payload is represented by a required `Any` field
-- in this present-property form. The Phase 21.7 body does not construct this
-- tagged entity: it emits the untagged `{name, params}` record declared inline
-- in WasmModule below.
-- ---------------------------------------------------------------------------
WasmComponentExport = WasmComponentExport name: String params: List CompileFieldSlot returnType: Any

-- ---------------------------------------------------------------------------
-- WasmModule — operational program-level envelope. The current Fenel producer
-- always carries `componentExports` and `stringPool` as lists; the dispatch
-- wrapper strips an empty stringPool at the TS wire boundary. `types` and
-- `imports` intentionally name the function-only subset accepted by the
-- current encoder. `componentExports` uses an inline untagged record because
-- that is the actual lowerer output; the catalog-only entity above has a
-- different, future-facing shape.
-- ---------------------------------------------------------------------------
WasmModule = WasmModule name: String fieldSlots: List CompileFieldSlot types: List WasmFuncType imports: List WasmFuncImport funcs: List WasmFunc exports: List WasmExport componentExports: List ({ name: String, params: List CompileFieldSlot }) stringPool: List String

-- ---------------------------------------------------------------------------
-- WasmDirectOp — encoded mapping from canonical codeName to Wasm
-- direct-op shape. Mirrors compile-wasm.ts:DIRECT_NUMERIC_OPS /
-- DIRECT_COMPARISON_OPS. The opaque dispatch on fnId-as-string string
-- uses this ADT to keep the per-case typing exhaustive.
-- ---------------------------------------------------------------------------
WasmDirectOp =
  WDNumeric op: WasmInstr resultDomain: WasmDomain
  | WDComparison op: WasmInstr
  | WDNoDirectOp

-- ---------------------------------------------------------------------------
-- CallDomain — argDomains + resultDomain pair returned by callDomainOf.
-- Encoded as a named-field record so the Fenel body can pattern-bind
-- both fields uniformly across all dispatch arms.
-- ---------------------------------------------------------------------------
CallDomain = CallDomain argDomains: List WasmDomain resultDomain: WasmDomain

-- ---------------------------------------------------------------------------
-- LowerOutput — (instrs, domain) pair returned by the per-CeExpr lowering.
-- Wrapped in a Result via Err/Ok at call sites; the named-record form lets
-- the body access `.instrs` and `.domain` symmetrically across every arm.
-- Mirrors the TS oracle's `(WasmInstr[], WasmDomain)` tuple that
-- `lowerExprInternal` produces via the out-array + return-domain split.
-- ---------------------------------------------------------------------------
LowerOutput = LowerOutput instrs: List WasmInstr domain: WasmDomain
