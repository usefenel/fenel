-- =========================================================================
-- compile-wasm — bodyless @native sigs for the seven Wasm-target pipeline
-- steps.
--
-- module-substrate Phase 3v.5 (2026-06-01) — sibling of compile-js/sigs.fenel
-- and compile-llvm/sigs.fenel. The TS impls (step natives in
-- engine/src/modules/compile-wasm.ts) STAY — they're the irreducible host
-- leaves that walk the typed IR through engine-bodies-dispatch.ts. This
-- file is the FENEL-AUTHORED sig surface; the union (types.fenel +
-- instances.fenel + sigs.fenel) groups all three under the compile-wasm
-- module name supplied by the loader arg. Every @label / @description /
-- @category / @tags directive mirrors the retired TS second-arg facet
-- record byte-identically.
--
-- Three of the 7 sigs carry an explicit @codeName: the per-target Wasm
-- spec gave the first three pipeline steps target-suffixed global codeNames
-- (normaliseToCoreForWasm / makeEffectsExplicitForWasm /
-- makeClosuresExplicitForWasm) while keeping the short fnId suffix
-- (compile-wasm:normaliseToCore / …). Default behaviour stamps codeName
-- == def-name; @codeName overrides for these three so the byte-identical
-- codeName-driven Codeable surface is preserved.
--
-- The 7 sigs (in spec-list order, preserved for stable instance ordering):
--   normaliseToCore       — codeName normaliseToCoreForWasm
--   makeEffectsExplicit   — codeName makeEffectsExplicitForWasm
--   makeClosuresExplicit  — codeName makeClosuresExplicitForWasm
--   lowerToWasmAst        — codeName lowerToWasmAst
--   serializeWasmModule   — Iso Bytes WasmModule encode side
--   deserializeWasmModule — Iso Bytes WasmModule decode side (Phase 13 stub)
--   compileFenelToWasm    — top-level pipeline (CompileSource into WasmModule)
--
-- No `module ... where` header — `compile-wasm` contains a hyphen which the
-- ident lexer splits on. The loader name-arg (set by compile-wasm.ts)
-- supplies the module identity instead; the three files share that arg
-- and union under the same group.
-- =========================================================================

@native
@codeName "normaliseToCoreForWasm"
@label "Lower → Core (Wasm path)"
@description "Lower a CompileSource (signature + JSON-Logic body + declared `requires`) to the Core IR for the Wasm target. Shares the engine-wide Core IR with the JS target — the same lowering, the same diagnostics. Surfacing this as a per-target function-id ensures the Phase 5 lowering's structural metadata is reachable from both compile-js and compile-wasm registry entries."
@category "compile-wasm"
@tags "compile" "lowering" "ir" "wasm"
normaliseToCore : (source: CompileSource) -> Result CompileError CoreProgram

@native
@codeName "makeEffectsExplicitForWasm"
@label "Lower → EffectsExplicit (Wasm path)"
@description "Make effect-dispatch sites explicit. Phase 15: recognises `$effect:<Class>:<method>` sentinel fnIds in CoreCall sites and populates the `effects` inventory + `handlerSites` list. Per-target lowering (`lowerToWasmAst`) emits `(import \"$effect.<Class>\" \"<method>\" …)` declarations + corresponding call instructions; the host runtime binds each import at instantiation time by walking the typeclass instance dispatch scope."
@category "compile-wasm"
@tags "compile" "lowering" "ir" "effects" "wasm"
makeEffectsExplicit : (core: CoreProgram) -> Result CompileError EffectsExplicitProgram

@native
@codeName "makeClosuresExplicitForWasm"
@label "Lower → ClosuresExplicit (Wasm path)"
@description "Closure-convert: walk the IR, compute the free-variable set of each lambda, materialise it as the closure's `captures` list. Wasm doesn't have lexical closures natively — the captures list is essential for the WasmGC struct that backs a closure. Phase 13 reuses the same pass as compile-js since the closures-explicit form is target-agnostic."
@category "compile-wasm"
@tags "compile" "lowering" "ir" "closures" "wasm"
makeClosuresExplicit : (ee: EffectsExplicitProgram) -> Result CompileError ClosuresExplicitProgram

@native
@label "Lower → WasmAst"
@description "Lower a ClosuresExplicitProgram to WasmAst. Maps Fenel std-op subset to direct Wasm 3.0 numeric / comparison ops (`add` → `f64.add`, `lt` → `f64.lt`, …) where the semantics align; routes other calls through a `$fenel.<fnId>(...)` import (declared at the module's import section, resolved by the host runtime at instantiation). Effect-dispatch sites (`$effect:<Class>:<method>` sentinel fnIds — Phase 15) lower to `$effect.<Class>.<method>` imports with `(externref…) → externref` signatures; the host walks the typeclass instance dispatch scope (`resolveEffect`) at instantiation time and binds each import to the resolved method. String literals intern into the module's `stringPool` and emit `$fenel.litString(<idx>)` runtime-helper calls; the host populates `litString` from the pool. Type inference picks `f64` / `i32` / `externref` for each param + return based on usage in the body."
@category "compile-wasm"
@tags "compile" "lowering" "ir" "wasm"
lowerToWasmAst : (ce: ClosuresExplicitProgram) -> Result CompileError WasmModule

@native
@label "Serialize WasmModule"
@description "Serialize a WasmModule to the `.wasm` binary format per the W3C Wasm 3.0 spec. The encode side of `Iso<Bytes, WasmModule>`. Output is a `Uint8Array` that `WebAssembly.instantiate` (or any Wasm runtime) can consume directly."
@category "compile-wasm"
@tags "compile" "serialize" "wasm" "codec"
serializeWasmModule : (module: WasmModule) -> Result String Bytes

@native
@label "Deserialize WasmModule (placeholder)"
@description "The decode side of `Iso<Bytes, WasmModule>`. Phase 13 stub — always returns Err. A real parser lands when a use case demands round-tripping compiled `.wasm` back into the typed WasmAst (e.g. for further rewriting / linking / introspection)."
@category "compile-wasm"
@tags "compile" "deserialize" "wasm" "codec" "placeholder"
deserializeWasmModule : (encoded: Bytes) -> Result String WasmModule

@native
@label "Compile Fenel → Wasm"
@description "Top-level CompileWasm pipeline: CompileSource → CoreProgram → EffectsExplicitProgram → ClosuresExplicitProgram → WasmModule. Steps 1–3 are reused unchanged from Phase 5 (the substrate is target-agnostic). Step 4 — `lowerToWasmAst` — handles direct numeric ops + runtime-helper imports + (Phase 15) effect-dispatch sentinel sites. Pair with `serializeWasmModule` to obtain the `.wasm` byte string. Effect imports (`$effect.<Class>` namespaces) are bound at instantiation time by walking the typeclass instance dispatch scope — see `design/effectful-compilation.md` for the per-target ABI shapes (Wasm / JS / LLVM all reuse the same `resolveEffect` walk)."
@category "compile-wasm"
@tags "compile" "pipeline" "wasm"
compileFenelToWasm : (source: CompileSource) -> Result CompileError WasmModule
