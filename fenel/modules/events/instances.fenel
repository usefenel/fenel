-- Events dispatch instances (typed-function-references Phase 10c).
--
-- Sampleable<Behavior> / Sampleable<Event> — entries in the polymorphic sample
-- dispatch table. `.fenel` value-decls (the Phase-10 loader flip lowers the
-- point-free method refs to the dispatch-ready `{$ref}` codeName handle; the
-- registry resolves them to `events:sampleBehavior` / `events:sampleEvent`).
-- Loaded with `dispatchInstanceFile: true`.
sampleableBehavior : Sampleable Behavior
sampleableBehavior = Sampleable { sample = sampleBehavior }

sampleableEvent : Sampleable Event
sampleableEvent = Sampleable { sample = sampleEvent }
