-- =========================================================================
-- Events — FRP for Fenel. Parametric `EventEntry<a>`, `Event<a>`, and
-- `Behavior<a>` carry the type-var `a` through the catalog as a $named
-- ref; the inline `constant` helper produces a constant Behavior whose
-- closure ignores its time argument.
--
-- module-substrate Phase 3i (2026-05-30) — events is a DISJOINT plain/ctx
-- module (= picture's 3f shape). The ~494-LOC hand-assembled TS module
-- (engine/src/modules/events.ts — 10 `defineFunction` specs + inline native
-- impls + the 3 sub-`.fenel` body merges) is RETIRED. This file is the
-- consolidated source of truth: the 3 entities + the 3 Fenel-bodied
-- constructors (`event` / `eventEntry` / `sampleEvent`, CONSOLIDATED from the
-- former event.fenel / event-entry.fenel / sample-event.fenel sidecars,
-- 3b/3g consolidation, now DELETED) + the `constant` helper + the 7 @native
-- FOREIGN DECLARATIONS (1 plain `_stepLookup` → nativeImpls; 6 ctx
-- `step` / `accum` / `_accumFold` / `sampleBehavior` / `behaviorToAnim` /
-- `behaviorToSound` → nativeImplsCtx). Their impls live in ffi/events-ffi.ts.
-- Plain-vs-ctx is decided by which seam map an impl lands in — the @native
-- decl is uniform, no marker (axis #4). The lowercase `events` name +
-- `events:` id-prefix + `events` category stay byte-identical.
--
-- ⚠ `ingress.fenel` in this same dir belongs to mixed-ingress — it is NOT
-- part of the events module and is left untouched.
--
-- Phase 4g of ts-elimination: this body was originally the inline
-- `const EVENTS_SRC = \`…\`` template literal at engine/src/modules/events.ts;
-- extracted verbatim with the JS template-literal `\\t` lambda escape
-- collapsed to single-backslash `\t`. `Time` resolves through the catalog
-- walk against the sound module which loads first.
-- =========================================================================

module events where

EventEntry<a> = EventEntry timestamp: Number payload: a

Event<a> = Event entries: [EventEntry]

Behavior<a> = BehaviorAt (Time -> a)

-- ----- Foreign declarations (native-backed; impl in ffi/events-ffi.ts) -----

@native
@label "step lookup (internal)"
@description "Internal helper: most-recent-event-payload-or-init lookup. Used by step."
@tags "frp" "events" "internal"
_stepLookup : (init: a, entries: List EventEntry, t: Time) -> a

@native
@label "accum fold (internal)"
@description "Internal helper: fold-events-up-to-t. Used by accum."
@tags "frp" "events" "internal"
_accumFold : (init: a, fn: ((s: a, p: b) -> a), entries: List EventEntry, t: Time) -> a

@native
@label "Step"
@description "Hold the most recent event payload as a Behavior. step init evt at time t = payload of most recent event with timestamp <= t, or init before any."
@tags "frp" "events" "bridge"
step : (init: a, event: Event) -> Behavior

@native
@label "Accumulate"
@description "Fold events into a state Behavior. accum init fn events at time t = fold fn init (events with timestamp <= t)."
@tags "frp" "events" "bridge" "higher-order"
accum : (init: a, fn: ((s: a, p: b) -> a), event: Event) -> Behavior

@native
@label "Sample behavior"
@description "Sample a Behavior at a Time, returning the value at that instant."
@tags "frp" "primitive"
sampleBehavior : (behavior: Behavior, t: Time) -> a

@native
@label "Behavior to Animation"
@description "Bridge a Behavior Picture into an Animation. Just retags — both are time-indexed function wrappers."
@tags "frp" "bridge"
behaviorToAnim : (behavior: Behavior) -> animation.Animation

@native
@label "Behavior to Sound"
@description "Bridge a Behavior Amplitude into a Sound."
@tags "frp" "bridge"
behaviorToSound : (behavior: Behavior) -> Sound

-- ----- Fenel-bodied constructors (consolidated from the former sidecars) -----

-- event — construct typed Event record from a list of EventEntry values.
-- Consolidated from the former events/event.fenel sidecar (Phase 5b10).
event : List EventEntry -> Event
@label "Event"
@description "Build an Event from a list of timestamped EventEntry values. Returns the canonical typed `{$tag: \"Event\", entries: [...]}` shape via the Event constructor."
@tags "frp" "events" "constructor"
event entries = Event { entries = entries }

-- eventEntry — construct typed EventEntry record from a timestamp (seconds)
-- and a polymorphic payload. Consolidated from the former events/event-entry.fenel
-- sidecar (Phase 5b10).
eventEntry : Number -> a -> EventEntry
@label "Event entry"
@description "Build an EventEntry from a timestamp (seconds) and a polymorphic payload. Returns the canonical typed `{$tag: \"EventEntry\", timestamp, payload}` shape via the EventEntry constructor."
@tags "frp" "events" "constructor"
eventEntry timestamp payload = EventEntry { timestamp = timestamp, payload = payload }

-- sampleEvent — sample an Event at a Time. Returns `Just payload` for an
-- event firing exactly at that timestamp, or `Nothing` when no entry matches.
-- Consolidated from the former events/sample-event.fenel sidecar (Phase 5b12).
-- Named-field `Just e` pattern is load-bearing — std-lib Maybe uses named
-- fields, so a positional `Just e` would parse but not bind at runtime.
sampleEvent : Event -> Time -> Maybe a
@label "Sample event"
@description "Sample an Event at a Time. Returns `Just payload` for an event firing exactly at that timestamp, or `Nothing` when no event matches. Conformant Maybe(aVar) return shape post-Phase 5b12 — previously the TS native returned non-conformant `null` for the unknown case; downstream callers using legacy `expect(...).toBe(null)` must update to `.toEqual({$tag: \"Nothing\"})`."
@tags "frp" "events" "primitive"
sampleEvent event t =
  case find (\e -> eq e.timestamp t.seconds) event.entries of
    Nothing -> Nothing
    Just e -> Just (e.payload)

-- A constant behavior: same value at every time.
constant : a -> Behavior a
constant v = BehaviorAt (\t -> v)
