-- =========================================================================
-- Generic event ingress + cross-cut emit primitive.
--
-- Phase 12c-routes sub-step 2 of the ts-elimination workstream. Sister of
-- sub-step 1's emailWebhooks:emitEmailEvent — wraps the 2-step generic
-- emit tail (appendEvent + dispatchEventTriggers) for the non-email
-- ingress routes.
--
-- emitEvent is the cross-cut: calendly + events-inbound + telegram-webhook
-- all compose it. The redirect route uses appendEvent alone (clicks aren't
-- trigger sources; no dispatch).
--
-- Decisions resolved:
--   I3 (verify in TS wrapper; Fenel body sees verified payload).
--   S (profileId param as Maybe<String>; Nothing unwraps cleanly to the
--     runtime's undefined).
--
-- Substrate primitives consumed:
--   - state:appendEvent (existing — 12a-1)
--   - state:dispatchEventTriggers (existing — 12a-1)
--
-- module-substrate Phase 3p (2026-05-31) — the AGGREGATION-FRONTIER CLOSE.
-- The retired `engine/src/modules/mixed-ingress.ts` junk-drawer BUNDLE loaded
-- this file (under the throwaway internal name `events-ingress`) + 5 sibling
-- files, hand-extracted every body by id, and re-wrapped each in a
-- `defineFunction` spec stamping the public prefixes. It is DISSOLVED: each
-- prefix lands in a SEMANTIC home. `emitEvent` + `eventsInbound` MERGE into the
-- already-migrated `events` module (events.ts now unions types.fenel ∪ this
-- file via `loadFenelModuleUnion`) — so this file carries the `module events
-- where` header. No stored @category (derives at read time from the `events:`
-- id prefix, Phase 3j). HasStateIO is INFERRED transitively from the state:* /
-- emit calls (the 3a precedent), not hand-declared.
-- =========================================================================

module events where

-- emitEvent — the cross-cut generic emit tail. Composes appendEvent +
-- dispatchEventTriggers into one Fenel-bodied primitive. Per sub-step 1's
-- pattern, each call sits on its own line (parseApp doesn't continue arg
-- lists across newlines).
--
-- profileId is Maybe<String> — Nothing flows through to appendEvent /
-- dispatchEventTriggers as undefined. The current state primitives don't
-- read profileId (they source it from the IO context); the param is
-- kept here for future expansion symmetry with the email-event tail.
@label "Emit event"
@description "Phase 12c-routes sub-step 2 — generic composing primitive. Wraps the 2-step ingress tail: appendEvent + dispatchEventTriggers. Sister of emailWebhooks:emitEmailEvent (which wraps the 4-step email-lifecycle tail). Used by events-inbound + calendly invitee.created + telegram-webhook umbrella."
@tags "events" "ingress" "phase-12c"
emitEvent : String -> {} -> Maybe String -> Unit
emitEvent eventType payload profileId =
  let _appended = appendEvent eventType payload Nothing Nothing profileId
  dispatchEventTriggers eventType payload

-- eventsInbound — POST /api/events/inbound body. The TS wrapper has
-- already verified the inbound-token + parsed the JSON body.
-- Composes emitEvent + returns the wire-stable response shape.
@label "Events inbound"
@description "POST /api/events/inbound body. The TS wrapper has already verified the x-fenel-inbound-token header + parsed the JSON body. Body composes emitEvent + returns {received: true}."
@tags "events" "ingress" "route" "phase-12c"
eventsInbound : String -> {} -> Maybe String -> {}
eventsInbound eventType payload profileId =
  let _emitted = emitEvent eventType payload profileId
  { received = true }
