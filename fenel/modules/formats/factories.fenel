-- Derived format-family factories — Fenel-bodied (Phase 3.3d,
-- typeclass-substrate-completion, 2026-05-29).
--
-- The three DERIVED typeclass-instance families — HandleFormat(platform),
-- PhoneFormat(country), DateFormat(locale) — are NOT curated constants (those
-- are the 3.3b/3.3c value-decls in instances.fenel) but FACTORIES that map
-- entity data → ClassInstance records. This file holds their factory LOGIC and
-- rules DATA, all Fenel-bodied. The TWO irreducible host leaves they lean on
-- are SetExpr-value constructors Fenel cannot author itself (record literals
-- can't carry a `$`-prefixed key):
--   * std:regexSet : String -> SetExpr  (`{$pattern}` — Phone/Handle)
--   * std:namedSet : String -> SetExpr  (`{$named}`   — Date)
-- Both are TOTAL (`regexSet` throws at boot on the unreachable malformed case,
-- mirroring the retired TS `regexSet` — fail-loud, never silent). Everything
-- else — the merge-with-default, the dial-code/min/max defaults, the per-locale
-- rules — is pure and lives here.
--
-- A ClassInstance is the plain record `{ typeName, args, methods }` downstream
-- dispatch reads (engine/src/class-types.ts). The factories return
-- `List ClassInstance` directly.
--
-- Execution: these bodies run through the engine's pure evaluator via
-- `dispatchEngineBody` (engine-bodies-dispatch.ts) — the same harness the
-- self-host compile pipeline uses. They CANNOT run during `buildRegistry`
-- (the evaluator harness pulls in the system-entities registry, which is mid-
-- initialisation there); the TS wrappers invoke them lazily, after module
-- init, and the runtime + catalog read the materialised instances. See the
-- roadmap's Phase 3.3d notes.

-- ---------------------------------------------------------------------------
-- HandleFormat(platform) — social-handle rules read straight off Platform
-- entity data (handlePattern / handlePrefix / handleMaxLength / urlTemplate are
-- already .fenel-sourced data). No curated rules table, no default — the
-- cleanest exercise of the leaf + the factory machinery, so it's the pilot.
-- ---------------------------------------------------------------------------

handleInstance : Platform -> ClassInstance
handleInstance p =
  { typeName = "HandleFormat"
  , args = [p.code]
  , methods = { pattern = regexSet p.handlePattern
              , prefix = p.handlePrefix
              , maxLength = p.handleMaxLength
              , urlTemplate = p.urlTemplate } }

deriveHandleInstances : List Platform -> List ClassInstance
deriveHandleInstances platforms = map handleInstance platforms

-- ---------------------------------------------------------------------------
-- PhoneFormat(country) — curated per-country rules + a permissive default for
-- non-curated countries. `phoneRuleFor` is the rules table as Fenel data: a
-- cascading-if over the ISO code returning `{ pattern, min, max, example }`,
-- with the final `else` the permissive default (`^[0-9]{4,15}$`, 4..15, no
-- example) — exactly the TS factory's `rule ? … : permissive` + `?? 4 / ?? 15`.
-- ---------------------------------------------------------------------------

phoneRuleFor code =
  if code == "US" then { pattern = "^[2-9]\\d{9}$", min = 10, max = 10, example = "2025551234" }
  else if code == "CA" then { pattern = "^[2-9]\\d{9}$", min = 10, max = 10, example = "6135551234" }
  else if code == "GB" then { pattern = "^[1-9]\\d{9,10}$", min = 10, max = 11, example = "7911123456" }
  else if code == "DE" then { pattern = "^[1-9]\\d{4,14}$", min = 5, max = 15, example = "15112345678" }
  else if code == "FR" then { pattern = "^[1-9]\\d{8}$", min = 9, max = 9, example = "612345678" }
  else if code == "JP" then { pattern = "^[1-9]\\d{8,9}$", min = 9, max = 10, example = "9012345678" }
  else if code == "CN" then { pattern = "^1[3-9]\\d{9}$", min = 11, max = 11, example = "13812345678" }
  else if code == "IN" then { pattern = "^[6-9]\\d{9}$", min = 10, max = 10, example = "9876543210" }
  else if code == "BR" then { pattern = "^[1-9]\\d{9,10}$", min = 10, max = 11, example = "11912345678" }
  else if code == "AU" then { pattern = "^[2-9]\\d{8}$", min = 9, max = 9, example = "412345678" }
  else if code == "RU" then { pattern = "^[3-9]\\d{9}$", min = 10, max = 10, example = "9121234567" }
  else if code == "MX" then { pattern = "^[1-9]\\d{9}$", min = 10, max = 10, example = "5512345678" }
  else if code == "KR" then { pattern = "^[1-9]\\d{7,9}$", min = 8, max = 10, example = "1012345678" }
  else if code == "IT" then { pattern = "^[0-9]\\d{5,11}$", min = 6, max = 12, example = "3123456789" }
  else if code == "ES" then { pattern = "^[6-9]\\d{8}$", min = 9, max = 9, example = "612345678" }
  else if code == "NL" then { pattern = "^[1-9]\\d{8}$", min = 9, max = 9, example = "612345678" }
  else if code == "SE" then { pattern = "^[1-9]\\d{6,9}$", min = 7, max = 10, example = "701234567" }
  else if code == "CH" then { pattern = "^[1-9]\\d{8}$", min = 9, max = 9, example = "781234567" }
  else if code == "PL" then { pattern = "^[1-9]\\d{8}$", min = 9, max = 9, example = "512345678" }
  else if code == "TR" then { pattern = "^[1-9]\\d{9}$", min = 10, max = 10, example = "5321234567" }
  else if code == "SA" then { pattern = "^[1-9]\\d{8}$", min = 9, max = 9, example = "512345678" }
  else if code == "AE" then { pattern = "^[1-9]\\d{7,8}$", min = 8, max = 9, example = "501234567" }
  else if code == "EG" then { pattern = "^[1-9]\\d{9}$", min = 10, max = 10, example = "1001234567" }
  else if code == "NG" then { pattern = "^[7-9]\\d{9}$", min = 10, max = 10, example = "8031234567" }
  else if code == "ZA" then { pattern = "^[1-9]\\d{8}$", min = 9, max = 9, example = "711234567" }
  else if code == "IL" then { pattern = "^[2-9]\\d{7,8}$", min = 8, max = 9, example = "501234567" }
  else if code == "SG" then { pattern = "^[3-9]\\d{7}$", min = 8, max = 8, example = "81234567" }
  else if code == "TH" then { pattern = "^[2-9]\\d{7,8}$", min = 8, max = 9, example = "812345678" }
  else if code == "PH" then { pattern = "^[2-9]\\d{8,9}$", min = 9, max = 10, example = "9171234567" }
  else if code == "MY" then { pattern = "^[1-9]\\d{7,9}$", min = 8, max = 10, example = "121234567" }
  else if code == "ID" then { pattern = "^[2-9]\\d{7,11}$", min = 8, max = 12, example = "81234567890" }
  else if code == "VN" then { pattern = "^[1-9]\\d{8,9}$", min = 9, max = 10, example = "912345678" }
  else { pattern = "^[0-9]{4,15}$", min = 4, max = 15, example = "" }

phoneInstance : Country -> ClassInstance
phoneInstance c =
  let rule = phoneRuleFor c.code
  { typeName = "PhoneFormat"
  , args = [c.code]
  , methods = { dialCode = c.dialCode
              , pattern = regexSet rule.pattern
              , minDigits = rule.min
              , maxDigits = rule.max
              , exampleLocal = rule.example } }

derivePhoneInstances : List Country -> List ClassInstance
derivePhoneInstances countries = map phoneInstance countries

-- ---------------------------------------------------------------------------
-- DateFormat(locale) — a fixed table of locale rules (no entity list to map
-- over, so it's 0-ary). `pattern` is a named-set ref built via `namedSet`;
-- `order` is a plain string list; the rest are plain strings. Total (no regex
-- → no Result). The locale-fallback reader (`dateFormatFor`) + the pattern
-- reader (`dateSetExpr`) stay thin TS readers over these instances
-- (modules/formats.ts) — the same instance-reader category as `phoneSetExpr`.
-- ---------------------------------------------------------------------------

deriveDateFormatInstances : List ClassInstance
deriveDateFormatInstances =
  [ { typeName = "DateFormat", args = ["iso"], methods = { pattern = namedSet "format:date:iso", template = "yyyy-MM-dd", order = ["year", "month", "day"], separator = "-", example = "2025-12-25" } }
  , { typeName = "DateFormat", args = ["en-US"], methods = { pattern = namedSet "format:date:us", template = "MM/dd/yyyy", order = ["month", "day", "year"], separator = "/", example = "12/25/2025" } }
  , { typeName = "DateFormat", args = ["en-GB"], methods = { pattern = namedSet "format:date:eu", template = "dd/MM/yyyy", order = ["day", "month", "year"], separator = "/", example = "25/12/2025" } }
  , { typeName = "DateFormat", args = ["fr"], methods = { pattern = namedSet "format:date:eu", template = "dd/MM/yyyy", order = ["day", "month", "year"], separator = "/", example = "25/12/2025" } }
  , { typeName = "DateFormat", args = ["it"], methods = { pattern = namedSet "format:date:eu", template = "dd/MM/yyyy", order = ["day", "month", "year"], separator = "/", example = "25/12/2025" } }
  , { typeName = "DateFormat", args = ["es"], methods = { pattern = namedSet "format:date:eu", template = "dd/MM/yyyy", order = ["day", "month", "year"], separator = "/", example = "25/12/2025" } }
  , { typeName = "DateFormat", args = ["de"], methods = { pattern = namedSet "format:date:eu-dot", template = "dd.MM.yyyy", order = ["day", "month", "year"], separator = ".", example = "25.12.2025" } }
  , { typeName = "DateFormat", args = ["ru"], methods = { pattern = namedSet "format:date:eu-dot", template = "dd.MM.yyyy", order = ["day", "month", "year"], separator = ".", example = "25.12.2025" } }
  , { typeName = "DateFormat", args = ["pl"], methods = { pattern = namedSet "format:date:eu-dot", template = "dd.MM.yyyy", order = ["day", "month", "year"], separator = ".", example = "25.12.2025" } }
  , { typeName = "DateFormat", args = ["ja"], methods = { pattern = namedSet "format:date:iso", template = "yyyy-MM-dd", order = ["year", "month", "day"], separator = "-", example = "2025-12-25" } }
  , { typeName = "DateFormat", args = ["zh"], methods = { pattern = namedSet "format:date:iso", template = "yyyy-MM-dd", order = ["year", "month", "day"], separator = "-", example = "2025-12-25" } }
  , { typeName = "DateFormat", args = ["ko"], methods = { pattern = namedSet "format:date:iso", template = "yyyy-MM-dd", order = ["year", "month", "day"], separator = "-", example = "2025-12-25" } }
  , { typeName = "DateFormat", args = ["sv"], methods = { pattern = namedSet "format:date:iso", template = "yyyy-MM-dd", order = ["year", "month", "day"], separator = "-", example = "2025-12-25" } }
  ]
