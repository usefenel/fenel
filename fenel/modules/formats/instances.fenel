-- Format-family typeclass instances — curated entity-grounded value-decls
-- (Phase 3.3b, typeclass-substrate-completion, 2026-05-29).
--
-- An instance is NOT a special concept: it is a typed VALUE of a parametric
-- class type. `countrySpatial : Spatial country` is a value whose type is
-- `Spatial` applied to `country`, exactly as `x : Int = 3` is an Int value.
-- The `loadFenelModule` loader (engine/src/fenel-module.ts), invoked with
-- `{ dispatchInstanceFile: true }`, recognises each `name : <Class> arg =
-- <Class> { f1 = v1, ... }` value-decl and PROJECTS it into the
-- `{ typeName, args, methods }` ClassInstance shape downstream dispatch reads
-- — typeName = <Class>, args from the type-application, methods = the record
-- fields — byte-identical to the TS consts it replaces in
-- engine/src/entity-typeclasses.ts.
--
-- Scope: the Spatial curated family is ported here (Phase 3.3b). The
-- AddressFormat curated family follows below (Phase 3.3c — `addressType : Type`
-- rebuild). The derived families (Phone / Handle / Date — eager Fenel-bodied
-- factories) and the deferred ExchangeRate factory remain in
-- entity-typeclasses.ts; see
-- workstreams/typeclass-substrate-completion/roadmap.md Phase 3.3b/3.3c/3.3d.

-- Spatial :: X — entity X has geographic geometry. `geometryType`'s value is
-- the plain string "multipolygon" (the class declares it as a $refined String
-- over the {point, polygon, multipolygon} enum; the instance carries the
-- string, validated by the `geometry-type-valid` law).
countrySpatial : Spatial "country"
countrySpatial = Spatial {
  geometryField = FieldRef { handle = "77f0169a-1bbb-46f3-8051-a8e46dade04a" },
  geometryType = "multipolygon",
  centroidField = FieldRef { handle = "cd52c958-3207-482e-80dc-b4f313fc1059" }
}

-- AddressFormat <CC> — the postal address shape for country <CC>, carried as a
-- first-class TYPE. `addressType`'s value is an uppercase type ident (e.g.
-- `UsAddress`, declared in fenel/std/entities/addresses.fenel); the loader
-- lowers it to the TYPE reference `{$named:"UsAddress"}` because the caller
-- (system-entities.ts + type-catalog.ts) passes
-- `typeValuedFields: { AddressFormat: ["addressType"] }` — the same type-as-
-- value mechanism aggregable's `inputType = List` uses. Without that option the
-- ident would lower to the runtime VALUE `{$tag:"UsAddress"}`; the option is
-- what makes `addressType` a type. The type-application arg (`AddressFormat US`)
-- projects to the string `args:["US"]` (the `Layout CanvasView` precedent).
usAddressFormat : AddressFormat US
usAddressFormat = AddressFormat { addressType = UsAddress }

caAddressFormat : AddressFormat CA
caAddressFormat = AddressFormat { addressType = CaAddress }

gbAddressFormat : AddressFormat GB
gbAddressFormat = AddressFormat { addressType = GbAddress }

deAddressFormat : AddressFormat DE
deAddressFormat = AddressFormat { addressType = DeAddress }

frAddressFormat : AddressFormat FR
frAddressFormat = AddressFormat { addressType = FrAddress }

jpAddressFormat : AddressFormat JP
jpAddressFormat = AddressFormat { addressType = JpAddress }
