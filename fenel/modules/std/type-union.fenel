module std where

-- The source chooses the union members; the existing Type-former crosses
-- the permanent dollar-key authoring seam through this ordinary marker.
TypeUnionMarker = TypeUnionMarker members: List Type

@native
@category "engine-internal"
typeUnionFromMarker : (marker: TypeUnionMarker) -> Type

@label "Union type"
typeUnion : (members: List Type) -> Type
typeUnion members = typeUnionFromMarker (TypeUnionMarker { members = members })
