module std where

-- clamp — constrain x between lo and hi. (Number, Number, Number) → Number.
--
-- Pure expression; mirrors the pre-Phase-5b3 TS native `clampNative`
-- at engine/src/modules/std.ts:2803
-- (`Math.min(Math.max(toNum(x), toNum(lo)), toNum(hi))`).
--
-- Decomposed into a nested cascade: `if x < lo then lo else if x >
-- hi then hi else x`. The Fenel port omits the `toNum` coercions
-- and the Math.min/Math.max host calls.
--
-- Documented JS-host divergence: `Math.min/Math.max` with a NaN
-- argument returns NaN, but the Fenel body returns the non-NaN
-- bound (since `lt NaN lo` and `gt NaN hi` are both false, so the
-- cascade falls through to `x`). Acceptable — Fenel's typed spec
-- is `Number`, not `NaN`-permitting; the divergence is the price
-- of typed honesty.

@label "Clamp"
@description "Constrain a number between min and max"
@tags "numeric" "constraint"
clamp : (x: Number) -> (lo: Number) -> (hi: Number) -> Number
clamp x lo hi = if lt x lo then lo else if gt x hi then hi else x
