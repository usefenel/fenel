module std where

-- =========================================================================
-- Int ⇄ Number / Int ⇄ ℤ-refinement bridges (numeric-tower Phase 2).
--
-- Int's pure sign-magnitude ADT remains the mathematical definition. Safe small
-- integers use Number carriers; larger exact values carry canonical signed
-- decimal digits. Arithmetic uses the existing Fenel bodies with their explicit
-- BigInt representation branch. Reprable lift produces the declared transfer
-- encoding, and lower exposes one pure outer Int with a represented Nat child.
--
-- numberToInt is the older integer-domain bridge used for small pure samples;
-- it materializes a Peano magnitude and is not exact integer text admission.
-- parseIntExact owns that path. intToNumber is an explicit approximate crossing
-- whose finite-projectable input refinement excludes overflow; approximateInt
-- gives callers a Result refusal. Neither serves as the current Reprable pair.

@label "Number to Int"
@description "Materialize a whole Number as a sign-magnitude Int: mkInt (numberToNat (abs n)) (lt n 0). The magnitude is the Peano materialization of |n|; the sign is (n < 0). numberToInt 0 ⇒ +0 (abs 0 = 0 ⇒ Zero magnitude ⇒ mkInt forces negative = False), so the bridge never emits −0. Defined over the ℤ domain (fractional parts floor-clamp through numberToNat)."
@tags "numeric" "int" "bridge"
numberToInt : (n: Number) -> Int
numberToInt n = mkInt (numberToNat (abs n)) (lt n 0)

@label "Int to Number"
@description "Explicit approximate projection to finite Number. Its input refinement admits only values with a finite current projection; approximateInt returns a typed refusal otherwise. Exact arithmetic and text do not use this projection."
@tags "numeric" "int" "bridge"
intToNumber : (i: FiniteNumberProjectableInt) -> Number
intToNumber i = integerNumberProjectionRaw i

-- Integer = Int | value ∈ ℤ uses the same exact carrier as Int. These witnesses
-- normalize its integer digits; they do not project through Number.
-- Historical note: numeric-tower Phase 2 used a Number-based refinement and
-- tested its float crossings only on small integer samples. That presentation
-- no longer describes these exact refinement witnesses.

@label "Int to integer-refinement"
@description "Normalize the same exact Int as its Integer refinement spelling. Every digit stays in the exact carrier; no Number projection occurs."
@tags "numeric" "int" "iso"
intToRefined : (i: Int) -> Integer
intToRefined i = integerIntEncodeDigits (intToExactText i)

@label "Integer-refinement to Int"
@description "Normalize the exact Integer refinement as Int without a Number projection."
@tags "numeric" "int" "iso"
intFromRefined : (n: Integer) -> Int
intFromRefined n = integerIntEncodeDigits (intToExactText n)
