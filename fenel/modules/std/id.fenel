module std where

-- id — identity function. ∀a. a → a.
--
-- Pure combinator; mirrors the pre-Phase-5b4 TS native at
-- engine/src/modules/std.ts:2970 (`(x) => x`).
--
-- The body is just the param reference — no function-call layer
-- means no recursion risk (unlike operator-form bodies which lower
-- to call-form of themselves via Infixable instances, see the 5b4
-- substrate-leaf-identity finding in the roadmap).

@label "Identity"
@description "Return the argument unchanged. ∀a. a → a"
@tags "function" "primitive"
id : (x: a) -> a
id x = x
