module std where

-- validateDateResolution — predicate: ISO date string fits within
-- the given precision level. (Date, String) → Boolean.
--
-- Strips trailing `Z` or a signed ASCII `HH:MM` / `HHMM` timezone suffix
-- before length-comparing against
-- the per-level maximum (year=4, month=7, day=10, hour=13, minute=16,
-- second=19). Unknown levels return True (matches TS native's
-- `if (!maxLen) return true`).
--
-- This predicate checks precision, not calendar or timezone validity: the
-- Date type owns date admission, and offset hour/minute ranges are not checked.
-- Retained divergence from resolution.ts's legacy regex: `Z0530` / `Z05:30`
-- are not signed offsets and stay unstripped. Malformed, repeated or padded
-- suffixes do not gain a second stripping pass.
--
-- Phase 2 of field-meta-collapse (2026-05-26): originally landed
-- TS-native in commit 4d7339d; immediately ported to .fenel after
-- Rom flagged the regression of `ts-elimination` workstream's intent.

@label "Validate date resolution"
@description "True when `value`'s ISO precision fits within `level` (year / month / day / hour / minute / second). Used by field-editor's date-resolution refinement."
@tags "time" "predicate" "resolution"
validateDateResolution : (value: Date) -> (level: String) -> Boolean
validateDateResolution value level =
  let n = length value
  let suffix = \size -> join (drop (n - size) (chars value)) ""
  let sign = \text -> text == "+" || text == "-"
  let digits = \text -> all (chars text) (\character -> contains "0123456789" character)
  let colonOffset = suffix 6
  let compactOffset = suffix 5
  let hasColonOffset = n >= 6 && sign (slice colonOffset 0 1) && slice colonOffset 3 4 == ":" && digits (slice colonOffset 1 3) && digits (slice colonOffset 4 6)
  let hasCompactOffset = n >= 5 && sign (slice compactOffset 0 1) && digits (slice compactOffset 1 5)
  let clean = if endsWith value "Z" then slice value 0 (n - 1) else value
  let cleanLen = if hasColonOffset then n - 6 else if hasCompactOffset then n - 5 else length clean
  if level == "year" then cleanLen <= 4
  else if level == "month" then cleanLen <= 7
  else if level == "day" then cleanLen <= 10
  else if level == "hour" then cleanLen <= 13
  else if level == "minute" then cleanLen <= 16
  else if level == "second" then cleanLen <= 19
  else True
