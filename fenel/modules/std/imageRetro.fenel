module std where

-- imageRetro — grayscale then pixelate. (Image, Number) → Image.
--
-- Pure expression; mirrors the pre-Phase-5b5 inline JSON-Logic body
-- at engine/src/modules/std.ts:4079 (`{pipe: [{var: "img"},
-- "imageGrayscale", ["imagePixelate", {var: "factor"}]]}`), which
-- used the legacy `pipe` JSON Logic op syntactic sugar to thread
-- the image through imageGrayscale then imagePixelate with factor.
--
-- The post-flip body uses nested canonical call-form via the
-- function registry: `imagePixelate (imageGrayscale img) factor` →
-- `{call: ["imagePixelate", {call: ["imageGrayscale", {var: "img"}]},
-- {var: "factor"}]}`. Semantically equivalent — the legacy `pipe`
-- op-key dispatch is retired here in favour of the standard
-- function-registry dispatch path; remaining `pipe` bodies else-
-- where in std.ts stay untouched.
--
-- Dispatch chain: std:imageRetro body → std:imageGrayscale (TS
-- native) → std:imagePixelate (TS native). First image-pipeline
-- spec ported in the ts-elimination workstream; validates the
-- recipe at image-pipeline surface depth 2.

@label "Retro"
@description "grayscale → pixelate. A composition (no native) — the storybook shows both intermediate stages."
@tags "media" "visual" "artistic" "composed"
imageRetro : (img: Image) -> (factor: Nat) -> Image
imageRetro img factor = imagePixelate (imageGrayscale img) factor
