module std where

-- sign — number's sign as -1, 0, or 1. Number → Number.
--
-- Pure expression; mirrors the pre-Phase-5b3 TS native `signNative`
-- at engine/src/modules/std.ts:2802 (`Math.sign(toNum(x))`).
--
-- Decomposed into a nested 3-way cascade: `if x < 0 then -1 else
-- if x > 0 then 1 else 0`. The Fenel port omits both the
-- `toNum(x)` coercion and the `Math.sign` host call.
--
-- Documented JS-host divergence: `Math.sign(NaN) === NaN` but the
-- Fenel body returns 0 for NaN (since `lt NaN 0` and `gt NaN 0`
-- are both false). Acceptable because Fenel's typed spec is
-- `Number`, not `NaN`-permitting — the divergence is the price of
-- typed honesty.

@label "Sign"
@description "Returns -1, 0, or 1"
@tags "numeric"
sign : (x: Number) -> Number
sign x = if lt x 0 then 0 - 1 else if gt x 0 then 1 else 0
