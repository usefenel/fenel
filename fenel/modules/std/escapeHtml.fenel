module std where

-- escapeHtml — canonical HTML-escape transform.
--
-- Substitutes the five-character HTML-attribute-safe escape set:
--   &  → &amp;   (must come first so subsequent replacements don't double-escape)
--   "  → &quot;
--   '  → &#39;
--   <  → &lt;
--   >  → &gt;
--
-- Pure string transform; composes std:replaceAll for each substitution.
-- Used by the redirect route's HTML template (Phase 12c-routes sub-step 2)
-- and by future HTML-rendering surfaces (sub-step 3's receipt route lands
-- the second consumer).
--
-- Order matters: replace & first, otherwise the subsequent &quot; etc.
-- would themselves have their `&` escaped (becoming &amp;quot;).

@label "Escape HTML"
@description "Substitute the 5-character HTML-attribute-safe escape set (&, \", ', <, >) in a string. Composes std:replaceAll. Used by the redirect route's HTML template; future HTML-rendering surfaces consume the same primitive."
@tags "text" "html" "escape" "phase-12c"
escapeHtml : (s: String) -> String
escapeHtml s =
  let a = replaceAll s "&" "&amp;"
  let b = replaceAll a "\"" "&quot;"
  let c = replaceAll b "'" "&#39;"
  let d = replaceAll c "<" "&lt;"
  replaceAll d ">" "&gt;"
