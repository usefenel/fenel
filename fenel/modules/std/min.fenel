module std where

-- min — smallest of two numbers. (Number, Number) → Number.
--
-- Pure expression; mirrors the pre-Phase-5b5 inline JSON-Logic body
-- at engine/src/modules/std.ts:268 (`{min: [a, b]}`), which dis-
-- patched via the named-op key `min` to BUILTIN_OP_NATIVES.min =
-- Math.min.
--
-- Decomposed into a pattern-match: `if lt a b then a else b`. The
-- post-flip body lowers to `{if: [{call: ["lt", a, b]}, a, b]}` —
-- canonical call-form dispatch through the function registry,
-- replacing the named-op-key dispatch with a Fenel-native if-then-
-- else over the existing `lt` substrate-leaf spec.
--
-- Documented JS-host divergence: `Math.min(NaN, x) === NaN` but the
-- Fenel body returns x (since `lt NaN x` is false in JS comparison
-- semantics, the else-branch returns b — falling through to the
-- second arg). Acceptable because Fenel's typed spec is `Number`,
-- not NaN-permitting — the divergence is the price of typed honesty.

@label "Minimum"
@description "Smallest of two numbers"
@tags "numeric" "comparison"
min : (a: Number) -> (b: Number) -> Number
min a b = if lt a b then a else b
