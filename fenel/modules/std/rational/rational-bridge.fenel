module std where

-- =========================================================================
-- Rational ⇄ Number / Rational ⇄ ℚ-refinement bridges (numeric-tower Phase 3).
--
-- Explicit scalar crossings. The default Rational runtime/storage
-- representation is now an exact integer-string pair (rational-runtime.fenel),
-- and these functions are no longer its Reprable lift/lower. Rational's pure
-- Int/PositiveNat arithmetic remains the semantic definition. Projection to
-- Number is approximate; the reverse integer-domain bridge is not a parser
-- for decimal/fraction text. parseRational owns that lossless input path.
--
--   rationalToNumber : FiniteNumberProjectableRational -> Number
--                       explicit approximate projection with a finite domain.
--   numberToRational : Number -> Rational    over the INTEGER-valued Number
--                                             domain — n ↦ n/1.
--
-- Current Reprable lift transfers exact integer strings into the declared
-- RationalRepresentation record; lower exposes one pure Rational with typed
-- represented Int/Nat children. Its roundtrip checks include true fractions and
-- large digits. BigInt stays inside the arithmetic representation branch.
--
-- Historical note: numeric-tower Phase 3 used a lossy Number Reprable and
-- restricted that float roundtrip test to integer samples. That default has
-- been replaced. numberToRational remains a small pure-reference bridge over
-- the integer Number domain, not a float-to-fraction heuristic or input parser.

@label "Rational to Number"
@description "Explicit approximate Rational-to-Number projection. Fractions can lose digits in the double; approximateRational adds a checked finite-result boundary. Exact runtime/storage Reprable uses integer strings instead."
@tags "numeric" "rational" "bridge"
rationalToNumber : (r: FiniteNumberProjectableRational) -> Number
rationalToNumber r = case approximateRational r of
  Ok approximate -> approximate

@label "Number to Rational"
@description "Materialize an integer-domain Number as the pure Rational n/1 through the existing Int/Nat bridges. This is a small pure-sample bridge, not exact decimal input or the default Reprable crossing; parseRational reads digits directly."
@tags "numeric" "rational" "bridge"
numberToRational : (n: Number) -> Rational
numberToRational n = mkRational (numberToInt n) (mkInt (numberToNat 1) False)

-- The refinement name now uses the same exact Rational carrier:
-- RationalNumber = Rational | value ∈ ℚ. The witnesses normalize the same value;
-- neither crosses a floating representation or discards a fraction.

@label "Rational to ℚ-refinement"
@description "Normalize an exact Rational into its ℚ-refinement spelling. Every fraction and integer digit stays in the same exact representation."
@tags "numeric" "rational" "iso"
ratToRefined : (r: Rational) -> RationalNumber
ratToRefined r = rationalNormalize r

@label "ℚ-refinement to Rational"
@description "Normalize the exact ℚ-refinement spelling as Rational; no Number projection occurs."
@tags "numeric" "rational" "iso"
ratFromRefined : (n: RationalNumber) -> Rational
ratFromRefined n = rationalNormalize n
