module std where

-- Rational retains its pure Int/PositiveNat definition. These declarations
-- describe its lossless runtime/storage representation and checked crossings.
-- BigInt is only the law-bound performance branch of the existing arithmetic;
-- decimal syntax, admission, bounds and result policy remain Fenel-owned.

IntegerDecimalText = String | rationalInputInteger value
PositiveIntegerDecimalText = String | rationalPositiveIntegerText value
RationalRepresentation = RationalRepresentation num: IntegerDecimalText den: PositiveIntegerDecimalText
RationalNativeRepresentation = RationalRepresentation | rationalNativeRepresentation value
RationalNativeMarker = RationalNativeMarker num: CanonicalIntIntegerText den: PositiveIntegerDecimalText

@native
@category "engine-internal"
rationalNativeFromMarker : (marker: RationalNativeMarker) -> RationalNativeRepresentation
NonZeroIntegerDecimalText = IntegerDecimalText | rationalInputCanonicalInteger value != "0"
NonZeroRational = Rational | not (ratEq value (rationalZero ()))
FiniteNumberProjectableRational = Rational | rationalProjectionFinite value
NonZeroInt = Int | rationalConstructorIntegerNonzero value

rationalConstructorIntegerNonzero : (value: a) -> Bool
rationalConstructorIntegerNonzero value =
  if intExactIsValid value then intToExactText value != "0" else false

rationalPositiveIntegerText : (text: String) -> Bool
rationalPositiveIntegerText text = rationalInputInteger text && not (startsWith text "-") && rationalInputCanonicalInteger text != "0"

rationalNativeRepresentation : (r: a) -> Bool
rationalNativeRepresentation r =
  let snapshot = representationValueSnapshot r
  case snapshot of
    SnapshotRecord fields ->
      if length fields != 3 then false
      else case integerSnapshotTag snapshot of
        Just tag ->
          if tag != "Rational" then false
          else case representationSnapshotConstructorField snapshot "num" 0 of
            Just numerator -> case representationSnapshotConstructorField snapshot "den" 1 of
              Just denominator -> isString numerator && isString denominator && rationalInputInteger numerator && rationalPositiveIntegerText denominator
              Nothing -> false
            Nothing -> false
        Nothing -> false
    _ -> false

rationalNatMembership : (n: a) -> (remaining: Number) -> Maybe Bool
rationalNatMembership n remaining = integerNatMembershipBudget n remaining

rationalIntMembership : (n: a) -> Maybe Bool
rationalIntMembership n = intExactMembership n

rationalPositiveNatMembership : (n: a) -> Maybe Bool
rationalPositiveNatMembership n =
  case natExactMembership n of
    Nothing -> Nothing
    Just false -> Just false
    Just true ->
      -- Admission already establishes the complete bounded Nat shape. Inspect
      -- its outer constructor to test positivity without formatting its pure
      -- spine or crossing a represented arithmetic intermediate.
      case representationValueSnapshot n of
        SnapshotNumber number -> Just (number > 0)
        SnapshotRecord fields -> case integerSnapshotTag (SnapshotRecord fields) of
          Just tag ->
            if tag == "Zero" then Just false
            else if tag == "Succ" || tag == "Nat" then Just true
            else Nothing
          Nothing -> Nothing
        _ -> Nothing

@description "Membership for native exact integer-string ratios and their pure Int/PositiveNat form. Native parts beyond 4096 characters or pure spines beyond 128 inspected constructors abstain; a workload limit is not mathematical nonmembership. Unreduced valid ratios are admitted; checked construction normalizes them. Scalar Number is not an exact Rational representation."
rationalMembership : (r: a) -> Maybe Bool
rationalMembership r =
  let snapshot = representationValueSnapshot r
  case snapshot of
    SnapshotUnreadable -> Nothing
    SnapshotRecord fields ->
      if length fields != 3 then Just false
      else case integerSnapshotTag snapshot of
        Nothing -> Just false
        Just tag ->
          if tag != "Rational" then Just false
          else case representationSnapshotConstructorField snapshot "num" 0 of
            Nothing -> Just false
            Just numerator -> case representationSnapshotConstructorField snapshot "den" 1 of
              Nothing -> Just false
              Just denominator ->
                if isString numerator && isString denominator then
                  if length numerator > 4096 || length denominator > 4096 then Nothing
                  else Just (rationalInputInteger numerator && rationalPositiveIntegerText denominator)
                else case intExactMembership numerator of
                  Nothing -> Nothing
                  Just false -> Just false
                  Just true -> rationalPositiveNatMembership denominator
    _ -> Just false

rationalIsValid : (r: a) -> Bool
rationalIsValid r = case rationalMembership r of
  Just answer -> answer
  Nothing -> false

rationalIntegerTextToInt : (text: String) -> Int
rationalIntegerTextToInt text =
  let magnitude = fold (\acc character -> natAdd (natMul acc (numberToNat 10)) (numberToNat (charCode character - charCode "0"))) (Zero) (chars (rationalInputUnsigned text))
  mkInt magnitude (startsWith text "-")

@category "engine-internal"
rationalNormalizeParts : (num: IntegerDecimalText) -> (den: NonZeroIntegerDecimalText) -> Rational
rationalNormalizeParts num den = mkRational (rationalIntegerTextToInt num) (rationalIntegerTextToInt den)

@label "Make exact Rational"
@description "Construct an exact Rational from two signed decimal integer strings, reduce to lowest terms and put the sign in the numerator. Invalid syntax, zero denominator and parts longer than 4096 characters refuse before the representation crossing. This is a workload bound, not a precision limit."
rationalFromParts : (num: String) -> (den: String) -> Result String Rational
rationalFromParts num den =
  if length num > 4096 || length den > 4096 then Err "Use at most 4096 characters for each Rational integer part."
  else if not (rationalInputInteger num && rationalInputInteger den) then Err "A Rational needs two signed decimal integer strings."
  else if rationalInputCanonicalInteger den == "0" then Err "A Rational denominator cannot be zero."
  else rationalCheckedResult (rationalNormalizeParts num den)

rationalZero : Rational
rationalZero = rationalNormalizeParts "0" "1"

rationalNatDecimal : (n: Nat) -> String
rationalNatDecimal n =
  let ten = numberToNat 10
  if natLt n ten then toString (natToNumber n)
  else join [rationalNatDecimal (natDiv n ten), toString (natToNumber (natMod n ten))] ""

rationalIntDecimal : (n: Int) -> String
rationalIntDecimal n = case n of
  Int { magnitude = magnitude, negative = negative } ->
    let digits = rationalNatDecimal magnitude
    if boolToNative negative && digits != "0" then join ["-", digits] "" else digits

rationalRepresentationParts : (r: Rational) -> RationalRepresentation
rationalRepresentationParts r = case r of
  Rational { num = numerator, den = denominator } ->
    let normalized = mkRational numerator (mkInt denominator False)
    case normalized of
      Rational { num = canonicalNum, den = canonicalDen } -> RationalRepresentation { num = rationalIntDecimal canonicalNum, den = rationalNatDecimal canonicalDen }

rationalFromRepresentationParts : (r: RationalRepresentation) -> Rational
rationalFromRepresentationParts r =
  let snapshot = representationValueSnapshot r
  case representationSnapshotConstructorField snapshot "num" 0 of
    Just numerator -> case representationSnapshotConstructorField snapshot "den" 1 of
      Just denominator -> case rationalFromParts numerator denominator of
        Ok result -> result

rationalRepresentationLift : (r: Rational) -> RationalNativeRepresentation
rationalRepresentationLift r =
  let parts = rationalRepresentationParts r
  rationalNativeFromMarker (RationalNativeMarker { num = parts.num, den = parts.den })

rationalRepresentationLower : (r: RationalRepresentation) -> Rational
rationalRepresentationLower r =
  let snapshot = representationValueSnapshot r
  case representationSnapshotConstructorField snapshot "num" 0 of
    Just numerator -> case representationSnapshotConstructorField snapshot "den" 1 of
      Just denominator -> Rational { num = integerIntEncodeDigits (rationalInputCanonicalInteger numerator), den = integerNatEncodeDigits (rationalInputCanonicalInteger denominator) }

@label "Normalize Rational"
rationalNormalize : (r: Rational) -> Rational
rationalNormalize r =
  let parts = rationalRepresentationParts r
  rationalNormalizeParts parts.num parts.den

@label "Exact Rational text"
@description "Write the normalized exact integer or numerator/denominator spelling. No value passes through floating arithmetic."
rationalToExactText : (r: Rational) -> String
rationalToExactText r =
  let parts = rationalRepresentationParts (rationalNormalize r)
  if parts.den == "1" then parts.num else join [parts.num, "/", parts.den] ""

@label "Divide exact Rationals"
divideRationals : (left: Rational) -> (right: Rational) -> Result String Rational
divideRationals left right =
  if not (rationalIsValid left && rationalIsValid right) then Err "Use admitted exact Rational values."
  else if ratEq right (rationalZero ()) then Err "Division by a zero Rational is undefined."
  else rationalCheckedResult (ratDiv left right)

rationalCheckedResult : (value: Rational) -> Result String Rational
rationalCheckedResult value =
  if rationalIsValid value then Ok value
  else Err "The result exceeds the bounded Rational calculation work."

rationalPowerPositive : (value: Rational) -> (exponent: Number) -> Rational
rationalPowerPositive value exponent =
  if exponent == 0 then rationalNormalizeParts "1" "1"
  else if exponent == 1 then value
  else
    let half = rationalPowerPositive value (floor (exponent / 2))
    let square = ratMul half half
    if mod exponent 2 == 0 then square else ratMul square value

@category "engine-internal"
rationalIntegerPowerChecked : (value: Rational) -> (exponent: Number) -> Result String Rational
rationalIntegerPowerChecked value exponent =
  if not (rationalIsValid value) then Err "Use an admitted exact Rational."
  else if not (numberIsFinite exponent) || exponent != floor exponent || abs exponent > 4096 then Err "Use a whole exponent from -4096 through 4096."
  else
    let parts = rationalRepresentationParts value
    if (length parts.num + length parts.den) * abs exponent > 16384 then Err "The power exceeds the bounded Rational calculation work."
    else if exponent < 0 then divideRationals (rationalNormalizeParts "1" "1") (rationalPowerPositive value (0 - exponent))
    else rationalCheckedResult (rationalPowerPositive value exponent)

@label "Power of an exact Rational"
@description "A whole Number exponent is a bounded iteration-count convenience for powerExactRational. Exact Rational exponents also admit perfect roots through that same operation."
powerRational : (value: Rational) -> (exponent: Number) -> Result String Rational
powerRational value exponent =
  if not (numberIsFinite exponent) || exponent != floor exponent || abs exponent > 4096 then Err "Use a whole exponent from -4096 through 4096."
  else powerExactRational value (rationalNormalizeParts (toString exponent) "1")

@label "Approximate Rational as Number"
@description "Explicit floating projection. Overflow or an unavailable finite projection refuses; exact arithmetic and text do not use this operation."
approximateRational : (r: Rational) -> Result String Number
approximateRational r =
  if not (rationalIsValid r) then Err "Use an admitted exact Rational."
  else
    let parts = rationalRepresentationParts r
    let numerator = integerFloatSampleFromText parts.num
    let denominator = integerFloatSampleFromText parts.den
    if not (isNumber numerator && isNumber denominator && numberIsFinite numerator && numberIsFinite denominator) then Err "This Rational has no finite Number projection through the current representation bridge."
    else
      let approximate = div numerator denominator
      if numberIsFinite approximate then Ok approximate else Err "This Rational has no finite Number projection through the current representation bridge."

rationalProjectionFinite : (r: a) -> Bool
rationalProjectionFinite r =
  if not (rationalIsValid r) then false
  else case approximateRational r of
    Ok approximate -> true
    Err message -> false

decodeRationalText : (text: String) -> Result String Rational
decodeRationalText text = (Decodable.decode text : Result String Rational)

encodeRationalText : (r: Rational) -> Result String String
encodeRationalText r = (Encodable.encode r : Result String String)

encodeRationalExactText : (r: Rational) -> Result String String
encodeRationalExactText r = if rationalIsValid r then Ok (rationalToExactText r) else Err "Use an admitted exact Rational."
