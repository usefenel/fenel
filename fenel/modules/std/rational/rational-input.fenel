module std where

-- Exact Rational text admission is generic numeric policy. Mantissa digits
-- remain strings throughout: no Number conversion, floating approximation,
-- unit catalogue or display-rounding policy participates in this parser.
-- Small bounded Numbers below are only character counts and exponent indices.
-- The checked representation crossing rationalFromParts owns normalization,
-- the positive-denominator invariant and rejection of a zero denominator.

rationalInputDigits : (text: String) -> Bool
rationalInputDigits text =
  text != "" && fold (\remaining digit -> replaceAll remaining digit "") text (chars "0123456789") == ""

rationalInputUnsigned : (text: String) -> String
rationalInputUnsigned text =
  if startsWith text "-" || startsWith text "+" then slice text 1 (length text)
  else text

rationalInputInteger : (text: String) -> Bool
rationalInputInteger text = rationalInputDigits (rationalInputUnsigned text)

rationalInputCanonicalInteger : (text: String) -> String
rationalInputCanonicalInteger text =
  let significant = join (dropWhile (\character -> character == "0") (chars (rationalInputUnsigned text))) ""
  if significant == "" then "0"
  else if startsWith text "-" then join ["-", significant] ""
  else significant

rationalInputExponentDigit : (result: Result String Number) -> (character: String) -> Result String Number
rationalInputExponentDigit result character = case result of
  Err reason -> Err reason
  Ok exponent ->
    let next = exponent * 10 + charCode character - charCode "0"
    if next <= 4096 then Ok next else Err "The exponent magnitude must be at most 4096."

rationalInputExponent : (text: String) -> Result String Number
rationalInputExponent text =
  if not (rationalInputInteger text) then Err "An exponent needs an optional sign followed by ASCII digits."
  else case fold rationalInputExponentDigit (Ok 0) (chars (rationalInputUnsigned text)) of
    Err reason -> Err reason
    Ok exponent -> Ok (if startsWith text "-" then 0 - exponent else exponent)

rationalInputScaled : (digits: String) -> (negative: Bool) -> (places: Number) -> Result String Rational
rationalInputScaled digits negative places =
  let significant = rationalInputCanonicalInteger digits
  if significant == "0" then rationalFromParts "0" "1"
  else
    let numeratorCharacters = length significant + (if places > 0 then places else 0) + (if negative then 1 else 0)
    let denominatorCharacters = if places < 0 then 1 - places else 1
    if numeratorCharacters > 4096 || denominatorCharacters > 4096 then Err "The expanded numerator and denominator must each fit within 4096 characters."
    else
      let magnitude = join [significant, repeat "0" (if places > 0 then places else 0)] ""
      let numerator = if negative then join ["-", magnitude] "" else magnitude
      let denominator = join ["1", repeat "0" (if places < 0 then 0 - places else 0)] ""
      rationalFromParts numerator denominator

rationalInputMantissa : (text: String) -> (exponent: Number) -> Result String Rational
rationalInputMantissa text exponent =
  let parts = split (rationalInputUnsigned text) "."
  let digits = join parts ""
  if length parts > 2 || not (rationalInputDigits digits) then Err "Use an optional sign and ASCII digits, with at most one decimal point."
  else
    let fractionalPlaces = if length parts == 2 then length (at parts 1) else 0
    rationalInputScaled digits (startsWith text "-") (exponent - fractionalPlaces)

rationalInputDecimal : (text: String) -> Result String Rational
rationalInputDecimal text =
  let parts = split (lower text) "e"
  if length parts == 1 then rationalInputMantissa (at parts 0) 0
  else if length parts == 2 then
    bindResult (rationalInputExponent (at parts 1)) (\exponent -> rationalInputMantissa (at parts 0) exponent)
  else Err "Use at most one exponent after the integer or decimal."

rationalInputFraction : (parts: List String) -> Result String Rational
rationalInputFraction parts =
  if length parts != 2 then Err "A fraction needs two signed whole integers separated by one slash."
  else
    let numerator = trim (at parts 0)
    let denominator = trim (at parts 1)
    if rationalInputInteger numerator && rationalInputInteger denominator then
      rationalFromParts (rationalInputCanonicalInteger numerator) (rationalInputCanonicalInteger denominator)
    else Err "A fraction needs two signed whole integers separated by one slash."

@label "Parse exact Rational"
@description "Read a signed whole number, exact decimal, or signed integer fraction as a Rational. Decimals may use e/E with a signed integer exponent; .5 and 5. are accepted. Surrounding whitespace and whitespace beside a fraction slash are ignored. ASCII digits only: grouping separators, locale commas, hexadecimal, non-finite values and internal decimal whitespace refuse. Source text is limited to 4096 characters, exponent magnitude to 4096, and expanded numerator/denominator strings to 4096 characters each. The checked Rational constructor reduces the fraction and rejects zero denominators; no digits pass through a floating Number."
@tags "numeric" "rational" "parse" "exact"
parseRational : (text: String) -> Result String Rational
parseRational text =
  if length text > 4096 then Err "Use at most 4096 characters for a Rational."
  else
    let input = trim text
    let parts = split input "/"
    if input == "" then Err "Enter a whole number, decimal or fraction."
    else if length parts == 1 then rationalInputDecimal input
    else if length parts == 2 then rationalInputFraction parts
    else Err "A fraction may contain only one slash."
