module std where

-- Exact fractional powers extend Rational's existing arithmetic. The pure
-- Int/Nat definition below remains the reference for the B4 native ratio
-- performance branch; admission, exponent bounds and refusal policy are here.

rationalRootNatMultiplyBounded : (left: Nat) -> (right: Nat) -> (limit: Nat) -> Maybe Nat
rationalRootNatMultiplyBounded left right limit = case right of
  Zero -> Just (Zero)
  Succ predecessor -> case rationalRootNatMultiplyBounded left predecessor limit of
    Nothing -> Nothing
    Just product ->
      if natLt limit left || natLt (natMonus limit left) product then Nothing
      else Just (natAdd left product)

rationalRootNatPowerBounded : (base: Nat) -> (exponent: Number) -> (limit: Nat) -> Maybe Nat
rationalRootNatPowerBounded base exponent limit =
  if exponent == 0 then Just (numberToNat 1)
  else if exponent == 1 then if natLt limit base then Nothing else Just base
  else case rationalRootNatPowerBounded base (floor (exponent / 2)) limit of
    Nothing -> Nothing
    Just half -> case rationalRootNatMultiplyBounded half half limit of
      Nothing -> Nothing
      Just square ->
        if mod exponent 2 == 0 then Just square
        else rationalRootNatMultiplyBounded square base limit

rationalRootNatSearch : (target: Nat) -> (degree: Number) -> (low: Nat) -> (high: Nat) -> Maybe Nat
rationalRootNatSearch target degree low high =
  if natEq (natAdd low (numberToNat 1)) high then
    case rationalRootNatPowerBounded low degree target of
      Just powered -> if natEq powered target then Just low else Nothing
      Nothing -> Nothing
  else
    let middle = natDiv (natAdd low high) (numberToNat 2)
    case rationalRootNatPowerBounded middle degree target of
      Nothing -> rationalRootNatSearch target degree low middle
      Just powered -> rationalRootNatSearch target degree middle high

rationalRootNatExact : (target: Nat) -> (degree: Number) -> Maybe Nat
rationalRootNatExact target degree = case target of
  Zero -> Just (Zero)
  Succ predecessor ->
    if degree == 1 then Just target
    else rationalRootNatSearch target degree (Zero) (natAdd target (numberToNat 1))

rationalRootNatHasNativeLeaf : (value: a) -> Bool
rationalRootNatHasNativeLeaf value =
  if natNativeRepresentation value then true
  else case value of
    Succ predecessor -> rationalRootNatHasNativeLeaf predecessor
    _ -> false

rationalRootIntHasNativeLeaf : (value: a) -> Bool
rationalRootIntHasNativeLeaf value =
  if intNativeRepresentation value then true
  else case value of
    Int { magnitude = magnitude, negative = negative } -> rationalRootNatHasNativeLeaf magnitude
    _ -> false

@category "engine-internal"
@description "Exact root reference over the existing pure Rational, Int and Nat definitions. A valid degree is a whole iteration count from 1 through 64. The native ratio performance branch preserves this result; nonperfect roots and negative even roots return Nothing."
rootRationalExact : (value: Rational) -> (degree: Number) -> Maybe Rational
rootRationalExact value degree =
  if not (numberIsFinite degree) || degree != floor degree || degree < 1 || degree > 64 then Nothing
  else case value of
    Rational { num = numerator, den = denominator } ->
      if rationalNativeRepresentation value || rationalRootIntHasNativeLeaf numerator || rationalRootNatHasNativeLeaf denominator then rootRationalExact (rationalNormalize value) degree
      else
        let normalized = mkRational numerator (mkInt denominator False)
        case normalized of
          Rational { num = canonicalNum, den = canonicalDen } -> case canonicalNum of
            Int { magnitude = magnitude, negative = negative } ->
            if boolToNative negative && mod degree 2 == 0 then Nothing
              else case rationalRootNatExact magnitude degree of
                Nothing -> Nothing
                Just numeratorRoot -> case rationalRootNatExact canonicalDen degree of
                  Nothing -> Nothing
                  Just denominatorRoot -> Just (mkRational (mkInt numeratorRoot negative) (mkInt denominatorRoot False))

@label "Exact Rational power"
@description "Raise a Rational to an exact Rational exponent p/q. Reduce the exponent before deciding the root, then return a Rational only when its qth root is exact. Negative bases allow odd roots; negative exponents require a nonzero base. Nonperfect roots require an explicit Real approximation. The existing 0^0 convention returns 1. The normalized numerator magnitude is at most 4096, root degree at most 64, and projected expansion at most 16384 characters; these workload bounds refuse without rounding."
powerExactRational : (value: Rational) -> (exponent: Rational) -> Result String Rational
powerExactRational value exponent =
  if not (rationalIsValid value && rationalIsValid exponent) then Err "Use admitted exact Rational values for the base and exponent."
  else
    let exponentParts = rationalRepresentationParts exponent
    let numeratorText = rationalInputUnsigned exponentParts.num
    if length numeratorText > 4 || length exponentParts.den > 2 then Err "Use an exponent numerator from -4096 through 4096 and a root degree from 1 through 64."
    else
      let numerator = toNumber exponentParts.num
      let degree = toNumber exponentParts.den
      if abs numerator > 4096 || degree > 64 then Err "Use an exponent numerator from -4096 through 4096 and a root degree from 1 through 64."
      else
        let parts = rationalRepresentationParts value
        if (length parts.num + length parts.den) * abs numerator > 16384 then Err "The power exceeds the bounded Rational calculation work."
        else if numerator < 0 && parts.num == "0" then Err "A zero Rational cannot have a negative exponent."
        else if startsWith parts.num "-" && mod degree 2 == 0 then Err "An even root of a negative Rational is outside the real-number domain."
        else if degree == 1 then rationalIntegerPowerChecked value numerator
        else case rootRationalExact (rationalNormalize value) degree of
          Nothing -> Err "This power has no exact Rational result; choose an explicit Real approximation."
          Just root -> rationalIntegerPowerChecked root numerator
