module std where

-- negate — arithmetic negation. Number → Number.
--
-- Pure expression; mirrors the pre-Phase-5b3 TS native
-- `negateNative` at engine/src/modules/std.ts:2788 (`(x) => -toNum(x)`).
--
-- The TS native used JS unary `-` after `toNum(x)` coercion. The
-- Fenel port uses `sub 0 x` (canonical call-form via the `-`
-- operator's Infixable instance). Semantically identical for any
-- Number; differs only on JS-host edge cases (NaN, ±0) — third
-- instantiation of the JS-coercion-omission pattern documented in
-- Phase 5b3 completion notes.

@label "Negate"
@description "Arithmetic negation. Number → Number. Counterpart to the unary `-` operator (Prefixable)."
@tags "numeric" "unary" "pin"
negate : (x: Number) -> Number
negate x = 0 - x

-- double — twice the number (2026-11-06, actions panel: a showcase number
-- action that the catalogue lacked). Pure; x + x is exact on every tower rung.

@label "Double"
@description "Twice the number. Number → Number."
@tags "numeric" "unary" "pin"
double : (x: Number) -> Number
double x = x + x
