module std where

-- max — largest of two numbers. (Number, Number) → Number.
--
-- Pure expression; mirrors the pre-Phase-5b5 inline JSON-Logic body
-- at engine/src/modules/std.ts:286 (`{max: [a, b]}`), which dis-
-- patched via the named-op key `max` to BUILTIN_OP_NATIVES.max =
-- Math.max.
--
-- Decomposed into a pattern-match: `if gt a b then a else b`. The
-- post-flip body lowers to `{if: [{call: ["gt", a, b]}, a, b]}` —
-- canonical call-form dispatch through the function registry,
-- replacing the named-op-key dispatch with a Fenel-native if-then-
-- else over the existing `gt` substrate-leaf spec.
--
-- Documented JS-host divergence: `Math.max(NaN, x) === NaN` but the
-- Fenel body returns x (since `gt NaN x` is false in JS comparison
-- semantics, the else-branch returns b — falling through to the
-- second arg). Acceptable because Fenel's typed spec is `Number`,
-- not NaN-permitting — the divergence is the price of typed honesty.

@label "Maximum"
@description "Largest of two numbers"
@tags "numeric" "comparison"
max : (a: Number) -> (b: Number) -> Number
max a b = if gt a b then a else b
