module std where

-- compareGeoLevel — depth comparison over the GeoLevel ADT.
-- (GeoLevel, GeoLevel) → Number (-1 / 0 / 1, the canonical Ordering shape).
--
-- Phase 4 of field-meta-collapse — supersedes the TS-side
-- `treeLattice` factory's `compare` method (resolution.ts:200-205)
-- for the geography lattice. The body is the same lookup-then-
-- comparison, expressed Fenel-first.
--
-- The canonical depth ordering is fixed in `places.ts:geoLevelOrder`:
--   Country = 0, Region = 1, City = 2,
--   PostalCode = 3, Street = 4, Address = 5
--
-- Returns:
--   -1 when `a` is coarser than `b` (a's depth less than b's)
--    0 when both share the same level
--    1 when `a` is finer than `b`
--
-- Composes from `lt` / `gt`. Pattern matches over the GeoLevel
-- variant; the constructor tags align with the typed constructors in
-- places.ts (`Country`, `Region`, …, `Address`).
--
-- Single-line cascading if-else (clamp.fenel pattern) — multi-line
-- if-else-if didn't parse correctly in the let-block context.

@label "Geo level depth"
@description "Depth index (0–5) of a GeoLevel constructor in the canonical Country → Address ordering. Phase 4 of field-meta-collapse — underpins the `Resolvable` typeclass instances for `Place : GeoLevel -> Type`."
@tags "geo" "resolution" "tree-hierarchical"
geoLevelDepth : (lvl: GeoLevel) -> Number
geoLevelDepth lvl = case lvl of
  GeoCountry -> 0
  GeoRegion -> 1
  GeoCity -> 2
  GeoPostalCode -> 3
  GeoStreet -> 4
  GeoAddress -> 5

@label "Compare geo level"
@description "Compare two GeoLevel constructors by depth — returns -1 if `a` is coarser, 0 if equal, 1 if `a` is finer. Phase 4 of field-meta-collapse — supersedes treeLattice's `compare` method for geography. Used by the `Resolvable` typeclass instances dispatched off the phantom level."
@tags "geo" "resolution" "tree-hierarchical" "ordering"
compareGeoLevel : (a: GeoLevel) -> (b: GeoLevel) -> Number
compareGeoLevel a b = if lt (geoLevelDepth a) (geoLevelDepth b) then -1 else if gt (geoLevelDepth a) (geoLevelDepth b) then 1 else 0
