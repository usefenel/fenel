-- Image declarations and the source-owned compositing/blur algorithms.
-- Other legacy image operations retain their native declarations below.
-- Source-over and Gaussian/box blur keep explicitly approved performance
-- mirrors in image-ops.ts. These complete bodies define their mathematics;
-- source/native controls pin their parity without changing the raster carrier.
module std where

@native
@label "Blue channel"
@description "Keep blue, zero red and green."
@tags "media" "visual" "channel"
imageBlueChannel : (img: Image) -> Image

@label "Box blur"
@description "Average each RGB pixel with its (2·radius+1)² neighbors, clamping edges and retaining the pixel's alpha. Radius zero preserves the image. Cheaper but boxier than Gaussian."
@tags "media" "visual" "filter" "blur" "pin"
imageBoxBlur : (img: Image) -> (radius: Nat) -> Image
imageBoxBlur img radius =
  if radius == 0 then img
  else imageSourceBlur img (max 1 (floor radius)) false

@native
@label "Brightness"
@description "Add `delta` to each RGB component (clamped to 0..255). Negative darkens, positive lightens."
@tags "media" "visual" "color"
imageBrightness : (img: Image) -> (delta: Number) -> Image

@native
@label "Checkerboard"
@description "Black/white checkerboard with `tile`-pixel squares."
@tags "media" "visual" "generative"
imageCheckerboard : (width: Nat) -> (height: Nat) -> (tile: Nat) -> Image

@native
@label "Contrast"
@description "Scale each component around 128: (px−128)·factor + 128. factor>1 boosts, <1 flattens."
@tags "media" "visual" "color"
imageContrast : (img: Image) -> (factor: Number) -> Image

@native
@label "Crop"
@description "Extract a sub-rectangle starting at (x, y) with the given width and height. Out-of-bounds is clipped."
@tags "media" "visual" "geometric"
imageCrop : (img: Image) -> (x: Nat) -> (y: Nat) -> (width: Nat) -> (height: Nat) -> Image

@native
@label "Difference"
@description "Absolute per-channel difference: |a − b|. Useful for change detection."
@tags "media" "visual" "composite" "blend"
imageDifference : (a: Image) -> (b: Image) -> Image

@native
@label "Dither (Floyd-Steinberg)"
@description "Floyd-Steinberg error diffusion to monochrome. Distributes quantization error to neighboring pixels."
@tags "media" "visual" "artistic" "dither"
imageDither : (img: Image) -> Image

@native
@label "Edge detect (Sobel)"
@description "Sobel operator on the grayscale projection — outputs gradient magnitude as light edges on a dark background."
@tags "media" "visual" "filter" "edge"
imageEdgeDetect : (img: Image) -> Image

@native
@label "Emboss"
@description "Convolve with the standard emboss kernel — gives a directional bas-relief look."
@tags "media" "visual" "filter" "artistic"
imageEmboss : (img: Image) -> Image

@native
@label "Flip horizontal"
@description "Mirror left↔right."
@tags "media" "visual" "geometric" "pin"
imageFlipHorizontal : (img: Image) -> Image

@native
@label "Flip vertical"
@description "Mirror top↔bottom."
@tags "media" "visual" "geometric"
imageFlipVertical : (img: Image) -> Image

@native
@label "Gamma"
@description "Gamma correction: out = 255·(in/255)^(1/gamma). gamma>1 brightens midtones, <1 darkens."
@tags "media" "visual" "color"
imageGamma : (img: Image) -> (gamma: Number) -> Image

@label "Gaussian blur"
@description "Convolve RGB with a Gaussian kernel of size 2·radius+1 (sigma = radius/2), clamping edges and retaining each pixel's alpha. Radius zero preserves the image. Smooth, isotropic blur."
@tags "media" "visual" "filter" "blur"
imageGaussianBlur : (img: Image) -> (radius: Nat) -> Image
imageGaussianBlur img radius =
  if radius == 0 then img
  else imageSourceBlur img (max 1 (floor radius)) true

@native
@label "Gradient"
@description "Horizontal linear gradient between two colors."
@tags "media" "visual" "generative"
imageGradient : (width: Nat) -> (height: Nat) -> (r1: Nat) -> (g1: Nat) -> (b1: Nat) -> (r2: Nat) -> (g2: Nat) -> (b2: Nat) -> Image

@native
@label "Grayscale"
@description "Convert each pixel to grayscale via the Rec. 601 luminance formula (0.299·R + 0.587·G + 0.114·B). Alpha preserved."
@tags "media" "visual" "color"
imageGrayscale : (img: Image) -> Image

@native
@label "Green channel"
@description "Keep green, zero red and blue."
@tags "media" "visual" "channel"
imageGreenChannel : (img: Image) -> Image

@native
@label "Hue rotate"
@description "Rotate each pixel's hue by `degrees` (0..360) in HSL space."
@tags "media" "visual" "color"
imageHueRotate : (img: Image) -> (degrees: Number) -> Image

@native
@label "Invert colors"
@description "Invert each pixel's RGB: R→255−R, G→255−G, B→255−B. Alpha preserved."
@tags "media" "visual" "color" "pin"
imageInvert : (img: Image) -> Image

@native
@label "Median"
@description "Replace each pixel with the median of its (2·radius+1)² neighborhood. Strong denoise, preserves edges."
@tags "media" "visual" "filter" "denoise"
imageMedian : (img: Image) -> (radius: Nat) -> Image

@native
@label "Multiply blend"
@description "Per-pixel multiply blend: result = a·b/255. Always darkens."
@tags "media" "visual" "composite" "blend"
imageMultiply : (a: Image) -> (b: Image) -> Image

@native
@label "Noise"
@description "Deterministic monochrome white noise (Mulberry32 PRNG seeded by `seed`)."
@tags "media" "visual" "generative"
imageNoise : (width: Nat) -> (height: Nat) -> (seed: Nat) -> Image

@native
@label "Scale opacity"
@description "Multiply each pixel's alpha by `alpha` (0..1)."
@tags "media" "visual" "color" "alpha"
imageOpacity : (img: Image) -> (alpha: Number) -> Image

@label "Overlay"
@description "Source-over composite straight RGBA pixels, accounting for both alpha channels. Output dimensions are bottom's; pixels outside top are retained. Fully transparent overlaps normalize to transparent black."
@tags "media" "visual" "composite" "blend"
imageOverlay : (top: Image) -> (bottom: Image) -> Image
imageOverlay top bottom = imageSourceBuild bottom.width bottom.height (imageSourceOverlayPixel top bottom)

@native
@label "Pixelate"
@description "Average each `factor`×`factor` block into a single color. factor=1 is a no-op; larger factors produce blockier output."
@tags "media" "visual" "filter"
imagePixelate : (img: Image) -> (factor: Nat) -> Image

@native
@label "Posterize"
@description "Quantize each channel to `levels` evenly-spaced steps. Lower levels produce a flatter, banded look."
@tags "media" "visual" "color"
imagePosterize : (img: Image) -> (levels: Nat) -> Image

@native
@label "Red channel"
@description "Keep red, zero green and blue."
@tags "media" "visual" "channel"
imageRedChannel : (img: Image) -> Image

@native
@label "Resize"
@description "Resample to a new width × height using bilinear interpolation."
@tags "media" "visual" "geometric"
imageResize : (img: Image) -> (width: Nat) -> (height: Nat) -> Image

@native
@label "Rotate 180°"
@description "Rotate by 180 degrees — same as flipping both axes."
@tags "media" "visual" "geometric"
imageRotate180 : (img: Image) -> Image

@native
@label "Rotate 270°"
@description "Rotate clockwise by 270 degrees (= 90° counter-clockwise)."
@tags "media" "visual" "geometric"
imageRotate270 : (img: Image) -> Image

@native
@label "Rotate 90°"
@description "Rotate clockwise by 90 degrees. Width and height swap."
@tags "media" "visual" "geometric"
imageRotate90 : (img: Image) -> Image

@native
@label "Bundled sample"
@description "Return one of the bundled sample images by index. Use this in saved expressions instead of embedding pixel literals — same expressions stay small and human-readable."
@tags "media" "visual" "generative" "sample"
imageSample : (index: Nat) -> Image

@native
@label "Saturate"
@description "Scale saturation in HSL space. factor=0 is grayscale, 1 is identity, >1 oversaturates."
@tags "media" "visual" "color"
imageSaturate : (img: Image) -> (factor: Number) -> Image

@native
@label "Screen"
@description "Per-pixel screen blend: result = 255 − (255−a)(255−b)/255. Always lightens."
@tags "media" "visual" "composite" "blend"
imageScreen : (a: Image) -> (b: Image) -> Image

@native
@label "Sepia"
@description "Apply the standard sepia tone matrix — warm reddish-brown tint reminiscent of aged photos."
@tags "media" "visual" "color"
imageSepia : (img: Image) -> Image

@native
@label "Sharpen"
@description "Convolve with the classic 5-center sharpen kernel — boosts the difference between each pixel and its 4 neighbors."
@tags "media" "visual" "filter"
imageSharpen : (img: Image) -> Image

@native
@label "Solid"
@description "Fresh image of a single solid color."
@tags "media" "visual" "generative"
imageSolid : (width: Nat) -> (height: Nat) -> (r: Nat) -> (g: Nat) -> (b: Nat) -> (a: Nat) -> Image

@native
@label "Swap R↔B"
@description "Swap the red and blue channels — useful for converting BGR ↔ RGB byte order."
@tags "media" "visual" "channel"
imageSwapRedBlue : (img: Image) -> Image

@native
@label "Swap R↔G"
@description "Swap the red and green channels."
@tags "media" "visual" "channel"
imageSwapRedGreen : (img: Image) -> Image

@native
@label "Threshold"
@description "Binarize on luminance: pixels below `level` go black, at-or-above go white."
@tags "media" "visual" "color"
imageThreshold : (img: Image) -> (level: Nat) -> Image

@native
@label "Flip diagonal"
@description "Swap rows and columns — main-diagonal reflection."
@tags "media" "visual" "geometric"
imageTranspose : (img: Image) -> Image

@native
@label "Vignette"
@description "Darken pixels radially from the center. `strength` 0..1 — 0 is no effect, 1 is full black at corners."
@tags "media" "visual" "artistic"
imageVignette : (img: Image) -> (strength: Number) -> Image

-- Straight (unassociated) RGBA is the existing raster carrier. Source-over
-- weights bottom RGB by its retained coverage, then unassociates exactly once.
-- The byte alpha is rounded only after computing the RGB denominator. This
-- repairs the legacy top-only RGB interpolation and max-alpha behavior; it
-- neither changes physical Color/Spectrum nor introduces an image type.
-- Record literals preserve the existing untagged Image/RgbaPixel encoding.
imageSourceByte : (value: Number) -> Nat
imageSourceByte value = if numberIsFinite value then round (clamp value 0 255) else 0

@label "Image from packed RGBA"
@description "Decode decimal RGBA words into ordinary row-major Image data. A wrong word count produces the empty image."
imageFromPackedRgba : (width: Nat) -> (height: Nat) -> (packed: String) -> Image
imageFromPackedRgba width height packed =
  let pixels = map imagePackedRgbaPixel (map toNumber (words packed))
  if length pixels == width * height then { width = width, height = height, pixels = pixels }
  else { width = 0, height = 0, pixels = [] }

imagePackedRgbaPixel : (rgba: Number) -> RgbaPixel
imagePackedRgbaPixel rgba =
  let r = floor (rgba / 16777216)
  let g = floor (rgba / 65536) - r * 256
  let b = floor (rgba / 256) - floor (rgba / 65536) * 256
  let a = rgba - floor (rgba / 256) * 256
  { r = imageSourceByte r, g = imageSourceByte g, b = imageSourceByte b, a = imageSourceByte a }

-- Palette pictures: a table of at most 64 packed RGBA words, then one letter
-- per pixel, row-major. Letter i of this fixed alphabet names palette word i.
imagePaletteAlphabet : String
imagePaletteAlphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/"

imagePaletteFound : (cell: Maybe RgbaPixel) -> Bool
imagePaletteFound cell = case cell of
  Just found -> true
  _ -> false

imagePaletteCell : (cell: Maybe RgbaPixel) -> RgbaPixel
imagePaletteCell cell = fromMaybe { r = 0, g = 0, b = 0, a = 0 } cell

@label "Image from a palette"
@description "Decode a palette picture into ordinary row-major Image data: the palette is at most 64 decimal RGBA words separated by spaces (as imageFromPackedRgba reads them), the letters are one character per pixel, row-major, from the alphabet 0-9, A-Z, a-z, + and /, where the i-th letter names the i-th palette word. A letter outside the palette, more than 64 words, or a letter count other than width times height produces the empty image."
@tags "media" "visual" "codec"
imageFromPalette : (width: Nat) -> (height: Nat) -> (palette: String) -> (letters: String) -> Image
imageFromPalette width height palette letters =
  let words64 = words palette
  let colours = map imagePackedRgbaPixel (map toNumber words64)
  let alphabet = chars (slice (imagePaletteAlphabet ()) 0 (length colours))
  let usable = take (length alphabet) colours
  let table = fromEntries (zipWith (\letter colour -> { key = letter, value = colour }) alphabet usable)
  let cells = map (\letter -> lookup table letter) (chars letters)
  let missing = filter (\cell -> not (imagePaletteFound cell)) cells
  if length colours <= 64 then
    if length cells == width * height then
      if length missing == 0 then { width = width, height = height, pixels = map imagePaletteCell cells }
      else { width = 0, height = 0, pixels = [] }
    else { width = 0, height = 0, pixels = [] }
  else { width = 0, height = 0, pixels = [] }

imageSourcePixel : (pixel: RgbaPixel) -> RgbaPixel
imageSourcePixel pixel = { r = imageSourceByte pixel.r, g = imageSourceByte pixel.g, b = imageSourceByte pixel.b, a = imageSourceByte pixel.a }

@label "Source-over RGBA pixel"
@description "Composite straight RGBA raster coverage using both alpha channels; round/clamp byte channels after unassociation. Fully transparent results are transparent black. Shared by imageOverlay and picture.alphaBlend."
@tags "media" "visual" "composite" "pixel"
imageSourceOverPixel : (top: RgbaPixel) -> (bottom: RgbaPixel) -> RgbaPixel
imageSourceOverPixel top bottom =
  let foreground = imageSourcePixel top
  let background = imageSourcePixel bottom
  let retained = background.a * (255 - foreground.a)
  let coverage = foreground.a * 255 + retained
  if coverage == 0 then { r = 0, g = 0, b = 0, a = 0 }
  else {
    r = imageSourceByte ((foreground.r * foreground.a * 255 + background.r * retained) / coverage),
    g = imageSourceByte ((foreground.g * foreground.a * 255 + background.g * retained) / coverage),
    b = imageSourceByte ((foreground.b * foreground.a * 255 + background.b * retained) / coverage),
    a = imageSourceByte (coverage / 255)
  }

-- Preserve the existing missing-buffer-pixel fallback. Valid Image data has
-- a complete row-major buffer; this arm keeps the legacy adapter behavior.
imageSourcePixelAt : (img: Image) -> (x: Number) -> (y: Number) -> RgbaPixel
imageSourcePixelAt img x y = case head (drop (y * img.width + x) img.pixels) of
  Just pixel -> pixel
  Nothing -> { r = 0, g = 0, b = 0, a = 255 }

imageSourceOverlayPixel : (top: Image) -> (bottom: Image) -> (x: Number) -> (y: Number) -> RgbaPixel
imageSourceOverlayPixel top bottom x y =
  let base = imageSourcePixelAt bottom x y
  if x >= top.width || y >= top.height then base
  else imageSourceOverPixel (imageSourcePixelAt top x y) base

imageSourceIndicesFrom : (current: Number) -> (finish: Number) -> List Number
imageSourceIndicesFrom current finish =
  if current >= finish then []
  else concat [current] (imageSourceIndicesFrom (current + 1) finish)

imageSourceBuild : (width: Nat) -> (height: Nat) -> (produce: (Number -> Number -> RgbaPixel)) -> Image
imageSourceBuild width height produce = {
  width = width,
  height = height,
  pixels = flatten (map (\y -> map (\x -> produce x y) (imageSourceIndicesFrom 0 width)) (imageSourceIndicesFrom 0 height))
}

imageSourceKernel : (radius: Number) -> (gaussian: Bool) -> List ({ x: Number, y: Number, weight: Number })
imageSourceKernel radius gaussian =
  let sigma = max 0.5 (radius / 2)
  let offsets = imageSourceIndicesFrom 0 (radius * 2 + 1)
  flatten (map (\row -> map (imageSourceKernelTap radius sigma gaussian row) offsets) offsets)

imageSourceKernelTap : (radius: Number) -> (sigma: Number) -> (gaussian: Bool) -> (row: Number) -> (column: Number) -> { x: Number, y: Number, weight: Number }
imageSourceKernelTap radius sigma gaussian row column =
  let x = column - radius
  let y = row - radius
  { x = x, y = y, weight = if gaussian then exp ((0 - (x * x + y * y)) / (2 * sigma * sigma)) else 1 }

imageSourceConvolvedSum : (img: Image) -> (x: Number) -> (y: Number) -> (total: { r: Number, g: Number, b: Number }) -> (tap: { x: Number, y: Number, weight: Number }) -> { r: Number, g: Number, b: Number }
imageSourceConvolvedSum img x y total tap =
  let pixel = imageSourcePixelAt img (clamp (x + tap.x) 0 (img.width - 1)) (clamp (y + tap.y) 0 (img.height - 1))
  { r = total.r + pixel.r * tap.weight, g = total.g + pixel.g * tap.weight, b = total.b + pixel.b * tap.weight }

imageSourceConvolvedPixel : (img: Image) -> (kernel: List ({ x: Number, y: Number, weight: Number })) -> (divisor: Number) -> (x: Number) -> (y: Number) -> RgbaPixel
imageSourceConvolvedPixel img kernel divisor x y =
  let totals = fold (imageSourceConvolvedSum img x y) { r = 0, g = 0, b = 0 } kernel
  let original = imageSourcePixelAt img x y
  { r = imageSourceByte (totals.r / divisor), g = imageSourceByte (totals.g / divisor), b = imageSourceByte (totals.b / divisor), a = original.a }

-- Blur retains the existing RGB-only convolution policy and source alpha.
-- Positive-radius kernels and clamp-edge sampling match the prior behavior;
-- zero-radius identity is decided above before any kernel or pixel traversal.
imageSourceBlur : (img: Image) -> (radius: Number) -> (gaussian: Bool) -> Image
imageSourceBlur img radius gaussian =
  let kernel = imageSourceKernel radius gaussian
  let divisor = fold (\total tap -> total + tap.weight) 0 kernel
  imageSourceBuild img.width img.height (\x y -> imageSourceConvolvedPixel img kernel divisor x y)
