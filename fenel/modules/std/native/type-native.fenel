-- FM-retire-9 Step 9b — std native-only leaves (`@native` decls).
-- THROWAWAY-GENERATED by _gen-std-9b.ts; the impls live in ffi/std-ffi.ts.
module std where

@native
@label "Char from code point"
@description "Single-character string from a Unicode code point (or UTF-16 code unit, for code points < 0x10000). Mirrors JS `String.fromCodePoint`. The inverse of indexing into `chars s`; useful for serializers walking byte sequences (e.g. LLVM IR's printable-ASCII passthrough in string-constant emission)."
@tags "text" "codec"
charFromCode : (code: Number) -> String

@native
@label "Char to code point"
@description "Unicode code point of a single character (the first code point if given a longer string; 0 for the empty string). Mirrors JS `.codePointAt(0)`. The irreducible host leaf that maps a Char's runtime repr (a one-character String — `Char = $opaque { repr: \"codepoint\", pure: Nat ∈ unicode-scalars }`, surfaced as a 1-char string at the boundary) to its ordinal. The inverse of `charFromCode`; the substrate that lets pure-Fenel `charLt` / `strCompare` (ord.fenel) order Char/String lexically. set-algebra-to-fenel Phase 3b-3 (string-ordering enabler)."
@tags "text" "codec" "ordering"
charCode : (c: String) -> Number

@native
@label "Is array"
@description "Check if value is a JS array. Phase 5b14 added this to support the bare-array-at-expression-position lowering in `engine:normaliseToCore` — the per-target CeLit lowerings (`lower-to-wasm-ast.fenel`'s `lowerWasmLit`, `lower-to-llvm-ast.fenel`'s `lowerLlvmLit`) gain an isArray arm that emits the empty-list base case as a target-appropriate null reference (the WASM / LLVM runtime helpers treat null as empty list end-to-end)."
@tags "predicate"
isArray : (x: a) -> Boolean

@native
@label "Is bytes"
@description "Recognize the Uint8Array host carrier of Bytes by its intrinsic brand and readable storage, without coercion or reading candidate properties. Detached views, other typed arrays, proxies and prototype imitations are not byte values."
@tags "predicate" "bytes"
isBytes : (x: a) -> Boolean

@native
@label "Bytes as a list"
@description "Copy the readable Uint8Array representation of Bytes into its ordinary List Byte view. This host representation bridge does not call candidate iterators or read candidate properties. Text decoding and validation belong to Fenel bodies."
@tags "bytes" "codec"
bytesToList : (bytes: Bytes) -> List Byte

@native
@label "Is boolean"
@description "Check if value is a boolean"
@tags "predicate"
isBoolean : (x: a) -> Boolean

@native
@label "Is null"
@description "Check if value is null or undefined"
@tags "predicate"
isNull : (x: a) -> Boolean

@native
@label "Is number"
@description "Check if value is a number"
@tags "predicate"
isNumber : (x: a) -> Boolean

@native
@label "Is string"
@description "Check if value is a string"
@tags "predicate"
isString : (x: a) -> Boolean

@native
@label "JS literal encode"
@description "Encode a value as a JS-source-valid string literal. Wraps `JSON.stringify` — produces `\"hi\"` for the string `hi`, `42` for the number `42`, `true` / `false` for booleans, `null` for null. The encode-side primitive used by `serializeJsModule`'s JsLit and JsObject-key arms to emit JS-source-valid output that round-trips through `eval` / dynamic-import."
@tags "js" "codec" "serialize"
jsLit : (value: a) -> String

@native
@label "Number is finite"
@description "True iff the number is neither NaN nor positive/negative Infinity. Mirrors JS `Number.isFinite`. Useful for serializers that need to special-case the non-finite IEEE 754 values (e.g. LLVM IR's hex-bit-pattern form for NaN/Inf doubles)."
@tags "predicate" "numeric"
numberIsFinite : (x: Number) -> Boolean

@native
@label "Number to hex"
@description "Render a non-negative integer in uppercase hexadecimal, zero-padded to `minDigits`. Mirrors JS `n.toString(16).toUpperCase().padStart(minDigits, \"0\")`. Phase 11b sub-step 3 substrate addition — used by `runtime:quotedPrintable` for the `=XX` RFC 2045 encoding of non-printable bytes. Negative or non-integer inputs follow JS's `toString(16)` semantics (the caller is responsible for clamping to byte range when used as a byte-encoder)."
@tags "numeric" "format" "hex" "codec"
numberToHex : (n: Number) -> (minDigits: Number) -> String

@native
@label "To boolean"
@description "Convert value to boolean (truthy check)"
@tags "coercion"
toBoolean : (x: a) -> Boolean

@native
@label "To number"
@description "Convert value to number"
@tags "coercion"
toNumber : (x: a) -> Number

@native
@label "To string"
@description "Convert value to string"
@tags "coercion"
toString : (x: a) -> String

@native
@label "UTF-8 bytes"
@description "Encode a string as its UTF-8 byte sequence (each byte as a Number 0–255). The primitive byte-iteration surface for serializers — e.g. LLVM IR's `[N x i8] c\"…\"` string constants, JSON byte-pretty-printers. `length (utf8Bytes s)` is the byte length (NOT the code-point count returned by `length s`)."
@tags "text" "codec" "utf8"
utf8Bytes : (s: String) -> List Number

-- FM-retire-10 — the type-returning + dependent type-level natives. `-> Type`
-- rides the Ext1 `Type` type-atom; these are used as `$el { call: [...] }` heads
-- when a length/element parameter is bound at runtime from a sibling field.

@native
@label "Type of"
@description "Return the FenelType of a value as a first-class Type. Conflate-free: the type's display name is `codeName (typeOf v)` via the Codeable typeclass, not a property of the value itself."
@tags "introspection" "type"
typeOf : (x: a) -> Type

@native
@label "Vec of length"
@description "Type-level: return the FenelType `Vec(elemType, n)` — a list of `elemType` of exactly `n` elements. Use under `$el { call: [\"vecOfLength\", T, { var: \"n\" }] }` when `n` comes from a sibling field."
@tags "dependent" "type-level"
vecOfLength : (elemType: Type) -> (n: Number) -> Type

@native
@label "Length-bounded String"
@description "Type-level: return the FenelType `LengthBoundedString(n)` — a String of exactly `n` codepoints. Use under `$el { call: [\"lengthBoundedStringOf\", { var: \"n\" }] }` when `n` comes from a sibling field."
@tags "dependent" "type-level"
lengthBoundedStringOf : (n: Number) -> Type
