@tags "comparison"
neq : (a: t) -> (b: t) -> Boolean

@native
@label "Shift left"
@description "Shift bits left by `n`. Int → Int → Int."
@tags "bitwise" "integer"
shiftLeft : (a: Int) -> (n: Int) -> Int

@native
@label "Shift right"
@description "Shift bits right by `n` (sign-extending). Int → Int → Int."
@tags "bitwise" "integer"
shiftRight : (a: Int) -> (n: Int) -> Int

@native
@label "Shift right (unsigned)"
@description "Shift bits right by `n` (zero-fill, unsigned). Mirrors JS `>>>`. Distinct from `shiftRight` (which is sign-extending — JS `>>`). Required for LEB128 encoders walking u32 values past the 2^31 boundary, where sign-extension would yield the wrong continuation bits."
@tags "bitwise" "integer"
shiftRightU : (a: Int) -> (n: Int) -> Int

@native
@label "Substring"
@description "Extract substring from start (optionally for `len` codepoints). Negative `len` counts from the end."
@tags "string" "slice"
substr : (str: String) -> (start: Number) -> (len: Maybe Number) -> String

@native
@label "Truthy"
@description "Coerce a value to its boolean truthiness. Mirrors JS truthiness semantics."
@tags "boolean" "coerce"
truthy : (x: a) -> Boolean
