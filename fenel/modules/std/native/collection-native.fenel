-- FM-retire-9 Step 9b — std native-only leaves (`@native` decls).
-- THROWAWAY-GENERATED by _gen-std-9b.ts; the impls live in ffi/std-ffi.ts.
-- effect-visibility Phase 3 — the higher-order fns (map / filter / fold /
-- flatMap / find / findIndex / takeWhile / dropWhile / zipWith / partition /
-- groupBy / sort) moved to ../hof.fenel as Fenel-BODIED members; their
-- stdNativesCtx impls remain as the purity-gated perf branch (see hof.fenel's
-- header for the selector contract).
--
-- recipe-functions S1 (2026-10-18) — MEMBERSHIP ON ORDINARY `eq`. `includes`,
-- `unique` (a left fold keeping first occurrences) and `distinctCount` are Fenel-BODIED here;
-- `intersection` and `subsequences` are ordinary Fenel compositions, without native branches.
-- the bodies are the SOURCE OF TRUTH. They used to be bodyless natives that
-- compared by JS reference (SameValueZero), while every nullary constructor
-- other than True/False evaluates to a fresh `{$tag}` object — so `includes
-- [Butter] Butter` was False. Equality is now the one value equality, `eq`
-- (structuralEq, the perf branch of `deepEqValue`): constructors, records (any
-- key order) and JSON round trips are found; NaN ≠ NaN, so `includes [NaN] NaN`
-- is False and `unique [NaN, NaN]` keeps both; callables compare by identity,
-- and every read of a closure yields a fresh carrier, so a closure is never
-- found again, not even a let-bound one (documented, not changed: it is what
-- `eq f f` says). Any non-list argument, a String included, is the empty
-- list (an `isArray` guard), exactly as the pre-S1 natives: S1 does not widen
-- membership to String traversal (review S1-2).
-- THE INTENTIONAL DUAL (ts-exceptions-ledger B4, as for minimum/maximum in
-- ../list/extremum.fenel): ffi/std-ffi.ts keeps `stdNatives.includes` /
-- `.unique` / `.distinctCount` as parity-tested PERF BRANCHES implementing
-- exactly these bodies (engine/src/collection-membership-equality.test.ts);
-- the selector is `invokeFunction`'s order nativesCtx → natives → body. Like
-- minimum/maximum, the bodies recurse once per element (deep lists need the
-- perf branch). `elem` stays a bodyless native (logic-native.fenel): the
-- compiled parser/resolver owners require it as a host leaf.
module std where

@native
@label "Assoc record"
@description "Set a dynamic key on a record, returning a new record. ∀a. Record String a → String → a → Record String a. Mirrors `{...record, [key]: value}` in JS. Sister of std:entries — Phase 13a sub-step 2 added this to retire the 12d-7 wrapper-side applyMapping iteration (the handle-platform branch needed dynamic key construction). Also retires one of the 12c-core deferred follow-ups."
@tags "record" "assign" "dynamic-key"
assocRecord : (record: {  }) -> (key: String) -> (value: a) -> {  }

@native
@label "At"
@description "Get the raw element at index `n`. Negative indices count from the end. This is a partial native: out-of-range returns the runtime null sentinel, so typed callers must prove bounds before consuming the result. ∀a. List a → Number → a"
@tags "list" "access" "indexing"
at : (xs: List a) -> (index: Number) -> a

@native
@label "Average"
@description "Arithmetic mean of numeric array"
@tags "array" "numeric" "aggregate"
avg : (arr: List Number) -> Number

@native
@label "Concat"
@description "Concatenate two lists. ∀a. List a → List a → List a — equivalent to Haskell `++`. The JS performance leaf retains a legacy two-string representation arm, but String remains nominal and inferred String construction uses the exact `join : List String → String → String` surface."
@tags "list" "combine"
concat : (a: List a) -> (b: List a) -> List a

@label "Distinct count"
@description "Number of distinct elements in a list under ordinary structural `eq`: `length (unique arr)`. NaN is never equal to itself, so every NaN counts; closures count by identity. ∀a. Eq a => List a → ℕ."
@tags "list" "aggregate"
distinctCount : (arr: List a) -> Nat
distinctCount arr = length (unique arr)

@native
@label "Drop"
@description "Skip the first n elements. ∀a. ℕ → List a → List a"
@tags "list" "slice"
drop : (n: Number) -> (arr: List a) -> List a

@native
@label "Flatten"
@description "Flatten nested lists by one level. ∀a. List (List a) → List a"
@tags "list" "structure"
flatten : (arr: List (List a)) -> List a

@native
@label "Head"
@description "First element of a list (or first character of a string). ∀a. List a → Maybe a"
@tags "list" "string" "access"
head : (xs: List a) -> Maybe a

@label "Includes"
@description "Does the list contain an element `eq` to the value? Structural: separately built constructors, records and JSON round trips are found; NaN is never found (NaN ≠ NaN); closures compare by identity. A non-list (a String included) contains nothing. ∀a. List a → a → Bool"
@tags "list" "search"
includes : (arr: List a) -> (value: a) -> Boolean
includes arr value =
  if not (isArray arr) then False
  else case head arr of
    Nothing -> False
    Just h -> if eq h value then True else includes (fromMaybe [] (tail arr)) value

@label "Intersection"
@description "Keep each element of the first list that occurs in the second under ordinary structural eq. Preserve the first list's order and duplicates."
@tags "list" "combine"
intersection : (left: List a) -> (right: List a) -> List a
intersection left right = filter (\item -> includes right item) left

@label "Subsequences"
@description "Every order-preserving selection from the list, including the empty selection. Repeated input positions remain separate choices; n items produce 2^n selections."
@tags "list" "combine"
subsequences : (arr: List a) -> List (List a)
subsequences arr =
  fold (\known item -> concat known (map (\items -> concat items [item]) known)) [[]] arr

@native
@label "Init"
@description "All elements except the last. ∀a. List a → Maybe (List a)"
@tags "list" "string" "access"
init : (xs: List a) -> Maybe (List a)

@native
@label "Last"
@description "Last element of a list (or last character of a string). ∀a. List a → Maybe a"
@tags "list" "string" "access"
last : (xs: List a) -> Maybe a

@native
@label "Lookup"
@description "Look up a dynamic key on a record. Returns Just<value> when present (regardless of value-truthiness — empty strings + 0 + false return Just), Nothing when the key is missing. ∀a. Record String a → String → Maybe a. Sister of std:assocRecord — Phase 13a sub-step 2 added this to retire the 12d-7 wrapper-side row[csvCol] dynamic-field read. Also retires one of the 12c-core deferred follow-ups."
@tags "record" "lookup" "dynamic-key"
lookup : (record: {  }) -> (key: String) -> Maybe a

-- `maximum` MOVED to ../list/extremum.fenel as a Fenel-BODIED member
-- (signature-substrate slice 3c-D2): its declared `List a -> a` was a lie —
-- the native returns host-`undefined` for the empty list and for any
-- unorderable pair. It is now `List a -> Maybe a`, with the std-ffi.ts native
-- KEPT as the ledgered perf branch returning the same tagged value.

@native
@label "Merge records"
@description "Shallow merge of two records into a new record. Fields from `b` overwrite fields from `a` on key collision (right-biased) — mirrors `{...a, ...b}` in JS / `M.union` in Haskell. Used when an orchestration body needs to extend a base payload with caller-provided extras."
@tags "record" "combine"
mergeRecords : (a: {  }) -> (b: {  }) -> {  }

-- `minimum` MOVED to ../list/extremum.fenel as a Fenel-BODIED member
-- (signature-substrate slice 3c-D2) — see the `maximum` note above.

@label "Reverse"
@fieldLabel "arr" "Items"
@description "Reverse list order. ∀a. List a → List a"
@tags "list" "ordering" "pin"
reverse : (arr: List a) -> List a
reverse arr = reverseOnto arr Nil

-- The pure cons-spine algorithm is the definition. The existing List/String
-- representation branch in std-ffi.ts selects the scoped Reprable boundary,
-- and only stock bridges may use the host shortcut. It never changes this type.
@category "engine-internal"
reverseOnto : (arr: List a) -> (acc: List a) -> List a
reverseOnto arr acc = case arr of
  Nil -> acc
  Cons h t -> reverseOnto t (Cons h acc)

_ : Iconable std.reverse
_ = Iconable { icon = "repeat" }

@native
@label "Sort lex"
@description "Sort a list of strings ascending in lexicographic (default JS string compare) order. ∀. List String → List String. The JS-native sort is stable, so equal elements preserve insertion order. Phase 21.2 introduced this as a no-key-fn alternative to `sort id …` — `sort` takes a key-function arg whose closure-conversion-in-compiled-targets is gappy on the self-host substrate, while `sortLex` is a single-arg native that lowers to a direct runtime helper call."
@tags "list" "string" "ordering"
sortLex : (arr: List String) -> List String

@native
@label "Sum"
@description "Sum of numeric array"
@tags "array" "numeric" "aggregate" "pin"
sum : (arr: List Number) -> Number

@native
@label "Tail"
@description "All elements except the first. ∀a. List a → Maybe (List a)"
@tags "list" "string" "access"
tail : (xs: List a) -> Maybe (List a)

@native
@label "Take"
@description "Take the first n elements. ∀a. ℕ → List a → List a"
@tags "list" "slice"
take : (n: Number) -> (arr: List a) -> List a

@label "Unique"
@description "Remove duplicates under ordinary structural `eq`, keeping each first occurrence in order. NaN is never equal to itself, so every NaN is kept; closures compare by identity. A non-list (a String included) gives the empty list. ∀a. List a → List a"
@tags "list" "dedup"
unique : (arr: List a) -> List a
unique arr = if isArray arr then fold (\kept h -> if includes kept h then kept else concat kept [h]) [] arr else []

@native
@label "Zip"
@description "Pair corresponding elements. ∀a b. List a → List b → List (a, b)"
@tags "list" "combine"
zip : (a: List a) -> (b: List b) -> List ((a, b))
