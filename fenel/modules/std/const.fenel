module std where

-- const — K combinator. ∀a b. a → b → a.
--
-- Pure combinator; mirrors the pre-Phase-5b4 TS native at
-- engine/src/modules/std.ts:2971 (`(x, _y) => x`).
--
-- The body is just the first param's reference — the underscore-
-- prefix `_y` is a valid Fenel ident (pre-validated by the 5b4
-- scope probe) and serves the same unused-param convention as
-- Haskell / TS. Parses to `{var: "x"}`.

@label "Const"
@description "Ignore the second argument and return the first. ∀a b. a → b → a"
@tags "function" "primitive"
const : (x: a) -> (_y: b) -> a
const x _y = x
