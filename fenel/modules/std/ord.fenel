module std where

-- Lexical ordering for Char and String — the PURE source of truth.
--
-- set-algebra-to-fenel Phase 3b-3 (string-ordering enabler). Char is
-- `$opaque { repr: "codepoint", pure: Nat ∈ unicode-scalars }` and String is
-- `$opaque { repr: "string", pure: List Char }`. Char ordering REDUCES to
-- code-point numeric ordering (the pure-ADT definition); String ordering is the
-- lexicographic fold over the two strings' chars — first differing char decides,
-- a prefix is less than its extension.
--
-- The ONE irreducible host leaf this builds on is `charCode : Char -> Number`
-- (std-ffi.ts — the host's `.codePointAt(0)`, the same category as
-- `charFromCode` / `utf8Bytes`). Everything below is pure Fenel composed from
-- `charCode` + the numeric `lt` + `head` / `tail` / `fromMaybe`.
--
-- These bodies ARE the declared source of truth for string ordering. The
-- `lt`/`gt`/`lte`/`gte` natives carry a JS-lexical `<` perf branch over the
-- opaque `repr` (ledger B4) that is byte-equivalent to `strCompare s1 s2 < 0`.
-- The full `Orderable`/`Ord` typeclass formalization is a deliberate follow-on
-- (co-sequenced with numeric-tower) — NOT this phase.

@label "Char less-than"
@description "True when char `a` orders before char `b` by Unicode code point. Char ordering reduces to numeric ordering of code points (Char = $opaque over codepoint). a/b are one-character strings (the Char runtime repr)."
@tags "char" "ordering" "comparison"
charLt : (a: String) -> (b: String) -> Boolean
charLt a b = lt (charCode a) (charCode b)

@label "Char compare"
@description "Three-way compare of two chars by code point — -1 if a<b, 0 if equal, 1 if a>b."
@tags "char" "ordering" "comparison"
charCompare : (a: String) -> (b: String) -> Number
charCompare a b = if charLt a b then -1 else if charLt b a then 1 else 0

@label "String compare"
@description "Lexicographic three-way compare of two strings (the PURE source of truth for string ordering) — -1 if a<b, 0 if equal, 1 if a>b. Folds char-by-char (String = List Char) via `charCompare`; the first differing char decides, and a prefix orders before its extension (empty string is least)."
@tags "string" "ordering" "comparison"
strCompare : (a: String) -> (b: String) -> Number
strCompare a b = case head a of
  Nothing -> case head b of
    Nothing -> 0
    Just _ -> -1
  Just ca -> case head b of
    Nothing -> 1
    Just cb -> if charLt ca cb then -1 else if charLt cb ca then 1 else strCompare (fromMaybe "" (tail a)) (fromMaybe "" (tail b))

@label "String less-than"
@description "True when string `a` orders lexicographically before string `b`. The pure-Fenel definition (strCompare a b < 0); the `lt` native's both-strings branch is its opaque-repr perf shortcut."
@tags "string" "ordering" "comparison"
strLt : (a: String) -> (b: String) -> Boolean
strLt a b = lt (strCompare a b) 0

-- sortAscending — the items in ascending order (2026-11-06, actions panel: the
-- catalogue had only the keyed `sort` and String-only `sortLex`, so a list had
-- no one-input Sort action). The identity key over the existing stable sort.

@label "Sort ascending"
@description "The items in ascending order: `sort` keyed by each item itself, stably. Items std lt cannot compare are a tie and keep encounter order. ∀a. List a → List a"
@tags "list" "ordering" "pin"
sortAscending : (arr: List a) -> List a
sortAscending arr = sort (\item -> item) arr
