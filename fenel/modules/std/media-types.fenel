module std where

-- Shared record declarations own the field identities used by every image
-- function. A single constructor with named fields lowers to a plain record;
-- existing RGBA pixels and raster images keep their untagged native carriers.

@entity
@label "RGBA raster pixel"
@description "Display encoding with natural-number r, g, b and a byte channels. Alpha encodes raster coverage; physical Color is a positive frequency, and spectra and composition carry separate meanings."
@tags "media" "visual" "pixel" "encoding"
RgbaPixel = RgbaPixel r: Nat g: Nat b: Nat a: Nat

@entity
@label "Image"
@description "Encoded raster image stored as width, height and a row-major list of RGBA pixels. Spectral source data is retained separately from its explicit display projection."
@tags "media" "visual" "raster"
Image = Image width: Nat height: Nat pixels: List RgbaPixel

-- A pasted or stored file. The address is a String because it may be a data
-- URL, which the format:url refinement does not accept. Telegram's File and
-- the shop's Asset are different records and stay those types.
@entity
@label "File"
@description "A stored file: its name, media type, size in bytes, content hash, and the address of its bytes."
@tags "media" "file"
File = File name: String mimeType: String size: Nat hash: String url: String
