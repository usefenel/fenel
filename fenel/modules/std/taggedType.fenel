module std where

-- The source owns the singleton set. Only the dollar-keyed Type envelope
-- crosses the same marshalling boundary as the other dynamic type builders.
TaggedSingletonTypeMarker = TaggedSingletonTypeMarker base: Type phantomBase: Type constraint: SetExpr

@native
@category "engine-internal"
taggedSingletonTypeFromMarker : (marker: TaggedSingletonTypeMarker) -> Type

@label "Tagged singleton type"
@description "Build a tagged type whose phantom is the intersection of its declared domain and one typed value's singleton set."
@tags "type" "reflection" "dependent"
taggedSingletonType : (base: Type) -> (phantomBase: Type) -> (phantomValue: a) -> Type
taggedSingletonType base phantomBase phantomValue =
  taggedSingletonTypeFromMarker (TaggedSingletonTypeMarker { base = base, phantomBase = phantomBase, constraint = SeEnum { values = [phantomValue] } })
