module std where

-- isUuid — the canonical text form of an RFC 4122 UUID: 36 characters,
-- hyphens at 8, 13, 18 and 23, hexadecimal digits elsewhere (either case),
-- version 1-5 and the RFC variant.
--
-- Added 2026-09-23 for `auth:switchAccount`, which refuses a malformed account
-- id before it reaches a storage read. It lives in std because a runtime body
-- cannot call the engine (the engine is not in the execute profile), and the
-- field identity kernel calls it too: `engine:fieldIdentityIsUuid` for one
-- text, and `isUuidVersion` in the batched lock check. The engine keeps two
-- restatements: a character walk for values that are not host strings, and
-- the batched shape check `engine:fieldIdentityUuidShapes`. The digits are
-- counted with native string operations rather than 36 interpreter steps per
-- character. Three declarations, because one would exceed the parser's
-- per-declaration token cap.

@label "Is UUID"
@description "True for the canonical text form of an RFC 4122 UUID: 36 characters, hyphens at positions 8, 13, 18 and 23, hexadecimal digits elsewhere in either case, version 1-5 and the RFC variant."
@tags "string" "predicate" "uuid"
isUuid : (text: String) -> Boolean
isUuid text =
  if not (eq (length text) 36)
  then false
  else and (isUuidDigits text) (isUuidVersion text)

@label "UUID digits and hyphens"
@description "For a 36-character text: hyphens at positions 8, 13, 18 and 23 and hexadecimal digits (either case) everywhere else. Part of isUuid."
@tags "string" "predicate" "uuid" "internal"
isUuidDigits : (text: String) -> Boolean
isUuidDigits text =
  let stripped = fold (\remaining digit -> replaceAll remaining digit "") (lower text) (chars "0123456789abcdef")
  let hyphens = fold (\valid index -> and valid (eq (slice text index (add index 1)) "-")) true [8, 13, 18, 23]
  and hyphens (eq stripped "----")

@label "UUID version and variant"
@description "For a 36-character text: version digit 1-5 and the RFC variant (8, 9, a or b). Part of isUuid."
@tags "string" "predicate" "uuid" "internal"
isUuidVersion : (text: String) -> Boolean
isUuidVersion text = and (elem (lower (slice text 14 15)) "12345") (elem (lower (slice text 19 20)) "89ab")
