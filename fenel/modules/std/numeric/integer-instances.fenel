decodableNatText : Decodable String Nat
decodableNatText = Decodable { decode = std.parseNatExact }

encodableNatText : Encodable String Nat
encodableNatText = Encodable { encode = std.encodeNatExactText }

decodableIntText : Decodable String Int
decodableIntText = Decodable { decode = std.parseIntExact }

encodableIntText : Encodable String Int
encodableIntText = Encodable { encode = std.encodeIntExactText }
