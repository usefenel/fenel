ratNeqM a b = Just (not (ratEq a b))

@label "Rational lt (Maybe)"
@description "Decidable Rational strict order: ratLtM a b = Just (ratLt a b)."
@tags "numeric" "rational" "lt"
ratLtM : (a: Rational) -> (b: Rational) -> Maybe Bool
ratLtM a b = Just (ratLt a b)

@label "Rational lte (Maybe)"
@description "Decidable Rational ≤: ratLteM a b = Just (or (ratLt a b) (ratEq a b))."
@tags "numeric" "rational" "lte"
ratLteM : (a: Rational) -> (b: Rational) -> Maybe Bool
ratLteM a b = Just (or (ratLt a b) (ratEq a b))

@label "Rational gt (Maybe)"
@description "Decidable Rational >: ratGtM a b = Just (ratLt b a)."
@tags "numeric" "rational" "gt"
ratGtM : (a: Rational) -> (b: Rational) -> Maybe Bool
ratGtM a b = Just (ratLt b a)

@label "Rational gte (Maybe)"
@description "Decidable Rational ≥: ratGteM a b = Just (or (ratLt b a) (ratEq a b))."
@tags "numeric" "rational" "gte"
ratGteM : (a: Rational) -> (b: Rational) -> Maybe Bool
ratGteM a b = Just (or (ratLt b a) (ratEq a b))

-- --- Real (PARTIAL; Eq + Ord at a DEFAULT fuel budget) -------------------------
-- The ℝ instance closes the fuel over the existing realEq/realLt (Maybe Bool) at
-- a sensible default budget so the class method has the SAME arity as the
-- decidable rungs. Explicit-fuel callers use realEq/realLt directly (the *Within
-- pair). The budget `numberToNat 64` is INLINED in each wrapper (a nullary
-- `realDefaultFuel : Nat` value referenced bare resolves to a function REFERENCE,
-- not its evaluated Nat — so it cannot be a shared const; the inline `(numberToNat
-- 64)` is the call). 64 separates reals up to ~1/64 apart within the 1/(k+1)
-- linear modulus; built via numberToNat (the bridge path — Succ-literal Nats blow
-- deep recursion, the Phase-4 surprise); it is the structural-recursion counter
-- realSeparate counts down.

@label "Negate a Maybe Bool"
@description "negateMB m = case m of Nothing -> Nothing | Just x -> Just (not x). Lifts boolean negation through the decidability Maybe — Nothing (undecided) stays Nothing, a decided Just flips. Used by the ℝ neq/lte/gte wrappers (≤ via ¬(b<a))."
@tags "numeric" "maybe" "bool"
negateMB : (m: Maybe Bool) -> Maybe Bool
negateMB m = case m of
  Nothing -> Nothing
  Just x -> Just (not x)

@label "Real eq (default fuel)"
@description "realEqDefault a b = realEq a b (numberToNat 64) : Maybe Bool. SOUND-conservative — Just False on separation, Nothing when equality is undecided within budget (NEVER Just True; real equality is not positively confirmable). The Eq Real instance's eq."
@tags "numeric" "real" "eq" "partial"
realEqDefault : (a: Real) -> (b: Real) -> Maybe Bool
realEqDefault a b = realEq a b (numberToNat 64)

@label "Real neq (default fuel)"
@description "realNeqDefault a b = negateMB (realEqDefault a b). Just True on separation, Nothing when undecided. The Eq Real instance's neq."
@tags "numeric" "real" "neq" "partial"
realNeqDefault : (a: Real) -> (b: Real) -> Maybe Bool
realNeqDefault a b = negateMB (realEqDefault a b)

@label "Real lt (default fuel)"
@description "realLtDefault a b = realLt a b (numberToNat 64) : Maybe Bool. Just True/False on a separation witness, Nothing when undecided within budget. The Ord Real instance's lt."
@tags "numeric" "real" "lt" "partial"
realLtDefault : (a: Real) -> (b: Real) -> Maybe Bool
realLtDefault a b = realLt a b (numberToNat 64)

@label "Real gt (default fuel)"
@description "realGtDefault a b = realLt b a (numberToNat 64) (flip lt). The Ord Real instance's gt."
@tags "numeric" "real" "gt" "partial"
realGtDefault : (a: Real) -> (b: Real) -> Maybe Bool
realGtDefault a b = realLt b a (numberToNat 64)

@label "Real lte (default fuel)"
@description "realLteDefault a b = negateMB (realLt b a (numberToNat 64)) — a ≤ b ⟺ ¬(b < a), lifted through the decidability Maybe (Nothing stays Nothing). The Ord Real instance's lte."
@tags "numeric" "real" "lte" "partial"
realLteDefault : (a: Real) -> (b: Real) -> Maybe Bool
realLteDefault a b = negateMB (realLt b a (numberToNat 64))

@label "Real gte (default fuel)"
@description "realGteDefault a b = negateMB (realLt a b (numberToNat 64)) — a ≥ b ⟺ ¬(a < b). The Ord Real instance's gte."
@tags "numeric" "real" "gte" "partial"
realGteDefault : (a: Real) -> (b: Real) -> Maybe Bool
realGteDefault a b = negateMB (realLt a b (numberToNat 64))
