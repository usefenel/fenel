module std where

-- =========================================================================
-- Numeric comparison wrappers — the `Maybe Bool` comparison layer the Phase-5
-- Eq/Ord instances reference (numeric-tower Phase 5, FORK-1 (B) UNIFORM
-- `Maybe Bool`).
--
-- WHY THIS LAYER EXISTS. FORK-1 resolution (B) types `Eq.eq`/`Ord.lt` as
-- `a -> a -> Maybe Bool` so ONE class hosts both the decidable rungs
-- (Nat/Int/Rational — always `Just …`) AND the partial ℝ rung (realEq/realLt's
-- `Maybe Bool`). The Phase 1–3 comparison bodies (natEq/natLt/intEq/intLt/ratEq/
-- ratLt) return a TOTAL `Boolean`, so the decidable instances cannot reference
-- them directly — they reference these thin `Just (…)`-wrapping adapters. The ℝ
-- adapters close the fuel budget over realEq/realLt (which already return
-- `Maybe Bool`) at a sensible default, so the class method `lt`/`eq` need no fuel
-- arg (the divergent-arity problem FORK-1 names). The `Just`-wrap is cheap +
-- honest: a total comparison IS "always-decidable". [[feedback_opaque_is_optimization]]
--
-- DERIVED ORDER METHODS. Only `*Lt` (and `*Eq`) exist as Phase 1–3 bodies; lte/
-- gt/gte are composed here: `lte = lt ∨ eq`, `gt = flip lt`, `gte = flip lt ∨ eq`.
-- (A future subsumption may collapse Ord to the minimal-complete `lt` with these
-- as std fns over Ord — recorded in typeclass-specs.fenel, not done here.)
--
-- ENGINE-BUG §0.3 WATCH (the roadmap Phase-4 surprise). A bare uppercase ident in
-- ARGUMENT position parses as a variable (`Just True` ⇒ `Just null`). Every
-- `Just (…)` below wraps a PARENTHESIZED lowercase application (`Just (natEq a b)`
-- ⇒ `{construct:["Just",{call:…}]}`), never a bare nullary ctor, so the bug does
-- not bite. `Nothing` appears only in tail/return position (safe — the Phase-4
-- sepDecision precedent). These are NEW standalone fnIds; NOT added to stdNatives.

-- --- Nat (decidable; Eq + Ord) -------------------------------------------------
@label "Nat eq (Maybe)"
@description "Decidable Nat equality, Just-wrapped for the Eq Nat instance: natEqM a b = Just (natEq a b). Always Just (Nat equality is total)."
@tags "numeric" "nat" "eq"
natEqM : (a: Nat) -> (b: Nat) -> Maybe Bool
natEqM a b = Just (natEq a b)

@label "Nat neq (Maybe)"
@description "Decidable Nat inequality: natNeqM a b = Just (not (natEq a b)). Always Just."
@tags "numeric" "nat" "neq"
natNeqM : (a: Nat) -> (b: Nat) -> Maybe Bool
natNeqM a b = Just (not (natEq a b))

@label "Nat lt (Maybe)"
@description "Decidable Nat strict order: natLtM a b = Just (natLt a b). Always Just."
@tags "numeric" "nat" "lt"
natLtM : (a: Nat) -> (b: Nat) -> Maybe Bool
natLtM a b = Just (natLt a b)

@label "Nat lte (Maybe)"
@description "Decidable Nat ≤: natLteM a b = Just (or (natLt a b) (natEq a b)). Always Just."
@tags "numeric" "nat" "lte"
natLteM : (a: Nat) -> (b: Nat) -> Maybe Bool
natLteM a b = Just (or (natLt a b) (natEq a b))

@label "Nat gt (Maybe)"
@description "Decidable Nat >: natGtM a b = Just (natLt b a) (flip lt). Always Just."
@tags "numeric" "nat" "gt"
natGtM : (a: Nat) -> (b: Nat) -> Maybe Bool
natGtM a b = Just (natLt b a)

@label "Nat gte (Maybe)"
@description "Decidable Nat ≥: natGteM a b = Just (or (natLt b a) (natEq a b)). Always Just."
@tags "numeric" "nat" "gte"
natGteM : (a: Nat) -> (b: Nat) -> Maybe Bool
natGteM a b = Just (or (natLt b a) (natEq a b))

-- --- Int (decidable; Eq + Ord) -------------------------------------------------
@label "Int eq (Maybe)"
@description "Decidable Int equality, Just-wrapped: intEqM a b = Just (intEq a b)."
@tags "numeric" "int" "eq"
intEqM : (a: Int) -> (b: Int) -> Maybe Bool
intEqM a b = Just (intEq a b)

@label "Int neq (Maybe)"
@description "Decidable Int inequality: intNeqM a b = Just (not (intEq a b))."
@tags "numeric" "int" "neq"
intNeqM : (a: Int) -> (b: Int) -> Maybe Bool
intNeqM a b = Just (not (intEq a b))

@label "Int lt (Maybe)"
@description "Decidable Int strict order: intLtM a b = Just (intLt a b)."
@tags "numeric" "int" "lt"
intLtM : (a: Int) -> (b: Int) -> Maybe Bool
intLtM a b = Just (intLt a b)

@label "Int lte (Maybe)"
@description "Decidable Int ≤: intLteM a b = Just (or (intLt a b) (intEq a b))."
@tags "numeric" "int" "lte"
intLteM : (a: Int) -> (b: Int) -> Maybe Bool
intLteM a b = Just (or (intLt a b) (intEq a b))

@label "Int gt (Maybe)"
@description "Decidable Int >: intGtM a b = Just (intLt b a)."
@tags "numeric" "int" "gt"
intGtM : (a: Int) -> (b: Int) -> Maybe Bool
intGtM a b = Just (intLt b a)

@label "Int gte (Maybe)"
@description "Decidable Int ≥: intGteM a b = Just (or (intLt b a) (intEq b a))."
@tags "numeric" "int" "gte"
intGteM : (a: Int) -> (b: Int) -> Maybe Bool
intGteM a b = Just (or (intLt b a) (intEq a b))

