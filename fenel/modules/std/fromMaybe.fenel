module std where

-- fromMaybe — unwrap a Maybe to its value, or a caller-supplied default
-- when Nothing. ∀a. a → Maybe a → a (Haskell `fromMaybe`, default-first).
--
-- FM-retire-4 Step 1 (typed-function-references) — the missing Maybe staple.
-- std had no `fromMaybe`/`withDefault`, so it got monomorphized inside the
-- `forms` module as `maybeRecordOr` ({}-default) + `maybeStrOr` (String
-- default) and as the `tailOrEmpty` ([]-default-on-`tail`) helper duplicated
-- in BOTH forms/submit.fenel AND imports/imports.fenel. This is the one
-- general primitive all of those are special cases of:
--   maybeRecordOr m        ≡ fromMaybe {} m
--   maybeStrOr m fallback   ≡ fromMaybe fallback m
--   tailOrEmpty xs          ≡ fromMaybe [] (tail xs)
--
-- Pure; the canonical Maybe eliminator. Body parses to a `case` over the
-- two Maybe arms.

@label "From Maybe"
@description "Unwrap a Maybe to its value, or the supplied default when Nothing. ∀a. a → Maybe a → a (Haskell `fromMaybe`, default-first). The canonical Maybe eliminator — fromMaybe {} m, fromMaybe \"\" m, fromMaybe [] (tail xs) subsume the ad-hoc default-on-absence helpers."
@tags "maybe" "default" "access"
fromMaybe : (def: a) -> (m: Maybe a) -> a
fromMaybe def m =
  case m of
    Nothing -> def
    Just v -> v
