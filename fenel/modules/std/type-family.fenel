module std where

-- The application is ordinary Type data. The source projection chooses its
-- existing identity and arguments; only the permanent dollar-key envelope
-- crosses this bodyless B3 leaf.
TypeFamilyApplicationMarker = TypeFamilyApplicationMarker family: Anything arguments: List Anything

@native
@category "engine-internal"
typeFamilyFromMarker : (marker: TypeFamilyApplicationMarker) -> Type
