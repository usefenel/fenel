module std where

-- isMultipleOf — predicate: `value` is integer multiple of step `num/den`.
-- (Number, Number, Number) → Boolean.
--
-- Pure expression; mirrors the TS native at
-- engine/src/resolution.ts:isMultipleOf (`Math.abs(scaled -
-- Math.round(scaled)) < 1e-9` where `scaled = value * den / num`).
--
-- Decomposed into a `let scaled = value * den / num` followed by
-- `abs (scaled - round scaled) < 1.0e-9`. Body composes from
-- existing std fns — `abs` / `round` / `mul` / `div` / `sub` / `lt` —
-- and a literal `1.0e-9` (parses to `1e-9` per fenel-parser).
--
-- Phase 2 of field-meta-collapse (2026-05-26): originally landed
-- TS-native in commit 4d7339d; immediately ported to .fenel after
-- Rom flagged the regression of `ts-elimination` workstream's intent
-- (TS only for irreducible host IO; predicates / arithmetic must be
-- Fenel-bodied). The Fenel body re-enters TS at the substrate-leaf
-- bodies of `abs` / `round` etc. — that's expected and acceptable;
-- the source-of-truth is `.fenel`, the leaf bodies are an internal
-- bridge to JS host arithmetic.

@label "Is multiple of"
@description "True when `value` is an integer multiple of `num/den` (within IEEE-754 tolerance 1e-9). Used by field-editor's number-resolution refinement: `isMultipleOf value 1 100` accepts hundredths (cents)."
@tags "numeric" "predicate" "resolution"
isMultipleOf : (value: Number) -> (num: Number) -> (den: Number) -> Boolean
isMultipleOf value num den =
  let scaled = value * den / num
  abs (scaled - round scaled) < 1.0e-9
