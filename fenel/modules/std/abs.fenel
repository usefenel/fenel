module std where

-- abs — absolute value. Number → Number.
--
-- Pure expression; mirrors the pre-Phase-5b3 TS native `absNative`
-- at engine/src/modules/std.ts:2789 (`Math.abs(toNum(x))`).
--
-- Decomposed into a pattern-match: `if x < 0 then -x else x`. The
-- Fenel port omits both the `toNum(x)` coercion and the `Math.abs`
-- host call — the typed spec's `x: Number` makes the defense
-- redundant; the host call is replaced by the pure pattern.
--
-- Documented JS-host divergence: `Math.abs(-0) === 0` but the
-- Fenel body returns -0 (since `lt -0 0` is false). Acceptable
-- because Fenel's typed spec is `Number`, not `±0`-permitting —
-- the divergence is the price of typed honesty.

@label "Absolute value"
@description "Absolute value of a number"
@tags "numeric" "pin"
abs : (x: Number) -> Number
abs x = if lt x 0 then 0 - x else x
