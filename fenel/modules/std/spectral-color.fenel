module std where

-- Color denotes a finite positive frequency in canonical hertz. It inherits
-- Number's existing pure numeric tower and representation, not a new atom.
-- Spectrum is a bounded finite line spectrum: each frequency retains its own
-- nonnegative relative weight. RGB coordinates never recover a single Color.
-- Opacity/transmission are composition data, separate from Color and Spectrum.
-- Display coordinates below are a declared primary model, not measured sRGB,
-- a CIE observer, a continuous spectrum or a reversible physical encoding.

@label "Color"
@description "A finite positive frequency in canonical hertz. One Color is monochromatic; a mixture remains a Spectrum of independently weighted frequencies."
Color = Number | numberIsFinite value && value > 0

@label "Spectral weight"
@description "A finite nonnegative relative spectral weight. Zero contributes no light; no absolute radiometric unit or normalization is implied."
SpectralWeight = Number | numberIsFinite value && value >= 0

@label "Opacity"
@description "A finite composition coefficient from 0 through 1. It belongs to a blend or transmission operation, not to Color or Spectrum."
Opacity = Number | numberIsFinite value && value >= 0 && value <= 1

@label "Spectral component"
SpectralComponent = SpectralComponent frequency: Color weight: SpectralWeight

@label "Spectrum"
@description "A finite list of independently weighted frequency components. This discrete line model retains each frequency; it is not a continuous spectral distribution. Operation budgets belong to the admitted functions, not to the meaning of Spectrum."
-- A plain `Spectrum = List SpectralComponent` is parsed as a List-named
-- variant constructor. The existing refinement spelling forces the intended
-- application type; membership in U leaves its full List denotation unchanged.
Spectrum = List SpectralComponent | value ∈ U

@label "Declared observer band"
@description "Authored lower/upper positive frequencies in hertz and a label. These bounds are a declared model, not a universal biological visibility limit."
SpectralObserverBand = SpectralObserverBand name: String lowerHz: Color upperHz: Color

@label "Declared RGB primary profile"
@description "Three distinct monochromatic primary frequencies in canonical hertz. RGB coordinates weight these declared primaries. A profile must state its own provenance; illustrative data is not a measured standard sRGB spectrum."
SpectralRgbProfile = SpectralRgbProfile name: String red: Color green: Color blue: Color

@label "RGB coordinates"
@description "Relative linear coefficients of the three frequencies in a declared profile, each from 0 through 1. These coordinates do not independently identify a physical spectrum."
SpectralRgb = SpectralRgb red: Number green: Number blue: Number

@label "Frequency transmission"
@description "An explicit transmission from 0 through 1 at one positive frequency. Unlisted frequencies refuse rather than acquiring an invented filter response."
SpectralTransmission = SpectralTransmission frequency: Color transmission: Opacity

colorAdmitted : (frequency: Number) -> Bool
colorAdmitted frequency = numberIsFinite frequency && frequency > 0

spectralWeightAdmitted : (weight: Number) -> Bool
spectralWeightAdmitted weight = numberIsFinite weight && weight >= 0

opacityAdmitted : (opacity: Number) -> Bool
opacityAdmitted opacity = numberIsFinite opacity && opacity >= 0 && opacity <= 1

spectralComponentAdmitted : (component: SpectralComponent) -> Bool
spectralComponentAdmitted component = colorAdmitted component.frequency && spectralWeightAdmitted component.weight

spectralObserverBandAdmitted : (band: SpectralObserverBand) -> Bool
spectralObserverBandAdmitted band = colorAdmitted band.lowerHz && colorAdmitted band.upperHz && band.lowerHz <= band.upperHz

spectralRgbProfileAdmitted : (profile: SpectralRgbProfile) -> Bool
spectralRgbProfileAdmitted profile = colorAdmitted profile.red && colorAdmitted profile.green && colorAdmitted profile.blue && profile.red != profile.green && profile.red != profile.blue && profile.green != profile.blue

@label "Color from hertz"
@description "Admit a finite positive hertz value as Color. Zero, negative, nonnumeric and nonfinite inputs return Err. No wavelength or frequency is inferred from RGB."
colorFromHertz : (frequencyHz: Number) -> Result String Color
colorFromHertz frequencyHz = if colorAdmitted frequencyHz then Ok frequencyHz else Err "Use a finite positive frequency in hertz."

@label "Type of human-spectrum Color"
@description "Narrow Color to an authored observer band's closed interval using the existing refinement and SetExpr machinery. Invalid bounds produce the empty type. The chosen band is model data, not a universal visibility claim."
humanSpectrumColorType : (band: SpectralObserverBand) -> Type
humanSpectrumColorType band =
  let constraint = if spectralObserverBandAdmitted band then SeInterval { interval = { lo = Just { value = band.lowerHz, inclusive = true }, hi = Just { value = band.upperHz, inclusive = true } } } else SeNone
  assocRecord {} "$refined" { base = assocRecord {} "$ref" "Color", set = constraint }

@label "Color in an observer band"
@description "The frequency parameter's type depends on the selected observer band. The same source checks the supplied frequency and refuses invalid or outside-band data; it reads no clock or host observation."
humanSpectrumColor : (band: SpectralObserverBand) -> (frequency: humanSpectrumColorType band) -> Result String Color
humanSpectrumColor band frequency =
  if not (spectralObserverBandAdmitted band) then Err "Use ordered finite positive observer-band bounds in hertz."
  else if colorAdmitted frequency && frequency >= band.lowerHz && frequency <= band.upperHz then Ok frequency
  else Err "The frequency is outside the declared observer band."

spectralInsert : (state: Result String Spectrum) -> (component: SpectralComponent) -> Result String Spectrum
spectralInsert state component = case state of
  Err problem -> Err problem
  Ok components ->
    if component.weight == 0 then Ok components
    else case find (\present -> present.frequency == component.frequency) components of
      Nothing -> if length components < 64 then Ok (appendItem component components) else Err "The normalized spectrum must contain at most 64 distinct frequencies."
      Just present ->
        let total = present.weight + component.weight
        if not (spectralWeightAdmitted total) then Err "The accumulated spectral weight exceeds the finite Number range."
        else Ok (map (\entry -> if entry.frequency == component.frequency then SpectralComponent { frequency = entry.frequency, weight = total } else entry) components)

@label "Normalize a finite spectrum"
@description "Validate at most 128 input components, merge exactly equal Number frequencies, omit zero weights and retain at most 64 distinct frequencies. Invalid data or weight overflow returns Err. Order follows the first contributing occurrence; no frequency is averaged."
normalizeSpectrum : (components: List SpectralComponent) -> Result String Spectrum
normalizeSpectrum components =
  if not (isArray components && length components <= 128) then Err "Use a list of at most 128 spectral components."
  else if not (all components spectralComponentAdmitted) then Err "Every component needs finite positive hertz and a finite nonnegative weight."
  else fold spectralInsert (Ok []) components

@label "Single-frequency spectrum"
monochromaticSpectrum : (frequencyHz: Number) -> (weight: Number) -> Result String Spectrum
monochromaticSpectrum frequencyHz weight = normalizeSpectrum [SpectralComponent { frequency = frequencyHz, weight = weight }]

@label "Add spectra"
@description "Add independent spectral contributions. Equal frequencies sum their weights; distinct frequencies remain separate. Each input has at most 64 components; overflow or more than 64 resulting distinct frequencies refuses."
addSpectra : (first: Spectrum) -> (second: Spectrum) -> Result String Spectrum
addSpectra first second =
  if not (isArray first && isArray second && length first <= 64 && length second <= 64) then Err "Each spectrum must contain at most 64 components."
  else normalizeSpectrum (concat first second)

@label "Scale a spectrum"
scaleSpectrum : (spectrum: Spectrum) -> (factor: Number) -> Result String Spectrum
scaleSpectrum spectrum factor =
  if not (isArray spectrum && length spectrum <= 64 && all spectrum spectralComponentAdmitted && spectralWeightAdmitted factor) then Err "Use at most 64 valid components and a finite nonnegative scale."
  else normalizeSpectrum (map (\component -> SpectralComponent { frequency = component.frequency, weight = component.weight * factor }) spectrum)

@label "Blend spectra with explicit opacity"
@description "Compute opacity times foreground plus (1-opacity) times background. Opacity is an explicit finite coefficient from 0 through 1, never a field of Color or Spectrum. This is a mixture of contributions; frequencies are not interpolated."
blendSpectra : (foreground: Spectrum) -> (background: Spectrum) -> (opacity: Number) -> Result String Spectrum
blendSpectra foreground background opacity =
  if not (opacityAdmitted opacity) then Err "Use a finite composition opacity from 0 through 1."
  else case scaleSpectrum foreground opacity of
    Err problem -> Err problem
    Ok front -> case scaleSpectrum background (1 - opacity) of
      Err problem -> Err problem
      Ok back -> addSpectra front back

@label "RGB coordinates to spectrum"
@description "Weight the three distinct positive frequencies in an explicitly supplied primary profile. Red/green/blue are finite linear coefficients from 0 through 1. White retains three contributions; purple retains red and blue. No measured sRGB spectra or single-frequency inverse is invented."
rgbToSpectrum : (profile: SpectralRgbProfile) -> (red: Number) -> (green: Number) -> (blue: Number) -> Result String Spectrum
rgbToSpectrum profile red green blue =
  if not (spectralRgbProfileAdmitted profile) then Err "Use three distinct finite positive primary frequencies in hertz."
  else if not (opacityAdmitted red && opacityAdmitted green && opacityAdmitted blue) then Err "Use finite RGB coefficients from 0 through 1."
  else normalizeSpectrum [SpectralComponent { frequency = profile.red, weight = red }, SpectralComponent { frequency = profile.green, weight = green }, SpectralComponent { frequency = profile.blue, weight = blue }]

spectralHueChannel : (p: Number) -> (q: Number) -> (hue: Number) -> Number
spectralHueChannel p q hue =
  let t = if hue < 0 then hue + 1 else if hue > 1 then hue - 1 else hue
  if t < 1 / 6 then p + (q - p) * 6 * t
  else if t < 1 / 2 then q
  else if t < 2 / 3 then p + (q - p) * (2 / 3 - t) * 6
  else p

@label "HSL coordinates to spectrum"
@description "Convert finite hue degrees from 0 through 360 and saturation/lightness from 0 through 1 into RGB coefficients of the supplied primary profile, then retain their weighted Spectrum. Hue 360 equals 0. This is the declared coordinate model, not a calibrated perceptual or measured sRGB spectrum."
hslToSpectrum : (profile: SpectralRgbProfile) -> (hueDegrees: Number) -> (saturation: Number) -> (lightness: Number) -> Result String Spectrum
hslToSpectrum profile hueDegrees saturation lightness =
  if not (numberIsFinite hueDegrees && hueDegrees >= 0 && hueDegrees <= 360 && opacityAdmitted saturation && opacityAdmitted lightness) then Err "Use finite hue from 0 through 360 degrees and saturation/lightness from 0 through 1."
  else if saturation == 0 then rgbToSpectrum profile lightness lightness lightness
  else
    let hue = hueDegrees / 360
    let q = if lightness < 0.5 then lightness * (1 + saturation) else lightness + saturation - lightness * saturation
    let p = 2 * lightness - q
    rgbToSpectrum profile (spectralHueChannel p q (hue + 1 / 3)) (spectralHueChannel p q hue) (spectralHueChannel p q (hue - 1 / 3))

spectralWeightAt : (spectrum: Spectrum) -> (frequency: Color) -> Number
spectralWeightAt spectrum frequency = fold (\total component -> if component.frequency == frequency then total + component.weight else total) 0 spectrum

@label "Spectrum to declared RGB coordinates"
@description "A partial projection into the supplied profile's three-frequency basis. Other frequencies refuse; accumulated coefficients above 1 refuse rather than clipping. The original Spectrum remains the source. This is not a physical spectrum reconstruction or a reversible Reprable instance."
spectrumToRgb : (profile: SpectralRgbProfile) -> (spectrum: Spectrum) -> Result String SpectralRgb
spectrumToRgb profile spectrum =
  if not (spectralRgbProfileAdmitted profile) then Err "Use three distinct finite positive primary frequencies in hertz."
  else if not (isArray spectrum && length spectrum <= 64 && all spectrum spectralComponentAdmitted) then Err "Use at most 64 valid spectral components."
  else if not (all spectrum (\component -> component.weight == 0 || component.frequency == profile.red || component.frequency == profile.green || component.frequency == profile.blue)) then Err "This spectrum contains a contributing frequency outside the declared RGB primary basis."
  else
    let red = spectralWeightAt spectrum profile.red
    let green = spectralWeightAt spectrum profile.green
    let blue = spectralWeightAt spectrum profile.blue
    if opacityAdmitted red && opacityAdmitted green && opacityAdmitted blue then Ok (SpectralRgb { red = red, green = green, blue = blue })
    else Err "The primary coefficients exceed the supported finite 0-through-1 display fragment."

spectralTransmissionAdmitted : (entry: SpectralTransmission) -> Bool
spectralTransmissionAdmitted entry = colorAdmitted entry.frequency && opacityAdmitted entry.transmission

spectralApplyTransmission : (filter: List SpectralTransmission) -> (state: Result String Spectrum) -> (component: SpectralComponent) -> Result String Spectrum
spectralApplyTransmission filter state component = case state of
  Err problem -> Err problem
  Ok components -> case find (\entry -> entry.frequency == component.frequency) filter of
    Nothing -> if component.weight == 0 then Ok components else Err "The filter has no declared transmission at a contributing frequency."
    Just entry -> spectralInsert (Ok components) (SpectralComponent { frequency = component.frequency, weight = component.weight * entry.transmission })

@label "Apply an explicit spectral filter"
@description "Multiply each frequency's weight by an explicitly supplied finite transmission from 0 through 1. Require at most 64 spectrum/filter entries and one filter entry per frequency; missing contributing frequencies refuse. This declares a transmission model, not a physical pigment model or frequency subtraction."
filterSpectrum : (spectrum: Spectrum) -> (filter: List SpectralTransmission) -> Result String Spectrum
filterSpectrum spectrum filter =
  if not (isArray spectrum && length spectrum <= 64 && all spectrum spectralComponentAdmitted) then Err "Use at most 64 valid spectral components."
  else if not (isArray filter && length filter <= 64 && all filter spectralTransmissionAdmitted) then Err "Use at most 64 finite positive filter frequencies with transmissions from 0 through 1."
  else if length (unique (map (\entry -> entry.frequency) filter)) != length filter then Err "The filter must declare each frequency at most once."
  else fold (spectralApplyTransmission filter) (Ok []) spectrum
