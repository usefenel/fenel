module std where

-- count — list length as a Number. ∀a. List a → Number.
--
-- Pure expression; mirrors the pre-Phase-5b4 TS native at
-- engine/src/modules/std.ts:2974 (`(arr) => toArr(arr).length`).
--
-- Direct delegation to the canonical String/List polymorphic
-- `length` stdNative — `count` is one of the canonical aggregators
-- (length / count / sum / avg / minimum / maximum / distinctCount; the
-- retired `$preimage` former named them). Staying TS-native
-- pre-5b4 was an inertia artefact — the helper IS pure `length`-
-- composition. Body parses to `{call: ["length", {var: "arr"}]}`
-- with no self-call (count and length are distinct stdNatives).

@label "Count"
@description "Number of elements in a list. ∀a. List a → ℕ"
@tags "list" "size"
count : (arr: List a) -> Number
count arr = length arr
