-- =========================================================================
-- Email — the 5 `EmailService` PROVIDER instances, authored as Fenel typed
-- values (module-substrate Phase 3k follow-up: providers ARE values).
--
-- An instance is a typed VALUE of the capability type: `emailMailgun :
-- EmailService mailgun` is a value whose type is `EmailService` applied to the
-- provider tag `mailgun`. `loadFenelModule(..., {dispatchInstanceFile:true})`
-- projects each into the `ClassInstance { typeName:"EmailService",
-- args:[<provider>], methods, label, priority }` shape the registry's
-- `listProvidersSorted` + `resolveCapabilityMethod` read — exactly the codec
-- `instances.fenel` pattern (Iso/Lens/Decodable), here with the provider tag as
-- the (lowercase) type-application arg.
--
-- METHODS are fnId STRINGS — the qualified dispatch name
-- `EmailService.<provider>.<method>` (codec's instances no longer do this:
-- they write the reference `encode = codec.base64Encode`).
-- `resolveCapabilityMethod` returns this
-- string as its `spec`; the runtime dispatch keys off `provider.args[0]` +ARGS
-- the capability method name (NOT the spec), so the string is the
-- browsable/identifying value, never executed directly. The three domain ops
-- use the RENAMED plain idents `domainAdd` / `domainVerify` / `domainList`
-- (see `capability.fenel` for why the dots were cosmetic + internal-only).
--
-- `priority` orders providers (fenel 100 > mailgun 50 > postmark 45 > ses 40 >
-- resend 35); `listProvidersSorted` reads the lifted `priority` slot. `label`
-- is the dev-facing provider name. The `fenel` pseudo-provider is the managed
-- default (master env vars, no per-account creds — see `credentials.fenel`).
-- =========================================================================

emailFenel : EmailService "fenel"
emailFenel = EmailService { send = "EmailService.fenel.send", send_batch = "EmailService.fenel.send_batch", suppress = "EmailService.fenel.suppress", domainAdd = "EmailService.fenel.domainAdd", domainVerify = "EmailService.fenel.domainVerify", domainList = "EmailService.fenel.domainList", label = "Fenel Email (managed)", priority = 100 }

emailMailgun : EmailService "mailgun"
emailMailgun = EmailService { send = "EmailService.mailgun.send", send_batch = "EmailService.mailgun.send_batch", suppress = "EmailService.mailgun.suppress", domainAdd = "EmailService.mailgun.domainAdd", domainVerify = "EmailService.mailgun.domainVerify", domainList = "EmailService.mailgun.domainList", label = "Mailgun", priority = 50 }

emailPostmark : EmailService "postmark"
emailPostmark = EmailService { send = "EmailService.postmark.send", send_batch = "EmailService.postmark.send_batch", suppress = "EmailService.postmark.suppress", domainAdd = "EmailService.postmark.domainAdd", domainVerify = "EmailService.postmark.domainVerify", domainList = "EmailService.postmark.domainList", label = "Postmark", priority = 45 }

emailSes : EmailService "ses"
emailSes = EmailService { send = "EmailService.ses.send", send_batch = "EmailService.ses.send_batch", suppress = "EmailService.ses.suppress", domainAdd = "EmailService.ses.domainAdd", domainVerify = "EmailService.ses.domainVerify", domainList = "EmailService.ses.domainList", label = "AWS SES", priority = 40 }

emailResend : EmailService "resend"
emailResend = EmailService { send = "EmailService.resend.send", send_batch = "EmailService.resend.send_batch", suppress = "EmailService.resend.suppress", domainAdd = "EmailService.resend.domainAdd", domainVerify = "EmailService.resend.domainVerify", domainList = "EmailService.resend.domainList", label = "Resend", priority = 35 }
