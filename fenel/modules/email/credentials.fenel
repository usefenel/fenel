-- =========================================================================
-- Email — provider credential requirements (module-substrate Phase 3k).
--
-- The cash-out of "creds are data": the per-provider environment-variable
-- requirements that were a TS `ProviderCredentials[]` const in the retired
-- `engine/src/modules/email.ts` are now Fenel-authored typed values. Each is
-- a `ProviderCredentials { capability, provider, envVars }` value-decl; the
-- seam loads this file as a SIDECAR ({dispatchInstanceFile:true}), reads each
-- projected `{typeName:"ProviderCredentials", methods:{capability, provider,
-- envVars}}` back, and reassembles the byte-identical `ProviderCredentials[]`
-- for the Module `credentialRequirements` field. These value-decls are NOT
-- merged into `emailModule.instances` — they never reach the spec registry, so
-- they carry no dispatch / law footprint; they are pure data read at the seam.
--
-- Order (mailgun / postmark / ses / resend) + envVars are preserved verbatim
-- so the round-trip is byte-identical to the retired const. The `fenel`
-- pseudo-provider uses master env vars on the runtime side, not per-account
-- integration credentials, so it has no entry (as before).
--
-- capability + provider ride as STRING FIELDS (not type-application args) so
-- the body-only construct projection (`deriveTypedValueDecl`) round-trips them
-- without needing a lowercase type-app arg or a registered `Credentialed`
-- class — the cleaner, parser-risk-free of the brief's two creds shapes.
-- =========================================================================

mailgunCredentials : ProviderCredentials
mailgunCredentials = ProviderCredentials { capability = "EmailService", provider = "mailgun", envVars = ["MAILGUN_API_KEY", "MAILGUN_REGION"] }

postmarkCredentials : ProviderCredentials
postmarkCredentials = ProviderCredentials { capability = "EmailService", provider = "postmark", envVars = ["POSTMARK_SERVER_TOKEN"] }

sesCredentials : ProviderCredentials
sesCredentials = ProviderCredentials { capability = "EmailService", provider = "ses", envVars = ["AWS_REGION", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"] }

resendCredentials : ProviderCredentials
resendCredentials = ProviderCredentials { capability = "EmailService", provider = "resend", envVars = ["RESEND_API_KEY"] }
