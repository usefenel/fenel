-- =========================================================================
-- module templates where — templates as typed functions.
--
-- typed-function-references · FenelModule-retirement Phase FM-retire-1 (the
-- warm-up port). The 4 `defineFunction` specs in the ~156-LOC TS wrapper
-- (`engine/src/modules/templates.ts`) are RETIRED in favour of these `module
-- templates where` decls + a thin seam. The existing `types.fenel`
-- (`Markup` / `HeadingLevel`) + `instances.fenel` (the 4 `Renderable` provider
-- instances) are KEPT and loaded exactly as before (Phase 4c / 10c); the seam
-- merges their entities + dispatch instances with this file's functions.
--
-- A template is a typed function `(profile, order, …) -> Markup`; `Markup` is a
-- Fenel type (not String), and the `Renderable a` typeclass renders it to a
-- per-channel target (HTML / plaintext / Telegram MD / PDF) via instance
-- dispatch. `render_template` evaluates a template + renders to a format; the
-- three `markup_to_*` are bodyless `@native` dispatch-stubs — they execute
-- NOWHERE (no body, no native, no handler), named ONLY by the `Renderable`
-- instances' `{$ref}` render-handle in `instances.fenel`. Preserving them
-- bodyless keeps that wiring byte-identical.
--
-- NO-CORNER-CUT FIX (FM-retire-1): the three `markup` params were typed
-- `{$record:{fields:[]}}` (the empty-record-placeholder anti-pattern — "I
-- haven't declared the shape"). `Markup` IS declared (types.fenel), so they are
-- now authored `markup: Markup` (the real type) — chipping 3 off the standing
-- 97-placeholder baseline. `render_template`'s `context` stays `{}` (a genuinely
-- dynamic template context, like io's dynamic shapes — held, not faked).
--
-- `RenderFormat` is the `render_template` `format` param's refinement extracted
-- to a top-level named atom — the canonical path-(b) workaround (the parser
-- rejects `String | value ∈ {…}` at PARAM position; it is a type-decl-level form
-- only). This is the SAME extraction `HeadingLevel` already uses in this module
-- (types.fenel). The resulting `{$refined: {base: String, set: $enum […]}}` is
-- byte-identical to the retired spec's inline param type; the param becomes
-- `format: RenderFormat` (a `{$ref}`).
--
-- Identity parity: each fn carried label + description + category="templates" +
-- tags. NO `@category` (derives from the `templates:` id prefix, Phase 3j);
-- `@label`/`@description`/`@tags` reproduce the rest. Param labels DROP (no
-- directive). The empty `default: Nothing` boilerplate VANISHES.
-- =========================================================================

module templates where

-- RenderFormat — the output-channel selector (`render_template`'s `format`).
-- Extracted named atom (path-(b)); inline `|`-refinement does not parse at
-- param position. Byte-identical to the retired inline `$refined String $enum`.
RenderFormat = String | value ∈ {"email", "sms", "telegram", "pdf"}

-- render_template — evaluate a template function with the given context, produce
-- Markup, then render to the target format via the Renderable typeclass.
-- `context` is a dynamic template context (held `{}`, not faked). Bodyless in
-- the retired spec too (signature-only `defineFunction`, no body / no ioAction)
-- → `@native` emits the same bodyless function.
@native
@label "Render Template"
@description "Evaluate a template function with given context, produce Markup, then render to target format via Renderable typeclass."
@tags "template" "render"
render_template : (template_slug: String, context: {}, format: RenderFormat) -> { content: String, mime_type: String }

-- markup_to_html — convert a Markup AST to an HTML string. Bodyless dispatch
-- stub; named by the Renderable email instance's render handle.
@native
@label "Markup to HTML"
@description "Convert Markup AST to HTML string. Used by Renderable Email instance."
@tags "template" "render" "pure"
markup_to_html : (markup: Markup) -> String

-- markup_to_plaintext — convert a Markup AST to plain text (strip formatting,
-- truncate for SMS). Bodyless dispatch stub (Renderable sms render handle).
@native
@label "Markup to Plaintext"
@description "Convert Markup AST to plain text. Strips formatting, truncates for SMS."
@tags "template" "render" "pure"
markup_to_plaintext : (markup: Markup, max_length: Maybe Number) -> String

-- markup_to_telegram_md — convert a Markup AST to Telegram-flavored Markdown.
-- Bodyless dispatch stub (Renderable telegram render handle).
@native
@label "Markup to Telegram Markdown"
@description "Convert Markup AST to Telegram-flavored Markdown."
@tags "template" "render" "pure"
markup_to_telegram_md : (markup: Markup) -> String
