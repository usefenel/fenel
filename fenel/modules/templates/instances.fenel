-- Templates dispatch instances (typed-function-references Phase 10c).
--
-- Renderable<email|sms|telegram|pdf> — the per-format render targets in the
-- Renderable dispatch table. `.fenel` value-decls (point-free `render =
-- markup_to_html` lowers to the `{$ref}` codeName handle; the registry resolves
-- it module-locally to `templates:markup_to_html`). Loaded with
-- `dispatchInstanceFile: true`.
--
-- `max_length : Maybe Number` (the Renderable spec's declared type). The TS
-- consts stored a raw `null` / bare number, violating that type; the `.fenel`
-- values are the proper `Nothing` / `Just n` (positional — the canonical
-- Maybe payload is `_0`; `Just { value = n }` would wrap a RECORD `{value:n}`,
-- yielding `Maybe {value:Number}`, not `Maybe Number`) — no `null`.
emailRenderable : Renderable "email"
emailRenderable = Renderable { render = markup_to_html, mime_type = "text/html", max_length = Nothing }

smsRenderable : Renderable "sms"
smsRenderable = Renderable { render = markup_to_plaintext, mime_type = "text/plain", max_length = Just 160 }

telegramRenderable : Renderable "telegram"
telegramRenderable = Renderable { render = markup_to_telegram_md, mime_type = "text/markdown", max_length = Just 4096 }

pdfRenderable : Renderable "pdf"
pdfRenderable = Renderable { render = markup_to_pdf, mime_type = "application/pdf", max_length = Nothing }
