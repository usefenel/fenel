-- Codec typeclass instances — Fenel-authored typed values (Phase 3.1 of
-- typeclass-substrate-completion, 2026-05-28).
--
-- An instance is a typed VALUE of a parametric spec type: `isoBase64 :
-- Iso String Bytes` is a value whose type is `Iso` applied to
-- `String Bytes`. `loadFenelModule` projects it into the legacy
-- `SpecInstance { typeName, args, methods }` cache shape downstream TS
-- dispatch reads (typeName = "Iso", args = ["String", "Bytes"], methods =
-- the record fields). See fenel/std/dispatch-instances.fenel (Phase 3)
-- for the builtin-path template this mirrors.
--
-- Scope: the Iso / Lens / Decodable instances; their fields hold the
-- functions themselves as qualified references (modules-as-values Phase 2b
-- for Lens, Phase 2d for Iso and Decodable). JsonValue's ordinary examples
-- now live here too; bytes/canonical-string/record sample literals retain
-- the existing seam data. Phase 3.2
-- (2026-05-29) restored the top-level `label` field on each instance: the
-- loader now lifts a `label` method-field into the `SpecInstance.label` slot
-- (mirroring the numeric `priority` lift), so the projection is byte-identical
-- to the original TS const — full object, not just the {typeName, args,
-- methods} triple. The labels are dev-facing strings unconsumed by dispatch.

-- Iso :: s a — bidirectional codec between serialized (s) and structured (a).
isoBase64 : Iso String Bytes
isoBase64 = Iso { encode = codec.base64Encode, decode = codec.base64Decode, label = "Base64 (RFC 4648)" }

isoJson : Iso String JsonValue
isoJson = Iso { encode = codec.jsonEncode, decode = codec.jsonDecode, label = "JSON" }

isoCanonicalJson : Iso CanonicalJsonString JsonValue
isoCanonicalJson = Iso { encode = codec.canonicalJsonEncode, decode = codec.canonicalJsonDecode, label = "Canonical JSON (RFC 8785-style)" }

-- Ordinary source-owned samples avoid invoking the JSON body dispatcher while
-- the registry is still loading this module. Keep the previous sample values.
jsonValueExemplifiable : Exemplifiable JsonValue
jsonValueExemplifiable = Exemplifiable { examples = [
  JsonNull,
  JsonBool { value = true },
  JsonBool { value = false },
  JsonNumber { value = 0 },
  JsonNumber { value = 42 },
  JsonNumber { value = -1 },
  JsonNumber { value = 3.14 },
  JsonString { value = "" },
  JsonString { value = "hello" },
  JsonString { value = "string with \"quotes\" and \\ slashes" },
  JsonArray { items = [] },
  JsonArray { items = [JsonNumber { value = 1 }, JsonNumber { value = 2 }, JsonNumber { value = 3 }] },
  JsonArray { items = [JsonString { value = "nested" }, JsonArray { items = [JsonString { value = "arrays" }, JsonString { value = "work" }] }] },
  JsonObject { pairs = [] },
  JsonObject { pairs = [JsonObjectEntry { key = "key", value = JsonString { value = "value" } }] },
  JsonObject { pairs = [JsonObjectEntry { key = "a", value = JsonNumber { value = 1 } }, JsonObjectEntry { key = "b", value = JsonNumber { value = 2 } }, JsonObjectEntry { key = "c", value = JsonNumber { value = 3 } }] },
  JsonObject { pairs = [JsonObjectEntry { key = "nested", value = JsonObject { pairs = [JsonObjectEntry { key = "a", value = JsonArray { items = [JsonNumber { value = 1 }, JsonNumber { value = 2 }] } }, JsonObjectEntry { key = "b", value = JsonObject { pairs = [JsonObjectEntry { key = "c", value = JsonNull }] } }] } }] }
] }

-- Lens :: s t a — lossy projection (view) + re-injection (put). modules-as-values
-- Phase 2b: Lens declares `view : s -> a` and `put : (s, a) -> s`, so its fields
-- hold the functions themselves, written qualified (`codec.recordFirstNameView`
-- loads as the reference `{$ref: "codec.recordFirstNameView"}`). Iso and
-- Decodable followed in Phase 2d, once their two class parameters select the
-- instance by its complete type.
lensFirstName : Lens Record Record String
lensFirstName = Lens { view = codec.recordFirstNameView, put = codec.recordFirstNamePut, label = "Record firstName lens" }

-- Decodable :: src a — partial decode of a JsonValue into a typed value.
decodableJsonValueString : Decodable JsonValue String
decodableJsonValueString = Decodable { decode = codec.decodeJsonString, label = "Decodable JsonValue → String" }

decodableJsonValueBool : Decodable JsonValue Boolean
decodableJsonValueBool = Decodable { decode = codec.decodeJsonBool, label = "Decodable JsonValue → Boolean" }

decodableJsonValueNumber : Decodable JsonValue Number
decodableJsonValueNumber = Decodable { decode = codec.decodeJsonNumber, label = "Decodable JsonValue → Number" }

decodableJsonValueInt : Decodable JsonValue Int
decodableJsonValueInt = Decodable { decode = codec.decodeJsonInt, label = "Decodable JsonValue → Int" }
