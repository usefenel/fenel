-- Picture dispatch instances (typed-function-references Phase 10c).
--
-- Sampleable<Picture> / Renderable<Picture> — entries in the polymorphic
-- sample/render dispatch tables. `.fenel` value-decls (the Phase-10 loader flip
-- lowers the point-free `sample = sample` / `render = render` to the
-- dispatch-ready `{$ref}` codeName handle; the registry resolves it to
-- `picture:sample` / `picture:render`). Loaded with `dispatchInstanceFile: true`.
sampleablePicture : Sampleable Picture
sampleablePicture = Sampleable { sample = sample }

renderablePicture : Renderable Picture
renderablePicture = Renderable { render = render }
