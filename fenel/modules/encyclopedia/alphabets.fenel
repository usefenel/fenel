module Encyclopedia where

-- Writing systems beside the modern Greek alphabet (GreekAlphabetDemo): the
-- Latin alphabet, the Russian Cyrillic alphabet, the Elder Futhark runes and
-- the basic kana. Each mark comes first, so a tile shows it large, and its
-- reading or second form second, in the corner. Code points and character
-- names are Unicode 17.0.0's; code points were read from the characters
-- themselves. Nothing here is a spelling, pronunciation or language claim.

@label "Latin Letter"
@description "One of the 26 letters of the basic Latin alphabet, in alphabetic order: its capital and small forms and their Unicode code points."
@fieldLabel "capital" "Capital"
@fieldLabel "small" "Small"
@fieldLabel "order" "Order"
@fieldLabel "capitalCode" "Capital Code"
@fieldLabel "smallCode" "Small Code"
LatinLetter = LatinLetter capital: String small: String order: Nat capitalCode: String smallCode: String

@label "Latin alphabet"
@description "The modern basic Latin alphabet: the 26 letters A to Z, each with its small letter. Classical Latin wrote 23 of them; J, U and W were added later. Letters and accents that other languages add are outside this list."
@tags "alphabet" "latin" "data"
latinAlphabet : List LatinLetter
latinAlphabet = [
  LatinLetter { capital = "A", small = "a", order = 1, capitalCode = "U+0041", smallCode = "U+0061" },
  LatinLetter { capital = "B", small = "b", order = 2, capitalCode = "U+0042", smallCode = "U+0062" },
  LatinLetter { capital = "C", small = "c", order = 3, capitalCode = "U+0043", smallCode = "U+0063" },
  LatinLetter { capital = "D", small = "d", order = 4, capitalCode = "U+0044", smallCode = "U+0064" },
  LatinLetter { capital = "E", small = "e", order = 5, capitalCode = "U+0045", smallCode = "U+0065" },
  LatinLetter { capital = "F", small = "f", order = 6, capitalCode = "U+0046", smallCode = "U+0066" },
  LatinLetter { capital = "G", small = "g", order = 7, capitalCode = "U+0047", smallCode = "U+0067" },
  LatinLetter { capital = "H", small = "h", order = 8, capitalCode = "U+0048", smallCode = "U+0068" },
  LatinLetter { capital = "I", small = "i", order = 9, capitalCode = "U+0049", smallCode = "U+0069" },
  LatinLetter { capital = "J", small = "j", order = 10, capitalCode = "U+004A", smallCode = "U+006A" },
  LatinLetter { capital = "K", small = "k", order = 11, capitalCode = "U+004B", smallCode = "U+006B" },
  LatinLetter { capital = "L", small = "l", order = 12, capitalCode = "U+004C", smallCode = "U+006C" },
  LatinLetter { capital = "M", small = "m", order = 13, capitalCode = "U+004D", smallCode = "U+006D" },
  LatinLetter { capital = "N", small = "n", order = 14, capitalCode = "U+004E", smallCode = "U+006E" },
  LatinLetter { capital = "O", small = "o", order = 15, capitalCode = "U+004F", smallCode = "U+006F" },
  LatinLetter { capital = "P", small = "p", order = 16, capitalCode = "U+0050", smallCode = "U+0070" },
  LatinLetter { capital = "Q", small = "q", order = 17, capitalCode = "U+0051", smallCode = "U+0071" },
  LatinLetter { capital = "R", small = "r", order = 18, capitalCode = "U+0052", smallCode = "U+0072" },
  LatinLetter { capital = "S", small = "s", order = 19, capitalCode = "U+0053", smallCode = "U+0073" },
  LatinLetter { capital = "T", small = "t", order = 20, capitalCode = "U+0054", smallCode = "U+0074" },
  LatinLetter { capital = "U", small = "u", order = 21, capitalCode = "U+0055", smallCode = "U+0075" },
  LatinLetter { capital = "V", small = "v", order = 22, capitalCode = "U+0056", smallCode = "U+0076" },
  LatinLetter { capital = "W", small = "w", order = 23, capitalCode = "U+0057", smallCode = "U+0077" },
  LatinLetter { capital = "X", small = "x", order = 24, capitalCode = "U+0058", smallCode = "U+0078" },
  LatinLetter { capital = "Y", small = "y", order = 25, capitalCode = "U+0059", smallCode = "U+0079" },
  LatinLetter { capital = "Z", small = "z", order = 26, capitalCode = "U+005A", smallCode = "U+007A" }
]

@label "Russian Letter"
@description "One of the 33 letters of the modern Russian alphabet: its capital and small forms, a Latin transliteration, its order and its Unicode code points."
@fieldLabel "capital" "Capital"
@fieldLabel "small" "Small"
@fieldLabel "transliteration" "Transliteration"
@fieldLabel "order" "Order"
@fieldLabel "capitalCode" "Capital Code"
@fieldLabel "smallCode" "Small Code"
@helpText "transliteration" "BGN/PCGN romanization of the letter on its own: ye and yë are the forms at the start of a word or after a vowel (elsewhere e and ë); the hard sign and the soft sign are written ˮ and ʼ and have no sound of their own."
CyrillicLetter = CyrillicLetter capital: String small: String transliteration: String order: Nat capitalCode: String smallCode: String

@label "Russian alphabet"
@description "The 33 letters of the modern Russian alphabet, written in the Cyrillic script, each with its BGN/PCGN Latin transliteration. This is the Russian set: Cyrillic also serves other languages, such as Ukrainian, Serbian and Kazakh, with other letters."
@tags "alphabet" "cyrillic" "russian" "data"
russianAlphabet : List CyrillicLetter
russianAlphabet = [
  CyrillicLetter { capital = "А", small = "а", transliteration = "a", order = 1, capitalCode = "U+0410", smallCode = "U+0430" },
  CyrillicLetter { capital = "Б", small = "б", transliteration = "b", order = 2, capitalCode = "U+0411", smallCode = "U+0431" },
  CyrillicLetter { capital = "В", small = "в", transliteration = "v", order = 3, capitalCode = "U+0412", smallCode = "U+0432" },
  CyrillicLetter { capital = "Г", small = "г", transliteration = "g", order = 4, capitalCode = "U+0413", smallCode = "U+0433" },
  CyrillicLetter { capital = "Д", small = "д", transliteration = "d", order = 5, capitalCode = "U+0414", smallCode = "U+0434" },
  CyrillicLetter { capital = "Е", small = "е", transliteration = "ye", order = 6, capitalCode = "U+0415", smallCode = "U+0435" },
  CyrillicLetter { capital = "Ё", small = "ё", transliteration = "yë", order = 7, capitalCode = "U+0401", smallCode = "U+0451" },
  CyrillicLetter { capital = "Ж", small = "ж", transliteration = "zh", order = 8, capitalCode = "U+0416", smallCode = "U+0436" },
  CyrillicLetter { capital = "З", small = "з", transliteration = "z", order = 9, capitalCode = "U+0417", smallCode = "U+0437" },
  CyrillicLetter { capital = "И", small = "и", transliteration = "i", order = 10, capitalCode = "U+0418", smallCode = "U+0438" },
  CyrillicLetter { capital = "Й", small = "й", transliteration = "y", order = 11, capitalCode = "U+0419", smallCode = "U+0439" },
  CyrillicLetter { capital = "К", small = "к", transliteration = "k", order = 12, capitalCode = "U+041A", smallCode = "U+043A" },
  CyrillicLetter { capital = "Л", small = "л", transliteration = "l", order = 13, capitalCode = "U+041B", smallCode = "U+043B" },
  CyrillicLetter { capital = "М", small = "м", transliteration = "m", order = 14, capitalCode = "U+041C", smallCode = "U+043C" },
  CyrillicLetter { capital = "Н", small = "н", transliteration = "n", order = 15, capitalCode = "U+041D", smallCode = "U+043D" },
  CyrillicLetter { capital = "О", small = "о", transliteration = "o", order = 16, capitalCode = "U+041E", smallCode = "U+043E" },
  CyrillicLetter { capital = "П", small = "п", transliteration = "p", order = 17, capitalCode = "U+041F", smallCode = "U+043F" },
  CyrillicLetter { capital = "Р", small = "р", transliteration = "r", order = 18, capitalCode = "U+0420", smallCode = "U+0440" },
  CyrillicLetter { capital = "С", small = "с", transliteration = "s", order = 19, capitalCode = "U+0421", smallCode = "U+0441" },
  CyrillicLetter { capital = "Т", small = "т", transliteration = "t", order = 20, capitalCode = "U+0422", smallCode = "U+0442" },
  CyrillicLetter { capital = "У", small = "у", transliteration = "u", order = 21, capitalCode = "U+0423", smallCode = "U+0443" },
  CyrillicLetter { capital = "Ф", small = "ф", transliteration = "f", order = 22, capitalCode = "U+0424", smallCode = "U+0444" },
  CyrillicLetter { capital = "Х", small = "х", transliteration = "kh", order = 23, capitalCode = "U+0425", smallCode = "U+0445" },
  CyrillicLetter { capital = "Ц", small = "ц", transliteration = "ts", order = 24, capitalCode = "U+0426", smallCode = "U+0446" },
  CyrillicLetter { capital = "Ч", small = "ч", transliteration = "ch", order = 25, capitalCode = "U+0427", smallCode = "U+0447" },
  CyrillicLetter { capital = "Ш", small = "ш", transliteration = "sh", order = 26, capitalCode = "U+0428", smallCode = "U+0448" },
  CyrillicLetter { capital = "Щ", small = "щ", transliteration = "shch", order = 27, capitalCode = "U+0429", smallCode = "U+0449" },
  CyrillicLetter { capital = "Ъ", small = "ъ", transliteration = "ˮ", order = 28, capitalCode = "U+042A", smallCode = "U+044A" },
  CyrillicLetter { capital = "Ы", small = "ы", transliteration = "y", order = 29, capitalCode = "U+042B", smallCode = "U+044B" },
