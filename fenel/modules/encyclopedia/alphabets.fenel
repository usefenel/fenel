]

@label "Rune"
@description "One of the 24 runes of the Elder Futhark: the rune, its transliteration, its reconstructed name, its place in the row, and its Unicode code point and name."
@fieldLabel "rune" "Rune"
@fieldLabel "transliteration" "Transliteration"
@fieldLabel "name" "Reconstructed Name"
@fieldLabel "order" "Order"
@fieldLabel "codepoint" "Code Point"
@fieldLabel "unicodeName" "Unicode Name"
@fieldLabel "source" "Source"
@helpText "name" "A reconstructed Proto-Germanic name, as written in English Wikipedia's Elder Futhark table. No source from the time of the Elder Futhark records the names; they are reconstructed from later rune poems, and some are uncertain."
@helpText "unicodeName" "Unicode names mix traditions: many list the Elder Futhark name with its Anglo-Saxon and Norse names and a letter, such as RUNIC LETTER FEHU FEOH FE F."
ElderFutharkRune = ElderFutharkRune rune: String transliteration: String name: String order: Nat codepoint: String unicodeName: String source: UrlStr

@label "Elder Futhark"
@description "The 24 runes of the Elder Futhark in the order of the Kylver stone, which ends with dagaz then ōþala (d, o); the Vadstena bracteates and many tables, English Wikipedia's included, swap the last two. Names are reconstructed. ᛇ is transliterated ï (also æ)."
@tags "alphabet" "runes" "data"
elderFuthark : List ElderFutharkRune
elderFuthark = [
  ElderFutharkRune { rune = "ᚠ", transliteration = "f", name = "fehu", order = 1, codepoint = "U+16A0", unicodeName = "RUNIC LETTER FEHU FEOH FE F", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚢ", transliteration = "u", name = "ūruz", order = 2, codepoint = "U+16A2", unicodeName = "RUNIC LETTER URUZ UR U", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚦ", transliteration = "þ", name = "þurisaz", order = 3, codepoint = "U+16A6", unicodeName = "RUNIC LETTER THURISAZ THURS THORN", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚨ", transliteration = "a", name = "ansuz", order = 4, codepoint = "U+16A8", unicodeName = "RUNIC LETTER ANSUZ A", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚱ", transliteration = "r", name = "raidō", order = 5, codepoint = "U+16B1", unicodeName = "RUNIC LETTER RAIDO RAD REID R", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚲ", transliteration = "k", name = "kauną", order = 6, codepoint = "U+16B2", unicodeName = "RUNIC LETTER KAUNA", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚷ", transliteration = "g", name = "gebō", order = 7, codepoint = "U+16B7", unicodeName = "RUNIC LETTER GEBO GYFU G", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚹ", transliteration = "w", name = "wunjō", order = 8, codepoint = "U+16B9", unicodeName = "RUNIC LETTER WUNJO WYNN W", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚺ", transliteration = "h", name = "hagalaz", order = 9, codepoint = "U+16BA", unicodeName = "RUNIC LETTER HAGLAZ H", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᚾ", transliteration = "n", name = "naudiz", order = 10, codepoint = "U+16BE", unicodeName = "RUNIC LETTER NAUDIZ NYD NAUD N", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛁ", transliteration = "i", name = "īsaz", order = 11, codepoint = "U+16C1", unicodeName = "RUNIC LETTER ISAZ IS ISS I", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛃ", transliteration = "j", name = "jēra", order = 12, codepoint = "U+16C3", unicodeName = "RUNIC LETTER JERAN J", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛇ", transliteration = "ï", name = "ī(h)waz", order = 13, codepoint = "U+16C7", unicodeName = "RUNIC LETTER IWAZ EOH", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛈ", transliteration = "p", name = "perþō", order = 14, codepoint = "U+16C8", unicodeName = "RUNIC LETTER PERTHO PEORTH P", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛉ", transliteration = "z", name = "algiz", order = 15, codepoint = "U+16C9", unicodeName = "RUNIC LETTER ALGIZ EOLHX", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛊ", transliteration = "s", name = "sōwilō", order = 16, codepoint = "U+16CA", unicodeName = "RUNIC LETTER SOWILO S", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛏ", transliteration = "t", name = "tīwaz", order = 17, codepoint = "U+16CF", unicodeName = "RUNIC LETTER TIWAZ TIR TYR T", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛒ", transliteration = "b", name = "berkanan", order = 18, codepoint = "U+16D2", unicodeName = "RUNIC LETTER BERKANAN BEORC BJARKAN B", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛖ", transliteration = "e", name = "ehwaz", order = 19, codepoint = "U+16D6", unicodeName = "RUNIC LETTER EHWAZ EH E", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛗ", transliteration = "m", name = "mannaz", order = 20, codepoint = "U+16D7", unicodeName = "RUNIC LETTER MANNAZ MAN M", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛚ", transliteration = "l", name = "laguz", order = 21, codepoint = "U+16DA", unicodeName = "RUNIC LETTER LAUKAZ LAGU LOGR L", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛜ", transliteration = "ŋ", name = "ingwaz", order = 22, codepoint = "U+16DC", unicodeName = "RUNIC LETTER INGWAZ", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛞ", transliteration = "d", name = "dagaz", order = 23, codepoint = "U+16DE", unicodeName = "RUNIC LETTER DAGAZ DAEG D", source = "https://en.wikipedia.org/wiki/Elder_Futhark" },
  ElderFutharkRune { rune = "ᛟ", transliteration = "o", name = "ōþala", order = 24, codepoint = "U+16DF", unicodeName = "RUNIC LETTER OTHALAN ETHEL O", source = "https://en.wikipedia.org/wiki/Elder_Futhark" }
]

-- The 46 basic kana of the gojūon table, in hiragana and in katakana, in
-- table order (a, ka, sa, ta, na, ha, ma, ya, ra, wa rows, then n). Readings
-- are Hepburn romanization (shi, chi, tsu, fu, n), with wo for を and ヲ as
-- many tables write it to tell it from お. Code points and character names are
-- Unicode 17.0.0's; Unicode's names use another romanization (SI, TI, TU, HU).
-- Voiced and small kana, and obsolete kana such as ゐ and ゑ, are outside this
-- table. Code points were read from the characters themselves; each katakana
-- here is its hiragana's code point plus 0x60.

@label "Kana Script"
@description "The script of a kana: hiragana or katakana."
KanaScript = HiraganaScript | KatakanaScript

@label "Kana"
@description "One basic kana: the character, its Hepburn reading, its place in the 46-kana table, whether it is a vowel, its script, and its Unicode code point and name."
@fieldLabel "kana" "Kana"
@fieldLabel "reading" "Reading"
@fieldLabel "order" "Order"
@fieldLabel "vowel" "Vowel"
@fieldLabel "script" "Script"
@fieldLabel "codepoint" "Code Point"
@fieldLabel "unicodeName" "Unicode Name"
@fieldLabel "source" "Source"
KanaCharacter = KanaCharacter kana: String reading: String order: Nat vowel: Bool script: KanaScript codepoint: String unicodeName: String source: UrlStr

@label "Hiragana"
@description "The 46 basic hiragana in table order, each with its Hepburn reading: あ a, か ka, し shi, ち chi, つ tsu, ふ fu, を wo, ん n."
@tags "kana" "japanese" "alphabet" "data"
hiragana : List KanaCharacter
hiragana = [
  KanaCharacter { kana = "あ", reading = "a", order = 1, vowel = true, script = HiraganaScript, codepoint = "U+3042", unicodeName = "HIRAGANA LETTER A", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "い", reading = "i", order = 2, vowel = true, script = HiraganaScript, codepoint = "U+3044", unicodeName = "HIRAGANA LETTER I", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "う", reading = "u", order = 3, vowel = true, script = HiraganaScript, codepoint = "U+3046", unicodeName = "HIRAGANA LETTER U", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "え", reading = "e", order = 4, vowel = true, script = HiraganaScript, codepoint = "U+3048", unicodeName = "HIRAGANA LETTER E", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "お", reading = "o", order = 5, vowel = true, script = HiraganaScript, codepoint = "U+304A", unicodeName = "HIRAGANA LETTER O", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "か", reading = "ka", order = 6, vowel = false, script = HiraganaScript, codepoint = "U+304B", unicodeName = "HIRAGANA LETTER KA", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "き", reading = "ki", order = 7, vowel = false, script = HiraganaScript, codepoint = "U+304D", unicodeName = "HIRAGANA LETTER KI", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "く", reading = "ku", order = 8, vowel = false, script = HiraganaScript, codepoint = "U+304F", unicodeName = "HIRAGANA LETTER KU", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "け", reading = "ke", order = 9, vowel = false, script = HiraganaScript, codepoint = "U+3051", unicodeName = "HIRAGANA LETTER KE", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "こ", reading = "ko", order = 10, vowel = false, script = HiraganaScript, codepoint = "U+3053", unicodeName = "HIRAGANA LETTER KO", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "さ", reading = "sa", order = 11, vowel = false, script = HiraganaScript, codepoint = "U+3055", unicodeName = "HIRAGANA LETTER SA", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "し", reading = "shi", order = 12, vowel = false, script = HiraganaScript, codepoint = "U+3057", unicodeName = "HIRAGANA LETTER SI", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "す", reading = "su", order = 13, vowel = false, script = HiraganaScript, codepoint = "U+3059", unicodeName = "HIRAGANA LETTER SU", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "せ", reading = "se", order = 14, vowel = false, script = HiraganaScript, codepoint = "U+305B", unicodeName = "HIRAGANA LETTER SE", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "そ", reading = "so", order = 15, vowel = false, script = HiraganaScript, codepoint = "U+305D", unicodeName = "HIRAGANA LETTER SO", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "た", reading = "ta", order = 16, vowel = false, script = HiraganaScript, codepoint = "U+305F", unicodeName = "HIRAGANA LETTER TA", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "ち", reading = "chi", order = 17, vowel = false, script = HiraganaScript, codepoint = "U+3061", unicodeName = "HIRAGANA LETTER TI", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "つ", reading = "tsu", order = 18, vowel = false, script = HiraganaScript, codepoint = "U+3064", unicodeName = "HIRAGANA LETTER TU", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "て", reading = "te", order = 19, vowel = false, script = HiraganaScript, codepoint = "U+3066", unicodeName = "HIRAGANA LETTER TE", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
  KanaCharacter { kana = "と", reading = "to", order = 20, vowel = false, script = HiraganaScript, codepoint = "U+3068", unicodeName = "HIRAGANA LETTER TO", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" },
