module Encyclopedia where

using std (map, filter, elem, unique, flatten, length, not)
using set (contains, decideSubset)
using engine (SetExpr)

-- Foods as a second closed variant of nullary constructors (ledger D5, D6):
-- the tomato plant is a living thing in the tree of life, the tomato is a food
-- that names that plant as where it comes from. Kinds of food are the inner
-- nodes of the same shape of tree; each food is in exactly one kind (the
-- culinary kind). Food constructors end in Food so no bare tag re-owns the
-- recipe example's Food constructors. This list is separate from the recipe
-- example's nine foods. Nothing here is a health or nutrition claim.
-- A variety is a food below a food (cherry tomatoes below tomato): it comes
-- from the same living thing, and the food above it becomes the set of its
-- varieties. A node is a leaf when no row names it as its parent.

@label "Food Rank"
@description "All foods, a kind of food, one food, or a variety of a food."
FoodRank = FoodRankAll | FoodRankKind | FoodRankFood | FoodRankVariety

@label "Food Facts"
@description "One food or kind of food: its name, the kinds it sits in from all foods down, and the living thing it comes from."
@fieldLabel "food" "Food"
@fieldLabel "rank" "Rank"
@fieldLabel "name" "Name"
@fieldLabel "within" "Within"
@fieldLabel "source" "Comes From"
FoodFacts = FoodFacts food: Foodstuff rank: FoodRank name: String within: List Foodstuff source: Maybe LivingThing

@label "Inclusion"
@description "Whether this set of foods is a subset of the kind its facts name as its parent: the set judgment's verdict. Nothing means undecided."
@fieldLabel "whole" "Parent"
@fieldLabel "within" "Is a Subset"
FoodSetInclusion = FoodSetInclusion whole: Foodstuff within: Maybe Bool

@label "Food Set"
@description "All foods, a kind of food or one food, as the set of the foods of this collection at or below it, with its judged inclusion in its kind, the judged partition into its children and the living thing it comes from."
@fieldLabel "item" "Food"
@fieldLabel "name" "Name"
@fieldLabel "scientificName" "Scientific Name"
@fieldLabel "rank" "Rank"
@fieldLabel "parents" "Parents"
@fieldLabel "members" "Foods"
@fieldLabel "constraint" "Set"
@fieldLabel "parts" "Partition"
@fieldLabel "comesFrom" "Comes From"
FoodSet = FoodSet item: Foodstuff name: String scientificName: Maybe String rank: FoodRank parents: List FoodSetInclusion members: List Foodstuff constraint: SetExpr parts: Maybe LifeSetPartition comesFrom: Maybe LivingThing

@label "Foods by Kind"
@description "The foods of this collection as nested sets: all foods, then kinds, then foods."
@fieldLabel "coverage" "Coverage"
@fieldLabel "sets" "Sets"
FoodClassification = FoodClassification coverage: String sets: List FoodSet

@label "Foods From a Group"
@description "Which foods of this collection come from the living things of one group, which of its species give them, which give none, and whether every species of it gives a food. Each answer is the set judgment's; Nothing means undecided."
@fieldLabel "group" "Group"
@fieldLabel "foods" "Foods"
@fieldLabel "givers" "Species Giving Food"
@fieldLabel "withoutFood" "Species Giving None"
@fieldLabel "everyMemberGives" "Every Species Gives a Food"
FoodsFromGroup = FoodsFromGroup group: LivingThing foods: Maybe (List Foodstuff) givers: Maybe (List LivingThing) withoutFood: Maybe (List LivingThing) everyMemberGives: Maybe Bool

_ : Viewable FoodClassification
_ = Viewable { defaultView = "nested-sets", defaultInlineView = "nested-sets" }

@label "Food Row"
@description "A row for one food and the living thing it comes from."
@fieldLabel "subject" "Food"
@fieldLabel "label" "Name"
@fieldLabel "ancestry" "Within"
@fieldLabel "giver" "Comes From"
encyclopediaFoodRow : (subject: Foodstuff) -> (label: String) -> (ancestry: List Foodstuff) -> (giver: LivingThing) -> FoodFacts
encyclopediaFoodRow subject label ancestry giver =
  let from = Just giver
  FoodFacts { food = subject, rank = FoodRankFood, name = label, within = ancestry, source = from }

@label "Food Kind Row"
@description "A row for all foods or one kind of food."
@fieldLabel "subject" "Kind"
@fieldLabel "level" "Rank"
@fieldLabel "label" "Name"
@fieldLabel "ancestry" "Within"
encyclopediaFoodKindRow : (subject: Foodstuff) -> (level: FoodRank) -> (label: String) -> (ancestry: List Foodstuff) -> FoodFacts
encyclopediaFoodKindRow subject level label ancestry = FoodFacts { food = subject, rank = level, name = label, within = ancestry, source = Nothing }

@label "Food Variety Row"
@description "A row for one variety of a food: the food it is a variety of is the last entry of its ancestry, and it comes from the same living thing."
@fieldLabel "subject" "Variety"
@fieldLabel "label" "Name"
@fieldLabel "ancestry" "Within"
@fieldLabel "giver" "Comes From"
encyclopediaFoodVarietyRow : (subject: Foodstuff) -> (label: String) -> (ancestry: List Foodstuff) -> (giver: LivingThing) -> FoodFacts
encyclopediaFoodVarietyRow subject label ancestry giver =
  let from = Just giver
  FoodFacts { food = subject, rank = FoodRankVariety, name = label, within = ancestry, source = from }

-- A food row is a leaf unless some row names it as its parent (a food with
-- varieties is a set of them). `stated` is every stated parent, read once.
encyclopediaFoodNode : (stated: List Foodstuff) -> (row: FoodFacts) -> { node: Foodstuff, ancestry: List Foodstuff, leaf: Bool, payload: FoodFacts }
encyclopediaFoodNode stated row =
  let leaf = not (elem row.food stated)
  { node = row.food, ancestry = row.within, leaf = leaf, payload = row }

-- Foods judge the partition of every group below all foods (each kind, and a
-- food with varieties); all foods itself is not asked, as for the tree of
-- life's groups of groups (cost: the square of every food).
encyclopediaFoodParts : (entries: List ({ node: Foodstuff, ancestry: List Foodstuff, leaf: Bool, payload: FoodFacts, members: List Foodstuff })) -> (entry: { node: Foodstuff, ancestry: List Foodstuff, leaf: Bool, payload: FoodFacts, members: List Foodstuff }) -> Maybe ({ apart: Maybe Bool, cover: Maybe Bool })
encyclopediaFoodParts entries entry =
  if entry.leaf then Nothing
  else if length entry.ancestry == 0 then Nothing
  else encyclopediaTreeLeafParts entry (filter (\child -> elem entry.node (encyclopediaStatedParent child.ancestry)) entries)

encyclopediaFoodInclusionOf : (pair: { whole: Foodstuff, within: Maybe Bool }) -> FoodSetInclusion
encyclopediaFoodInclusionOf pair = FoodSetInclusion { whole = pair.whole, within = pair.within }

encyclopediaFoodSetOf : (entries: List ({ node: Foodstuff, ancestry: List Foodstuff, leaf: Bool, payload: FoodFacts, members: List Foodstuff })) -> (groups: List ({ node: Foodstuff, ancestry: List Foodstuff, leaf: Bool, payload: FoodFacts, members: List Foodstuff })) -> (entry: { node: Foodstuff, ancestry: List Foodstuff, leaf: Bool, payload: FoodFacts, members: List Foodstuff }) -> FoodSet
encyclopediaFoodSetOf entries groups entry =
  let row = entry.payload
  let judgedParents = map encyclopediaFoodInclusionOf (encyclopediaTreeParents groups entry)
  let constraint = SeEnum { values = entry.members }
  let partition = encyclopediaLifePartitionOf (encyclopediaFoodParts entries entry)
  FoodSet { item = row.food, name = row.name, scientificName = Nothing, rank = row.rank, parents = judgedParents, members = entry.members, constraint = constraint, parts = partition, comesFrom = row.source }

@label "Classify Foods"
@description "The foods of the given rows as nested sets: each set judged inside its kind (a variety inside its food), the children of each kind and of each food with varieties judged apart and covering it."
@fieldLabel "rows" "Rows"
encyclopediaFoodClassification : (rows: List FoodFacts) -> FoodClassification
encyclopediaFoodClassification rows =
  let stated = unique (flatten (map (\row -> encyclopediaStatedParent row.within) rows))
  let entries = encyclopediaTreeEntries (map (encyclopediaFoodNode stated) rows)
  let groups = filter (\entry -> if entry.leaf then false else true) entries
  let sets = map (encyclopediaFoodSetOf entries groups) entries
  FoodClassification { coverage = "These sets contain the foods described in this collection. Other foods are not listed here.", sets = sets }

@label "Foods by kind"
@description "All foods of this collection, then their kinds (fruits, vegetables, herbs, grains, pulses, seeds, mushrooms, dairy, meat, eggs, seafood, bee products), then the foods, each judged inside its kind, and five tomato varieties inside the tomato. Each food names the living thing it comes from."
@tags "encyclopedia" "foods" "sets"
encyclopediaFoods : FoodClassification
encyclopediaFoods = encyclopediaFoodClassification (encyclopediaFoodFacts ())

encyclopediaFoodFromGroup : (group: SetExpr) -> (edible: FoodFacts) -> Maybe Bool
encyclopediaFoodFromGroup group edible = case edible.source of
  Just giver -> set.contains group giver
  _ -> Just false

@label "Foods from a group"
@description "The foods that come from the species of one group of the tree of life, the species that give them, the species that give none, and whether every species of the group gives a food: each decided by the set judgment."
@fieldLabel "group" "Group"
encyclopediaFoodsFrom : (group: LivingThing) -> FoodsFromGroup
encyclopediaFoodsFrom group =
  let rows = encyclopediaFoodFacts ()
  let leafFoods = filter (\edible -> elem edible.rank [FoodRankFood]) rows
  let speciesBelow = encyclopediaLeavesOf group
  let groupSet = SeEnum { values = speciesBelow }
  let allGivers = unique (flatten (map (\edible -> encyclopediaMaybeAsList edible.source) leafFoods))
  let giverSet = SeEnum { values = allGivers }
  let giving = SeIntersect { branches = [groupSet, giverSet] }
  let notGiving = SeDiff { left = groupSet, right = giverSet }
  let chosenFoods = encyclopediaSelectDecided (encyclopediaFoodFromGroup groupSet) leafFoods
  let foods = encyclopediaFoodsOfRows chosenFoods
  let givers = encyclopediaSelectDecided (\member -> set.contains giving member) speciesBelow
  let withoutFood = encyclopediaSelectDecided (\member -> set.contains notGiving member) speciesBelow
  let every = set.decideSubset groupSet giverSet
  FoodsFromGroup { group = group, foods = foods, givers = givers, withoutFood = withoutFood, everyMemberGives = every }

encyclopediaFoodsOfRows : (chosen: Maybe (List FoodFacts)) -> Maybe (List Foodstuff)
encyclopediaFoodsOfRows chosen = case chosen of
  Just rows -> Just (map (\row -> row.food) rows)
  _ -> Nothing

@label "Foods from nightshades"
@description "Foods ∩ nightshades: the foods of this collection that come from the nightshade family (Solanaceae), the nightshades that give them, and the ones that give none (cutleaf nightshade, thorn apple)."
@tags "encyclopedia" "foods" "sets"
encyclopediaNightshadeFoods : FoodsFromGroup
encyclopediaNightshadeFoods = encyclopediaFoodsFrom Solanaceae
