encyclopediaLifeRoot : LivingThingFacts
encyclopediaLifeRoot =
  let unnamed = Nothing
  LivingThingFacts { thing = AllLife, rank = RankLife, scientificName = unnamed, commonNames = ["all life", "living things"], within = [], source = "https://www.gbif.org/dataset/d7dddbf4-2cf0-4f39-9b2a-bb099caae36c" }

@label "Facts of the tree of life"
@description "One row per living thing of the tree of life: rank, accepted scientific name, common names, the groups it sits in from the root down, and the source."
@tags "encyclopedia" "living-things"
encyclopediaLivingThingFacts : List LivingThingFacts
