module Encyclopedia where

using std (map, filter, length, concat, typeOf)
using set (contains, decideSubset, decideDisjoint)
using EncyclopediaDemo (encyclopediaTypeFromSet)

-- Emoji sets from Unicode's own classification. emoji-test.txt places every
-- emoji in exactly one group and one subgroup; each official set below is one
-- subgroup, so two official sets never overlap. A set computed from others
-- (a union) says so. Rows are generated into emoji-data.fenel.

@label "Emoji"
@description "One fully-qualified emoji: its code point sequence, its Unicode short name, the official group and subgroup it is filed under, and the Emoji version that added it."
@fieldLabel "emoji" "Emoji"
@fieldLabel "name" "Name"
@fieldLabel "group" "Group"
@fieldLabel "subgroup" "Subgroup"
@fieldLabel "codepoints" "Code Points"
@fieldLabel "since" "Since"
EmojiCharacter = EmojiCharacter emoji: String name: String group: String subgroup: String codepoints: String since: String

@label "Emoji Set Origin"
EmojiSetOrigin = OfficialEmojiSubgroup | UnionOfEmojiSets | FlagsOfCountrySet

@label "Emoji Set"
@description "A named finite set of emoji: what it is, where its members come from, the members themselves, their finite set and a String type with exactly these emoji as values."
@fieldLabel "name" "Name"
@fieldLabel "meaning" "Meaning"
@fieldLabel "origin" "Origin"
@fieldLabel "members" "Members"
@fieldLabel "count" "Count"
@fieldLabel "constraint" "Constraint"
@fieldLabel "emojiType" "Emoji Type"
EmojiSet = EmojiSet name: String meaning: String origin: EmojiSetOrigin members: List EmojiCharacter count: Nat constraint: SetExpr emojiType: Type

@label "Emoji Set Comparison"
@description "The existing set judgments on two emoji sets: their shared members, whether one lies inside the other and whether they are disjoint. Unknown stays unknown."
@fieldLabel "left" "Left"
@fieldLabel "right" "Right"
@fieldLabel "shared" "Shared"
@fieldLabel "leftWithinRight" "Left Within Right"
@fieldLabel "rightWithinLeft" "Right Within Left"
@fieldLabel "disjoint" "Disjoint"
@fieldLabel "explanation" "Explanation"
EmojiSetComparison = EmojiSetComparison left: String right: String shared: List EmojiCharacter leftWithinRight: Maybe Bool rightWithinLeft: Maybe Bool disjoint: Maybe Bool explanation: String

encyclopediaEmojiSet : (setName: String) -> (setMeaning: String) -> (setOrigin: EmojiSetOrigin) -> (rows: List EmojiCharacter) -> EmojiSet
encyclopediaEmojiSet setName setMeaning setOrigin rows =
  let finite = SeEnum { values = map (\row -> row.emoji) rows }
  EmojiSet { name = setName, meaning = setMeaning, origin = setOrigin, members = rows, count = length rows, constraint = finite, emojiType = encyclopediaTypeFromSet (typeOf "") finite }

@label "Fruit emoji"
@description "Unicode's Food & Drink subgroup food-fruit (Emoji 17.0)."
fruitEmoji : EmojiSet
fruitEmoji = encyclopediaEmojiSet "Fruit" "Every fully-qualified emoji Unicode files under Food & Drink, subgroup food-fruit." OfficialEmojiSubgroup (encyclopediaFruitEmojiRows ())

@label "Vegetable emoji"
@description "Unicode's Food & Drink subgroup food-vegetable (Emoji 17.0)."
vegetableEmoji : EmojiSet
vegetableEmoji = encyclopediaEmojiSet "Vegetables" "Every fully-qualified emoji Unicode files under Food & Drink, subgroup food-vegetable." OfficialEmojiSubgroup (encyclopediaVegetableEmojiRows ())

@label "Flower emoji"
@description "Unicode's Animals & Nature subgroup plant-flower (Emoji 17.0)."
flowerEmoji : EmojiSet
flowerEmoji = encyclopediaEmojiSet "Flowers" "Every fully-qualified emoji Unicode files under Animals & Nature, subgroup plant-flower." OfficialEmojiSubgroup (encyclopediaFlowerEmojiRows ())

@label "Other plant emoji"
@description "Unicode's Animals & Nature subgroup plant-other (Emoji 17.0)."
otherPlantEmoji : EmojiSet
otherPlantEmoji = encyclopediaEmojiSet "Other plants" "Every fully-qualified emoji Unicode files under Animals & Nature, subgroup plant-other." OfficialEmojiSubgroup (encyclopediaOtherPlantEmojiRows ())

@label "Mammal emoji"
@description "Unicode's Animals & Nature subgroup animal-mammal (Emoji 17.0)."
mammalEmoji : EmojiSet
mammalEmoji = encyclopediaEmojiSet "Mammals" "Every fully-qualified emoji Unicode files under Animals & Nature, subgroup animal-mammal." OfficialEmojiSubgroup (encyclopediaMammalEmojiRows ())

@label "Smiling face emoji"
@description "Unicode's Smileys & Emotion subgroup face-smiling (Emoji 17.0)."
smilingFaceEmoji : EmojiSet
smilingFaceEmoji = encyclopediaEmojiSet "Smiling faces" "Every fully-qualified emoji Unicode files under Smileys & Emotion, subgroup face-smiling." OfficialEmojiSubgroup (encyclopediaSmilingFaceEmojiRows ())

@label "Country flag emoji"
@description "Unicode's Flags subgroup country-flag (Emoji 17.0): flags of regions with a two-letter region code."
countryFlagEmoji : EmojiSet
countryFlagEmoji = encyclopediaEmojiSet "Country flags" "Every fully-qualified emoji Unicode files under Flags, subgroup country-flag. Each is a pair of regional indicator letters." OfficialEmojiSubgroup (encyclopediaCountryFlagEmojiRows ())

@label "Plant emoji"
@description "Flowers and other plants together: the union of two official subgroups."
plantEmoji : EmojiSet
plantEmoji = encyclopediaEmojiSet "Plants" "The union of the official subgroups plant-flower and plant-other. Unicode files fruit and vegetables elsewhere, under Food & Drink." UnionOfEmojiSets (concat (encyclopediaFlowerEmojiRows ()) (encyclopediaOtherPlantEmojiRows ()))

@label "Food from plants"
@description "Fruit and vegetables together: the union of two official subgroups."
plantFoodEmoji : EmojiSet
plantFoodEmoji = encyclopediaEmojiSet "Fruit and vegetables" "The union of the official subgroups food-fruit and food-vegetable." UnionOfEmojiSets (concat (encyclopediaFruitEmojiRows ()) (encyclopediaVegetableEmojiRows ()))

encyclopediaDefiniteMember : (constraint: SetExpr) -> (emoji: String) -> Bool
encyclopediaDefiniteMember constraint emoji = case set.contains constraint emoji of
  Just true -> true
  _ -> false

@label "Compare two emoji sets"
@description "Ask the existing set judgments about two emoji sets: which emoji they share, whether either lies inside the other, and whether they are disjoint."
@tags "encyclopedia" "emoji" "sets"
@fieldLabel "first" "First"
@fieldLabel "second" "Second"
compareEmojiSets : (first: EmojiSet) -> (second: EmojiSet) -> EmojiSetComparison
compareEmojiSets first second =
  let common = filter (\row -> encyclopediaDefiniteMember second.constraint row.emoji) first.members
  EmojiSetComparison { left = first.name, right = second.name, shared = common, leftWithinRight = set.decideSubset first.constraint second.constraint, rightWithinLeft = set.decideSubset second.constraint first.constraint, disjoint = set.decideDisjoint first.constraint second.constraint, explanation = "Shared members are the left set's emoji that the right set's finite set contains. Inside and disjoint are the subset and disjointness judgments on the two finite sets; Nothing would mean undecided. Official subgroups never share an emoji, because Unicode files each emoji once." }

@label "Fruit inside fruit and vegetables"
@description "Every fruit emoji is also in the union of fruit and vegetables: a subset."
fruitWithinPlantFood : EmojiSetComparison
fruitWithinPlantFood = compareEmojiSets (fruitEmoji ()) (plantFoodEmoji ())

@label "Fruit and plants share no emoji"
@description "Unicode files fruit under Food & Drink and plants under Animals & Nature, so the two official sets are disjoint."
fruitAndPlants : EmojiSetComparison
fruitAndPlants = compareEmojiSets (fruitEmoji ()) (plantEmoji ())
