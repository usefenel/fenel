@label "Ferula"
@description "The giant fennel genus, in the family Apiaceae: subfamily Apioideae, tribe Scandiceae, subtribe Ferulinae in NCBI Taxonomy. Carrot is in the same tribe; common fennel is not."
ferula : PlantGenus
ferula = PlantGenus { scientificName = "Ferula", authority = "L.", family = apiaceae (), source = "https://www.gbif.org/species/3034682" }

@label "Common fennel"
@description "Foeniculum vulgare: a perennial native from the Mediterranean to Ethiopia and western Nepal (Kew, Plants of the World Online)."
commonFennel : PlantSpecies
commonFennel = PlantSpecies { scientificName = "Foeniculum vulgare", authority = "Mill.", genus = foeniculum (), commonNames = ["fennel", "common fennel"], lifeForm = PlantPerennial, nativeRange = "Mediterranean to Ethiopia and western Nepal", source = "https://powo.science.kew.org/taxon/842680-1" }

@label "Giant fennel"
@description "Ferula communis: a perennial native from the Mediterranean to the Arabian Peninsula and Tanzania (Kew, Plants of the World Online). It shares a family with common fennel, not a genus."
giantFennel : PlantSpecies
giantFennel = PlantSpecies { scientificName = "Ferula communis", authority = "L.", genus = ferula (), commonNames = ["giant fennel"], lifeForm = PlantPerennial, nativeRange = "Mediterranean to the Arabian Peninsula and Tanzania", source = "https://powo.science.kew.org/taxon/842235-1" }

