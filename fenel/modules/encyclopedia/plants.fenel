module Encyclopedia where

using std (map, filter, fold, concat, head, tail, last, words, some, fromMaybe, floor, imageSourceByte, Image, RgbaPixel)
using set (contains, decideSubset, decideDisjoint)
using engine (SetExpr)

-- Living things: three plant families and some of their species.
-- Classification is a typed reference to the next rank up: a species names
-- its genus and a genus its family. The held closed-ontology design
-- (workstreams/kinds/roadmap.md KC, workstreams/health-knowledge/roadmap.md
-- H0) concerns global biological kinds. The finite species sets below use
-- these same records from the supplied collection, without a new kind or
-- claim that unlisted species are absent from a biological genus or family.
-- Facts are botanical only, each with its source. Uses, myths and names given
-- after a plant live with the data that gives them; nothing here is a health
-- or food claim.

@label "Life Form"
@description "How long a plant lives: one growing season, two, or many years."
PlantLifeForm = PlantAnnual | PlantBiennial | PlantPerennial

@label "Taxon"
@description "A plant at one rank: a family, a genus or a species."
PlantTaxon = TaxonFamily PlantFamily | TaxonGenus PlantGenus | TaxonSpecies PlantSpecies

-- A plate points at the taxon it shows; a taxon does not carry its pictures,
-- so reading a plant (or anything that references it) never decodes an image.
@label "Plate Credit"
@description "What a plate says and what it is: the caption printed on it, which plant that is today, and where the plate comes from under which licence."
@fieldLabel "caption" "Caption"
@fieldLabel "depicts" "Depicts"
@fieldLabel "source" "Source"
@fieldLabel "licence" "Licence"
PlateCredit = PlateCredit caption: String depicts: String source: String licence: String

@label "Botanical Illustration"
@icon "image"
@description "A plate reduced to a small Image, the taxon it shows and its credit."
@fieldLabel "image" "Image"
@fieldLabel "subject" "Subject"
@fieldLabel "credit" "Credit"
BotanicalIllustration = BotanicalIllustration image: Image subject: PlantTaxon credit: PlateCredit

@label "Plant Family"
@icon "seedling"
@description "A botanical family: its accepted name, common names and the source of these facts."
@fieldLabel "scientificName" "Scientific Name"
@fieldLabel "commonNames" "Common Names"
@fieldLabel "source" "Source"
PlantFamily = PlantFamily scientificName: String commonNames: List String source: UrlStr

@label "Plant Genus"
@icon "seedling"
@description "A genus with its authority, the family it belongs to and the source of these facts."
@fieldLabel "scientificName" "Scientific Name"
@fieldLabel "authority" "Authority"
@fieldLabel "family" "Family"
@fieldLabel "source" "Source"
PlantGenus = PlantGenus scientificName: String authority: String family: PlantFamily source: UrlStr

@label "Plant Species"
@icon "seedling"
@description "An accepted species with its authority, genus, common names, life form and native range, and the source of these facts."
@fieldLabel "scientificName" "Scientific Name"
@fieldLabel "authority" "Authority"
@fieldLabel "genus" "Genus"
@fieldLabel "commonNames" "Common Names"
@fieldLabel "lifeForm" "Life Form"
@fieldLabel "nativeRange" "Native Range"
@fieldLabel "source" "Source"
PlantSpecies = PlantSpecies scientificName: String authority: String genus: PlantGenus commonNames: List String lifeForm: PlantLifeForm nativeRange: String source: UrlStr

encyclopediaPlatePixel : (rgb: Number) -> RgbaPixel
encyclopediaPlatePixel rgb =
  let r = floor (rgb / 65536)
  let g = floor (rgb / 256) - r * 256
  let b = rgb - floor (rgb / 256) * 256
  { r = imageSourceByte r, g = imageSourceByte g, b = imageSourceByte b, a = 255 }

@label "Köhler's fennel plate image"
@description "Plate 148 of Köhler's Medizinal-Pflanzen (1897) as a 72-pixel-wide Image. The original is preserved at /demo/encyclopedia/foeniculum-vulgare-koehler-148.jpg."
foeniculumVulgarePlateImage : Image
foeniculumVulgarePlateImage = { width = 72, height = foeniculumVulgarePlatePackedHeight (), pixels = map encyclopediaPlatePixel (foeniculumVulgarePlatePacked ()) }

@label "Van Houtte Ferula plate image"
@description "The lithograph captioned Narthex asafoetida Falconer as a 72-pixel-wide Image. The original is preserved at /demo/encyclopedia/narthex-asafoetida-van-houtte.jpg."
narthexAsafoetidaPlateImage : Image
narthexAsafoetidaPlateImage = { width = 72, height = narthexAsafoetidaPlatePackedHeight (), pixels = map encyclopediaPlatePixel (narthexAsafoetidaPlatePacked ()) }

@label "Köhler's plate of fennel"
@description "Plate 148 of Köhler's Medizinal-Pflanzen (1897): Foeniculum vulgare in flower and fruit."
foeniculumVulgareIllustration : BotanicalIllustration
foeniculumVulgareIllustration = BotanicalIllustration { image = foeniculumVulgarePlateImage (), subject = TaxonSpecies (commonFennel ()), credit = foeniculumVulgarePlateCredit () }

@label "A Ferula on a Van Houtte plate"
@description "A 19th-century lithograph captioned Narthex asafoetida Falconer, from Tibet. Falconer's Narthex is today part of the genus Ferula, the genus of giant fennel; the plant shown is another member of the genus, not giant fennel itself, so the plate shows the genus."
narthexAsafoetidaIllustration : BotanicalIllustration
narthexAsafoetidaIllustration = BotanicalIllustration { image = narthexAsafoetidaPlateImage (), subject = TaxonGenus (ferula ()), credit = narthexAsafoetidaPlateCredit () }

@label "Apiaceae"
@description "The carrot family, also called umbellifers. Common fennel and giant fennel both belong to it, in different genera."
apiaceae : PlantFamily
apiaceae = PlantFamily { scientificName = "Apiaceae", commonNames = ["carrot family", "umbellifers"], source = "https://www.gbif.org/species/6720" }

@label "Foeniculum"
@description "The fennel genus, in the family Apiaceae. NCBI Taxonomy files common fennel under Anethum, as Anethum foeniculum, in subfamily Apioideae, tribe Apieae; GBIF and Kew keep the genus Foeniculum."
foeniculum : PlantGenus
