-- These are finite sets of the species records in the supplied collection.
-- Taxon records retain their existing meaning; no global biological kind or
-- completeness claim is introduced. Unavailable selection keeps Nothing.

@label "Species Set"
@fieldLabel "taxon" "Taxon"
@fieldLabel "members" "Species"
@fieldLabel "constraint" "Set"
PlantSpeciesSet = PlantSpeciesSet taxon: PlantTaxon members: List PlantSpecies constraint: SetExpr

@label "Species Set Comparison"
@fieldLabel "first" "First Set"
@fieldLabel "second" "Second Set"
@fieldLabel "firstWithinSecond" "First Is a Subset of Second"
@fieldLabel "secondWithinFirst" "Second Is a Subset of First"
@fieldLabel "disjoint" "Disjoint"
@fieldLabel "shared" "Shared Species"
@fieldLabel "onlyFirst" "Only in First"
@fieldLabel "onlySecond" "Only in Second"
PlantSpeciesSetComparison = PlantSpeciesSetComparison first: PlantSpeciesSet second: PlantSpeciesSet firstWithinSecond: Maybe Bool secondWithinFirst: Maybe Bool disjoint: Maybe Bool shared: List PlantSpecies onlyFirst: List PlantSpecies onlySecond: List PlantSpecies

@label "Union of Genus Species Sets"
@fieldLabel "members" "Species"
@fieldLabel "constraint" "Union"
@fieldLabel "unionWithinFamily" "Union Is a Subset of Family"
@fieldLabel "familyWithinUnion" "Family Is a Subset of Union"
PlantSpeciesSetUnion = PlantSpeciesSetUnion members: List PlantSpecies constraint: SetExpr unionWithinFamily: Maybe Bool familyWithinUnion: Maybe Bool

@label "Family and Genus Species Sets"
@fieldLabel "family" "Family Set"
@fieldLabel "genera" "Genus Sets"
@fieldLabel "genusWithinFamily" "Genera Compared With Family"
@fieldLabel "genusComparisons" "Genera Compared With Each Other"
@fieldLabel "union" "Union of Genera"
PlantFamilySpeciesSets = PlantFamilySpeciesSets family: PlantSpeciesSet genera: List PlantSpeciesSet genusWithinFamily: List PlantSpeciesSetComparison genusComparisons: List PlantSpeciesSetComparison union: PlantSpeciesSetUnion

@label "Life Form Set"
@description "The species of this collection with one life form. The set cuts across families: its members come from several of them."
@fieldLabel "lifeForm" "Life Form"
@fieldLabel "members" "Species"
@fieldLabel "constraint" "Set"
PlantLifeFormSet = PlantLifeFormSet lifeForm: PlantLifeForm members: List PlantSpecies constraint: SetExpr

@label "Family and Life Form"
@description "One family set and one life-form set: the species they share, selected by membership in their intersection, and the subset and disjointness verdicts of the set judgment. Nothing means undecided."
@fieldLabel "family" "Family Set"
@fieldLabel "lifeForm" "Life Form Set"
@fieldLabel "shared" "Shared Species"
@fieldLabel "familyWithinLifeForm" "Family Is a Subset of Life Form"
@fieldLabel "disjoint" "Disjoint"
PlantFamilyLifeFormCrossing = PlantFamilyLifeFormCrossing family: PlantSpeciesSet lifeForm: PlantLifeFormSet shared: List PlantSpecies familyWithinLifeForm: Maybe Bool disjoint: Maybe Bool

-- A set made by people, not by botany: the species of the collection that
-- people call by one name. Its members are selected by their common names;
-- every subset and disjointness verdict against the botanical sets below is
-- the set judgment's own, never written by hand.
@label "Species Set by Name"
@description "The species of this collection that people call by one name, whatever their botany. It is a set made by people, not a family or a genus: its members can come from several genera or families."
@fieldLabel "name" "Name"
@fieldLabel "calledBy" "Called"
@fieldLabel "meaning" "Meaning"
@fieldLabel "members" "Species"
@fieldLabel "constraint" "Set"
PlantNamedSpeciesSet = PlantNamedSpeciesSet name: String calledBy: String meaning: String members: List PlantSpecies constraint: SetExpr

@label "Set by Name and a Botanical Set"
@description "One set by name and one family or genus set: the species they share, the species only the botanical set holds, and the subset and disjointness verdicts of the set judgment. Nothing means undecided."
@fieldLabel "named" "Set by Name"
@fieldLabel "taxon" "Botanical Set"
@fieldLabel "namedWithinTaxon" "Set by Name Is a Subset of Botanical Set"
@fieldLabel "disjoint" "Disjoint"
@fieldLabel "shared" "Shared Species"
@fieldLabel "onlyTaxon" "Only in Botanical Set"
PlantNamedSetTaxonComparison = PlantNamedSetTaxonComparison named: PlantNamedSpeciesSet taxon: PlantSpeciesSet namedWithinTaxon: Maybe Bool disjoint: Maybe Bool shared: List PlantSpecies onlyTaxon: List PlantSpecies

@label "Set by Name Among the Botanical Sets"
@description "A set by name compared with every family and genus set it is not decided disjoint from. A botanical set that holds it whole shows the other species that come with it."
@fieldLabel "named" "Set by Name"
@fieldLabel "meets" "Botanical Sets It Meets"
PlantNamedSetPlacement = PlantNamedSetPlacement named: PlantNamedSpeciesSet meets: List PlantNamedSetTaxonComparison

@label "Species Sets in This Collection"
@description "These sets contain the species described in this collection. Other species are not listed here. Nothing means that a complete selection could not be decided."
@fieldLabel "coverage" "Coverage"
@fieldLabel "families" "Family Sets"
@fieldLabel "lifeForms" "Life Form Sets"
@fieldLabel "crossings" "Families Crossed With Life Forms"
@fieldLabel "namedSets" "Sets by Name"
PlantSpeciesSetsInCollection = PlantSpeciesSetsInCollection coverage: String families: Maybe (List PlantFamilySpeciesSets) lifeForms: Maybe (List PlantLifeFormSet) crossings: Maybe (List PlantFamilyLifeFormCrossing) namedSets: Maybe (List PlantNamedSetPlacement)

-- The species sets are ordinary typed data; Viewable selects the shared
-- nested-sets body (each genus set drawn inside its family set, the species as
-- chips, the decided relations below). The values stay inspectable through the
-- structural reader, and every verdict above is the set judgment's own.
_ : Viewable PlantSpeciesSetsInCollection
_ = Viewable { defaultView = "nested-sets", defaultInlineView = "nested-sets" }

_ : Viewable PlantFamilySpeciesSets
_ = Viewable { defaultView = "nested-sets", defaultInlineView = "nested-sets" }

@label "Collect Decided Species Results"
@fieldLabel "results" "Results"
encyclopediaCollectSpeciesResults : (results: List (Maybe a)) -> Maybe (List a)
encyclopediaCollectSpeciesResults results = case head results of
  Nothing -> Just []
  Just first -> case first of
    Nothing -> Nothing
    Just value -> case encyclopediaCollectSpeciesResults (fromMaybe [] (tail results)) of
      Nothing -> Nothing
      Just rest -> Just (concat [value] rest)

@label "Species Described in the Collection"
@fieldLabel "families" "Plant Families"
encyclopediaCollectionSpecies : (families: List EncyclopediaFamilyEntry) -> List PlantSpecies
encyclopediaCollectionSpecies families =
  let genusEntries = fold (\known family -> concat known family.genera) [] families
  fold (\known genus -> concat known genus.species) [] genusEntries

@label "Species Belongs to the Selected Taxon"
@description "Compare the existing genus or family record through singleton membership. Scientific names are labels, not identity keys."
@fieldLabel "taxon" "Taxon"
@fieldLabel "species" "Species"
encyclopediaSpeciesTaxonContains : (taxon: PlantTaxon) -> (species: PlantSpecies) -> Maybe Bool
encyclopediaSpeciesTaxonContains taxon species = case taxon of
  TaxonFamily family -> set.contains (SeEnum { values = [family] }) species.genus.family
  TaxonGenus genus -> set.contains (SeEnum { values = [genus] }) species.genus
  TaxonSpecies selected -> set.contains (SeEnum { values = [selected] }) species

@label "Select Species With Decided Membership"
@description "A decided empty selection is Just []. Any undecided membership keeps the complete selection unknown."
@fieldLabel "predicate" "Membership"
@fieldLabel "species" "Species"
encyclopediaSelectSpecies : (predicate: PlantSpecies -> Maybe Bool) -> (species: List PlantSpecies) -> Maybe (List PlantSpecies)
encyclopediaSelectSpecies predicate species = case head species of
  Nothing -> Just []
  Just first -> case predicate first of
    Nothing -> Nothing
    Just included -> case encyclopediaSelectSpecies predicate (fromMaybe [] (tail species)) of
      Nothing -> Nothing
      Just rest -> if included then Just (concat [first] rest) else Just rest

@label "Species Set for a Taxon in This Collection"
@fieldLabel "species" "Collection Species"
@fieldLabel "taxon" "Taxon"
encyclopediaSpeciesSet : (species: List PlantSpecies) -> (taxon: PlantTaxon) -> Maybe PlantSpeciesSet
encyclopediaSpeciesSet species taxon =
  case encyclopediaSelectSpecies (\row -> encyclopediaSpeciesTaxonContains taxon row) species of
    Nothing -> Nothing
    Just members ->
      let constraint = SeEnum { values = members }
      Just (PlantSpeciesSet { taxon = taxon, members = members, constraint = constraint })

@label "Compare Species Sets"
@description "Use the existing subset, disjointness, intersection and difference judgments on the actual species records. Undecided judgments stay Nothing."
@fieldLabel "first" "First Set"
@fieldLabel "second" "Second Set"
comparePlantSpeciesSets : (first: PlantSpeciesSet) -> (second: PlantSpeciesSet) -> Maybe PlantSpeciesSetComparison
comparePlantSpeciesSets first second =
  let intersection = SeIntersect { branches = [first.constraint, second.constraint] }
  let firstDifference = SeDiff { left = first.constraint, right = second.constraint }
  let secondDifference = SeDiff { left = second.constraint, right = first.constraint }
  case encyclopediaSelectSpecies (\row -> set.contains intersection row) first.members of
    Nothing -> Nothing
    Just shared -> case encyclopediaSelectSpecies (\row -> set.contains firstDifference row) first.members of
      Nothing -> Nothing
      Just onlyFirst -> case encyclopediaSelectSpecies (\row -> set.contains secondDifference row) second.members of
        Nothing -> Nothing
        Just onlySecond -> Just (PlantSpeciesSetComparison { first = first, second = second, firstWithinSecond = set.decideSubset first.constraint second.constraint, secondWithinFirst = set.decideSubset second.constraint first.constraint, disjoint = set.decideDisjoint first.constraint second.constraint, shared = shared, onlyFirst = onlyFirst, onlySecond = onlySecond })

@label "Compare Each Pair of Genus Sets"
@fieldLabel "genera" "Genus Sets"
encyclopediaGenusSetComparisons : (genera: List PlantSpeciesSet) -> Maybe (List PlantSpeciesSetComparison)
encyclopediaGenusSetComparisons genera = case head genera of
  Nothing -> Just []
  Just first ->
    let rest = fromMaybe [] (tail genera)
    case encyclopediaCollectSpeciesResults (map (comparePlantSpeciesSets first) rest) of
      Nothing -> Nothing
      Just comparisons -> case encyclopediaGenusSetComparisons rest of
        Nothing -> Nothing
        Just remaining -> Just (concat comparisons remaining)

@label "Union of the Collection's Genus Sets"
@fieldLabel "family" "Family Set"
@fieldLabel "genera" "Genus Sets"
encyclopediaGenusSetUnion : (family: PlantSpeciesSet) -> (genera: List PlantSpeciesSet) -> PlantSpeciesSetUnion
encyclopediaGenusSetUnion family genera =
  let branches = map (\genus -> genus.constraint) genera
  let constraint = SeUnion { branches = branches }
  let members = fold (\known genus -> concat known genus.members) [] genera
  PlantSpeciesSetUnion { members = members, constraint = constraint, unionWithinFamily = set.decideSubset constraint family.constraint, familyWithinUnion = set.decideSubset family.constraint constraint }

@label "Species Sets for a Described Family"
@fieldLabel "species" "Collection Species"
@fieldLabel "entry" "Family Entry"
encyclopediaFamilySpeciesSets : (species: List PlantSpecies) -> (entry: EncyclopediaFamilyEntry) -> Maybe PlantFamilySpeciesSets
encyclopediaFamilySpeciesSets species entry =
  case encyclopediaSpeciesSet species (TaxonFamily entry.family) of
    Nothing -> Nothing
    Just family -> case encyclopediaCollectSpeciesResults (map (\genus -> encyclopediaSpeciesSet species (TaxonGenus genus.genus)) entry.genera) of
      Nothing -> Nothing
      Just genera -> case encyclopediaCollectSpeciesResults (map (\genus -> comparePlantSpeciesSets genus family) genera) of
        Nothing -> Nothing
        Just within -> case encyclopediaGenusSetComparisons genera of
          Nothing -> Nothing
          Just comparisons -> Just (PlantFamilySpeciesSets { family = family, genera = genera, genusWithinFamily = within, genusComparisons = comparisons, union = encyclopediaGenusSetUnion family genera })

@label "Species Has the Life Form"
@description "Compare the species' life form with the selected one through singleton membership."
@fieldLabel "selected" "Life Form"
@fieldLabel "species" "Species"
encyclopediaSpeciesLifeFormContains : (selected: PlantLifeForm) -> (species: PlantSpecies) -> Maybe Bool
encyclopediaSpeciesLifeFormContains selected species = set.contains (SeEnum { values = [selected] }) species.lifeForm

@label "Life Form Set in This Collection"
@description "The collection's species with the selected life form, from every family. Any undecided membership keeps the complete selection unknown."
@fieldLabel "species" "Collection Species"
@fieldLabel "selected" "Life Form"
encyclopediaLifeFormSet : (species: List PlantSpecies) -> (selected: PlantLifeForm) -> Maybe PlantLifeFormSet
encyclopediaLifeFormSet species selected =
  case encyclopediaSelectSpecies (\row -> encyclopediaSpeciesLifeFormContains selected row) species of
    Nothing -> Nothing
    Just members ->
      let constraint = SeEnum { values = members }
      Just (PlantLifeFormSet { lifeForm = selected, members = members, constraint = constraint })

@label "Cross a Family With a Life Form"
@description "The family's species that the intersection of the two sets contains, and the subset and disjointness judgments on the same two sets. Undecided judgments stay Nothing."
@fieldLabel "familySet" "Family Set"
@fieldLabel "lifeFormSet" "Life Form Set"
encyclopediaFamilyLifeFormCrossing : (familySet: PlantSpeciesSet) -> (lifeFormSet: PlantLifeFormSet) -> Maybe PlantFamilyLifeFormCrossing
encyclopediaFamilyLifeFormCrossing familySet lifeFormSet =
  let intersection = SeIntersect { branches = [familySet.constraint, lifeFormSet.constraint] }
  case encyclopediaSelectSpecies (\row -> set.contains intersection row) familySet.members of
    Nothing -> Nothing
    Just shared -> Just (PlantFamilyLifeFormCrossing { family = familySet, lifeForm = lifeFormSet, shared = shared, familyWithinLifeForm = set.decideSubset familySet.constraint lifeFormSet.constraint, disjoint = set.decideDisjoint familySet.constraint lifeFormSet.constraint })

@label "Cross Every Family With Every Life Form"
@description "One crossing per family and life form: families in collection order, each crossed with the life forms in the order given. Nothing when a family selection, a life-form selection or a crossing is undecided."
@fieldLabel "families" "Family Sets"
@fieldLabel "lifeForms" "Life Form Sets"
encyclopediaFamilyLifeFormCrossings : (families: Maybe (List PlantFamilySpeciesSets)) -> (lifeForms: Maybe (List PlantLifeFormSet)) -> Maybe (List PlantFamilyLifeFormCrossing)
encyclopediaFamilyLifeFormCrossings families lifeForms = case families of
  Nothing -> Nothing
  Just familySets -> case lifeForms of
    Nothing -> Nothing
    Just lifeFormSets ->
      let rows = map (\familySet -> encyclopediaCollectSpeciesResults (map (encyclopediaFamilyLifeFormCrossing familySet.family) lifeFormSets)) familySets
      case encyclopediaCollectSpeciesResults rows of
        Nothing -> Nothing
        Just perFamily -> Just (fold (\known row -> concat known row) [] perFamily)

@label "Common Name Ends With a Word"
@description "Whether the last word of a common name is the given word: giant fennel ends with fennel."
@fieldLabel "word" "Word"
@fieldLabel "commonName" "Common Name"
encyclopediaNameEndsWith : (word: String) -> (commonName: String) -> Bool
encyclopediaNameEndsWith word commonName = case last (words commonName) of
  Nothing -> false
  Just final -> final == word

@label "Species Is Called by a Word"
@description "Whether one of the species' common names ends with the word: common fennel and giant fennel are both called fennel. A name people use, not a botanical rank."
@fieldLabel "word" "Word"
@fieldLabel "species" "Species"
encyclopediaSpeciesCalled : (word: String) -> (species: PlantSpecies) -> Bool
encyclopediaSpeciesCalled word species = some species.commonNames (\commonName -> encyclopediaNameEndsWith word commonName)

@label "Species Set by Name in This Collection"
@description "The collection's species that one of their common names calls by the word, as a finite set of the species records."
@fieldLabel "setName" "Name"
@fieldLabel "word" "Word"
@fieldLabel "setMeaning" "Meaning"
@fieldLabel "species" "Collection Species"
encyclopediaNamedSpeciesSet : (setName: String) -> (word: String) -> (setMeaning: String) -> (species: List PlantSpecies) -> PlantNamedSpeciesSet
encyclopediaNamedSpeciesSet setName word setMeaning species =
  let members = filter (\row -> encyclopediaSpeciesCalled word row) species
  PlantNamedSpeciesSet { name = setName, calledBy = word, meaning = setMeaning, members = members, constraint = SeEnum { values = members } }

encyclopediaFennelsMeaning : String
encyclopediaFennelsMeaning = "Common fennel and giant fennel: the species of this collection that people call fennel. No family or genus holds just these two. NCBI Taxonomy places common fennel (filed there as Anethum foeniculum) in tribe Apieae, with dill and celery, and Ferula in tribe Scandiceae, with carrot. The smallest botanical group holding both is subfamily Apioideae, which also holds carrot, celery, coriander and dill."

@label "Fennels"
@description "The species of a collection that people call fennel: a set made by people, not by botany. Common fennel and giant fennel are in different genera and different tribes; the smallest botanical group holding both also holds carrot."
@fieldLabel "species" "Collection Species"
encyclopediaFennelsIn : (species: List PlantSpecies) -> PlantNamedSpeciesSet
encyclopediaFennelsIn species = encyclopediaNamedSpeciesSet "Fennels" "fennel" (encyclopediaFennelsMeaning ()) species

@label "Compare a Set by Name With a Botanical Set"
@description "Use the existing subset, disjointness, intersection and difference judgments on the actual species records. Undecided judgments stay Nothing."
@fieldLabel "nameSet" "Set by Name"
@fieldLabel "botanical" "Botanical Set"
encyclopediaCompareNamedSet : (nameSet: PlantNamedSpeciesSet) -> (botanical: PlantSpeciesSet) -> Maybe PlantNamedSetTaxonComparison
encyclopediaCompareNamedSet nameSet botanical =
  let intersection = SeIntersect { branches = [nameSet.constraint, botanical.constraint] }
  let botanicalOnly = SeDiff { left = botanical.constraint, right = nameSet.constraint }
  case encyclopediaSelectSpecies (\row -> set.contains intersection row) botanical.members of
    Nothing -> Nothing
    Just common -> case encyclopediaSelectSpecies (\row -> set.contains botanicalOnly row) botanical.members of
      Nothing -> Nothing
      Just others -> Just (PlantNamedSetTaxonComparison { named = nameSet, taxon = botanical, namedWithinTaxon = set.decideSubset nameSet.constraint botanical.constraint, disjoint = set.decideDisjoint nameSet.constraint botanical.constraint, shared = common, onlyTaxon = others })

-- Only a decided disjointness drops a botanical set; an undecided one stays.
encyclopediaNamedSetMeets : (comparison: PlantNamedSetTaxonComparison) -> Bool
encyclopediaNamedSetMeets comparison = case comparison.disjoint of
  Just true -> false
  _ -> true

@label "Place a Set by Name Among the Botanical Sets"
@description "Compare the set by name with every family set and every genus set, in collection order, and keep the ones it is not decided disjoint from. Nothing when a comparison is undecided."
@fieldLabel "nameSet" "Set by Name"
@fieldLabel "familySets" "Family Sets"
encyclopediaNamedSetPlacement : (nameSet: PlantNamedSpeciesSet) -> (familySets: List PlantFamilySpeciesSets) -> Maybe PlantNamedSetPlacement
encyclopediaNamedSetPlacement nameSet familySets =
  let botanical = fold (\known familySet -> concat known (concat [familySet.family] familySet.genera)) [] familySets
  case encyclopediaCollectSpeciesResults (map (encyclopediaCompareNamedSet nameSet) botanical) of
    Nothing -> Nothing
    Just rows -> Just (PlantNamedSetPlacement { named = nameSet, meets = filter encyclopediaNamedSetMeets rows })

@label "Place Every Set by Name"
@fieldLabel "nameSets" "Sets by Name"
@fieldLabel "families" "Family Sets"
encyclopediaNamedSetPlacements : (nameSets: List PlantNamedSpeciesSet) -> (families: Maybe (List PlantFamilySpeciesSets)) -> Maybe (List PlantNamedSetPlacement)
encyclopediaNamedSetPlacements nameSets families = case families of
  Nothing -> Nothing
  Just familySets -> encyclopediaCollectSpeciesResults (map (\nameSet -> encyclopediaNamedSetPlacement nameSet familySets) nameSets)

@label "Species Sets in This Collection"
@description "These sets contain the species described in this collection. Other species are not listed here. Every set is recomputed from the supplied plant-family collection: the family and genus sets, the life-form sets annual, biennial and perennial, each family crossed with each life form, and the fennels, a set by name placed among the family and genus sets."
@tags "encyclopedia" "plants" "sets"
@fieldLabel "entries" "Plant Families"
encyclopediaSpeciesSets : (entries: List EncyclopediaFamilyEntry) -> PlantSpeciesSetsInCollection
encyclopediaSpeciesSets entries =
  let species = encyclopediaCollectionSpecies entries
  let familySets = encyclopediaCollectSpeciesResults (map (encyclopediaFamilySpeciesSets species) entries)
  let lifeFormSets = encyclopediaCollectSpeciesResults (map (encyclopediaLifeFormSet species) [PlantAnnual, PlantBiennial, PlantPerennial])
  let crossings = encyclopediaFamilyLifeFormCrossings familySets lifeFormSets
  let namedSets = encyclopediaNamedSetPlacements [encyclopediaFennelsIn species] familySets
  PlantSpeciesSetsInCollection { coverage = "These sets contain the species described in this collection. Other species are not listed here.", families = familySets, lifeForms = lifeFormSets, crossings = crossings, namedSets = namedSets }
