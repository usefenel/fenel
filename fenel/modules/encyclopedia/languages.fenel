module Encyclopedia where

-- Programming languages Fenel learns from, in the order they first appeared.
-- Each year is the "First appeared" year of the language's English Wikipedia
-- infobox (checked 2026-11-11). "What Fenel takes from it" is Fenel's own
-- reading of its design, written by its authors: it ranks nothing and makes no
-- claim about the language itself.

@label "Programming Language"
@icon "code"
@description "A programming language: its name, the year it first appeared, what Fenel takes from it, and the source of these facts."
@fieldLabel "name" "Name"
@fieldLabel "firstAppeared" "First Appeared"
@fieldLabel "fenelTakes" "What Fenel Takes From It"
@fieldLabel "source" "Source"
ProgrammingLanguage = ProgrammingLanguage name: String firstAppeared: Nat fenelTakes: String source: UrlStr

@label "LISP"
@description "John McCarthy began LISP (list processing) in 1958; its design was published in 1960, the year given here. Its later dialects are written Lisp."
languageLisp : ProgrammingLanguage
languageLisp = ProgrammingLanguage { name = "LISP", firstAppeared = 1960, fenelTakes = "Code is data: a program is a value that other programs can read and build.", source = "https://en.wikipedia.org/wiki/Lisp_(programming_language)" }

@label "Smalltalk"
@description "Smalltalk first appeared in 1972; its development began in 1969."
languageSmalltalk : ProgrammingLanguage
languageSmalltalk = ProgrammingLanguage { name = "Smalltalk", firstAppeared = 1972, fenelTakes = "A live environment where every value can be opened, inspected and changed.", source = "https://en.wikipedia.org/wiki/Smalltalk" }

@label "Prolog"
languageProlog : ProgrammingLanguage
languageProlog = ProgrammingLanguage { name = "Prolog", firstAppeared = 1972, fenelTakes = "Asking for the solutions of a question instead of writing the search.", source = "https://en.wikipedia.org/wiki/Prolog" }

@label "SQL"
@description "SQL was designed by Donald D. Chamberlin and Raymond F. Boyce at IBM; it first appeared in 1973."
languageSql : ProgrammingLanguage
languageSql = ProgrammingLanguage { name = "SQL", firstAppeared = 1973, fenelTakes = "Data as tables of typed rows, read by describing the rows wanted.", source = "https://en.wikipedia.org/wiki/SQL" }

@label "Erlang"
languageErlang : ProgrammingLanguage
languageErlang = ProgrammingLanguage { name = "Erlang", firstAppeared = 1986, fenelTakes = "Durable work that can stop and start again without losing its place.", source = "https://en.wikipedia.org/wiki/Erlang_(programming_language)" }

@label "Coq"
@description "Coq is now named Rocq: the official renaming came with Rocq 9.0 in March 2025. Its first version appeared in 1989."
languageCoq : ProgrammingLanguage
languageCoq = ProgrammingLanguage { name = "Coq", firstAppeared = 1989, fenelTakes = "Claims written as types, and evidence that a small checker verifies.", source = "https://en.wikipedia.org/wiki/Rocq" }

@label "Haskell"
languageHaskell : ProgrammingLanguage
languageHaskell = ProgrammingLanguage { name = "Haskell", firstAppeared = 1990, fenelTakes = "Algebraic data types, type classes and pure functions.", source = "https://en.wikipedia.org/wiki/Haskell" }

@label "OCaml"
languageOCaml : ProgrammingLanguage
languageOCaml = ProgrammingLanguage { name = "OCaml", firstAppeared = 1996, fenelTakes = "Modules that are ordinary values, and variants.", source = "https://en.wikipedia.org/wiki/OCaml" }

@label "Scratch"
@description "Scratch's first prototype appeared in 2003, the year given here; Scratch 1.0 was released in 2007."
languageScratch : ProgrammingLanguage
languageScratch = ProgrammingLanguage { name = "Scratch", firstAppeared = 2003, fenelTakes = "Building programs from blocks instead of typing text.", source = "https://en.wikipedia.org/wiki/Scratch_(programming_language)" }

@label "TypeScript"
languageTypeScript : ProgrammingLanguage
languageTypeScript = ProgrammingLanguage { name = "TypeScript", firstAppeared = 2012, fenelTakes = "Structural types, and the host that runs Fenel's reference runtime.", source = "https://en.wikipedia.org/wiki/TypeScript" }

@label "Programming languages"
@description "Ten programming languages Fenel learns from, in the order they first appeared: LISP, Smalltalk, Prolog, SQL, Erlang, Coq (now Rocq), Haskell, OCaml, Scratch and TypeScript."
@tags "languages" "data"
programmingLanguages : List ProgrammingLanguage
programmingLanguages = [languageLisp (), languageSmalltalk (), languageProlog (), languageSql (), languageErlang (), languageCoq (), languageHaskell (), languageOCaml (), languageScratch (), languageTypeScript ()]
