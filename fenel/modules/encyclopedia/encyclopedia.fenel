module Encyclopedia where

using EncyclopediaDemo (EncyclopediaCountry, encyclopediaCountries)
using GreekAlphabetDemo (GreekAlphabetLetter, GreekAlphabetCharacter, GreekAlphabetSetResult, greekAlphabet, greekCharacters, greekAlphabetSets, AllGreekLetters, UppercaseGreek, LowercaseGreek, GreekVowels, GreekIntersection, GreekDifference)

-- The encyclopedia's table of contents: ordinary records nesting each
-- collection inside the one that contains it (a species inside its genus
-- inside its family; an emoji subgroup inside its Unicode group). Opening an
-- entry evaluates its data; nothing here is stored or fetched. Countries and
-- the Greek alphabet are the existing collections, reused, not copied.

@label "Genus and Its Species"
@description "One genus, the species of it this collection describes, and plates of the genus or those species."
@fieldLabel "genus" "Genus"
@fieldLabel "species" "Species"
@fieldLabel "plates" "Plates"
EncyclopediaGenusEntry = EncyclopediaGenusEntry genus: PlantGenus species: List PlantSpecies plates: List BotanicalIllustration

@label "Family and Its Genera"
@description "One plant family and the genera of it this collection describes."
@fieldLabel "family" "Family"
@fieldLabel "genera" "Genera"
EncyclopediaFamilyEntry = EncyclopediaFamilyEntry family: PlantFamily genera: List EncyclopediaGenusEntry

@label "Emoji Group"
@description "One Unicode emoji group and the official subgroups of it included here. The group has other subgroups; this is not the whole group."
@fieldLabel "group" "Group"
@fieldLabel "subgroups" "Subgroups"
EncyclopediaEmojiGroup = EncyclopediaEmojiGroup group: String subgroups: List EmojiSet

@label "Living Things"
@description "Plants by family, genus and species."
@fieldLabel "plantFamilies" "Plant Families"
@fieldLabel "speciesSets" "Species Sets in This Collection"
EncyclopediaLivingThings = EncyclopediaLivingThings plantFamilies: List EncyclopediaFamilyEntry speciesSets: PlantSpeciesSetsInCollection

@label "Countries"
@description "The country reference rows, and sets of them compared with the existing set judgments."
@fieldLabel "countries" "Countries"
@fieldLabel "euroAndEu" "Euro Area and EU"
@fieldLabel "euroAreaFlags" "Euro Area Flags"
@fieldLabel "euroAreaFlagsWithinCountryFlags" "Euro Area Flags Within Country Flags"
EncyclopediaCountrySets = EncyclopediaCountrySets countries: List EncyclopediaCountry euroAndEu: CountrySetComparison euroAreaFlags: EmojiSet euroAreaFlagsWithinCountryFlags: EmojiSetComparison

@label "Writing Systems"
@description "The modern Greek alphabet, its characters and sets of them; the Latin and Russian alphabets, the Elder Futhark runes, and the basic hiragana and katakana."
@fieldLabel "greekAlphabet" "Greek Alphabet"
@fieldLabel "greekCharacters" "Greek Characters"
@fieldLabel "greekSets" "Greek Sets"
@fieldLabel "latinAlphabet" "Latin Alphabet"
@fieldLabel "russianAlphabet" "Russian Alphabet"
@fieldLabel "elderFuthark" "Elder Futhark"
@fieldLabel "hiragana" "Hiragana"
@fieldLabel "katakana" "Katakana"
EncyclopediaWriting = EncyclopediaWriting greekAlphabet: List GreekAlphabetLetter greekCharacters: List GreekAlphabetCharacter greekSets: List GreekAlphabetSetResult latinAlphabet: List LatinLetter russianAlphabet: List CyrillicLetter elderFuthark: List ElderFutharkRune hiragana: List KanaCharacter katakana: List KanaCharacter

@label "Emoji"
@description "Emoji sets by Unicode group and subgroup, unions of them, and comparisons between sets."
@fieldLabel "groups" "Groups"
@fieldLabel "unions" "Unions"
@fieldLabel "comparisons" "Comparisons"
EncyclopediaEmoji = EncyclopediaEmoji groups: List EncyclopediaEmojiGroup unions: List EmojiSet comparisons: List EmojiSetComparison

@label "Contents"
@description "Living things, countries, writing systems, emoji and programming languages, each nested inside the collection that contains it."
@fieldLabel "livingThings" "Living Things"
@fieldLabel "countries" "Countries"
@fieldLabel "writing" "Writing"
@fieldLabel "emoji" "Emoji"
@fieldLabel "programmingLanguages" "Programming Languages"
EncyclopediaContents = EncyclopediaContents livingThings: EncyclopediaLivingThings countries: EncyclopediaCountrySets writing: EncyclopediaWriting emoji: EncyclopediaEmoji programmingLanguages: List ProgrammingLanguage

@label "Living things"
@description "Plants by family, genus and species: Apiaceae (common fennel, giant fennel, carrot, celery, coriander, dill), Asteraceae (sunflower, Jerusalem artichoke, lesser burdock) and Solanaceae (potato, cutleaf nightshade, thorn apple)."
@tags "encyclopedia" "plants"
encyclopediaLivingThings : EncyclopediaLivingThings
encyclopediaLivingThings =
  let families = encyclopediaPlantFamilies ()
  EncyclopediaLivingThings { plantFamilies = families, speciesSets = encyclopediaSpeciesSets families }

@label "Plant families"
@description "The plant families this collection describes, each with the genera and species of it described here: Apiaceae, Asteraceae and Solanaceae."
@tags "encyclopedia" "plants"
encyclopediaPlantFamilies : List EncyclopediaFamilyEntry
encyclopediaPlantFamilies = [encyclopediaApiaceaeEntry (), encyclopediaAsteraceaeEntry (), encyclopediaSolanaceaeEntry ()]

@label "Species sets"
@description "Each described plant family as the set of its described species, each genus as a subset of it, with the subset, disjointness and union verdicts of Fenel's set judgment; then the sets by life form, which cut across families, and each family crossed with each life form. These sets contain the species described in this collection. Other species are not listed here."
@tags "encyclopedia" "plants" "sets"
encyclopediaPlantSpeciesSets : PlantSpeciesSetsInCollection
encyclopediaPlantSpeciesSets = encyclopediaSpeciesSets (encyclopediaPlantFamilies ())

@label "Plant species"
@description "Every species this collection describes, as ordinary typed records. Each species names its genus and each genus its family."
@tags "encyclopedia" "plants"
encyclopediaPlantSpecies : List PlantSpecies
encyclopediaPlantSpecies = encyclopediaCollectionSpecies (encyclopediaPlantFamilies ())

@label "Fennels"
@description "Common fennel and giant fennel: the species of this collection that people call fennel. A set made by people, not by botany: no family or genus holds just these two, and the smallest botanical group holding both also holds carrot. The species sets place it among the family and genus sets."
@tags "plants" "sets"
encyclopediaFennels : PlantNamedSpeciesSet
encyclopediaFennels = encyclopediaFennelsIn (encyclopediaPlantSpecies ())

encyclopediaFoeniculumEntry : EncyclopediaGenusEntry
encyclopediaFoeniculumEntry = EncyclopediaGenusEntry { genus = foeniculum (), species = [commonFennel ()], plates = [foeniculumVulgareIllustration ()] }

encyclopediaFerulaEntry : EncyclopediaGenusEntry
encyclopediaFerulaEntry = EncyclopediaGenusEntry { genus = ferula (), species = [giantFennel ()], plates = [narthexAsafoetidaIllustration ()] }

encyclopediaDaucusEntry : EncyclopediaGenusEntry
encyclopediaDaucusEntry = EncyclopediaGenusEntry { genus = daucus (), species = [carrot ()], plates = [] }

encyclopediaApiumEntry : EncyclopediaGenusEntry
encyclopediaApiumEntry = EncyclopediaGenusEntry { genus = apium (), species = [celery ()], plates = [] }

encyclopediaCoriandrumEntry : EncyclopediaGenusEntry
encyclopediaCoriandrumEntry = EncyclopediaGenusEntry { genus = coriandrum (), species = [coriander ()], plates = [] }

encyclopediaAnethumEntry : EncyclopediaGenusEntry
encyclopediaAnethumEntry = EncyclopediaGenusEntry { genus = anethum (), species = [dill ()], plates = [] }

encyclopediaHelianthusEntry : EncyclopediaGenusEntry
encyclopediaHelianthusEntry = EncyclopediaGenusEntry { genus = helianthus (), species = [sunflower (), jerusalemArtichoke ()], plates = [] }

encyclopediaArctiumEntry : EncyclopediaGenusEntry
encyclopediaArctiumEntry = EncyclopediaGenusEntry { genus = arctium (), species = [lesserBurdock ()], plates = [] }

encyclopediaSolanumEntry : EncyclopediaGenusEntry
encyclopediaSolanumEntry = EncyclopediaGenusEntry { genus = solanum (), species = [potato (), cutleafNightshade ()], plates = [] }

encyclopediaDaturaEntry : EncyclopediaGenusEntry
encyclopediaDaturaEntry = EncyclopediaGenusEntry { genus = datura (), species = [thornApple ()], plates = [] }

encyclopediaApiaceaeEntry : EncyclopediaFamilyEntry
encyclopediaApiaceaeEntry = EncyclopediaFamilyEntry { family = apiaceae (), genera = [encyclopediaFoeniculumEntry (), encyclopediaFerulaEntry (), encyclopediaDaucusEntry (), encyclopediaApiumEntry (), encyclopediaCoriandrumEntry (), encyclopediaAnethumEntry ()] }

encyclopediaAsteraceaeEntry : EncyclopediaFamilyEntry
encyclopediaAsteraceaeEntry = EncyclopediaFamilyEntry { family = asteraceae (), genera = [encyclopediaHelianthusEntry (), encyclopediaArctiumEntry ()] }

encyclopediaSolanaceaeEntry : EncyclopediaFamilyEntry
encyclopediaSolanaceaeEntry = EncyclopediaFamilyEntry { family = solanaceae (), genera = [encyclopediaSolanumEntry (), encyclopediaDaturaEntry ()] }

@label "Country sets"
@description "All country reference rows, the euro area as an intersection of two country sets, and its flags inside every country flag."
@tags "encyclopedia" "countries" "sets"
encyclopediaCountrySets : EncyclopediaCountrySets
encyclopediaCountrySets = EncyclopediaCountrySets { countries = encyclopediaCountries (), euroAndEu = euroAndEuCountries (), euroAreaFlags = euroAreaFlagEmoji (), euroAreaFlagsWithinCountryFlags = euroAreaFlagsWithinCountryFlags () }

@label "Writing systems"
@description "The 24 modern Greek letters, their 49 characters, and three sets of them: capitals that are vowels, characters that are not vowels, and capitals that are lowercase, which is empty. Then the 26 Latin letters, the 33 Russian letters, the 24 Elder Futhark runes, and the 46 basic hiragana and katakana."
@tags "encyclopedia" "greek" "sets"
encyclopediaWriting : EncyclopediaWriting
encyclopediaWriting = EncyclopediaWriting { greekAlphabet = greekAlphabet (), greekCharacters = greekCharacters (), greekSets = [greekAlphabetSets UppercaseGreek GreekIntersection GreekVowels "Α", greekAlphabetSets AllGreekLetters GreekDifference GreekVowels "Β", greekAlphabetSets UppercaseGreek GreekIntersection LowercaseGreek "Α"], latinAlphabet = latinAlphabet (), russianAlphabet = russianAlphabet (), elderFuthark = elderFuthark (), hiragana = hiragana (), katakana = katakana () }

@label "Emoji sets"
@description "Seven official Unicode subgroups in their four groups, two unions of them, and what the set judgments say about pairs."
@tags "encyclopedia" "emoji" "sets"
encyclopediaEmoji : EncyclopediaEmoji
encyclopediaEmoji = EncyclopediaEmoji { groups = [encyclopediaFoodGroup (), encyclopediaNatureGroup (), encyclopediaSmileysGroup (), encyclopediaFlagsGroup ()], unions = [plantEmoji (), plantFoodEmoji ()], comparisons = [fruitWithinPlantFood (), fruitAndPlants ()] }

encyclopediaFoodGroup : EncyclopediaEmojiGroup
encyclopediaFoodGroup = EncyclopediaEmojiGroup { group = "Food & Drink", subgroups = [fruitEmoji (), vegetableEmoji ()] }

encyclopediaNatureGroup : EncyclopediaEmojiGroup
encyclopediaNatureGroup = EncyclopediaEmojiGroup { group = "Animals & Nature", subgroups = [flowerEmoji (), otherPlantEmoji (), mammalEmoji ()] }

encyclopediaSmileysGroup : EncyclopediaEmojiGroup
encyclopediaSmileysGroup = EncyclopediaEmojiGroup { group = "Smileys & Emotion", subgroups = [smilingFaceEmoji ()] }

encyclopediaFlagsGroup : EncyclopediaEmojiGroup
encyclopediaFlagsGroup = EncyclopediaEmojiGroup { group = "Flags", subgroups = [countryFlagEmoji ()] }

@label "Encyclopedia"
@description "Ordinary typed data about living things, countries, writing systems, emoji and programming languages, with sets nested inside the sets that contain them. Each set is also a type."
@tags "encyclopedia" "data" "sets"
encyclopedia : EncyclopediaContents
encyclopedia = EncyclopediaContents { livingThings = encyclopediaLivingThings (), countries = encyclopediaCountrySets (), writing = encyclopediaWriting (), emoji = encyclopediaEmoji (), programmingLanguages = programmingLanguages () }
