module CheckDemo where

using engine (SetExpr)
using set (contains)
using std (some, chars, includes, length, fold)

-- These examples reuse the existing membership judgment. A format checks text
-- shape; it does not deliver email or turn the date/UUID text into a parsed
-- value. The visual editor, live diagnostics and explicit try use the same
-- candidate and the same declared refinement.

@label "Email input"
@description "Text matching Fenel's existing email format. No message is sent."
CheckEmailInput = String | value ∈ format:email

@label "EU date text"
@description "The existing dd/MM/yyyy text pattern. This format example does not establish calendar validity or parse a Date value."
CheckDateInput = String | value ∈ format:date:eu

@label "UUID text"
@description "The existing five-group hexadecimal UUID text pattern. This example checks the format's supported text shape."
CheckUuidInput = String | value ∈ format:uuid

@label "Quantity from one to five"
@description "A numeric input restricted to the inclusive interval from 1 to 5."
CheckQuantityInput = Number | value ∈ [1..5]

@label "Contact input"
@description "A structured candidate with an email and a bounded quantity. The email uses the existing unmasked native widget so invalid text remains visible for correction."
@widget "email" "native"
CheckContactInput = CheckContactInput email: CheckEmailInput quantity: CheckQuantityInput

@label "Membership explanation"
@description "Keep an undecided membership answer distinct from a refused or accepted value. These are value checks, not proof certificates."
checkDemoExplanation : (verdict: Maybe Boolean) -> String
checkDemoExplanation verdict = case verdict of
  Just true -> "This candidate belongs to the displayed constraint."
  Just false -> "This candidate does not belong to the displayed constraint."
  Nothing -> "Membership was not decided."

@label "Check email input"
@description "Enter a bad email, inspect the failing position and next expected text, then correct it. This is a format check; no email is sent."
@tags "demo" "live-check" "format" "email"
checkEmailInput : (candidate: CheckEmailInput) -> ({ candidate: String, constraint: SetExpr, verdict: Maybe Boolean, explanation: String })
checkEmailInput candidate =
  let constraint = SeRef { handle = "format:email" }
  let verdict = set.contains constraint candidate
  { candidate = candidate, constraint = constraint, verdict = verdict, explanation = checkDemoExplanation verdict }

@label "Try a date mask"
@description "Type date digits and let the existing mask insert separators. Complete the text, inspect its format verdict, then try the same candidate again."
@tags "demo" "live-check" "format" "date"
checkDateInput : (candidate: CheckDateInput) -> ({ candidate: String, constraint: SetExpr, verdict: Maybe Boolean, explanation: String })
checkDateInput candidate =
  let constraint = SeRef { handle = "format:date:eu" }
  let verdict = set.contains constraint candidate
  { candidate = candidate, constraint = constraint, verdict = verdict, explanation = checkDemoExplanation verdict }

@label "Try a UUID mask"
@description "Complete the five hexadecimal groups through the existing masked input and inspect the same candidate's format verdict."
@tags "demo" "live-check" "format" "uuid"
checkUuidInput : (candidate: CheckUuidInput) -> ({ candidate: String, constraint: SetExpr, verdict: Maybe Boolean, explanation: String })
checkUuidInput candidate =
  let constraint = SeRef { handle = "format:uuid" }
  let verdict = set.contains constraint candidate
  { candidate = candidate, constraint = constraint, verdict = verdict, explanation = checkDemoExplanation verdict }

@label "Check a quantity"
@description "Try a number outside 1 to 5, then correct it. The same type directs the numeric editor and the membership check."
@tags "demo" "live-check" "number"
checkQuantityInput : (candidate: CheckQuantityInput) -> ({ candidate: Number, constraint: SetExpr, verdict: Maybe Boolean, explanation: String })
checkQuantityInput candidate =
  let constraint = SeInterval { interval = { lo = Just ({ value = 1, inclusive = true }), hi = Just ({ value = 5, inclusive = true }) } }
  let verdict = set.contains constraint candidate
  { candidate = candidate, constraint = constraint, verdict = verdict, explanation = checkDemoExplanation verdict }

@label "Check a structured contact"
@description "Type a malformed email or a quantity outside 1 to 5. Inspect each field's own membership verdict, then correct the same record. No data is saved and no email is sent."
@tags "demo" "live-check" "record" "email" "number"
checkContactInput : (candidate: CheckContactInput) -> ({ candidate: { email: String, quantity: Number }, email: { candidate: String, constraint: SetExpr, verdict: Maybe Boolean, explanation: String }, quantity: { candidate: Number, constraint: SetExpr, verdict: Maybe Boolean, explanation: String } })
checkContactInput candidate =
  let email = checkEmailInput candidate.email
  let quantity = checkQuantityInput candidate.quantity
  { candidate = candidate, email = email, quantity = quantity }

@label "Change the type, change the input"
@description "Open this function's contact input type. Add a field to the temporary type draft, fill in the generated input beside it and inspect the same data. Reset restores the example; nothing is saved or sent."
@tags "demo" "type" "form"
typeFormDemo : (contact: CheckContactInput) -> CheckContactInput
typeFormDemo contact = contact

-- Live hints (demo 10): each refined type below shows one hint per rule while
-- it is typed, from the type alone. A text pattern says "not yet" when typing
-- more can still make it valid and "blocked" when it cannot; any other rule
-- says met or not met. Nothing here is specific to sign-up forms.

@label "Email address"
@description "An email in Fenel's existing email format. While typing, an incomplete address such as test@gmail is not yet valid but not wrong; a character that can never belong, such as ? after the @, is wrong at once."
HintEmail = String | value ∈ format:email

@label "Website address"
@description "A web address in the structured URL format, with named parts (scheme, host, path, query) that are checked as they are typed."
HintUrl = String | value ∈ format:url:structured

@label "Password"
@description "Six rules, each its own hint: at least 8 characters, an uppercase letter, a digit, a special character, no birth year, and no character three times in a row. An example policy, not strength advice; use invented text only."
HintPassword = String | length value >= 8 && containsAnUppercaseLetter value && containsADigit value && containsASpecialCharacter value && containsNoBirthYear value && repeatsNoCharacterThreeTimes value

@label "Contains an uppercase letter"
@description "The text holds at least one ASCII uppercase letter."
containsAnUppercaseLetter : (text: String) -> Bool
containsAnUppercaseLetter text = some (chars text) (\c -> includes (chars "ABCDEFGHIJKLMNOPQRSTUVWXYZ") c)

@label "Contains a digit"
@description "The text holds at least one ASCII digit."
containsADigit : (text: String) -> Bool
containsADigit text = some (chars text) (\c -> includes (chars "0123456789") c)

@label "Contains no spaces"
@description "The text holds no space character."
containsNoSpaces : (text: String) -> Bool
containsNoSpaces text = not (includes (chars text) " ")

@label "Contains a special character"
@description "The text holds at least one character that is not an ASCII letter, a digit or a space."
containsASpecialCharacter : (text: String) -> Bool
containsASpecialCharacter text = some (chars text) (\c -> not (includes (chars "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ") c))

-- A birth year is read one character at a time: 0 nothing yet, 1 after "1",
-- 2 after "2", 3 after "19", 4 after "20", 5 after one more digit, 6 found.
birthYearStart : (character: String) -> Number
birthYearStart character = if character == "1" then 1 else if character == "2" then 2 else 0

birthYearStep : (state: Number) -> (character: String) -> Number
birthYearStep state character =
  let digit = includes (chars "0123456789") character
  if state == 6 then 6
  else if (state == 5) && digit then 6
  else if ((state == 3) || (state == 4)) && digit then 5
  else if (state == 1) && (character == "9") then 3
  else if (state == 2) && (character == "0") then 4
  else birthYearStart character

@label "Contains no birth year"
@description "The text holds no year from 1900 to 2099 written as four digits, as in 1987, 12051987 or 12/05/1987. A date written with a two-digit year is outside this rule."
containsNoBirthYear : (text: String) -> Bool
containsNoBirthYear text = not (fold birthYearStep 0 (chars text) == 6)

HintRunState = HintRunState previous: Maybe String currentRun: Number repeatedTriple: Bool

hintRunStep : (state: HintRunState) -> (character: String) -> HintRunState
hintRunStep state character =
  let same = case state.previous of
    Just previous -> previous == character
    Nothing -> false
  let currentRun = if same then state.currentRun + 1 else 1
  HintRunState { previous = Just character, currentRun = currentRun, repeatedTriple = state.repeatedTriple || currentRun >= 3 }

@label "Repeats no character three times"
@description "The text never holds the same character three times in a row. The same character may return later."
repeatsNoCharacterThreeTimes : (text: String) -> Bool
repeatsNoCharacterThreeTimes text =
  let state = fold hintRunStep (HintRunState { previous = Nothing, currentRun = 0, repeatedTriple = false }) (chars text)
  not state.repeatedTriple

@label "Adult age"
@description "An age from 18 to 150."
AdultAge = Number | value ∈ [18..150]

@label "Person"
@description "A name and an age."
HintPerson = HintPerson name: String age: Number

@label "Adult"
@description "A person aged 18 or more: the rule is on the whole record, so the record itself shows the hint."
AdultPerson = HintPerson | value.age >= 18

@label "Sign-up draft"
@description "Type each field and watch its rules: the email, the website's parts, each password rule, and the adult rule on the whole person. Nothing is saved or sent."
@widget "email" "native"
@widget "website" "native"
@widget "password" "native"
SignUpDraft = SignUpDraft email: HintEmail website: HintUrl password: HintPassword person: AdultPerson

@label "Check a sign-up"
@description "Fill in a sign-up draft field by field. Each refined field shows its rules live: what is met, what can still be met by typing more, and what can no longer be met. Nothing is saved or sent."
@tags "demo" "live-check" "record" "email" "password" "url"
checkSignUp : (draft: SignUpDraft) -> SignUpDraft
checkSignUp draft = draft

-- Starting candidates are source-owned data, including invalid and incomplete
-- drafts so visitors can watch a correction rather than only inspect success.
checkDemoStartingInputs : List ({ function: Any, arguments: List Any })
checkDemoStartingInputs = [
  { function = checkEmailInput, arguments = ["rom@usefenel!.com"] },
  { function = checkDateInput, arguments = ["25/12/202"] },
  { function = checkUuidInput, arguments = ["123e4567-e89b-12d3-a456-42661417400"] },
  { function = checkQuantityInput, arguments = [6] },
  { function = checkContactInput, arguments = [{ email = "rom@usefenel!.com", quantity = 6 }] },
  { function = typeFormDemo, arguments = [{ email = "hello@usefenel.com", quantity = 2 }] },
  { function = checkSignUp, arguments = [{ email = "test@gmail", website = "https://usefenel", password = "abc", person = { name = "Ada", age = 17 } }] }
]
