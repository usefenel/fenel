module UtilityDemo where

using std (Color, Spectrum, SpectralObserverBand, SpectralRgbProfile, SpectralRgb, SpectralTransmission, RgbaPixel, Image, colorAdmitted, colorFromHertz, humanSpectrumColorType, humanSpectrumColor, monochromaticSpectrum, addSpectra, blendSpectra, rgbToSpectrum, hslToSpectrum, spectrumToRgb, filterSpectrum, isString, length, slice, chars, all, contains, upper, join, toNumber, numberToHex, numberIsFinite, not, round)
using picture (lerpColor, solid, render)
using ImageDemo (imageMatrixColorAdmitted)

-- Color is a positive finite Hz number, Spectrum independent weighted lines.
-- RGB/HSL use explicit primary models and never invent one frequency for a
-- mixture. Alpha survives only in the separate raster encoding recipes below.
-- All examples are ordinary source data through the shared Call and lenses.

@label "Frequency Color and vacuum wavelength"
FrequencyColorResult = FrequencyColorResult frequencyHz: Color vacuumWavelengthNm: Number

@label "Color from a frequency"
@description "Admit a supplied frequency from 1 through 1000000000000000000 hertz as Color, alongside its vacuum wavelength in nanometres using c = 299792458 metres per second. This convenience range belongs to the operation, not Color's definition. Number approximation remains visible."
frequencyColor : (frequencyHz: Number) -> Result String FrequencyColorResult
frequencyColor frequencyHz =
  if not (colorAdmitted frequencyHz && frequencyHz >= 1 && frequencyHz <= 1000000000000000000) then Err "Use a finite frequency from 1 through 1000000000000000000 hertz."
  else case colorFromHertz frequencyHz of
    Err problem -> Err problem
    Ok frequency -> Ok (FrequencyColorResult { frequencyHz = frequency, vacuumWavelengthNm = 299792458000000000 / frequency })

@label "Declared human-spectrum Color result"
HumanSpectrumColorResult = HumanSpectrumColorResult band: SpectralObserverBand frequencyHz: Color type: Type

@label "Color in its authored observer band"
@description "The frequency field derives its numeric subtype from this same record's band. The function input remains a named ground record; ordinary FieldRenderer sibling context owns the dependent field."
HumanSpectrumColorInput = HumanSpectrumColorInput band: SpectralObserverBand frequencyHz: humanSpectrumColorType band

@label "Color in a declared human band"
@description "The frequency's numeric input type depends on this authored observer band. Retain the model, Color and derived Type. The starting band is illustrative data, not a universal biological visibility boundary."
observerBandColor : (input: HumanSpectrumColorInput) -> Result String HumanSpectrumColorResult
observerBandColor input = case humanSpectrumColor input.band input.frequencyHz of
  Err problem -> Err problem
  Ok frequency -> Ok (HumanSpectrumColorResult { band = input.band, frequencyHz = frequency, type = humanSpectrumColorType input.band })

@label "Add two spectral lines"
@description "Add finite positive frequencies with nonnegative relative weights. Equal frequencies sum weights; different frequencies remain separate. Zero weights disappear. No frequency averaging or opacity field."
addFrequencySpectra : (firstHz: Number) -> (firstWeight: Number) -> (secondHz: Number) -> (secondWeight: Number) -> Result String Spectrum
addFrequencySpectra firstHz firstWeight secondHz secondWeight = case monochromaticSpectrum firstHz firstWeight of
  Err problem -> Err problem
  Ok first -> case monochromaticSpectrum secondHz secondWeight of
    Err problem -> Err problem
    Ok second -> addSpectra first second

@label "Blend spectral lines with opacity"
@description "An explicit opacity from 0 through 1 weights foreground and background contributions. Different frequencies stay distinct. Frequencies need finite positive Hz and weights need finite nonnegative numbers."
blendFrequencySpectra : (foregroundHz: Number) -> (foregroundWeight: Number) -> (backgroundHz: Number) -> (backgroundWeight: Number) -> (opacity: Number) -> Result String Spectrum
blendFrequencySpectra foregroundHz foregroundWeight backgroundHz backgroundWeight opacity = case monochromaticSpectrum foregroundHz foregroundWeight of
  Err problem -> Err problem
  Ok foreground -> case monochromaticSpectrum backgroundHz backgroundWeight of
    Err problem -> Err problem
    Ok background -> blendSpectra foreground background opacity

@label "RGB coordinates to a spectrum"
@description "Supply three distinct primary frequencies and finite linear RGB coefficients from 0 through 1. White retains three contributions; purple retains red/blue contributions. No standard measured primary spectra or single-frequency inverse are invented."
rgbSpectrum : (profile: SpectralRgbProfile) -> (red: Number) -> (green: Number) -> (blue: Number) -> Result String Spectrum
rgbSpectrum profile red green blue = rgbToSpectrum profile red green blue

@label "HSL coordinates to a spectrum"
@description "Use an explicit primary profile, hue degrees from 0 through 360 and saturation/lightness from 0 through 1. White, grey and purple remain mixtures of the profile's frequencies. This is the declared coordinate model, not calibrated colourimetry."
hslSpectrum : (profile: SpectralRgbProfile) -> (hueDegrees: Number) -> (saturation: Number) -> (lightness: Number) -> Result String Spectrum
hslSpectrum profile hueDegrees saturation lightness = hslToSpectrum profile hueDegrees saturation lightness

@label "Explicit primary transmission filter"
@description "Build RGB-derived spectral data, then multiply each primary's contribution by its declared transmission from 0 through 1. This finite subtractive transmission model makes no pigment, ink or calibrated-material claim."
filterPrimarySpectrum : (profile: SpectralRgbProfile) -> (red: Number) -> (green: Number) -> (blue: Number) -> (redTransmission: Number) -> (greenTransmission: Number) -> (blueTransmission: Number) -> Result String Spectrum
filterPrimarySpectrum profile red green blue redTransmission greenTransmission blueTransmission = case rgbToSpectrum profile red green blue of
  Err problem -> Err problem
  Ok spectrum -> filterSpectrum spectrum [SpectralTransmission { frequency = profile.red, transmission = redTransmission }, SpectralTransmission { frequency = profile.green, transmission = greenTransmission }, SpectralTransmission { frequency = profile.blue, transmission = blueTransmission }]

@label "Spectrum and declared raster projection"
@description "Keep the exact profile and weighted Spectrum beside a partial RGB-coordinate projection and separate opaque raster encoding. Byte rounding loses coordinate precision; no frequency is reconstructed from bytes."
SpectralPreview = SpectralPreview profile: SpectralRgbProfile spectrum: Spectrum coordinates: SpectralRgb rasterPixel: RgbaPixel swatch: Image explanation: String

@label "Preview a spectrum in its declared RGB basis"
@description "Only contributing frequencies in the supplied primary basis project; coefficients outside 0 through 1 refuse without clipping. Retain source Spectrum beside rounded opaque RGBA bytes and an Image. This displays model coordinates, not calibrated human spectral appearance."
previewSpectrum : (profile: SpectralRgbProfile) -> (spectrum: Spectrum) -> Result String SpectralPreview
previewSpectrum profile spectrum = case spectrumToRgb profile spectrum of
  Err problem -> Err problem
  Ok coordinates ->
    let pixel = RgbaPixel { r = round (255 * coordinates.red), g = round (255 * coordinates.green), b = round (255 * coordinates.blue), a = 255 }
    Ok (SpectralPreview { profile = profile, spectrum = spectrum, coordinates = coordinates, rasterPixel = pixel, swatch = render (solid pixel) 32 16, explanation = "Spectrum retains the supplied frequencies and weights. The profile declares which frequencies its RGB coordinates weight. Image is a rounded opaque raster encoding of those coordinates, not a measured spectral-to-human-display conversion or a reversible spectrum/RGB encoding." })

@label "Preview RGB-derived spectral data"
@description "Compose RGB coefficients and an explicitly declared primary profile with retained Spectrum data and a partial rounded raster projection. The starting profile is illustrative, not measured sRGB."
previewRgbSpectrum : (profile: SpectralRgbProfile) -> (red: Number) -> (green: Number) -> (blue: Number) -> Result String SpectralPreview
previewRgbSpectrum profile red green blue = case rgbToSpectrum profile red green blue of
  Err problem -> Err problem
  Ok spectrum -> previewSpectrum profile spectrum

@label "Preview HSL-derived spectral data"
@description "Compose HSL coordinates in the supplied profile with retained weighted spectral data and a rounded opaque raster projection. This is an explicit coordinate model, not calibrated colourimetry."
previewHslSpectrum : (profile: SpectralRgbProfile) -> (hueDegrees: Number) -> (saturation: Number) -> (lightness: Number) -> Result String SpectralPreview
previewHslSpectrum profile hueDegrees saturation lightness = case hslToSpectrum profile hueDegrees saturation lightness of
  Err problem -> Err problem
  Ok spectrum -> previewSpectrum profile spectrum

-- Explicit RGBA raster encoding helpers; these do not define frequency Color.

utilityColorHexAdmitted : (text: String) -> Bool
utilityColorHexAdmitted text =
  if not (isString text) then false
  else
    let size = length text
    if not (size == 4 || size == 5 || size == 7 || size == 9) then false
    else slice text 0 1 == "#" && all (chars (slice text 1 size)) (\digit -> contains "0123456789ABCDEFabcdef" digit)

utilityColorExpandHex : (digits: String) -> String
utilityColorExpandHex digits =
  let size = length digits
  if size == 3 || size == 4 then
    let red = slice digits 0 1
    let green = slice digits 1 2
    let blue = slice digits 2 3
    let alpha = if size == 4 then slice digits 3 4 else "F"
    join [red, red, green, green, blue, blue, alpha, alpha] ""
  else if size == 6 then join [digits, "FF"] ""
  else digits

-- Called only after the complete ASCII hex syntax is admitted and expanded.
-- Each two-digit 0x string denotes one exact byte through the existing Number
-- representation; no permissive parse, rounding or clipping reaches the result.
utilityColorHexByte : (digits: String) -> (offset: Number) -> Number
utilityColorHexByte digits offset = toNumber (join ["0x", slice digits offset (offset + 2)] "")

@label "Hex to RGBA raster pixel"
@description "Read exactly #RGB, #RGBA, #RRGGBB or #RRGGBBAA, with ASCII hexadecimal digits in either case. Short digits expand twice; missing alpha is 255. Whitespace, names, missing #, other lengths and malformed digits return Err. The result is the existing RgbaPixel with exact whole RGBA bytes. This is a raster encoding, separate from frequency Color and Spectrum."
@tags "utility" "colour" "hex" "parser"
rgbaFromHex : (text: String) -> Result String RgbaPixel
rgbaFromHex text =
  if not (utilityColorHexAdmitted text) then Err "Use #RGB, #RGBA, #RRGGBB or #RRGGBBAA with hexadecimal digits and no whitespace."
  else
    let digits = utilityColorExpandHex (upper (slice text 1 (length text)))
    Ok (RgbaPixel { r = utilityColorHexByte digits 0, g = utilityColorHexByte digits 2, b = utilityColorHexByte digits 4, a = utilityColorHexByte digits 6 })

@label "RGBA raster pixel to hex"
@description "Write the existing RgbaPixel as uppercase #RRGGBBAA, always retaining alpha. Each channel must be a whole finite byte from 0 through 255; malformed, fractional or out-of-range channels return Err without clipping. Parsing this result restores exactly the same RGBA bytes."
@tags "utility" "colour" "hex" "format"
rgbaToHex : (pixel: RgbaPixel) -> Result String String
rgbaToHex pixel =
  if not (imageMatrixColorAdmitted pixel) then Err "Every RgbaPixel needs whole r, g, b and a channels from 0 through 255."
  else Ok (join ["#", numberToHex pixel.r 2, numberToHex pixel.g 2, numberToHex pixel.b 2, numberToHex pixel.a 2] "")

@label "Interpolate RGBA raster bytes"
@description "Interpolate the existing encoded RGBA byte channels: amount 0 returns first, amount 1 returns second. Require whole finite input bytes and a finite amount from 0 through 1. Reuse picture.lerpColor's nearest-byte rounding, with half bytes rounded upward. This is channel interpolation, without linear-light conversion, premultiplied alpha or source-over compositing or spectral mixing. Invalid inputs return Err instead of clipping."
@tags "utility" "colour" "mix"
mixRgbaPixels : (first: RgbaPixel) -> (second: RgbaPixel) -> (amount: Number) -> Result String RgbaPixel
mixRgbaPixels first second amount =
  if not (imageMatrixColorAdmitted first && imageMatrixColorAdmitted second) then Err "Both raster pixels need whole r, g, b and a channels from 0 through 255."
  else if not (numberIsFinite amount && amount >= 0 && amount <= 1) then Err "Use a finite mixing amount from 0 through 1."
  else Ok (lerpColor first second amount)

@label "RgbaPixel data and swatch"
@description "The existing RgbaPixel bytes, their exact uppercase alpha-retaining hex spelling, and a 32 by 16 Image made from that same RgbaPixel through Picture."
RgbaPreview = RgbaPreview pixel: RgbaPixel hex: String swatch: Image

@label "Preview an RGBA raster pixel"
@description "Inspect ordinary RgbaPixel data, its exact #RRGGBBAA spelling and a small Image swatch through the shared data lenses. Whole RGBA bytes are required; no channel is clipped. The swatch keeps the same alpha, so a transparent RgbaPixel stays transparent."
@tags "utility" "colour" "image" "data"
previewRgba : (pixel: RgbaPixel) -> Result String RgbaPreview
previewRgba pixel = case rgbaToHex pixel of
  Err reason -> Err reason
  Ok hex -> Ok (RgbaPreview { pixel = pixel, hex = hex, swatch = render (solid pixel) 32 16 })

@label "Preview a hex raster encoding"
@description "Parse #RGB, #RGBA, #RRGGBB or #RRGGBBAA, then inspect the same RgbaPixel, exact alpha-retaining hex spelling and small Image swatch. Malformed text returns Err; alpha is preserved."
@tags "utility" "colour" "hex" "image" "composed"
previewHexRgba : (text: String) -> Result String RgbaPreview
previewHexRgba text = case rgbaFromHex text of
  Err reason -> Err reason
  Ok pixel -> previewRgba pixel


@label "Illustrative primary profile"
@description "Declared example primaries at 460, 550 and 700 terahertz. Illustrative source data, not measured standard sRGB spectra or a calibrated display/observer."
utilitySpectralProfile : SpectralRgbProfile
utilitySpectralProfile = SpectralRgbProfile { name = "Illustrative monochromatic primaries, not measured sRGB", red = 460000000000000, green = 550000000000000, blue = 700000000000000 }

@label "Illustrative authored observer band"
@description "An authored 400-through-790-terahertz interval for dependent input. Explicit illustrative model data, not a universal visibility limit."
utilityHumanBand : SpectralObserverBand
utilityHumanBand = SpectralObserverBand { name = "Illustrative authored human observer band", lowerHz = 400000000000000, upperHz = 790000000000000 }

@label "Colour, spectrum and raster tools"
@description "Use frequency Color, independently weighted spectra, explicit observer/primary models and composition opacity. RGB/HSL produce spectra; hex/RGBA remains separate raster encoding data."
colorTools : {
  frequencyColor: (frequencyHz: Number) -> Result String FrequencyColorResult,
  observerBandColor: (input: HumanSpectrumColorInput) -> Result String HumanSpectrumColorResult,
  addFrequencySpectra: (firstHz: Number) -> (firstWeight: Number) -> (secondHz: Number) -> (secondWeight: Number) -> Result String Spectrum,
  blendFrequencySpectra: (foregroundHz: Number) -> (foregroundWeight: Number) -> (backgroundHz: Number) -> (backgroundWeight: Number) -> (opacity: Number) -> Result String Spectrum,
  rgbSpectrum: (profile: SpectralRgbProfile) -> (red: Number) -> (green: Number) -> (blue: Number) -> Result String Spectrum,
  hslSpectrum: (profile: SpectralRgbProfile) -> (hueDegrees: Number) -> (saturation: Number) -> (lightness: Number) -> Result String Spectrum,
  filterPrimarySpectrum: (profile: SpectralRgbProfile) -> (red: Number) -> (green: Number) -> (blue: Number) -> (redTransmission: Number) -> (greenTransmission: Number) -> (blueTransmission: Number) -> Result String Spectrum,
  previewRgbSpectrum: (profile: SpectralRgbProfile) -> (red: Number) -> (green: Number) -> (blue: Number) -> Result String SpectralPreview,
  previewHslSpectrum: (profile: SpectralRgbProfile) -> (hueDegrees: Number) -> (saturation: Number) -> (lightness: Number) -> Result String SpectralPreview,
  rgbaFromHex: (text: String) -> Result String RgbaPixel,
  rgbaToHex: (pixel: RgbaPixel) -> Result String String,
  mixRgbaPixels: (first: RgbaPixel) -> (second: RgbaPixel) -> (amount: Number) -> Result String RgbaPixel,
  previewRgba: (pixel: RgbaPixel) -> Result String RgbaPreview,
  previewHexRgba: (text: String) -> Result String RgbaPreview
}
colorTools = { frequencyColor = frequencyColor, observerBandColor = observerBandColor, addFrequencySpectra = addFrequencySpectra, blendFrequencySpectra = blendFrequencySpectra, rgbSpectrum = rgbSpectrum, hslSpectrum = hslSpectrum, filterPrimarySpectrum = filterPrimarySpectrum, previewRgbSpectrum = previewRgbSpectrum, previewHslSpectrum = previewHslSpectrum, rgbaFromHex = rgbaFromHex, rgbaToHex = rgbaToHex, mixRgbaPixels = mixRgbaPixels, previewRgba = previewRgba, previewHexRgba = previewHexRgba }

utilityColorStartingInputs : List ({ function: Any, arguments: List Any })
utilityColorStartingInputs = [
  { function = frequencyColor, arguments = [550000000000000] },
  { function = observerBandColor, arguments = [HumanSpectrumColorInput { band = utilityHumanBand (), frequencyHz = 550000000000000 }] },
  { function = addFrequencySpectra, arguments = [460000000000000, 0.7, 700000000000000, 0.3] },
  { function = blendFrequencySpectra, arguments = [460000000000000, 1, 700000000000000, 1, 0.25] },
  { function = rgbSpectrum, arguments = [utilitySpectralProfile (), 1, 0, 1] },
  { function = hslSpectrum, arguments = [utilitySpectralProfile (), 0, 0, 1] },
  { function = filterPrimarySpectrum, arguments = [utilitySpectralProfile (), 1, 1, 1, 1, 0.5, 0] },
  { function = previewRgbSpectrum, arguments = [utilitySpectralProfile (), 1, 0, 1] },
  { function = previewHslSpectrum, arguments = [utilitySpectralProfile (), 120, 1, 0.5] },
  { function = rgbaFromHex, arguments = ["#3B82F6CC"] },
  { function = rgbaToHex, arguments = [RgbaPixel { r = 59, g = 130, b = 246, a = 204 }] },
  { function = mixRgbaPixels, arguments = [RgbaPixel { r = 239, g = 68, b = 68, a = 255 }, RgbaPixel { r = 59, g = 130, b = 246, a = 255 }, 0.5] },
  { function = previewRgba, arguments = [RgbaPixel { r = 59, g = 130, b = 246, a = 255 }] },
  { function = previewHexRgba, arguments = ["#fa3"] }
]
