module StatisticsDemo where

using std (fold, map, filter, find, head, length, min, max, all, unique, concat, appendItem, numberIsFinite, floor, isArray)
using picture (Point)
using DrawingDemo (PointLineChart, PointLineChartRefused, pointLineChart)

-- Statistics are Fenel bodies; std's bodyless sum and avg are not used.
-- This bounded browser-local example recomputes inside Call. It is not a stored
-- reactive dependency graph. Charts present data; they do not compute it.

@label "Total numbers"
@description "A Fenel left fold adds the supplied values, starting at zero."
statisticsTotal : (values: List Number) -> Number
statisticsTotal values = fold (\total value -> total + value) 0 values

statisticsEmptySummary : NumberSummary
statisticsEmptySummary = NumberSummary { count = 0, total = 0, average = Nothing, minimum = Nothing, maximum = Nothing }

@label "Summarize numbers"
@description "Count, total and optional average/minimum/maximum. Empty data returns zero count and total, with Nothing for each undefined statistic."
summarizeNumbers : (values: List Number) -> NumberSummary
summarizeNumbers values = case head values of
  Nothing -> statisticsEmptySummary ()
  Just first ->
    let count = length values
    let total = statisticsTotal values
    NumberSummary { count = count, total = total, average = Just (total / count), minimum = Just (fold min first values), maximum = Just (fold max first values) }

statisticsNumberAdmitted : (value: Number) -> Bool
statisticsNumberAdmitted value = numberIsFinite value && value >= -1000000 && value <= 1000000

statisticsPointStep : (acc: StatisticsPointAccumulator) -> (value: Number) -> StatisticsPointAccumulator
statisticsPointStep acc value = StatisticsPointAccumulator { nextIndex = acc.nextIndex + 1, points = appendItem { x = acc.nextIndex, y = value } acc.points }

@label "Number chart points"
@description "Preserve input order and values, using a one-based sample index for the horizontal coordinate."
statisticsNumberPoints : (values: List Number) -> List Point
statisticsNumberPoints values =
  let start = StatisticsPointAccumulator { nextIndex = 1, points = [] }
  let finished = fold statisticsPointStep start values
  finished.points

statisticsNumberResult : (values: List Number) -> NumberStatistics
statisticsNumberResult values = NumberStatistics { values = values, summary = summarizeNumbers values, chart = pointLineChart (statisticsNumberPoints values), explanation = "Fenel fold computes count, total and optional average/minimum/maximum. The chart plots each original value by its one-based position. Open Call, then edit the input to recompute; no data is saved." }

@label "Statistics from numbers"
@description "Open Call, then edit a number list to recompute. Inspect its Fenel summary and the same data as a typed chart. At most 64 finite numbers from -1000000 through 1000000 are admitted."
@tags "demo" "statistics" "numbers" "chart"
numberStatistics : (values: List Number) -> NumberStatistics
numberStatistics values =
  if isArray values && length values <= 64 && all values statisticsNumberAdmitted then statisticsNumberResult values
  else NumberStatisticsRefused { reason = "Use at most 64 finite numbers between -1000000 and 1000000." }

@label "Chart numbers"
@description "Present the same admitted number data through the existing PointLineChart lens. Open Call, then edit the numbers to update the chart; refusals retain their reason."
@tags "demo" "statistics" "numbers" "chart"
numberChart : (values: List Number) -> PointLineChart
numberChart values = case numberStatistics values of
  NumberStatistics { chart = chart } -> chart
  NumberStatisticsRefused { reason = reason } -> PointLineChartRefused { reason = reason }

statisticsPurchaseAmountAdmitted : (purchase: StatisticsPurchase) -> Bool
statisticsPurchaseAmountAdmitted purchase = numberIsFinite purchase.amountCents && purchase.amountCents >= 0 && purchase.amountCents <= 1000000 && floor purchase.amountCents == purchase.amountCents

statisticsCustomerIds : (customers: List StatisticsCustomer) -> List String
statisticsCustomerIds customers = map (\customer -> customer.id) customers

statisticsPurchaseIds : (purchases: List StatisticsPurchase) -> List String
statisticsPurchaseIds purchases = unique (map (\purchase -> purchase.customerId) purchases)

statisticsHasCustomer : (customers: List StatisticsCustomer) -> (id: String) -> Bool
statisticsHasCustomer customers id = case find (\customer -> customer.id == id) customers of
  Nothing -> false
  Just customer -> true

statisticsCustomerName : (customers: List StatisticsCustomer) -> (id: String) -> Maybe String
statisticsCustomerName customers id = case find (\customer -> customer.id == id) customers of
  Nothing -> Nothing
  Just customer -> Just customer.name

@label "Group customer purchases"
@description "Select one customer id's purchases, then derive count and cents from the same Fenel number summary. A customer with no purchases has count/total zero and Nothing average."
statisticsCustomerSummary : (customers: List StatisticsCustomer) -> (purchases: List StatisticsPurchase) -> (id: String) -> CustomerPurchaseSummary
statisticsCustomerSummary customers purchases id =
  let selected = filter (\purchase -> purchase.customerId == id) purchases
  let summary = summarizeNumbers (map (\purchase -> purchase.amountCents) selected)
  CustomerPurchaseSummary { customerId = id, customerName = statisticsCustomerName customers id, count = summary.count, totalCents = summary.total, averageCents = summary.average }

@label "Purchase breakdown"
@description "For admitted inputs with unique customer ids, keep supplied customers in input order, then unknown purchaser ids in first-purchase order. Every purchase belongs to exactly one group."
statisticsPurchaseBreakdown : (customers: List StatisticsCustomer) -> (purchases: List StatisticsPurchase) -> List CustomerPurchaseSummary
statisticsPurchaseBreakdown customers purchases =
  let known = statisticsCustomerIds customers
  let unknown = filter (\id -> not (statisticsHasCustomer customers id)) (statisticsPurchaseIds purchases)
  map (statisticsCustomerSummary customers purchases) (concat known unknown)

statisticsPurchaseResult : (customers: List StatisticsCustomer) -> (purchases: List StatisticsPurchase) -> PurchaseStatistics
statisticsPurchaseResult customers purchases = PurchaseStatistics { customers = customers, purchases = purchases, summary = summarizeNumbers (map (\purchase -> purchase.amountCents) purchases), breakdown = statisticsPurchaseBreakdown customers purchases, explanation = "Counts, totals and averages use each supplied purchase's whole cents. Supplied customers with no purchases remain with zero totals; unknown ids remain with no name. Open Call, then edit the data to recompute; no storage is read or written." }

statisticsPurchasesAdmitted : (customers: List StatisticsCustomer) -> (purchases: List StatisticsPurchase) -> Bool
statisticsPurchasesAdmitted customers purchases = isArray customers && isArray purchases && length customers <= 64 && length purchases <= 64 && length (unique (statisticsCustomerIds customers)) == length customers && all purchases statisticsPurchaseAmountAdmitted

@label "Statistics from purchases"
@description "Open Call, then change typed customer and purchase rows to recompute. Counts, total cents and average cents update together with the per-customer breakdown. Up to 64 customers and 64 purchases; customer ids must be unique."
@tags "demo" "statistics" "customers" "purchases"
purchaseStatistics : (customers: List StatisticsCustomer) -> (purchases: List StatisticsPurchase) -> PurchaseStatistics
purchaseStatistics customers purchases =
  if statisticsPurchasesAdmitted customers purchases then statisticsPurchaseResult customers purchases
  else PurchaseStatisticsRefused { reason = "Use at most 64 customers with unique ids and 64 purchases with whole amounts from 0 through 1000000 cents." }

@label "Customer purchase table data"
@description "The same admitted per-customer breakdown as an ordinary typed list inside Ok, ready for the shared table lens. Err retains the input refusal."
@tags "demo" "statistics" "customers" "table"
customerBreakdown : (customers: List StatisticsCustomer) -> (purchases: List StatisticsPurchase) -> Result String (List CustomerPurchaseSummary)
customerBreakdown customers purchases = case purchaseStatistics customers purchases of
  PurchaseStatistics { breakdown = rows } -> Ok rows
  PurchaseStatisticsRefused { reason = reason } -> Err reason
