module RecipeFunctions where

using std (eq, find, head, tail, fromMaybe, map, concat, filter, length, some, not)
using engine (ReifyOutcome, RecipeAnalysisSnapshot, RecipeExtraction, RecipeRefusal, RecipeClaimContext, RecipeClaim, RecipeThresholdClaim, RecipeCountRange, RecipeKindSpread, RecipeAlternative, RecipeAlternativeFood, RecipeFamilyMember, RecipeFoodDistance, RecipeFamilyScope, RecipeFamilyClaim, RecipeFamilyScopes, RecipeConstraint, RecipeCriteriaGate, RecipeCardAnalysis)
using prover (EpistemicStatus)

-- These questions concern sets of successful pantries and preparations. The
-- existing symbolic proposer and checker establish them from the recipe's
-- expression. This module does not tabulate a recipe over pantry subsets.
-- The card's first row is the one call of the recipe on the canonical full
-- pantry. That return is not a symbolic claim and it does not try any other
-- pantry. Family and distance source/captures remain explicit alongside the
-- recipe snapshot. Their constructor rows begin unknown: arbitrary callbacks
-- are never executed as an analysis shortcut. The engine must check source
-- application before turning a missing membership/distance into a definite fact.

-- A4 forwards enter the existing engine harness from the public profile,
-- which omits executable engine functions. These declarations contain no
-- analysis policy; the source-owned engine proposer/checker remains canonical.
@native
@category "engine-internal"
proposeRecipeAnalysis : (snapshot: RecipeAnalysisSnapshot) -> (budget: Nat) -> RecipeExtraction

@native
@category "engine-internal"
recipeCriteriaGuaranteed : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (budget: Nat) -> RecipeClaim (List Nat)

@native
@category "engine-internal"
recipeCriteriaNecessary : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (budget: Nat) -> RecipeClaim (List Nat)

@native
@category "engine-internal"
recipeCriteriaRequiredFamily : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (members: List RecipeFamilyMember) -> (assumptions: List ReifyOutcome) -> (budget: Nat) -> RecipeClaim Bool

@native
@category "engine-internal"
recipeCriteriaFamilies : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (subjects: List a) -> (scope: RecipeFamilyScope) -> (budget: Nat) -> List (RecipeFamilyClaim a)

@native
@category "engine-internal"
recipeCriteriaKOfN : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (ranks: List Nat) -> (threshold: Nat) -> (budget: Nat) -> RecipeThresholdClaim

@native
@category "engine-internal"
recipeCriteriaCountRange : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (budget: Nat) -> RecipeClaim (RecipeCountRange Nat)

@native
@category "engine-internal"
recipeCriteriaKindSpread : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (distances: List RecipeFoodDistance) -> (assumptions: List ReifyOutcome) -> (budget: Nat) -> RecipeClaim (RecipeKindSpread Nat)

@native
@category "engine-internal"
recipeCriteriaSubstitutes : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (budget: Nat) -> RecipeClaim (List (RecipeAlternative Nat))

@native
@category "engine-internal"
recipeCriteriaStrictlyOptional : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (rank: Nat) -> (budget: Nat) -> RecipeClaim Bool

-- One checked analysis per call, over a pantry set; the `…In` forwards read
-- every criterion from that one gate.
@native
@category "engine-internal"
recipeCriteriaPrepare : (snapshot: RecipeAnalysisSnapshot) -> (proposal: RecipeExtraction) -> (pantries: RecipeConstraint) -> (budget: Nat) -> RecipeCriteriaGate

@native
@category "engine-internal"
recipeCriteriaGuaranteedIn : (gate: RecipeCriteriaGate) -> (budget: Nat) -> RecipeClaim (List Nat)

@native
@category "engine-internal"
recipeCriteriaNecessaryIn : (gate: RecipeCriteriaGate) -> (budget: Nat) -> RecipeClaim (List Nat)

@native
@category "engine-internal"
recipeCriteriaRequiredFamilyIn : (gate: RecipeCriteriaGate) -> (members: List RecipeFamilyMember) -> (assumptions: List ReifyOutcome) -> (budget: Nat) -> RecipeClaim Bool

@native
@category "engine-internal"
recipeCriteriaFamiliesIn : (gate: RecipeCriteriaGate) -> (subjects: List a) -> (scope: RecipeFamilyScope) -> (budget: Nat) -> List (RecipeFamilyClaim a)

@native
@category "engine-internal"
recipeCriteriaFamiliesSharedIn : (gate: RecipeCriteriaGate) -> (subjects: List a) -> (necessary: RecipeClaim (List Nat)) -> (guaranteed: RecipeClaim (List Nat)) -> (budget: Nat) -> RecipeFamilyScopes a

-- A card in two stages: the pantry-independent analysis of one snapshot
-- (computed once per reader observation), then the pantry set's verdicts.
@native
@category "engine-internal"
recipeCardAnalysis : (snapshot: RecipeAnalysisSnapshot) -> (budget: Nat) -> RecipeCardAnalysis

@native
@category "engine-internal"
recipeCriteriaPrepareFromAnalysis : (analysis: RecipeCardAnalysis) -> (pantries: RecipeConstraint) -> (budget: Nat) -> RecipeCriteriaGate

@native
@category "engine-internal"
recipeCriteriaFamiliesFromAnalysis : (gate: RecipeCriteriaGate) -> (analysis: RecipeCardAnalysis) -> (subjects: List a) -> (necessary: RecipeClaim (List Nat)) -> (guaranteed: RecipeClaim (List Nat)) -> (budget: Nat) -> RecipeFamilyScopes a

@native
@category "engine-internal"
recipeCriteriaKOfNIn : (gate: RecipeCriteriaGate) -> (ranks: List Nat) -> (threshold: Nat) -> (budget: Nat) -> RecipeThresholdClaim

@native
@category "engine-internal"
recipeCriteriaCountRangeIn : (gate: RecipeCriteriaGate) -> (budget: Nat) -> RecipeClaim (RecipeCountRange Nat)

@native
@category "engine-internal"
recipeCriteriaKindSpreadIn : (gate: RecipeCriteriaGate) -> (distances: List RecipeFoodDistance) -> (assumptions: List ReifyOutcome) -> (budget: Nat) -> RecipeClaim (RecipeKindSpread Nat)

@native
@category "engine-internal"
recipeCriteriaSubstitutesIn : (gate: RecipeCriteriaGate) -> (budget: Nat) -> RecipeClaim (List (RecipeAlternative Nat))

@native
@category "engine-internal"
recipeCriteriaStrictlyOptionalIn : (gate: RecipeCriteriaGate) -> (rank: Nat) -> (budget: Nat) -> RecipeClaim Bool

@label "Guaranteed foods result"
GuaranteedFoodsResult = RecipeClaim (List Food) | if true then true else true

@label "Necessary foods result"
NecessaryFoodsResult = RecipeClaim (List Food) | if true then true else true

@label "Required family result"
RequiredFamilyResult = RecipeClaim Bool | if true then true else true

@description "A subject and its ordinary food predicate. Exact foods, classifications and nutrient-derived families share the checked analysis."
RecipeFamilySubject a = RecipeFamilySubject subject: a predicate: (Food -> Maybe Bool)

@label "Recipe category requirements"
@description "The most specific established categories, plus every checked finding including negative and unknown results. Empty established categories alone do not mean no category is required. Pantry and preparation scopes are separate."
RecipeCategoryRequirements = RecipeCategoryRequirements scope: RecipeFamilyScope mostSpecificEstablished: List FoodCategory findings: List (RecipeFamilyClaim FoodCategory) facts: FoodFactSnapshot

@label "Recipe threshold result"
RecipeThresholdResult = RecipeThresholdClaim | if true then true else true

@label "Preparation count range result"
RecipeCountRangeResult = RecipeClaim (RecipeCountRange Food) | if true then true else true

@label "Preparation kind spread result"
RecipeKindSpreadResult = RecipeClaim (RecipeKindSpread Food) | if true then true else true

@label "Conditional recipe alternatives result"
RecipeSubstitutesResult = RecipeClaim (List (RecipeAlternative Food)) | if true then true else true

AppearingFoodsResult = RecipeClaim (List Food) | if true then true else true

@label "Strictly optional food result"
RecipeOptionalResult = RecipeClaim Bool | if true then true else true

recipeAnalysisBudget : Nat
recipeAnalysisBudget = 16384

@label "Foods to choose from"
@description "The lists of foods the facts of a recipe consider: every list of foods, or every list drawn from these foods. Each fact of a recipe holds for every list of this set."
@fieldLabel "SubsetsOf.pantry" "Foods"
PantrySet = AllPantries | SubsetsOf pantry: Pantry

-- The set in the analysis's own rank language: a pantry drawn from P holds
-- no food outside P. A non-canonical pantry is refused, never repaired.
recipePantryConstraint : (snapshot: RecipeAnalysisSnapshot) -> (pantries: PantrySet) -> Result RecipeRefusal RecipeConstraint
recipePantryConstraint snapshot pantries = case pantries of
  AllPantries -> Ok RcAll
  SubsetsOf { pantry = pantry } ->
    if not (canonicalFoods pantry) then Err RecipeInvalidDomain
    else
      let excluded = filter (\entry -> not (some pantry (\food -> eq food entry.value))) snapshot.domain.foods
      if length excluded == 0 then Ok RcAll
      else Ok (RcAnd { terms = map (\entry -> RcNot { inner = RcHasFood { rank = entry.rank } }) excluded })
  _ -> Err RecipeInvalidDomain

-- One proposal and one checked gate for a snapshot and a pantry set.
recipePublicGate : (snapshot: RecipeAnalysisSnapshot) -> (pantries: PantrySet) -> Result RecipeRefusal RecipeCriteriaGate
recipePublicGate snapshot pantries = case recipePantryConstraint snapshot pantries of
  Ok constraint -> Ok (recipeCriteriaPrepare snapshot (proposeRecipeAnalysis snapshot (recipeAnalysisBudget ())) constraint (recipeAnalysisBudget ()))
  Err reason -> Err reason
  _ -> Err RecipeInvalidDomain

recipeDomainFoods : List Food
recipeDomainFoods = [Butter, CoconutCream, Cream, Honey, LemonJuice, Egg, Tomato, Watermelon, Cucumber]

-- The inverse is total as a Maybe: an invalid rank never becomes a different
-- food or vanishes from a preparation/witness during public projection.
foodFromRank : (rank: Nat) -> Maybe Food
foodFromRank rank =
  if rank == 0 then Just Butter
  else if rank == 1 then Just CoconutCream
  else if rank == 2 then Just Cream
  else if rank == 3 then Just Honey
  else if rank == 4 then Just LemonJuice
  else if rank == 5 then Just Egg
  else if rank == 6 then Just Tomato
  else if rank == 7 then Just Watermelon
  else if rank == 8 then Just Cucumber
  else Nothing

recipeCollectMaybe : (project: a -> Maybe b) -> (values: List a) -> Maybe (List b)
recipeCollectMaybe project values = case head values of
  Nothing -> Just []
  Just value -> case project value of
    Nothing -> Nothing
    Just projected -> case recipeCollectMaybe project (fromMaybe [] (tail values)) of
      Nothing -> Nothing
      Just rest -> Just (concat [projected] rest)

foodFromAnalysisRank : (snapshot: RecipeAnalysisSnapshot) -> (rank: Nat) -> Maybe Food
foodFromAnalysisRank snapshot rank = case foodFromRank rank of
  Nothing -> Nothing
  Just food -> case find (\entry -> entry.rank == rank) snapshot.domain.foods of
    Nothing -> Nothing
    Just entry -> if eq entry.value food && foodRank food == rank then Just food else Nothing

recipeFoodsFromRanks : (context: RecipeClaimContext) -> (ranks: List Nat) -> Maybe (List Food)
recipeFoodsFromRanks context ranks = case context.snapshot of
  Nothing -> Nothing
  Just snapshot -> recipeCollectMaybe (foodFromAnalysisRank snapshot) ranks

recipePublicRefusal : (reason: RecipeRefusal) -> RecipeClaim a
recipePublicRefusal reason = RecipeUndetermined {
  reasons = [reason],
  context = RecipeClaimContext { snapshot = Nothing, analysis = Nothing, assumptions = [], family = [], distances = [], applications = [] }
}

recipePublicSnapshotRefusal : (snapshot: RecipeAnalysisSnapshot) -> (assumptions: List ReifyOutcome) -> (reason: RecipeRefusal) -> RecipeClaim a
recipePublicSnapshotRefusal snapshot assumptions reason = RecipeUndetermined {
  reasons = [reason],
  context = RecipeClaimContext { snapshot = Just snapshot, analysis = Nothing, assumptions = assumptions, family = [], distances = [], applications = [] }
}

recipeMapClaim : (project: RecipeClaimContext -> a -> Maybe b) -> (claim: RecipeClaim a) -> RecipeClaim b
recipeMapClaim project claim = case claim of
  RecipeKnown { value = value, status = status, context = context } -> case project context value of
    Nothing -> RecipeUndetermined { reasons = [RecipeInvalidDomain], context = context }
    Just projected -> RecipeKnown { value = projected, status = status, context = context }
  NoSuccessfulOutcome { status = status, context = context } -> NoSuccessfulOutcome { status = status, context = context }
  RecipeUndetermined { reasons = reasons, context = context } -> RecipeUndetermined { reasons = reasons, context = context }

recipeFoodWitnesses : (context: RecipeClaimContext) -> (minimumPantry: List Nat) -> (minimumPreparation: List Nat) -> (maximumPantry: List Nat) -> (maximumPreparation: List Nat) -> Maybe ({ minimumPantry: List Food, minimumPreparation: List Food, maximumPantry: List Food, maximumPreparation: List Food })
recipeFoodWitnesses context minimumPantry minimumPreparation maximumPantry maximumPreparation =
  case recipeFoodsFromRanks context minimumPantry of
    Nothing -> Nothing
    Just lowPantry -> case recipeFoodsFromRanks context minimumPreparation of
      Nothing -> Nothing
      Just lowPreparation -> case recipeFoodsFromRanks context maximumPantry of
        Nothing -> Nothing
        Just highPantry -> case recipeFoodsFromRanks context maximumPreparation of
          Nothing -> Nothing
          Just highPreparation -> Just { minimumPantry = lowPantry, minimumPreparation = lowPreparation, maximumPantry = highPantry, maximumPreparation = highPreparation }

recipePublicCountRange : (context: RecipeClaimContext) -> (range: RecipeCountRange Nat) -> Maybe (RecipeCountRange Food)
recipePublicCountRange context range =
  case recipeFoodWitnesses context range.minimumPantry range.minimumPreparation range.maximumPantry range.maximumPreparation of
    Nothing -> Nothing
    Just witnesses -> Just (RecipeCountRange {
      minimum = range.minimum, maximum = range.maximum,
      minimumPantry = witnesses.minimumPantry, minimumPreparation = witnesses.minimumPreparation,
      maximumPantry = witnesses.maximumPantry, maximumPreparation = witnesses.maximumPreparation
    })

recipePublicKindSpread : (context: RecipeClaimContext) -> (range: RecipeKindSpread Nat) -> Maybe (RecipeKindSpread Food)
recipePublicKindSpread context range =
  case recipeFoodWitnesses context range.minimumPantry range.minimumPreparation range.maximumPantry range.maximumPreparation of
    Nothing -> Nothing
    Just witnesses -> Just (RecipeKindSpread {
      minimum = range.minimum, maximum = range.maximum,
      minimumPantry = witnesses.minimumPantry, minimumPreparation = witnesses.minimumPreparation,
      maximumPantry = witnesses.maximumPantry, maximumPreparation = witnesses.maximumPreparation
    })

recipePublicAlternativeFood : (context: RecipeClaimContext) -> (entry: RecipeAlternativeFood Nat) -> Maybe (RecipeAlternativeFood Food)
recipePublicAlternativeFood context entry = case context.snapshot of
  Nothing -> Nothing
  Just snapshot -> case foodFromAnalysisRank snapshot entry.food of
    Nothing -> Nothing
    Just food -> Just (RecipeAlternativeFood { food = food, included = entry.included })

recipePublicAlternative : (context: RecipeClaimContext) -> (alternative: RecipeAlternative Nat) -> Maybe (RecipeAlternative Food)
recipePublicAlternative context alternative =
  case recipeCollectMaybe (recipePublicAlternativeFood context) alternative.foods of
    Nothing -> Nothing
    Just foods -> case recipeFoodsFromRanks context alternative.witnessPantry of
      Nothing -> Nothing
      Just pantry -> case recipeFoodsFromRanks context alternative.witnessPreparation of
        Nothing -> Nothing
        Just preparation -> Just (RecipeAlternative { condition = alternative.condition, foods = foods, witnessPantry = pantry, witnessPreparation = preparation })

recipePublicAlternatives : (context: RecipeClaimContext) -> (alternatives: List (RecipeAlternative Nat)) -> Maybe (List (RecipeAlternative Food))
recipePublicAlternatives context alternatives = recipeCollectMaybe (recipePublicAlternative context) alternatives

@label "Guaranteed foods"
@description "Foods in every successful preparation, established from the recipe expression. A recipe with no established success never yields a vacuous guarantee."
@tags "demo" "recipes" "criteria"
guaranteed : (recipe: Recipe) -> (pantries: PantrySet) -> GuaranteedFoodsResult
guaranteed recipe pantries = case recipeReaderSnapshot recipe (recipeDomainDescriptor ()) of
  Err reason -> recipePublicRefusal reason
  Ok snapshot -> case recipePublicGate snapshot pantries of
    Err reason -> recipePublicSnapshotRefusal snapshot [] reason
    Ok gate -> recipeMapClaim recipeFoodsFromRanks (recipeCriteriaGuaranteedIn gate (recipeAnalysisBudget ()))

@label "Necessary pantry foods"
@description "Foods in every successful pantry. This differs from inclusion in every returned preparation."
@tags "demo" "recipes" "criteria"
necessary : (recipe: Recipe) -> (pantries: PantrySet) -> NecessaryFoodsResult
necessary recipe pantries = case recipeReaderSnapshot recipe (recipeDomainDescriptor ()) of
  Err reason -> recipePublicRefusal reason
  Ok snapshot -> case recipePublicGate snapshot pantries of
    Err reason -> recipePublicSnapshotRefusal snapshot [] reason
    Ok gate -> recipeMapClaim recipeFoodsFromRanks (recipeCriteriaNecessaryIn gate (recipeAnalysisBudget ()))

recipeFamilyMember : (snapshot: RecipeAnalysisSnapshot) -> (food: Food) -> Maybe RecipeFamilyMember
recipeFamilyMember snapshot food = case find (\entry -> entry.rank == foodRank food) snapshot.domain.foods of
  Nothing -> Nothing
  Just entry -> if eq entry.value food then Just (RecipeFamilyMember { rank = entry.rank, membership = Nothing, identity = entry.identity }) else Nothing

@label "Required food family"
@description "Whether every successful pantry contains a member of the supplied family. The actual predicate and captures accompany unknown constructor memberships; only checked source application can establish their facts. Missing facts remain unknown."
@tags "demo" "recipes" "criteria"
requiredFamily : (recipe: Recipe) -> (pantries: PantrySet) -> (family: Food -> Maybe Bool) -> RequiredFamilyResult
requiredFamily recipe pantries family = case recipeReaderSnapshotWithFunctions recipe (recipeDomainDescriptor ()) [family] of
  Err reason -> recipePublicRefusal reason
  Ok snapshot ->
    let assumptions = snapshot.functions
    case recipeCollectMaybe (recipeFamilyMember snapshot) (recipeDomainFoods ()) of
      Nothing -> recipePublicSnapshotRefusal snapshot assumptions RecipeInvalidDomain
      Just members -> case recipePublicGate snapshot pantries of
        Err reason -> recipePublicSnapshotRefusal snapshot assumptions reason
        Ok gate -> recipeCriteriaRequiredFamilyIn gate members assumptions (recipeAnalysisBudget ())

@label "Required food families"
@description "Check a catalogue of ordinary food predicates against one reader snapshot and checked recipe extraction. Each finding retains its own predicate, captures and evidence."
requiredFamilies : (recipe: Recipe) -> (pantries: PantrySet) -> (scope: RecipeFamilyScope) -> (families: List (RecipeFamilySubject a)) -> List (RecipeFamilyClaim a)
requiredFamilies recipe pantries scope families =
  case recipeReaderSnapshotWithFunctions recipe (recipeDomainDescriptor ()) (map (\family -> family.predicate) families) of
    Err reason -> map (\family -> RecipeFamilyClaim { subject = family.subject, result = recipePublicRefusal reason }) families
    Ok snapshot -> case recipePublicGate snapshot pantries of
      Err reason -> map (\family -> RecipeFamilyClaim { subject = family.subject, result = recipePublicSnapshotRefusal snapshot snapshot.functions reason }) families
      Ok gate -> recipeCriteriaFamiliesIn gate (map (\family -> family.subject) families) scope (recipeAnalysisBudget ())

recipeFamilyEstablished : (finding: RecipeFamilyClaim a) -> Bool
recipeFamilyEstablished finding = case finding.result of
  RecipeKnown { value = value } -> value
  _ -> false

-- The five category predicates in allFoodCategories order.
recipeCategoryFamilies : (facts: FoodFactSnapshot) -> List (RecipeFamilySubject FoodCategory)
recipeCategoryFamilies facts =
  let expanded = expandFoodCategories facts.categoryInclusions facts.categories
  map (\category -> RecipeFamilySubject { subject = category, predicate = foodInCategory facts.classifiedFoods expanded category }) (allFoodCategories ())

recipeCategoryRequirementsOf : (scope: RecipeFamilyScope) -> (facts: FoodFactSnapshot) -> (findings: List (RecipeFamilyClaim FoodCategory)) -> RecipeCategoryRequirements
recipeCategoryRequirementsOf scope facts findings =
  let established = map (\finding -> finding.subject) (std.filter recipeFamilyEstablished findings)
  RecipeCategoryRequirements { scope = scope, mostSpecificEstablished = mostSpecificFoodCategories facts.categoryInclusions established, findings = findings, facts = facts }

recipeCategoryRequirements : (recipe: Recipe) -> (pantries: PantrySet) -> (scope: RecipeFamilyScope) -> (facts: FoodFactSnapshot) -> RecipeCategoryRequirements
recipeCategoryRequirements recipe pantries scope facts =
  recipeCategoryRequirementsOf scope facts (requiredFamilies recipe pantries scope (recipeCategoryFamilies facts))

@label "Necessary pantry categories"
@description "Classifications represented in every successful pantry, with all checked ancestor and unknown findings retained. The supplied classification snapshot does not change the recipe."
@tags "demo" "recipes" "criteria"
requiredCategories : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeCategoryRequirements
requiredCategories recipe pantries =
  let snapshot = recipeSnapshot ()
  recipeCategoryRequirements recipe pantries PantryFamily (snapshot.facts)

@label "Guaranteed preparation categories"
@description "Classifications represented in every successful preparation. A category merely available in the pantry is not necessarily used."
@tags "demo" "recipes" "criteria"
guaranteedCategories : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeCategoryRequirements
guaranteedCategories recipe pantries =
  let snapshot = recipeSnapshot ()
  recipeCategoryRequirements recipe pantries PreparationFamily (snapshot.facts)

@label "Distinct food threshold"
@description "Check the distinct-membership threshold implied by recipe success, with sufficiency and exactness reported separately. Repeated selected foods do not count twice."
@tags "demo" "recipes" "criteria"
kOfN : (recipe: Recipe) -> (pantries: PantrySet) -> (foods: List Food) -> (k: Nat) -> RecipeThresholdResult
kOfN recipe pantries foods k = case recipeReaderSnapshot recipe (recipeDomainDescriptor ()) of
  Err reason -> RecipeThresholdClaim { implication = recipePublicRefusal reason, sufficiency = recipePublicRefusal reason, exactness = recipePublicRefusal reason }
  Ok snapshot -> case recipePublicGate snapshot pantries of
    Err reason -> RecipeThresholdClaim { implication = recipePublicSnapshotRefusal snapshot [] reason, sufficiency = recipePublicSnapshotRefusal snapshot [] reason, exactness = recipePublicSnapshotRefusal snapshot [] reason }
    Ok gate -> recipeCriteriaKOfNIn gate (map foodRank foods) k (recipeAnalysisBudget ())

@label "Preparation count range"
@description "Minimum and maximum successful preparation sizes, each with an attaining pantry and preparation. Unexplored paths cannot silently disappear from an exact range."
@tags "demo" "recipes" "criteria"
countRange : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeCountRangeResult
countRange recipe pantries = case recipeReaderSnapshot recipe (recipeDomainDescriptor ()) of
  Err reason -> recipePublicRefusal reason
  Ok snapshot -> case recipePublicGate snapshot pantries of
    Err reason -> recipePublicSnapshotRefusal snapshot [] reason
    Ok gate -> recipeMapClaim recipePublicCountRange (recipeCriteriaCountRangeIn gate (recipeAnalysisBudget ()))

recipeDistancePairs : (left: Food) -> (rights: List Food) -> List RecipeFoodDistance
recipeDistancePairs left rights = map (\right -> RecipeFoodDistance { left = foodRank left, right = foodRank right, distance = Nothing }) rights

recipeDistanceRows : (foods: List Food) -> List RecipeFoodDistance
recipeDistanceRows foods = case head foods of
  Nothing -> []
  Just left ->
    let rest = fromMaybe [] (tail foods)
    concat (recipeDistancePairs left rest) (recipeDistanceRows rest)

@label "Preparation kind spread"
@description "The mean supplied distance over unordered distinct food pairs in each preparation; fewer than two foods score zero. Unknown distances stay unknown. General conditional-size optimisation remains an explicit residual."
@tags "demo" "recipes" "criteria"
kindSpread : (recipe: Recipe) -> (pantries: PantrySet) -> (distance: Food -> Food -> Maybe Number) -> RecipeKindSpreadResult
kindSpread recipe pantries distance = case recipeReaderSnapshotWithFunctions recipe (recipeDomainDescriptor ()) [distance] of
  Err reason -> recipePublicRefusal reason
  Ok snapshot ->
    let assumptions = snapshot.functions
    case recipeCollectMaybe (foodFromAnalysisRank snapshot) (map foodRank (recipeDomainFoods ())) of
      Nothing -> recipePublicSnapshotRefusal snapshot assumptions RecipeInvalidDomain
      Just foods -> case recipePublicGate snapshot pantries of
        Err reason -> recipePublicSnapshotRefusal snapshot assumptions reason
        Ok gate -> recipeMapClaim recipePublicKindSpread (recipeCriteriaKindSpreadIn gate (recipeDistanceRows foods) assumptions (recipeAnalysisBudget ()))

@label "Conditional recipe alternatives"
@description "Alternative successful preparations with their path conditions and attaining witnesses. These alternatives do not assert global symmetric substitution."
@tags "demo" "recipes" "criteria"
substitutes : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeSubstitutesResult
substitutes recipe pantries = case recipeReaderSnapshot recipe (recipeDomainDescriptor ()) of
  Err reason -> recipePublicRefusal reason
  Ok snapshot -> case recipePublicGate snapshot pantries of
    Err reason -> recipePublicSnapshotRefusal snapshot [] reason
    Ok gate -> recipeMapClaim recipePublicAlternatives (recipeCriteriaSubstitutesIn gate (recipeAnalysisBudget ()))

@label "Strictly optional food"
@description "Whether canonical insertion/removal preserves success across the pantry set and the food occurs in some successful preparation. Merely being absent from a necessary list is insufficient. A food that no pantry of the set contains is not strictly optional over that set."
@tags "demo" "recipes" "criteria"
strictlyOptional : (recipe: Recipe) -> (pantries: PantrySet) -> (food: Food) -> RecipeOptionalResult
strictlyOptional recipe pantries food = case recipeReaderSnapshot recipe (recipeDomainDescriptor ()) of
  Err reason -> recipePublicRefusal reason
  Ok snapshot -> case recipePublicGate snapshot pantries of
    Err reason -> recipePublicSnapshotRefusal snapshot [] reason
    Ok gate -> recipeCriteriaStrictlyOptionalIn gate (foodRank food) (recipeAnalysisBudget ())

@label "Required fat-rich example family"
@description "Apply the supplied fat-rich predicate with its actual fact/rule snapshot captured. The default example supplies no nutrient measurements, so missing facts remain unknown."
requiredFatRich : (recipe: Recipe) -> (pantries: PantrySet) -> RequiredFamilyResult
requiredFatRich recipe pantries = requiredFamily recipe pantries (fatRich (recipeSnapshot ()))

@label "Hydration example threshold"
@description "Check the two-of-three threshold for tomato, watermelon and cucumber, with implication, sufficiency and exactness kept separate."
hydrationThreshold : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeThresholdResult
hydrationThreshold recipe pantries = kOfN recipe pantries [Tomato, Watermelon, Cucumber] 2

@label "Is honey strictly optional?"
optionalHoney : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeOptionalResult
optionalHoney recipe pantries = strictlyOptional recipe pantries Honey

@label "Unspecified food distance"
@description "No distance facts are supplied by this example. Missing distances return Nothing, not a fabricated numerical score."
unknownFoodDistance : (left: Food) -> (right: Food) -> Maybe Number
unknownFoodDistance left right = Nothing

@label "Recipe kind spread with unspecified distances"
recipeKindSpread : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeKindSpreadResult
recipeKindSpread recipe pantries = kindSpread recipe pantries unknownFoodDistance

@label "Recipe expression and captures"
@description "Reflect this recipe in the current reader, retaining its actual expression, admitted captures, helper dependencies and constructor resolution. Reflection does not execute the recipe."
recipeReflection : (recipe: Recipe) -> ReifyOutcome
recipeReflection recipe = reflectFunction recipe

-- One row of the recipe card. The summary is the fact a person reads.
-- Evidence is the check's status, scope, or reasons. The analysis snapshot
-- stays out of both, so opening a fact cannot draw the whole certificate.
@label "Recipe fact"
@description "One derived fact of a recipe. Opening it shows the checked evidence. The analysis snapshot is not included."
RecipeFact = RecipeFact title: String summary: RecipeFactSummary evidence: RecipeFactEvidence

@label "Recipe fact summary"
RecipeFactSummary = Foods items: List Food
  | Families items: List FoodCategory
  | Findings items: List RecipeFinding
  | Preparations items: List (List Food)
  | IngredientCount minimum: Nat maximum: Nat
  | Alternatives items: List (RecipeAlternative Food)
  | Missing items: List RecipeRefusal
  | NoSuccessfulPreparation

@label "Recipe finding"
@description "Whether one food category holds for every successful pantry or preparation. Unknown keeps its reasons."
RecipeFinding = RecipeYes category: FoodCategory
  | RecipeNo category: FoodCategory
  | RecipeNoPreparation category: FoodCategory
  | RecipeUnknown category: FoodCategory reasons: List RecipeRefusal

@label "Recipe fact evidence"
RecipeFactEvidence = StatusEvidence status: EpistemicStatus
  | ScopeEvidence scope: RecipeFamilyScope
  | CountEvidence status: EpistemicStatus range: (RecipeCountRange Food)
  | ReasonEvidence reasons: List RecipeRefusal
  | DirectEvaluation

recipeRememberFood : (seen: List Food) -> (food: Food) -> List Food
recipeRememberFood seen food = case find (\item -> eq item food) seen of
  Just _ -> seen
  Nothing -> concat seen [food]

recipeFoodsInOne : (seen: List Food) -> (preparation: List Food) -> List Food
recipeFoodsInOne seen preparation = case head preparation of
  Nothing -> seen
  Just food -> recipeFoodsInOne (recipeRememberFood seen food) (fromMaybe [] (tail preparation))

recipeFoodsInMany : (seen: List Food) -> (preparations: List (List Food)) -> List Food
recipeFoodsInMany seen preparations = case head preparations of
  Nothing -> seen
  Just preparation -> recipeFoodsInMany (recipeFoodsInOne seen preparation) (fromMaybe [] (tail preparations))

recipeFoodsSame : (left: List Food) -> (right: List Food) -> Bool
recipeFoodsSame left right = case head left of
  Nothing -> case head right of
    Nothing -> true
    Just _ -> false
  Just food -> case head right of
    Nothing -> false
    Just other -> if eq food other then recipeFoodsSame (fromMaybe [] (tail left)) (fromMaybe [] (tail right)) else false

recipeRememberPreparation : (seen: List (List Food)) -> (preparation: List Food) -> List (List Food)
recipeRememberPreparation seen preparation = case find (\item -> recipeFoodsSame item preparation) seen of
  Just _ -> seen
  Nothing -> concat seen [preparation]

recipeUniquePreparations : (seen: List (List Food)) -> (alternatives: List (RecipeAlternative Food)) -> List (List Food)
recipeUniquePreparations seen alternatives = case head alternatives of
  Nothing -> seen
  Just alternative -> recipeUniquePreparations (recipeRememberPreparation seen alternative.witnessPreparation) (fromMaybe [] (tail alternatives))

recipeFinding : (finding: RecipeFamilyClaim FoodCategory) -> RecipeFinding
recipeFinding finding = case finding.result of
  RecipeKnown { value = value } -> if value then RecipeYes { category = finding.subject } else RecipeNo { category = finding.subject }
  NoSuccessfulOutcome { status = status } -> RecipeNoPreparation { category = finding.subject }
  RecipeUndetermined { reasons = reasons } -> RecipeUnknown { category = finding.subject, reasons = reasons }

recipeFoodFact : (title: String) -> (claim: RecipeClaim (List Food)) -> RecipeFact
recipeFoodFact title claim = case claim of
  RecipeKnown { value = value, status = status } -> RecipeFact { title = title, summary = Foods { items = value }, evidence = StatusEvidence { status = status } }
  NoSuccessfulOutcome { status = status } -> RecipeFact { title = title, summary = NoSuccessfulPreparation, evidence = StatusEvidence { status = status } }
  RecipeUndetermined { reasons = reasons } -> RecipeFact { title = title, summary = Missing { items = reasons }, evidence = ReasonEvidence { reasons = reasons } }

-- A family row over a gate that found no successful pantry says so; over a
-- refused gate it says what is missing. Findings keep their own verdicts.
recipeFamilyFact : (title: String) -> (gate: RecipeCriteriaGate) -> (requirements: RecipeCategoryRequirements) -> RecipeFact
recipeFamilyFact title gate requirements = case gate of
  RecipeCriteriaReady { basis = basis } -> RecipeFact { title = title, summary = Families { items = requirements.mostSpecificEstablished }, evidence = ScopeEvidence { scope = requirements.scope } }
  RecipeCriteriaImpossible { context = context } -> RecipeFact { title = title, summary = NoSuccessfulPreparation, evidence = ScopeEvidence { scope = requirements.scope } }
  RecipeCriteriaBlocked { reasons = reasons, context = context } -> recipeMissingFact title reasons
  _ -> recipeMissingFact title [RecipeInvalidDomain]

recipeFindingsFact : (title: String) -> (gate: RecipeCriteriaGate) -> (requirements: RecipeCategoryRequirements) -> RecipeFact
recipeFindingsFact title gate requirements = case gate of
  RecipeCriteriaBlocked { reasons = reasons, context = context } -> recipeMissingFact title reasons
  _ -> RecipeFact { title = title, summary = Findings { items = map recipeFinding requirements.findings }, evidence = ScopeEvidence { scope = requirements.scope } }

recipeMissingFact : (title: String) -> (reasons: List RecipeRefusal) -> RecipeFact
recipeMissingFact title reasons = RecipeFact { title = title, summary = Missing { items = reasons }, evidence = ReasonEvidence { reasons = reasons } }

recipeSubstituteFact : (claim: RecipeSubstitutesResult) -> RecipeFact
recipeSubstituteFact claim = case claim of
  RecipeKnown { value = value, status = status } -> RecipeFact { title = "Substitutes", summary = Alternatives { items = value }, evidence = StatusEvidence { status = status } }
  NoSuccessfulOutcome { status = status } -> RecipeFact { title = "Substitutes", summary = NoSuccessfulPreparation, evidence = StatusEvidence { status = status } }
  RecipeUndetermined { reasons = reasons } -> RecipeFact { title = "Substitutes", summary = Missing { items = reasons }, evidence = ReasonEvidence { reasons = reasons } }

recipeCountFact : (claim: RecipeCountRangeResult) -> RecipeFact
recipeCountFact claim = case claim of
  RecipeKnown { value = value, status = status } -> RecipeFact { title = "Ingredient count", summary = IngredientCount { minimum = value.minimum, maximum = value.maximum }, evidence = CountEvidence { status = status, range = value } }
  NoSuccessfulOutcome { status = status } -> RecipeFact { title = "Ingredient count", summary = NoSuccessfulPreparation, evidence = StatusEvidence { status = status } }
  RecipeUndetermined { reasons = reasons } -> RecipeFact { title = "Ingredient count", summary = Missing { items = reasons }, evidence = ReasonEvidence { reasons = reasons } }

recipeCombinationFact : (claim: RecipeSubstitutesResult) -> RecipeFact
recipeCombinationFact claim = case claim of
  RecipeKnown { value = value, status = status } -> RecipeFact { title = "Combinations", summary = Preparations { items = recipeUniquePreparations [] value }, evidence = StatusEvidence { status = status } }
  NoSuccessfulOutcome { status = status } -> RecipeFact { title = "Combinations", summary = NoSuccessfulPreparation, evidence = StatusEvidence { status = status } }
  RecipeUndetermined { reasons = reasons } -> RecipeFact { title = "Combinations", summary = Missing { items = reasons }, evidence = ReasonEvidence { reasons = reasons } }

recipeAppearingFoodsFact : (claim: RecipeSubstitutesResult) -> RecipeFact
recipeAppearingFoodsFact claim = case claim of
  RecipeKnown { value = value, status = status } -> RecipeFact { title = "Foods that can appear", summary = Foods { items = recipeFoodsInMany [] (recipeUniquePreparations [] value) }, evidence = StatusEvidence { status = status } }
  NoSuccessfulOutcome { status = status } -> RecipeFact { title = "Foods that can appear", summary = NoSuccessfulPreparation, evidence = StatusEvidence { status = status } }
  RecipeUndetermined { reasons = reasons } -> RecipeFact { title = "Foods that can appear", summary = Missing { items = reasons }, evidence = ReasonEvidence { reasons = reasons } }

@label "Foods that can appear"
@description "Every food used by at least one successful preparation. A food can be mandatory, optional, or neither. Foods the recipe never uses are absent."
appearingFoods : (recipe: Recipe) -> (pantries: PantrySet) -> AppearingFoodsResult
appearingFoods recipe pantries = case substitutes recipe pantries of
  RecipeKnown { value = value, status = status, context = context } ->
    RecipeKnown { value = recipeFoodsInMany [] (recipeUniquePreparations [] value), status = status, context = context }
  NoSuccessfulOutcome { status = status, context = context } -> NoSuccessfulOutcome { status = status, context = context }
  RecipeUndetermined { reasons = reasons, context = context } -> RecipeUndetermined { reasons = reasons, context = context }

-- One call of the recipe on the largest list of foods of the set: every food
-- for AllPantries, the given foods for SubsetsOf. This is the function's own
-- return. It is not a symbolic claim and it does not try any other pantry.
recipeFullPantryFact : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeFact
recipeFullPantryFact recipe pantries = case pantries of
  AllPantries -> RecipeFact { title = "All foods", summary = Preparations { items = recipe (recipeDomainFoods ()) }, evidence = DirectEvaluation }
  SubsetsOf { pantry = pantry } ->
    if canonicalFoods pantry then RecipeFact { title = "These foods", summary = Preparations { items = recipe pantry }, evidence = DirectEvaluation }
    else recipeMissingFact "These foods" [RecipeInvalidDomain]
  _ -> recipeMissingFact "All foods" [RecipeInvalidDomain]

recipeCardTitles : List String
recipeCardTitles = ["Necessary foods", "Necessary families", "Necessary family findings", "Guaranteed foods", "Guaranteed families", "Guaranteed family findings", "Foods that can appear", "Substitutes", "Ingredient count", "Combinations"]

-- A refused snapshot or pantry set: the direct row still shows; every
-- symbolic row says what is missing.
recipeCardRefused : (direct: RecipeFact) -> (reason: RecipeRefusal) -> List RecipeFact
recipeCardRefused direct reason = concat [direct] (map (\title -> recipeMissingFact title [reason]) (recipeCardTitles ()))

-- Every row from one gate: one snapshot (with the five category predicates),
-- one proposal, one checked analysis over the pantry set.
recipeCardFromGate : (direct: RecipeFact) -> (facts: FoodFactSnapshot) -> (gate: RecipeCriteriaGate) -> List RecipeFact
recipeCardFromGate direct facts gate =
  let budget = recipeAnalysisBudget ()
  let necessary = recipeCriteriaNecessaryIn gate budget
  let guaranteed = recipeCriteriaGuaranteedIn gate budget
  -- One projection per category feeds both family rows.
  recipeCardRows direct facts gate necessary guaranteed (recipeCriteriaFamiliesSharedIn gate (allFoodCategories ()) necessary guaranteed budget)

-- The same rows from a card analysis: its projections answer both family rows.
recipeCardFromAnalysis : (direct: RecipeFact) -> (facts: FoodFactSnapshot) -> (analysis: RecipeCardAnalysis) -> (gate: RecipeCriteriaGate) -> List RecipeFact
recipeCardFromAnalysis direct facts analysis gate =
  let budget = recipeAnalysisBudget ()
  let necessary = recipeCriteriaNecessaryIn gate budget
  let guaranteed = recipeCriteriaGuaranteedIn gate budget
  recipeCardRows direct facts gate necessary guaranteed (recipeCriteriaFamiliesFromAnalysis gate analysis (allFoodCategories ()) necessary guaranteed budget)

recipeCardRows : (direct: RecipeFact) -> (facts: FoodFactSnapshot) -> (gate: RecipeCriteriaGate) -> (necessary: RecipeClaim (List Nat)) -> (guaranteed: RecipeClaim (List Nat)) -> (families: RecipeFamilyScopes FoodCategory) -> List RecipeFact
recipeCardRows direct facts gate necessary guaranteed families =
  let budget = recipeAnalysisBudget ()
  let needed = recipeMapClaim recipeFoodsFromRanks necessary
  let neededFamilies = recipeCategoryRequirementsOf PantryFamily facts families.pantry
  let used = recipeMapClaim recipeFoodsFromRanks guaranteed
  let usedFamilies = recipeCategoryRequirementsOf PreparationFamily facts families.preparation
  let options = recipeMapClaim recipePublicAlternatives (recipeCriteriaSubstitutesIn gate budget)
  let counts = recipeMapClaim recipePublicCountRange (recipeCriteriaCountRangeIn gate budget)
  [
    direct,
    recipeFoodFact "Necessary foods" needed,
    recipeFamilyFact "Necessary families" gate neededFamilies,
    recipeFindingsFact "Necessary family findings" gate neededFamilies,
    recipeFoodFact "Guaranteed foods" used,
    recipeFamilyFact "Guaranteed families" gate usedFamilies,
    recipeFindingsFact "Guaranteed family findings" gate usedFamilies,
    recipeAppearingFoodsFact options,
    recipeSubstituteFact options,
    recipeCountFact counts,
    recipeCombinationFact options
  ]

@label "Recipe facts"
@description "The derived facts of one recipe, in order."
RecipeCard = List RecipeFact | if true then true else true

@label "Recipe facts"
@description "Derived facts for one recipe over the foods it chooses from. The first row is the recipe's own return on the largest list of those foods. Then foods and families that every successful list of foods or preparation uses, every food that can appear, the substitutes, how many ingredients, and the preparations that succeed. Kind spread, total weight, and rules that belong to only one example stay out of these facts."
@tags "demo" "recipes"
recipeCard : (recipe: Recipe) -> (pantries: PantrySet) -> RecipeCard
recipeCard recipe pantries =
  let snapshotFacts = recipeSnapshot ()
  let facts = snapshotFacts.facts
  let direct = recipeFullPantryFact recipe pantries
  let predicates = map (\family -> family.predicate) (recipeCategoryFamilies facts)
  case recipeReaderSnapshotWithFunctions recipe (recipeDomainDescriptor ()) predicates of
    Err reason -> recipeCardRefused direct reason
    -- Two stages: the snapshot's analysis does not depend on the pantry set
    -- (the engine reuses it for an identical observation), then the set's
    -- gate and verdicts. Same rows as recipeCardFromGate over recipePublicGate.
    Ok snapshot -> case recipePantryConstraint snapshot pantries of
      Err reason -> recipeCardRefused direct reason
      Ok constraint ->
        let analysis = recipeCardAnalysis snapshot (recipeAnalysisBudget ())
        recipeCardFromAnalysis direct facts analysis (recipeCriteriaPrepareFromAnalysis analysis constraint (recipeAnalysisBudget ()))
      _ -> recipeCardRefused direct RecipeInvalidDomain
    _ -> recipeCardRefused direct RecipeUnavailable
