module StatisticsDemo where

using picture (Point)
using DrawingDemo (PointLineChart)

-- Ordinary source-owned data shared by the numerical and commerce examples.
-- Cents are whole units; unknown customers remain visible with Nothing names.

@label "Number summary"
@description "Count and total, with no fabricated average or extrema for an empty collection."
NumberSummary = NumberSummary count: Nat total: Number average: Maybe Number minimum: Maybe Number maximum: Maybe Number

@label "Number statistics"
@description "The input data, its Fenel-derived summary and an existing typed line chart. A refused input has a reason instead of numerical output."
@discriminator "$tag"
NumberStatistics = NumberStatistics values: List Number summary: NumberSummary chart: PointLineChart explanation: String
  | NumberStatisticsRefused reason: String

@label "Statistics customer"
StatisticsCustomer = StatisticsCustomer id: String name: String

@label "Purchase amount in cents"
@description "A whole nonnegative amount in cents, from 0 through 1000000."
StatisticsAmount = Nat | value ∈ [0..1000000]

@label "Statistics purchase"
StatisticsPurchase = StatisticsPurchase id: String customerId: String amountCents: StatisticsAmount

@label "Customer purchase summary"
@description "Count, total cents and average cents for one customer id. Nothing means that no name was supplied, or that no purchase exists for the average."
CustomerPurchaseSummary = CustomerPurchaseSummary customerId: String customerName: Maybe String count: Nat totalCents: Number averageCents: Maybe Number

@label "Purchase statistics"
@description "All supplied customers and purchases with reconciled per-customer summaries. Unknown customer ids and customers with no purchases stay visible."
@discriminator "$tag"
PurchaseStatistics = PurchaseStatistics customers: List StatisticsCustomer purchases: List StatisticsPurchase summary: NumberSummary breakdown: List CustomerPurchaseSummary explanation: String
  | PurchaseStatisticsRefused reason: String

-- The accumulator is a typed intermediate value, not a host chart algorithm.
StatisticsPointAccumulator = StatisticsPointAccumulator nextIndex: Nat points: List Point
