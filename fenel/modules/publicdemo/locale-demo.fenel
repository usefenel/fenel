module LocaleDemo where

using locale (localize, translation)
using std (isString)

-- Locale is a reader choice. The same label and description remain data;
-- only their displayed text changes. Author through LocaleStringEditor and
-- inspect these source definitions through the ordinary public Home lens.

@label "Reader language"
@description "Choose English or French for both the label and its description."
LocaleDemoLanguage = English | French

@label "Language projection"
@description "The source data alongside the text selected for one reader. Missing translations fall back to English, then the first available translation."
@discriminator "$tag"
LocaleDemoProjection = LocaleDemoProjection sourceLabel: LocaleString sourceDescription: LocaleString language: String label: String description: String fallback: String

@label "Multilingual label"
@description "One unchanged value with an English and a French translation."
localeDemoLabel : LocaleString
localeDemoLabel = { en = "Welcome", fr = "Bienvenue" }

@label "Description with a missing translation"
@description "This value has only English. French readers see the English fallback."
localeDemoDescription : LocaleString
localeDemoDescription = { en = "Make yourself at home." }

@label "One value, two languages"
@description "Switch reader language between English and French. Both displayed text fields use that choice; the original multilingual data stays unchanged. Edit translations through the same universal editor."
@tags "demo" "language" "locale" "projection"
languagePreview : (label: LocaleString) -> (description: LocaleString) -> (language: LocaleDemoLanguage) -> LocaleDemoProjection
languagePreview label description language =
  let selected = localeDemoSelectedLanguage language
  let fallback = localeDemoFallback (localeDemoMissing label selected) (localeDemoMissing description selected)
  LocaleDemoProjection { sourceLabel = label, sourceDescription = description, language = selected, label = localize label selected, description = localize description selected, fallback = fallback }

localeDemoSelectedLanguage : (language: LocaleDemoLanguage) -> String
localeDemoSelectedLanguage language =
  case language of
    English -> "en"
    French -> "fr"

localeDemoMissing : (value: LocaleString) -> (language: String) -> Boolean
localeDemoMissing value language =
  if isString value then False
  else case translation value language of
    Just text -> False
    Nothing -> True

localeDemoFallback : (missingLabel: Boolean) -> (missingDescription: Boolean) -> String
localeDemoFallback missingLabel missingDescription =
  if missingLabel && missingDescription then "No translation for the label or description: using the fallback text."
  else if missingLabel then "No translation for the label: using the fallback text."
  else if missingDescription then "No translation for the description: using the fallback text."
  else "Both text fields use the reader language."

-- Exact callable identity and starting data travel through the same public
-- Call modal used by the solver and image examples.
localeDemoStartingInputs : List ({ function: Any, arguments: List Any })
localeDemoStartingInputs = [{ function = languagePreview, arguments = [localeDemoLabel (), localeDemoDescription (), (English)] }]
