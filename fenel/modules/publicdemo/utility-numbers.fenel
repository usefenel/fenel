module UtilityDemo where

using std (numberIsFinite, floor)
using StatisticsDemo (NumberStatistics, numberStatistics)
using time (Duration, duration, hours, minutes, seconds, timestamp, diffTimestamps)

-- Ordinary Number calculations use the existing double representation. The
-- finite bounded admission and explicit Result errors belong to these recipes;
-- empty-list statistics and time-span construction keep their existing owners.
-- No clock is read, and fixed hours/minutes imply no calendar or unit catalogue.

utilityBoundedNumber : (value: Number) -> Bool
utilityBoundedNumber value = numberIsFinite value && value >= -1000000 && value <= 1000000

utilityFiniteNumber : (value: Number) -> Result String Number
utilityFiniteNumber value = if numberIsFinite value then Ok value else Err "The calculation exceeds the finite Number range."

@label "Percentage of a number"
@description "Calculate value multiplied by percent divided by 100. Both inputs must be finite and between -1000000 and 1000000. Signed values and percentages are allowed; decimal results use the existing Number approximation."
@tags "utility" "numbers" "percentage"
percentageOf : (value: Number) -> (percent: Number) -> Result String Number
percentageOf value percent =
  if utilityBoundedNumber value && utilityBoundedNumber percent
  then utilityFiniteNumber ((value * percent) / 100)
  else Err "Use finite value and percent inputs between -1000000 and 1000000."

@label "Percentage change"
@description "Calculate 100 times (after minus before) divided by before. Before must be strictly positive and at most 1000000; after may be between -1000000 and 1000000. Zero and negative baselines refuse, as do non-finite results. Decimal results use the existing Number approximation."
@tags "utility" "numbers" "percentage"
percentageChange : (before: Number) -> (after: Number) -> Result String Number
percentageChange before after =
  if utilityBoundedNumber before && before > 0 && utilityBoundedNumber after
  then utilityFiniteNumber (((after - before) / before) * 100)
  else Err "Before must be finite, greater than zero and at most 1000000; after must be finite and between -1000000 and 1000000."

@label "Apply a discount"
@description "Calculate price multiplied by (100 minus discountPercent) divided by 100. Price must be finite from 0 through 1000000 and discountPercent from 0 through 100. No currency or money-rounding policy is implied; decimal results use the existing Number approximation."
@tags "utility" "numbers" "discount"
discountedTotal : (price: Number) -> (discountPercent: Number) -> Result String Number
discountedTotal price discountPercent =
  if utilityBoundedNumber price && price >= 0 && numberIsFinite discountPercent && discountPercent >= 0 && discountPercent <= 100
  then utilityFiniteNumber ((price * (100 - discountPercent)) / 100)
  else Err "Use a finite price from 0 through 1000000 and a finite discount from 0 through 100 percent."

@label "Fixed duration total"
@description "The same supplied fixed span in seconds and the existing time Duration's milliseconds. This is ordinary typed data, with no calendar or timezone conversion."
FixedDurationTotal = FixedDurationTotal totalSeconds: Number duration: Duration

utilityDurationTotal : (span: Duration) -> Result String FixedDurationTotal
utilityDurationTotal span =
  if numberIsFinite span.ms
  then Ok (FixedDurationTotal { totalSeconds = span.ms / 1000, duration = span })
  else Err "The fixed duration exceeds the finite Number range."

utilityDurationPart : (value: Number) -> Bool
utilityDurationPart value = utilityBoundedNumber value && value >= 0

@label "Add hours, minutes and seconds"
@description "Add fixed hours of 3600 seconds, minutes of 60 seconds and seconds. Each component must be finite from 0 through 1000000; fractional components are allowed with Number approximation. One hour plus six minutes plus five seconds gives 3965 seconds and Duration 3965000 milliseconds. No calendar, timezone or general unit conversion is performed."
@tags "utility" "time" "duration"
mixedDuration : (hourCount: Number) -> (minuteCount: Number) -> (secondCount: Number) -> Result String FixedDurationTotal
mixedDuration hourCount minuteCount secondCount =
  if utilityDurationPart hourCount && utilityDurationPart minuteCount && utilityDurationPart secondCount
  then
    let hourSpan = hours hourCount
    let minuteSpan = minutes minuteCount
    let secondSpan = seconds secondCount
    utilityDurationTotal (duration (hourSpan.ms + minuteSpan.ms + secondSpan.ms))
  else Err "Use finite nonnegative hours, minutes and seconds, each at most 1000000."

utilityEpochMilliseconds : (value: Number) -> Bool
utilityEpochMilliseconds value = numberIsFinite value && value >= -10000000000000 && value <= 10000000000000 && floor value == value

@label "Elapsed seconds from milliseconds"
@description "Subtract supplied whole epoch milliseconds, then show the fixed span in seconds and Duration. Each endpoint must be finite and between -10000000000000 and 10000000000000; finish must be at or after start. No clock, date text, calendar or timezone is read. A 2500-millisecond span gives 2.5 seconds."
@tags "utility" "time" "duration"
elapsedSeconds : (startMs: Number) -> (finishMs: Number) -> Result String FixedDurationTotal
elapsedSeconds startMs finishMs =
  if utilityEpochMilliseconds startMs && utilityEpochMilliseconds finishMs && finishMs >= startMs
  then utilityDurationTotal (diffTimestamps (timestamp finishMs) (timestamp startMs))
  else Err "Use whole finite epoch milliseconds between -10000000000000 and 10000000000000, with finish at or after start."

@label "Number and duration tools"
@description "Ordinary functions for percentages, discounts, bounded number-list statistics and fixed elapsed time. Each callable keeps its actual typed inputs and results. Number-list statistics reuse the existing owner: empty input has zero count/total and Nothing average/minimum/maximum."
@tags "utility" "numbers" "time"
numberTools : {
  percentageOf: (value: Number) -> (percent: Number) -> Result String Number,
  percentageChange: (before: Number) -> (after: Number) -> Result String Number,
  discountedTotal: (price: Number) -> (discountPercent: Number) -> Result String Number,
  numberStatistics: (values: List Number) -> NumberStatistics,
  mixedDuration: (hourCount: Number) -> (minuteCount: Number) -> (secondCount: Number) -> Result String FixedDurationTotal,
  elapsedSeconds: (startMs: Number) -> (finishMs: Number) -> Result String FixedDurationTotal
}
numberTools = { percentageOf = percentageOf, percentageChange = percentageChange, discountedTotal = discountedTotal, numberStatistics = numberStatistics, mixedDuration = mixedDuration, elapsedSeconds = elapsedSeconds }

utilityNumberStartingInputs : List ({ function: Any, arguments: List Any })
utilityNumberStartingInputs = [
  { function = percentageOf, arguments = [250, 15] },
  { function = percentageChange, arguments = [80, 100] },
  { function = discountedTotal, arguments = [120, 20] },
  { function = numberStatistics, arguments = [[12, 7, 18, 3, 10]] },
  { function = mixedDuration, arguments = [1, 6, 5] },
  { function = elapsedSeconds, arguments = [0, 2500] }
]
