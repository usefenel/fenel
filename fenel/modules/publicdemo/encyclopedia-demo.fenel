module EncyclopediaDemo where

using std (map, filter, find, length, unique, typeOf, countryFlag)
using set (contains)
using engine (SetExpr)

-- A bounded country encyclopedia over the existing repository Countries data.
-- The source rows' code/name/currency/language projection is explicit: their
-- Country declaration also names geographic fields that those rows omit.
-- Filtering, finite membership and the dependent input all use one code set.
-- No catalogue is copied, no storage is read or written, and no address is added.

@label "Country"
@description "A country's flag, name, code, currency and language, projected from Fenel's existing country reference data."
@discriminator "$tag"
@fieldLabel "EncyclopediaCountry.flag" "Flag"
@fieldLabel "EncyclopediaCountry.name" "Name"
@fieldLabel "EncyclopediaCountry.code" "Code"
@fieldLabel "EncyclopediaCountry.currency" "Currency"
@fieldLabel "EncyclopediaCountry.language" "Language"
EncyclopediaCountry = EncyclopediaCountry flag: String name: String code: String currency: String language: String

@label "Country Choice Result"
@description "The filtered reference rows, their finite code type, and the selected country. The type drives the same ordinary typed input."
@discriminator "$tag"
@fieldLabel "CountryEncyclopediaResult.currency" "Currency"
@fieldLabel "CountryEncyclopediaResult.countries" "Countries"
@fieldLabel "CountryEncyclopediaResult.count" "Count"
@fieldLabel "CountryEncyclopediaResult.codes" "Codes"
@fieldLabel "CountryEncyclopediaResult.countryCodeType" "Country Code Type"
@fieldLabel "CountryEncyclopediaResult.selected" "Selected"
@fieldLabel "CountryEncyclopediaResult.membership" "Membership"
@fieldLabel "CountryEncyclopediaResult.explanation" "Explanation"
CountryEncyclopediaResult = CountryEncyclopediaResult currency: String countries: List EncyclopediaCountry count: Nat codes: List String countryCodeType: Type selected: Maybe EncyclopediaCountry membership: Maybe Boolean explanation: String

-- B3 only: the host encodes the permanent $-key FenelType envelope using the
-- existing setExprAsType constructor. Base and constraint are chosen below.
@native
encyclopediaTypeFromSet : (base: Type) -> (constraint: SetExpr) -> Type

-- A2 source reflection only: the host supplies the already-loaded repository
-- country rows. Their selection and field projection remain Fenel below.
@native
encyclopediaSourceCountries : List ({ code: String, alpha3: String, name: String, dialCode: String, currency: String, language: String })

@label "Project the country catalogue"
@description "Reuse each existing country row's name, code, currency and language with its derived flag, preserving its order and data. This is a projection, not a second catalogue."
@fieldLabel "countries" "Countries"
encyclopediaProjectCountries : (countries: List ({ code: String, alpha3: String, name: String, dialCode: String, currency: String, language: String })) -> List EncyclopediaCountry
encyclopediaProjectCountries countries = map (\country -> EncyclopediaCountry { flag = countryFlag country.code, name = country.name, code = country.code, currency = country.currency, language = country.language }) countries

@label "Countries"
@description "The existing Fenel country reference data, projected to its present fields with a flag derived from each code. Browse it through the ordinary typed list and table lenses."
@tags "demo" "encyclopedia" "countries" "data"
encyclopediaCountries : List EncyclopediaCountry
encyclopediaCountries = encyclopediaProjectCountries (encyclopediaSourceCountries ())

@label "Filter countries by currency"
@description "Select reference rows whose currency exactly matches the supplied code. For example, EUR selects euro countries and USD selects dollar countries in this catalogue."
@tags "demo" "encyclopedia" "countries" "filter"
@fieldLabel "countries" "Countries"
@fieldLabel "currency" "Currency"
encyclopediaCountriesForCurrency : (countries: List EncyclopediaCountry) -> (currency: String) -> List EncyclopediaCountry
encyclopediaCountriesForCurrency countries currency = filter (\country -> country.currency == currency) countries

@label "Codes of the filtered countries"
@description "Project and deduplicate the same filtered rows' country codes, preserving their first occurrence."
@fieldLabel "countries" "Countries"
@fieldLabel "currency" "Currency"
encyclopediaCountryCodesForCurrency : (countries: List EncyclopediaCountry) -> (currency: String) -> List String
encyclopediaCountryCodesForCurrency countries currency = encyclopediaCountryCodes (encyclopediaCountriesForCurrency countries currency)

encyclopediaCountryCodes : (countries: List EncyclopediaCountry) -> List String
encyclopediaCountryCodes countries = unique (map (\country -> country.code) countries)

@label "Filtered country code set"
@description "The finite set contains exactly the codes of the filtered reference rows. An unknown currency yields an empty set."
@fieldLabel "countries" "Countries"
@fieldLabel "currency" "Currency"
encyclopediaCountryCodeSet : (countries: List EncyclopediaCountry) -> (currency: String) -> SetExpr
encyclopediaCountryCodeSet countries currency = SeEnum { values = encyclopediaCountryCodesForCurrency countries currency }

@label "Type of a filtered country code"
@description "Derive a String member type from the same finite code set. This runtime type supplies the ordinary dependent input's choices and membership check."
@tags "demo" "encyclopedia" "countries" "type"
@fieldLabel "countries" "Countries"
@fieldLabel "currency" "Currency"
encyclopediaCountryCodeType : (countries: List EncyclopediaCountry) -> (currency: String) -> Type
encyclopediaCountryCodeType countries currency = encyclopediaTypeFromSet (typeOf "") (encyclopediaCountryCodeSet countries currency)

@label "Type of a country choice"
@description "Choose a currency and derive its country-code type from the existing reference catalogue. The catalogue stays shared data, outside the editable Call arguments."
@tags "demo" "encyclopedia" "countries" "type"
@fieldLabel "currency" "Currency"
countryCodeType : (currency: String) -> Type
countryCodeType currency = encyclopediaCountryCodeType (encyclopediaCountries ()) currency

@label "Countries using one currency"
@description "Filter the existing country catalogue by an exact currency code. EUR and USD produce different ordinary country tables. An unknown code produces an empty table."
@tags "demo" "encyclopedia" "countries" "filter"
@fieldLabel "currency" "Currency"
countriesUsingCurrency : (currency: String) -> List EncyclopediaCountry
countriesUsingCurrency currency = encyclopediaCountriesForCurrency (encyclopediaCountries ()) currency

@label "Countries become a typed choice"
@description "Browse the existing country data, change EUR to USD, and choose from the filtered country codes. The same Fenel computation supplies the rows, finite type and checked choice. No data is saved."
@tags "demo" "encyclopedia" "countries" "filter" "dependent" "picker"
@fieldLabel "currency" "Currency"
@fieldLabel "countryCode" "Country Code"
countryEncyclopedia : (currency: String) -> (countryCode: countryCodeType currency) -> CountryEncyclopediaResult
countryEncyclopedia currency countryCode = countryEncyclopediaFrom (encyclopediaCountries ()) currency countryCode

countryEncyclopediaFrom : (countries: List EncyclopediaCountry) -> (currency: String) -> (countryCode: encyclopediaCountryCodeType countries currency) -> CountryEncyclopediaResult
countryEncyclopediaFrom countries currency countryCode =
  let selectedCountries = encyclopediaCountriesForCurrency countries currency
  let codes = encyclopediaCountryCodes selectedCountries
  let constraint = SeEnum { values = codes }
  let countryCodeType = encyclopediaTypeFromSet (typeOf "") constraint
  let selected = find (\country -> country.code == countryCode) selectedCountries
  let membership = set.contains constraint countryCode
  CountryEncyclopediaResult { currency = currency, countries = selectedCountries, count = length selectedCountries, codes = codes, countryCodeType = countryCodeType, selected = selected, membership = membership, explanation = "The country rows are existing Fenel reference data. Filtering their currency produces both this table and a finite country-code type. That same type directs the country input. Change the currency, then choose a country in the new result. No data is saved." }

-- The source owns the starting callable and arguments. Each public wrapper
-- reuses the repository catalogue; no second country list is embedded.
encyclopediaDemoStartingInputs : List ({ function: Any, arguments: List Any })
encyclopediaDemoStartingInputs = [
  { function = countryEncyclopedia, arguments = ["EUR", "FR"] },
  { function = countriesUsingCurrency, arguments = ["EUR"] },
  { function = countryCodeType, arguments = ["EUR"] }
]
