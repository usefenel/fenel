module ClaimsDemo where

using std (all, elem, find, length, numberIsFinite, floor, isArray, isNumber, isString)
using prover (EpistemicStatus, UnprovedReason, VerifyError)

-- Claims are ordinary source-owned data. The certificate examples admit only
-- small closed finite sets of numbers or currency-code strings. They use the
-- existing proposition builder, untrusted proposer and kernel; no synthesis,
-- inhabited/search witness, named-set lookup or new evidence rule is involved.
-- A finite observation has no kernel certificate and makes no universal claim.

@label "Named claim"
@description "A named claim with its callable definition, explicit domain, actual evidence grade, optional proposed certificate and exact kernel verdict. Sample observations and unknowns carry no certificate."
NamedClaim = NamedClaim
  title: String
  definition: Any
  domain: String
  claim: Any
  evidence: EpistemicStatus
  certificate: Maybe Any
  kernelVerdict: Maybe (Result VerifyError EpistemicStatus)
  samples: List Any
  explanation: String
  related: List Any

ClaimsKernelReport = ClaimsKernelReport
  claim: Any
  proposal: Result UnprovedReason Any
  verdict: Maybe (Result VerifyError EpistemicStatus)

-- These bodyless declarations are existing A4/B3 boundary forwards. Their
-- host implementations only call the canonical authored builder/proposer and
-- kernel. The eligibility, bounds, observations and presentation stay here.
@native
@category "engine-internal"
claimsDemoNumberSubset : (members: List Number) -> (allowed: List Number) -> ClaimsKernelReport

@native
@category "engine-internal"
claimsDemoCurrencySubset : (requested: List String) -> (supported: List String) -> ClaimsKernelReport

claimsWholeNumber : (candidate: Number) -> Bool
claimsWholeNumber candidate = isNumber candidate && numberIsFinite candidate && candidate >= -20 && candidate <= 20 && floor candidate == candidate

claimsCurrencyCode : (candidate: String) -> Bool
claimsCurrencyCode candidate = isString candidate && length candidate == 3

@label "Positive number predicate"
@description "The ordinary Fenel predicate used by the sample examples. A returned Boolean describes one number; it is not a proof that every number is positive."
@tags "demo" "claim" "predicate"
claimPositive : (candidate: Number) -> Bool
claimPositive candidate = candidate > 0

claimsRefusedCheck : (title: String) -> (definition: Any) -> (domain: String) -> (claim: Any) -> (proof: Any) -> (verdict: Result VerifyError EpistemicStatus) -> NamedClaim
claimsRefusedCheck title definition domain claim proof verdict = NamedClaim { title = title, definition = definition, domain = domain, claim = claim, evidence = (Unknown), certificate = Just proof, kernelVerdict = Just verdict, samples = [], explanation = "The kernel refused the proposed certificate. Inspect its exact rejection; this claim has no accepted certificate.", related = [] }

claimsChecked : (title: String) -> (definition: Any) -> (domain: String) -> (report: ClaimsKernelReport) -> (missing: Maybe Any) -> NamedClaim
claimsChecked title definition domain report missing = case report.proposal of
  Ok proof ->
    case report.verdict of
      Nothing -> NamedClaim { title = title, definition = definition, domain = domain, claim = report.claim, evidence = (Unknown), certificate = Just proof, kernelVerdict = Nothing, samples = [], explanation = "A proposal without a kernel verdict has no accepted certificate.", related = [] }
      Just verdict -> case verdict of
        Ok grade -> NamedClaim { title = title, definition = definition, domain = domain, claim = report.claim, evidence = grade, certificate = Just proof, kernelVerdict = Just verdict, samples = [], explanation = "The existing kernel re-checked this closed finite-set claim. The displayed grade is its actual verdict; SolverChecked is distinct from Proven.", related = [] }
        Err error -> claimsRefusedCheck title definition domain report.claim proof verdict
  Err reason -> case missing of
    Just witness -> NamedClaim { title = title, definition = definition, domain = domain, claim = report.claim, evidence = Refuted { counterexample = witness }, certificate = Nothing, kernelVerdict = Nothing, samples = [], explanation = "This supplied member is absent from the supplied allowed set. It is a concrete counterexample, with no accepted certificate.", related = [] }
    Nothing -> NamedClaim { title = title, definition = definition, domain = domain, claim = report.claim, evidence = (Unknown), certificate = Nothing, kernelVerdict = Nothing, samples = [], explanation = "The proposer did not supply an accepted certificate and no concrete counterexample was established.", related = [] }

@label "Check a finite number subset"
@description "Compare two small closed finite number sets through the existing proposer and kernel. Removing an allowed member exposes that exact counterexample. Each list admits at most 12 whole numbers from -20 through 20."
@tags "demo" "claim" "mathematics" "set"
finiteNumberSubset : (members: List Number) -> (allowed: List Number) -> Result String NamedClaim
finiteNumberSubset members allowed =
  if isArray members && isArray allowed && length members <= 12 && length allowed <= 12 && all members claimsWholeNumber && all allowed claimsWholeNumber
  then
    let report = claimsDemoNumberSubset members allowed
    let missing = find (\candidate -> not (elem candidate allowed)) members
    Ok (claimsChecked "Every supplied number is allowed" finiteNumberSubset "Two closed finite sets of whole numbers from -20 through 20" report missing)
  else Err "Use at most 12 whole numbers from -20 through 20 in each set."

@label "Check payment currency choices"
@description "An ordinary domain claim: every requested currency belongs to the merchant's displayed supported set. Uses finite-set certificates, not rates or financial advice. Each list admits at most 12 three-character codes."
@tags "demo" "claim" "commerce" "set"
paymentCurrencyChoices : (requested: List String) -> (supported: List String) -> Result String NamedClaim
paymentCurrencyChoices requested supported =
  if isArray requested && isArray supported && length requested <= 12 && length supported <= 12 && all requested claimsCurrencyCode && all supported claimsCurrencyCode
  then
    let report = claimsDemoCurrencySubset requested supported
    let missing = find (\candidate -> not (elem candidate supported)) requested
    Ok (claimsChecked "Requested currencies are supported" paymentCurrencyChoices "Two closed finite sets of three-character currency-code strings" report missing)
  else Err "Use at most 12 three-character currency codes in each set."

@label "Check positive-number samples"
@description "Actually call the Fenel positive-number predicate on the supplied samples. Passing finite observations are SampleTested, a nonpositive value is Refuted, and no samples is Unknown. No theorem certificate is created. At most 12 whole numbers from -20 through 20 are admitted."
@tags "demo" "claim" "samples" "counterexample"
positiveNumberSamples : (samples: List Number) -> Result String NamedClaim
positiveNumberSamples samples =
  if isArray samples && length samples <= 12 && all samples claimsWholeNumber
  then Ok (positiveNumberSampleResult samples)
  else Err "Use at most 12 whole-number samples from -20 through 20."

positiveNumberSampleResult : (samples: List Number) -> NamedClaim
positiveNumberSampleResult samples =
  let claim = { predicate = claimPositive, suppliedSamples = samples }
  if length samples == 0
  then NamedClaim { title = "The supplied numbers are positive", definition = claimPositive, domain = "Only the explicitly supplied finite samples", claim = claim, evidence = (Unknown), certificate = Nothing, kernelVerdict = Nothing, samples = samples, explanation = "No samples were supplied. There is no observed success, counterexample or theorem certificate.", related = [positiveNumberSamples] }
  else case find (\candidate -> not (claimPositive candidate)) samples of
    Just witness -> NamedClaim { title = "The supplied numbers are positive", definition = claimPositive, domain = "Only the explicitly supplied finite samples", claim = claim, evidence = Refuted { counterexample = witness }, certificate = Nothing, kernelVerdict = Nothing, samples = samples, explanation = "The Fenel predicate returned false for this exact supplied number. This concrete counterexample refutes the displayed sample claim.", related = [positiveNumberSamples] }
    Nothing -> NamedClaim { title = "The supplied numbers are positive", definition = claimPositive, domain = "Only the explicitly supplied finite samples", claim = claim, evidence = SampleTested (length samples), certificate = Nothing, kernelVerdict = Nothing, samples = samples, explanation = "The Fenel predicate returned true for each supplied sample. This observation says nothing about untested numbers and is not a theorem certificate.", related = [positiveNumberSamples] }

@label "Every number is positive?"
@description "An open-domain claim remains Unknown here: this collection supplies neither a universal proof nor a counterexample search. Open the related finite sample check to observe particular values."
@tags "demo" "claim" "unknown"
openPositiveClaim : NamedClaim
openPositiveClaim = NamedClaim { title = "Every number is positive?", definition = claimPositive, domain = "The unbounded Number domain", claim = { predicate = claimPositive, quantifier = "every Number" }, evidence = (Unknown), certificate = Nothing, kernelVerdict = Nothing, samples = [], explanation = "No universal proof or domain search was run for this open claim. A sample result must not be promoted into a theorem.", related = [positiveNumberSamples, claimPositive] }

@label "Named claims library"
@description "Browse the finite-set checks, real positive-number observations, a concrete counterexample and an unknown open claim as ordinary Fenel data. Each record links its own callable definition and states the exact evidence boundary."
@tags "demo" "claim" "library"
namedClaims : List NamedClaim
namedClaims = [
  claimsStartingResult (finiteNumberSubset [1, 2] [1, 2, 3]),
  claimsStartingResult (paymentCurrencyChoices ["EUR", "USD"] ["EUR", "USD", "GBP"]),
  claimsStartingResult (positiveNumberSamples [1, 2, 3]),
  claimsStartingResult (positiveNumberSamples [1, -2, 3]),
  openPositiveClaim ()
]

claimsStartingResult : (result: Result String NamedClaim) -> NamedClaim
claimsStartingResult result = case result of
  Ok claim -> claim
  Err reason -> NamedClaim { title = "Starting claim was refused", definition = namedClaims, domain = "The source-owned starting inputs", claim = { refusal = reason }, evidence = (Unknown), certificate = Nothing, kernelVerdict = Nothing, samples = [], explanation = reason, related = [] }

claimsDemoStartingInputs : List ({ function: Any, arguments: List Any })
claimsDemoStartingInputs = [
  { function = finiteNumberSubset, arguments = [[1, 2], [1, 2, 3]] },
  { function = paymentCurrencyChoices, arguments = [["EUR", "USD"], ["EUR", "USD", "GBP"]] },
  { function = positiveNumberSamples, arguments = [[1, 2, 3]] },
  { function = positiveNumberSamples, arguments = [[1, -2, 3]] }
]
