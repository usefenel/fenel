module RecipeDemo where

import std (map, filter, find, head, all, includes, unique, length, numberIsFinite, floor, isArray)

-- GP-56's bounded browser-local slice: catalogue rows, rules and a schedule
-- are ordinary Fenel data. Pure predicates join ingredient ids to food rows,
-- explain every decision and choose the same result's funnel branch.
-- The pantry records available ids, not quantities. Catalogue classifications
-- and preparation times are authored examples, not nutrition or health claims.

@label "Ingredient grouping"
@description "An authored grouping used by the plant-only preference rule. Inspect and edit the supplied food catalogue to change the grouping."
RecipeFoodKind = RecipePlant | RecipeAnimal

@label "Food catalogue row"
RecipeFood = RecipeFood id: String name: String kind: RecipeFoodKind notes: String

@label "Recipe catalogue row"
@description "Ingredient ids refer to the food catalogue. The planner accepts finite whole preparation minutes from 0 through 240. The example tracks availability by id, without quantities or nutritional calculations."
RecipeDefinition = RecipeDefinition id: String name: String ingredientIds: List String preparationMinutes: Number

@label "Preparation window"
@description "Finite whole minutes after midnight from 0 through 1440, validated by the planner. Preparation starts at startMinute and must finish by finishMinute on the same authored day. Equal endpoints leave zero minutes; no clock is read."
RecipeSchedule = RecipeSchedule startMinute: Number finishMinute: Number

@label "Ingredient preference"
RecipeIngredientPolicy = RecipeAnyIngredients | RecipePlantIngredientsOnly

@label "Recipe rules"
@description "Change the preparation maximum, ingredient preference or personal exclusions. The planner accepts finite whole maximum minutes from 0 through 240; exclusions are exact supplied food ids."
RecipeRules = RecipeRules maximumPreparationMinutes: Number ingredientPolicy: RecipeIngredientPolicy excludedFoodIds: List String

@label "Recipe planning input"
@description "Edit catalogue rows, available food ids, the schedule or rules. Food and recipe ids must be unique; at most 24 foods, 12 recipes and 12 ingredient ids per recipe."
RecipePlanInput = RecipePlanInput foods: List RecipeFood recipes: List RecipeDefinition availableFoodIds: List String schedule: RecipeSchedule rules: RecipeRules

@label "Named recipe rule"
RecipeRuleKind = RecipeIngredientsPresent | RecipeCatalogueKnown | RecipePantryAvailable | RecipePreferenceMatches | RecipeExclusionsAllowed | RecipeMaximumFits | RecipeScheduleFits

@label "Recipe rule reason"
@description "A pure rule's Boolean verdict, the affected food ids and its explanation. This is an evaluated predicate, not a proof certificate."
RecipeRuleReason = RecipeRuleReason rule: RecipeRuleKind passed: Bool affectedFoodIds: List String explanation: String

@label "Recipe decision"
@description "Every named reason remains visible for eligible and ineligible recipes. Eligibility is the conjunction of those same verdicts."
RecipeDecision = RecipeDecision recipe: RecipeDefinition eligible: Bool reasons: List RecipeRuleReason

@label "Recipe funnel branch"
@description "A pure conditional outcome from the same eligible recipes: adjust inputs, offer the single match, or choose among several. No page is published or submitted."
RecipeFunnel = RecipeAdjustInputs message: String
  | RecipeOfferOne recipeId: String
  | RecipeChooseSeveral recipeIds: List String

@label "Recipe plan"
@description "Keep the actual input, each decision and the source-ordered eligible recipes beside their derived funnel branch. The planner returns Err for invalid bounds or ambiguous catalogue identities."
RecipePlan = RecipePlan input: RecipePlanInput availableMinutes: Number decisions: List RecipeDecision eligibleRecipes: List RecipeDefinition funnel: RecipeFunnel explanation: String

recipeIdAdmitted : (id: String) -> Bool
recipeIdAdmitted id = length id > 0 && length id <= 64

recipeNameAdmitted : (name: String) -> Bool
recipeNameAdmitted name = length name > 0 && length name <= 80

recipeWholeMinutesAdmitted : (maximum: Number) -> (minutes: Number) -> Bool
recipeWholeMinutesAdmitted maximum minutes = numberIsFinite minutes && minutes >= 0 && minutes <= maximum && floor minutes == minutes

recipeFoodAdmitted : (food: RecipeFood) -> Bool
recipeFoodAdmitted food = recipeIdAdmitted food.id && recipeNameAdmitted food.name && length food.notes <= 240 && recipeFoodKindAdmitted food.kind

recipeFoodKindAdmitted : (kind: RecipeFoodKind) -> Bool
recipeFoodKindAdmitted kind = case kind of
  RecipePlant -> true
  RecipeAnimal -> true
  _ -> false

recipePolicyAdmitted : (policy: RecipeIngredientPolicy) -> Bool
recipePolicyAdmitted policy = case policy of
  RecipeAnyIngredients -> true
  RecipePlantIngredientsOnly -> true
  _ -> false

recipeDefinitionAdmitted : (recipe: RecipeDefinition) -> Bool
recipeDefinitionAdmitted recipe = isArray recipe.ingredientIds && recipeIdAdmitted recipe.id && recipeNameAdmitted recipe.name && length recipe.ingredientIds <= 12 && all recipe.ingredientIds recipeIdAdmitted && length (unique recipe.ingredientIds) == length recipe.ingredientIds && recipeWholeMinutesAdmitted 240 recipe.preparationMinutes

@label "Find an ingredient in the catalogue"
recipeFindFood : (foods: List RecipeFood) -> (id: String) -> Maybe RecipeFood
recipeFindFood foods id = find (\food -> food.id == id) foods

recipeFoodKnown : (foods: List RecipeFood) -> (id: String) -> Bool
recipeFoodKnown foods id = case recipeFindFood foods id of
  Nothing -> false
  Just food -> true

recipeFoodIsPlant : (foods: List RecipeFood) -> (id: String) -> Bool
recipeFoodIsPlant foods id = case recipeFindFood foods id of
  Nothing -> false
  Just food -> case food.kind of
    RecipePlant -> true
    RecipeAnimal -> false

recipePreferenceFailures : (input: RecipePlanInput) -> (recipe: RecipeDefinition) -> List String
recipePreferenceFailures input recipe = case input.rules.ingredientPolicy of
  RecipeAnyIngredients -> []
  RecipePlantIngredientsOnly -> filter (\id -> not (recipeFoodIsPlant input.foods id)) recipe.ingredientIds

recipePlanRowsAdmitted : (input: RecipePlanInput) -> Bool
recipePlanRowsAdmitted input =
  let foodIds = map (\food -> food.id) input.foods
  let recipeIds = map (\recipe -> recipe.id) input.recipes
  all input.foods recipeFoodAdmitted && all input.recipes recipeDefinitionAdmitted && length (unique foodIds) == length foodIds && length (unique recipeIds) == length recipeIds && length (unique input.availableFoodIds) == length input.availableFoodIds && length (unique input.rules.excludedFoodIds) == length input.rules.excludedFoodIds && all input.availableFoodIds (recipeFoodKnown input.foods) && all input.rules.excludedFoodIds (recipeFoodKnown input.foods) && recipePolicyAdmitted input.rules.ingredientPolicy && recipeWholeMinutesAdmitted 240 input.rules.maximumPreparationMinutes && recipeWholeMinutesAdmitted 1440 input.schedule.startMinute && recipeWholeMinutesAdmitted 1440 input.schedule.finishMinute && input.schedule.finishMinute >= input.schedule.startMinute

recipePlanAdmitted : (input: RecipePlanInput) -> Bool
recipePlanAdmitted input =
  if isArray input.foods && isArray input.recipes && isArray input.availableFoodIds && isArray input.rules.excludedFoodIds && length input.foods <= 24 && length input.recipes <= 12 && length input.availableFoodIds <= 24 && length input.rules.excludedFoodIds <= 24 then recipePlanRowsAdmitted input
  else false

@label "Explain the recipe rules"
@description "Join ingredient ids to the supplied catalogue and evaluate seven ordinary predicates, in a stable order. Unknown ingredients remain explicit failures; changing an input or rule changes these same reasons."
recipeReasons : (input: RecipePlanInput) -> (recipe: RecipeDefinition) -> List RecipeRuleReason
recipeReasons input recipe =
  let unknown = filter (\id -> not (recipeFoodKnown input.foods id)) recipe.ingredientIds
  let missing = filter (\id -> not (includes input.availableFoodIds id)) recipe.ingredientIds
  let preference = recipePreferenceFailures input recipe
  let excluded = filter (\id -> includes input.rules.excludedFoodIds id) recipe.ingredientIds
  let availableMinutes = input.schedule.finishMinute - input.schedule.startMinute
  [
    RecipeRuleReason { rule = RecipeIngredientsPresent, passed = length recipe.ingredientIds > 0, affectedFoodIds = [], explanation = "A recipe must list at least one ingredient id." },
    RecipeRuleReason { rule = RecipeCatalogueKnown, passed = length unknown == 0, affectedFoodIds = unknown, explanation = "Every ingredient id must refer to one row in the supplied food catalogue." },
    RecipeRuleReason { rule = RecipePantryAvailable, passed = length missing == 0, affectedFoodIds = missing, explanation = "Every ingredient id must appear in the available pantry ids. This rule does not track quantities." },
    RecipeRuleReason { rule = RecipePreferenceMatches, passed = length preference == 0, affectedFoodIds = preference, explanation = "The plant-only preference accepts ingredients classified RecipePlant in this authored catalogue; the any-ingredients preference imposes no grouping restriction." },
    RecipeRuleReason { rule = RecipeExclusionsAllowed, passed = length excluded == 0, affectedFoodIds = excluded, explanation = "No ingredient id may appear in the supplied personal exclusions." },
    RecipeRuleReason { rule = RecipeMaximumFits, passed = recipe.preparationMinutes <= input.rules.maximumPreparationMinutes, affectedFoodIds = [], explanation = "Preparation minutes must be at most the authored maximum, including equality." },
    RecipeRuleReason { rule = RecipeScheduleFits, passed = recipe.preparationMinutes <= availableMinutes, affectedFoodIds = [], explanation = "Preparation must fit between the authored start and finish minutes, including equality." }
  ]

@label "Evaluate one recipe"
@description "Eligibility uses exactly the displayed reasons. The planner first checks its input bounds and unique catalogue identities."
recipeDecision : (input: RecipePlanInput) -> (recipe: RecipeDefinition) -> RecipeDecision
recipeDecision input recipe =
  let reasons = recipeReasons input recipe
  RecipeDecision { recipe = recipe, eligible = all reasons (\reason -> reason.passed), reasons = reasons }

@label "Choose the recipe funnel branch"
@description "The same source-ordered eligible recipes drive a conditional offer, choice or request to change inputs. This is pure data, with no saved or submitted funnel."
recipeFunnel : (recipes: List RecipeDefinition) -> RecipeFunnel
recipeFunnel recipes = case head recipes of
  Nothing -> RecipeAdjustInputs { message = "No recipe matches every authored rule. Inspect the failed reasons, then change the pantry, schedule or rules." }
  Just recipe ->
    if length recipes == 1 then RecipeOfferOne { recipeId = recipe.id }
    else RecipeChooseSeveral { recipeIds = map (\recipe -> recipe.id) recipes }

@label "Plan recipes from rules"
@description "Open Call and edit the pantry, preparation window, rules or recipe catalogue. Inspect which recipes match, every named reason and the same decision's funnel branch. No data is saved."
@tags "demo" "recipes" "rules" "schedule" "funnel"
planRecipes : (input: RecipePlanInput) -> Result String RecipePlan
planRecipes input =
  if recipePlanAdmitted input then
    let decisions = map (recipeDecision input) input.recipes
    let eligible = map (\decision -> decision.recipe) (filter (\decision -> decision.eligible) decisions)
    Ok (RecipePlan { input = input, availableMinutes = input.schedule.finishMinute - input.schedule.startMinute, decisions = decisions, eligibleRecipes = eligible, funnel = recipeFunnel eligible, explanation = "Fenel predicates join the supplied food and recipe rows, check pantry ids and authored rules, then choose a funnel branch from those same eligible recipes. Pantry availability records ids, not quantities. Open Call and edit an input to recompute; no data is saved." })
  else Err "Use at most 24 unique food ids and 12 unique recipe ids; ids are 1 to 64 characters, names 1 to 80, notes at most 240. Each recipe has at most 12 unique ingredient ids. Available and excluded ids must be unique, refer to the food catalogue and each list has at most 24 items. Preparation limits are whole minutes from 0 to 240; schedule endpoints are whole minutes from 0 to 1440, with finish at or after start. Food groupings and ingredient preferences must use their declared constructors."

@label "Example food catalogue"
@description "Eight ordinary typed food rows, with authored groupings used by the preference rule. Open each row to inspect or change its data."
recipeFoodCatalogue : List RecipeFood
recipeFoodCatalogue = [
  RecipeFood { id = "chickpeas", name = "Chickpeas", kind = RecipePlant, notes = "Example pantry ingredient." },
  RecipeFood { id = "tomato", name = "Tomato", kind = RecipePlant, notes = "Used by the bowl and toast recipes." },
  RecipeFood { id = "cucumber", name = "Cucumber", kind = RecipePlant, notes = "Used by the chickpea bowl." },
  RecipeFood { id = "olive-oil", name = "Olive oil", kind = RecipePlant, notes = "Used by the chickpea bowl." },
  RecipeFood { id = "bread", name = "Bread", kind = RecipePlant, notes = "This catalogue's example bread is classified as plant-based." },
  RecipeFood { id = "egg", name = "Egg", kind = RecipeAnimal, notes = "Used by egg toast." },
  RecipeFood { id = "chicken", name = "Chicken", kind = RecipeAnimal, notes = "Absent from the starting pantry." },
  RecipeFood { id = "rice", name = "Rice", kind = RecipePlant, notes = "Absent from the starting pantry." }
]

@label "Example recipe catalogue"
@description "Four authored recipes with ingredient links and example preparation times."
recipeCatalogue : List RecipeDefinition
recipeCatalogue = [
  RecipeDefinition { id = "chickpea-bowl", name = "Chickpea bowl", ingredientIds = ["chickpeas", "tomato", "cucumber", "olive-oil"], preparationMinutes = 12 },
  RecipeDefinition { id = "tomato-toast", name = "Tomato toast", ingredientIds = ["tomato", "bread"], preparationMinutes = 8 },
  RecipeDefinition { id = "egg-toast", name = "Egg toast", ingredientIds = ["egg", "bread"], preparationMinutes = 10 },
  RecipeDefinition { id = "chicken-rice", name = "Chicken and rice", ingredientIds = ["chicken", "rice"], preparationMinutes = 45 }
]

@label "Starting recipe rules"
recipeStartingRules : RecipeRules
recipeStartingRules = RecipeRules { maximumPreparationMinutes = 30, ingredientPolicy = RecipePlantIngredientsOnly, excludedFoodIds = [] }

@label "Starting recipe input"
@description "A 20-minute window and plant-only preference offer the chickpea bowl and tomato toast. Egg toast fails the preference; chicken and rice also fails availability and both time rules."
recipeStartingInput : RecipePlanInput
recipeStartingInput = RecipePlanInput { foods = recipeFoodCatalogue (), recipes = recipeCatalogue (), availableFoodIds = ["chickpeas", "tomato", "cucumber", "olive-oil", "bread", "egg"], schedule = RecipeSchedule { startMinute = 720, finishMinute = 740 }, rules = recipeStartingRules () }

@label "Try a preparation window"
@description "Change finite whole start and finish minutes from 0 through 1440, with finish at or after start; invalid input returns Err. The inclusive eight-minute window offers only tomato toast; a five-minute window has no matches."
@tags "demo" "recipes" "schedule" "funnel"
recipesInWindow : (startMinute: Number) -> (finishMinute: Number) -> Result String RecipePlan
recipesInWindow startMinute finishMinute =
  let initial = recipeStartingInput ()
  planRecipes (RecipePlanInput { foods = initial.foods, recipes = initial.recipes, availableFoodIds = initial.availableFoodIds, schedule = RecipeSchedule { startMinute = startMinute, finishMinute = finishMinute }, rules = initial.rules })

@label "Try different recipe rules"
@description "Edit the same typed rules. Allow any ingredient grouping to admit egg toast, or exclude tomato to remove both starting plant recipes. The same reasons and funnel branch update."
@tags "demo" "recipes" "rules" "funnel"
recipesWithRules : (rules: RecipeRules) -> Result String RecipePlan
recipesWithRules rules =
  let initial = recipeStartingInput ()
  planRecipes (RecipePlanInput { foods = initial.foods, recipes = initial.recipes, availableFoodIds = initial.availableFoodIds, schedule = initial.schedule, rules = rules })

recipeDemoStartingInputs : List ({ function: Any, arguments: List Any })
recipeDemoStartingInputs = [
  { function = planRecipes, arguments = [recipeStartingInput ()] },
  { function = recipesInWindow, arguments = [720, 728] },
  { function = recipesWithRules, arguments = [recipeStartingRules ()] },
  { function = recipeFoodCatalogue, arguments = [] },
  { function = recipeCatalogue, arguments = [] }
]
