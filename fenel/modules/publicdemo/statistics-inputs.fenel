module StatisticsDemo where

@label "Sample number data"
statisticsSampleNumbers : List Number
statisticsSampleNumbers = [12, 7, 18, 3, 10]

@label "Sample customers"
statisticsSampleCustomers : List StatisticsCustomer
statisticsSampleCustomers = [
  StatisticsCustomer { id = "ada", name = "Ada" },
  StatisticsCustomer { id = "bo", name = "Bo" },
  StatisticsCustomer { id = "cy", name = "Cy" }
]

@label "Sample purchases"
statisticsSamplePurchases : List StatisticsPurchase
statisticsSamplePurchases = [
  StatisticsPurchase { id = "p1", customerId = "ada", amountCents = 1200 },
  StatisticsPurchase { id = "p2", customerId = "ada", amountCents = 800 },
  StatisticsPurchase { id = "p3", customerId = "bo", amountCents = 1500 },
  StatisticsPurchase { id = "p4", customerId = "guest", amountCents = 500 }
]

@label "Sample customer totals"
@description "The typed per-customer summaries derived from the sample rows, ready for the existing table lens."
statisticsSampleBreakdown : List CustomerPurchaseSummary
statisticsSampleBreakdown = statisticsPurchaseBreakdown (statisticsSampleCustomers ()) (statisticsSamplePurchases ())

-- Callable inputs retain references to the same source-owned functions.
statisticsDemoStartingInputs : List ({ function: Any, arguments: List Any })
statisticsDemoStartingInputs = [
  { function = numberStatistics, arguments = [statisticsSampleNumbers ()] },
  { function = purchaseStatistics, arguments = [statisticsSampleCustomers (), statisticsSamplePurchases ()] },
  { function = customerBreakdown, arguments = [statisticsSampleCustomers (), statisticsSamplePurchases ()] },
  { function = numberChart, arguments = [statisticsSampleNumbers ()] }
]
