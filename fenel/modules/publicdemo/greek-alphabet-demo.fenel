@label "Sources and scope of the Greek alphabet"
greekAlphabetSources : GreekAlphabetSources
greekAlphabetSources = GreekAlphabetSources { release = "Unicode 17.0.0", orthography = "https://ebooks.edu.gr/ebooks/v/html/8547/2334/Grammatiki-Neas-Ellinikis-Glossas_A-B-G-Gymnasiou_html-apli/index_B_03.html", unicodeData = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt", scripts = "https://www.unicode.org/Public/17.0.0/ucd/Scripts.txt", blocks = "https://www.unicode.org/Public/17.0.0/ucd/Blocks.txt", casing = "https://www.unicode.org/Public/17.0.0/ucd/SpecialCasing.txt", license = "https://www.unicode.org/license.txt", scope = "All 24 modern Greek base letters: 24 capitals and 25 lowercase forms including final sigma. This is an orthographic alphabet, not all Greek-script characters or the entire Greek and Coptic block. The text exercise accepts 1–16 unaccented alphabet codepoints; accents, combining marks, spaces, punctuation and mathematical variants remain outside this explicit exercise." }

@label "Greek alphabet"
@description "Browse all 24 base letters in alphabetic order. The Greek names and both sigma forms follow the Greek education ministry's modern grammar table; Unicode names use the official spelling LAMDA."
@tags "demo" "encyclopedia" "greek" "alphabet" "data"
greekAlphabet : List GreekAlphabetLetter
greekAlphabet = [
  GreekAlphabetLetter { order = 1, name = "Alpha", greekName = "άλφα", unicodeStem = "ALPHA", capital = "Α", capitalCode = "U+0391", small = "α", smallCode = "U+03B1", lowercaseForms = ["α"], vowel = true },
  GreekAlphabetLetter { order = 2, name = "Beta", greekName = "βήτα", unicodeStem = "BETA", capital = "Β", capitalCode = "U+0392", small = "β", smallCode = "U+03B2", lowercaseForms = ["β"], vowel = false },
  GreekAlphabetLetter { order = 3, name = "Gamma", greekName = "γάμα", unicodeStem = "GAMMA", capital = "Γ", capitalCode = "U+0393", small = "γ", smallCode = "U+03B3", lowercaseForms = ["γ"], vowel = false },
  GreekAlphabetLetter { order = 4, name = "Delta", greekName = "δέλτα", unicodeStem = "DELTA", capital = "Δ", capitalCode = "U+0394", small = "δ", smallCode = "U+03B4", lowercaseForms = ["δ"], vowel = false },
  GreekAlphabetLetter { order = 5, name = "Epsilon", greekName = "έψιλον", unicodeStem = "EPSILON", capital = "Ε", capitalCode = "U+0395", small = "ε", smallCode = "U+03B5", lowercaseForms = ["ε"], vowel = true },
  GreekAlphabetLetter { order = 6, name = "Zeta", greekName = "ζήτα", unicodeStem = "ZETA", capital = "Ζ", capitalCode = "U+0396", small = "ζ", smallCode = "U+03B6", lowercaseForms = ["ζ"], vowel = false },
  GreekAlphabetLetter { order = 7, name = "Eta", greekName = "ήτα", unicodeStem = "ETA", capital = "Η", capitalCode = "U+0397", small = "η", smallCode = "U+03B7", lowercaseForms = ["η"], vowel = true },
  GreekAlphabetLetter { order = 8, name = "Theta", greekName = "θήτα", unicodeStem = "THETA", capital = "Θ", capitalCode = "U+0398", small = "θ", smallCode = "U+03B8", lowercaseForms = ["θ"], vowel = false },
  GreekAlphabetLetter { order = 9, name = "Iota", greekName = "γιώτα", unicodeStem = "IOTA", capital = "Ι", capitalCode = "U+0399", small = "ι", smallCode = "U+03B9", lowercaseForms = ["ι"], vowel = true },
  GreekAlphabetLetter { order = 10, name = "Kappa", greekName = "κάπα", unicodeStem = "KAPPA", capital = "Κ", capitalCode = "U+039A", small = "κ", smallCode = "U+03BA", lowercaseForms = ["κ"], vowel = false },
  GreekAlphabetLetter { order = 11, name = "Lambda", greekName = "λάμδα", unicodeStem = "LAMDA", capital = "Λ", capitalCode = "U+039B", small = "λ", smallCode = "U+03BB", lowercaseForms = ["λ"], vowel = false },
  GreekAlphabetLetter { order = 12, name = "Mu", greekName = "μι", unicodeStem = "MU", capital = "Μ", capitalCode = "U+039C", small = "μ", smallCode = "U+03BC", lowercaseForms = ["μ"], vowel = false },
  GreekAlphabetLetter { order = 13, name = "Nu", greekName = "νι", unicodeStem = "NU", capital = "Ν", capitalCode = "U+039D", small = "ν", smallCode = "U+03BD", lowercaseForms = ["ν"], vowel = false },
  GreekAlphabetLetter { order = 14, name = "Xi", greekName = "ξι", unicodeStem = "XI", capital = "Ξ", capitalCode = "U+039E", small = "ξ", smallCode = "U+03BE", lowercaseForms = ["ξ"], vowel = false },
  GreekAlphabetLetter { order = 15, name = "Omicron", greekName = "όμικρον", unicodeStem = "OMICRON", capital = "Ο", capitalCode = "U+039F", small = "ο", smallCode = "U+03BF", lowercaseForms = ["ο"], vowel = true },
  GreekAlphabetLetter { order = 16, name = "Pi", greekName = "πι", unicodeStem = "PI", capital = "Π", capitalCode = "U+03A0", small = "π", smallCode = "U+03C0", lowercaseForms = ["π"], vowel = false },
  GreekAlphabetLetter { order = 17, name = "Rho", greekName = "ρο", unicodeStem = "RHO", capital = "Ρ", capitalCode = "U+03A1", small = "ρ", smallCode = "U+03C1", lowercaseForms = ["ρ"], vowel = false },
  GreekAlphabetLetter { order = 18, name = "Sigma", greekName = "σίγμα", unicodeStem = "SIGMA", capital = "Σ", capitalCode = "U+03A3", small = "σ", smallCode = "U+03C3", lowercaseForms = ["σ", "ς"], vowel = false },
  GreekAlphabetLetter { order = 19, name = "Tau", greekName = "ταυ", unicodeStem = "TAU", capital = "Τ", capitalCode = "U+03A4", small = "τ", smallCode = "U+03C4", lowercaseForms = ["τ"], vowel = false },
  GreekAlphabetLetter { order = 20, name = "Upsilon", greekName = "ύψιλον", unicodeStem = "UPSILON", capital = "Υ", capitalCode = "U+03A5", small = "υ", smallCode = "U+03C5", lowercaseForms = ["υ"], vowel = true },
  GreekAlphabetLetter { order = 21, name = "Phi", greekName = "φι", unicodeStem = "PHI", capital = "Φ", capitalCode = "U+03A6", small = "φ", smallCode = "U+03C6", lowercaseForms = ["φ"], vowel = false },
  GreekAlphabetLetter { order = 22, name = "Chi", greekName = "χι", unicodeStem = "CHI", capital = "Χ", capitalCode = "U+03A7", small = "χ", smallCode = "U+03C7", lowercaseForms = ["χ"], vowel = false },
  GreekAlphabetLetter { order = 23, name = "Psi", greekName = "ψι", unicodeStem = "PSI", capital = "Ψ", capitalCode = "U+03A8", small = "ψ", smallCode = "U+03C8", lowercaseForms = ["ψ"], vowel = false },
  GreekAlphabetLetter { order = 24, name = "Omega", greekName = "ωμέγα", unicodeStem = "OMEGA", capital = "Ω", capitalCode = "U+03A9", small = "ω", smallCode = "U+03C9", lowercaseForms = ["ω"], vowel = true }
]

greekCapitalCharacter : (letter: GreekAlphabetLetter) -> GreekAlphabetCharacter
greekCapitalCharacter letter = GreekAlphabetCharacter { glyph = letter.capital, name = letter.name, unicodeName = concat "GREEK CAPITAL LETTER " letter.unicodeStem, codepoint = letter.capitalCode, scalar = charCode letter.capital, letterOrder = letter.order, greekName = letter.greekName, case = GreekCapital, category = "Lu", script = "Greek", block = "Greek and Coptic", simpleUppercase = letter.capital, simpleLowercase = letter.small, vowel = letter.vowel, release = "Unicode 17.0.0", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" }

greekSmallCharacter : (letter: GreekAlphabetLetter) -> (glyph: String) -> GreekAlphabetCharacter
greekSmallCharacter letter glyph =
  let isFinal = glyph == "ς"
  GreekAlphabetCharacter { glyph = glyph, name = if isFinal then "Final sigma" else letter.name, unicodeName = if isFinal then "GREEK SMALL LETTER FINAL SIGMA" else concat "GREEK SMALL LETTER " letter.unicodeStem, codepoint = if isFinal then "U+03C2" else letter.smallCode, scalar = charCode glyph, letterOrder = letter.order, greekName = letter.greekName, case = GreekSmall, category = "Ll", script = "Greek", block = "Greek and Coptic", simpleUppercase = letter.capital, simpleLowercase = glyph, vowel = letter.vowel, release = "Unicode 17.0.0", source = "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt" }

@label "The 49 base alphabet characters"
@description "All capital and lowercase forms of the 24 modern letters, including final sigma, as ordinary typed rows with Unicode properties and inspectable case pairs."
@tags "demo" "encyclopedia" "greek" "unicode" "data"
greekCharacters : List GreekAlphabetCharacter
greekCharacters = fold (\rows letter -> concat rows (concat [greekCapitalCharacter letter] (map (greekSmallCharacter letter) letter.lowercaseForms))) [] (greekAlphabet ())

greekSelectionRows : (selection: GreekAlphabetSelection) -> List GreekAlphabetCharacter
greekSelectionRows selection = filter (\character -> greekSelectionIncludes selection character) (greekCharacters ())

greekSelectionIncludes : (selection: GreekAlphabetSelection) -> (character: GreekAlphabetCharacter) -> Bool
greekSelectionIncludes selection character = case selection of
  AllGreekLetters -> true
  UppercaseGreek -> character.category == "Lu"
  LowercaseGreek -> character.category == "Ll"
  GreekVowels -> character.vowel
  GreekConsonants -> not character.vowel
  FinalSigma -> character.glyph == "ς"

@label "Greek alphabet character set"
@description "A finite set derived from exactly the selected catalogue rows. The same glyphs supply browsing, membership and the typed choice."
@fieldLabel "selection" "Selection"
greekLetterSet : (selection: GreekAlphabetSelection) -> SetExpr
greekLetterSet selection = SeEnum { values = map (\character -> character.glyph) (greekSelectionRows selection) }

@label "A Greek selection becomes a type"
@description "Derive a String member type from the selected finite alphabet set. It directs the ordinary character picker; no new type constructor or checker is introduced."
@tags "demo" "encyclopedia" "greek" "type"
@fieldLabel "selection" "Selection"
greekLetterType : (selection: GreekAlphabetSelection) -> Type
greekLetterType selection = encyclopediaTypeFromSet (typeOf "") (greekLetterSet selection)

@label "Explore and choose a Greek character"
@description "Change the alphabet selection, browse the matching characters and choose one through its derived finite type. UppercaseGreek offers 24 capitals; LowercaseGreek offers 25 forms, including final sigma."
@tags "demo" "encyclopedia" "greek" "dependent" "picker"
@fieldLabel "selection" "Selection"
@fieldLabel "character" "Character"
greekAlphabetExplore : (selection: GreekAlphabetSelection) -> (character: greekLetterType selection) -> GreekAlphabetExploration
greekAlphabetExplore selection character =
  let rows = greekSelectionRows selection
  let constraint = greekLetterSet selection
  GreekAlphabetExploration { selection = selection, characters = rows, glyphs = map (\row -> row.glyph) rows, count = length rows, constraint = constraint, characterType = greekLetterType selection, selected = find (\row -> row.glyph == character) rows, membership = set.contains constraint character, sources = greekAlphabetSources (), explanation = "These are the selected characters of the complete 24-letter base alphabet. The same finite set supplies this table, the character type and the choice above. Greek script, the Greek and Coptic block and the modern alphabet are different sets. Final sigma is one lowercase form of sigma, not a 25th letter." }

greekCombinedSet : (left: GreekAlphabetSelection) -> (operation: GreekAlphabetOperation) -> (right: GreekAlphabetSelection) -> SetExpr
greekCombinedSet left operation right =
  let a = greekLetterSet left
  let b = greekLetterSet right
  case operation of
    GreekUnion -> SeUnion { branches = [a, b] }
    GreekIntersection -> SeIntersect { branches = [a, b] }
    GreekDifference -> SeDiff { left = a, right = b }

greekDefiniteMember : (constraint: SetExpr) -> (glyph: String) -> Bool
greekDefiniteMember constraint glyph = case set.contains constraint glyph of
  Just true -> true
  _ -> false

@label "Combine Greek character sets"
@description "Try UppercaseGreek intersect GreekVowels, unite capital and small letters, or remove vowels from all letters. Inspect the actual set expression, its finite inhabitants, derived type and candidate verdict."
@tags "demo" "encyclopedia" "greek" "sets" "membership"
@fieldLabel "left" "Left"
@fieldLabel "operation" "Operation"
@fieldLabel "right" "Right"
@fieldLabel "candidate" "Candidate"
greekAlphabetSets : (left: GreekAlphabetSelection) -> (operation: GreekAlphabetOperation) -> (right: GreekAlphabetSelection) -> (candidate: String) -> GreekAlphabetSetResult
greekAlphabetSets left operation right candidate =
  let constraint = greekCombinedSet left operation right
  let rows = filter (\row -> greekDefiniteMember constraint row.glyph) (greekCharacters ())
  let glyphs = map (\row -> row.glyph) rows
  GreekAlphabetSetResult { left = left, operation = operation, right = right, characters = rows, glyphs = glyphs, count = length rows, constraint = constraint, characterType = encyclopediaTypeFromSet (typeOf "") (SeEnum { values = glyphs }), candidate = candidate, membership = set.contains constraint candidate, sources = greekAlphabetSources (), explanation = "Union, intersection and difference are the existing set operations. Each glyph occurs once in alphabet order. The rows enumerate the result inside this finite base alphabet; the displayed member type uses those same glyphs. A membership verdict checks the candidate value and is not a proof certificate." }

@label "Nonempty text from a Greek selection"
@description "Derive an algebraic sequence pattern through the existing regexSet boundary: repeat one member of the selected finite alphabet from 1 through 16 times. Whitespace, accents and combining marks stay outside this explicitly unaccented exercise."
@fieldLabel "selection" "Selection"
greekTextSet : (selection: GreekAlphabetSelection) -> SetExpr
greekTextSet selection =
  let glyphs = join (map (\row -> row.glyph) (greekSelectionRows selection)) ""
  regexSet (concat "^[" (concat glyphs "]{1,16}$"))

@label "Type of selected Greek text"
@fieldLabel "selection" "Selection"
greekTextType : (selection: GreekAlphabetSelection) -> Type
greekTextType selection = encyclopediaTypeFromSet (typeOf "") (greekTextSet selection)

greekCharacterAt : (glyph: String) -> Maybe GreekAlphabetCharacter
greekCharacterAt glyph = find (\row -> row.glyph == glyph) (greekCharacters ())

greekSimpleUppercase : (glyph: String) -> String
greekSimpleUppercase glyph = case greekCharacterAt glyph of
  Just row -> row.simpleUppercase
  Nothing -> glyph

greekSimpleLowercase : (glyph: String) -> String
greekSimpleLowercase glyph = case greekCharacterAt glyph of
  Just row -> row.simpleLowercase
  Nothing -> glyph

-- Within one admitted unaccented word every codepoint is cased and there are
-- no case-ignorable characters. Unicode's Final_Sigma condition therefore
-- reduces to: a capital sigma is last and has a preceding character. Already
-- lowercase sigma is never corrected or case-folded into another form.
greekLowerWord : (candidate: String) -> String
greekLowerWord candidate =
  let letters = chars candidate
  let count = length letters
  let state = fold (\state glyph -> { text = concat state.text (if glyph == "Σ" && state.position > 0 && state.position == count - 1 then "ς" else greekSimpleLowercase glyph), position = state.position + 1 }) { text = "", position = 0 } letters
  state.text

greekTextChecks : (selection: GreekAlphabetSelection) -> (candidate: String) -> List GreekAlphabetCharacterCheck
greekTextChecks selection candidate =
  let constraint = greekLetterSet selection
  let state = fold (\state glyph -> { rows = concat state.rows [GreekAlphabetCharacterCheck { position = state.position, glyph = glyph, membership = set.contains constraint glyph, character = greekCharacterAt glyph }], position = state.position + 1 }) { rows = [], position = 1 } (chars candidate)
  state.rows

greekCheckOutside : (check: GreekAlphabetCharacterCheck) -> Bool
greekCheckOutside check = case check.membership of
  Just false -> true
  _ -> false

@label "Try text against Greek letter sets"
@description "Enter uppercase Greek text, change the selection or add a Latin lookalike, then inspect the same membership judgment and its first excluded character. For an admitted unaccented word, inspect case mappings including final sigma."
@tags "demo" "encyclopedia" "greek" "text" "membership" "case"
@fieldLabel "selection" "Selection"
@fieldLabel "candidate" "Candidate"
greekAlphabetText : (selection: GreekAlphabetSelection) -> (candidate: String) -> GreekAlphabetTextResult
greekAlphabetText selection candidate =
  let constraint = greekTextSet selection
  let checks = greekTextChecks selection candidate
  let admittedWord = greekDefiniteMember (greekTextSet AllGreekLetters) candidate
  GreekAlphabetTextResult { selection = selection, candidate = candidate, count = length (chars candidate), constraint = constraint, textType = greekTextType selection, membership = set.contains constraint candidate, checks = checks, firstOutside = find greekCheckOutside checks, uppercase = if admittedWord then Just (join (map greekSimpleUppercase (chars candidate)) "") else Nothing, lowercase = if admittedWord then Just (greekLowerWord candidate) else Nothing, sources = greekAlphabetSources (), explanation = "The pattern accepts 1–16 codepoints from the selected base alphabet. Inspect each character's membership separately; empty or overlong text also fails the whole pattern. This tests the selected set, not spelling or complete Greek-language text. Case conversion is limited to one admitted unaccented alphabet word: capital sigma becomes final sigma only at the end after another letter; existing lowercase sigma forms stay unchanged. Accents and mathematical variants are neither stripped nor silently substituted." }

-- Callable values and authored initial arguments remain ordinary source data.
greekAlphabetDemoStartingInputs : List ({ function: Any, arguments: List Any })
greekAlphabetDemoStartingInputs = [
  { function = greekAlphabetExplore, arguments = [UppercaseGreek, "Α"] },
  { function = greekAlphabetSets, arguments = [UppercaseGreek, GreekIntersection, GreekVowels, "Α"] },
  { function = greekAlphabetText, arguments = [UppercaseGreek, "ΚΟΣΜΟΣ"] },
  { function = greekAlphabetText, arguments = [UppercaseGreek, "ΚΟΣΜΟA"] },
  { function = greekLetterType, arguments = [UppercaseGreek] }
]
