module GreekAlphabetDemo where

using std (map, filter, find, fold, concat, length, chars, join, typeOf, charCode, regexSet)
using set (contains)
using engine (SetExpr)
using EncyclopediaDemo (encyclopediaTypeFromSet)

-- The complete 24-letter modern Greek BASE alphabet, including both lowercase
-- sigma forms (49 glyphs). Orthography is the Greek education ministry's
-- alphabet table; character names, categories and simple case pairs are pinned
-- to Unicode 17.0.0. Script, block and orthographic membership stay distinct.
-- The bounded text exercise deliberately excludes accents, combining marks,
-- punctuation, spaces and mathematical letter variants. It is not a spelling
-- checker or the set of every Greek-script character. No normalisation occurs.

@label "Greek Alphabet Sources"
@description "The alphabet's orthographic scope and the pinned Unicode property sources. Source-derived facts remain distinct from the demo's bounded text policy."
@discriminator "$tag"
@fieldLabel "GreekAlphabetSources.release" "Release"
@fieldLabel "GreekAlphabetSources.orthography" "Orthography"
@fieldLabel "GreekAlphabetSources.unicodeData" "Unicode Data"
@fieldLabel "GreekAlphabetSources.scripts" "Scripts"
@fieldLabel "GreekAlphabetSources.blocks" "Blocks"
@fieldLabel "GreekAlphabetSources.casing" "Casing"
@fieldLabel "GreekAlphabetSources.license" "License"
@fieldLabel "GreekAlphabetSources.scope" "Scope"
GreekAlphabetSources = GreekAlphabetSources release: String orthography: UrlStr unicodeData: UrlStr scripts: UrlStr blocks: UrlStr casing: UrlStr license: UrlStr scope: String

@label "Modern Greek Alphabet Letter"
@description "One of the 24 ordered base letters, with its modern Greek name, Unicode name stem, capital form and lowercase forms. Sigma has two lowercase forms."
@discriminator "$tag"
@fieldLabel "GreekAlphabetLetter.capital" "Capital"
@fieldLabel "GreekAlphabetLetter.small" "Small"
@fieldLabel "GreekAlphabetLetter.name" "Name"
@fieldLabel "GreekAlphabetLetter.greekName" "Greek Name"
@fieldLabel "GreekAlphabetLetter.order" "Order"
@fieldLabel "GreekAlphabetLetter.unicodeStem" "Unicode Stem"
@fieldLabel "GreekAlphabetLetter.capitalCode" "Capital Code"
@fieldLabel "GreekAlphabetLetter.smallCode" "Small Code"
@fieldLabel "GreekAlphabetLetter.lowercaseForms" "Lowercase Forms"
@fieldLabel "GreekAlphabetLetter.vowel" "Vowel"
GreekAlphabetLetter = GreekAlphabetLetter capital: String small: String name: String greekName: String order: Nat unicodeStem: String capitalCode: String smallCode: String lowercaseForms: List String vowel: Bool

@label "Greek Letter Case"
GreekAlphabetCase = GreekCapital | GreekSmall

@label "Greek Alphabet Character"
@description "A single base-alphabet glyph, its Unicode 17 name/category/codepoint, separate script and block properties, and its simple case mappings. Final sigma is a lowercase form of letter 18."
@discriminator "$tag"
@fieldLabel "GreekAlphabetCharacter.glyph" "Glyph"
@fieldLabel "GreekAlphabetCharacter.name" "Name"
@fieldLabel "GreekAlphabetCharacter.unicodeName" "Unicode Name"
@fieldLabel "GreekAlphabetCharacter.codepoint" "Code Point"
@fieldLabel "GreekAlphabetCharacter.scalar" "Scalar"
@fieldLabel "GreekAlphabetCharacter.letterOrder" "Letter Order"
@fieldLabel "GreekAlphabetCharacter.greekName" "Greek Name"
@fieldLabel "GreekAlphabetCharacter.case" "Case"
@fieldLabel "GreekAlphabetCharacter.category" "Category"
@fieldLabel "GreekAlphabetCharacter.script" "Script"
@fieldLabel "GreekAlphabetCharacter.block" "Block"
@fieldLabel "GreekAlphabetCharacter.simpleUppercase" "Simple Uppercase"
@fieldLabel "GreekAlphabetCharacter.simpleLowercase" "Simple Lowercase"
@fieldLabel "GreekAlphabetCharacter.vowel" "Vowel"
@fieldLabel "GreekAlphabetCharacter.release" "Release"
@fieldLabel "GreekAlphabetCharacter.source" "Source"
GreekAlphabetCharacter = GreekAlphabetCharacter glyph: String name: String unicodeName: String codepoint: String scalar: Nat letterOrder: Nat greekName: String case: GreekAlphabetCase category: String script: String block: String simpleUppercase: String simpleLowercase: String vowel: Bool release: String source: UrlStr

@label "Greek Alphabet Selection"
@description "Select from this modern Greek base alphabet: its capital or small letters, vowel or consonant letters, or final sigma. Vowels mean alphabet letters, not distinct sounds."
GreekAlphabetSelection = AllGreekLetters | UppercaseGreek | LowercaseGreek | GreekVowels | GreekConsonants | FinalSigma

@label "Combine Greek Selections"
GreekAlphabetOperation = GreekUnion | GreekIntersection | GreekDifference

