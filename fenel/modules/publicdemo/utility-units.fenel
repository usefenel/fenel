module UtilityDemo where

using std (length, fold, isArray, map, rationalZero, rationalNormalize)
using units (UnitCatalogue, UnitDefinition, MeasureQuantity, MeasureExpr, unitCatalogue, catalogueUnitType, compatibleUnitType, compatibleUnitChoices, convertUnit, addQuantities, multiplyQuantities, divideQuantities, powerQuantity, approximateUnitConversion, quantityDuration)
using time (Duration)

-- Recipes compose the shared ordinary unit values and exact Rational algebra.
-- Catalogue codes are display facts; input fields contain typed unit records.
-- The Call editor is the authoring surface, including the exact Rational input.

@label "Compatible unit conversion input"
@description "Enter an exact number, choose a unit value, then select a compatible target. Source changes update the typed target choices."
UnitConversionInput = UnitConversionInput value: Rational fromUnit: (catalogueUnitType "") toUnit: compatibleUnitType fromUnit

@label "Convert compatible units"
@description "Convert exact numbers between typed unit values. Try 1000 grams to pounds, 1 byte to bits, 1 US fluid ounce to US tablespoons, or 100 Celsius to Fahrenheit. Units carry their own dimension and calibration; names are presentation only. Affine coordinates remain distinct from linear differences. Degree conversions use the explicitly approximate function. Fixed months and years mean 30/365 days."
@tags "utility" "units" "convert" "exact"
convertUnits : (input: UnitConversionInput) -> Result String Rational
convertUnits input = convertUnit input.value input.fromUnit input.toUnit

@label "Compatible units"
@description "List actual catalogue unit values admitted by the same dimension and calibration policy. Custom units do not need catalogue registration to use the shared converter."
@tags "utility" "units" "catalogue"
compatibleUnits : (fromUnit: UnitDefinition) -> List UnitDefinition
compatibleUnits fromUnit = map (\choice -> choice.unit) (compatibleUnitChoices fromUnit)

utilityQuantity : (value: Rational) -> (unit: UnitDefinition) -> MeasureQuantity
utilityQuantity value unit = MeasureQuantity { value = rationalNormalize value, unit = MeasureAtom { unit = unit } }

@label "Add quantities in a chosen unit"
@description "Add at most 64 exact quantities and return the total in a typed target unit. The example adds 6 minutes, 1 hour and 5 seconds to give exactly 3965 seconds. Empty input gives zero. Incompatible dimensions and affine coordinates refuse; their linear differences may be added."
@tags "utility" "units" "addition" "duration"
sumUnitQuantities : (quantities: List MeasureQuantity) -> (targetUnit: UnitDefinition) -> Result String MeasureQuantity
sumUnitQuantities quantities targetUnit =
  if isArray quantities then
    if length quantities <= 64 then
      let zero = utilityQuantity (rationalZero ()) targetUnit
      let initial = addQuantities zero zero
      let addQuantity = \acc quantity ->
        case acc of
          Err problem -> Err problem
          Ok total -> addQuantities total quantity
      fold addQuantity initial quantities
    else Err "Use at most 64 quantities in one sum."
  else Err "Quantities must be a list."

@label "Multiply quantities"
@description "Multiply two exact quantities and retain their typed product unit. For example 3 metres times 4 metres is 12 square metres. Symbolic units retain approximate calibrations without approximating the quantity value. Affine coordinates refuse."
@tags "utility" "units" "product"
multiplyUnitQuantities : (left: MeasureQuantity) -> (right: MeasureQuantity) -> Result String MeasureQuantity
multiplyUnitQuantities left right = multiplyQuantities left right

@label "Divide quantities"
@description "Divide exact quantities and retain their typed quotient unit. For example 100 metres divided by 20 seconds is exactly 5 metres per second. A zero divisor or affine coordinate refuses."
@tags "utility" "units" "quotient" "speed"
divideUnitQuantities : (left: MeasureQuantity) -> (right: MeasureQuantity) -> Result String MeasureQuantity
divideUnitQuantities left right = divideQuantities left right

@label "Raise a quantity to an exact power"
@description "Use a Rational exponent from -64 through 64. Perfect rational roots remain exact: the square root of 9 square metres is 3 metres. Powers retain typed dimensions. Non-rational results and affine coordinates refuse."
@tags "utility" "units" "power" "exact"
powerUnitQuantity : (quantity: MeasureQuantity) -> (exponent: Rational) -> Result String MeasureQuantity
powerUnitQuantity quantity exponent = powerQuantity quantity exponent

@label "Convert unit differences"
@description "Convert a difference using typed calibration scales, without coordinate origins or offsets. This applies to any compatible affine units. A difference of 10 Celsius degrees is exactly 18 Fahrenheit degrees; an absolute reading uses Convert compatible units."
@tags "utility" "units" "difference"
convertUnitDifference : (value: Rational) -> (fromUnit: UnitDefinition) -> (toUnit: UnitDefinition) -> Result String Rational
convertUnitDifference value fromUnit toUnit = units.convertUnitDifference value fromUnit toUnit

@label "Approximate compatible unit conversion"
@description "Explicitly project an exact input and typed calibrations to floating arithmetic. Use this for degree/radian conversions, whose scale contains pi. Finite-range failures refuse; exact conversion remains available separately."
@tags "utility" "units" "approximation"
approximateUnits : (input: UnitConversionInput) -> Result String Number
approximateUnits input = approximateUnitConversion input.value input.fromUnit input.toUnit

@label "Quantity becomes a duration"
@description "Convert an exact time quantity to the current millisecond Duration. Its final Number projection is explicit at the Duration representation boundary. The starting quantity is 3965 seconds. Fixed-duration months and years differ from calendar arithmetic."
@tags "utility" "units" "duration" "dates"
unitDuration : (quantity: MeasureQuantity) -> Result String Duration
unitDuration quantity = quantityDuration quantity

@label "Unit tools"
@description "Browse typed units and compose exact conversions, sums, products, quotients and powers. Each unit carries its own dimensions and calibration. Catalogue labels are presentation. Irrational angle scales have an explicit approximate path."
@tags "utility" "units" "quantity" "catalogue"
unitTools : {
  catalogue: UnitCatalogue,
  convertUnits: (input: UnitConversionInput) -> Result String Rational,
  compatibleUnits: (fromUnit: UnitDefinition) -> List UnitDefinition,
  sumUnitQuantities: (quantities: List MeasureQuantity) -> (targetUnit: UnitDefinition) -> Result String MeasureQuantity,
  multiplyUnitQuantities: (left: MeasureQuantity) -> (right: MeasureQuantity) -> Result String MeasureQuantity,
  divideUnitQuantities: (left: MeasureQuantity) -> (right: MeasureQuantity) -> Result String MeasureQuantity,
  powerUnitQuantity: (quantity: MeasureQuantity) -> (exponent: Rational) -> Result String MeasureQuantity,
  convertUnitDifference: (value: Rational) -> (fromUnit: UnitDefinition) -> (toUnit: UnitDefinition) -> Result String Rational,
  approximateUnits: (input: UnitConversionInput) -> Result String Number,
  unitDuration: (quantity: MeasureQuantity) -> Result String Duration
}
unitTools = { catalogue = unitCatalogue (), convertUnits = convertUnits, compatibleUnits = compatibleUnits, sumUnitQuantities = sumUnitQuantities, multiplyUnitQuantities = multiplyUnitQuantities, divideUnitQuantities = divideUnitQuantities, powerUnitQuantity = powerUnitQuantity, convertUnitDifference = convertUnitDifference, approximateUnits = approximateUnits, unitDuration = unitDuration }

utilityUnitStartingInputs : List ({ function: Any, arguments: List Any })
utilityUnitStartingInputs =
  let sixMinutes = utilityQuantity (Rational { num = 6, den = 1 }) units.minute
  let oneHour = utilityQuantity (Rational { num = 1, den = 1 }) units.hour
  let fiveSeconds = utilityQuantity (Rational { num = 5, den = 1 }) units.second
  let threeMetres = utilityQuantity (Rational { num = 3, den = 1 }) units.metre
  let fourMetres = utilityQuantity (Rational { num = 4, den = 1 }) units.metre
  let hundredMetres = utilityQuantity (Rational { num = 100, den = 1 }) units.metre
  let twentySeconds = utilityQuantity (Rational { num = 20, den = 1 }) units.second
  let totalSeconds = utilityQuantity (Rational { num = 3965, den = 1 }) units.second
  let massConversion = UnitConversionInput { value = Rational { num = 1000, den = 1 }, fromUnit = units.gram, toUnit = units.pound }
  [
    { function = convertUnits, arguments = [massConversion] },
    { function = compatibleUnits, arguments = [units.gram] },
    { function = sumUnitQuantities, arguments = [[sixMinutes, oneHour, fiveSeconds], units.second] },
    { function = multiplyUnitQuantities, arguments = [threeMetres, fourMetres] },
    { function = divideUnitQuantities, arguments = [hundredMetres, twentySeconds] },
    { function = powerUnitQuantity, arguments = [threeMetres, Rational { num = 2, den = 1 }] },
    { function = convertUnitDifference, arguments = [Rational { num = 10, den = 1 }, units.celsius, units.fahrenheit] },
    { function = unitDuration, arguments = [totalSeconds] }
  ]
