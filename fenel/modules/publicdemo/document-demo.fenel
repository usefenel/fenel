module DocumentDemo where

using std (RichDocument, DocBlock, DocInline, DocEmbeddedData, id, documentOutline, documentPlainText, documentToHtml, documentToMarkdown, documentFromHtml, documentFromMarkdown, map, join, fromMaybe)
using email (Email, Address, Body, Text, address, formatAddress, bodyText)
using ImportDemo (ImportTextInput)

@label "Starting document"
@description "One editable typed document: nested headings, styled text, a code block, a note and embedded number data. No data is saved."
@tags "demo" "document" "authoring"
documentSample : RichDocument
documentSample = RichDocument { blocks = [
  DocSection { title = [DocText { text = "An article made of data" }], blocks = [
    DocParagraph { content = [DocText { text = "A document is " }, DocStrong { content = [DocText { text = "ordinary typed data" }] }, DocText { text = ". Edit its text and the numbers below in the same form." }] },
    DocParagraph { content = [DocEmphasis { content = [DocText { text = "Structure, style and data compose." }] }, DocText { text = " This " }, DocLink { url = "https://usefenel.com", content = [DocText { text = "link" }] }, DocText { text = " is a preview; it does not navigate." }] },
    DocEmbed { data = DocNumbersData { numbers = [12, 18, 27] }, caption = [DocText { text = "These numbers remain typed Fenel data, shown as source and through their ordinary lens." }] },
    DocSection { title = [DocText { text = "The same tree stays inspectable" }], blocks = [
      DocParagraph { content = [DocText { text = "Inline " }, DocInlineCode { code = "DocStrong" }, DocText { text = " and nested sections are constructors, not hidden formatting." }] },
      DocCode { language = Just "fenel", source = "total xs = fold add 0 xs" },
      DocNote { blocks = [DocParagraph { content = [DocText { text = "This stage embeds text, numbers, booleans and lists. Its outline and plain text can compose a typed email. Other data, saved references and foreign-format export remain later steps." }] }] }
    ] }
  ] }
] }

@label "Edit a document"
@description "Change this document's typed blocks, inline text or embedded scalar/list data. The same returned data drives source inspection and the document preview. No data is saved or sent."
@tags "demo" "document" "authoring"
editDocument : (document: RichDocument) -> RichDocument
editDocument document = id document

@label "Read a document outline"
@description "Edit the same document and derive its section titles and actual nesting depth as ordinary typed data."
@tags "demo" "document" "outline"
outlineDocument : (document: RichDocument) -> List ({ depth: Nat, title: String })
outlineDocument document = documentOutline document

@label "Read a document as plain text"
@description "Edit the same document and extract its headings, paragraphs, code, notes, embedded data and captions. This declared conversion removes inline styling and keeps link labels."
@tags "demo" "document" "text" "conversion"
plainTextDocument : (document: RichDocument) -> String
plainTextDocument document = documentPlainText document

@label "Compose a plain-text email"
@description "Compose the existing typed Email from editable sender, recipients, subject and the same document. Its body is email.Text containing the document's plain-text projection. Inspect the returned data and Fenel source; nothing is saved or sent."
@tags "demo" "document" "email" "authoring"
composeDocumentEmail : (from: Address) -> (to: List Address) -> (subject: String) -> (document: RichDocument) -> Email
composeDocumentEmail from to subject document = Email {
  from = from, to = to, cc = [], bcc = [], replyTo = Nothing,
  subject = subject, body = Text (documentPlainText document),
  attachments = [], headers = [], inReplyTo = Nothing, references = []
}

-- Derive a RichDocument from the same Email value so ordinary typed results
-- use its existing registered document lens. The body remains literal code
-- content, without a browser HTML body or a replacement mail renderer.
@label "Preview a plain-text email"
@description "Derive a Document preview from the same typed plain-text Email: sender and recipients are paragraphs, subject is a heading, and body stays literal text. The existing document lens renders the result; nothing is saved or sent."
@tags "demo" "document" "email" "preview"
previewDocumentEmail : (from: Address) -> (to: List Address) -> (subject: String) -> (document: RichDocument) -> RichDocument
previewDocumentEmail from to subject document =
  let mail = composeDocumentEmail from to subject document
  RichDocument { blocks = [
    DocParagraph { content = [DocText { text = join ["From: ", formatAddress mail.from] "" }] },
    DocParagraph { content = [DocText { text = join ["To: ", join (map formatAddress mail.to) ", "] "" }] },
    DocSection { title = [DocText { text = mail.subject }], blocks = [
      DocCode { language = Nothing, source = fromMaybe "" (bodyText mail.body) }
    ] }
  ] }

-- Format examples share the authored Document model. The original sample keeps
-- its embedded data; this separate sample belongs to the declared exportable
-- fragment. Conversions refuse unsupported input instead of discarding it.
@label "Document for format conversion"
@description "An exportable typed document with a heading, styled text, a safe link, code and a note. Embedded data remains outside this format fragment."
@tags "demo" "document" "conversion"
documentFormatSample : RichDocument
documentFormatSample = RichDocument { blocks = [
  DocSection { title = [DocText { text = "An article across formats" }], blocks = [
    DocParagraph { content = [DocText { text = "Literal <text> & " }, DocStrong { content = [DocText { text = "typed data" }] }, DocText { text = ". " }, DocLink { url = "https://usefenel.com", content = [DocText { text = "Fenel" }] }] },
    DocCode { language = Just "fenel", source = "total xs = fold add 0 xs" },
    DocNote { blocks = [DocParagraph { content = [DocEmphasis { content = [DocText { text = "The same document stays editable." }] }] }] }
  ] }
] }

@label "Starting XHTML fragment"
@description "Safe XHTML-style source for the Document importer. Edit the text, tags or link to inspect a typed Document or a clear refusal."
@tags "demo" "document" "html"
documentHtmlSample : String
documentHtmlSample = "<section><h1>An article across formats</h1><p>Hello <strong>typed data</strong> &amp; literal &lt;text&gt;. <a href=\"https://usefenel.com\">Fenel</a></p><pre><code data-language=\"fenel\">total xs = fold add 0 xs</code></pre><aside class=\"document-note\"><p>The same document stays editable.</p></aside></section>"

@label "Export a document as HTML"
@description "Export the declared Document fragment as escaped XHTML-compatible HTML. Embedded data, unsafe links and unsupported content return Err; nothing is saved or sent."
@tags "demo" "document" "html" "conversion"
exportDocumentHtml : (document: RichDocument) -> Result String String
exportDocumentHtml document = documentToHtml document

@label "Export a document as Markdown"
@description "Export the declared Document fragment as CommonMark with explicit XHTML for styles, links and notes. Unsupported content returns Err. Bounded Markdown import uses heading-outline normalization; arbitrary original document trees do not round trip."
@tags "demo" "document" "markdown" "conversion"
exportDocumentMarkdown : (document: RichDocument) -> Result String String
exportDocumentMarkdown document = documentToMarkdown document

@label "Read a document from XHTML"
@description "Read the bounded XHTML-style HTML fragment into the same typed Document. Unknown tags or attributes, malformed source and unsafe links return Err. Text-node boundaries normalize; this is not a general HTML parser."
@tags "demo" "document" "html" "conversion"
importDocumentHtml : (source: String) -> Result String RichDocument
importDocumentHtml source = documentFromHtml source

@label "Starting Markdown outline"
@description "A bounded Markdown outline with headings, paragraphs and explicit XHTML styling. Later blocks belong to the latest heading until a same-level or shallower heading starts."
@tags "demo" "document" "markdown"
documentMarkdownSample : String
documentMarkdownSample = "# An article across formats\n\nHello <strong>typed data</strong> &amp; literal &lt;text&gt;.\n\n## Editable data\n\nA bounded outline stays editable."

@label "Read a document from Markdown"
@description "Read the bounded Markdown fragment into the same typed Document. Headings form an outline; unsupported syntax, malformed source and unsafe links return Err. Original section endings and text-node boundaries normalize."
@tags "demo" "document" "markdown" "conversion"
importDocumentMarkdown : (source: ImportTextInput) -> Result String RichDocument
importDocumentMarkdown source = documentFromMarkdown source.text

documentDemoStartingInputs : List ({ function: Any, arguments: List Any })
documentDemoStartingInputs = [
  { function = editDocument, arguments = [documentSample ()] },
  { function = outlineDocument, arguments = [documentSample ()] },
  { function = plainTextDocument, arguments = [documentSample ()] },
  { function = composeDocumentEmail, arguments = [address "author" "example.com" (Just "Article author"), [address "reader" "example.com" (Just "Article reader")], "An article made of data", documentSample ()] },
  { function = previewDocumentEmail, arguments = [address "author" "example.com" (Just "Article author"), [address "reader" "example.com" (Just "Article reader")], "An article made of data", documentSample ()] },
  { function = exportDocumentHtml, arguments = [documentFormatSample ()] },
  { function = exportDocumentMarkdown, arguments = [documentFormatSample ()] },
  { function = importDocumentHtml, arguments = [documentHtmlSample ()] },
  { function = importDocumentMarkdown, arguments = [ImportTextInput { text = documentMarkdownSample () }] }
]
