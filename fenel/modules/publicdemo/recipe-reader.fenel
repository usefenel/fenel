module RecipeFunctions where

using engine (ReifyOutcome, RecipeRefusal, RecipeAnalysisSnapshot)

-- These are reader observations. Analysis, admission and claim construction
-- remain ordinary Fenel bodies. A reference alone grants no read authority.
@native
@label "Reflect function"
reflectFunction : (fn: (a -> b)) -> ReifyOutcome

@native
@category "engine-internal"
recipeReaderSnapshot : (recipe: Recipe) -> (descriptor: RecipeDomainDescriptor) -> Result RecipeRefusal RecipeAnalysisSnapshot

@native
@category "engine-internal"
recipeReaderSnapshotWithFunctions : (recipe: Recipe) -> (descriptor: RecipeDomainDescriptor) -> (functions: List Any) -> Result RecipeRefusal RecipeAnalysisSnapshot

describeRecipeDomain : (unit: Unit) -> RecipeDomainDescriptor
describeRecipeDomain unit = recipeDomainDescriptor ()
