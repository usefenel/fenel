module AxiomsDemo where

using std (all, filter, length, unique, isArray, isString, typeOf, floor, arrayToList, recordType, appendItem)
using set (contains, decideSubset)
using engine (FloorLawClaim, SetExpr)
using ClaimsDemo (NamedClaim, claimsWholeNumber)
using GreekAlphabetDemo (GreekAlphabetSelection, GreekAlphabetExploration, greekLetterType, greekAlphabetExplore)
using CheckDemo (CheckContactInput, typeFormDemo)

-- Seven floor families, not seven formulas or new engine rules. Assumed names
-- the trusted basis; concrete Maybe Bool observations carry no certificate.
-- Lists and callable refs are ordinary Fenel data. All choices, bounds and
-- explanations remain here; bodyless forwards only enter existing engine bodies.

@label "Axiom example"
AxiomExample = AxiomExample caption: String function: Any arguments: List Any

@label "Axiom family"
@description "One of the seven floor families, with an assumed basis, canonical source, explicit fragment and ordinary editable examples. A checked instance is separate from the assumed family."
AxiomFamily = AxiomFamily title: String basis: NamedClaim canonicalSource: String fragment: String examples: List AxiomExample explanation: String

@label "Lattice law"
AxiomLatticeLaw = DifferenceDefinition | DeMorganIntersection | UnionIdempotence

@label "Arrow candidate"
AxiomArrowCandidate = SourceConstant | SourceIncrement | ExistingFloor | DependentChoice | PlainNumber

@label "Recursive example"
AxiomRecursionMode = GuardedList | UnguardedReference

@label "One set observation"
AxiomSetObservation = AxiomSetObservation constraint: SetExpr members: List Number candidate: Number membership: Maybe Bool

@label "Concrete law comparison"
@description "The existing floor-law claim and its two actual equality faces. These are Maybe Bool observations of this instance, without a theorem certificate."
AxiomLawCheck = AxiomLawCheck claim: FloorLawClaim bySubset: Maybe Bool byEmpty: Maybe Bool explanation: String

@label "Lattice result"
AxiomLatticeResult = AxiomLatticeResult domain: List Number union: AxiomSetObservation intersection: AxiomSetObservation complement: AxiomSetObservation difference: AxiomSetObservation law: AxiomLawCheck explanation: String

@label "Singleton result"
AxiomSingletonResult = AxiomSingletonResult value: String candidate: String singleton: SetExpr membership: Maybe Bool choices: List String pickerType: Type pickerMembership: Maybe Bool decomposition: AxiomLawCheck explanation: String

@label "Arrow result"
AxiomArrowResult = AxiomArrowResult callable: Any contract: SetExpr emptyReturnContract: SetExpr widerInputContract: SetExpr membership: Maybe Bool emptyReturnMembership: Maybe Bool variance: Maybe Bool reverseVariance: Maybe Bool explanation: String

@label "Recursive List result"
AxiomRecursionResult = AxiomRecursionResult data: List Number pureList: List Number constraint: SetExpr unfolded: SetExpr positive: Bool guarded: Bool membership: Maybe Bool explanation: String

@label "Dependent choice result"
AxiomDependencyResult = AxiomDependencyResult exploration: GreekAlphabetExploration generalContainment: Maybe Bool explanation: String

@label "Types as data result"
AxiomUniverseResult = AxiomUniverseResult data: CheckContactInput reflectedType: Type generalContainment: Maybe Bool explanation: String

@label "Fresh field identities result"
AxiomFreshIdentityResult = AxiomFreshIdentityResult schema: Type observedFreshness: Maybe Bool instructions: String explanation: String

-- Existing A4 engine-harness re-entry only: precise declared shapes, with no
-- parallel law evaluator, substitution rule, positivity check or guard checker.
@native
@category "engine-internal"
axiomsLawDiffDef : (left: SetExpr) -> (right: SetExpr) -> FloorLawClaim
@native
@category "engine-internal"
axiomsLawDeMorgan : (left: SetExpr) -> (right: SetExpr) -> FloorLawClaim
@native
@category "engine-internal"
axiomsLawIdempotent : (set: SetExpr) -> FloorLawClaim
@native
@category "engine-internal"
axiomsLawSingletonUnion : (set: SetExpr) -> FloorLawClaim
@native
@category "engine-internal"
axiomsLawEqBySubset : (left: SetExpr) -> (right: SetExpr) -> Maybe Bool
@native
@category "engine-internal"
axiomsLawEqByEmpty : (left: SetExpr) -> (right: SetExpr) -> Maybe Bool
@native
@category "engine-internal"
axiomsSubstitute : (variable: String) -> (replacement: SetExpr) -> (body: SetExpr) -> SetExpr
@native
@category "engine-internal"
axiomsPositive : (variable: String) -> (body: SetExpr) -> Bool
@native
@category "engine-internal"
axiomsGuarded : (variable: String) -> (body: SetExpr) -> Bool

axiomsPair : (left: a) -> (right: a) -> List a
axiomsPair left right = appendItem right (appendItem left [])

axiomsNumbers : (values: List Number) -> Bool
axiomsNumbers values = isArray values && length values <= 8 && all values claimsWholeNumber

axiomsSmallString : (value: String) -> Bool
axiomsSmallString value = isString value && length value <= 16

axiomsStrings : (values: List String) -> Bool
axiomsStrings values = isArray values && length values <= 8 && all values axiomsSmallString

axiomsDefiniteMember : (constraint: SetExpr) -> (candidate: Number) -> Bool
axiomsDefiniteMember constraint candidate = case set.contains constraint candidate of
  Just true -> true
  _ -> false

axiomsSetObservation : (domain: List Number) -> (constraint: SetExpr) -> (candidate: Number) -> AxiomSetObservation
axiomsSetObservation domain constraint candidate = AxiomSetObservation { constraint = constraint, members = filter (axiomsDefiniteMember constraint) (unique domain), candidate = candidate, membership = set.contains constraint candidate }

axiomsCheckLaw : (claim: FloorLawClaim) -> AxiomLawCheck
axiomsCheckLaw claim = AxiomLawCheck { claim = claim, bySubset = axiomsLawEqBySubset claim.lhs claim.rhs, byEmpty = axiomsLawEqByEmpty claim.lhs claim.rhs, explanation = "The existing floor-law builders supply these two sides. The existing mutual-subset and symmetric-difference emptiness faces report this particular instance; no universal proof or certificate is manufactured." }

axiomsChosenLaw : (law: AxiomLatticeLaw) -> (left: SetExpr) -> (right: SetExpr) -> AxiomLawCheck
axiomsChosenLaw law left right = case law of
  DifferenceDefinition -> axiomsCheckLaw (axiomsLawDiffDef left right)
  DeMorganIntersection -> axiomsCheckLaw (axiomsLawDeMorgan left right)
  UnionIdempotence -> axiomsCheckLaw (axiomsLawIdempotent left)

@label "Combine finite sets and check one law"
@description "Edit two finite number sets, an explicit enumeration domain and a candidate. Inspect actual union, intersection, complement, difference and one concrete existing floor-law comparison."
@tags "demo" "axiom" "lattice" "set"
axiomsLattice : (left: List Number) -> (right: List Number) -> (domain: List Number) -> (candidate: Number) -> (law: AxiomLatticeLaw) -> Result String AxiomLatticeResult
axiomsLattice left right domain candidate law =
  if axiomsNumbers left && axiomsNumbers right && axiomsNumbers domain && claimsWholeNumber candidate
  then
    let a = SeEnum { values = unique left }
    let b = SeEnum { values = unique right }
    let branches = axiomsPair a b
    Ok (AxiomLatticeResult { domain = unique domain, union = axiomsSetObservation domain (SeUnion { branches = branches }) candidate, intersection = axiomsSetObservation domain (SeIntersect { branches = branches }) candidate, complement = axiomsSetObservation domain (SeComplement { inner = a }) candidate, difference = axiomsSetObservation domain (SeDiff { left = a, right = b }) candidate, law = axiomsChosenLaw law a b, explanation = "Displayed members enumerate only the supplied finite domain. Complement membership still asks the actual judgment about the candidate; this list does not enumerate the whole universe. Each list admits at most eight whole numbers from -20 through 20." })
  else Err "Use at most eight whole numbers from -20 through 20 per list, and a candidate in that range."

@label "Exactly this value, and a finite picker"
@description "Change one String and try an equal or different candidate. The singleton judgment also composes the supplied choices into a genuine finite member type."
@tags "demo" "axiom" "singleton" "picker"
axiomsSingleton : (value: String) -> (candidate: String) -> (choices: List String) -> Result String AxiomSingletonResult
axiomsSingleton value candidate choices =
  if axiomsSmallString value && axiomsSmallString candidate && axiomsStrings choices
  then
    let singleton = SeEnum { values = appendItem value [] }
    let finite = SeEnum { values = unique choices }
    Ok (AxiomSingletonResult { value = value, candidate = candidate, singleton = singleton, membership = set.contains singleton candidate, choices = unique choices, pickerType = EncyclopediaDemo.encyclopediaTypeFromSet (typeOf "") finite, pickerMembership = set.contains finite candidate, decomposition = axiomsCheckLaw (axiomsLawSingletonUnion finite), explanation = "Both verdicts use the existing membership judgment. The finite picker is the union of these singletons; its decomposition is one concrete law instance. Use at most eight choices, each at most sixteen codepoints." })
  else Err "Use strings of at most sixteen codepoints and at most eight choices."

@label "A source-owned number function"
@description "This ordinary Fenel body increments one Number. Signature membership uses the existing admission and purity fences, rather than testing every possible input."
axiomsIncrement : (candidate: Number) -> Number
axiomsIncrement candidate = candidate + 1

axiomsArrowCallable : (candidate: AxiomArrowCandidate) -> Any
axiomsArrowCallable candidate = case candidate of
  SourceConstant -> (\input -> 1)
  SourceIncrement -> axiomsIncrement
  ExistingFloor -> floor
  DependentChoice -> greekAlphabetExplore
  PlainNumber -> 7

axiomsArrowSet : (domain: List Number) -> (returns: SetExpr) -> SetExpr
axiomsArrowSet domain returns =
  let parameter = SetArrowParam { key = PositionalField { index = 0 }, wireName = "_0", set = SeEnum { values = unique domain } }
  SeArrow { params = appendItem parameter [], returns = returns }

@label "A function contract and its variance"
@description "Edit a finite input domain and codomain. Compare two real arrow constraints, then ask actual membership for a source function, an existing floor function, a dependent function or a number. Unknown stays distinct."
@tags "demo" "axiom" "arrow" "function"
axiomsArrow : (domain: List Number) -> (codomain: List Number) -> (candidate: AxiomArrowCandidate) -> Result String AxiomArrowResult
axiomsArrow domain codomain candidate =
  if axiomsNumbers domain && axiomsNumbers codomain
  then
    let callable = axiomsArrowCallable candidate
    let contract = axiomsArrowSet domain (SeEnum { values = unique codomain })
    let emptyReturn = axiomsArrowSet domain (SeNone)
    let supplied = axiomsArrowSet domain (SeEnum { values = unique codomain })
    let widerInput = axiomsArrowSet (appendItem 3 domain) (SeEnum { values = unique codomain })
    Ok (AxiomArrowResult { callable = callable, contract = contract, emptyReturnContract = emptyReturn, widerInputContract = widerInput, membership = set.contains contract callable, emptyReturnMembership = set.contains emptyReturn callable, variance = set.decideSubset widerInput supplied, reverseVariance = set.decideSubset supplied widerInput, explanation = "SourceConstant is an actual closed Fenel lambda returning 1. Change the finite codomain to include or exclude 1 and inspect its real CHECK verdict. The extra input 3 makes variance concrete: a function accepting the wider domain satisfies the narrower input contract with the same return set. Registered signatures retain arity, realizability, purity and admission fences; closure checking retains its supported-fragment fences. ExistingFloor, a dependent signature or the SeNone return may report Nothing. A non-callable number is refused; this is not exhaustive execution testing." })
  else Err "Use at most eight whole numbers from -20 through 20 in each domain and codomain."

axiomsListBody : (allowed: List Number) -> SetExpr
axiomsListBody allowed =
  let headField = SetCtorField { key = PositionalField { index = 0 }, wireName = "_0", set = SeEnum { values = unique allowed } }
  let tailField = SetCtorField { key = PositionalField { index = 1 }, wireName = "_1", set = SeRef { handle = "AxiomList" } }
  let consFields = axiomsPair headField tailField
  let constructors = axiomsPair (SeCtor { ctor = "Nil", fields = [] }) (SeCtor { ctor = "Cons", fields = consFields })
  SeUnion { branches = constructors }

axiomsRecursiveBody : (allowed: List Number) -> (mode: AxiomRecursionMode) -> SetExpr
axiomsRecursiveBody allowed mode = case mode of
  GuardedList -> axiomsListBody allowed
  UnguardedReference -> SeUnion { branches = axiomsPair (SeRef { handle = "AxiomList" }) (SeEnum { values = unique allowed }) }

@label "Unfold and check an ordinary List"
@description "Add or remove ordinary list elements, change their allowed finite set and inspect one actual unfolding. Choose the unguarded reference to see the existing recursion fence return Nothing."
@tags "demo" "axiom" "recursion" "list"
axiomsRecursion : (allowed: List Number) -> (candidate: List Number) -> (mode: AxiomRecursionMode) -> Result String AxiomRecursionResult
axiomsRecursion allowed candidate mode =
  if axiomsNumbers allowed && axiomsNumbers candidate
  then
    let body = axiomsRecursiveBody allowed mode
    let constraint = SeMu { var = "AxiomList", body = body }
    let pureList = arrayToList candidate
    Ok (AxiomRecursionResult { data = candidate, pureList = pureList, constraint = constraint, unfolded = axiomsSubstitute "AxiomList" constraint body, positive = axiomsPositive "AxiomList" body, guarded = axiomsGuarded "AxiomList" body, membership = set.contains constraint pureList, explanation = "The ordinary List editor authors this data. std.arrayToList supplies its canonical Nil/Cons positional spine; no second recursive data model is introduced. The existing capture-avoiding substitution unfolds the actual SeMu once. Membership respects the existing positivity, guardedness and supported-fragment gates; unguarded recursion remains unknown." })
  else Err "Use at most eight whole numbers from -20 through 20 in each list."

@label "An earlier choice shapes the next input"
@description "Change the Greek alphabet selection and choose from its actual derived character type. This is the existing dependent picker, with its real $el signature."
@tags "demo" "axiom" "dependency" "picker"
axiomsDependency : (selection: GreekAlphabetSelection) -> (character: greekLetterType selection) -> AxiomDependencyResult
axiomsDependency selection character = AxiomDependencyResult { exploration = greekAlphabetExplore selection character, generalContainment = Nothing, explanation = "The earlier selection computes the type of the later character input. This dependent editor and its concrete finite membership ship. General dependent-type containment remains undecided: the set language has no SeEl carrier, so this example supplies no general containment proof." }

@label "A type is ordinary inspectable data"
@description "Inspect this function's Contact input type. Edit its temporary type draft and enter data through the generated ordinary input, then inspect the reflected type and this same data."
@tags "demo" "axiom" "universe" "type"
axiomsUniverse : (contact: CheckContactInput) -> AxiomUniverseResult
axiomsUniverse contact = AxiomUniverseResult { data = typeFormDemo contact, reflectedType = typeOf contact, generalContainment = Nothing, explanation = "The type of this named contact data is a runtime Type value. Open the Contact input type to edit a temporary draft and its generated input. This demonstrates runtime reflection, rather than a completed hierarchy of universe levels or a Type : Type theorem. General universe containment has no SeType carrier and remains undecided." }

@label "Create and inspect real field identities"
@description "The Type input uses the existing TypeBuilder. Start with its empty record, Add field twice, inspect the two actual identities and edit the fields independently. Reset discards the temporary draft."
@tags "demo" "axiom" "mint" "identity" "type"
axiomsFreshIdentities : (schema: Type) -> AxiomFreshIdentityResult
axiomsFreshIdentities schema = AxiomFreshIdentityResult { schema = schema, observedFreshness = Nothing, instructions = "In the Type input, use Add field twice. Each action uses the existing identity creation boundary. Name the fields differently, change one field's type and inspect the Type data to see both real identities. Open the result Type to enter data through its generated input; reset restores the empty record.", explanation = "This function returns the actual supplied Type; it does not mint or fabricate IDs. The editor's real creation actions provide the observations. No freshness-against-every-set proof is claimed, and this source-only result supplies no freshness verdict. If field creation is unavailable, retain that limitation instead of simulating success." }

axiomsBasis : (title: String) -> (definition: Any) -> (statement: String) -> (domain: String) -> (related: List Any) -> NamedClaim
axiomsBasis title definition statement domain related = NamedClaim { title = title, definition = definition, domain = domain, claim = { statement = statement }, evidence = (Assumed), certificate = Nothing, kernelVerdict = Nothing, samples = [], explanation = "This family belongs to the stated trusted floor basis. Assumed is distinct from a concrete membership/law observation or a kernel-rechecked theorem certificate.", related = related }

axiomsFamily : (title: String) -> (definition: Any) -> (statement: String) -> (fragment: String) -> (examples: List AxiomExample) -> (related: List Any) -> (explanation: String) -> AxiomFamily
axiomsFamily title definition statement fragment examples related explanation = AxiomFamily { title = title, basis = axiomsBasis title definition statement fragment related, canonicalSource = "design/floor-kernel.md, section 3.2: the proposed axiom set over Layer 0", fragment = fragment, examples = examples, explanation = explanation }

@label "Lattice — combine sets"
axiomsLatticeFamily : AxiomFamily
axiomsLatticeFamily = axiomsFamily "Lattice — combine sets" axiomsLattice "Union and intersection obey associativity, commutativity, idempotence, absorption and distributivity. Classical complement gives De Morgan, involution, excluded middle and non-contradiction in the stated fragments; difference is intersection with complement." "This example uses closed finite number sets. Complement enumeration is relative to the explicit finite domain; the law check describes one supplied instance." [AxiomExample { caption = "Edit sets and compare difference with its floor definition", function = axiomsLattice, arguments = [[1, 2], [2, 3], [0, 1, 2, 3], 2, DifferenceDefinition] }] [axiomsLattice, axiomsLawDiffDef, axiomsLawDeMorgan, axiomsLawEqBySubset, axiomsLawEqByEmpty] "The lattice family groups three floor formers: union, intersection and complement. Existing specialized equality faces may differ in precision; preserve their actual answers."

@label "Singletons — exactly this value"
axiomsSingletonFamily : AxiomFamily
axiomsSingletonFamily = axiomsFamily "Singletons — exactly this value" axiomsSingleton "A value belongs to its own singleton; distinct values have disjoint singletons. Membership asks whether the candidate singleton is a subset of the supplied set." "Bounded String values and a finite union of at most eight choices. Existing membership and equality judgments supply every verdict." [AxiomExample { caption = "Change the singleton and try another candidate", function = axiomsSingleton, arguments = ["Alpha", "Alpha", ["Alpha", "Beta", "Gamma"]] }] [axiomsSingleton, axiomsLawSingletonUnion] "Single values supply the floor atoms. A finite picker composes them without introducing a second equality implementation."

@label "Arrow — a function contract"
axiomsArrowFamily : AxiomFamily
axiomsArrowFamily = axiomsFamily "Arrow — a function contract" axiomsArrow "Inputs are contravariant and outputs covariant. Callable membership uses an admitted signature or the existing trusted CHECK face for a supported closure. Constructive signature realizability is part of the floor basis." "Finite number domains/codomains for the variance comparison and closed constant lambda check; registered-signature membership retains arity, purity, realizability and trust fences." [AxiomExample { caption = "Include or exclude 1 from a closed lambda's contract", function = axiomsArrow, arguments = [[1, 2], [1, 2], SourceConstant] }, AxiomExample { caption = "Inspect the existing floor callable's admission boundary", function = axiomsArrow, arguments = [[1, 2], [1, 2], ExistingFloor] }, AxiomExample { caption = "Inspect a named source-owned callable and its admission boundary", function = axiomsArrow, arguments = [[1, 2], [1, 2], SourceIncrement] }] [axiomsArrow, axiomsIncrement, floor] "Function membership is intensional. These observations do not evaluate an arbitrary function on every possible input."

@label "Recursion — the same shape again"
axiomsRecursionFamily : AxiomFamily
axiomsRecursionFamily = axiomsFamily "Recursion — the same shape again" axiomsRecursion "A least fixpoint unfolds to its body with the fixpoint substituted for the bound variable. Park induction and the documented guardedness/regularity conditions govern reasoning; the recursive-reference sibling has its stated coinductive acceptance rule." "The existing guarded Nil/Cons List shape over a finite number set; an explicitly unguarded sibling shows Nothing." [AxiomExample { caption = "Edit ordinary List data and unfold its recursive set", function = axiomsRecursion, arguments = [[1, 2], [1, 2], GuardedList] }, AxiomExample { caption = "Inspect the unguarded recursion boundary", function = axiomsRecursion, arguments = [[1, 2], [1, 2], UnguardedReference] }] [axiomsRecursion, arrayToList, axiomsSubstitute, axiomsPositive, axiomsGuarded] "The List editor and canonical pure spine stay shared. A refused element and an unsupported recursion have different actual verdicts."

@label "Dependency — one choice shapes another"
axiomsDependencyFamily : AxiomFamily
axiomsDependencyFamily = axiomsFamily "Dependency — one choice shapes another" axiomsDependency "A dependent type derives from earlier data. Narrowing refines the base in the stated decidable fragment; the general form is undecidable." "The shipped Greek finite-choice $el signature and dependent editor. General $el containment has no SeEl carrier and remains Nothing." [AxiomExample { caption = "Change uppercase letters to lowercase choices", function = axiomsDependency, arguments = [UppercaseGreek, "Α"] }] [axiomsDependency, greekLetterType, greekAlphabetExplore, EncyclopediaDemo.countryEncyclopedia] "An earlier alphabet selection supplies the next input's real type; the country/currency choice uses the same dependency ingredient."

@label "Universe — types are data too"
axiomsUniverseFamily : AxiomFamily
axiomsUniverseFamily = axiomsFamily "Universe — types are data too" axiomsUniverse "The universe makes types available as runtime data while retaining the intended level discipline." "Existing runtime reflection and the shared Types and forms editor. General universe containment has no SeType carrier; no completed universe-level hierarchy or Type : Type theorem is demonstrated." [AxiomExample { caption = "Inspect the Contact input type and edit its temporary draft", function = axiomsUniverse, arguments = [CheckContactInput { email = "hello@usefenel.com", quantity = 2 }] }] [axiomsUniverse, typeFormDemo, typeOf, axiomsFreshIdentities] "The runtime type remains inspectable data, and its ordinary editor generates inputs from a temporary draft."

@label "Fresh identities — create a new identity"
axiomsFreshIdentityFamily : AxiomFamily
axiomsFreshIdentityFamily = axiomsFamily "Fresh identities — create a new identity" axiomsFreshIdentities "Mint is an effect: a newly generated singleton is fresh with respect to the world constructed before it." "Two real Add field actions in the existing temporary TypeBuilder. Inspect distinct actual identities and independent edits; no source-generated fake ID or universal freshness proof." [AxiomExample { caption = "Add two real fields to the temporary Type draft", function = axiomsFreshIdentities, arguments = [recordType []] }] [axiomsFreshIdentities, typeFormDemo, axiomsUniverse] "Mint is the one floor effect, rather than a ninth former. The existing editor event and host boundary perform the creation; this family records its explicit observation boundary."

@label "Seven floor axiom families"
axiomsFamilies : List AxiomFamily
axiomsFamilies = [axiomsLatticeFamily (), axiomsSingletonFamily (), axiomsArrowFamily (), axiomsRecursionFamily (), axiomsDependencyFamily (), axiomsUniverseFamily (), axiomsFreshIdentityFamily ()]

axiomsDemoStartingInputs : List ({ function: Any, arguments: List Any })
axiomsDemoStartingInputs = [
  { function = axiomsLattice, arguments = [[1, 2], [2, 3], [0, 1, 2, 3], 2, DifferenceDefinition] },
  { function = axiomsSingleton, arguments = ["Alpha", "Alpha", ["Alpha", "Beta", "Gamma"]] },
  { function = axiomsArrow, arguments = [[1, 2], [1, 2], SourceConstant] },
  { function = axiomsRecursion, arguments = [[1, 2], [1, 2], GuardedList] },
  { function = axiomsDependency, arguments = [UppercaseGreek, "Α"] },
  { function = axiomsUniverse, arguments = [CheckContactInput { email = "hello@usefenel.com", quantity = 2 }] },
  { function = axiomsFreshIdentities, arguments = [recordType []] }
]
