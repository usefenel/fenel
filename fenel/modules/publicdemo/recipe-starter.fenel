module RecipeFunctions where

@label "Recipe function examples"
@description "The source-owned starter function and the foods it chooses from. The browser copies the readable definition into editable Local data. The choice starts with every food, so the demo turns foods off."
recipeDemoSources : List ({ name: String, callable: Recipe, pantries: PantrySet })
recipeDemoSources = [
  { name = "Moisturizing-lubrication formula", callable = lubeFormula, pantries = SubsetsOf { pantry = recipeDomainFoods () } }
]

-- The callable field is intentionally heterogeneous. The browser transports
-- each actual checked declaration and its nullary result owner; this roster
-- supplies no authority or asserted function signature. Each criterion takes
-- the recipe and the pantry set.
recipeDemoCriteria : List ({ name: String, callable: Any })
recipeDemoCriteria = [
  { name = "facts", callable = recipeCard }
]
