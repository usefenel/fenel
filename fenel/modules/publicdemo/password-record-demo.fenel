module PasswordRecordDemo where

using std (fold, all, chars, length, includes, split, concat, regexSet, numberIsFinite, floor)
using CheckDemo (checkDemoExplanation)
using set (contains)

-- GP-12's bounded password/whole-record slice. These are authored example
-- policies, not password-strength advice. Character classes use the existing
-- supported pattern parser. Repeated runs, ascending fragments and the exact
-- blocklist are ordinary Fenel predicates instead of lookahead/backreferences.
-- Concrete membership preserves Just true / Just false / Nothing; no theorem
-- certificate, account, saved credential or postal-address validity is claimed.

@label "Input criterion"
@description "One authored criterion's actual membership verdict. Unknown stays distinct from refusal."
InputCriterion = InputCriterion name: String verdict: Maybe Boolean explanation: String

@label "Password check result"
@description "The demonstration text, actual criteria and their conjunction. Use invented examples only; the text remains inspectable data."
PasswordCheckResult = PasswordCheckResult candidate: String criteria: List InputCriterion verdict: Maybe Boolean explanation: String

passwordCriterion : (name: String) -> (passed: Bool) -> (explanation: String) -> InputCriterion
passwordCriterion name passed explanation = InputCriterion { name = name, verdict = Just passed, explanation = explanation }

passwordPatternCriterion : (name: String) -> (pattern: String) -> (explanation: String) -> (candidate: String) -> InputCriterion
passwordPatternCriterion name pattern explanation candidate =
  let constraint = regexSet pattern
  let verdict = set.contains constraint candidate
  InputCriterion { name = name, verdict = verdict, explanation = explanation }

-- This is ordinary conjunction over existing membership answers, not a
-- replacement membership checker. A known refusal dominates an unknown rule.
passwordConjoin : (left: Maybe Boolean) -> (right: Maybe Boolean) -> Maybe Boolean
passwordConjoin left right = case left of
  Just false -> Just false
  Just true -> right
  Nothing -> case right of
    Just false -> Just false
    _ -> Nothing

passwordCriteriaVerdict : (criteria: List InputCriterion) -> Maybe Boolean
passwordCriteriaVerdict criteria = fold (\verdict criterion -> passwordConjoin verdict criterion.verdict) (Just true) criteria

-- A refinement's predicate must return an actual Boolean to decide. Returning
-- Nothing here keeps an unsupported pattern undecided at the same boundary.
passwordPredicateVerdict : (verdict: Maybe Boolean) -> Any
passwordPredicateVerdict verdict = case verdict of
  Just passed -> passed
  Nothing -> Nothing

@label "Basic password criteria"
@description "Six example rules: no ASCII whitespace, ASCII uppercase/lowercase/digit, a non-alphanumeric character and at least eight codepoints. The current pattern excludes ASCII spaces, tabs and line breaks; other Unicode spaces are outside this rule. These are format criteria, not a strength estimate."
passwordBasicCriteria : (candidate: String) -> List InputCriterion
passwordBasicCriteria candidate = [
  passwordPatternCriterion "No ASCII whitespace" "^\\S+$" "Exclude ASCII spaces, tabs and line breaks. This rule does not exclude other Unicode spaces." candidate,
  passwordPatternCriterion "Uppercase letter" "[A-Z]" "Include an ASCII uppercase letter." candidate,
  passwordPatternCriterion "Lowercase letter" "[a-z]" "Include an ASCII lowercase letter." candidate,
  passwordPatternCriterion "Digit" "[0-9]" "Include an ASCII digit." candidate,
  passwordPatternCriterion "Special character" "[^a-zA-Z0-9]" "Include a character outside the ASCII letter and digit classes." candidate,
  passwordCriterion "Eight codepoints" (length candidate >= 8) "Include at least eight codepoints."
]

PasswordRunState = PasswordRunState previous: Maybe String runs: Number currentRun: Number repeatedTriple: Bool

passwordRunStep : (state: PasswordRunState) -> (character: String) -> PasswordRunState
passwordRunStep state character =
  let same = case state.previous of
    Just previous -> previous == character
    Nothing -> false
  let currentRun = if same then state.currentRun + 1 else 1
  let runs = if same then state.runs else state.runs + 1
  PasswordRunState { previous = Just character, runs = runs, currentRun = currentRun, repeatedTriple = state.repeatedTriple || currentRun >= 3 }

passwordRunState : (candidate: String) -> PasswordRunState
passwordRunState candidate = fold passwordRunStep (PasswordRunState { previous = Nothing, runs = 0, currentRun = 0, repeatedTriple = false }) (chars candidate)

@label "Count consecutive character runs"
@description "Collapse each consecutive run to one codepoint for this authored rule: AAAbb becomes two runs. Nonadjacent equal characters remain separate runs."
passwordCountRuns : (candidate: String) -> Number
passwordCountRuns candidate =
  let state = passwordRunState candidate
  state.runs

@label "No repeated character triple"
@description "Refuse three or more consecutive identical codepoints. This replaces the test fixture's unsupported backreference."
passwordNoRepeatedTriple : (candidate: String) -> Bool
passwordNoRepeatedTriple candidate =
  let state = passwordRunState candidate
  not state.repeatedTriple

passwordAscendingFragments : List String
passwordAscendingFragments = ["abc", "bcd", "cde", "def", "efg", "fgh", "ghi", "hij", "ijk", "jkl", "klm", "lmn", "mno", "nop", "opq", "pqr", "qrs", "rst", "stu", "tuv", "uvw", "vwx", "wxy", "xyz", "ABC", "BCD", "CDE", "DEF", "EFG", "FGH", "GHI", "HIJ", "IJK", "JKL", "KLM", "LMN", "MNO", "NOP", "OPQ", "PQR", "QRS", "RST", "STU", "TUV", "UVW", "VWX", "WXY", "XYZ", "012", "123", "234", "345", "456", "567", "678", "789"]

@label "No ascending ASCII triple"
@description "Refuse a case-sensitive ascending triple within ASCII lowercase letters, uppercase letters or digits. Mixed-case triples and other scripts are outside this authored fragment rule."
passwordNoAscendingTriple : (candidate: String) -> Bool
passwordNoAscendingTriple candidate =
  let state = fold passwordFragmentStep (PasswordFragmentState { candidate = candidate, admitted = true }) (passwordAscendingFragments ())
  state.admitted

PasswordFragmentState = PasswordFragmentState candidate: String admitted: Bool

passwordFragmentStep : (state: PasswordFragmentState) -> (fragment: String) -> PasswordFragmentState
passwordFragmentStep state fragment = PasswordFragmentState { candidate = state.candidate, admitted = state.admitted && length (split state.candidate fragment) == 1 }

passwordExampleBlocklist : List String
passwordExampleBlocklist = ["P@ssw0rd1234", "Qwerty12345!", "Letmein1234!", "Admin1234!@#", "Welcome1234!", "M0nk3y$ecure!", "Dragon12345!", "Master1234!@", "Shadow1234!@", "Trustn01234!"]

passwordHardenedCriteria : (candidate: String) -> List InputCriterion
passwordHardenedCriteria candidate = concat (passwordBasicCriteria candidate) [
  passwordCriterion "Twelve codepoints" (length candidate >= 12) "Include at least twelve codepoints.",
  passwordCriterion "No repeated triple" (passwordNoRepeatedTriple candidate) "Do not repeat a codepoint three times consecutively.",
  passwordCriterion "No ascending ASCII triple" (passwordNoAscendingTriple candidate) "Avoid the listed case-sensitive ascending ASCII triples, including xyz and 123.",
  passwordCriterion "Outside the example blocklist" (not (includes (passwordExampleBlocklist ()) candidate)) "Refuse exactly the ten supplied example strings. This is not a breached-password service."
]

passwordSmartCriteria : (candidate: String) -> List InputCriterion
passwordSmartCriteria candidate = concat (passwordBasicCriteria candidate) [passwordCriterion "Ten consecutive runs" (passwordCountRuns candidate >= 10) "Collapse each consecutive run to one codepoint and require at least ten runs. Repeated triples are allowed by this different policy."]

-- The legacy fixture can call these same bodies from ordinary Fenel source.
passwordHardenedAdmitted : (candidate: String) -> Any
passwordHardenedAdmitted candidate = passwordPredicateVerdict (passwordCriteriaVerdict (passwordHardenedCriteria candidate))

passwordSmartAdmitted : (candidate: String) -> Any
passwordSmartAdmitted candidate = passwordPredicateVerdict (passwordCriteriaVerdict (passwordSmartCriteria candidate))

@label "Hardened example password"
@description "The fixed twelve-codepoint example policy, with character classes, repeated-run, ascending-fragment and exact blocklist rules. Unknown membership is retained. Use invented text only."
HardenedExamplePassword = String | passwordHardenedAdmitted value

@label "Consecutive-run example password"
@description "A different fixed policy: the six basic rules plus at least ten consecutive runs after collapsing repetitions. Repetition is not universally forbidden. Use invented text only."
SmartExamplePassword = String | passwordSmartAdmitted value

passwordCheckResult : (candidate: String) -> (criteria: List InputCriterion) -> PasswordCheckResult
passwordCheckResult candidate criteria =
  let verdict = passwordCriteriaVerdict criteria
  PasswordCheckResult { candidate = candidate, criteria = criteria, verdict = verdict, explanation = checkDemoExplanation verdict }

@label "Check a fixed password policy"
@description "Edit invented text through the ordinary typed input. Inspect every actual rule, try a repeated triple or xyz, then correct it. No credential is saved. This is an example policy, not password-strength advice."
@tags "demo" "live-check" "password" "rules"
checkHardenedPassword : (candidate: HardenedExamplePassword) -> PasswordCheckResult
checkHardenedPassword candidate = passwordCheckResult candidate (passwordHardenedCriteria candidate)

@label "Compare a consecutive-run password policy"
@description "This different policy allows repeated triples if at least ten runs remain after collapsing consecutive repetitions. Change invented text and inspect the same computed criteria."
@tags "demo" "live-check" "password" "rules"
checkSmartPassword : (candidate: SmartExamplePassword) -> PasswordCheckResult
checkSmartPassword candidate = passwordCheckResult candidate (passwordSmartCriteria candidate)

@label "Credentials draft"
@description "Two invented strings. Confirmation is checked over the complete record; a nested field does not implicitly reach an outer sibling."
@widget "password" "password"
@widget "confirm" "password"
CredentialsDraft = CredentialsDraft confirm: String password: HardenedExamplePassword

credentialsCriteria : (candidate: CredentialsDraft) -> List InputCriterion
credentialsCriteria candidate = concat (passwordHardenedCriteria candidate.password) [passwordCriterion "Confirmation matches" (candidate.password == candidate.confirm) "The complete record's password and confirmation must agree exactly."]

credentialsAdmitted : (candidate: CredentialsDraft) -> Any
credentialsAdmitted candidate = passwordPredicateVerdict (passwordCriteriaVerdict (credentialsCriteria candidate))

@label "Matching credentials"
@description "A whole-record refinement: the same fixed password policy and exact confirmation agreement. This is invented demonstration data, not account registration."
MatchingCredentials = CredentialsDraft | credentialsAdmitted value

@label "Check a whole credentials record"
@description "Edit the two invented strings, inspect the password criteria and exact confirmation rule, then correct the same typed record. Nothing is saved or registered."
@tags "demo" "live-check" "password" "record"
checkCredentialsRecord : (candidate: MatchingCredentials) -> ({ candidate: CredentialsDraft, criteria: List InputCriterion, verdict: Maybe Boolean, explanation: String })
checkCredentialsRecord candidate =
  let criteria = credentialsCriteria candidate
  let verdict = passwordCriteriaVerdict criteria
  { candidate = candidate, criteria = criteria, verdict = verdict, explanation = checkDemoExplanation verdict }

@label "Example shipping country"
OrderExampleCountry = OrderUnitedStates | OrderFrance

@label "Example order customer"
OrderExampleCustomer = OrderExampleCustomer country: OrderExampleCountry name: String

@label "Example order item"
OrderExampleItem = OrderExampleItem name: String quantity: Number

@label "Example shipping address"
@description "This bounded example has US and France choices. US ZIP text must have exactly five ASCII digits; France has no postal-format rule here. No real address is verified."
OrderExampleShipping = OrderExampleShipping country: OrderExampleCountry zip: String

@label "Nested order draft"
@description "Ordinary nested customer, item-list and shipping records. Whole-order rules check every item and the two country choices."
NestedOrderDraft = NestedOrderDraft customer: OrderExampleCustomer items: List OrderExampleItem shipping: OrderExampleShipping

orderQuantityAdmitted : (item: OrderExampleItem) -> Bool
orderQuantityAdmitted item = numberIsFinite item.quantity && item.quantity > 0 && item.quantity <= 100 && floor item.quantity == item.quantity

orderCriteria : (candidate: NestedOrderDraft) -> List InputCriterion
orderCriteria candidate =
  let zipCriterion = case candidate.shipping.country of
    OrderUnitedStates -> passwordPatternCriterion "US ZIP has five ASCII digits" "^[0-9]{5}$" "US ZIP text must be exactly five ASCII digits. Five letters are refused; no address existence is checked." candidate.shipping.zip
    OrderFrance -> passwordCriterion "No France postal rule" true "This example does not impose or establish a French postal format."
  [
    passwordCriterion "One to eight items" (length candidate.items >= 1 && length candidate.items <= 8) "Provide one to eight items in this bounded example.",
    passwordCriterion "Every quantity is a whole number from one to 100" (all candidate.items orderQuantityAdmitted) "Each item quantity must be finite, whole and between one and 100.",
    passwordCriterion "Shipping country matches the customer" (candidate.shipping.country == candidate.customer.country) "The complete order compares the shipping and customer country choices.",
    zipCriterion
  ]

nestedOrderAdmitted : (candidate: NestedOrderDraft) -> Any
nestedOrderAdmitted candidate = passwordPredicateVerdict (passwordCriteriaVerdict (orderCriteria candidate))

@label "Checked nested order"
@description "Whole-record membership combines bounded item quantities, country agreement and the explicit five-digit US ZIP rule. These are authored example policies."
CheckedNestedOrder = NestedOrderDraft | nestedOrderAdmitted value

@label "Check a nested order"
@description "Edit customer/shipping countries, quantities and ZIP text through ordinary nested record/list inputs. Try ABCDE for a US ZIP, then restore 10001. Every quantity and whole-record country agreement are checked; no purchase is submitted."
@tags "demo" "live-check" "record" "nested" "postal"
checkNestedOrder : (candidate: CheckedNestedOrder) -> ({ candidate: NestedOrderDraft, criteria: List InputCriterion, verdict: Maybe Boolean, explanation: String })
checkNestedOrder candidate =
  let criteria = orderCriteria candidate
  let verdict = passwordCriteriaVerdict criteria
  { candidate = candidate, criteria = criteria, verdict = verdict, explanation = checkDemoExplanation verdict }

passwordRecordDemoStartingInputs : List ({ function: Any, arguments: List Any })
passwordRecordDemoStartingInputs = [
  { function = checkHardenedPassword, arguments = ["AAAb1!kcwpmzvq"] },
  { function = checkSmartPassword, arguments = ["AAAb1!kcwpmzvq"] },
  { function = checkCredentialsRecord, arguments = [CredentialsDraft { password = "K9$mPx!vR2@nWq", confirm = "K9$mPx!vR2@nWq" }] },
  { function = checkNestedOrder, arguments = [NestedOrderDraft { customer = OrderExampleCustomer { name = "Alice", country = OrderUnitedStates }, items = [OrderExampleItem { name = "Notebook", quantity = 2 }], shipping = OrderExampleShipping { country = OrderUnitedStates, zip = "ABCDE" } }] }
]
