module RecipeFunctions where

using engine (CanonicalListDomain)

pantryCanonicalListDomain : CanonicalListDomain Pantry
pantryCanonicalListDomain = CanonicalListDomain { describe = describeRecipeDomain }

-- A recipe card is ordinary typed data; Viewable selects the shared card body,
-- one row per fact. The rows remain inspectable through the fact itself.
_ : Viewable RecipeCard
_ = Viewable { defaultView = "recipe-card", defaultInlineView = "recipe-card" }
