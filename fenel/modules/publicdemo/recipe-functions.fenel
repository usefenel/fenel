module RecipeFunctions where

using std (eq, lt, lte, gt, gte, add, div, elem, all, some, head, tail, fromMaybe, length, filter, intersection, subsequences, find, map, fold, concat, unique, numberIsFinite, rationalZero, ratEq, ratLt, not)
using units (MeasureQuantity, MeasureExpr, convertLinearMeasure, addQuantities)

-- Recipes are ordinary pure functions. These are supplied examples; neither
-- a successful preparation nor an inferred criterion is a claim about safety, nutrition, treatment or efficacy.
--
-- This closed nine-food slice and its explicit constructor rank are the C0
-- domain contract. Changing either requires a foodRankVersion bump and fresh
-- dependent analysis. Labels never determine ordering or membership.
-- Explicit if guards keep rank and tail recursion behind carrier/order checks;
-- written && is an ordinary eager call. Outside the admitted Food-list fragment,
-- a false guard now skips the later computation instead of eagerly entering it.

@label "Food"
@description "The nine constructor identities in this deliberately small recipe example."
Food = Butter | CoconutCream | Cream | Honey | LemonJuice | Egg | Tomato | Watermelon | Cucumber

-- Each constructor carries its own Emojiable glyph. The list circle asks the
-- constructor before the Food type, so the nine foods stay distinguishable.
_ : Emojiable "Butter"
_ = Emojiable { emoji = "🧈" }
_ : Emojiable "CoconutCream"
_ = Emojiable { emoji = "🥥" }
_ : Emojiable "Cream"
_ = Emojiable { emoji = "🥛" }
_ : Emojiable "Honey"
_ = Emojiable { emoji = "🍯" }
_ : Emojiable "LemonJuice"
_ = Emojiable { emoji = "🍋" }
_ : Emojiable "Egg"
_ = Emojiable { emoji = "🥚" }
_ : Emojiable "Tomato"
_ = Emojiable { emoji = "🍅" }
_ : Emojiable "Watermelon"
_ = Emojiable { emoji = "🍉" }
_ : Emojiable "Cucumber"
_ = Emojiable { emoji = "🥒" }

foodRankVersion : Nat
foodRankVersion = 1

foodRank : (food: Food) -> Nat
foodRank food = case food of
  Butter -> 0
  CoconutCream -> 1
  Cream -> 2
  Honey -> 3
  LemonJuice -> 4
  Egg -> 5
  Tomato -> 6
  Watermelon -> 7
  Cucumber -> 8

canonicalFood : (food: Food) -> Bool
canonicalFood food = case food of
  Butter -> eq food Butter
  CoconutCream -> eq food CoconutCream
  Cream -> eq food Cream
  Honey -> eq food Honey
  LemonJuice -> eq food LemonJuice
  Egg -> eq food Egg
  Tomato -> eq food Tomato
  Watermelon -> eq food Watermelon
  Cucumber -> eq food Cucumber
  _ -> false

canonicalFoodsAfter : (previous: Nat) -> (foods: List Food) -> Bool
canonicalFoodsAfter previous foods = case head foods of
  Nothing -> true
  Just food ->
    if canonicalFood food then
      if previous < foodRank food then canonicalFoodsAfter (foodRank food) (fromMaybe [] (tail foods)) else false
    else false

canonicalFoods : (foods: List Food) -> Bool
canonicalFoods foods = case head foods of
  Nothing -> true
  Just food ->
    if canonicalFood food then canonicalFoodsAfter (foodRank food) (fromMaybe [] (tail foods)) else false

@label "List of foods"
@description "A list of foods, in order, with no repeats. The order is the order of the Food choices: butter, coconut cream, cream, honey, lemon juice, egg, tomato, watermelon, cucumber. An empty list is valid; a repeated or reordered list is refused, never repaired."
Pantry = List Food | canonicalFoods value

@label "Preparation"
@description "The foods of one preparation: a nonempty list of foods, in the same order as Foods, with no repeats."
Ingredients = List Food | if canonicalFoods value then length value > 0 else false

@label "Recipe"
@icon "utensils"
@description "A pure function from a list of foods to every preparation it allows with them. An empty result means no preparation."
-- A name for that function type. `Recipe = Pantry -> List Ingredients` does
-- not parse as a synonym: `Name = Ident` is a variant constructor, and the
-- transparent `type X = Y` surface is not shipped. This refinement's
-- predicate is constantly true, so the inhabitants stay exactly the arrow's.
Recipe = (Pantry -> List Ingredients) | if true then true else true

@label "Moisturizing-lubrication formula"
@description "The formula uses honey, lemon juice and egg, with butter or coconut cream. Given foods with both butter and coconut cream, it returns both preparations. It is a supplied example and makes no health claim."
@tags "demo" "recipes" "pure"
lubeFormula : Recipe
lubeFormula foods =
  let has = \food -> elem food foods
  let essentials = [Honey, LemonJuice, Egg]
  if all essentials has then
    map (\fat -> concat [fat] essentials) (filter has [Butter, CoconutCream])
  else []

-- The same formula given three lists of foods: one preparation, two, or none.
-- Each list is in the order Foods requires.
@label "With butter"
@description "The moisturizing-lubrication formula given butter, honey, lemon juice and egg: one preparation."
@tags "demo" "recipes" "pure"
lubeWithButter : List Ingredients
lubeWithButter = lubeFormula [Butter, Honey, LemonJuice, Egg]

@label "With butter and coconut cream"
@description "The moisturizing-lubrication formula given butter, coconut cream, honey, lemon juice and egg: two preparations, one with butter and one with coconut cream."
@tags "demo" "recipes" "pure"
lubeWithButterAndCoconutCream : List Ingredients
lubeWithButterAndCoconutCream = lubeFormula [Butter, CoconutCream, Honey, LemonJuice, Egg]

@label "Without honey"
@description "The moisturizing-lubrication formula given butter, coconut cream, lemon juice and egg, without honey: no preparation."
@tags "demo" "recipes" "pure"
lubeWithoutHoney : List Ingredients
lubeWithoutHoney = lubeFormula [Butter, CoconutCream, LemonJuice, Egg]

hydrationFood : (food: Food) -> Bool
hydrationFood food =
  let tomato = eq food Tomato
  let watermelon = eq food Watermelon
  let cucumber = eq food Cucumber
  if tomato then true else if watermelon then true else cucumber

@label "Sports formula"
@description "The formula returns every preparation of at least two of the given foods among tomato, watermelon and cucumber. All three foods yield three pairs and the triple. It is a supplied example and makes no health claim."
@tags "demo" "recipes" "pure"
hydrationFormula : Recipe
hydrationFormula foods =
  let chosen = intersection [Tomato, Watermelon, Cucumber] foods
  if length chosen >= 2 then
    filter (\items -> length items >= 2) (subsequences chosen)
  else []

-- Classification is a relation, not specialization. Sharing a category never
-- passes a nutrient fact to another food. This snapshot asserts no refinement
-- edges among these nine foods: butter production from cream is not subtyping.

@label "Food category"
@description "Supplied classifications, including the custom bland-fruit category. Categories can overlap; category inclusion is separate from food specialization."
FoodCategory = DairyFood | PlantFood | AnimalFood | FruitFood | BlandFruit

-- Each category carries its own glyph. The list circle asks the constructor
-- before the FoodCategory type. The icon catalogue has no leaf, milk or
-- animal drawing, so these are emoji, the same fallback the foods use.
_ : Emojiable "DairyFood"
_ = Emojiable { emoji = "🧀" }
_ : Emojiable "PlantFood"
_ = Emojiable { emoji = "🌱" }
_ : Emojiable "AnimalFood"
_ = Emojiable { emoji = "🐄" }
_ : Emojiable "FruitFood"
_ = Emojiable { emoji = "🍎" }
_ : Emojiable "BlandFruit"
_ = Emojiable { emoji = "🍈" }

allFoodCategories : List FoodCategory
allFoodCategories = [DairyFood, PlantFood, AnimalFood, FruitFood, BlandFruit]

FoodInCategory = FoodInCategory food: Food category: FoodCategory

@description "An explicit inclusion from a more specific category to a more general one. Membership-table coincidences do not create inclusion edges."
FoodCategoryIncludes = FoodCategoryIncludes specific: FoodCategory general: FoodCategory

foodCategoryIncludesVisited : (inclusions: List FoodCategoryIncludes) -> (visited: List FoodCategory) -> (specific: FoodCategory) -> (general: FoodCategory) -> Bool
foodCategoryIncludesVisited inclusions visited specific general =
  if eq specific general then true
  else if elem specific visited then false
  else
    let parents = filter (\edge -> eq edge.specific specific) inclusions
    some parents (\edge -> foodCategoryIncludesVisited inclusions (concat [specific] visited) edge.general general)

@description "Reflexive, transitive reachability through the supplied category inclusion edges. Cycles terminate; no inclusion is inferred from the current food sample."
foodCategoryIncludes : (inclusions: List FoodCategoryIncludes) -> (specific: FoodCategory) -> (general: FoodCategory) -> Bool
foodCategoryIncludes inclusions specific general = foodCategoryIncludesVisited inclusions [] specific general

@description "Expand stated food classifications through the explicit hierarchy once, preserving first occurrence and removing duplicate memberships. The expanded rows can be captured by a family predicate."
expandFoodCategories : (inclusions: List FoodCategoryIncludes) -> (categories: List FoodInCategory) -> List FoodInCategory
expandFoodCategories inclusions categories =
  let appendCategory = \known food category ->
        if some known (\row -> eq row.food food && eq row.category category) then known
        else concat known [FoodInCategory { food = food, category = category }]
  let appendFoodCategories = \known row ->
        fold (\expanded category -> appendCategory expanded row.food category) known (filter (\category -> foodCategoryIncludes inclusions row.category category) (allFoodCategories ()))
  fold appendFoodCategories [] categories

@label "Food category membership"
@description "Build a family from already-expanded classification rows. Stated membership is true; absence is false only within complete food coverage, and otherwise remains unknown. The returned function captures only food lists."
foodInCategory : (classifiedFoods: List Food) -> (expandedCategories: List FoodInCategory) -> (category: FoodCategory) -> (Food -> Maybe Bool)
foodInCategory classifiedFoods expandedCategories category =
  let members = map (\row -> row.food) (filter (\row -> eq row.category category) expandedCategories)
  \food -> if elem food members then Just true else if elem food classifiedFoods then Just false else Nothing

@label "Most specific food categories"
@description "Remove only ancestors of another supplied category under explicit strict inclusion. Incomparable categories and categories connected in both directions remain; current membership-table equality is irrelevant."
mostSpecificFoodCategories : (inclusions: List FoodCategoryIncludes) -> (categories: List FoodCategory) -> List FoodCategory
mostSpecificFoodCategories inclusions categories =
  let stricterThan = \category other ->
        if foodCategoryIncludes inclusions other category then
          if foodCategoryIncludes inclusions category other then false else true
        else false
  filter (\category -> if some categories (stricterThan category) then false else true) (unique categories)

FoodRefines = FoodRefines specific: Food general: Food

Nutrient = FatFraction | WaterFraction

NutrientFraction = Number | numberIsFinite value && value >= 0 && value <= 1

@description "A supplied illustration is explicitly distinct from a cited measurement. The resolver checks consequences of supplied data, not the truth of its source."
NutrientSource = IllustrativeFact description: String | CitedFact reference: String

NutrientFact = NutrientFact food: Food nutrient: Nutrient amount: NutrientFraction source: NutrientSource

NutrientOrigin = Stated source: NutrientSource
  | InheritedFrom general: Food origin: NutrientOrigin
  | AveragedFrom specifics: List ResolvedNutrient

ResolvedNutrient = ResolvedNutrient food: Food nutrient: Nutrient amount: NutrientFraction origin: NutrientOrigin

@description "An explicit supplied fact snapshot. Classification rows include ancestors and are complete only for classifiedFoods; categoryInclusions records the supplied hierarchy. Change version after editing facts or relations. Missing nutrient facts remain unknown."
FoodFactSnapshot = FoodFactSnapshot version: Nat foodRankVersion: Nat classifiedFoods: List Food categories: List FoodInCategory categoryInclusions: List FoodCategoryIncludes refinements: List FoodRefines nutrients: List NutrientFact

@description "The resolution policy is an ordinary swappable function value. Change version when its definition or precedence changes."
NutrientResolutionRule = NutrientResolutionRule version: Nat resolve: ((snapshot: FoodFactSnapshot) -> (food: Food) -> (nutrient: Nutrient) -> Maybe ResolvedNutrient)

RecipeSnapshot = RecipeSnapshot facts: FoodFactSnapshot rule: NutrientResolutionRule

@label "Stated nutrient facts only"
@description "Read the first supplied fact for the exact food and nutrient. Source order is this rule's explicit precedence; absence returns Nothing."
statedNutrients : (snapshot: FoodFactSnapshot) -> (food: Food) -> (nutrient: Nutrient) -> Maybe ResolvedNutrient
statedNutrients snapshot food nutrient =
  case find (\fact -> eq fact.food food && eq fact.nutrient nutrient) snapshot.nutrients of
    Nothing -> Nothing
    Just fact -> Just (ResolvedNutrient { food = food, nutrient = nutrient, amount = fact.amount, origin = Stated { source = fact.source } })

firstResolvedNutrient : (candidates: List (Maybe ResolvedNutrient)) -> Maybe ResolvedNutrient
firstResolvedNutrient candidates = case head candidates of
  Nothing -> Nothing
  Just candidate -> case candidate of
    Just resolved -> Just resolved
    Nothing -> firstResolvedNutrient (fromMaybe [] (tail candidates))

generalNutrient : (snapshot: FoodFactSnapshot) -> (visited: List Food) -> (food: Food) -> (nutrient: Nutrient) -> Maybe ResolvedNutrient
generalNutrient snapshot visited food nutrient =
  if some visited (\seen -> eq seen food) then Nothing
  else case statedNutrients snapshot food nutrient of
    Just resolved -> Just resolved
    Nothing ->
      let generals = filter (\edge -> eq edge.specific food) snapshot.refinements
      let nextVisited = concat visited [food]
      let resolveGeneral = \edge ->
            case generalNutrient snapshot nextVisited edge.general nutrient of
              Nothing -> Nothing
              Just resolved -> Just (ResolvedNutrient { food = food, nutrient = nutrient, amount = resolved.amount, origin = InheritedFrom { general = edge.general, origin = resolved.origin } })
      let candidates = map resolveGeneral generals
      firstResolvedNutrient candidates

@label "Stated then general nutrient facts"
@description "Prefer an exact stated fact, then search specialization ancestors in supplied edge order. Category membership is not consulted. Cycles without a reachable fact stay unknown."
statedThenGeneral : (snapshot: FoodFactSnapshot) -> (food: Food) -> (nutrient: Nutrient) -> Maybe ResolvedNutrient
statedThenGeneral snapshot food nutrient = generalNutrient snapshot [] food nutrient

knownSpecificNutrients : (snapshot: FoodFactSnapshot) -> (food: Food) -> (nutrient: Nutrient) -> List ResolvedNutrient
knownSpecificNutrients snapshot food nutrient =
  let edges = filter (\edge -> eq edge.general food) snapshot.refinements
  let specifics = fold (\known edge -> if some known (\specific -> eq specific edge.specific) then known else concat known [edge.specific]) [] edges
  let appendKnownSpecific = \known specific ->
        case statedNutrients snapshot specific nutrient of
          Nothing -> known
          Just resolved -> concat known [resolved]
  fold appendKnownSpecific [] specifics

@label "Stated, general, then known-specific average"
@description "Prefer stated and inherited facts; otherwise average directly stated known specifics, each food once. Missing specifics are excluded, not treated as zero. Preserve every contributing origin. This policy is supplied reasoning, not a nutritional claim."
statedThenGeneralThenAverage : (snapshot: FoodFactSnapshot) -> (food: Food) -> (nutrient: Nutrient) -> Maybe ResolvedNutrient
statedThenGeneralThenAverage snapshot food nutrient =
  case statedThenGeneral snapshot food nutrient of
    Just resolved -> Just resolved
    Nothing ->
      let specifics = knownSpecificNutrients snapshot food nutrient
      if length specifics == 0 then Nothing
      else
        let total = fold (\amount resolved -> amount + resolved.amount) 0 specifics
        Just (ResolvedNutrient { food = food, nutrient = nutrient, amount = total / length specifics, origin = AveragedFrom { specifics = specifics } })

resolveNutrient : (snapshot: RecipeSnapshot) -> (food: Food) -> (nutrient: Nutrient) -> Maybe ResolvedNutrient
resolveNutrient snapshot food nutrient = snapshot.rule.resolve snapshot.facts food nutrient

@label "Fat-rich example family"
@description "An authored predicate: a supplied or resolved fat mass fraction of at least one half. Missing facts return Nothing, separately from an analyzer's inability to inspect the function. The threshold is an example definition, not dietary advice."
fatRich : (snapshot: RecipeSnapshot) -> (food: Food) -> Maybe Bool
fatRich snapshot food = case resolveNutrient snapshot food FatFraction of
  Nothing -> Nothing
  Just resolved -> Just (resolved.amount >= 0.5)

@label "Recipe fact and rule snapshot"
@description "A versioned example classification and swappable stated-only rule. No nutrient measurements or specialization edges are supplied, so nutrient-derived families remain unknown until facts are explicitly provided."
recipeSnapshot : RecipeSnapshot
recipeSnapshot =
  let inclusions = [
        FoodCategoryIncludes { specific = DairyFood, general = AnimalFood },
        FoodCategoryIncludes { specific = FruitFood, general = PlantFood },
        FoodCategoryIncludes { specific = BlandFruit, general = FruitFood }
      ]
  let statedCategories = [
      FoodInCategory { food = Butter, category = DairyFood },
      FoodInCategory { food = Cream, category = DairyFood },
      FoodInCategory { food = CoconutCream, category = PlantFood },
      FoodInCategory { food = LemonJuice, category = PlantFood },
      FoodInCategory { food = Tomato, category = BlandFruit },
      FoodInCategory { food = Watermelon, category = BlandFruit },
      FoodInCategory { food = Cucumber, category = BlandFruit },
      FoodInCategory { food = Honey, category = AnimalFood },
      FoodInCategory { food = Egg, category = AnimalFood }
      ]
  RecipeSnapshot {
    facts = FoodFactSnapshot {
      version = 2,
      foodRankVersion = foodRankVersion (),
      classifiedFoods = [Butter, CoconutCream, Cream, Honey, LemonJuice, Egg, Tomato, Watermelon, Cucumber],
      categories = expandFoodCategories inclusions statedCategories,
      categoryInclusions = inclusions,
      refinements = [],
      nutrients = []
    },
    rule = NutrientResolutionRule { version = 1, resolve = statedNutrients }
  }

@description "Ordinary source data for generic live analysis. Type fields are qualified type values; function fields are references. The reader must check their admitted definitions and dependencies before using them as evidence."
RecipeDomainDescriptor = RecipeDomainDescriptor food: Type pantry: Type ingredients: Type rankVersion: Nat rank: (Food -> Nat) canonical: (List Food -> Bool) canonicalAfter: (Nat -> List Food -> Bool) snapshot: RecipeSnapshot

recipeDomainDescriptor : RecipeDomainDescriptor
recipeDomainDescriptor = RecipeDomainDescriptor {
  food = RecipeFunctions.Food,
  pantry = RecipeFunctions.Pantry,
  ingredients = RecipeFunctions.Ingredients,
  rankVersion = foodRankVersion (),
  rank = foodRank,
  canonical = canonicalFoods,
  canonicalAfter = canonicalFoodsAfter,
  snapshot = recipeSnapshot ()
}

-- Exact, concrete mass data; no missing amount or assumed stock is a
-- runtime inhabitant. Bounds below are caller inputs, not nutritional facts.
-- Admission preserves input order and refuses duplicates/zeros. The explicit
-- normalizer is the only operation that sorts, combines or removes entries.

@label "Food and quantity"
FoodQuantity = FoodQuantity food: Food quantity: MeasureQuantity

@label "Mass pantry"
MassPantry = List FoodQuantity | canonicalFoodQuantities value

@label "Mass preparation"
MassPreparation = List FoodQuantity | if canonicalFoodQuantities value then length value > 0 else false

zeroFoodMass : MeasureQuantity
zeroFoodMass = MeasureQuantity { value = rationalZero (), unit = MeasureAtom { unit = units.gram } }

massInGrams : (quantity: MeasureQuantity) -> Result String Rational
massInGrams quantity = case quantity of
  MeasureQuantity { value = amount, unit = unit } -> case convertLinearMeasure amount unit (MeasureAtom { unit = units.gram }) of
    Err problem -> Err problem
    Ok grams -> if ratLt grams (rationalZero ()) then Err "Food mass must be nonnegative." else Ok grams
  _ -> Err "Use a concrete exact mass quantity."

canonicalFoodQuantities : (quantities: List FoodQuantity) -> Bool
canonicalFoodQuantities quantities = case validateFoodQuantities quantities of
  Err problem -> false
  Ok admitted -> true

validateFoodQuantities : (quantities: List FoodQuantity) -> Result String (List FoodQuantity)
validateFoodQuantities quantities = validateFoodQuantitiesAfter Nothing quantities

validateFoodQuantitiesAfter : (previous: Maybe Nat) -> (quantities: List FoodQuantity) -> Result String (List FoodQuantity)
validateFoodQuantitiesAfter previous quantities = case head quantities of
  Nothing -> Ok quantities
  Just portion ->
    if not (canonicalFood portion.food) then Err "Use an admitted Food value."
    else case massInGrams portion.quantity of
      Err problem -> Err problem
      Ok grams ->
        if ratEq grams (rationalZero ()) then Err "Omit zero-mass entries or normalize them explicitly."
        else
          let ordered = case previous of
            Nothing -> true
            Just earlier -> earlier < foodRank portion.food
          if not ordered then Err "Use strictly increasing foods without duplicates, or normalize explicitly."
          else case validateFoodQuantitiesAfter (Just (foodRank portion.food)) (fromMaybe [] (tail quantities)) of
            Err problem -> Err problem
            Ok rest -> Ok quantities

normalizeFoodQuantities : (quantities: List FoodQuantity) -> Result String MassPantry
normalizeFoodQuantities quantities = fold normalizeFoodQuantity (Ok []) quantities

normalizeFoodQuantity : (acc: Result String (List FoodQuantity)) -> (portion: FoodQuantity) -> Result String (List FoodQuantity)
normalizeFoodQuantity acc portion = case acc of
  Err problem -> Err problem
  Ok admitted ->
    if not (canonicalFood portion.food) then Err "Use an admitted Food value."
    else case massInGrams portion.quantity of
      Err problem -> Err problem
      Ok grams ->
        if ratEq grams (rationalZero ()) then Ok admitted
        else insertFoodQuantity (FoodQuantity { food = portion.food, quantity = MeasureQuantity { value = grams, unit = MeasureAtom { unit = units.gram } } }) admitted

insertFoodQuantity : (portion: FoodQuantity) -> (quantities: List FoodQuantity) -> Result String (List FoodQuantity)
insertFoodQuantity portion quantities = case head quantities of
  Nothing -> Ok [portion]
  Just first ->
    if foodRank portion.food < foodRank first.food then Ok (concat [portion] quantities)
    else if eq portion.food first.food then case addQuantities portion.quantity first.quantity of
      Err problem -> Err problem
      Ok combined -> Ok (concat [FoodQuantity { food = first.food, quantity = combined }] (fromMaybe [] (tail quantities)))
    else case insertFoodQuantity portion (fromMaybe [] (tail quantities)) of
      Err problem -> Err problem
      Ok inserted -> Ok (concat [first] inserted)

foodMass : (food: Food) -> (quantities: MassPantry) -> Result String MeasureQuantity
foodMass food quantities =
  if not (canonicalFood food) then Err "Use an admitted Food value."
  else case validateFoodQuantities quantities of
    Err problem -> Err problem
    Ok admitted -> foodMassAdmitted food admitted

foodMassAdmitted : (food: Food) -> (quantities: List FoodQuantity) -> Result String MeasureQuantity
foodMassAdmitted food quantities = case find (\portion -> eq portion.food food) quantities of
  Nothing -> Ok (zeroFoodMass ())
  Just portion -> case massInGrams portion.quantity of
    Err problem -> Err problem
    Ok grams -> Ok (MeasureQuantity { value = grams, unit = MeasureAtom { unit = units.gram } })

matchingMass : (foods: Pantry) -> (quantities: MassPantry) -> Result String MeasureQuantity
matchingMass foods quantities =
  if not (canonicalFoods foods) then Err "Use canonical foods without duplicate selections."
  else case validateFoodQuantities quantities of
    Err problem -> Err problem
    Ok admitted ->
      let selected = filter (\portion -> elem portion.food foods) admitted
      let addPortion = \acc portion -> case acc of
        Err problem -> Err problem
        Ok total -> addQuantities total portion.quantity
      fold addPortion (Ok (zeroFoodMass ())) selected

positiveFoods : (quantities: MassPantry) -> Result String Pantry
positiveFoods quantities = case validateFoodQuantities quantities of
  Err problem -> Err problem
  Ok admitted -> Ok (map (\portion -> portion.food) admitted)

quantitiesWithinStock : (pantry: MassPantry) -> (preparation: MassPantry) -> Result String Bool
quantitiesWithinStock pantry preparation = case validateFoodQuantities pantry of
  Err problem -> Err problem
  Ok available -> case validateFoodQuantities preparation of
    Err problem -> Err problem
    Ok selected ->
      let checkPortion = \acc portion -> case acc of
        Err problem -> Err problem
        Ok permitted -> case foodMassAdmitted portion.food available of
          Err problem -> Err problem
          Ok stock -> case massInGrams portion.quantity of
            Err problem -> Err problem
            Ok used -> Ok (permitted && not (ratLt stock.value used))
      fold checkPortion (Ok true) selected

@label "Hydration mass range"
@description "Supply exact positive lower and upper group masses and a concrete pantry. The result checks a concrete preparation; it does not enumerate quantities or assert nutritional recommendations."
hydrationMassFormula : (minimum: MeasureQuantity) -> (maximum: MeasureQuantity) -> (pantry: MassPantry) -> Result String (MassPreparation -> Result String Bool)
hydrationMassFormula minimum maximum pantry = case massInGrams minimum of
  Err problem -> Err problem
  Ok lower -> case massInGrams maximum of
    Err problem -> Err problem
    Ok upper ->
      if not (ratLt (rationalZero ()) lower) then Err "Supply a positive minimum group mass."
      else if ratLt upper lower then Err "The maximum group mass must be at least the minimum."
      else case validateFoodQuantities pantry of
        Err problem -> Err problem
        Ok admitted -> Ok (\preparation -> hydrationMassPreparation lower upper admitted preparation)

hydrationMassPreparation : (minimum: Rational) -> (maximum: Rational) -> (pantry: MassPantry) -> (preparation: MassPreparation) -> Result String Bool
hydrationMassPreparation minimum maximum pantry preparation = case validateFoodQuantities preparation of
  Err problem -> Err problem
  Ok selected ->
    if length selected == 0 then Err "Use a nonempty preparation."
    else if not (all selected (\portion -> hydrationFood portion.food)) then Ok false
    else case quantitiesWithinStock pantry selected of
      Err problem -> Err problem
      Ok enough ->
        if not enough then Ok false
        else case matchingMass [Tomato, Watermelon, Cucumber] selected of
          Err problem -> Err problem
          Ok total -> Ok (length selected >= 2 && not (ratLt total.value minimum) && not (ratLt maximum total.value))

@label "Hydration target mass"
@description "Check an exact caller-supplied target mass, with at least two hydration foods and known stock quantities. The supplied mass is an arithmetic example, not a dietary recommendation."
hydrationMassTarget : (target: MeasureQuantity) -> (pantry: MassPantry) -> Result String (MassPreparation -> Result String Bool)
hydrationMassTarget target pantry = hydrationMassFormula target target pantry

-- Synthetic exact-arithmetic examples for universal Data/Expression inspection.
-- These are input values only; no clinical or nutritional quantity is asserted.
quantityInspectionExample : { target: MeasureQuantity, pantry: MassPantry, halves: MassPreparation, thirds: MassPreparation }
quantityInspectionExample =
  let grams = \numerator denominator -> MeasureQuantity { value = Rational { num = numerator, den = denominator }, unit = MeasureAtom { unit = units.gram } }
  {
    target = grams 300 1,
    pantry = [FoodQuantity { food = Tomato, quantity = grams 300 1 }, FoodQuantity { food = Watermelon, quantity = grams 300 1 }],
    halves = [FoodQuantity { food = Tomato, quantity = grams 150 1 }, FoodQuantity { food = Watermelon, quantity = grams 150 1 }],
    thirds = [FoodQuantity { food = Tomato, quantity = grams 100 1 }, FoodQuantity { food = Watermelon, quantity = grams 200 1 }]
  }
