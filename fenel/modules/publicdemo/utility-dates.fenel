module UtilityDemo where

using std (isString, isArray, length, join, slice, numberIsFinite, floor, toNumber, toString, padStart, concat, all, filter, includes, not)
using time (Timestamp, Duration, parseIsoTimestamp, formatIsoTimestamp, diffTimestamps, addDuration, days)

-- Date-only recipes reuse time's Timestamp and Duration owners. Every admitted
-- date names UTC midnight; exact ISO roundtrips reject calendar rollover.
-- Calendar months/years preserve the day and refuse unavailable destinations.
-- Fixed days are elapsed 86400000-ms spans. No clock or local timezone is read.
-- Weekdays use the same UTC calendar; business days exclude only supplied
-- holiday dates, without a regional holiday catalogue or working-week guess.

@label "UTC weekday"
@description "The seven named weekdays in the existing UTC calendar, from Monday through Sunday."
UtcWeekday = Monday | Tuesday | Wednesday | Thursday | Friday | Saturday | Sunday

utilityDateError : String
utilityDateError = "Use a real calendar date in exact YYYY-MM-DD form, with a four-digit year from 0000 through 9999."

@label "Parse a UTC date"
@description "Parse an exact YYYY-MM-DD calendar date as the existing Timestamp at UTC midnight. Four-digit years 0000 through 9999 are supported. Reject impossible dates such as 2025-02-29, altered padding, whitespace, timestamp text and calendar rollover. No current clock or local timezone is used."
@tags "utility" "dates" "parse" "UTC"
parseUtcDate : (date: String) -> Result String Timestamp
parseUtcDate date =
  if isString date && length date == 10 then
    let iso = join [date, "T00:00:00.000Z"] ""
    case parseIsoTimestamp iso of
      Nothing -> Err (utilityDateError ())
      Just timestamp ->
        if formatIsoTimestamp timestamp == iso then Ok timestamp
        else Err (utilityDateError ())
  else Err (utilityDateError ())

utilityTimestampWeekday : (timestamp: Timestamp) -> UtcWeekday
utilityTimestampWeekday timestamp =
  let oneDay = days 1
  -- 1970-01-01 was Thursday, three days after a Monday anchor. Floor-based
  -- remainder keeps the weekday index from 0 through 6 before the epoch too.
  let mondayDays = floor (timestamp.epochMs / oneDay.ms) + 3
  let weekdayIndex = mondayDays - floor (mondayDays / 7) * 7
  if weekdayIndex == 0 then Monday
  else if weekdayIndex == 1 then Tuesday
  else if weekdayIndex == 2 then Wednesday
  else if weekdayIndex == 3 then Thursday
  else if weekdayIndex == 4 then Friday
  else if weekdayIndex == 5 then Saturday
  else Sunday

@label "Find a UTC date's weekday"
@description "Return the named Monday-through-Sunday weekday of a real exact YYYY-MM-DD date. Reuse the checked UTC Timestamp and fixed-day arithmetic; dates before 1970 and four-digit years 0000 through 9999 are supported. No clock or local timezone is read."
@tags "utility" "dates" "weekday" "UTC"
utcWeekday : (date: String) -> Result String UtcWeekday
utcWeekday date = case parseUtcDate date of
  Err problem -> Err problem
  Ok timestamp -> Ok (utilityTimestampWeekday timestamp)

utilityDateIsWeekday : (date: String) -> Bool
utilityDateIsWeekday date = case utcWeekday date of
  Err problem -> false
  Ok weekday -> case weekday of
    Saturday -> false
    Sunday -> false
    _ -> true

utilityDateAdmitted : (date: String) -> Bool
utilityDateAdmitted date = case parseUtcDate date of
  Err problem -> false
  Ok timestamp -> true

@label "Days between dates"
@description "Count signed elapsed UTC-midnight days from startDate to finishDate, excluding the starting date. Equal dates give 0; 2024-02-28 to 2024-03-01 gives 2; reversing them gives -2. Both inputs must be real exact YYYY-MM-DD dates. These are fixed 24-hour spans, independent of local daylight-saving changes."
@tags "utility" "dates" "difference" "UTC"
daysBetweenDates : (startDate: String) -> (finishDate: String) -> Result String Number
daysBetweenDates startDate finishDate =
  case parseUtcDate startDate of
    Err problem -> Err problem
    Ok start ->
      case parseUtcDate finishDate of
        Err problem -> Err problem
        Ok finish ->
          let span = diffTimestamps finish start
          let oneDay = days 1
          Ok (span.ms / oneDay.ms)

@label "Add fixed days to a date"
@description "Add a signed whole dayCount from -1000000 through 1000000 to an exact YYYY-MM-DD date at UTC midnight. Each day is the existing time.days fixed 86400000-millisecond span. Negative counts subtract days; 2024-02-28 plus 2 gives 2024-03-01. Refuse results outside four-digit years 0000 through 9999. No calendar-month or local-time policy is implied."
@tags "utility" "dates" "duration" "UTC"
addDateDays : (date: String) -> (dayCount: Number) -> Result String String
addDateDays date dayCount =
  if numberIsFinite dayCount && dayCount >= -1000000 && dayCount <= 1000000 && floor dayCount == dayCount then
    case parseUtcDate date of
      Err problem -> Err problem
      Ok timestamp ->
        let shifted = addDuration timestamp (days dayCount)
        let iso = formatIsoTimestamp shifted
        if length iso == 24 then Ok (slice iso 0 10)
        else Err "The resulting date must have a four-digit year from 0000 through 9999."
  else Err "Use a finite whole dayCount from -1000000 through 1000000."

@label "Add calendar years to a date"
@description "Add a signed whole yearCount from -9999 through 9999, preserving the date's month and day. 2026-10-06 plus 18 years gives 2044-10-06. Refuse February 29 when the destination year has no leap day; do not clamp or roll it into March. The start and result are exact YYYY-MM-DD dates with four-digit years 0000 through 9999. Calendar years differ from fixed-duration days; no clock or local timezone is used."
@tags "utility" "dates" "calendar" "years" "UTC"
addDateYears : (date: String) -> (yearCount: Number) -> Result String String
addDateYears date yearCount =
  if numberIsFinite yearCount && yearCount >= -9999 && yearCount <= 9999 && floor yearCount == yearCount then
    case parseUtcDate date of
      Err problem -> Err problem
      Ok timestamp ->
        let destinationYear = toNumber (slice date 0 4) + yearCount
        if destinationYear >= 0 && destinationYear <= 9999 then
          let candidate = join [padStart (toString destinationYear) 4 "0", slice date 4 10] ""
          case parseUtcDate candidate of
            Err problem -> Err "The destination year has no such month/day. A leap day is refused instead of being clamped or rolled forward."
            Ok destination -> Ok candidate
        else Err "The resulting date must have a four-digit year from 0000 through 9999."
  else Err "Use a finite whole yearCount from -9999 through 9999."

@label "Add calendar months to a date"
@description "Add a signed whole monthCount from -119999 through 119999, preserving the day of the month. January 31 plus one month refuses; January 31 plus two months gives March 31. Refuse an unavailable destination day instead of clamping or rolling forward. The start and result are exact YYYY-MM-DD dates with four-digit years 0000 through 9999. Calendar months differ from fixed elapsed durations."
@tags "utility" "dates" "calendar" "months" "UTC"
addDateMonths : (date: String) -> (monthCount: Number) -> Result String String
addDateMonths date monthCount =
  if numberIsFinite monthCount && monthCount >= -119999 && monthCount <= 119999 && floor monthCount == monthCount then
    case parseUtcDate date of
      Err problem -> Err problem
      Ok timestamp ->
        let destinationIndex = toNumber (slice date 0 4) * 12 + toNumber (slice date 5 7) - 1 + monthCount
        if destinationIndex >= 0 && destinationIndex <= 119999 then
          let destinationYear = floor (destinationIndex / 12)
          let destinationMonth = destinationIndex - destinationYear * 12 + 1
          let candidate = join [padStart (toString destinationYear) 4 "0", "-", padStart (toString destinationMonth) 2 "0", slice date 7 10] ""
          case parseUtcDate candidate of
            Err problem -> Err "The destination month has no such day. It is refused instead of being clamped or rolled forward."
            Ok destination -> Ok candidate
        else Err "The resulting date must have a four-digit year from 0000 through 9999."
  else Err "Use a finite whole monthCount from -119999 through 119999."

utilityDateRangeValues : (start: Timestamp) -> (dayCount: Number) -> List String
utilityDateRangeValues start dayCount =
  if dayCount <= 0 then []
  else concat [slice (formatIsoTimestamp start) 0 10] (utilityDateRangeValues (addDuration start (days 1)) (dayCount - 1))

@label "List an inclusive UTC date range"
@description "List each real YYYY-MM-DD date from startDate through finishDate, including both ends. Equal endpoints produce one date; leap days and year boundaries use existing UTC Timestamp and fixed-day arithmetic. Refuse reversed endpoints and ranges over 366 dates. No local timezone, clock or business-day policy is used."
@tags "utility" "dates" "range" "UTC"
utcDateRange : (startDate: String) -> (finishDate: String) -> Result String (List String)
utcDateRange startDate finishDate =
  case parseUtcDate startDate of
    Err problem -> Err problem
    Ok start ->
      case parseUtcDate finishDate of
        Err problem -> Err problem
        Ok finish ->
          let span = diffTimestamps finish start
          let oneDay = days 1
          let dayCount = span.ms / oneDay.ms + 1
          if dayCount < 1 then Err "Finish must be at or after start for an inclusive UTC date range."
          else if dayCount > 366 then Err "An inclusive UTC date range may contain at most 366 dates."
          else Ok (utilityDateRangeValues start dayCount)

@label "List weekdays in a UTC date range"
@description "Keep Monday through Friday from the existing inclusive UTC date range, in date order. Weekend endpoints are omitted; a weekend-only range returns an empty list. The original span may contain at most 366 calendar dates, before filtering. Both endpoints must be real exact YYYY-MM-DD dates and finish must be at or after start. No holidays, clock or local timezone are inferred."
@tags "utility" "dates" "range" "weekday" "UTC"
utcWeekdayRange : (startDate: String) -> (finishDate: String) -> Result String (List String)
utcWeekdayRange startDate finishDate = case utcDateRange startDate finishDate of
  Err problem -> Err problem
  Ok dates -> Ok (filter utilityDateIsWeekday dates)

@label "List business days with supplied holidays"
@description "Keep Monday through Friday from the inclusive UTC date range, then exclude the supplied holiday dates. Supply an explicit holiday list, including an empty list when there are none; no regional or observed holidays are guessed. The span may contain at most 366 calendar dates and the holiday list at most 366 entries. Every holiday must be a real exact YYYY-MM-DD date, including holidays outside the range. Duplicate and weekend holidays have no extra effect. Weekend/holiday-only ranges return an empty list; results retain date order."
@tags "utility" "dates" "range" "business-days" "holidays" "UTC"
utcBusinessDayRange : (startDate: String) -> (finishDate: String) -> (holidays: List String) -> Result String (List String)
utcBusinessDayRange startDate finishDate holidays =
  if isArray holidays && length holidays <= 366 && all holidays utilityDateAdmitted then
    case utcWeekdayRange startDate finishDate of
      Err problem -> Err problem
      Ok dates -> Ok (filter (\date -> not (includes holidays date)) dates)
  else Err "Supply at most 366 holidays, each a real calendar date in exact YYYY-MM-DD form with a four-digit year from 0000 through 9999."

@label "Add a duration to a UTC date"
@description "Add the existing Duration's signed milliseconds to an exact YYYY-MM-DD date at UTC midnight, retaining the time of day in the existing Timestamp result. One hour, six minutes and five seconds is Duration 3965000 milliseconds and gives 01:06:05 UTC. Duration milliseconds must be finite and between -86400000000000 and 86400000000000, equivalent to one million fixed days. Fractional milliseconds retain the existing Number approximation. Refuse results outside four-digit years 0000 through 9999; no clock or local timezone is read."
@tags "utility" "dates" "duration" "UTC"
addDateDuration : (date: String) -> (span: Duration) -> Result String Timestamp
addDateDuration date span =
  if numberIsFinite span.ms && span.ms >= -86400000000000 && span.ms <= 86400000000000 then
    case parseUtcDate date of
      Err problem -> Err problem
      Ok timestamp ->
        let shifted = addDuration timestamp span
        -- Exact existing UTC year bounds also reject fractional underflow
        -- that the host's millisecond ISO formatter could truncate away.
        if shifted.epochMs >= -62167219200000 && shifted.epochMs < 253402300800000 then Ok shifted
        else Err "The resulting timestamp must have a four-digit year from 0000 through 9999."
  else Err "Use a Duration with finite milliseconds from -86400000000000 through 86400000000000."

@label "Date tools"
@description "Parse real UTC dates, find named weekdays, count signed days, list bounded inclusive date/weekday ranges or business days with supplied holidays, add fixed elapsed days or Duration data, and add calendar months/years with explicit unavailable-day refusal. Ordinary typed functions use the existing Timestamp and Duration owners. Dates are exact YYYY-MM-DD text, and every failure remains a Result error."
@tags "utility" "dates" "UTC"
dateTools : {
  parseUtcDate: (date: String) -> Result String Timestamp,
  daysBetweenDates: (startDate: String) -> (finishDate: String) -> Result String Number,
  addDateDays: (date: String) -> (dayCount: Number) -> Result String String,
  addDateYears: (date: String) -> (yearCount: Number) -> Result String String,
  addDateMonths: (date: String) -> (monthCount: Number) -> Result String String,
  utcDateRange: (startDate: String) -> (finishDate: String) -> Result String (List String),
  addDateDuration: (date: String) -> (span: Duration) -> Result String Timestamp,
  utcWeekday: (date: String) -> Result String UtcWeekday,
  utcWeekdayRange: (startDate: String) -> (finishDate: String) -> Result String (List String),
  utcBusinessDayRange: (startDate: String) -> (finishDate: String) -> (holidays: List String) -> Result String (List String)
}
dateTools = { parseUtcDate = parseUtcDate, daysBetweenDates = daysBetweenDates, addDateDays = addDateDays, addDateYears = addDateYears, addDateMonths = addDateMonths, utcDateRange = utcDateRange, addDateDuration = addDateDuration, utcWeekday = utcWeekday, utcWeekdayRange = utcWeekdayRange, utcBusinessDayRange = utcBusinessDayRange }

utilityDateStartingInputs : List ({ function: Any, arguments: List Any })
utilityDateStartingInputs = [
  { function = parseUtcDate, arguments = ["2024-02-29"] },
  { function = daysBetweenDates, arguments = ["2024-02-28", "2024-03-01"] },
  { function = addDateDays, arguments = ["2024-02-28", 2] },
  { function = addDateYears, arguments = ["2026-10-06", 18] },
  { function = addDateMonths, arguments = ["2024-01-29", 1] },
  { function = utcDateRange, arguments = ["2024-02-28", "2024-03-01"] },
  { function = addDateDuration, arguments = ["2026-10-07", Duration { ms = 3965000 }] },
  { function = utcWeekday, arguments = ["2026-10-14"] },
  { function = utcWeekdayRange, arguments = ["2026-10-09", "2026-10-13"] },
  { function = utcBusinessDayRange, arguments = ["2026-10-09", "2026-10-13", ["2026-10-12"]] }
]
