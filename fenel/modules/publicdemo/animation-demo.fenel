module AnimationDemo where

import std (sin, map)
import DrawingDemo (DrawingRadius, layeredPicture, drawingTriangle, drawingLine)
import animation (Animation, Animate, FrameSequence, renderAnim)
import sound (Time, time)
import picture (Picture, Image, render)

-- GP-60's bounded first slice reuses DrawingDemo's exact layered scene.
-- Fenel owns motion and sampling; the existing frame player displays only
-- the finite rendered sequence. No live function evaluation or saved state.

@label "Animation speed"
@description "Motion speed from half speed to twice the starting speed."
AnimationSpeed = Number | value ∈ [0.5..2]

@label "Animation instant"
@description "A time in seconds within the two-second clip, including its end."
AnimationInstant = Number | value ∈ [0..2]

@label "Animation snapshot"
@description "The exact sample time, the circle's horizontal position and the rendered image at that instant."
@discriminator "$tag"
AnimationSnapshot = AnimationSnapshot seconds: Number position: Number image: Image

@label "Motion formula"
@description "Horizontal centre = 36 + 16*sin(pi*speed*seconds). The circle stays between pixel columns 20 and 52; one cycle takes two seconds at speed 1."
motionFormula : (speed: AnimationSpeed) -> (seconds: Number) -> Number
motionFormula speed seconds = 36 + 16 * sin (3.141592653589793 * speed * seconds)

@label "Picture at a time"
@description "Move the existing Drawing circle while retaining the triangle, diagonal line, colours and layer order."
animationPicture : (radius: DrawingRadius) -> (speed: AnimationSpeed) -> (instant: Time) -> Picture
animationPicture radius speed instant = layeredPicture radius (motionFormula speed instant.seconds) (drawingTriangle ()) (drawingLine ())

@label "Drawing over time"
@description "An ordinary Animate value carrying the Fenel Time-to-Picture function. Use the rendered clip to play it; this formula itself is inspectable data."
drawingAnimation : (radius: DrawingRadius) -> (speed: AnimationSpeed) -> Animation
drawingAnimation radius speed = Animate (animationPicture radius speed)

@label "Play the drawing"
@description "Render exactly 16 frames at 8 fps: a two-second, 72 by 48 pixel clip of the existing Drawing scene. Change radius or speed, then play, pause or scrub the finite result. No data is saved."
@tags "demo" "animation" "picture" "time"
animationClip : (radius: DrawingRadius) -> (speed: AnimationSpeed) -> FrameSequence
animationClip radius speed = renderAnim (drawingAnimation radius speed) 2 8 72 48

@label "Inspect one instant"
@description "Sample the same source at an exact time from 0 to 2 seconds. The clip includes 0 through 1.875 seconds; its endpoint at 2 is available here."
@tags "demo" "animation" "time" "snapshot"
animationSnapshot : (radius: DrawingRadius) -> (speed: AnimationSpeed) -> (seconds: AnimationInstant) -> AnimationSnapshot
animationSnapshot radius speed seconds =
  let instant = time seconds
  let picture = animationPicture radius speed instant
  AnimationSnapshot { seconds = seconds, position = motionFormula speed seconds, image = render picture 72 48 }

@label "Four fixed snapshots"
@description "Deterministic samples of the same scene at 0, 0.5, 1 and 1.5 seconds. At speed 1 these show centre, right, centre and left."
animationSnapshots : (radius: DrawingRadius) -> (speed: AnimationSpeed) -> List AnimationSnapshot
animationSnapshots radius speed = map (animationSnapshot radius speed) [0, 0.5, 1, 1.5]

animationDemoStartingInputs : List ({ function: Any, arguments: List Any })
animationDemoStartingInputs = [
  { function = animationClip, arguments = [8, 1] },
  { function = animationSnapshot, arguments = [8, 1, 0.5] },
  { function = animationSnapshots, arguments = [8, 1] },
  { function = motionFormula, arguments = [1, 0.5] },
  { function = drawingAnimation, arguments = [8, 1] }
]
