module DrawingDemo where

using std (map, take, length, fold, min, max, join, toString, all, numberIsFinite, isArray, concat)
using picture (Point, point, color, solid, circle, rectangle, over, render)
using path (path, line, stroke, fill)

-- The formula, sampled points, paths and composition are ordinary Fenel
-- values. The existing Image lens draws the bounded raster result. This
-- demo samples a polyline; it does not claim an exact symbolic curve.

@label "Circle radius"
@description "Radius in pixels, from 2 to 12."
DrawingRadius = Nat | value ∈ [2..12]

@label "Circle position"
@description "Horizontal centre in pixels, from 16 to 56."
DrawingPosition = Number | value ∈ [16..56]

@label "Formula curve result"
@description "The formula's math coordinates, the displayed pixel-coordinate path, its Picture and the 72 by 48 pixel rendering. Geometry beyond the canvas edges is clipped."
@discriminator "$tag"
FormulaCurveResult = FormulaCurveResult points: List Point curve: CurvePath picture: Picture image: Image explanation: String

@label "Layered drawing result"
@description "The editable circle parameters, the polygon and line paths, the composed Picture and its 72 by 48 pixel rendering."
@discriminator "$tag"
LayeredDrawingResult = LayeredDrawingResult radius: Nat position: Number polygon: CurvePath line: CurvePath picture: Picture image: Image

@label "Point chart bounds"
PointChartBounds = PointChartBounds xMin: Number xMax: Number yMin: Number yMax: Number

@label "Projected chart point"
PointChartMark = PointChartMark x: Number y: Number label: String value: Number valueLabel: String title: String

@label "Point line plot"
PointLinePlot = PointLinePlot width: Number height: Number right: Number xAxisY: Number yAxisX: Number path: String marks: List PointChartMark

@label "Point line chart"
@description "Original numerical points with a Fenel-projected, zero-inclusive line plot, or an explicit coordinate refusal. Lines join the supplied points in their original order."
@discriminator "$tag"
PointLineChart = PointLineChart points: List Point bounds: PointChartBounds plot: PointLinePlot explanation: String
  | PointLineChartRefused reason: String

@label "Chart coordinate admitted?"
@description "This bounded chart accepts finite coordinates between -1000000 and 1000000, keeping its projection arithmetic finite."
chartCoordinateAdmitted : (value: Number) -> Bool
chartCoordinateAdmitted value = numberIsFinite value && value >= -1000000 && value <= 1000000

chartPointAdmitted : (p: Point) -> Bool
chartPointAdmitted p = chartCoordinateAdmitted p.x && chartCoordinateAdmitted p.y

@label "Point chart bounds"
@description "Include zero in both numerical axes. Empty and all-zero domains expand to 0 through 1; singleton and constant series remain finite."
pointChartBounds : (points: List Point) -> PointChartBounds
pointChartBounds points =
  let xMin = fold (\n p -> min n p.x) 0 points
  let xMax = fold (\n p -> max n p.x) 0 points
  let yMin = fold (\n p -> min n p.y) 0 points
  let yMax = fold (\n p -> max n p.y) 0 points
  PointChartBounds { xMin = xMin, xMax = if xMax == xMin then xMin + 1 else xMax, yMin = yMin, yMax = if yMax == yMin then yMin + 1 else yMax }

chartPixelX : (bounds: PointChartBounds) -> (right: Number) -> (x: Number) -> Number
chartPixelX bounds right x = 30 + (x - bounds.xMin) / (bounds.xMax - bounds.xMin) * (right - 30)

chartPixelY : (bounds: PointChartBounds) -> (y: Number) -> Number
chartPixelY bounds y = 160 - (y - bounds.yMin) / (bounds.yMax - bounds.yMin) * 150

chartPointMark : (bounds: PointChartBounds) -> (right: Number) -> (p: Point) -> PointChartMark
chartPointMark bounds right p =
  let coordinate = toString p.x
  let showLabel = p.x == bounds.xMin || p.x == bounds.xMax || p.x == 0
  let label = if showLabel then coordinate else ""
  let valueLabel = if showLabel then toString p.y else ""
  PointChartMark { x = chartPixelX bounds right p.x, y = chartPixelY bounds p.y, label = label, value = p.y, valueLabel = valueLabel, title = join ["(", coordinate, ", ", toString p.y, ")"] "" }

chartLinePath : (marks: List PointChartMark) -> String
chartLinePath marks = fold (\s p -> join [s, if s == "" then "M " else " L ", toString p.x, " ", toString p.y] "") "" marks

chartLinePlot : (bounds: PointChartBounds) -> (points: List Point) -> PointLinePlot
chartLinePlot bounds points =
  let right = 450
  let marks = map (chartPointMark bounds right) points
  PointLinePlot { width = right + 30, height = 205, right = right, xAxisY = chartPixelY bounds 0, yAxisX = chartPixelX bounds right 0, path = chartLinePath marks, marks = marks }

@label "Chart point data"
@description "Plot ordinary x/y points through the shared line chart. Numerical x spacing and signed y values are preserved; straight segments follow input order. Coordinates outside the finite -1000000 to 1000000 range are refused."
@tags "demo" "chart" "points"
pointLineChart : (points: List Point) -> PointLineChart
pointLineChart points =
  if isArray points then
    if all points chartPointAdmitted then
      let bounds = pointChartBounds points
      PointLineChart { points = points, bounds = bounds, plot = chartLinePlot bounds points, explanation = "Numerical x and y coordinates; axes include zero. Straight segments join the supplied points in their original order." }
    else PointLineChartRefused { reason = "Coordinates must be finite and between -1000000 and 1000000." }
  else PointLineChartRefused { reason = "Points must be a list." }

@label "Formula to chart"
@description "Edit a function of x and plot its 25 samples from -3 to 3. Inspect the original numerical points, signed bounds and Fenel projection. This is a sampled polyline, not an exact symbolic curve."
@tags "demo" "math" "chart" "function"
formulaChart : (formula: ((x: Number) -> Number)) -> PointLineChart
formulaChart formula = pointLineChart (formulaPoints formula)

@label "Function graph"
@description "Plot a Number-to-Number function over lo..hi from 51 evenly spaced samples. A sample whose value is not a finite number between -1000000 and 1000000 leaves a gap in the line. A function card shows this for a pure one-parameter numeric function; the range comes from its parameter type. This is a sampled polyline, not an exact symbolic curve."
@tags "chart" "function"
functionGraph : (formula: ((x: Number) -> Number)) -> (lo: Number) -> (hi: Number) -> PointLineChart
functionGraph formula lo hi =
  if chartCoordinateAdmitted lo && chartCoordinateAdmitted hi && lo < hi
  then functionGraphDrawn lo hi (map (\x -> functionGraphSample formula x) (functionGraphXs lo ((hi - lo) / 50) 0))
  else PointLineChartRefused { reason = "The range must be finite, between -1000000 and 1000000, and increasing." }

functionGraphDrawn : (lo: Number) -> (hi: Number) -> (samples: List (Maybe Point)) -> PointLineChart
functionGraphDrawn lo hi samples =
  let shown = fold (\acc s -> functionGraphKeep acc s) [] samples
  if length shown == 0 then PointLineChartRefused { reason = "No sampled value is a finite number in this range." }
  else functionGraphChart lo hi samples shown

functionGraphChart : (lo: Number) -> (hi: Number) -> (samples: List (Maybe Point)) -> (shown: List Point) -> PointLineChart
functionGraphChart lo hi samples shown =
  let bounds = pointChartBounds shown
  let plot = chartLinePlot bounds shown
  PointLineChart { points = shown, bounds = bounds, plot = PointLinePlot { width = plot.width, height = plot.height, right = plot.right, xAxisY = plot.xAxisY, yAxisX = plot.yAxisX, path = chartGapPath bounds plot.right samples, marks = plot.marks }, explanation = join ["51 samples from x=", toString lo, " to x=", toString hi, ". Straight segments join neighbouring finite samples; other samples leave gaps."] "" }

functionGraphXs : (lo: Number) -> (step: Number) -> (i: Number) -> List Number
functionGraphXs lo step i = if i > 50 then [] else concat [lo + step * i] (functionGraphXs lo step (i + 1))

-- A sample is judged on the formula's own answer, BEFORE a Point is built:
-- `point` reads a non-number coordinate as 0 and `div` answers 0 for a zero
-- divisor, so a check on the built Point would draw NaN as a point at y = 0.
functionGraphSample : (formula: ((x: Number) -> Number)) -> (x: Number) -> Maybe Point
functionGraphSample formula x =
  let y = formula x
  if chartCoordinateAdmitted x && chartCoordinateAdmitted y then Just (point x y) else Nothing

functionGraphKeep : (acc: List Point) -> (sample: Maybe Point) -> List Point
functionGraphKeep acc sample = case sample of
  Just p -> concat acc [p]
  Nothing -> acc

-- One path over every sample in order: a drawn sample extends the current
-- segment (or starts one with M); a gap lifts the pen. (The fold result is
-- bound first: `(fold ...).path` parses as a composition with `path`.)
chartGapPath : (bounds: PointChartBounds) -> (right: Number) -> (samples: List (Maybe Point)) -> String
chartGapPath bounds right samples =
  let drawn = fold (\acc s -> chartGapStep bounds right acc s) { path = "", down = false } samples
  drawn.path

chartGapStep : (bounds: PointChartBounds) -> (right: Number) -> (acc: { path: String, down: Bool }) -> (sample: Maybe Point) -> { path: String, down: Bool }
chartGapStep bounds right acc sample = case sample of
  Just p -> chartGapDraw bounds right acc p
  Nothing -> { path = acc.path, down = false }

chartGapDraw : (bounds: PointChartBounds) -> (right: Number) -> (acc: { path: String, down: Bool }) -> (p: Point) -> { path: String, down: Bool }
chartGapDraw bounds right acc p =
  let move = if acc.down then " L " else if acc.path == "" then "M " else " M "
  { path = join [acc.path, move, toString (chartPixelX bounds right p.x), " ", toString (chartPixelY bounds p.y)] "", down = true }

@label "Square formula"
@description "The starting Number-to-Number function: x*x. Inspect its source, or replace this function argument with a lambda of your own."
squareFormula : (x: Number) -> Number
squareFormula x = x * x

@label "Sample a formula"
@description "Evaluate a Number-to-Number function at 25 x coordinates from -3 to 3, spaced by one quarter. These are math coordinates, before canvas projection."
formulaPoints : (formula: ((x: Number) -> Number)) -> List Point
formulaPoints formula = map (\x -> point x (formula x)) [-3, -2.75, -2.5, -2.25, -2, -1.75, -1.5, -1.25, -1, -0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2, 2.25, 2.5, 2.75, 3]

@label "Project math coordinates"
@description "Map x from -3 to 3 into the image's horizontal span. Image y increases downwards; math y increases upwards. Math y=0 is pixel row 43, with 3 pixels per y unit."
curveCoordinates : (points: List Point) -> List Point
curveCoordinates points = map (\p -> point (6 + (p.x + 3) * 10) (43 - p.y * 3)) points

@label "Join points with lines"
@description "Build one CurvePath with exactly one straight linker per consecutive point pair. Each linker is a function value."
straightPath : (points: List Point) -> CurvePath
straightPath points = path points (map (\p -> line) (take (length points - 1) points))

@label "Draw a sampled curve"
@description "Layer the existing stroked path over the two coordinate axes and a light background."
curvePicture : (curve: CurvePath) -> Picture
curvePicture curve =
  let horizontal = rectangle (point 3 43) (point 69 43) (color 179 186 196 255)
  let vertical = rectangle (point 36 3) (point 36 46) (color 179 186 196 255)
  let axes = over vertical (over horizontal (solid (color 245 247 250 255)))
  over (stroke curve 1.5 (color 72 98 222 255)) axes

@label "Formula to curve"
@description "Start with the Square formula function. Choose Lambda in its argument editor to enter your own function of x, such as x+3, then try it again. Inspect the 25 typed points, the pixel path and the composed Picture. This is a sampled polyline with fixed pixel scaling; geometry beyond the canvas edges is clipped."
@tags "demo" "math" "picture" "function" "curve"
formulaCurve : (formula: ((x: Number) -> Number)) -> FormulaCurveResult
formulaCurve formula =
  let points = formulaPoints formula
  let curve = straightPath (curveCoordinates points)
  let picture = curvePicture curve
  FormulaCurveResult { points = points, curve = curve, picture = picture, image = render picture 72 48, explanation = "25 samples from x=-3 to x=3. Straight segments join them. Math y=0 is pixel row 43, with 3 pixels per y unit. Geometry beyond the canvas edges is clipped." }

@label "Draw layered shapes"
@description "Change the circle's radius and horizontal position. A filled triangle, a stroked line and the circle share one Picture composition. Inspect each path, the Picture and the rendered image; no data is saved."
@tags "demo" "picture" "geometry" "layers"
layeredDrawing : (radius: DrawingRadius) -> (position: DrawingPosition) -> LayeredDrawingResult
layeredDrawing radius position =
  let polygon = drawingTriangle ()
  let segment = drawingLine ()
  let picture = layeredPicture radius position polygon segment
  LayeredDrawingResult { radius = radius, position = position, polygon = polygon, line = segment, picture = picture, image = render picture 72 48 }

@label "Triangle path"
@description "The closed triangle's four anchors in canvas pixels. Straight linkers join consecutive anchors."
drawingTriangle : CurvePath
drawingTriangle = straightPath [point 7 41, point 26 20, point 43 41, point 7 41]

@label "Diagonal line path"
@description "The diagonal's two endpoints in canvas pixels, joined by a straight linker."
drawingLine : CurvePath
drawingLine = straightPath [point 5 8, point 66 38]

@label "Compose picture layers"
@description "Place the circle over the stroked line, the filled triangle and the light background. The layer order and colours are ordinary Fenel source."
layeredPicture : (radius: Number) -> (position: Number) -> (polygon: CurvePath) -> (segment: CurvePath) -> Picture
layeredPicture radius position polygon segment =
  let background = solid (color 245 247 250 255)
  let triangle = fill polygon (color 126 199 153 255)
  let diagonal = stroke segment 2 (color 70 98 218 255)
  let disk = circle (point position 16) radius (color 239 169 73 255)
  over disk (over diagonal (over triangle background))

-- Starting input holds the source-owned function as a Ref. The canonical
-- arrow editor can replace it with a lambda. Runtime closures do not yet
-- project into prefilled editable lambda bodies at this authoring boundary.
drawingDemoStartingInputs : List ({ function: Any, arguments: List Any })
drawingDemoStartingInputs = [
  { function = formulaCurve, arguments = [squareFormula] },
  { function = layeredDrawing, arguments = [8, 51] },
  { function = formulaChart, arguments = [squareFormula] }
]
