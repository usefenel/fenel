module ImportDemo where

import codec (JsonValue)
import StatisticsDemo (StatisticsPurchase)

@label "Import text"
@description "Paste CSV or JSON into the shared multiline text editor. This is ordinary typed input; no file is uploaded or saved."
@widget "text" "textarea"
ImportTextInput = ImportTextInput text: String

@label "JSON purchase check"
@description "Separate a text limit, JSON syntax failure, a decoded value with the wrong purchase shape, and an accepted typed purchase. JSON syntax uses the existing host codec; the purchase decoder and amount membership are Fenel."
@discriminator "$tag"
ImportJsonCheck = ImportTextRefused reason: String | ImportJsonSyntaxRejected reason: String | ImportPurchaseRejected parsed: JsonValue reason: String | ImportPurchaseAccepted parsed: JsonValue purchase: StatisticsPurchase amountMembership: Maybe Boolean

-- This parser deliberately supports one physical line per CSV row. Its state
-- and failures are ordinary data, available through the universal editor.
ImportCsvMode = ImportCsvBare | ImportCsvQuoted | ImportCsvClosed

ImportCsvState = ImportCsvState fields: List String current: String mode: ImportCsvMode failure: Maybe String

ImportCsvRows = ImportCsvRows rows: List StatisticsPurchase nextLine: Nat
