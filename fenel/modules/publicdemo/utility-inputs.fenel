module UtilityDemo where

using std (concat)

-- Starting data belongs to the same source owner as the callable recipes.
-- Function fields are references, so their names never become identity keys.
utilityDemoStartingInputs : List ({ function: Any, arguments: List Any })
utilityDemoStartingInputs = concat (concat (utilityTextStartingInputs ()) (utilityNumberStartingInputs ())) (concat (concat (utilityColorStartingInputs ()) (utilityDateStartingInputs ())) (utilityUnitStartingInputs ()))
