module ShowcaseDemo where

using std (map, concat, typeOf, recordType, assocRecord, Image)
using view (linkedDemoSavedValue, linkedDemoItem, linkedDemoTypeField, TabDataCommand, TabEditValues, TabEditEntries, LocusAppend, LocusEntry)
using Encyclopedia (PlantFamily, PlantGenus, PlantSpecies, PlantTaxon, BotanicalIllustration, PlateCredit, apiaceae, foeniculum, ferula, commonFennel, giantFennel, foeniculumVulgarePlateCredit, narthexAsafoetidaPlateCredit, foeniculumVulgareIllustration, narthexAsafoetidaIllustration, foeniculumVulgarePlateImage, narthexAsafoetidaPlateImage, ProgrammingLanguage, PlantNamedSpeciesSet, programmingLanguages, encyclopediaFennels, encyclopediaFennelsIn, languageLisp, languageSmalltalk, languageProlog, languageSql, languageErlang, languageCoq, languageHaskell, languageOCaml, languageScratch, languageTypeScript)
using RecipeFunctions (Recipe, lubeFormula, hydrationFormula)

-- Public identity data, distinct from CRM and authentication profiles. Missing
-- biographies, dates and public links stay absent; no private facts are seeded.
-- Public bindings and temporary copies use the existing saved-expression
-- slots. Projects point at people, plants, languages, the fennels set and the
-- projects that inspired them, the fennels set at its plants, and the mascot
-- at its project, so the retained graph stays acyclic. Plants, languages and
-- the fennels set are the Encyclopedia module's; the formulas are
-- RecipeFunctions' own functions, held by reference.

-- The closed choice of where a social link points. This is not std's
-- Platform entity (fenel/std/entities/platform.fenel), a record of handle
-- rules for CRM profile handles.
@label "Social Platform"
@description "The platform a social link points at."
SocialPlatform = X | YouTube | GitHub | Telegram | Reddit

-- Each platform constructor's display name, keyed by its bare tag.
_ : Labelable "X"
_ = Labelable { label = "X" }
_ : Labelable "YouTube"
_ = Labelable { label = "YouTube" }
_ : Labelable "GitHub"
_ = Labelable { label = "GitHub" }
_ : Labelable "Telegram"
_ = Labelable { label = "Telegram" }
_ : Labelable "Reddit"
_ = Labelable { label = "Reddit" }

@label "Social link"
@description "A public URL associated with an existing social platform. People and projects use the same data type."
@fieldLabel "platform" "Platform"
@fieldLabel "url" "Link"
SocialLink = SocialLink platform: SocialPlatform url: UrlStr

@label "Person"
@icon "user"
@description "Public name, an optional picture, and optional biography, birth date and social links. This data grants no account access."
@fieldLabel "name" "Name"
@fieldLabel "picture" "Picture"
@fieldLabel "biography" "Biography"
@fieldLabel "birthDate" "Birth Date"
@fieldLabel "socialLinks" "Social Links"
PublicPerson = PublicPerson name: String picture: Maybe Image biography: Maybe String birthDate: Maybe Date socialLinks: List SocialLink

@label "Emblem"
@description "A plant a project takes as an emblem, what it stands for, and where that meaning comes from."
@fieldLabel "meaning" "Meaning"
@fieldLabel "plant" "Plant"
@fieldLabel "source" "Source"
Emblem = Emblem meaning: String plant: PlantSpecies source: String

-- A logo is a constructor; its picture is attached beside it as a Picturable
-- instance (people-pictures.fenel), the food pictures' mechanism, so a project
-- record holds no pixel data and compares as ordinary data.
@label "Logo"
@icon "image"
@description "The logo of a project. Its picture is attached to the logo, never stored inside the project."
Logo = PrimalDiet | Healthfully | BayneOS | DripCollector | SevenCatYear | FenelLogo

-- Each logo constructor's display name, keyed by its bare tag.
_ : Labelable "FenelLogo"
_ = Labelable { label = "Fenel" }
_ : Labelable "PrimalDiet"
_ = Labelable { label = "Primal Diet" }
_ : Labelable "Healthfully"
_ = Labelable { label = "Healthfully" }
_ : Labelable "BayneOS"
_ = Labelable { label = "BayneOS" }
_ : Labelable "DripCollector"
_ = Labelable { label = "DripCollector" }
_ : Labelable "SevenCatYear"
_ = Labelable { label = "7CatYear" }

@label "Project"
@icon "folder"
@description "A project of any kind: its people, website, contact email, first release year and logo, the projects and programming languages that inspired it, the formulas it holds, the plants it is named after, the plant sets that inspired its logo, and its emblems. Each person, project, plant and language remains ordinary typed data; a formula is a reference to its function."
@fieldLabel "name" "Name"
@fieldLabel "description" "Description"
@fieldLabel "logo" "Logo"
@fieldLabel "website" "Website"
@fieldLabel "contactEmail" "Contact Email"
@fieldLabel "firstRelease" "First Release"
@fieldLabel "socialLinks" "Social Links"
@fieldLabel "authors" "Authors"
@fieldLabel "inspiredBy" "Inspired By"
@fieldLabel "inspiredByLanguages" "Inspired By Languages"
@fieldLabel "formulas" "Formulas"
@fieldLabel "namedAfter" "Named After"
@fieldLabel "logoInspiredBy" "Logo Inspired By"
@fieldLabel "emblems" "Emblems"
Project = Project name: String description: String logo: Maybe Logo website: Maybe UrlStr contactEmail: Maybe EmailStr firstRelease: Maybe Nat socialLinks: List SocialLink authors: List PublicPerson inspiredBy: List Project inspiredByLanguages: List ProgrammingLanguage formulas: List Recipe namedAfter: List PlantSpecies logoInspiredBy: List PlantNamedSpeciesSet emblems: List Emblem

@label "Mascot"
@icon "user"
@description "A fictional character that represents a project. It is inspired by plants and is not itself a plant."
@fieldLabel "name" "Name"
@fieldLabel "description" "Description"
@fieldLabel "mascotOf" "Mascot Of"
@fieldLabel "inspiredBy" "Inspired By"
Mascot = Mascot name: String description: String mascotOf: Project inspiredBy: List PlantSpecies

