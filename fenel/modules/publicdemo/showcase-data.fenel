@label "People"
showcasePeople : List PublicPerson
showcasePeople = [showcaseRom (), showcaseBayne (), showcaseAajonus ()]

@label "Projects"
showcaseProjects : List Project
showcaseProjects = [showcaseFenel (), showcasePrimalDiet (), showcaseHealthfully (), showcaseBayneOS (), showcaseDripCollector (), showcaseSevenCatYear ()]

showcaseLiteral : a -> { kind: String, value: a }
showcaseLiteral value = { kind = "literal", value = value }

showcaseField : String -> e -> { name: String, value: e }
showcaseField name expression = { name = name, value = expression }

showcaseReference : String -> { kind: String, savedExprId: String }
showcaseReference identity = { kind = "ref", savedExprId = identity }

showcaseConstruct : String -> List f -> { kind: String, value: { __construct: { tag: String, fields: List f } } }
showcaseConstruct tag fields = showcaseLiteral { __construct = { tag = tag, fields = fields } }

showcaseCall : String -> { kind: String, fnId: String, args: List ({ kind: String, savedExprId: String }) }
showcaseCall handle = { kind = "call", fnId = handle, args = [] }

-- A list of links to other records, one reference per saved identity.
showcaseReferences : List String -> { kind: String, value: { __list: List ({ kind: String, savedExprId: String }) } }
showcaseReferences identities = showcaseLiteral { __list = map (\identity -> showcaseReference identity) identities }

-- A function held as data: a literal reference to its exact identity, never
-- a call and never a name string.
showcaseFunctionReference : String -> { kind: String, value: Any }
showcaseFunctionReference identity = showcaseLiteral (assocRecord {} "$ref" identity)

-- This finite schema preserves the actual ExprNode wires and their value/type
-- payloads. It is not another AST, data resolver or admission judgment.
showcaseSourceTypes : Type -> { saved: Type, item: Type, command: Type }
showcaseSourceTypes personType =
  let textType = typeOf ""
  let universe = assocRecord {} "$type" true
  let unitType = assocRecord {} "$unit" true
  let listOf = \element -> assocRecord {} "$el" (assocRecord {} "call" ["List", element])
  let literalOf = \payload -> recordType [linkedDemoTypeField "kind" textType, linkedDemoTypeField "value" payload]
  let socialLinksType = listOf (assocRecord {} "$ref" "SocialLink")
  let reference = recordType [linkedDemoTypeField "kind" textType, linkedDemoTypeField "savedExprId" textType]
  let referenceList = literalOf (recordType [linkedDemoTypeField "__list" (listOf reference)])
  let textLiteral = literalOf textType
  let linksLiteral = literalOf socialLinksType
  let namesLiteral = literalOf (listOf textType)
  let lifeFormLiteral = literalOf (assocRecord {} "$ref" "PlantLifeForm")
  let urlLiteral = literalOf (assocRecord {} "$el" (assocRecord {} "call" ["Maybe", assocRecord {} "$ref" "UrlStr"]))
  let emailLiteral = literalOf (assocRecord {} "$el" (assocRecord {} "call" ["Maybe", assocRecord {} "$ref" "EmailStr"]))
  let creditLiteral = literalOf (assocRecord {} "$ref" "PlateCredit")
  let numberLiteral = literalOf (typeOf 0)
  let callNode = recordType [linkedDemoTypeField "kind" textType, linkedDemoTypeField "fnId" textType, linkedDemoTypeField "args" (listOf reference)]
  let maybeOf = \inner -> assocRecord {} "$el" (assocRecord {} "call" ["Maybe", inner])
  let maybeTextLiteral = literalOf (maybeOf textType)
  let maybeDateLiteral = literalOf (maybeOf (assocRecord {} "$ref" "Date"))
  let maybeNumberLiteral = literalOf (maybeOf (typeOf 0))
  let logoLiteral = literalOf (maybeOf (assocRecord {} "$ref" "Logo"))
  let formulaList = literalOf (recordType [linkedDemoTypeField "__list" (listOf (literalOf (assocRecord {} "$ref" "Recipe")))])
  let calledField = recordType [linkedDemoTypeField "name" textType, linkedDemoTypeField "value" callNode]
  let calledConstruct = literalOf (recordType [linkedDemoTypeField "__construct" (recordType [linkedDemoTypeField "tag" textType, linkedDemoTypeField "fields" (listOf calledField)])])
  let nestedField = recordType [linkedDemoTypeField "name" textType, linkedDemoTypeField "value" (assocRecord {} "$union" [textLiteral, reference])]
  let nestedConstruct = literalOf (recordType [linkedDemoTypeField "__construct" (recordType [linkedDemoTypeField "tag" textType, linkedDemoTypeField "fields" (listOf nestedField)])])
  let nestedList = literalOf (recordType [linkedDemoTypeField "__list" (listOf nestedConstruct)])
  let fieldExpression = assocRecord {} "$union" [textLiteral, linksLiteral, urlLiteral, emailLiteral, namesLiteral, lifeFormLiteral, creditLiteral, numberLiteral, maybeTextLiteral, maybeDateLiteral, maybeNumberLiteral, logoLiteral, formulaList, calledConstruct, reference, referenceList, callNode, nestedConstruct, nestedList]
  let field = recordType [linkedDemoTypeField "name" textType, linkedDemoTypeField "value" fieldExpression]
  let constructor = recordType [linkedDemoTypeField "tag" textType, linkedDemoTypeField "fields" (listOf field)]
  let constructExpression = literalOf (recordType [linkedDemoTypeField "__construct" constructor])
  let personExpression = literalOf personType
  let listCall = recordType [linkedDemoTypeField "kind" textType, linkedDemoTypeField "fnId" textType, linkedDemoTypeField "args" (listOf referenceList)]
  let expression = assocRecord {} "$union" [personExpression, constructExpression, listCall]
  let query = recordType [linkedDemoTypeField "kind" textType, linkedDemoTypeField "expr" expression, linkedDemoTypeField "valueType" universe]
  let saved = recordType [linkedDemoTypeField "id" textType, linkedDemoTypeField "slug" textType, linkedDemoTypeField "name" textType, linkedDemoTypeField "query" query]
  let savedReference = recordType [linkedDemoTypeField "kind" textType, linkedDemoTypeField "id" textType]
  let itemSource = recordType [linkedDemoTypeField "kind" textType, linkedDemoTypeField "ref" savedReference]
  let item = recordType [linkedDemoTypeField "id" textType, linkedDemoTypeField "caption" textType, linkedDemoTypeField "source" itemSource, linkedDemoTypeField "valueType" universe]
  let command = assocRecord {} "$el" (assocRecord {} "call" ["TabDataCommand", item, saved, unitType, unitType, unitType, unitType, unitType])
  { saved = saved, item = item, command = command }

showcaseCommandsType : Type -> Type
showcaseCommandsType personType =
  let shapes = showcaseSourceTypes personType
  let listOf = \element -> assocRecord {} "$el" (assocRecord {} "call" ["List", element])
  recordType [linkedDemoTypeField "commands" (listOf shapes.command)]

showcaseSourceRecordsType : Type -> Type
showcaseSourceRecordsType personType =
  let shapes = showcaseSourceTypes personType
  let listOf = \element -> assocRecord {} "$el" (assocRecord {} "call" ["List", element])
  recordType [linkedDemoTypeField "values" (listOf shapes.saved), linkedDemoTypeField "items" (listOf shapes.item)]

-- These are references to the declarations which own the public bindings,
-- and to the functions their records call or hold (the plate Images, the
-- people's pictures, the fennels set and the Primal Diet's formulas), never
-- names or evaluated copies used to guess identity. Public source admission
-- projects their checked identities; Local still mints fresh IDs.
@tags "internal"
showcasePublicBindingSources : { bindings: { rom: Any, bayne: Any, aajonus: Any, fenel: Any, primalDiet: Any, healthfully: Any, bayneOS: Any, dripCollector: Any, sevenCatYear: Any, fen: Any, apiaceae: Any, foeniculum: Any, ferula: Any, commonFennel: Any, giantFennel: Any, fennelPlate: Any, ferulaPlate: Any, fennels: Any, lisp: Any, smalltalk: Any, prolog: Any, sql: Any, erlang: Any, coq: Any, haskell: Any, ocaml: Any, scratch: Any, typescript: Any }, calls: { fennelImage: Any, ferulaImage: Any, fennelsIn: Any, romPicture: Any, baynePicture: Any, aajonusPicture: Any, lubeFormula: Any, hydrationFormula: Any } }
showcasePublicBindingSources =
  { bindings = { rom = showcaseRom, bayne = showcaseBayne, aajonus = showcaseAajonus, fenel = showcaseFenel, primalDiet = showcasePrimalDiet, healthfully = showcaseHealthfully, bayneOS = showcaseBayneOS, dripCollector = showcaseDripCollector, sevenCatYear = showcaseSevenCatYear, fen = showcaseFen, apiaceae = apiaceae, foeniculum = foeniculum, ferula = ferula, commonFennel = commonFennel, giantFennel = giantFennel, fennelPlate = foeniculumVulgareIllustration, ferulaPlate = narthexAsafoetidaIllustration, fennels = encyclopediaFennels, lisp = languageLisp, smalltalk = languageSmalltalk, prolog = languageProlog, sql = languageSql, erlang = languageErlang, coq = languageCoq, haskell = languageHaskell, ocaml = languageOCaml, scratch = languageScratch, typescript = languageTypeScript }, calls = { fennelImage = foeniculumVulgarePlateImage, ferulaImage = narthexAsafoetidaPlateImage, fennelsIn = encyclopediaFennelsIn, romPicture = romPicture, baynePicture = baynePicture, aajonusPicture = aajonusPicture, lubeFormula = lubeFormula, hydrationFormula = hydrationFormula } }

-- Each plant binding keeps the Encyclopedia's facts.
showcasePlantFields : PlantSpecies -> String -> List ({ name: String, value: Any })
showcasePlantFields species genusRef =
  [showcaseField "scientificName" (showcaseLiteral species.scientificName), showcaseField "authority" (showcaseLiteral species.authority), showcaseField "genus" (showcaseReference genusRef), showcaseField "commonNames" (showcaseLiteral species.commonNames), showcaseField "lifeForm" (showcaseLiteral species.lifeForm), showcaseField "nativeRange" (showcaseLiteral species.nativeRange), showcaseField "source" (showcaseLiteral species.source)]

showcaseLanguageFields : ProgrammingLanguage -> List ({ name: String, value: Any })
showcaseLanguageFields language =
  [showcaseField "name" (showcaseLiteral language.name), showcaseField "firstAppeared" (showcaseLiteral language.firstAppeared), showcaseField "fenelTakes" (showcaseLiteral language.fenelTakes), showcaseField "source" (showcaseLiteral language.source)]

showcaseGenusFields : PlantGenus -> String -> List ({ name: String, value: Any })
showcaseGenusFields genus familyRef =
  [showcaseField "scientificName" (showcaseLiteral genus.scientificName), showcaseField "authority" (showcaseLiteral genus.authority), showcaseField "family" (showcaseReference familyRef), showcaseField "source" (showcaseLiteral genus.source)]

-- A copied plate points at the copied taxon it shows; its picture stays a call
-- to the Encyclopedia's Image, so no pixel data is copied into the tab.
showcasePlate : String -> String -> String -> PlateCredit -> { kind: String, value: { __construct: { tag: String, fields: List ({ name: String, value: Any }) } } }
showcasePlate imageHandle taxonTag subjectRef plateCredit =
  showcaseConstruct "BotanicalIllustration" [showcaseField "image" (showcaseCall imageHandle), showcaseField "subject" (showcaseConstruct taxonTag [showcaseField "_0" (showcaseReference subjectRef)]), showcaseField "credit" (showcaseLiteral plateCredit)]

-- A person with a picture keeps it a call to its Image (as the plates do), so
-- no pixel data is copied into the tab.
showcasePicturedPerson : PublicPerson -> String -> { kind: String, value: { __construct: { tag: String, fields: List ({ name: String, value: Any }) } } }
showcasePicturedPerson person pictureHead =
  showcaseConstruct "PublicPerson" [showcaseField "name" (showcaseLiteral person.name), showcaseField "picture" (showcaseConstruct "Just" [showcaseField "_0" (showcaseCall pictureHead)]), showcaseField "biography" (showcaseLiteral person.biography), showcaseField "birthDate" (showcaseLiteral person.birthDate), showcaseField "socialLinks" (showcaseLiteral person.socialLinks)]

-- A project's own facts are copied from its declaration; its people, the
-- projects and languages that inspired it, its plants, its plant sets, its
-- emblems and its formulas are the linked expressions the caller supplies.
showcaseProject : Project -> { authors: Any, inspiredBy: Any, inspiredByLanguages: Any, formulas: Any, namedAfter: Any, logoInspiredBy: Any, emblems: Any } -> { kind: String, value: { __construct: { tag: String, fields: List ({ name: String, value: Any }) } } }
showcaseProject project links =
  showcaseConstruct "Project" [showcaseField "name" (showcaseLiteral project.name), showcaseField "description" (showcaseLiteral project.description), showcaseField "logo" (showcaseLiteral project.logo), showcaseField "website" (showcaseLiteral project.website), showcaseField "contactEmail" (showcaseLiteral project.contactEmail), showcaseField "firstRelease" (showcaseLiteral project.firstRelease), showcaseField "socialLinks" (showcaseLiteral project.socialLinks), showcaseField "authors" links.authors, showcaseField "inspiredBy" links.inspiredBy, showcaseField "inspiredByLanguages" links.inspiredByLanguages, showcaseField "formulas" links.formulas, showcaseField "namedAfter" links.namedAfter, showcaseField "logoInspiredBy" links.logoInspiredBy, showcaseField "emblems" links.emblems]

showcaseFamilyFields : PlantFamily -> List ({ name: String, value: Any })
showcaseFamilyFields family =
  [showcaseField "scientificName" (showcaseLiteral family.scientificName), showcaseField "commonNames" (showcaseLiteral family.commonNames), showcaseField "source" (showcaseLiteral family.source)]

@label "Try people, projects and plants"
@description "Add Rom, Bayne, Aajonus, the projects Fenel, Primal Diet, Healthfully, BayneOS, DripCollector and 7CatYear, Fenel's mascot Fen, the fennels with their genera and family, the fennels set, the ten programming languages and two plates to this temporary tab. Each project references its people, the projects and languages that inspired it and its plants; open its dependencies to follow the links. Edit a person or a plant and everything that references it changes too. Existing data is preserved."
@tags "demo" "people" "projects" "plants" "linked-data"
showcaseCommands : (ids: { rom: String, bayne: String, aajonus: String, fenel: String, primalDiet: String, healthfully: String, bayneOS: String, dripCollector: String, sevenCatYear: String, fen: String, apiaceae: String, foeniculum: String, ferula: String, commonFennel: String, giantFennel: String, fennelPlate: String, ferulaPlate: String, fennels: String, lisp: String, smalltalk: String, prolog: String, sql: String, erlang: String, coq: String, haskell: String, ocaml: String, scratch: String, typescript: String, romItem: String, bayneItem: String, aajonusItem: String, fenelItem: String, primalDietItem: String, healthfullyItem: String, bayneOSItem: String, dripCollectorItem: String, sevenCatYearItem: String, fenItem: String, apiaceaeItem: String, foeniculumItem: String, ferulaItem: String, commonFennelItem: String, giantFennelItem: String, fennelPlateItem: String, ferulaPlateItem: String, fennelsItem: String, lispItem: String, smalltalkItem: String, prologItem: String, sqlItem: String, erlangItem: String, coqItem: String, haskellItem: String, ocamlItem: String, scratchItem: String, typescriptItem: String }) -> (heads: { fennelImage: String, ferulaImage: String, fennelsIn: String, romPicture: String, baynePicture: String, aajonusPicture: String, lubeFormula: String, hydrationFormula: String }) -> (personType: Type) -> (projectType: Type) -> (mascotType: Type) -> (familyType: Type) -> (genusType: Type) -> (speciesType: Type) -> (plateType: Type) -> (languageType: Type) -> (nameSetType: Type) -> showcaseCommandsType personType
showcaseCommands ids heads personType projectType mascotType familyType genusType speciesType plateType languageType nameSetType =
  let records = showcaseSourceRecords ids heads personType projectType mascotType familyType genusType speciesType plateType languageType nameSetType
  { commands = [TabEditValues { commands = map (\value -> LocusAppend { entry = LocusEntry { id = value.id, value = value } }) records.values }, TabEditEntries { commands = map (\item -> LocusAppend { entry = LocusEntry { id = item.id, value = item } }) records.items }] }

-- One authored linked-record programme supplies public browsing and Local
-- copies. The caller chooses admitted source identities or fresh copy IDs;
-- references, facts, plate-image calls and formula references are authored
-- exactly once here.
@tags "internal"
showcaseSourceRecords : (ids: { rom: String, bayne: String, aajonus: String, fenel: String, primalDiet: String, healthfully: String, bayneOS: String, dripCollector: String, sevenCatYear: String, fen: String, apiaceae: String, foeniculum: String, ferula: String, commonFennel: String, giantFennel: String, fennelPlate: String, ferulaPlate: String, fennels: String, lisp: String, smalltalk: String, prolog: String, sql: String, erlang: String, coq: String, haskell: String, ocaml: String, scratch: String, typescript: String, romItem: String, bayneItem: String, aajonusItem: String, fenelItem: String, primalDietItem: String, healthfullyItem: String, bayneOSItem: String, dripCollectorItem: String, sevenCatYearItem: String, fenItem: String, apiaceaeItem: String, foeniculumItem: String, ferulaItem: String, commonFennelItem: String, giantFennelItem: String, fennelPlateItem: String, ferulaPlateItem: String, fennelsItem: String, lispItem: String, smalltalkItem: String, prologItem: String, sqlItem: String, erlangItem: String, coqItem: String, haskellItem: String, ocamlItem: String, scratchItem: String, typescriptItem: String }) -> (heads: { fennelImage: String, ferulaImage: String, fennelsIn: String, romPicture: String, baynePicture: String, aajonusPicture: String, lubeFormula: String, hydrationFormula: String }) -> (personType: Type) -> (projectType: Type) -> (mascotType: Type) -> (familyType: Type) -> (genusType: Type) -> (speciesType: Type) -> (plateType: Type) -> (languageType: Type) -> (nameSetType: Type) -> showcaseSourceRecordsType personType
showcaseSourceRecords ids heads personType projectType mascotType familyType genusType speciesType plateType languageType nameSetType =
  let none = showcaseLiteral []
  let emblem = showcaseConstruct "Emblem" [showcaseField "meaning" (showcaseLiteral (showcaseFireMeaning ())), showcaseField "plant" (showcaseReference ids.giantFennel), showcaseField "source" (showcaseLiteral (showcaseFireSource ()))]
  -- Each language is its own record; the fennels set stays a call to the
  -- Encyclopedia's own selection over the two linked fennels.
  let languages = [{ id = ids.lisp, item = ids.lispItem, language = languageLisp () }, { id = ids.smalltalk, item = ids.smalltalkItem, language = languageSmalltalk () }, { id = ids.prolog, item = ids.prologItem, language = languageProlog () }, { id = ids.sql, item = ids.sqlItem, language = languageSql () }, { id = ids.erlang, item = ids.erlangItem, language = languageErlang () }, { id = ids.coq, item = ids.coqItem, language = languageCoq () }, { id = ids.haskell, item = ids.haskellItem, language = languageHaskell () }, { id = ids.ocaml, item = ids.ocamlItem, language = languageOCaml () }, { id = ids.scratch, item = ids.scratchItem, language = languageScratch () }, { id = ids.typescript, item = ids.typescriptItem, language = languageTypeScript () }]
  let fenelLanguages = showcaseLiteral { __list = map (\row -> showcaseReference row.id) languages }
  let fennels = { kind = "call", fnId = heads.fennelsIn, args = [showcaseLiteral { __list = [showcaseReference ids.commonFennel, showcaseReference ids.giantFennel] }] }
  let fenelLinks = { authors = showcaseReferences [ids.rom], inspiredBy = none, inspiredByLanguages = fenelLanguages, formulas = none, namedAfter = showcaseReferences [ids.commonFennel], logoInspiredBy = showcaseReferences [ids.fennels], emblems = showcaseLiteral { __list = [emblem] } }
  let fenel = showcaseProject (showcaseFenel ()) fenelLinks
  let formulas = showcaseLiteral { __list = [showcaseFunctionReference heads.lubeFormula, showcaseFunctionReference heads.hydrationFormula] }
  let primalDietLinks = { authors = showcaseReferences [ids.aajonus], inspiredBy = none, inspiredByLanguages = none, formulas = formulas, namedAfter = none, logoInspiredBy = none, emblems = none }
  let primalDiet = showcaseProject (showcasePrimalDiet ()) primalDietLinks
  let healthfullyLinks = { authors = showcaseReferences [ids.bayne, ids.rom], inspiredBy = showcaseReferences [ids.primalDiet], inspiredByLanguages = none, formulas = none, namedAfter = none, logoInspiredBy = none, emblems = none }
  let healthfully = showcaseProject (showcaseHealthfully ()) healthfullyLinks
  let byBayne = { authors = showcaseReferences [ids.bayne], inspiredBy = none, inspiredByLanguages = none, formulas = none, namedAfter = none, logoInspiredBy = none, emblems = none }
  let bayneOS = showcaseProject (showcaseBayneOS ()) byBayne
  let dripCollector = showcaseProject (showcaseDripCollector ()) byBayne
  let byRom = { authors = showcaseReferences [ids.rom], inspiredBy = none, inspiredByLanguages = none, formulas = none, namedAfter = none, logoInspiredBy = none, emblems = none }
  let sevenCatYear = showcaseProject (showcaseSevenCatYear ()) byRom
  let fen = showcaseConstruct "Mascot" [showcaseField "name" (showcaseLiteral "Fen"), showcaseField "description" (showcaseLiteral (showcaseFenDescription ())), showcaseField "mascotOf" (showcaseReference ids.fenel), showcaseField "inspiredBy" (showcaseLiteral { __list = [showcaseReference ids.commonFennel] })]
  let family = showcaseConstruct "PlantFamily" (showcaseFamilyFields (apiaceae ()))
  let fennelGenus = showcaseConstruct "PlantGenus" (showcaseGenusFields (foeniculum ()) ids.apiaceae)
  let ferulaGenus = showcaseConstruct "PlantGenus" (showcaseGenusFields (ferula ()) ids.apiaceae)
  let fennel = showcaseConstruct "PlantSpecies" (showcasePlantFields (commonFennel ()) ids.foeniculum)
  let giant = showcaseConstruct "PlantSpecies" (showcasePlantFields (giantFennel ()) ids.ferula)
  let fennelPlate = showcasePlate heads.fennelImage "TaxonSpecies" ids.commonFennel (foeniculumVulgarePlateCredit ())
  let ferulaPlate = showcasePlate heads.ferulaImage "TaxonGenus" ids.ferula (narthexAsafoetidaPlateCredit ())
  let values = [linkedDemoSavedValue ids.rom "Rom" (showcasePicturedPerson (showcaseRom ()) heads.romPicture) personType, linkedDemoSavedValue ids.bayne "Bayne" (showcasePicturedPerson (showcaseBayne ()) heads.baynePicture) personType, linkedDemoSavedValue ids.aajonus "Aajonus" (showcasePicturedPerson (showcaseAajonus ()) heads.aajonusPicture) personType, linkedDemoSavedValue ids.apiaceae "Apiaceae" family familyType, linkedDemoSavedValue ids.foeniculum "Foeniculum" fennelGenus genusType, linkedDemoSavedValue ids.ferula "Ferula" ferulaGenus genusType, linkedDemoSavedValue ids.commonFennel "Common fennel" fennel speciesType, linkedDemoSavedValue ids.giantFennel "Giant fennel" giant speciesType, linkedDemoSavedValue ids.fennels "Fennels" fennels nameSetType, linkedDemoSavedValue ids.fenel "Fenel" fenel projectType, linkedDemoSavedValue ids.primalDiet "Primal Diet" primalDiet projectType, linkedDemoSavedValue ids.healthfully "Healthfully" healthfully projectType, linkedDemoSavedValue ids.bayneOS "BayneOS" bayneOS projectType, linkedDemoSavedValue ids.dripCollector "DripCollector" dripCollector projectType, linkedDemoSavedValue ids.sevenCatYear "7CatYear" sevenCatYear projectType, linkedDemoSavedValue ids.fen "Fen" fen mascotType, linkedDemoSavedValue ids.fennelPlate "Köhler's plate of fennel" fennelPlate plateType, linkedDemoSavedValue ids.ferulaPlate "A Ferula on a Van Houtte plate" ferulaPlate plateType]
  let items = [linkedDemoItem ids.romItem "Rom" ids.rom personType, linkedDemoItem ids.bayneItem "Bayne" ids.bayne personType, linkedDemoItem ids.aajonusItem "Aajonus" ids.aajonus personType, linkedDemoItem ids.fenelItem "Fenel" ids.fenel projectType, linkedDemoItem ids.primalDietItem "Primal Diet" ids.primalDiet projectType, linkedDemoItem ids.healthfullyItem "Healthfully" ids.healthfully projectType, linkedDemoItem ids.bayneOSItem "BayneOS" ids.bayneOS projectType, linkedDemoItem ids.dripCollectorItem "DripCollector" ids.dripCollector projectType, linkedDemoItem ids.sevenCatYearItem "7CatYear" ids.sevenCatYear projectType, linkedDemoItem ids.fenItem "Fen" ids.fen mascotType, linkedDemoItem ids.commonFennelItem "Common fennel" ids.commonFennel speciesType, linkedDemoItem ids.giantFennelItem "Giant fennel" ids.giantFennel speciesType, linkedDemoItem ids.fennelsItem "Fennels" ids.fennels nameSetType, linkedDemoItem ids.foeniculumItem "Foeniculum" ids.foeniculum genusType, linkedDemoItem ids.ferulaItem "Ferula" ids.ferula genusType, linkedDemoItem ids.apiaceaeItem "Apiaceae" ids.apiaceae familyType, linkedDemoItem ids.fennelPlateItem "Köhler's plate of fennel" ids.fennelPlate plateType, linkedDemoItem ids.ferulaPlateItem "A Ferula on a Van Houtte plate" ids.ferulaPlate plateType]
  let languageValues = map (\row -> linkedDemoSavedValue row.id row.language.name (showcaseConstruct "ProgrammingLanguage" (showcaseLanguageFields row.language)) languageType) languages
  let languageItems = map (\row -> linkedDemoItem row.item row.language.name row.id languageType) languages
  { values = concat values languageValues, items = concat items languageItems }
