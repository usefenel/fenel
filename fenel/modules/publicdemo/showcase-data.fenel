showcaseDripCollector = Project { name = "DripCollector", description = "A project by Bayne.", logo = Just DripCollector, website = Just "https://dripcollector.app", contactEmail = Nothing, firstRelease = Nothing, socialLinks = [], authors = [showcaseBayne ()], inspiredBy = [], inspiredByLanguages = [], formulas = [], namedAfter = [], logoInspiredBy = [], emblems = [] }

