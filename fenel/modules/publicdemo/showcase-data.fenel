showcaseSevenCatYear = Project { name = "7CatYear", description = "An app made to research GG33's numerology-astrology system by modelling it.", logo = Just SevenCatYear, website = Just "https://7catyear.com", contactEmail = Nothing, firstRelease = Just 2023, socialLinks = [], authors = [showcaseRom ()], inspiredBy = [], inspiredByLanguages = [], formulas = [], namedAfter = [], logoInspiredBy = [], emblems = [] }

@label "Fen"
@description "Fenel's mascot, a working name: a fictional character inspired by common fennel."
showcaseFen : Mascot
