module UtilityDemo where

import std (reverse, upper, lower, chars, charCode, length, words, lines, split, join, sortLex, unique, map, trim, replaceAll, slugify, fold, all, isString, isArray, not)
import ImportDemo (ImportTextInput)

-- Practical tools are bounded recipes over the existing String/List owners.
-- Counts use Unicode code points, whitespace-separated tokens, and physical
-- LF/CRLF lines respectively. Code points are not grapheme clusters or letters.
-- Sorting preserves existing lexicographic String order, without locale rules.

utilityTextAdmitted : (text: String) -> Bool
utilityTextAdmitted text = isString text && length text <= 4096

utilityTextScalarsAdmitted : (points: List String) -> Bool
utilityTextScalarsAdmitted points = all points (\point -> charCode point < 55296 || charCode point > 57343)

utilityTextLimitMessage : String
utilityTextLimitMessage = "Use text with at most 4096 Unicode code points; the result must fit the same limit."

utilityTextChecked : (text: String) -> Result String String
utilityTextChecked text = if utilityTextAdmitted text then Ok text else Err (utilityTextLimitMessage ())

utilityTextBounded : (transform: (String -> String)) -> (text: String) -> Result String String
utilityTextBounded transform text =
  if utilityTextAdmitted text then utilityTextChecked (transform text)
  else Err (utilityTextLimitMessage ())

@label "Reverse text"
@description "Reverse at most 4096 Unicode code points. Supplementary characters stay intact; combining marks and joined emoji are separate code points. Empty text stays empty."
@tags "utility" "text" "reverse"
reverseText : (text: String) -> Result String String
reverseText text = utilityTextBounded (\value -> join (reverse (chars value)) "") text

@label "Uppercase text"
@description "Apply the existing Unicode uppercase operation to at most 4096 code points. Refuse if case expansion would exceed the same output limit."
@tags "utility" "text" "case"
uppercaseText : (text: String) -> Result String String
uppercaseText text = utilityTextBounded upper text

@label "Lowercase text"
@description "Apply the existing Unicode lowercase operation to at most 4096 code points. Refuse if the output would exceed that limit."
@tags "utility" "text" "case"
lowercaseText : (text: String) -> Result String String
lowercaseText text = utilityTextBounded lower text

@label "Count text"
@description "Count Unicode code points, whitespace-separated tokens and LF/CRLF physical lines independently. Empty text has zero of each; a final newline adds an empty line. Combining marks count separately. Paste at most 4096 code points into the shared multiline input."
@tags "utility" "text" "count"
summarizeText : (source: ImportTextInput) -> Result String ({ codePoints: Nat, whitespaceTokens: Nat, lines: Nat })
summarizeText source =
  if utilityTextAdmitted source.text then
    Ok { codePoints = length (chars source.text), whitespaceTokens = length (words source.text), lines = length (lines source.text) }
  else Err (utilityTextLimitMessage ())

@label "Split text"
@description "Split at a nonempty literal delimiter, retaining empty items and a final empty item. Empty source yields one empty item. Source and delimiter each have at most 4096 code points; return at most 128 items. Empty delimiters and delimiters containing unpaired UTF-16 surrogates refuse; chars is the separate code-point operation."
@tags "utility" "text" "split"
splitText : (source: ImportTextInput) -> (delimiter: String) -> Result String (List String)
splitText source delimiter =
  if not (utilityTextAdmitted source.text && utilityTextAdmitted delimiter) then Err (utilityTextLimitMessage ())
  else if length delimiter == 0 then Err "Choose a nonempty literal delimiter. Use chars to split by Unicode code point."
  else if not (utilityTextScalarsAdmitted (chars delimiter)) then Err "Use well-formed Unicode text without unpaired UTF-16 surrogates."
  else
    let items = split source.text delimiter
    if length items <= 128 then Ok items
    else Err "The split result must contain at most 128 items."

@label "Join text items"
@description "Join at most 128 String items with a literal separator. Empty items remain; an empty list yields empty text. Admit at most 4096 code points per input and in the complete output, checking its size before constructing it."
@tags "utility" "text" "join"
joinText : (items: List String) -> (separator: String) -> Result String String
joinText items separator =
  if not (isArray items && length items <= 128) then Err "Use a list of at most 128 text items."
  else if not (utilityTextAdmitted separator && all items utilityTextAdmitted) then Err (utilityTextLimitMessage ())
  else
    let contentLength = fold (\total item -> total + length item) 0 items
    let separatorCount = if length items == 0 then 0 else length items - 1
    if contentLength + separatorCount * length separator <= 4096 then Ok (join items separator)
    else Err (utilityTextLimitMessage ())

@label "Sort text code points"
@description "Split at most 4096 code points with chars, sort using existing lexicographic String order, then join. Keep duplicates, spaces and combining marks; no locale-aware alphabetic collation or grapheme segmentation is claimed."
@tags "utility" "text" "sort"
sortTextCodePoints : (text: String) -> Result String String
sortTextCodePoints text =
  if utilityTextAdmitted text then Ok (join (sortLex (chars text)) "")
  else Err (utilityTextLimitMessage ())

@label "Sort text lines"
@description "Sort up to 128 LF/CRLF physical lines in existing lexicographic String order. Keep duplicate and empty lines; write LF separators. Empty text stays empty. Source and output have at most 4096 code points. A lone carriage return stays inside its line."
@tags "utility" "text" "sort" "lines"
sortTextLines : (source: ImportTextInput) -> Result String String
sortTextLines source =
  if not (utilityTextAdmitted source.text) then Err (utilityTextLimitMessage ())
  else
    let items = lines source.text
    if length items <= 128 then utilityTextChecked (join (sortLex items) "\n")
    else Err "Use at most 128 physical lines."

@label "Deduplicate text lines"
@description "Remove repeated LF/CRLF physical lines, keeping their first occurrence and original order. Equality is case-sensitive and includes whitespace; write LF separators. Keep an empty line at its first occurrence; a final newline remains only when its empty line is the first one. Empty text stays empty; a lone carriage return remains inside its line. Admit at most 128 input lines and 4096 Unicode code points."
@tags "utility" "text" "deduplicate" "lines"
deduplicateTextLines : (source: ImportTextInput) -> Result String String
deduplicateTextLines source =
  if not (utilityTextAdmitted source.text) then Err (utilityTextLimitMessage ())
  else
    let items = lines source.text
    if length items <= 128 then utilityTextChecked (join (unique items) "\n")
    else Err "Use at most 128 physical lines."

@label "Count each text code point"
@description "Return typed codePoint/count rows in first-appearance order. Count spaces, line breaks, supplementary characters and combining marks separately; case stays distinct and joined emoji contain several code points. This is not letter or grapheme frequency. Empty text returns an empty list. Admit at most 4096 Unicode code points and 128 distinct code points; unpaired UTF-16 surrogates refuse."
@tags "utility" "text" "count" "frequency"
textCodePointFrequencies : (source: ImportTextInput) -> Result String (List ({ codePoint: String, count: Nat }))
textCodePointFrequencies source =
  if not (utilityTextAdmitted source.text) then Err (utilityTextLimitMessage ())
  else
    let points = chars source.text
    if not (utilityTextScalarsAdmitted points) then Err "Use well-formed Unicode text without unpaired UTF-16 surrogates."
    else
      let distinct = unique points
      if length distinct > 128 then Err "Use at most 128 distinct Unicode code points."
      else Ok (map (\point -> { codePoint = point, count = length (split source.text point) - 1 }) distinct)

@label "Trim text"
@description "Remove leading and trailing whitespace with the existing trim operation. Interior spaces and newlines stay unchanged. Input and output have at most 4096 code points."
@tags "utility" "text" "cleanup"
trimText : (text: String) -> Result String String
trimText text = utilityTextBounded trim text

@label "Normalize text whitespace"
@description "Split pasted text with the existing whitespace-token operation and join with one ASCII space. Remove leading/trailing whitespace and collapse whitespace runs, including newlines. Whitespace-only text becomes empty. Admit at most 4096 code points."
@tags "utility" "text" "cleanup" "whitespace"
normalizeTextWhitespace : (source: ImportTextInput) -> Result String String
normalizeTextWhitespace source =
  if utilityTextAdmitted source.text then utilityTextChecked (join (words source.text) " ")
  else Err (utilityTextLimitMessage ())

@label "Replace literal text"
@description "Replace every nonoverlapping occurrence of a nonempty literal search string. Replacement text is literal, including dollar signs. Source, search and replacement each have at most 4096 code points; predict and refuse an oversized result before allocating it. Empty search and unpaired UTF-16 surrogates in search or replacement refuse."
@tags "utility" "text" "replace"
replaceText : (source: ImportTextInput) -> (search: String) -> (replacement: String) -> Result String String
replaceText source search replacement =
  if not (utilityTextAdmitted source.text && utilityTextAdmitted search && utilityTextAdmitted replacement) then Err (utilityTextLimitMessage ())
  else if length search == 0 then Err "Choose a nonempty literal search string."
  else if not (utilityTextScalarsAdmitted (chars search) && utilityTextScalarsAdmitted (chars replacement)) then Err "Use well-formed Unicode text without unpaired UTF-16 surrogates."
  else
    let fragments = split source.text search
    let occurrences = length fragments - 1
    let remainingLength = fold (\total fragment -> total + length fragment) 0 fragments
    let resultLength = remainingLength + occurrences * length replacement
    if resultLength <= 4096 then utilityTextChecked (replaceAll source.text search replacement)
    else Err (utilityTextLimitMessage ())

@label "Make a URL slug"
@description "Use the existing lowercase ASCII slug operation: normalize combining accents, collapse other characters to hyphens and trim edge hyphens. This is not transliteration of every script. Input and result have at most 4096 code points."
@tags "utility" "text" "slug"
slugifyText : (text: String) -> Result String String
slugifyText text = utilityTextBounded slugify text

@label "Text tools"
@description "Useful bounded text recipes with editable inputs and typed results. Count, split, sort/deduplicate lines, code-point frequencies, normalize whitespace and replace use the existing multiline input. Inspect the source, retain errors and reuse the resulting ordinary data."
textTools : ({ reverse: (String -> Result String String), uppercase: (String -> Result String String), lowercase: (String -> Result String String), count: (ImportTextInput -> Result String ({ codePoints: Nat, whitespaceTokens: Nat, lines: Nat })), split: (ImportTextInput -> String -> Result String (List String)), join: (List String -> String -> Result String String), sortCodePoints: (String -> Result String String), sortLines: (ImportTextInput -> Result String String), deduplicateLines: (ImportTextInput -> Result String String), codePointFrequencies: (ImportTextInput -> Result String (List ({ codePoint: String, count: Nat }))), trim: (String -> Result String String), normalizeWhitespace: (ImportTextInput -> Result String String), replace: (ImportTextInput -> String -> String -> Result String String), slugify: (String -> Result String String) })
textTools = { reverse = reverseText, uppercase = uppercaseText, lowercase = lowercaseText, count = summarizeText, split = splitText, join = joinText, sortCodePoints = sortTextCodePoints, sortLines = sortTextLines, deduplicateLines = deduplicateTextLines, codePointFrequencies = textCodePointFrequencies, trim = trimText, normalizeWhitespace = normalizeTextWhitespace, replace = replaceText, slugify = slugifyText }

utilityTextStartingInputs : List ({ function: Any, arguments: List Any })
utilityTextStartingInputs = [
  { function = reverseText, arguments = ["Fenel 🦊"] },
  { function = uppercaseText, arguments = ["Hello, Straße!"] },
  { function = lowercaseText, arguments = ["HELLO WORLD"] },
  { function = summarizeText, arguments = [ImportTextInput { text = "Hello 🦊 world\nOne more line\n" }] },
  { function = splitText, arguments = [ImportTextInput { text = "red,blue,,green," }, ","] },
  { function = joinText, arguments = [["red", "blue", "green"], ", "] },
  { function = sortTextCodePoints, arguments = ["cab 🦊a"] },
  { function = sortTextLines, arguments = [ImportTextInput { text = "pear\napple\npear\nbanana" }] },
  { function = deduplicateTextLines, arguments = [ImportTextInput { text = "pear\napple\npear\nbanana\napple" }] },
  { function = textCodePointFrequencies, arguments = [ImportTextInput { text = "Hello 🦊! Hello!" }] },
  { function = trimText, arguments = ["   breathing room   "] },
  { function = normalizeTextWhitespace, arguments = [ImportTextInput { text = "  hello\t world\nfrom  Fenel  " }] },
  { function = replaceText, arguments = [ImportTextInput { text = "Hello world, hello again." }, "hello", "hi"] },
  { function = slugifyText, arguments = ["  Étoile du nord — Volume One!  "] }
]
