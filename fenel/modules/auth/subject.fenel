-- =========================================================================
-- module subject where — who is acting on the system.
--
-- module-substrate Phase 3m (2026-05-31) — the HEADER-IS-IDENTITY half of the
-- cross-file-union representative. `subject` is its OWN module (the Subject
-- ADT + its 5 accessors), distinct from the `auth` module that `session.fenel`
-- + `cookies.fenel` UNION into. The `module subject where` header drives the
-- `subject:` id-prefix; it does NOT fold into `auth` even when loaded in the
-- same `loadFenelModuleUnion` call (OQ3 — header is identity, not directory).
--
-- The 5 accessors were hand-wrapped TS `defineFunction` specs in the retired
-- `engine/src/modules/auth.ts`; their identity (codeName / label / description
-- / tags) now rides @facet directives here. The retired specs kept id-suffix
-- ≠ codeName on two accessors (`subject:accountId` codeName `subjectAccountId`,
-- `subject:actorId` codeName `subjectActorId`) — reproduced byte-for-byte via
-- the def-head rename + `@codeName` (Phase 3c). The intra-module reference in
-- `requireAccountId` stays the CODENAME (`subjectAccountId`), resolved by the
-- registry's codeName lookup, exactly as the pre-migration body did. No stored
-- @category — the `subject` category derives at read time from the `subject:`
-- id prefix (Phase 3j).
--
-- Phase 12c-core sub-step 1 of the ts-elimination workstream (origin). Decision
-- A2: canonical Fenel form + cascade flip. Subject lifts from TS-side
-- {kind: "user"|...} lowercase to a Fenel-native $variant ADT with PascalCase
-- $tag discriminators.
--
-- Variants:
--   User       — authenticated end-user (dashboard, API token)
--   Bot        — programmatic actor on behalf of an account
--   Anonymous  — public visitor (sessionId optional via Maybe<String>)
--
-- rights R2a DELETED the `System` variant. It existed so that
-- `permissions:check` could open `System -> Allow everything`, and four TypeScript
-- sites manufactured one out of thin air to get past that engine. There is no
-- second policy engine any more: what an execution may do is the envelope on its
-- frame, and a subject is attribution, not authorization. A caller that needs to
-- reach a protected leaf carries an authority that names it.
--
-- Note: User / Bot carry both accountId (partition key) and the actor's own id
-- (userId / botId). Anonymous carries an optional sessionId (Maybe<String> —
-- explicit Maybe per Decision G; the TS shim wraps undefined → Nothing, string
-- → Just).
-- =========================================================================

module subject where

Subject = User accountId: String userId: String
  | Bot accountId: String botId: String
  | Anonymous sessionId: Maybe<String>

-- accountId (codeName subjectAccountId) — extract the account partition key.
-- Nothing for Anonymous.
@codeName "subjectAccountId"
@label "Subject account id"
@description "Phase 12c-core sub-step 1 — accessor. Extract the account partition key from a Subject. User / Bot → Just accountId; Anonymous → Nothing."
@tags "auth" "subject" "pure" "phase-12c"
accountId : Subject -> Maybe String
accountId s =
  case s of
    User { accountId } -> Just accountId
    Bot { accountId } -> Just accountId
    Anonymous {} -> Nothing

-- requireAccountId — same shape as accountId; the TS wrapper unwraps Just /
-- throws on Nothing. The Fenel body is purely the accessor — the throw is a TS
-- concern (Decision C). References the `subjectAccountId` codeName (resolved by
-- the registry's codeName lookup, exactly as the pre-migration body did).
@label "Require account id"
@description "Phase 12c-core sub-step 1 — accessor with throw-on-Nothing semantics handled TS-side. The Fenel body is the bare accessor; the TS wrapper unwraps Just and throws on Nothing (Decision C)."
@tags "auth" "subject" "pure" "phase-12c"
requireAccountId : Subject -> Maybe String
requireAccountId s = subjectAccountId s

-- actorId (codeName subjectActorId) — the actor's stable id within its kind,
-- for audit / logging. User → Just userId; Bot → Just botId; Anonymous →
-- sessionId (already a Maybe).
@codeName "subjectActorId"
@label "Subject actor id"
@description "Phase 12c-core sub-step 1 — accessor. User → Just userId; Bot → Just botId; Anonymous → sessionId (already Maybe)."
@tags "auth" "subject" "pure" "phase-12c"
actorId : Subject -> Maybe String
actorId s =
  case s of
    User { userId } -> Just userId
    Bot { botId } -> Just botId
    Anonymous { sessionId } -> sessionId

-- isAuthenticated — True for account-bound subjects (User, Bot). False otherwise.
@label "Is authenticated"
@description "Phase 12c-core sub-step 1 — predicate. True for account-bound subjects (User, Bot); false for Anonymous."
@tags "auth" "subject" "pure" "phase-12c"
isAuthenticated : Subject -> Boolean
isAuthenticated s =
  case s of
    User {} -> true
    Bot {} -> true
    _ -> false

-- rights R2a — `isSystem` is DELETED with the `System` variant. The predicate
-- existed to gate privileged paths on WHO was asking; privilege is now a
-- property of the frame, judged at exercise.
