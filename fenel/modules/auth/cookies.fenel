-- =========================================================================
-- module auth where — cookie helpers (pure D-portable; sync via in-process
-- evaluate).
--
-- module-substrate Phase 3m (2026-05-31) — the SECOND file of the `auth`
-- UNION. This file carries the SAME `module auth where` header as
-- `session.fenel`, so `loadFenelModuleUnion` merges the two into one `auth`
-- module (OQ3 cross-file header union). The members are disjoint (session ⊎
-- cookies); a name colliding across the two would throw at load.
--
-- Phase 12c-core sub-step 3 of the ts-elimination workstream (origin). Lifts
-- the 2 pure cookie-string builders that lived inline in api/src/routes/auth.ts.
-- ts-elimination-completion Phase 3 (2026-06-02) added the 3rd helper,
-- parseCookieHeader — the Decision-a deferral ("pending std:assocRecord") is
-- discharged: std:assocRecord shipped Phase 2b, so the dynamic-key insert is
-- now expressible Fenel-side. All 3 carry NO @ioAction (pure; the TS wrappers
-- in core/auth.ts call the bodies via in-process evaluate). No stored
-- @category — the `auth` category derives at read time from the `auth:` id
-- prefix (Phase 3j).
--
-- Per Decision C1, `isProd` is threaded by the TS wrapper as a Bool arg rather
-- than reading process.env["NODE_ENV"]. The SESSION_COOKIE name
-- "fenel_session" is hard-coded in the body (a constant in
-- api/src/middleware/auth.ts, not configurable).
-- =========================================================================

module auth where

-- sessionCookieHeader — builds "fenel_session=<token>; Path=/; HttpOnly;
-- SameSite=Lax; Max-Age=<n>" with "; Secure" appended when isProd is true.
@label "Session cookie header"
@description "Phase 12c-core sub-step 3 — pure cookie-string builder. Returns 'fenel_session=<token>; Path=/; HttpOnly; SameSite=Lax; Max-Age=<n>' with '; Secure' appended when isProd is true. Per Decision C1, isProd is threaded by the TS wrapper as a Bool arg."
@tags "auth" "cookie" "pure" "phase-12c"
sessionCookieHeader : String -> Number -> Boolean -> String
sessionCookieHeader token maxAgeSeconds isProd =
  let prefix = concat "fenel_session=" token
  let withPath = concat prefix "; Path=/; HttpOnly; SameSite=Lax; Max-Age="
  let withMaxAge = concat withPath (toString maxAgeSeconds)
  ifElse isProd (concat withMaxAge "; Secure") withMaxAge

-- clearSessionCookieHeader — Max-Age=0 variant for logout.
@label "Clear session cookie header"
@description "Phase 12c-core sub-step 3 — pure cookie-string builder for logout. Returns Max-Age=0 variant; '; Secure' appended when isProd is true."
@tags "auth" "cookie" "pure" "phase-12c"
clearSessionCookieHeader : Boolean -> String
clearSessionCookieHeader isProd =
  let base = "fenel_session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0"
  ifElse isProd (concat base "; Secure") base

-- parseCookieHeader — Phase 3 (ts-elimination-completion). Minimal cookie-header
-- parser: "a=1; b=2" -> { a = "1", b = "2" }. Retires the deferred TS residual
-- (was "pending std:assocRecord", shipped Phase 2b). Splits on ';', folds each
-- part: split on '=', key = head, value = `join (tail) "="` (faithful to the TS
-- `slice(eq+1)` when a value itself contains '='), trim both, decode the value
-- via std:decodeUriComponent (the sister of std:urlEncode), insert via
-- std:assocRecord. Parts with no '=' (split yields length 1) are skipped, and an
-- empty key after trim is skipped — both matching the pre-port TS
-- (`if (eq < 0) continue` + `if (k) out[k] = …`). Dynamic-key map return typed
-- `{}` (the imports:applyMapping precedent). Pure; the TS wrapper calls this body
-- via in-process evaluate (the sessionCookieHeader pattern).
@label "Parse cookie header"
@description "Phase 3 (ts-elimination-completion) — minimal cookie-header parser: 'a=1; b=2' -> { a = '1', b = '2' }. Splits on ';', folds each part: split on '=', key = head, value = join (tail) '=', trim both, decode the value via std:decodeUriComponent, insert via std:assocRecord. Parts with no '=' and empty keys are skipped (matching the pre-port TS). Retires the last cookie-helper TS residual (was deferred pending std:assocRecord, shipped Phase 2b)."
@tags "auth" "cookie" "pure" "phase-3"
parseCookieHeader : String -> {}
parseCookieHeader header =
  fold addCookiePart {} (split header ";")

addCookiePart acc part =
  let kv = split part "="
  if length kv == 1 then acc else withCookieKey acc kv

withCookieKey acc kv =
  case head kv of
    Nothing -> acc
    Just rawKey -> withCookieTail acc rawKey kv

withCookieTail acc rawKey kv =
  case tail kv of
    Nothing -> acc
    Just rest -> insertCookie acc (trim rawKey) rest

insertCookie acc key rest =
  if eq key "" then acc else assocRecord acc key (decodeUriComponent (trim (join rest "=")))
