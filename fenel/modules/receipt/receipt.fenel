-- =========================================================================
-- module receipt where — GET /@:handle/:tag receipt-link decider.
--
-- module-substrate Phase 3n (2026-05-31) — the OTHER half of the
-- public-surfaces aggregation-DISSOLVE. The retired junk-drawer bundle
-- `engine/src/modules/public-surfaces.ts` lumped these 2 `receipt:*` fns in
-- with the 4 `pages:*` fns; per the standing steer ("no wrapper modules
-- around already-clean separate modules") it is dissolved into `pages` +
-- `receipt`, each its own semantic module.
--
-- THIS file is now a `module receipt where` source-of-truth: header + the 2
-- `receipt:*` sigs + their @label/@description/@tags facets (lifted from the
-- retired `defineFunction` specs). Bodies unchanged. No stored @category (the
-- `receipt` category derives at read time from the `receipt:` id prefix,
-- Phase 3j). Both fns are PURE — no `@ioAction`, no inferred requires.
--
-- Phase 12c-routes sub-step 3 of the ts-elimination workstream (origin). The
-- TS wrapper handles:
--   - account lookup via state:findAccountBySlug + 404 short-circuit
--   - JSONB navigation of account.config.receipt_links[tag] — the
--     dynamic-key lookup is held in the wrapper per Risk 3 (parseApp's
--     `.` syntax handles only static keys; std lacks a record-by-string
--     lookup primitive)
--   - HTML template formatting via std:escapeHtml (Decision R + sister
--     of sub-step 2's redirect.ts pattern; std:escapeHtml's apostrophe-
--     escaping behavior is a strict superset of receipt.ts's pre-12c-3
--     local helper per Decision CC)
--
-- Body normalises the resolved Maybe<RawLink> into a typed
-- Maybe<ReceiptLink> shape the wrapper renders as OG-tagged HTML.
-- The body shape is intentionally thin (single case fall-through); it
-- exists to (a) provide a Fenel-side seam where future receipt-link
-- enrichments can grow, and (b) keep the wrapper as a pure template
-- renderer.
--
-- Decisions resolved:
--   BB (receipt JSONB navigation TS-side per Risk 3 fallback — no
--       std:lookup primitive, dynamic-key access not in parser surface)
--   CC (std:escapeHtml consolidation — apostrophe-escaping strict
--       superset)
-- =========================================================================

module receipt where

-- findReceiptLink — wrapper passes Maybe<RawLink> already resolved from
-- account.config.receipt_links[tag]. Body normalises field-Maybe absence
-- to Nothing-tagged fields so the renderer can dispatch uniformly.
@label "Find receipt link"
@description "Phase 12c-routes sub-step 3 — normalise a resolved Maybe<RawLink> into a typed Maybe<ReceiptLink>. The TS wrapper has resolved the account via state:findAccountBySlug, navigated account.config.receipt_links[tag] (TS-side per Risk 3), and converted JS undefined to Nothing. Body is intentionally thin — provides a Fenel-side seam for future enrichments."
@tags "receipt" "ingress" "route" "phase-12c"
findReceiptLink : Maybe ({}) -> Maybe ({})
findReceiptLink linkMaybe =
  case linkMaybe of
    Just raw -> Just (normalizeReceiptLink raw)
    _ -> Nothing

-- normalizeReceiptLink — coerce the raw JSONB shape (url required;
-- title / description / image optional with arbitrary JSONB absence
-- semantics — undefined / null / missing all map to Nothing on the wire)
-- into a typed link record with explicit Maybe-wrapped optional fields.
-- The wrapper has converted JS undefined to Nothing before invoking.
@label "Normalize receipt link"
@description "Phase 12c-routes sub-step 3 — coerce the raw JSONB receipt-link shape into a typed link record with the canonical (url, title, description, image) field set."
@tags "receipt" "pure" "phase-12c"
normalizeReceiptLink : {} -> {}
normalizeReceiptLink raw =
  { url = raw.url, title = raw.title, description = raw.description, image = raw.image }
