-- =========================================================================
-- module twitter where — read tweet engagement, fetch recent tweets, post
-- replies, and score virality.
--
-- module-substrate Phase 3q (2026-05-31) — `twitter` is one half of the
-- "signature-only pair" Surprise #30 DEFERRED at Phase 3k. It is a PLAIN
-- function module (no capability / creds / providers / instances) whose
-- ~98-LOC TS `defineFunction` spec wrapper (`engine/src/modules/twitter.ts`)
-- is RETIRED in favour of this `module twitter where` source + a thin seam.
--
-- Three of the four functions are irreducible host-IO (HTTP) → bodyless
-- `@native` FOREIGN DECLARATIONS backed by the runtime IO handlers in
-- `runtime/src/providers.ts` (the `payments:createStripeCheckoutSession` /
-- `ai:callLLM` precedent — NO `nativeImpls` map, NO `ffi/` leaf; the handlers
-- stay as-is). The fourth, `twitter_check_viral`, is a PURE virality formula
-- → a Fenel BODY (Fenel-first HARD RULE); its dead TS native + IO-handler
-- registration are removed from `providers.ts`.
--
-- Three blessed surface improvements (each law-neutral, each documented):
--   1. The anonymous 5-field return of `twitter_get_metrics` (inexpressible
--      in a `.fenel` sig — Surprise #30) becomes a NAMED `TweetMetrics`
--      entity (the named-types-over-anon-records direction; 3l-blessed).
--   2. `twitter_check_viral` ports to a Fenel body. The retired TS native
--      returned a DEBUG RECORD `{viral, score, likes, retweets, views,
--      hoursOld}`, but the declared return type was `Boolean` — a long-
--      standing type/value mismatch. We HONOUR THE DECLARED `Boolean` sig and
--      return the `.viral` verdict (`score >= minScore`); the extra debug
--      fields were never part of the type and are dropped. The score FORMULA
--      is byte-faithful to the native: `(likes + retweets*3) / max(hoursOld,
--      0.1)`; `minScore` defaults to 50 when `Nothing`. (The retired
--      defineFunction description mentions a stale `+ quotes*5` term that the
--      native never computed; it is preserved VERBATIM below for facet parity.)
--   3. Param LABELS drop (in-bar, Surprise #30 — no directive).
--
-- The `{}` placeholders (`twitter_get_recent`'s `List ({})`,
-- `twitter_post_reply`'s `{}`) ride VERBATIM (the codec / ai `{}` precedent;
-- already counted by the empty-record-placeholder audit). NO `@category`
-- (the `twitter` category derives at read time from the `twitter:` id prefix,
-- Phase 3j). The header keeps the LEGACY lowercase `twitter:` id-prefix.
-- =========================================================================

module twitter where

-- ----- Data types ----------------------------------------------------------

-- TweetMetrics — the named return of `twitter_get_metrics` (replaces the
-- anonymous 5-field record the retired spec declared). Single-constructor
-- record; all counts are Number, the tweet body is String.
TweetMetrics = TweetMetrics likes: Number retweets: Number replies: Number views: Number text: String

-- ----- Functions -----------------------------------------------------------

-- twitter_get_metrics — FOREIGN DECLARATION (@native): fetch engagement
-- metrics for a tweet. Backed by the runtime `twitter_get_metrics` IO handler.
@native
@label "Get Tweet Metrics"
@description "Fetch engagement metrics for a tweet. Uses fxtwitter syndication for public data, or account cookies for private."
@tags "social" "twitter" "metrics"
twitter_get_metrics : (tweet_url: String) -> TweetMetrics

-- twitter_get_recent — FOREIGN DECLARATION (@native): fetch recent tweets
-- from an account. The `List ({})` return placeholder rides verbatim.
@native
@label "Get Recent Tweets"
@description "Fetch recent tweets from an account. Requires Twitter cookies (ct0 + auth_token)."
@tags "social" "twitter"
twitter_get_recent : (username: String, count: Maybe Number) -> List ({})

-- twitter_post_reply — FOREIGN DECLARATION (@native): post a reply to a
-- tweet. The `{}` return placeholder rides verbatim.
@native
@label "Post Reply"
@description "Post a reply to a tweet. Requires Twitter cookies."
@tags "social" "twitter" "post"
twitter_post_reply : (tweet_id: String, text: String) -> {}

-- twitter_check_viral — PURE Fenel BODY (Fenel-first HARD RULE): does the
-- tweet's virality score clear the threshold? score = (likes + retweets*3) /
-- max(hours_old, 0.1); the threshold defaults to 50 when min_score is
-- Nothing. `views` is accepted for signature parity but unused in the
-- verdict (the native echoed it in its debug record only). Authored as a
-- single `case` expression (no `let`) so the score+guard inline per branch.
twitter_check_viral : Number -> Number -> Maybe Number -> Number -> Maybe Number -> Boolean
@label "Check Viral"
@description "Pure function — check if tweet metrics exceed a virality threshold. score = (likes + retweets*3 + quotes*5) / hours_since_post."
@tags "social" "twitter" "formula" "pure"
twitter_check_viral likes retweets views hours_old min_score =
  case min_score of
    Just m -> (likes + retweets * 3) / (if hours_old > 0.1 then hours_old else 0.1) >= m
    Nothing -> (likes + retweets * 3) / (if hours_old > 0.1 then hours_old else 0.1) >= 50
