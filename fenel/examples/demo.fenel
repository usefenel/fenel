-- Fenel language demo
module Demo where

-- Algebraic data types
Shape = Circle radius: Number | Rect width: Number height: Number

-- Pattern matching with variable binding
classify : Number -> String
classify total = case total of
  n | n > 200 -> "expensive"
  n | n > 50  -> "moderate"
  _           -> "cheap"

-- Where clause
discount : Number -> Number
discount total = total * rate where rate = 0.1

area : Shape -> Number
area shape = case shape of
  Circle { radius = r } -> r * r * 3.14
  Rect { width = w, height = h } -> w * h
  _ -> 0

demo : String
demo =
  -- Basic arithmetic and let bindings
  let tax_rate = 0.2
  let price = 100
  let total = price + price * tax_rate

  -- String interpolation with std
  let label = `Total: ${total}`

  let shape = Circle { radius = 42 }

  -- Result
  `${label} (${classify total}, save ${discount total}, area ${area shape})`
