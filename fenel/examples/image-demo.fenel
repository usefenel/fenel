marketPhotoPixel : (rgb: Number) -> RgbaPixel
marketPhotoPixel rgb =
  let r = floor (rgb / 65536)
  let g = floor (rgb / 256) - r * 256
  let b = rgb - floor (rgb / 256) * 256
  { r = imageSourceByte r, g = imageSourceByte g, b = imageSourceByte b, a = 255 }

@label "Fennel at the market"
@description "The supplied photograph as a 96 by 128 Image with ordinary row-major RGBA pixel data. The unchanged 960 by 1280 JPEG is preserved at /demo/fennel-market.jpg."
@tags "demo" "media" "photo" "data"
marketPhoto : Image
marketPhoto = { width = 96, height = 128, pixels = map marketPhotoPixel (marketPhotoPackedRgb ()) }

@label "Photo editing chain"
@description "One expression crops and resizes the supplied photo, turns it upside down, adjusts brightness and contrast, applies sepia, inverts the colours, blurs and pixelates it, then overlays a translucent miniature landscape. Open Expression to browse every call and its image result. Crop coordinates and sizes are pixels; blur radius 2 averages a 5 by 5 neighbourhood; pixel size is 2; the upper-left landscape is 48 by 28 pixels at 80 percent opacity."
@tags "demo" "media" "photo" "composed"
marketPhotoPipeline : Image
marketPhotoPipeline = imageOverlay (imageOpacity (imageResize (imageSample 0) 48 28) 0.8) (imagePixelate (imageBoxBlur (imageInvert (imageSepia (imageContrast (imageBrightness (imageRotate180 (imageResize (imageCrop (marketPhoto ()) 12 16 72 96) 96 128)) 12) 1.15))) 2) 2)
