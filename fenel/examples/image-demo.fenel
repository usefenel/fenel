module ImageDemo where

using std (RgbaPixel, Image, imageSample, imageGrayscale, imageGaussianBlur, imageEdgeDetect, imagePixelate, imageFlipHorizontal, imageRotate180, imageCrop, imageResize, imageBrightness, imageContrast, imageSepia, imageInvert, imageBoxBlur, imageOverlay, imageOpacity, imageSourceByte, toNumber, words, map, eq, all, length, take, drop, concat, flatten, numberIsFinite, floor, isArray, not)

-- Original artwork: sample 0 is the Fenel-authored landscape. Every result
-- stays ordinary Image or List Image data, rendered by the same image lens.

@label "Blur radius"
@description "Gaussian blur radius in pixels, from 0 (no blur) to 4."
ImageBlurRadius = Nat | value ∈ [0..4]

@label "Pixel size"
@description "Size of each retro pixel block, from 1 to 12."
ImagePixelSize = Nat | value ∈ [1..12]

@label "Image filter results"
@description "One original landscape, named filter results, then the same retro filter applied to three images."
@discriminator "$tag"
ImageFilterResults = ImageFilterResults radius: Nat factor: Nat original: Image grayscale: Image blurred: Image edges: Image retro: Image inputImages: List Image filteredImages: List Image

@label "Soft grayscale"
@description "Convert to grayscale, then apply a Gaussian blur."
@tags "media" "visual" "composed"
softGrayscale : (radius: ImageBlurRadius) -> (image: Image) -> Image
softGrayscale radius image =
  let grayscale = imageGrayscale image
  if eq radius 0 then grayscale else imageGaussianBlur grayscale radius

@label "Soft edges"
@description "Detect Sobel edges after the same grayscale and blur composition."
@tags "media" "visual" "composed"
softEdges : (radius: ImageBlurRadius) -> (image: Image) -> Image
softEdges radius image = imageEdgeDetect (softGrayscale radius image)

@label "Retro landscape"
@description "Convert to grayscale, then average each pixel block. The same function also maps over the image list."
@tags "media" "visual" "composed"
retroLandscape : (factor: ImagePixelSize) -> (image: Image) -> Image
retroLandscape factor image = imagePixelate (imageGrayscale image) factor

@label "Images: one to many"
@description "Change blur radius (0 to 4) and pixel size (1 to 12). Inspect each named image, then compare the same retro function across the original, mirrored and rotated landscape."
@tags "demo" "media" "visual" "composed" "list"
imageFilterDemo : (radius: ImageBlurRadius) -> (factor: ImagePixelSize) -> ImageFilterResults
imageFilterDemo radius factor =
  let original = imageSample 0
  let grayscale = imageGrayscale original
  let blurred = softGrayscale radius original
  let edges = softEdges radius original
  let retro = retroLandscape factor original
  let inputImages = [original, imageFlipHorizontal original, imageRotate180 original]
  let filteredImages = map (retroLandscape factor) inputImages
  ImageFilterResults { radius = radius, factor = factor, original = original, grayscale = grayscale, blurred = blurred, edges = edges, retro = retro, inputImages = inputImages, filteredImages = filteredImages }

-- GP-72: rows are a projection, not a second Image encoding. The small
-- browser-local fragment preserves zero dimensions and exact row-major order.
-- RgbaPixel itself declares Nat channels; the raster fragment additionally admits
-- only whole byte channels, rather than clipping or coercing their values.

@label "Image and its rows"
@description "The original 3 by 2 Image and its ordinary nested-list projection, beside the edited rows and the reconstructed Image. Image still declares width, height and one flat pixel list."
@discriminator "$tag"
ImageMatrixResults = ImageMatrixResults original: Image originalRows: List (List RgbaPixel) width: Nat height: Nat rows: List (List RgbaPixel) image: Image explanation: String

imageMatrixDimensionAdmitted : (dimension: Nat) -> Bool
imageMatrixDimensionAdmitted dimension = numberIsFinite dimension && dimension >= 0 && dimension <= 16 && floor dimension == dimension

imageMatrixChannelAdmitted : (channel: Nat) -> Bool
imageMatrixChannelAdmitted channel = numberIsFinite channel && channel >= 0 && channel <= 255 && floor channel == channel

imageMatrixColorAdmitted : (pixel: RgbaPixel) -> Bool
imageMatrixColorAdmitted pixel = imageMatrixChannelAdmitted pixel.r && imageMatrixChannelAdmitted pixel.g && imageMatrixChannelAdmitted pixel.b && imageMatrixChannelAdmitted pixel.a

imageMatrixRowAdmitted : (width: Nat) -> (row: List RgbaPixel) -> Bool
imageMatrixRowAdmitted width row = isArray row && length row == width && all row imageMatrixColorAdmitted

imageRowsBuild : (width: Nat) -> (height: Nat) -> (pixels: List RgbaPixel) -> List (List RgbaPixel)
imageRowsBuild width height pixels =
  if height == 0 then []
  else concat [take width pixels] (imageRowsBuild width (height - 1) (drop width pixels))

@label "Image to ordinary rows"
@description "Project a small Image into List (List RgbaPixel). Width and height must be whole numbers from 0 through 16, pixel count must equal width times height, and RGBA channels must be whole bytes. Rows preserve the flat Image's row-major order; zero-width images retain their empty rows."
@tags "demo" "media" "list" "projection"
imageRows : (image: Image) -> Result String (List (List RgbaPixel))
imageRows image =
  if not (imageMatrixDimensionAdmitted image.width && imageMatrixDimensionAdmitted image.height) then Err "Use whole width and height from 0 through 16."
  else if not (isArray image.pixels && length image.pixels == image.width * image.height) then Err "The flat pixel list must contain exactly width times height RgbaPixels."
  else if not (all image.pixels imageMatrixColorAdmitted) then Err "Every RgbaPixel needs whole r, g, b and a channels from 0 through 255."
  else Ok (imageRowsBuild image.width image.height image.pixels)

@label "Ordinary rows to Image"
@description "Reconstruct the declared Image from editable List (List RgbaPixel) data, with whole width and height from 0 through 16. The outer list must have height rows and every row must have width RgbaPixels; invalid dimensions, row lengths and RGBA byte channels return Err. Nothing is resized, dropped or clipped."
@tags "demo" "media" "list" "reconstruction"
imageFromRows : (width: Nat) -> (height: Nat) -> (rows: List (List RgbaPixel)) -> Result String Image
imageFromRows width height rows =
  if not (imageMatrixDimensionAdmitted width && imageMatrixDimensionAdmitted height) then Err "Use whole width and height from 0 through 16."
  else if not (isArray rows && length rows == height) then Err "The outer list must contain exactly height rows."
  else if not (all rows (\row -> isArray row && length row == width)) then Err "Every row must contain exactly width RgbaPixels; ragged rows are refused."
  else if not (all rows (imageMatrixRowAdmitted width)) then Err "Every RgbaPixel needs whole r, g, b and a channels from 0 through 255."
  else Ok { width = width, height = height, pixels = flatten rows }

@label "Original pixel rows"
@description "Two ordinary lists of three RgbaPixel records. Open a row, then a RgbaPixel to inspect its r, g, b and a channels. These are a projection of Image data, not Image's declared storage shape."
@tags "demo" "media" "list" "data"
imageMatrixSampleRows : List (List RgbaPixel)
imageMatrixSampleRows = [
  [{ r = 239, g = 68, b = 68, a = 255 }, { r = 59, g = 130, b = 246, a = 255 }, { r = 250, g = 204, b = 21, a = 255 }],
  [{ r = 168, g = 85, b = 247, a = 255 }, { r = 255, g = 255, b = 255, a = 255 }, { r = 30, g = 41, b = 59, a = 255 }]
]

@label "Original 3 by 2 Image"
@description "A tiny non-square six-pixel Image. Its declared pixels field is one flat row-major List RgbaPixel; imageRows exposes the same RgbaPixels as two ordinary rows."
@tags "demo" "media" "data"
imageMatrixSample : Image
imageMatrixSample = { width = 3, height = 2, pixels = flatten (imageMatrixSampleRows ()) }

@label "Empty Image"
@description "The declared 0 by 0 Image has no flat pixels and projects to no rows. Reconstruct it with width 0, height 0 and an empty outer list."
@tags "demo" "media" "data"
imageMatrixEmpty : Image
imageMatrixEmpty = { width = 0, height = 0, pixels = [] }

@label "An image is typed data"
@description "Open a row and edit one RgbaPixel through the ordinary nested-list editor, then compare the reconstructed Image with the original 3 by 2 sample. Width and height must be whole numbers from 0 through 16; rows must match them exactly and channels must be whole bytes. Inspect original data and Fenel source. Close and reopen Call to restore its source-owned starting inputs."
@tags "demo" "media" "list" "editing"
imageMatrixDemo : (width: Nat) -> (height: Nat) -> (rows: List (List RgbaPixel)) -> Result String ImageMatrixResults
imageMatrixDemo width height rows = case imageFromRows width height rows of
  Err reason -> Err reason
  Ok image -> Ok (ImageMatrixResults { original = imageMatrixSample (), originalRows = imageMatrixSampleRows (), width = width, height = height, rows = rows, image = image, explanation = "Rows are a List (List RgbaPixel) projection. Image still stores a flat List RgbaPixel in row-major order. Edits reconstruct the same declared Image; the original sample remains available for inspection and reset." })

-- The editable example's starting arguments are data, with its callable held
-- as a function value rather than a textual id.
imageDemoStartingInputs : List ({ function: Any, arguments: List Any })
imageDemoStartingInputs = [
  { function = imageFilterDemo, arguments = [2, 4] },
  { function = imageMatrixDemo, arguments = [3, 2, imageMatrixSampleRows ()] },
  { function = imageRows, arguments = [imageMatrixSample ()] },
  { function = imageFromRows, arguments = [3, 2, imageMatrixSampleRows ()] }
]


-- The supplied market photograph is preserved byte-for-byte at
-- /demo/fennel-market.jpg (960 by 1280). This decoded 96 by 128 preview keeps
-- the runnable example bounded. Decimal RGB integers are source data; existing
-- string/number functions read them, and the Fenel projection produces the
-- declared RgbaPixel records with the shared finite/round/clamp byte policy.
marketPhotoPackedRgb : List Number
marketPhotoPackedRgb = map toNumber (words "16115611 16706696 15522431 16115608 16049550 15917179 15325287 15390836 15321712 14925677 14921811 16236386 16501351 16371058 16699243 13867592 10839332 11563055 10642468 10249261 9200197 10383175 8938049 5322267 4993301 4993301 4729609 6307088 12033634 11709291 10656866 11117159 11248484 11709284 12169330 11446125 10125639 9993029 10126920 10655584 9997410 8352839 8482877 7364653 5261096 3680532 3087884 2364681 5125662 8088389 7366955 6051095 4734738 4273676 4668426 5586715 4731415 8937517 8016689 6307616 4140306 4731408 5322772 3810320 5847067 7031837 7622937 5848852 5123346 11436353 11439948 9401427 8019532 6573631 3220489 3417610 3219466 1970691 1643011 2234633 2102531 7494681 8611625 2366727 4273685 8090168 6574878 7498024 8947779 9800239 11113775 8613938 7366950 9340975 9998121 11247145 16511402 16776860 16771220 16776629 16772256 16773266 16310630 16772746 16307066 16106612 16764786 16767092 16768117 16769402 16761696 12549684 12088623 12417588 11496491 11365943 9462851 9724735 10975056 7030824 4992788 5453079 4203525 7756327 14536074 12826988 11183712 12104557 12564083 12630126 12498804 11248228 10981961 10388801 9137721 10720079 9206595 8088386 7562300 6904618 5325605 3943705 4271644 5192994 3351052 5127455 8221745 6183191 5129233 4800015 6639386 6507046 2759946 7294494 7885868 6242595 4008462 5454617 5124373 6899759 6768162 6768922 6899992 5782298 7293987 11633460 11569200 8874051 7756360 5061417 2825987 3746314 4732436 4799000 3616789 1840389 1970945 8613419 6442012 3155467 6905640 8813625 8286761 9538613 10130749 11378494 11640888 9208370 8946477 9603882 9932321 12365360 15390106 15716732 15653280 15916719 15256723 15324034 15060070 15189106 14657365 15512925 16435823 16370802 16633198 15511638 11958323 11169072 11497522 11497780 10708525 10709301 9265470 8605994 10580042 9200188 5583899 5387804 3481095 5784348 12564091 12431980 10261332 10919769 12037735 11511656 11052136 9077319 9535809 9798461 7888423 743068