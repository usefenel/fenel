# =============================================================================
# Fenel: environment variables
# Copy to .env at the repository root. Start with DATABASE_URL and the
# account/admin settings; optional provider secrets can stay empty.
# This file documents local development, not a production deployment.
# =============================================================================

# ---- Runtime ----
# NODE_ENV: leave unset on dev/staging for verbose error responses;
# set to "production" on prod so 500s collapse to a generic message.
NODE_ENV=

# ---- Database ----
DATABASE_URL=postgresql://localhost:5432/fenel_dev

# ---- API Server ----
API_PORT=3001
# Vite proxies /api, /webhooks and /r to 127.0.0.1:3001. Keep that port
# unless you also change the frontend proxy configuration.
API_HOST=127.0.0.1
# Optional build/CI revision for GET /api/version; empty uses git rev-parse.
GIT_SHA=
# Shared secret for POST /api/intake/events/inbound (Zapier, integrations).
INBOUND_EVENT_TOKEN=

# ---- Account ----
# UUID of an existing account. This release has no seed script that creates
# one: running the API against a fresh database is not supported yet.
DEFAULT_ACCOUNT_ID=

# ---- Admin login ----
# When ADMIN_EMAIL + ADMIN_PASSWORD are set, the API server bootstraps
# (or rotates) an admin user on every boot, attached to DEFAULT_ACCOUNT_ID
# with role "owner". Use these to log in on Home or /login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Token gating /api/auth/dev-login (admin-only convenience endpoint).
# Leave unset in production.
ADMIN_TOKEN=

# ---- Public deployment and API safety limits ----
# Public hosting opts in with FENEL_PUBLIC_DEPLOYMENT=1 and NODE_ENV=production.
# The boot guard also requires loopback API_HOST and EMPTY ADMIN_TOKEN,
# INBOUND_EVENT_TOKEN, STRIPE_WEBHOOK_SECRET, CALENDLY_WEBHOOK_SECRET and
# GOOGLE_PLACES_API_KEY. This guard alone does not make accounts launch-ready.
FENEL_PUBLIC_DEPLOYMENT=0
# Additional trusted proxy IPs, comma-separated. Loopback is already trusted.
FENEL_TRUSTED_PROXY_IPS=
# Server-wide body cap in bytes; route groups have tighter caps below.
FENEL_MAX_REQUEST_BODY_BYTES=67108864

# Token-bucket limits per process: <count>/<window>, with s, min or h.
FENEL_RATE_LIMIT_ANON_READ=120/min
FENEL_RATE_LIMIT_ANON_SUBMIT=20/min
FENEL_RATE_LIMIT_LOGIN=20/min
FENEL_RATE_LIMIT_LOGIN_EMAIL_IP=10/15min
FENEL_RATE_LIMIT_LOGIN_EMAIL=100/h
FENEL_RATE_LIMIT_SIGNUP=10/h
FENEL_RATE_LIMIT_API=300/min
FENEL_RATE_LIMIT_WEBHOOK=600/min
FENEL_RATE_LIMIT_WEBHOOK_IP=6000/min
FENEL_RATE_LIMIT_ACCOUNT=600/min
FENEL_API_CONCURRENCY_PER_IP=2
FENEL_API_QUEUE_PER_IP=16

# Per-route body caps: bytes, KB or MB. These and the rates above are
# implementation defaults; production capacity has not been load-tested yet.
FENEL_BODY_LIMIT_ANON_READ=64KB
FENEL_BODY_LIMIT_ANON_SUBMIT=1MB
FENEL_BODY_LIMIT_LOGIN=4KB
FENEL_BODY_LIMIT_SIGNUP=8KB
FENEL_BODY_LIMIT_API_EXPRESSION=64KB
FENEL_BODY_LIMIT_API_ARGUMENTS=256KB
FENEL_BODY_LIMIT_WEBHOOK=1MB
FENEL_BODY_LIMIT_ACCOUNT=8MB

# ---- Stripe ----
# The host Checkout leaf uses STRIPE_SECRET_KEY. Other provider credentials
# belong to per-account integrations, configured through Fenel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Empty uses the default return URLs written in fenel/modules/payments/payments.fenel.
# Set your own return URLs when you try payment links.
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# ---- Telegram Bot ----
# Polling requires a Bot entity in this account. Its token is stored on that
# entity; BOT_TOKEN and TG_GROUP_* environment settings are no longer read.
ACCOUNT_ID=                           # same account UUID as DEFAULT_ACCOUNT_ID
# Public base URL for Telegram webhook callbacks (e.g. https://fenel.example.com).
# runTelegramCollector auto-calls setWebhook pointing to {base}/webhooks/telegram/{botId}.
WEBHOOK_BASE_URL=

# ---- Email ----
# From address used by the template-email action when it builds an Email.
# Format: "Display Name <addr@domain>".
EMAIL_FROM=Fenel <noreply@usefenel.com>

# ---- Email: Fenel-managed default sender (server-level) ----
# These power the OOB managed sender that any account uses when they
# haven't configured their own provider. Internally forwards to Mailgun
# under master credentials and rewrites the from-domain to FENEL_MAILGUN_DOMAIN.
# Customers wanting to send from their own domain should add a Mailgun /
# Postmark / SES / Resend integration instead.
FENEL_MAILGUN_KEY=
# Your verified Mailgun sending domain. Both key and domain are required.
FENEL_MAILGUN_DOMAIN=
FENEL_MAILGUN_REGION=us                  # us | eu

# Per-account hourly send limit on the managed default. One bad actor on
# the shared sender pool tarnishes deliverability for everyone, so we
# rate-limit aggressively. This quota applies to the managed sender.
# Account-configured providers have their own service limits and still use
# the API's request limits.
FENEL_MANAGED_HOURLY_LIMIT=100

# ---- Email: provider integrations (per account, not server-level) ----
# Mailgun, Postmark, SES, and Resend credentials are stored per account,
# rather than in this environment file. Configure via the dashboard UI or
# the integrations API. See implementations/typescript/engine/src/integrations.ts for the
# credential shape per provider type.

# ---- Calendly ----
CALENDLY_WEBHOOK_SECRET=
# Map Calendly event type URIs to call type slugs:
# CALENDLY_MAP_intro=https://api.calendly.com/event_types/XXXXX

# ---- Address autocomplete ----
# Optional Google Places API key; empty leaves autocomplete disabled.
# Must stay empty when FENEL_PUBLIC_DEPLOYMENT=1.
GOOGLE_PLACES_API_KEY=

# ---- Twitter / X ----
# Public web-app bearer (the one the x.com web client uses).
# Used alongside per-account ct0 / auth_token cookies stored in `integrations`.
TWITTER_BEARER_TOKEN=
